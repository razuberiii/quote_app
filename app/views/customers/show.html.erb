<main class="workspace-page customer-core">
  <header class="customer-core__hero">
    <div><%= link_to t("customers.core.back"), customers_path %><h1><%= @customer.name %></h1><p><%= [@customer.contact_name, @customer.email, @customer.phone].compact_blank.join(" · ") %></p></div>
    <div class="customer-core__actions"><%= link_to t("self_service.quote_core.index.new"), new_quote_path(customer_id: @customer.id), class: "button button--primary" %><%= link_to t("customers.core.edit"), edit_customer_path(@customer), class: "button button--secondary" %></div>
  </header>
  <dl class="quote-core-facts"><div><dt><%= t("customers.core.fields.country") %></dt><dd><%= @customer.country.presence || "—" %></dd></div><div><dt><%= t("customers.core.fields.address") %></dt><dd><%= @customer.address.presence || "—" %></dd></div><div><dt><%= t("customers.core.fields.payment_terms") %></dt><dd><%= @customer.payment_terms.presence || "—" %></dd></div></dl>
  <section class="customer-core__quotes"><h2><%= t("customers.core.quotes") %></h2><% @quotes.each do |quote| %><%= link_to quote_path(quote), class: "customer-core__row" do %><div><strong><%= quote.custom_title.presence || quote.quote_no %></strong><small><%= quote.quote_no %></small></div><span><%= quote.currency %> <%= number_with_delimiter(quote.grand_total) %></span><i>→</i><% end %><% end %></section>
</main>
