<section class="workspace-page product-source">
  <header class="workspace-heading workspace-heading--split">
    <div><span class="eyebrow">Library / Product source</span><h1><%= @product.name %></h1><p><%= @product.sku.presence || "No SKU" %> · <%= @product.product_category.presence || "Uncategorised" %></p></div>
    <div class="resource-editor__actions"><%= link_to "Back to Library", library_path, class: "control control--quiet" %><%= link_to "Edit source", edit_product_path(@product), class: "control control--primary" %></div>
  </header>

  <div class="product-source__layout">
    <aside class="resource-media">
      <div class="resource-media__preview">
        <% if @product.display_image.present? %><%= image_tag @product.display_image, alt: @product.name %><% else %><div class="product-visual-placeholder"><span>PRODUCT / SOURCE</span><strong><%= @product.sku.presence || @product.name %></strong><i></i></div><% end %>
      </div>
      <% if @product.gallery_images.attached? %><div class="resource-media__gallery"><% @product.gallery_images.each do |image| %><%= image_tag image, alt: @product.name %><% end %></div><% end %>
    </aside>

    <div class="product-source__content">
      <section class="source-summary"><span class="eyebrow">Commercial source</span><strong><%= @product.price_currency %> <%= number_with_precision(@product.default_price, precision: 2) %></strong><p>Reference price · confirmation is still required inside each Deal.</p></section>
      <dl class="source-facts">
        <div><dt>Sales unit</dt><dd><%= @product.unit.presence || "—" %></dd></div>
        <div><dt>MOQ</dt><dd><%= @product.moq.presence || "—" %></dd></div>
        <div><dt>Lead time</dt><dd><%= @product.lead_time.presence || "Not specified" %></dd></div>
        <div><dt>Internal cost</dt><dd><%= @product.cost_price.present? ? "#{@product.price_currency} #{number_with_precision(@product.cost_price, precision: 2)}" : "Not recorded" %></dd></div>
      </dl>
      <section class="source-description"><span class="eyebrow">Buyer-facing description</span><h2>Product context</h2><p><%= @product.description.presence || "Add a concise description before this product enters a buyer-facing quote." %></p></section>
      <section class="source-config"><span class="eyebrow">Configuration</span><div><article><strong>Specification preset</strong><span><%= @product.default_spec_preset&.name || "No default" %></span></article><article><strong>Accessory preset</strong><span><%= @product.default_addon_preset&.name || "No default" %></span></article></div></section>
    </div>
  </div>
</section>
