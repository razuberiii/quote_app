    function refreshConfigurationRows() {
      if (!configurationRowsContainer) return;
      const rows = Array.from(configurationRowsContainer.querySelectorAll(".js-configuration-row"));
      rows.forEach((row, index) => {
        row.dataset.index = String(index);
        row.querySelectorAll("input[name]").forEach((input) => {
          input.name = input.name
            .replace(/quote\[configuration_block\]\[rows\]\[[^\]]+\]/, `quote[configuration_block][rows][${index}]`);
        });
        const positionInput = row.querySelector(".js-config-position");
        if (positionInput) positionInput.value = String(index + 1);
      });
      const hasValidRow = rows.some((row) => {
        const label = row.querySelector(".js-config-label")?.value?.trim() || "";
        const value = row.querySelector(".js-config-value")?.value?.trim() || "";
        return label.length > 0 && value.length > 0;
      });
      setEmptyHintVisibility(configurationRowsContainer, ".js-configuration-row", ".js-configuration-empty");
    }

    function refreshDetailPictureRows() {
      if (!detailPictureRowsContainer) return;
      const rows = Array.from(detailPictureRowsContainer.querySelectorAll(".js-detail-picture-row"));
      rows.forEach((row, index) => {
        row.dataset.index = String(index);
        row.querySelectorAll("input[name], select[name]").forEach((input) => {
          input.name = input.name
            .replace(/quote\[detail_pictures_block\]\[items\]\[[^\]]+\]/, `quote[detail_pictures_block][items][${index}]`);
        });
        const positionInput = row.querySelector(".js-detail-picture-position");
        if (positionInput) positionInput.value = String(index + 1);
        const blobId = row.querySelector(".js-detail-picture-blob")?.value?.trim() || "";
        row.dataset.blobId = blobId;
      });
      const batchUploadCount = detailPictureBatchUploadInput?.files?.length || 0;
      const hasAnyPicture = rows.some((row) => {
        const blobId = row.querySelector(".js-detail-picture-blob")?.value?.trim() || "";
        return blobId.length > 0;
      }) || batchUploadCount > 0;
      if (detailPicturesEnabledInput) detailPicturesEnabledInput.value = hasAnyPicture ? "1" : "0";
      setEmptyHintVisibility(detailPictureRowsContainer, ".js-detail-picture-row", ".js-detail-pictures-empty");
      rows.forEach((row) => renderDetailPicturePreview(row));
      syncDetailGallerySelectionStateFromRows();
    }

    function refreshContainerLoadingRows() {
      if (!containerLoadingRowsContainer) return;
      const noteEnabled = !!containerLoadingNoteEnabledInput?.checked;
      const noteHeader = form?.querySelector(".js-container-loading-header-note")?.value?.trim() || "<%= j t("quote_document.labels.note", default: "Note") %>";
      const rows = Array.from(containerLoadingRowsContainer.querySelectorAll(".js-container-loading-row"));
      rows.forEach((row, index) => {
        row.dataset.index = String(index);
        row.querySelectorAll("input[name]").forEach((input) => {
          input.name = input.name
            .replace(/quote\[container_loading_block\]\[rows\]\[[^\]]+\]/, `quote[container_loading_block][rows][${index}]`);
        });
        const positionInput = row.querySelector(".js-container-loading-position");
        if (positionInput) positionInput.value = String(index + 1);
        const noteInput = row.querySelector(".js-container-loading-note");
        if (noteInput) {
          noteInput.hidden = !noteEnabled;
          noteInput.placeholder = noteHeader || "<%= j t("quotes.view.form.container_loading_note_placeholder", default: "Note (optional)") %>";
        }
      });

      const hasValidRow = rows.some((row) => {
        const variant = row.querySelector(".js-container-loading-variant")?.value?.trim() || "";
        const containerType = row.querySelector(".js-container-loading-type")?.value?.trim() || "";
        const capacity = row.querySelector(".js-container-loading-capacity")?.value?.trim() || "";
        const note = noteEnabled ? (row.querySelector(".js-container-loading-note")?.value?.trim() || "") : "";
        return variant.length > 0 || containerType.length > 0 || capacity.length > 0 || (noteEnabled && note.length > 0);
      });
      if (containerLoadingEnabledInput) containerLoadingEnabledInput.value = hasValidRow ? "1" : "0";
      setEmptyHintVisibility(containerLoadingRowsContainer, ".js-container-loading-row", ".js-container-loading-empty");
    }

    function newConfigurationRowHtml(index) {
      return `
        <div class="quote-advanced-module-row js-configuration-row" data-index="${index}">
          <input type="text" class="app-ui-input js-config-label" name="quote[configuration_block][rows][${index}][label]" placeholder="${escapeAttr("<%= j t("quotes.view.form.configuration_label_placeholder", default: "Label") %>")}">
          <input type="text" class="app-ui-input js-config-value" name="quote[configuration_block][rows][${index}][value]" placeholder="${escapeAttr("<%= j t("quotes.view.form.configuration_value_placeholder", default: "Value") %>")}">
          <input type="hidden" class="js-config-position" name="quote[configuration_block][rows][${index}][position]" value="${index + 1}">
          <button type="button" class="quote-kv-remove js-config-row-remove" aria-label="${escapeAttr("<%= j t("quotes.view.form.remove", default: "Remove") %>")}">&times;</button>
        </div>
      `;
    }

    function newDetailPictureRowHtml(index) {
      return `
        <div class="quote-advanced-module-row quote-advanced-module-row--picture js-detail-picture-row" data-index="${index}" data-blob-id="">
          <input type="hidden" class="js-detail-picture-source" name="quote[detail_pictures_block][items][${index}][source]" value="product_gallery">
          <input type="hidden" class="js-detail-picture-blob" name="quote[detail_pictures_block][items][${index}][image_blob_id]" value="">
          <div class="quote-detail-item-preview js-detail-picture-preview"></div>
          <p class="quote-detail-item-name js-detail-picture-name"></p>
          <input type="text" class="app-ui-input js-detail-picture-caption" name="quote[detail_pictures_block][items][${index}][caption]" placeholder="${escapeAttr("<%= j t("quotes.view.form.detail_picture_caption_placeholder", default: "Caption (optional)") %>")}">
          <input type="hidden" class="js-detail-picture-position" name="quote[detail_pictures_block][items][${index}][position]" value="${index + 1}">
          <button type="button" class="quote-kv-remove js-detail-picture-row-remove" aria-label="${escapeAttr("<%= j t("quotes.view.form.remove", default: "Remove") %>")}">&times;</button>
        </div>
      `;
    }

    function detailPictureUrlFromBlobId(blobId) {
      const targetId = String(blobId || "").trim();
      if (!targetId) return "";

      const entry = detailPictureCatalog.find((item) => String(item.blob_id || "") === targetId);
      if (entry?.url) return entry.url;

      return "";
    }

    function detailPictureLabelFromBlobId(blobId) {
      const targetId = String(blobId || "").trim();
      if (!targetId) return "";
      const entry = detailPictureCatalog.find((item) => String(item.blob_id || "") === targetId);
      return entry?.label || "";
    }

    function currentSelectedProductIds() {
      return activeQuoteItemRows()
        .map((row) => String(row.querySelector(".js-product-id")?.value || "").trim())
        .filter((id) => id.length > 0);
    }

    function detailGalleryEntriesFromSelectedProducts() {
      const selectedIds = new Set(currentSelectedProductIds());
      if (!selectedIds.size) return [];

      return products
        .filter((product) => selectedIds.has(String(product.id)))
        .flatMap((product) => {
          const options = Array.isArray(product.image_options) ? product.image_options : [];
          return options.map((entry) => ({
            productName: product.name || "",
            blobId: String(entry.blob_id || "").trim(),
            url: String(entry.url || "").trim(),
            label: String(entry.label || "").trim()
          })).filter((entry) => entry.blobId && entry.url);
        });
    }

    function existingDetailPictureBlobIds() {
      if (!detailPictureRowsContainer) return new Set();
      return new Set(
        Array.from(detailPictureRowsContainer.querySelectorAll(".js-detail-picture-blob"))
          .map((input) => String(input.value || "").trim())
          .filter((value) => value.length > 0)
      );
    }

    function setDetailGalleryCardSelectedState(card, selected) {
      if (!card) return;
      card.classList.toggle("is-selected", selected);
      card.setAttribute("aria-pressed", selected ? "true" : "false");
    }

    function refreshDetailGallerySelectAllLabel() {
      if (!detailGalleryGrid || !detailGallerySelectAllBtn) return;
      const cards = Array.from(detailGalleryGrid.querySelectorAll(".js-detail-gallery-card"));
      const selectedCount = cards.filter((card) => card.classList.contains("is-selected")).length;
      const allSelected = cards.length > 0 && selectedCount === cards.length;
      detailGallerySelectAllBtn.textContent = allSelected ? detailGalleryDeselectAllLabel : detailGallerySelectAllLabel;
      detailGallerySelectAllBtn.disabled = cards.length === 0;
    }

    function syncDetailGallerySelectionStateFromRows() {
      if (!detailGalleryGrid) return;
      const selectedBlobIds = existingDetailPictureBlobIds();
      detailGalleryGrid.querySelectorAll(".js-detail-gallery-card").forEach((card) => {
        const blobId = String(card.dataset.blobId || "").trim();
        setDetailGalleryCardSelectedState(card, blobId && selectedBlobIds.has(blobId));
      });
      refreshDetailGallerySelectAllLabel();
    }

    function renderSelectedProductGallery() {
      if (!detailGalleryGrid || !detailGalleryEmpty) return;
      const entries = detailGalleryEntriesFromSelectedProducts();
      detailGalleryGrid.innerHTML = "";
      if (!entries.length) {
        detailGalleryEmpty.hidden = false;
        refreshDetailGallerySelectAllLabel();
        return;
      }

      detailGalleryEmpty.hidden = true;
      const deduped = [];
      const seen = new Set();
      entries.forEach((entry) => {
        if (seen.has(entry.blobId)) return;
        seen.add(entry.blobId);
        deduped.push(entry);
      });

      const existingIds = existingDetailPictureBlobIds();
      detailGalleryGrid.innerHTML = deduped.map((entry) => {
        const selectedClass = existingIds.has(entry.blobId) ? "is-selected" : "";
        const ariaPressed = existingIds.has(entry.blobId) ? "true" : "false";
        return `
          <button type="button" class="quote-detail-gallery-card js-detail-gallery-card ${selectedClass}" data-blob-id="${escapeAttr(entry.blobId)}" aria-pressed="${ariaPressed}">
            <span class="quote-detail-gallery-selected-indicator" aria-hidden="true"></span>
            <img src="${escapeAttr(entry.url)}" alt="${escapeAttr(entry.productName)}" class="quote-detail-gallery-image">
            <span class="quote-detail-gallery-meta">${escapeHtml(entry.productName)} · ${escapeHtml(entry.label || "Image")}</span>
          </button>
        `;
      }).join("");
      refreshDetailGallerySelectAllLabel();
    }

    function addDetailPictureRowWithBlob(blobId) {
      if (!detailPictureRowsContainer) return;
      const existingIds = existingDetailPictureBlobIds();
      if (existingIds.has(blobId)) return;

      const index = detailPictureRowsContainer.querySelectorAll(".js-detail-picture-row").length;
      detailPictureRowsContainer.insertAdjacentHTML("beforeend", newDetailPictureRowHtml(index));
      const newRow = detailPictureRowsContainer.querySelectorAll(".js-detail-picture-row")[index];
      const blobInput = newRow?.querySelector(".js-detail-picture-blob");
      if (blobInput) blobInput.value = blobId;
      const sourceInput = newRow?.querySelector(".js-detail-picture-source");
      if (sourceInput) sourceInput.value = "product_gallery";
    }

    function removeDetailPictureRowByBlob(blobId) {
      if (!detailPictureRowsContainer) return;
      const target = Array.from(detailPictureRowsContainer.querySelectorAll(".js-detail-picture-row"))
        .find((row) => String(row.querySelector(".js-detail-picture-blob")?.value || "").trim() === String(blobId || "").trim());
      target?.remove();
    }

    function renderDetailPicturePreview(row) {
      if (!row) return;
      const preview = row.querySelector(".js-detail-picture-preview");
      const nameEl = row.querySelector(".js-detail-picture-name");
      if (!preview) return;

      const blobId = row.querySelector(".js-detail-picture-blob")?.value?.trim() || "";
      const imageUrl = detailPictureUrlFromBlobId(blobId);
      const imageLabel = detailPictureLabelFromBlobId(blobId);
      if (!imageUrl) {
        preview.innerHTML = "";
        preview.classList.remove("is-active");
        if (nameEl) nameEl.textContent = "";
        return;
      }

      preview.innerHTML = `<img src="${escapeAttr(imageUrl)}" alt="detail preview" class="quote-detail-item-preview-image">`;
      preview.classList.add("is-active");
      if (nameEl) nameEl.textContent = imageLabel;
    }

    function renderDetailBatchPreview() {
      if (!detailBatchPreview || !detailPictureBatchUploadInput) return;
      const files = Array.from(detailPictureBatchUploadInput.files || []);
      if (!files.length) {
        detailBatchPreview.hidden = true;
        detailBatchPreview.innerHTML = "";
        return;
      }

      detailBatchPreview.hidden = false;
      detailBatchPreview.innerHTML = files.slice(0, 12).map((file, index) => {
        const url = URL.createObjectURL(file);
        return `
          <figure class="quote-advanced-module-row quote-advanced-module-row--picture quote-detail-batch-preview-item" data-upload-index="${index}">
            <div class="quote-detail-item-preview is-active">
              <img src="${escapeAttr(url)}" alt="${escapeAttr(file.name)}" class="quote-detail-item-preview-image">
            </div>
            <figcaption class="quote-detail-item-name">${escapeHtml(file.name)}</figcaption>
            <input type="text" class="app-ui-input quote-detail-batch-caption-input" name="quote[detail_pictures_batch_captions][${index}]" placeholder="${escapeAttr("<%= j t("quotes.view.form.detail_picture_caption_placeholder", default: "Caption (optional)") %>")}">
            <button type="button" class="quote-kv-remove js-detail-batch-remove" data-upload-index="${index}" aria-label="${escapeAttr("<%= j t("quotes.view.form.remove", default: "Remove") %>")}">&times;</button>
          </figure>
        `;
      }).join("");
    }

    function removeBatchUploadAt(index) {
      if (!detailPictureBatchUploadInput) return;
      const files = Array.from(detailPictureBatchUploadInput.files || []);
      if (index < 0 || index >= files.length) return;
      files.splice(index, 1);
      const transfer = new DataTransfer();
      files.forEach((file) => transfer.items.add(file));
      detailPictureBatchUploadInput.files = transfer.files;
      renderDetailBatchPreview();
      refreshDetailPictureRows();
    }

