<% data = @inquiry.extracted_data.deep_stringify_keys %>
<% evidence = data.fetch("evidence", {}) %>
<main class="rubusoo-page inquiry-review" data-controller="intake-motion inquiry-review">
  <header class="inquiry-review__header">
    <div><p class="eyebrow"><%= t("self_service.review.eyebrow") %></p><h1><%= t("self_service.review.title") %></h1><p><%= t("self_service.review.description") %></p></div>
    <div class="inquiry-review__status"><span class="status-dot"></span><strong><%= t("self_service.review.saved") %></strong><small><%= t("self_service.review.saved_ago", time: time_ago_in_words(@inquiry.updated_at)) %></small></div>
  </header>

  <section class="review-guidance" aria-labelledby="review-next-step">
    <div class="review-guidance__lead">
      <span><%= t("self_service.review.current_step") %></span>
      <h2 id="review-next-step"><%= @guidance.next_item&.label || t("self_service.review.ready_title") %></h2>
      <p><%= @guidance.next_item&.reason || t("self_service.review.ready_body") %></p>
    </div>
    <div class="review-guidance__groups">
      <% InquiryGuidance::LEVELS.each do |level| %>
        <section>
          <h3><%= t("self_service.priority.#{level}") %></h3>
          <% @guidance.items.select { |item| item.level == level }.each do |item| %>
            <div class="review-guidance__item <%= "is-complete" if item.complete %>">
              <span aria-hidden="true"><%= item.complete ? "✓" : "→" %></span>
              <div><strong><%= item.label %></strong><small><%= item.reason %></small></div>
            </div>
          <% end %>
        </section>
      <% end %>
    </div>
  </section>

  <section class="inquiry-conversation" id="conversation" aria-labelledby="conversation-title">
    <header class="inquiry-conversation__header">
      <div><p class="section-kicker"><%= t("self_service.conversation.kicker") %></p><h2 id="conversation-title"><%= t("self_service.conversation.title") %></h2><p><%= t("self_service.conversation.help") %></p></div>
      <div class="inquiry-conversation__readiness"><span><%= t("self_service.review.readiness") %></span><strong><%= @inquiry.ready_to_build_quote? ? t("self_service.review.ready") : t("self_service.review.not_ready") %></strong></div>
    </header>
    <div class="inquiry-conversation__layout">
      <ol class="inquiry-timeline">
        <% @messages.each_with_index do |message, index| %>
          <li class="inquiry-message inquiry-message--<%= message.direction %>">
            <div class="inquiry-message__marker"><span><%= (index + 1).to_s.rjust(2, "0") %></span></div>
            <article>
              <header><strong><%= t("self_service.conversation.directions.#{message.direction}") %></strong><span><%= t("self_service.conversation.channels.#{message.channel}") %> · <%= message.occurred_at.strftime("%Y-%m-%d %H:%M") %></span></header>
              <div class="inquiry-message__body"><%= simple_format(message.body) %></div>
              <% summary = message.change_summary.deep_stringify_keys %>
              <% if summary["status"] == "queued" %><footer class="is-processing"><%= t("self_service.conversation.processing") %></footer>
              <% elsif summary["initial"] %><footer><%= t("self_service.conversation.initial") %></footer>
              <% elsif Array(summary["changed"]).any? || summary["products_before"] != summary["products_after"] %>
                <footer><strong><%= t("self_service.conversation.updated") %></strong><%= t("self_service.conversation.change_count", count: Array(summary["changed"]).size, products: summary["products_after"]) %></footer>
              <% else %><footer><%= t("self_service.conversation.evidence_only") %></footer><% end %>
            </article>
          </li>
        <% end %>
      </ol>
      <aside class="inquiry-followup">
        <p class="section-kicker"><%= t("self_service.conversation.add_kicker") %></p>
        <h3><%= t("self_service.conversation.add_title") %></h3>
        <p><%= t("self_service.conversation.add_help") %></p>
        <% if @clarification_questions.any? %><div class="inquiry-followup__prompts"><strong><%= t("self_service.conversation.prompt_title") %></strong><ul><% @clarification_questions.each do |question| %><li><%= question %></li><% end %></ul></div><% end %>
        <%= form_with model: [@inquiry, @message], class: "inquiry-followup__form", multipart: true do |f| %>
          <details class="inquiry-followup__advanced"><summary><%= t("self_service.conversation.advanced") %></summary><div class="inquiry-followup__meta"><%= f.select :direction, InquiryMessage::DIRECTIONS.map { |value| [t("self_service.conversation.directions.#{value}"), value] }, {}, class: "input" %><%= f.select :channel, InquiryMessage::CHANNELS.map { |value| [t("self_service.conversation.channels.#{value}"), value] }, {}, class: "input" %></div></details>
          <%= f.text_area :body, rows: 7, class: "textarea", placeholder: t("self_service.conversation.placeholder") %>
          <label class="inquiry-followup__file"><span><%= t("self_service.conversation.attachment") %></span><%= f.file_field :attachment, accept: ".pdf,.xlsx,.csv,.txt,application/pdf,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" %></label>
          <%= f.submit t("self_service.conversation.add"), class: "button button--primary button--full" %>
        <% end %>
      </aside>
    </div>
  </section>

  <%= form_with model: @inquiry, class: "inquiry-review__workspace" do |f| %>
    <section class="inquiry-source-panel" data-intake-motion-target="source">
      <header><div><p class="section-kicker"><%= t("self_service.review.original") %></p><h2><%= @inquiry.source_file.attached? ? @inquiry.source_file.filename : t("self_service.intake.#{@inquiry.source_type}", default: t("self_service.intake.text")) %></h2></div><span><%= t("self_service.review.source_truth") %></span></header>
      <div class="inquiry-source-panel__body"><%= simple_format(@inquiry.source_text, {}, wrapper_tag: "div") %></div>
      <% if @inquiry.source_file.attached? %><footer><%= t("self_service.review.file_retained", size: number_to_human_size(@inquiry.source_file.byte_size)) %></footer><% end %>
    </section>

    <section class="inquiry-results-panel">
      <div class="inquiry-review-section">
        <div class="inquiry-review-section__heading"><span>01</span><div><h2><%= t("self_service.review.buyer_heading") %></h2><p><%= t("self_service.review.buyer_help") %></p></div></div>
        <div class="inquiry-field-grid">
          <% [["customer", t("self_service.review.customer")], ["contact_name", t("self_service.review.contact")], ["contact_email", t("self_service.review.email")], ["country", t("self_service.review.country")], ["currency", t("self_service.review.currency")]].each do |key, label| %>
            <label class="extracted-field <%= data[key].present? ? 'is-confirmed' : 'is-missing' %>" data-intake-motion-target="field" data-action="click->intake-motion#focusSource">
              <span><%= label %><em><%= data[key].present? ? t("self_service.review.confirmed") : t("self_service.review.missing") %></em></span>
              <input class="input" name="inquiry[extracted_data][<%= key %>]" value="<%= data[key] %>" placeholder="<%= t("self_service.review.required") %>" />
              <% if evidence[key].present? %><small>“<%= evidence[key] %>”</small><% else %><small><%= t("self_service.review.no_evidence") %></small><% end %>
            </label>
          <% end %>
          <% terms = data.fetch("commercial_terms", {}) %>
          <% [["destination", t("self_service.review.destination")], ["incoterm", t("self_service.review.incoterm")], ["delivery", t("self_service.review.delivery")], ["packing", t("self_service.review.packing")]].each do |key, label| %>
            <label class="extracted-field <%= terms[key].present? ? 'is-uncertain' : 'is-missing' %>" data-intake-motion-target="field" data-action="click->intake-motion#focusSource">
              <span><%= label %><em><%= terms[key].present? ? t("self_service.review.uncertain") : t("self_service.review.missing") %></em></span>
              <input class="input" name="inquiry[extracted_data][commercial_terms][<%= key %>]" value="<%= terms[key] %>" placeholder="<%= t("self_service.review.manual") %>" />
              <small><%= evidence[key].present? ? "“#{evidence[key]}”" : t("self_service.review.no_evidence") %></small>
            </label>
          <% end %>
          <label class="extracted-field <%= terms["freight_amount"].to_d.positive? ? 'is-confirmed' : 'is-missing' %>"><span><%= t("self_service.review.freight") %> <em><%= terms["freight_amount"].to_d.positive? ? t("self_service.review.confirmed") : t("self_service.review.missing") %></em></span><input class="input" type="number" min="0" step="0.01" name="inquiry[extracted_data][commercial_terms][freight_amount]" value="<%= terms["freight_amount"] %>" placeholder="<%= t("self_service.review.required") %>"><small><%= t("self_service.review.ai_no_amount") %></small></label>
          <label class="extracted-field <%= terms["freight_source"].present? ? 'is-confirmed' : 'is-missing' %>"><span><%= t("self_service.review.freight_source") %> <em><%= terms["freight_source"].present? ? t("self_service.review.confirmed") : t("self_service.review.missing") %></em></span><select class="input" name="inquiry[extracted_data][commercial_terms][freight_source]"><option value=""><%= t("self_service.studio.select_source") %></option><% ["freight_forwarder_quote", "carrier_quote", "customer_account", "manually_entered"].each do |source| %><option value="<%= source %>" <%= "selected" if terms["freight_source"] == source %>><%= t("self_service.review.freight_sources.#{source}") %></option><% end %></select><small><%= t("self_service.review.freight_help") %></small></label>
        </div>
      </div>

      <div class="inquiry-review-section">
        <div class="inquiry-review-section__heading"><span>02</span><div><h2><%= t("self_service.review.products_heading") %></h2><p><%= t("self_service.review.products_help") %></p></div></div>
        <div class="inquiry-product-list" data-inquiry-review-target="products">
          <% Array(data["products"]).each_with_index do |product, index| %>
            <% recommended_match = Array(@catalog_matches[index]).first %>
            <% auto_match_id = recommended_match[:product].id if recommended_match && recommended_match[:score] >= 5 %>
            <article class="inquiry-product-card">
              <header><span><%= (index + 1).to_s.rjust(2, "0") %></span><div><input name="inquiry[extracted_data][products][<%= index %>][name]" value="<%= product["name"] %>" class="inquiry-product-card__name" /><small><%= product["evidence"].present? ? "#{t("self_service.review.source")}：“#{product['evidence']}”" : t("self_service.review.no_exact_source") %></small></div><strong class="status status--required"><%= product["unit_price"].to_d.positive? ? t("self_service.review.priced") : t("self_service.review.price_required") %></strong></header>
              <div class="inquiry-product-card__facts">
                <% [["model", t("self_service.review.model")], ["quantity", t("self_service.review.quantity")], ["unit", t("self_service.review.unit")], ["packing", t("self_service.review.packing")]].each do |key, label| %>
                  <label><span><%= label %></span><input class="input" name="inquiry[extracted_data][products][<%= index %>][<%= key %>]" value="<%= product[key] %>" /></label>
                <% end %>
              </div>
              <div class="inquiry-product-card__specs">
                <% %w[voltage color material].each do |key| %><label><span><%= t("self_service.review.#{key}") %></span><input class="input" name="inquiry[extracted_data][products][<%= index %>][specifications][<%= key %>]" value="<%= product.dig('specifications', key) %>" placeholder="<%= t("self_service.review.missing") %>" /></label><% end %>
              </div>
              <fieldset class="catalog-match"><legend><%= t("self_service.review.catalog_match") %></legend>
                <% Array(@catalog_matches[index]).each do |match| %>
                  <% catalog_product = match[:product] %>
                  <label class="catalog-candidate"><input type="radio" name="inquiry[extracted_data][products][<%= index %>][catalog_product_id]" value="<%= catalog_product.id %>" <%= "checked" if product["catalog_product_id"].to_i == catalog_product.id || (product["catalog_product_id"].blank? && auto_match_id == catalog_product.id) %>><span class="catalog-candidate__visual"><% if catalog_product.display_image.present? %><%= image_tag catalog_product.display_image, alt: "" %><% else %><b><%= catalog_product.name.first %></b><% end %></span><span><strong><%= catalog_product.name %></strong><small><%= catalog_product.sku %> · <%= match[:reasons].join(" · ") %></small></span><em><%= match[:score] >= 5 ? t("self_service.review.best_match") : t("self_service.review.candidate") %></em></label>
                <% end %>
                <label class="catalog-candidate"><input type="radio" name="inquiry[extracted_data][products][<%= index %>][catalog_product_id]" value="" <%= "checked" if product["catalog_product_id"].blank? && auto_match_id.blank? %>><span class="catalog-candidate__visual is-temporary">+</span><span><strong><%= t("self_service.review.deal_only") %></strong><small><%= t("self_service.review.deal_only_help") %></small></span></label>
                <label class="catalog-manual"><span><%= t("self_service.review.choose_other") %></span><select class="input" name="inquiry[extracted_data][products][<%= index %>][manual_catalog_product_id]" onchange="this.closest('fieldset').querySelectorAll('input[type=radio]').forEach(r=>r.checked=false); this.name=this.name.replace('manual_catalog_product_id','catalog_product_id')"><option value=""><%= t("self_service.review.select_manual") %></option><%= options_from_collection_for_select(@catalog_products, :id, :name) %></select></label>
              </fieldset>
              <div class="price-confirmation"><div><p class="section-kicker"><%= t("self_service.review.commercial") %></p><strong><%= t("self_service.review.ai_never_price") %></strong></div><label><span><%= t("self_service.review.unit_price") %></span><input class="input money-input" type="number" min="0" step="0.01" name="inquiry[extracted_data][products][<%= index %>][unit_price]" value="<%= product["unit_price"] %>" placeholder="<%= t("self_service.review.required") %>"></label><label><span><%= t("self_service.review.price_source") %></span><select class="input" name="inquiry[extracted_data][products][<%= index %>][price_source]"><option value=""><%= t("self_service.studio.select_source") %></option><% QuoteItem::PRICE_SOURCES.each do |source| %><option value="<%= source %>" <%= "selected" if product["price_source"] == source %>><%= t("self_service.review.price_sources.#{source}") %></option><% end %></select></label><label><span><%= t("self_service.review.buyer_control") %></span><select class="input" name="inquiry[extracted_data][products][<%= index %>][selection_mode]"><% QuoteItem::SELECTION_MODES.each do |mode| %><option value="<%= mode %>" <%= "selected" if product["selection_mode"] == mode %>><%= t("self_service.review.selection_modes.#{mode}") %></option><% end %></select></label></div>
            </article>
          <% end %>
        </div>
        <template data-inquiry-review-target="template">
          <article class="inquiry-product-card inquiry-product-card--new">
            <header><span>＋</span><div><input name="inquiry[extracted_data][products][NEW_INDEX][name]" class="inquiry-product-card__name" placeholder="商品名称" required><small><%= t("self_service.review.manual_product") %></small></div><button type="button" class="text-action" data-action="inquiry-review#removeProduct">移除</button></header>
            <div class="inquiry-product-card__facts"><label><span>Model</span><input class="input" name="inquiry[extracted_data][products][NEW_INDEX][model]"></label><label><span>数量</span><input class="input" type="number" min="1" name="inquiry[extracted_data][products][NEW_INDEX][quantity]" required></label><label><span>单位</span><input class="input" name="inquiry[extracted_data][products][NEW_INDEX][unit]" value="pcs"></label><label><span>包装</span><input class="input" name="inquiry[extracted_data][products][NEW_INDEX][packing]"></label></div>
            <div class="inquiry-product-card__specs"><label><span>电压</span><input class="input" name="inquiry[extracted_data][products][NEW_INDEX][specifications][voltage]"></label><label><span>颜色</span><input class="input" name="inquiry[extracted_data][products][NEW_INDEX][specifications][color]"></label><label><span>材质</span><input class="input" name="inquiry[extracted_data][products][NEW_INDEX][specifications][material]"></label></div>
            <input type="hidden" name="inquiry[extracted_data][products][NEW_INDEX][price_source]" value="unpriced">
          </article>
        </template>
        <button type="button" class="studio-add-product inquiry-add-product" data-action="inquiry-review#addProduct"><%= t("self_service.review.add_manual_product") %></button>
      </div>

      <div class="inquiry-review-section inquiry-review-section--questions">
        <div class="inquiry-review-section__heading"><span>03</span><div><h2><%= t("self_service.review.questions_heading") %></h2><p><%= t("self_service.review.questions_help") %></p></div></div>
        <div class="inquiry-field-grid"><label class="extracted-field"><span><%= t("self_service.review.buyer_questions") %></span><textarea class="textarea" name="inquiry[extracted_data][questions]"><%= Array(data["questions"]).join("\n") %></textarea></label><label class="extracted-field is-missing"><span><%= t("self_service.review.missing_information") %> <em><%= t("self_service.review.needs_review") %></em></span><textarea class="textarea" name="inquiry[extracted_data][missing_information]"><%= Array(data["missing_information"]).join("\n") %></textarea></label></div>
      </div>

      <footer class="inquiry-review__actions"><div><span><%= t("self_service.review.readiness") %></span><strong><%= @inquiry.ready_to_build_quote? ? t("self_service.review.ready") : t("self_service.review.not_ready") %></strong></div><%= f.submit t("self_service.review.save_review"), class: "button button--secondary" %><%= button_tag t("self_service.review.build_deal"), type: "submit", name: "build_deal", value: "1", class: "button button--primary", data: { intake_motion_target: "build", action: "intake-motion#build" } %></footer>
    </section>
  <% end %>
</main>
