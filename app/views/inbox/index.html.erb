<main class="deal-workspace inbox-page" data-controller="deal-motion">
  <header class="deal-page-header">
    <div><p class="eyebrow"><%= t("self_service.inbox.eyebrow") %></p><h1><%= t("self_service.inbox.title") %></h1><p><%= t("self_service.inbox.subtitle") %></p></div>
    <div class="deal-header-actions"><%= link_to t("self_service.inbox.import"), new_inquiry_path, class: "button button--secondary" %><%= link_to t("self_service.inbox.new_deal"), new_inquiry_path(mode: "manual"), class: "button button--primary" %></div>
  </header>

  <section class="deal-metrics" aria-label="<%= t('self_service.inbox.summary') %>">
    <article><span><%= t("self_service.inbox.attention") %></span><strong data-deal-motion-target="number"><%= @metrics[:attention] %></strong></article>
    <article><span><%= t("self_service.inbox.live_value") %></span><strong data-deal-motion-target="number"><%= current_user.company.default_currency %> <%= number_with_delimiter(@metrics[:live_value]) %></strong></article>
    <article><span><%= t("self_service.inbox.accepted") %></span><strong data-deal-motion-target="number"><%= @metrics[:accepted] %></strong></article>
    <article><span><%= t("self_service.inbox.won") %></span><strong data-deal-motion-target="number"><%= @metrics[:won] %></strong></article>
  </section>

  <section class="inbox-stream">
    <header><div><p class="section-kicker"><%= t("self_service.inbox.now") %></p><h2><%= t("self_service.inbox.needs_decision", count: @attention.size) %></h2></div><%= link_to t("self_service.inbox.view_all"), deals_path, class: "text-action" %></header>
    <% @attention.each do |deal, progress| %>
      <article class="inbox-event" data-deal-motion-target="item">
        <div class="inbox-event__signal"><i></i><time><%= t("self_service.inbox.ago", time: time_ago_in_words(progress.signal_at || deal.updated_at)) %></time></div>
        <div><span><%= deal.customer&.name || t("self_service.inbox.buyer_pending") %></span><h3><%= deal_title(deal) %></h3><p><%= progress.signal %></p></div>
        <div class="inbox-event__amount"><span><%= progress.stage_label %></span><strong><%= deal.currency %> <%= number_with_delimiter(deal.grand_total) %></strong></div>
        <%= link_to progress.action_label, deal_action_path(deal, progress), class: "button button--primary" %>
      </article>
    <% end %>
    <% if @attention.empty? %><div class="deal-zero"><span>✓</span><h2><%= t("self_service.inbox.clear_title") %></h2><p><%= t("self_service.inbox.clear_body") %></p><%= link_to t("self_service.inbox.import"), new_inquiry_path, class: "button button--primary" %></div><% end %>
  </section>

  <% if @waiting.any? %><section class="waiting-strip"><header><p class="section-kicker"><%= t("self_service.inbox.waiting") %></p><h2><%= t("self_service.inbox.waiting_title") %></h2></header><div><% @waiting.first(6).each do |deal, progress| %><%= link_to deal_path(deal), class: "waiting-deal" do %><span><%= deal.customer.name %></span><strong><%= deal_title(deal) %></strong><small><%= progress.signal %> · <%= t("self_service.inbox.ago", time: time_ago_in_words(progress.signal_at || deal.updated_at)) %></small><% end %><% end %></div></section><% end %>
</main>
