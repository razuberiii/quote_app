<%= render "components/ui/card", class: "sales-insight-card sales-insight-card--dual app-surface" do %>
  <h3 class="sales-insight-card__title"><%= t("analytics.win_loss_distribution.title") %></h3>
  <div class="sales-insight-card__body sales-insight-win-loss-dual">
    <div class="sales-insight-subsection is-win-pane">
      <h4><%= t("analytics.win_loss_distribution.wins_title") %></h4>
      <% if @analytics_win_loss_top.dig(:wins, :rows).present? %>
        <ul class="sales-insight-dist-list">
          <% @analytics_win_loss_top[:wins][:rows].each do |row| %>
            <li class="sales-insight-dist-item">
              <span class="sales-insight-dist-label"><%= row[:label] %></span>
              <span class="sales-insight-dist-bar-wrap">
                <% win_bar_width = row[:pct].to_i.positive? ? [row[:pct].to_i, 4].max : 0 %>
                <span class="sales-insight-dist-bar is-win" style="width:<%= win_bar_width %>%"></span>
              </span>
              <span class="sales-insight-dist-pct"><%= row[:pct] %>%</span>
              <span class="sales-insight-dist-count">(<%= row[:count] %>)</span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="app-empty-note"><%= t("analytics.win_loss_distribution.no_wins") %></p>
      <% end %>
    </div>
    <div class="sales-insight-subsection is-loss-pane">
      <h4><%= t("analytics.win_loss_distribution.losses_title") %></h4>
      <% if @analytics_win_loss_top.dig(:losses, :rows).present? %>
        <ul class="sales-insight-dist-list">
          <% @analytics_win_loss_top[:losses][:rows].each do |row| %>
            <li class="sales-insight-dist-item">
              <span class="sales-insight-dist-label"><%= row[:label] %></span>
              <span class="sales-insight-dist-bar-wrap">
                <% loss_bar_width = row[:pct].to_i.positive? ? [row[:pct].to_i, 4].max : 0 %>
                <span class="sales-insight-dist-bar is-loss" style="width:<%= loss_bar_width %>%"></span>
              </span>
              <span class="sales-insight-dist-pct"><%= row[:pct] %>%</span>
              <span class="sales-insight-dist-count">(<%= row[:count] %>)</span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="app-empty-note"><%= t("analytics.win_loss_distribution.no_losses") %></p>
      <% end %>
    </div>
  </div>
<% end %>

<%= render "components/ui/card", class: "sales-insight-card app-surface" do %>
  <h3 class="sales-insight-card__title"><%= t("analytics.revision_depth.title") %></h3>
  <div class="sales-insight-card__body">
    <% if @analytics_revision.any? %>
      <% revision_rows = @analytics_revision.map { |row| row.symbolize_keys } %>
      <% total_wins = revision_rows.sum { |row| row[:wins].to_i } %>
      <% avg_won_revision = if total_wins.positive?
                              (revision_rows.sum { |row| row[:revision_number].to_i * row[:wins].to_i }.to_f / total_wins).round(1)
                            else
                              0
                            end %>
      <% first_revision = revision_rows.find { |row| row[:revision_number].to_i == 1 } || { wins: 0, total: 0 } %>
      <% first_win_rate = first_revision[:total].to_i.positive? ? ((first_revision[:wins].to_f / first_revision[:total].to_i) * 100).round : 0 %>
      <% multi_revision_wins = revision_rows.reject { |row| row[:revision_number].to_i == 1 }.sum { |row| row[:wins].to_i } %>
      <% multi_win_share = total_wins.positive? ? ((multi_revision_wins.to_f / total_wins) * 100).round : 0 %>
      <div class="sales-insight-summary-strip">
        <article class="sales-insight-summary-cell">
          <span><%= t("analytics.revision_depth.summary_avg_won_revision", default: "Avg won revision") %></span>
          <strong><%= avg_won_revision %></strong>
        </article>
        <article class="sales-insight-summary-cell">
          <span><%= t("analytics.revision_depth.summary_first_win_rate", default: "First-revision win rate") %></span>
          <strong><%= first_win_rate %>%</strong>
        </article>
        <article class="sales-insight-summary-cell">
          <span><%= t("analytics.revision_depth.summary_multi_win_share", default: "Multi-revision win share") %></span>
          <strong><%= multi_win_share %>%</strong>
        </article>
      </div>
      <div class="table-responsive">
        <%= render "components/ui/table", class: "dashboard-recent-table dashboard-summary-table dashboard-analysis-table app-table-surface sales-insight-table-surface", table_class: "dashboard-recent-table dashboard-summary-table dashboard-analysis-table app-data-table" do %>
          <thead>
            <tr>
              <th><%= t("analytics.revision_depth.revision") % { n: "#" } %></th>
              <th class="text-right"><%= t("analytics.revision_depth.total") %></th>
              <th class="text-right"><%= t("analytics.revision_depth.wins") %></th>
              <th class="text-right"><%= t("analytics.revision_depth.win_rate") %></th>
            </tr>
          </thead>
          <tbody>
            <% @analytics_revision.each do |row| %>
              <tr>
                <td data-label="<%= t("analytics.revision_depth.revision") % { n: "#" } %>"><%= t("analytics.revision_depth.revision", n: row[:revision_number]) %></td>
                <td class="text-right" data-label="<%= t("analytics.revision_depth.total") %>"><%= row[:total] %></td>
                <td class="text-right" data-label="<%= t("analytics.revision_depth.wins") %>"><%= row[:wins] %></td>
                <td class="text-right sales-insight-winrate <%= row[:win_rate].to_f >= 50 ? 'is-good' : '' %>" data-label="<%= t("analytics.revision_depth.win_rate") %>">
                  <span class="sales-insight-winrate-cell">
                    <span class="sales-insight-winrate-track" role="presentation" aria-hidden="true">
                      <% win_rate_width = row[:win_rate].to_i.positive? ? [[row[:win_rate].to_i, 4].max, 100].min : 0 %>
                      <span class="sales-insight-winrate-fill <%= row[:win_rate].to_f >= 50 ? 'is-good' : 'is-muted' %>" style="width: <%= win_rate_width %>%"></span>
                    </span>
                    <strong><%= row[:win_rate] %>%</strong>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        <% end %>
      </div>
    <% else %>
      <p class="app-empty-note"><%= t("analytics.revision_depth.no_data") %></p>
    <% end %>
  </div>
<% end %>
