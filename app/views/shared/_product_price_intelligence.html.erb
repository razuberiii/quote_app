<% if @average_quoted_price.present? || @recent_quoted_prices&.any? %>
<div class="product-price-intelligence-panel">
  <div class="price-header">
    <div>
      <h4><%= t("price_intelligence.average_price") %></h4>
      <% if @quote_reference_count.to_i > 0 %>
        <span class="price-intel-count"><%= t("price_intelligence.based_on_count", count: @quote_reference_count) %></span>
      <% end %>
    </div>
    <span class="price-value">
      <%= @average_quoted_price.present? ? quote_money(@average_quoted_price, @product.price_currency) : "—" %>
    </span>
  </div>

  <% if @recent_quoted_prices.any? %>
  <div class="recent-quotes-section">
    <h5><%= t("price_intelligence.recent_quotes") %></h5>
    <div class="price-intel-list">
      <% @recent_quoted_prices.each do |item| %>
        <% display_name = item.custom_title.presence || item.customer_name.presence || item.quote_no %>
        <%= link_to quote_path(item.quote_id), class: "price-intel-card" do %>
          <div class="price-intel-card-main">
            <strong class="price-intel-card-title"><%= display_name %></strong>
            <div class="price-intel-card-subline">
              <span class="price-intel-card-id"><%= item.quote_no %></span>
              <% if item.customer_name.present? && item.customer_name != display_name %>
                <span class="price-intel-card-dot">•</span>
                <span><%= item.customer_name %></span>
              <% end %>
            </div>
          </div>
          <div class="price-intel-card-stats">
            <span><%= t("price_intelligence.unit_price") %>: <strong><%= quote_money(item.unit_price, item.currency || @product.price_currency) %></strong></span>
            <span><%= t("price_intelligence.qty") %>: <strong><%= item.quantity %></strong></span>
            <span><%= t("price_intelligence.date") %>: <strong><%= l(item.updated_at.to_date) %></strong></span>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
  <% end %>
</div>
<% end %>
