<section class="app-page-shell app-page-shell--form app-page-shell--customer-form">
  <header class="app-page-header">
    <div class="app-page-header-main">
      <h1><%= t("customers.view.edit.title", name: @customer.name) %></h1>
      <p><%= t("customers.view.edit.subtitle", default: t("customers.view.show.subtitle")) %></p>
    </div>
  </header>

  <%= render "form", customer: @customer, submit_label: t("customers.view.edit.update_customer") %>

  <%= link_to t("customers.view.edit.back_to_customer"), @customer, class: "form-page-back-link" %>
</section>
