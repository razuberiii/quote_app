<%= render "components/ui/card", class: "dashboard-panel app-surface dashboard-onboarding-card" do %>
  <% steps = [
    {
      key: :account_profile,
      label: t("dashboard.onboarding.quick_start.steps.account_profile.label"),
      detail: t("dashboard.onboarding.quick_start.steps.account_profile.detail"),
      action_label: t("dashboard.onboarding.quick_start.steps.account_profile.action"),
      action_path: edit_user_registration_path
    },
    {
      key: :company_profile,
      label: t("dashboard.onboarding.quick_start.steps.company_profile.label"),
      detail: t("dashboard.onboarding.quick_start.steps.company_profile.detail"),
      action_label: t("dashboard.onboarding.quick_start.steps.company_profile.action"),
      action_path: edit_company_settings_path
    },
    {
      key: :customer,
      label: t("dashboard.onboarding.quick_start.steps.customer.label"),
      detail: t("dashboard.onboarding.quick_start.steps.customer.detail"),
      action_label: t("dashboard.onboarding.quick_start.steps.customer.action"),
      action_path: new_customer_path
    },
    {
      key: :product,
      label: t("dashboard.onboarding.quick_start.steps.product.label"),
      detail: t("dashboard.onboarding.quick_start.steps.product.detail"),
      action_label: t("dashboard.onboarding.quick_start.steps.product.action"),
      action_path: new_product_path
    },
    {
      key: :quote,
      label: t("dashboard.onboarding.quick_start.steps.quote.label"),
      detail: t("dashboard.onboarding.quick_start.steps.quote.detail"),
      action_label: t("dashboard.onboarding.quick_start.steps.quote.action"),
      action_path: @quick_create_quote_path
    },
    {
      key: :shared,
      label: t("dashboard.onboarding.quick_start.steps.shared.label"),
      detail: t("dashboard.onboarding.quick_start.steps.shared.detail"),
      action_label: t("dashboard.onboarding.quick_start.steps.shared.action"),
      action_path: customers_path
    },
    {
      key: :viewed,
      label: t("dashboard.onboarding.quick_start.steps.viewed.label"),
      detail: t("dashboard.onboarding.quick_start.steps.viewed.detail"),
      action_label: nil,
      action_path: nil
    }
  ].tap { |items| items.delete_if { |step| step[:key] == :company_profile && !current_user.can_manage_templates? } } %>
  <% completed_count = steps.count { |step| @onboarding[step[:key]] } %>

  <div class="dashboard-onboarding-head">
    <div>
      <h2><%= t("dashboard.onboarding.quick_start.title") %></h2>
      <p class="dashboard-onboarding-subtitle"><%= t("dashboard.onboarding.quick_start.subtitle") %></p>
      <p class="dashboard-onboarding-progress"><%= t("dashboard.onboarding.quick_start.progress", count: completed_count, total: steps.length) %></p>
      <p class="dashboard-onboarding-shortcuts">
        <span><%= t("dashboard.onboarding.quick_start.shortcut_hint") %></span>
        <span class="dashboard-onboarding-shortcut-item"><kbd>?</kbd> <%= t("dashboard.onboarding.quick_start.shortcut_help") %></span>
        <span class="dashboard-onboarding-shortcut-item"><kbd>Cmd/Ctrl+K</kbd> <%= t("dashboard.onboarding.quick_start.shortcut_palette") %></span>
      </p>
    </div>

    <%= button_to t("dashboard.onboarding.quick_start.dismiss"), dismiss_onboarding_path, method: :patch, class: ui_button_classes(:ghost, "dashboard-onboarding-dismiss") %>
  </div>

  <div class="dashboard-onboarding-steps">
    <% steps.each do |step| %>
      <% done = @onboarding[step[:key]] %>
      <div class="dashboard-onboarding-step">
        <div class="dashboard-onboarding-step-main">
          <span class="dashboard-onboarding-step-icon <%= done ? 'is-done' : 'is-pending' %>">
            <%= done ? "✔" : "⬜" %>
          </span>
          <div>
            <p class="dashboard-onboarding-step-label <%= 'is-done' if done %>"><%= step[:label] %></p>
            <p class="dashboard-onboarding-step-detail"><%= step[:detail] %></p>
          </div>
        </div>

        <% if !done && step[:action_label].present? %>
          <%= render "components/ui/button", href: step[:action_path], variant: :secondary, class: "dashboard-onboarding-step-action" do %>
            <%= step[:action_label] %>
          <% end %>
        <% elsif done %>
          <span class="dashboard-onboarding-step-state is-done"><%= t("dashboard.onboarding.quick_start.done") %></span>
        <% else %>
          <span class="dashboard-onboarding-step-state"><%= t("dashboard.onboarding.quick_start.waiting") %></span>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
