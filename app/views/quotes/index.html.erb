<main class="deal-workspace quote-core-index quote-home">
  <header class="quote-home__bar">
    <h1>报价</h1>
    <% if @quote_rows.any? %><div class="quote-home__bar-actions"><%= link_to "继续处理客户需求（#{@open_inquiry_count}）", inquiries_path, class: "button button--secondary" if @open_inquiry_count.positive? %><%= link_to "新建报价", new_quote_path, class: "button button--primary" %></div><% end %>
  </header>

  <% if @quote_rows.any? %>
    <form class="quote-core-filters quote-home__filters" method="get">
    <label>
      <span>搜索</span>
      <input type="search" name="q" value="<%= params[:q] %>" placeholder="搜索报价、客户、商品">
    </label>
    <nav aria-label="报价状态">
      <% [
        ["all", "全部"],
        ["draft", "草稿"],
        ["sent", "等待客户"],
        ["changes", "客户有反馈"],
        ["accepted", "已接受"],
        ["expired", "已结束"]
      ].each do |status, label| %>
        <%= link_to label, quotes_path(q: params[:q], status: (status unless status == "all")),
          class: ("is-active" if (params[:status].presence || "all") == status) %>
      <% end %>
    </nav>
    </form>

    <section class="quote-core-list quote-home__list">
      <header>
      <span>报价名称</span>
      <span>客户</span>
      <span>金额</span>
      <span>版本</span>
      <span>更新时间</span>
      <span>状态</span>
      <span></span>
      </header>
      <% @quote_rows.each do |quote, lifecycle| %>
      <% latest_revision = quote.quote_revisions.where.not(published_at: nil).ordered.first %>
      <% customer_link = latest_revision ? buyer_room_url(latest_revision.secure_token) : nil %>
      <article class="<%= "has-attention" if lifecycle.attention %>">
        <%= link_to quote_path(quote), class: "quote-core-identity" do %>
          <small><%= quote.quote_no %></small>
          <strong><%= deal_title(quote) %></strong>
          <span><%= lifecycle.signal %></span>
        <% end %>
        <div class="quote-core-customer">
          <% if quote.customer.present? %>
            <%= link_to quote.customer.name, customer_path(quote.customer) %>
            <span><%= quote.customer.contact_name.presence || quote.customer.email %></span>
          <% else %>
            <strong><%= t("self_service.quote_core.index.customer_missing") %></strong>
          <% end %>
        </div>
        <strong class="quote-core-amount"><%= quote.currency %> <%= number_with_delimiter(quote.grand_total) %></strong>
        <span class="quote-core-version"><%= latest_revision ? "V#{latest_revision.number}" : "草稿" %></span>
        <span class="quote-core-time"><%= time_ago_in_words(quote.updated_at) %>前</span>
        <div class="quote-core-state">
          <span class="quote-state quote-state--<%= lifecycle.state %>"><i></i><%= lifecycle.label %></span>
          <small><%= lifecycle.attention ? "需要处理" : "正常" %></small>
        </div>
        <div class="quote-row-actions">
          <%= link_to lifecycle.action_label, quote_action_path(quote, lifecycle), class: "deal-next" %>
          <details class="quote-row-menu">
            <summary>...</summary>
            <div>
              <%= link_to "复制报价", new_quote_path(source_quote_id: quote.id) %>
              <% if customer_link %>
                <button type="button"
                  data-controller="clipboard"
                  data-clipboard-text-value="<%= customer_link %>"
                  data-clipboard-success-message-value="客户链接已复制"
                  data-action="clipboard#copy">复制客户链接</button>
              <% end %>
              <%= link_to "记录线下接受", new_acceptance_quote_path(quote, version_id: latest_revision&.id) if latest_revision && !quote.quote_acceptance %>
            </div>
          </details>
        </div>
        </article>
      <% end %>
    </section>
  <% else %>
    <section class="first-quote-launch">
      <% if @open_inquiry_count.positive? %>
        <p class="eyebrow">客户需求已保存</p><h2>继续核对并生成报价</h2>
        <p>你有 <%= @open_inquiry_count %> 条客户需求正在处理中。打开后确认客户、商品和数量，就能生成报价草稿。</p>
        <div class="first-quote-launch__actions"><%= link_to "继续处理客户需求（#{@open_inquiry_count}）", inquiries_path, class: "button button--primary" %><%= link_to "开始另一份报价", new_quote_path, class: "button button--secondary" %></div>
        <small>客户原文和系统整理结果都已保存，可以随时回来继续。</small>
      <% else %>
        <p class="eyebrow">第一份报价</p><h2>从客户发来的内容开始</h2>
        <p>安装聊天插件后，在 WhatsApp Web 或 Alibaba 国际站打开客户会话，就能持续同步消息并准备报价草稿。</p>
        <div class="first-quote-launch__actions"><%= link_to "连接聊天插件", chat_integration_path, class: "button button--primary" %><%= link_to "查看其他开始方式", new_quote_path(manual: 1, anchor: "manual-options"), class: "button button--secondary" %></div>
        <small>无需先整理聊天记录；粘贴、上传文件和手工创建仍然可用。</small>
      <% end %>
    </section>
  <% end %>
</main>
