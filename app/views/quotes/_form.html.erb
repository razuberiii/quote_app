          <input type="hidden" name="quote[quote_items_attributes][${index}][item_image_blob_id]" class="js-item-image-blob-id" value="">
          <input type="hidden" name="quote[quote_items_attributes][${index}][remove_item_image]" class="js-remove-item-image" value="0">
          <div class="quote-item-image-tools">
            <button
              type="button"
              class="quote-kv-open js-open-image-editor"
              data-label-add="${escapeAttr(uiText.addImage)}"
              data-label-change="${escapeAttr(uiText.changeImage)}"
            >${escapeHtml(uiText.addImage)}</button>
          </div>
          <div class="quote-kv-editor js-item-image-editor" data-kind="image" hidden>
            <div class="quote-kv-editor-head">
              <strong>${escapeHtml(uiText.itemImage)}</strong>
              <button type="button" class="quote-kv-close js-kv-close">${escapeHtml(uiText.close)}</button>
            </div>
            <div class="quote-item-image-gallery js-item-image-gallery"></div>
            <p class="quote-form-hint js-item-image-gallery-empty" hidden>${escapeHtml(uiText.productGalleryEmpty)}</p>
            <div class="quote-item-image-current js-item-image-current is-empty">
              <p class="quote-item-image-current-label">${escapeHtml(uiText.currentSelectedImage)}</p>
              <img src="" class="quote-item-current-thumb js-item-image-thumb" alt="${escapeHtml(uiText.itemImagePreview)}" hidden>
              <span class="quote-form-hint js-item-image-empty-hint">${escapeHtml(uiText.noImageSelected)}</span>
            </div>
            <div class="quote-item-image-upload">
              <input type="file" accept="image/png,image/jpeg,image/webp,image/gif" class="quote-item-image-upload-input js-item-image-upload" name="quote[quote_items_attributes][${index}][item_image]">
            </div>
            <div class="quote-kv-actions">
              <button type="button" class="quote-kv-clear js-item-image-remove">${escapeHtml(uiText.removeImage)}</button>
            </div>
          </div>
          <input type="hidden" name="quote[quote_items_attributes][${index}][description]" class="js-description" value="${escapeAttr(presetDescription)}">
        </td>
        <td class="quote-col-specs">
          <select class="js-spec-preset-select quote-inline-select app-ui-input" data-default-id="">
            <option value="">${escapeHtml(uiText.customSpecs)}</option>
          </select>
          <textarea rows="2" class="js-specifications sr-only-input" name="quote[quote_items_attributes][${index}][specifications_text]" placeholder="Power: 5kW&#10;Voltage: 220V" hidden>${escapeHtml(presetSpecs)}</textarea>
          <div class="quote-kv-summary js-spec-summary"
               data-controller="sortable"
               data-sortable-enabled-value="true"
               data-sortable-draggable-selector-value=".quote-kv-chip"
               data-sortable-filter-value=".quote-kv-summary-empty"></div>
          <button type="button" class="quote-kv-open js-open-spec-editor">${escapeHtml(uiText.editSpecs)}</button>
          <div class="quote-kv-editor js-spec-editor" data-kind="spec" hidden>
            <div class="quote-kv-editor-head">
              <strong>${escapeHtml(uiText.specifications)}</strong>
              <button type="button" class="quote-kv-close js-kv-close">${escapeHtml(uiText.close)}</button>
            </div>
            <div class="quote-kv-bulk">
              <textarea class="quote-kv-bulk-input js-spec-bulk-input" rows="3" placeholder="${escapeHtml(uiText.specBulkPlaceholder)}"></textarea>
              <div class="quote-kv-bulk-actions">
                <button type="button" class="quote-kv-parse js-spec-bulk-apply">${escapeHtml(uiText.applyText)}</button>
                <span class="quote-kv-bulk-check js-spec-bulk-check" aria-live="polite"></span>
              </div>
            </div>
            <div class="quote-kv-rows js-kv-rows">
              ${createSpecRow()}
            </div>
            <div class="quote-kv-actions">
              <button type="button" class="quote-kv-add js-kv-add">${escapeHtml(uiText.addSpec)}</button>
              <button type="button" class="quote-kv-clear js-kv-clear-all">${escapeHtml(uiText.clearAll)}</button>
            </div>
          </div>
        </td>
        <td class="quote-col-addons">
          <select class="js-addon-preset-select quote-inline-select app-ui-input" data-default-id="">
            <option value="">${escapeHtml(uiText.customAddOns)}</option>
          </select>
          <textarea rows="2" class="js-addon-charges sr-only-input" name="quote[quote_items_attributes][${index}][addon_charges_text]" placeholder="Packaging: 30&#10;Installation: 120" hidden>${escapeHtml(presetAddons)}</textarea>
          <div class="quote-kv-summary js-addon-summary"
               data-controller="sortable"
               data-sortable-enabled-value="true"
               data-sortable-draggable-selector-value=".quote-kv-chip"
               data-sortable-filter-value=".quote-kv-summary-empty"></div>
          <button type="button" class="quote-kv-open js-open-addon-editor">${escapeHtml(uiText.editAddOns)}</button>
          <div class="quote-kv-editor js-addon-editor" data-kind="addon" hidden>
            <div class="quote-kv-editor-head">
              <strong>${escapeHtml(uiText.addOns)}</strong>
              <button type="button" class="quote-kv-close js-kv-close">${escapeHtml(uiText.close)}</button>
            </div>
            <div class="quote-kv-bulk">
              <textarea class="quote-kv-bulk-input js-addon-bulk-input" rows="3" placeholder="${escapeHtml(uiText.addonBulkPlaceholder)}"></textarea>
              <div class="quote-kv-bulk-actions">
                <button type="button" class="quote-kv-parse js-addon-bulk-apply">${escapeHtml(uiText.applyText)}</button>
                <span class="quote-kv-bulk-check js-addon-bulk-check" aria-live="polite"></span>
              </div>
            </div>
            <div class="quote-kv-rows js-kv-rows">
              ${createAddonRow()}
            </div>
            <div class="quote-kv-actions">
              <button type="button" class="quote-kv-add js-kv-add">${escapeHtml(uiText.addAddOn)}</button>
              <button type="button" class="quote-kv-clear js-kv-clear-all">${escapeHtml(uiText.clearAll)}</button>
            </div>
          </div>
        </td>
        <td class="quote-col-price">
          <input type="number" step="0.01" name="quote[quote_items_attributes][${index}][unit_price]" class="js-unit-price app-ui-input" placeholder="0.00" value="${escapeAttr(presetUnitPrice)}">
        </td>
        <td class="quote-col-qty">
          <input type="number" min="1" value="${escapeAttr(String(presetQuantity))}" name="quote[quote_items_attributes][${index}][quantity]" class="js-quantity app-ui-input">
        </td>
        <td class="quote-col-remove">
          <input type="hidden" name="quote[quote_items_attributes][${index}][_destroy]" value="0" class="js-destroy-flag">
          <button type="button" class="quote-item-remove-icon js-remove-item" aria-label="Remove item">&times;</button>
        </td>
      `;

      body.appendChild(tr);
      bindRow(tr);
      updateTotalsUI();
      window.setTimeout(() => tr.classList.remove("is-new"), 420);
    }

    activeQuoteItemRows().forEach(bindRow);
    if (addBtn) addBtn.addEventListener("click", addRow);
    if (advancedModeToggleBtn) {
      advancedModeToggleBtn.addEventListener("click", () => {
        const nextEnabled = !advancedModeEnabled();
        setAdvancedMode(nextEnabled);
        if (nextEnabled) {
          applyDefaultAdvancedPresets();
          window.showAppToast?.("<%= j t("quotes.view.form.extended_scenario_applied", default: "Extended modules enabled.") %>", "success");
        } else {
          window.showAppToast?.("<%= j t("quotes.view.form.extended_scenario_disabled", default: "Extended modules disabled.") %>", "success");
        }
      });
    }
    if (insertFeeItemsBtn) {
      insertFeeItemsBtn.addEventListener("click", () => {
        const feePresetResult = resolveSelectedFeePreset();
        if (feePresetResult.status !== "selected") {
          const message = feePresetResult.status === "selected_but_no_rows"
            ? "<%= j t('quotes.view.form.standard_fee_items_empty_rows', default: 'Selected preset has no valid fee rows. Configure rows in Quote Presets / Standard Fee Items.') %>"
            : "<%= j t('quotes.view.form.standard_fee_items_not_selected', default: 'Select a standard logistics fee preset first') %>";
          window.showAppToast?.(message, "warn");
          return;
        }
        feePresetResult.rows.forEach((feeItem) => addRow(feeItem));
      });
    }

    Object.entries(quoteMasterPresetMap || {}).forEach(([moduleKey, presetId]) => {
      const select = form?.querySelector(`#quote-module-preset-${moduleKey}`);
      if (!select || !presetId) return;
      if (String(select.value || "").trim() !== "") return;
      select.value = String(presetId);
      syncSearchableSelectInput(select);
    });
    const standardFeePresetSelect = feePresetSelectNode();
    if (standardFeePresetSelect && String(standardFeePresetSelect.value || "").trim() === "") {
      const firstOption = Array.from(standardFeePresetSelect.options || []).find((option) => String(option.value || "").trim() !== "");
      if (firstOption) {
        standardFeePresetSelect.value = firstOption.value;
        syncSearchableSelectInput(standardFeePresetSelect);
      }
    }

    if (!quotePersisted) {
      if (String(form?.querySelector("#quote-module-preset-business_terms")?.value || "").trim()) {
        applyModulePreset("business_terms", { silent: true });
      }
      if (advancedModeEnabled()) {
        applyDefaultAdvancedPresets();
      }
    }

    modulePresetSelects.forEach((select) => {
      select.addEventListener("change", () => {
        const moduleKey = String(select.id || "").replace("quote-module-preset-", "").trim();
        if (!moduleKey) return;
        if (String(select.value || "").trim().length === 0) {
          clearModulePresetContent(moduleKey);
          return;
        }
        applyModulePreset(moduleKey);
      });
    });

    if (formalClosingSellerSignatureUploadInput) {
      formalClosingSellerSignatureUploadInput.addEventListener("change", () => {
        if (formalClosingSellerSignatureBlobInput) formalClosingSellerSignatureBlobInput.value = "";
        if (formalClosingSellerSignatureRemoveInput) formalClosingSellerSignatureRemoveInput.value = "0";
        const file = formalClosingSellerSignatureUploadInput.files?.[0];
        if (!file) return;
        const previewUrl = URL.createObjectURL(file);
        setFormalClosingImage("signature", { imageUrl: previewUrl, blobSignedId: "" });
      });
    }
    if (formalClosingSellerStampUploadInput) {
      formalClosingSellerStampUploadInput.addEventListener("change", () => {
        if (formalClosingSellerStampBlobInput) formalClosingSellerStampBlobInput.value = "";
        if (formalClosingSellerStampRemoveInput) formalClosingSellerStampRemoveInput.value = "0";
        const file = formalClosingSellerStampUploadInput.files?.[0];
        if (!file) return;
        const previewUrl = URL.createObjectURL(file);
        setFormalClosingImage("stamp", { imageUrl: previewUrl, blobSignedId: "" });
      });
    }
    formalClosingSellerSignatureRemoveBtn?.addEventListener("click", () => {
      if (formalClosingSellerSignatureUploadInput) formalClosingSellerSignatureUploadInput.value = "";
      if (formalClosingSellerSignatureBlobInput) formalClosingSellerSignatureBlobInput.value = "";
      setFormalClosingImage("signature", { imageUrl: "", blobSignedId: "", markRemoved: true });
    });
    formalClosingSellerStampRemoveBtn?.addEventListener("click", () => {
      if (formalClosingSellerStampUploadInput) formalClosingSellerStampUploadInput.value = "";
      if (formalClosingSellerStampBlobInput) formalClosingSellerStampBlobInput.value = "";
      setFormalClosingImage("stamp", { imageUrl: "", blobSignedId: "", markRemoved: true });
    });

    form?.addEventListener("click", (event) => {
      const clearBtn = event.target.closest(".js-clear-module-preset");
      if (!clearBtn) return;
      const moduleKey = String(clearBtn.dataset.moduleKey || "").trim();
      if (!moduleKey) return;
      const select = form?.querySelector(`#quote-module-preset-${moduleKey}`);
      if (select) {
        select.value = "";
        syncSearchableSelectInput(select);
        select.dispatchEvent(new CustomEvent("searchable-select:reset", { bubbles: true }));
      }
      clearModulePresetContent(moduleKey, { silent: false });
    });

    if (addConfigurationRowBtn && configurationRowsContainer) {
      addConfigurationRowBtn.addEventListener("click", () => {
        const index = configurationRowsContainer.querySelectorAll(".js-configuration-row").length;
        configurationRowsContainer.insertAdjacentHTML("beforeend", newConfigurationRowHtml(index));
        refreshConfigurationRows();
      });
      configurationRowsContainer.addEventListener("click", (event) => {
        const removeBtn = event.target.closest(".js-config-row-remove");
        if (!removeBtn) return;
        removeBtn.closest(".js-configuration-row")?.remove();
        refreshConfigurationRows();
      });
      configurationRowsContainer.addEventListener("input", refreshConfigurationRows);
      configurationRowsContainer.addEventListener("change", refreshConfigurationRows);
    }

    if (detailPictureRowsContainer) {
      detailPictureRowsContainer.addEventListener("click", (event) => {
        const removeBtn = event.target.closest(".js-detail-picture-row-remove");
        if (!removeBtn) return;
        const row = removeBtn.closest(".js-detail-picture-row");
        const blobId = String(row?.querySelector(".js-detail-picture-blob")?.value || "").trim();
        row?.remove();
        if (blobId && detailGalleryGrid) {
          const galleryCard = detailGalleryGrid.querySelector(`.js-detail-gallery-card[data-blob-id='${CSS.escape(blobId)}']`);
          if (galleryCard) setDetailGalleryCardSelectedState(galleryCard, false);
        }
        refreshDetailPictureRows();
      });
      detailPictureRowsContainer.addEventListener("input", refreshDetailPictureRows);
      detailPictureRowsContainer.addEventListener("change", refreshDetailPictureRows);
    }

    if (detailPictureBatchUploadInput) {
      detailPictureBatchUploadInput.addEventListener("change", () => {
        renderDetailBatchPreview();
        refreshDetailPictureRows();
      });
    }
    if (detailBatchPreview) {
      detailBatchPreview.addEventListener("click", (event) => {
        const removeBtn = event.target.closest(".js-detail-batch-remove");
        if (!removeBtn) return;
        const index = parseInt(removeBtn.dataset.uploadIndex || "-1", 10);
        if (!Number.isFinite(index) || index < 0) return;
        removeBatchUploadAt(index);
      });
    }

    if (detailGalleryToggleBtn && detailGalleryPicker) {
      detailGalleryToggleBtn.addEventListener("click", () => {
        const nextHidden = !detailGalleryPicker.hidden;
        detailGalleryPicker.hidden = nextHidden;
        if (!nextHidden) renderSelectedProductGallery();
      });
    }

    if (detailGallerySelectAllBtn && detailGalleryGrid) {
      detailGallerySelectAllBtn.addEventListener("click", () => {
        const cards = Array.from(detailGalleryGrid.querySelectorAll(".js-detail-gallery-card"));
        if (!cards.length) return;
        const shouldSelectAll = cards.some((card) => !card.classList.contains("is-selected"));
        cards.forEach((card) => {
          const blobId = String(card.dataset.blobId || "").trim();
          if (!blobId) return;
          setDetailGalleryCardSelectedState(card, shouldSelectAll);
          if (shouldSelectAll) {
            addDetailPictureRowWithBlob(blobId);
          } else {
            removeDetailPictureRowByBlob(blobId);
          }
        });
        refreshDetailPictureRows();
      });
    }

    if (detailGalleryGrid) {
      detailGalleryGrid.addEventListener("click", (event) => {
        const card = event.target.closest(".js-detail-gallery-card");
        if (!card) return;
        const blobId = String(card.dataset.blobId || "").trim();
        if (!blobId) return;
        const nextSelected = !card.classList.contains("is-selected");
        if (nextSelected) {
          addDetailPictureRowWithBlob(blobId);
        } else {
          removeDetailPictureRowByBlob(blobId);
        }
        setDetailGalleryCardSelectedState(card, nextSelected);
        refreshDetailPictureRows();
      });
    }

    if (addContainerLoadingRowBtn && containerLoadingRowsContainer) {
      addContainerLoadingRowBtn.addEventListener("click", () => {
        const index = containerLoadingRowsContainer.querySelectorAll(".js-container-loading-row").length;
        containerLoadingRowsContainer.insertAdjacentHTML("beforeend", newContainerLoadingRowHtml(index));
        refreshContainerLoadingRows();
      });
      containerLoadingRowsContainer.addEventListener("click", (event) => {
        const removeBtn = event.target.closest(".js-container-loading-row-remove");
        if (!removeBtn) return;
        removeBtn.closest(".js-container-loading-row")?.remove();
        refreshContainerLoadingRows();
      });
      containerLoadingRowsContainer.addEventListener("input", refreshContainerLoadingRows);
      containerLoadingRowsContainer.addEventListener("change", refreshContainerLoadingRows);
    }
    if (containerLoadingNoteEnabledInput) {
      containerLoadingNoteEnabledInput.addEventListener("change", refreshContainerLoadingRows);
    }
    [
      form?.querySelector(".js-container-loading-header-variant"),
      form?.querySelector(".js-container-loading-header-type"),
      form?.querySelector(".js-container-loading-header-capacity"),
      form?.querySelector(".js-container-loading-header-note")
    ].forEach((input) => {
      if (!input) return;
      input.addEventListener("input", refreshContainerLoadingRows);
      input.addEventListener("change", refreshContainerLoadingRows);
    });

    [taxInput, shippingInput, discountInput, currencyInput].forEach((input) => {
      if (!input) return;
      input.addEventListener("input", updateTotalsUI);
      input.addEventListener("change", updateTotalsUI);
    });

    if (body) {
      const totalsWatchSelector = ".js-unit-price, .js-quantity, .js-addon-charges, .js-addon-amount, .js-discount-input, .js-tax-input, .js-shipping-input";
      body.addEventListener("input", (event) => {
        if (event.target && event.target.matches(totalsWatchSelector)) updateTotalsUI();
      });
      body.addEventListener("change", (event) => {
        if (event.target && event.target.matches(totalsWatchSelector)) updateTotalsUI();
      });
    }

    if (addDiscountBtn) {
      addDiscountBtn.addEventListener("click", () => {
        toggleDiscountVisibility(true);
        if (discountInput && parseNumber(discountInput.value) <= 0) discountInput.value = "0.00";
        if (discountInput) discountInput.focus();
        updateTotalsUI();
      });
    }

    if (removeDiscountBtn) {
      removeDiscountBtn.addEventListener("click", () => {
        toggleDiscountVisibility(false);
        updateTotalsUI();
      });
    }

    if (statusInput) {
      statusInput.addEventListener("change", () => {
        applyStatusUI();
        updateTotalsUI();
      });
    }

    [winReasonInput, lossReasonInput, stalledReasonInput].forEach((input) => {
      if (!input) return;
      input.addEventListener("change", applyStatusUI);
    });

    if (validUntilInput) {
      validUntilInput.addEventListener("change", updateExpirySummary);
    }

    enforcePiReadonlyMode();
    updateTotalsUI();
    updateExpirySummary();
    applyStatusUI();
    setAdvancedMode(advancedModeEnabled());
    refreshConfigurationRows();
    refreshDetailPictureRows();
    renderDetailBatchPreview();
    renderSelectedProductGallery();
    refreshContainerLoadingRows();

    if (form && submitButton) {
      form.querySelectorAll("input, select, textarea").forEach((field) => {
        field.addEventListener("input", clearClientErrors);
        field.addEventListener("change", clearClientErrors);
      });

      form.addEventListener("submit", (event) => {
        refreshConfigurationRows();
        refreshDetailPictureRows();
        refreshContainerLoadingRows();
        const invalidFields = Array.from(form.querySelectorAll(":invalid")).filter((field) => !field.disabled && field.offsetParent !== null);
        if (invalidFields.length > 0) {
          event.preventDefault();
          highlightInvalidFields(invalidFields);
          showClientErrors(invalidFields);
          window.showAppToast?.("Please complete the required fields.", "error");
          const firstInvalid = invalidFields[0];
          if (firstInvalid && typeof firstInvalid.focus === "function") {
            firstInvalid.focus({ preventScroll: true });
          }
          return;
        }

        if (submitButton.dataset.submitting === "true") {
          event.preventDefault();
          return;
        }

        submitButton.dataset.submitting = "true";
        submitButton.disabled = true;
        if (submitButton.tagName === "INPUT") {
          submitButton.dataset.originalValue = submitButton.value;
          submitButton.value = "<%= j submit_loading_label %>";
        } else {
          submitButton.dataset.originalValue = submitButton.textContent;
          submitButton.textContent = "<%= j submit_loading_label %>";
        }
      });
    }

    if (root.dataset.hasErrors === "true") {
      const errorTarget = document.querySelector(".quote-form-inline-error, .error-messages");
      if (errorTarget) {
        setTimeout(() => {
          errorTarget.scrollIntoView({ behavior: "smooth", block: "center" });
        }, 120);
      }
    }
  })();
</script>
