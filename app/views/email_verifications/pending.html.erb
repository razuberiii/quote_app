<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="alert alert-info" role="alert">
        <h4 class="alert-heading">Email Verification Required</h4>
        <p>Thank you for registering! Before you can log in, you need to verify your email address.</p>
        <hr/>
        <p>Please check your email for a verification link. The link will expire in 15 minutes.</p>
        <p class="mb-0">
          If you don't see the verification email, please check your spam folder or 
          <%= link_to "sign up", new_user_registration_path %> again to receive a new verification link.
        </p>
      </div>
    </div>
  </div>
</div>
