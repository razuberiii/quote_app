<main class="rubusoo-page inquiry-page"><header class="page-heading"><p class="eyebrow">Inquiry review</p><h1>Confirm the request before pricing.</h1></header><div class="inquiry-split"><section class="source-paper"><pre><%= @inquiry.source_text %></pre></section><aside><h2>Structured requirements</h2><div class="review-row"><span>Customer</span><strong class="status status--missing">Missing</strong></div><div class="review-row"><span>Products</span><strong class="status status--missing">Missing</strong></div><div class="review-row"><span>Price</span><strong class="status status--required">Price required</strong></div><div class="review-row"><span>Freight</span><strong class="status status--required">Freight required</strong></div><%= button_to "Build quote", build_quote_inquiry_path(@inquiry), class: "button button--primary button--full" %></aside></div></main>
