            <label><%= t("quotes.view.form.detail_picture_batch_upload_label", default: "Upload quote images (batch)") %></label>
            <%= file_field_tag "quote[detail_pictures_batch_uploads][]",
                               multiple: true,
                               accept: "image/png,image/jpeg,image/webp,image/gif",
                               class: "#{ui_input_classes} js-detail-pictures-batch-upload" %>
            <p class="quote-form-hint"><%= t("quotes.view.form.detail_picture_batch_upload_hint", default: "You can select multiple images at once.") %></p>
          </div>
          <div class="quote-advanced-module-list quote-advanced-module-list--detail-pictures js-detail-picture-rows"
               data-name-prefix="quote[detail_pictures_block][items]"
               data-empty-label="<%= t("quotes.view.form.detail_pictures_empty_label", default: "No pictures selected, this block stays hidden in output.") %>">
            <div class="quote-detail-batch-preview js-detail-batch-preview" hidden></div>
            <% if detail_picture_items.any? %>
              <% detail_picture_items.each_with_index do |item, idx| %>
                <div class="quote-advanced-module-row quote-advanced-module-row--picture js-detail-picture-row" data-index="<%= idx %>" data-blob-id="<%= item[:image_blob_id] %>">
                  <%= hidden_field_tag "quote[detail_pictures_block][items][#{idx}][source]", item[:source].presence || "product_gallery", class: "js-detail-picture-source" %>
                  <%= hidden_field_tag "quote[detail_pictures_block][items][#{idx}][image_blob_id]", item[:image_blob_id], class: "js-detail-picture-blob" %>
                  <div class="quote-detail-item-preview js-detail-picture-preview"></div>
                  <p class="quote-detail-item-name js-detail-picture-name"></p>
                  <%= text_field_tag "quote[detail_pictures_block][items][#{idx}][caption]", item[:caption], class: ui_input_classes("js-detail-picture-caption"), placeholder: t("quotes.view.form.detail_picture_caption_placeholder", default: "Caption (optional)") %>
                  <%= hidden_field_tag "quote[detail_pictures_block][items][#{idx}][position]", item[:position].presence || (idx + 1), class: "js-detail-picture-position" %>
                  <button type="button" class="quote-kv-remove js-detail-picture-row-remove" aria-label="<%= t("quotes.view.form.remove", default: "Remove") %>">&times;</button>
                </div>
              <% end %>
            <% end %>
            <p class="quote-form-hint js-detail-pictures-empty" <%= "hidden" if detail_picture_items.any? %>><%= t("quotes.view.form.detail_pictures_empty_label", default: "No pictures selected, this block stays hidden in output.") %></p>
          </div>
        </div>

        <% if Quote.column_names.include?("formal_closing_block") %>
