<% current_revision = @commercial_revisions.first %>
<section class="commercial-flow">
  <header class="commercial-flow__header"><div><p class="eyebrow">Commercial workflow</p><h1><%= @quote.quote_no %> · <%= @quote.customer.name %></h1><p>Move this quotation from a checked draft to an accepted order without losing the buyer’s context.</p></div><div class="commercial-flow__total"><span>Current total</span><strong><%= @quote.currency %> <%= number_with_delimiter(@quote.grand_total) %></strong><small><%= @quote.status.humanize %></small></div></header>
  <div class="commercial-flow__grid">
    <section class="commercial-readiness <%= "is-ready" if @readiness_issues.empty? %>"><div><span><%= @readiness_issues.empty? ? "Ready to send" : "Send check" %></span><strong><%= @readiness_issues.empty? ? "Commercial details are complete" : "#{@readiness_issues.size} items need attention" %></strong></div><% if @readiness_issues.any? %><ul><% @readiness_issues.first(6).each do |issue| %><li><%= issue %></li><% end %></ul><%= link_to "Resolve in Quote Studio", edit_quote_path(@quote), class: "button button--secondary" %><% else %><div class="commercial-readiness__actions"><%= link_to "Preview buyer experience", current_revision ? buyer_room_path(current_revision.secure_token, preview: 1) : public_preview_quote_path(@quote), target: "_blank", class: "button button--secondary" %><%= button_to current_revision ? "Publish Revision #{current_revision.number + 1}" : "Publish Revision 1", quote_revisions_path(quote_id: @quote.id), class: "button button--primary" %></div><% end %></section>
    <section class="commercial-timeline"><header><div><span>Revisions</span><strong><%= @commercial_revisions.size %> formal versions</strong></div><% if current_revision %><button type="button" class="text-action" data-copy-text="<%= buyer_room_url(current_revision.secure_token) %>">Copy latest Buyer Room link</button><% end %></header><div class="commercial-timeline__list"><% @commercial_revisions.each do |revision| %><%= link_to quote_revision_path(revision) do %><span>R<%= revision.number %></span><div><strong><%= revision.summary %></strong><small><%= revision.status.humanize %> · <%= revision.sent_at&.to_date %></small></div><em><%= revision.currency %> <%= number_with_delimiter(revision.total) %></em><% end %><% end %><% if @commercial_revisions.empty? %><p>No formal version has been sent yet.</p><% end %></div></section>
  </div>
  <% if @buyer_questions.any? || @change_requests.any? || @quote.quote_acceptance.present? %><section class="buyer-inbox"><header><span>Buyer activity</span><strong>Context preserved with each action</strong></header><div class="buyer-inbox__grid"><% @change_requests.each do |request| %><article><span>Revision request · R<%= request.quote_revision.number %></span><h3><%= request.message %></h3><p><%= request.buyer_name %> · <%= request.buyer_email %></p><%= link_to "Create the next revision", edit_quote_path(@quote), class: "text-action" if @quote.can_edit_revision? %></article><% end %><% @buyer_questions.each do |question| %><article><span>Question · <%= question.context_type.humanize %> <%= question.context_key %></span><h3><%= question.body %></h3><p><%= question.buyer_name %> · <%= question.buyer_email %></p></article><% end %><% if @quote.quote_acceptance %><article class="is-accepted"><span>Accepted · R<%= @quote.quote_acceptance.quote_revision.number %></span><h3><%= @quote.quote_acceptance.name %> accepted <%= @quote.quote_acceptance.currency %> <%= number_with_delimiter(@quote.quote_acceptance.total) %></h3><p><%= @quote.quote_acceptance.accepted_at.to_fs(:long) %></p><% if @quote.proforma_invoice %><%= link_to "Open #{@quote.proforma_invoice.number}", @quote.proforma_invoice, class: "button button--primary" %><% else %><%= button_to "Generate proforma invoice", proforma_invoices_path(quote_acceptance_id: @quote.quote_acceptance.id), class: "button button--primary" %><% end %></article><% end %></div></section><% end %>
</section>
