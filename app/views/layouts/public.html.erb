<!DOCTYPE html>
<html>
  <head>
    <title><%= seo_title("Rubusoo Public Quote") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= seo_description %>">
    <meta name="robots" content="<%= seo_robots %>">
    <% if seo_canonical_url.present? %>
      <link rel="canonical" href="<%= seo_canonical_url %>">
    <% end %>
    <link rel="icon" href="<%= favicon_href %>" type="image/png">
    <link rel="shortcut icon" href="<%= favicon_href %>" type="image/png">
    <link rel="apple-touch-icon" href="<%= favicon_href %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "base", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "layout", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "legacy", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "marketing", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "seo", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="public-quote-body">
    <main class="public-quote-main">
      <%= yield %>
    </main>
    <footer class="global-app-footer global-app-footer-public no-print">
    </footer>

    <style>
      body.public-quote-body {
        margin: 0;
        padding: 2rem 1rem 3rem;
        background: linear-gradient(180deg, #f8fafc 0%, #f3f4f6 100%);
        color: #111827;
      }

      main.public-quote-main {
        max-width: 920px;
        margin: 0 auto;
      }

      @media (max-width: 768px) {
        body.public-quote-body {
          padding: 1rem 0.65rem 2rem;
        }
      }

      @media print {
        @page {
          margin: 12mm;
        }

        body.public-quote-body {
          padding: 0;
          background: white;
        }

        main.public-quote-main {
          box-shadow: none;
          max-width: 100%;
          margin: 0;
        }

        .no-print { display: none !important; }
      }
    </style>
  </body>
</html>
