<main class="deal-workspace deals-index">
  <header class="deal-page-header"><div><p class="eyebrow"><%= t("self_service.deals.eyebrow") %></p><h1><%= t("self_service.deals.title") %></h1><p><%= t("self_service.deals.subtitle") %></p></div><%= link_to t("self_service.deals.new"), new_inquiry_path, class: "button button--primary" %></header>
  <form class="deal-filters" method="get"><label><%= t("self_service.deals.search") %><input type="search" name="q" value="<%= params[:q] %>" placeholder="<%= t('self_service.deals.search_placeholder') %>"></label><label><%= t("self_service.deals.result") %><select name="outcome"><option><%= t("self_service.deals.all_active") %></option><option><%= t("self_service.deals.won") %></option><option><%= t("self_service.deals.lost") %></option></select></label><label><%= t("self_service.deals.attention") %><select name="attention"><option><%= t("self_service.deals.all") %></option><option><%= t("self_service.deals.needs_attention") %></option><option><%= t("self_service.deals.waiting") %></option></select></label><button class="button button--secondary"><%= t("self_service.deals.filter") %></button></form>
  <% @groups.each do |label, rows| %><% next if rows.empty? %><section class="deal-group"><header><h2><%= label %></h2><span><%= rows.size %></span></header><div class="deal-table"><div class="deal-table__head"><span><%= t("self_service.deals.columns.deal") %></span><span><%= t("self_service.deals.columns.stage") %></span><span><%= t("self_service.deals.columns.amount") %></span><span><%= t("self_service.deals.columns.activity") %></span><span><%= t("self_service.deals.columns.next") %></span></div><% rows.each do |deal, progress| %><article class="deal-row"><%= link_to deal_path(deal), class: "deal-row__identity" do %><strong><%= deal.customer&.name || t("self_service.deals.buyer_pending") %></strong><span><%= deal_title(deal) %></span><small><%= deal_version_label(deal) %> · <%= t("self_service.deals.updated", time: time_ago_in_words(deal.updated_at)) %></small><% end %><span class="deal-stage deal-stage--<%= progress.stage %>"><i></i><%= progress.stage_label %></span><strong class="deal-money"><%= deal.currency %> <%= number_with_delimiter(deal.grand_total) %></strong><span class="deal-signal"><%= progress.signal %><small><%= t("self_service.deals.ago", time: time_ago_in_words(progress.signal_at || deal.updated_at)) %></small></span><%= link_to progress.action_label, deal_action_path(deal, progress), class: "deal-next" %></article><% end %></div></section><% end %>
  <% if @deals.empty? %><div class="deal-zero"><h2><%= t("self_service.deals.empty") %></h2><%= link_to t("self_service.deals.import"), new_inquiry_path, class: "button button--primary" %></div><% end %>
</main>
