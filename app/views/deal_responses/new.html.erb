<main class="deal-workspace context-form">
  <header>
    <%= link_to t("self_service.quote_core.response_form.back"), quote_path(@deal, tab: "activity"), class: "deal-back" %>
    <p class="eyebrow"><%= t("self_service.quote_core.response_form.eyebrow") %></p>
    <h1><%= t("self_service.quote_core.response_form.title") %></h1>
    <p><%= t("self_service.quote_core.response_form.help") %></p>
  </header>
  <%= form_with model: @response, url: responses_quote_path(@deal), multipart: true, class: "context-form__grid" do |form| %>
    <%= hidden_field_tag :idempotency_key, SecureRandom.uuid %>
    <div><%= form.label :quote_revision_id, t("self_service.quote_core.response_form.version") %><%= form.select :quote_revision_id, @deal.quote_revisions.ordered.map { |version| [t("self_service.quote_core.response_form.version_option", number: version.number, currency: version.currency, total: version.total), version.id] }, {}, class: "app-ui-input" %></div>
    <div><%= form.label :kind, t("self_service.quote_core.response_form.type") %><%= form.select :kind, DealResponse::KINDS.map { |kind| [t("self_service.quote_core.response_form.kinds.#{kind}", default: kind.humanize), kind] }, {}, class: "app-ui-input" %></div>
    <div><%= form.label :source, t("self_service.quote_core.response_form.source") %><%= form.select :source, DealResponse::SOURCES.map { |source| [t("self_service.quote_core.response_form.sources.#{source}", default: source.humanize), source] }, {}, class: "app-ui-input" %></div>
    <div><%= form.label :received_at, t("self_service.quote_core.response_form.received_at") %><%= form.datetime_local_field :received_at, class: "app-ui-input" %></div>
    <div><%= form.label :buyer_name, t("self_service.quote_core.response_form.contact") %><%= form.text_field :buyer_name, class: "app-ui-input" %></div>
    <div><%= form.label :buyer_email, t("self_service.quote_core.response_form.email") %><%= form.email_field :buyer_email, class: "app-ui-input" %></div>
    <div><%= form.label :context_type, t("self_service.quote_core.response_form.context") %><%= form.select :context_type, DealResponse::CONTEXT_TYPES.map { |type| [t("self_service.quote_core.response_form.contexts.#{type}", default: type.humanize), type] }, {}, class: "app-ui-input" %></div>
    <div><%= form.label :context_key, t("self_service.quote_core.response_form.reference") %><%= form.text_field :context_key, class: "app-ui-input" %></div>
    <div class="context-form__wide"><%= form.label :body, t("self_service.quote_core.response_form.body") %><%= form.text_area :body, rows: 5, class: "app-ui-input" %></div>
    <div class="context-form__wide"><%= form.label :attachment, t("self_service.quote_core.response_form.file") %><%= form.file_field :attachment, accept: ".pdf,.xlsx,.csv,.txt,application/pdf,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv,text/plain" %><small><%= t("self_service.quote_core.response_form.file_help") %></small></div>
    <footer class="context-form__wide"><%= form.submit t("self_service.quote_core.response_form.submit"), class: "button button--primary" %></footer>
  <% end %>
</main>
