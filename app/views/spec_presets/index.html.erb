<section class="app-page-shell app-page-shell--settings-form preset-admin-shell">
  <header class="app-page-header" id="new">
    <div class="app-page-header-main">
      <h1><%= t("spec_presets.view.index.title") %></h1>
      <p><%= t("spec_presets.view.index.create_title") %> · <%= t("spec_presets.view.index.library_title") %></p>
    </div>
    <div class="app-page-header-actions">
      <%= link_to t("spec_presets.view.index.back_to_product_presets"), product_presets_path, class: "form-page-back-link" %>
    </div>
  </header>

  <article class="app-surface team-members-panel">
    <div class="app-section-heading">
      <h2><%= t("spec_presets.view.index.create_title") %></h2>
    </div>
    <%= render "form", spec_preset: @spec_preset %>
  </article>

  <article class="app-table-surface team-members-panel team-members-panel--secondary">
    <div class="app-section-heading">
      <h2><%= t("spec_presets.view.index.library_title") %></h2>
    </div>
    <% if @spec_presets.any? %>
      <div class="table-responsive">
        <table class="customers-table saas-table">
          <thead>
            <tr>
              <th><%= t("spec_presets.view.index.name") %></th>
              <th><%= t("spec_presets.view.index.specs") %></th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @spec_presets.each do |preset| %>
              <tr>
                <td><strong><%= preset.name %></strong></td>
                <td><%= preset.normalized_entries.map { |entry| "#{entry[:name]}: #{entry[:value]}" }.join(" • ") %></td>
                <td class="text-right preset-row-actions">
                  <%= link_to t("spec_presets.view.index.edit"), edit_spec_preset_path(preset), class: ui_button_classes(:secondary) %>
                  <%= button_to t("spec_presets.view.index.delete"), spec_preset_path(preset), method: :delete, data: { turbo_confirm: t("spec_presets.view.index.delete_confirm") }, class: ui_button_classes(:danger) %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="team-members-hint"><%= t("spec_presets.view.index.empty") %></p>
    <% end %>
  </article>
</section>
