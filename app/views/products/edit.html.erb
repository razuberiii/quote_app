<section class="app-page-shell app-page-shell--form app-page-shell--product-form">
  <header class="app-page-header">
    <div class="app-page-header-main">
      <h1><%= t("products.view.edit.title") %></h1>
      <p><%= t("products.view.edit.subtitle_html", name: @product.name) %></p>
    </div>
  </header>

  <%= render "form",
             product: @product,
             submit_label: t("products.view.edit.submit_label"),
             back_path: @product,
             back_label: t("products.view.edit.back_to_product") %>
</section>
