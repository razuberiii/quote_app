<%
  flow_steps = t("landing.homepage.flow_showcase.steps")
  capability_cards = t("landing.homepage.capability_cards")
%>

<section id="product-story" class="app-page-shell marketing-page-shell">
  <div class="app-section-stack" data-controller="marketing-switcher" data-marketing-switcher-selected-value="<%= flow_steps.first[:key] %>">
    <section class="marketing-hero-grid">
      <div class="app-section-stack marketing-hero-copy">
        <div class="app-section-stack">
          <p class="marketing-eyebrow-chip"><%= t("landing.homepage.hero.kicker") %></p>
          <div class="app-section-stack gap-4">
            <h1 class="marketing-hero-title"><%= t("landing.homepage.hero.title") %></h1>
            <p class="marketing-hero-body"><%= t("landing.homepage.hero.body") %></p>
            <p class="app-subtle-note"><%= t("landing.homepage.hero.helper") %></p>
            <ul class="grid gap-2 sm:grid-cols-2">
              <% capability_cards.each do |card| %>
                <li class="rounded-xl border border-slate-200 bg-white px-3 py-2">
                  <p class="text-sm font-semibold text-slate-900"><%= card[:title] %></p>
                  <p class="mt-1 text-xs text-slate-600"><%= card[:body] %></p>
                </li>
              <% end %>
            </ul>
          </div>
        </div>

        <div class="marketing-hero-cta-group">
          <div class="flex flex-wrap gap-3">
            <%= render "components/ui/button", href: demo_path, variant: :primary do %>
              <%= t("landing.homepage.hero.cta_demo") %>
            <% end %>
            <%= render "components/ui/button", href: sample_quote_path, variant: :secondary, attrs: { target: "_blank" } do %>
              <%= t("landing.homepage.hero.cta_sample") %>
            <% end %>
            <%= render "components/ui/button", href: new_user_registration_path, variant: :ghost do %>
              <%= t("landing.homepage.hero.cta_primary") %>
            <% end %>
          </div>

          <p class="app-subtle-note"><%= t("landing.homepage.hero.cta_support") %></p>
        </div>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-white shadow-sm overflow-hidden">
        <div class="flex items-center gap-2 border-b border-slate-200 bg-slate-50 px-4 py-3">
          <span class="h-2.5 w-2.5 rounded-full bg-slate-300"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-slate-300"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-slate-300"></span>
          <p class="ml-2 text-xs font-medium uppercase tracking-[0.16em] text-slate-500"><%= t("landing.homepage.hero.preview_shell_title") %></p>
        </div>
        <div class="space-y-4 p-4">
          <%= render "components/ui/card", class: "app-surface marketing-hero-card marketing-hero-shell marketing-hero-shell--record", attrs: { "data-marketing-hero-sequence": true } do %>
            <% flow_steps.each_with_index do |step, index| %>
              <% primary_event = step[:timeline].first %>
              <% secondary_event = step[:timeline].second %>
              <section
                id="homepage-flow-panel-<%= step[:key] %>"
                class="marketing-switcher__panel <%= 'is-active' if index.zero? %>"
                role="tabpanel"
                aria-labelledby="homepage-flow-tab-<%= step[:key] %>"
                <%= "hidden" unless index.zero? %>
                data-marketing-switcher-target="panel"
                data-state-key="<%= step[:key] %>">
                <article class="marketing-record-mockup">
                  <header class="marketing-record-mockup__header">
                    <div class="marketing-record-mockup__identity">
                      <p class="marketing-section-kicker"><%= t("landing.homepage.hero_mockup.kicker") %></p>
                      <h2 class="marketing-record-mockup__title"><%= t("landing.homepage.hero_mockup.title") %></h2>
                      <div class="marketing-record-mockup__meta">
                        <p class="marketing-record-mockup__meta-line">
                          <%= t("landing.homepage.hero_mockup.meta_line", version: step[:version_badge], buyer: t("landing.homepage.hero_mockup.buyer"), status: step[:badge]) %>
                        </p>
                      </div>
                    </div>
                  </header>

                  <div class="marketing-record-mockup__main">
                    <div class="marketing-record-mockup__main-head">
                      <div>
                        <p class="app-stat-label"><%= step[:summary_label] %></p>
                        <p class="app-subtle-note mt-2"><%= t("landing.homepage.hero_mockup.same_record_note") %></p>
                      </div>
                    </div>

                    <div class="marketing-record-mockup__summary-grid">
                      <% step[:summary_rows].each do |row| %>
                        <article class="marketing-record-mockup__summary-row <%= 'is-changed' if row[:changed] %>">
                          <span class="text-slate-600"><%= row[:label] %></span>
                          <strong class="text-slate-950"><%= row[:value] %></strong>
                        </article>
                      <% end %>
                    </div>

                    <div class="marketing-record-mockup__update">
                      <div class="marketing-record-mockup__update-head">
                        <p class="app-stat-label"><%= t("landing.homepage.hero_mockup.timeline_label") %></p>
                        <span class="app-subtle-note"><%= primary_event[:time] %></span>
                      </div>
                      <strong class="marketing-record-mockup__update-title"><%= primary_event[:title] %></strong>
                      <p class="marketing-record-mockup__update-body"><%= primary_event[:body] %></p>

                      <% if secondary_event.present? %>
                        <div class="marketing-record-mockup__update-note">
                          <div class="marketing-record-mockup__update-note-head">
                            <span class="text-slate-950 font-medium"><%= secondary_event[:title] %></span>
                            <span class="app-subtle-note"><%= secondary_event[:time] %></span>
                          </div>
                          <p class="app-subtle-note"><%= secondary_event[:body] %></p>
                        </div>
                      <% end %>
                    </div>
                  </div>

                  <div class="marketing-record-mockup__footer">
                    <article class="marketing-record-mockup__aux">
                      <span class="app-stat-label"><%= step[:activity][:label] %></span>
                      <strong class="app-stat-value"><%= step[:activity][:value] %></strong>
                      <p class="app-subtle-note mt-2"><%= step[:activity][:body] %></p>
                    </article>
                    <article class="marketing-record-mockup__aux">
                      <span class="app-stat-label"><%= step[:next_action][:label] %></span>
                      <strong class="app-stat-value"><%= step[:next_action][:value] %></strong>
                      <p class="app-subtle-note mt-2"><%= step[:next_action][:body] %></p>
                    </article>
                  </div>
                </article>
              </section>
            <% end %>
          <% end %>

        </div>
      </div>
    </section>

    <section class="marketing-editorial-section marketing-editorial-section--flow">
      <div class="app-section-stack gap-4">
        <div class="app-section-stack gap-2">
          <p class="marketing-section-kicker"><%= t("landing.homepage.flow_showcase.kicker") %></p>
          <h2 class="marketing-section-title marketing-section-title--quiet max-w-3xl"><%= t("landing.homepage.flow_showcase.title") %></h2>
          <p class="marketing-section-body marketing-section-body--compact max-w-3xl"><%= t("landing.homepage.flow_showcase.body") %></p>
        </div>

        <div class="marketing-switcher__nav marketing-switcher__nav--inline marketing-switcher__nav--subtle" role="tablist" aria-label="<%= t("landing.homepage.flow_showcase.aria_label") %>">
          <% flow_steps.each_with_index do |step, index| %>
            <button
              id="homepage-flow-tab-<%= step[:key] %>"
              type="button"
              role="tab"
              class="marketing-switcher__tab marketing-switcher__tab--inline marketing-switcher__tab--subtle <%= 'is-active' if index.zero? %>"
              aria-controls="homepage-flow-panel-<%= step[:key] %>"
              aria-selected="<%= index.zero? %>"
              tabindex="<%= index.zero? ? 0 : -1 %>"
              data-active="<%= index.zero? %>"
              data-action="click->marketing-switcher#select keydown->marketing-switcher#keydown"
              data-marketing-switcher-target="tab"
              data-state-key="<%= step[:key] %>">
              <span class="marketing-switcher__tab-step"><%= step[:step] %></span>
              <span class="marketing-switcher__tab-copy">
                <strong><%= step[:title] %></strong>
                <span><%= step[:body] %></span>
              </span>
            </button>
          <% end %>
        </div>
      </div>
    </section>

    <section class="marketing-editorial-section marketing-editorial-section--bridge">
      <div class="app-section-stack gap-6">
        <h2 class="marketing-section-title marketing-section-title--quiet max-w-4xl"><%= t("landing.homepage.why.title") %></h2>
        <p class="marketing-section-body marketing-section-body--compact max-w-4xl"><%= t("landing.homepage.why.body") %></p>

        <div class="marketing-compare-band">
          <article class="marketing-compare-band__column is-before">
            <h3 class="text-2xl font-semibold tracking-tight text-slate-950"><%= t("landing.homepage.why.before.title") %></h3>
            <ul class="marketing-checklist mt-4">
              <% t("landing.homepage.why.before.items").each do |item| %>
                <li><%= item %></li>
              <% end %>
            </ul>
          </article>

          <article class="marketing-compare-band__column is-after">
            <h3 class="text-2xl font-semibold tracking-tight text-slate-950"><%= t("landing.homepage.why.after.title") %></h3>
            <ul class="marketing-checklist mt-4">
              <% t("landing.homepage.why.after.items").each do |item| %>
                <li><%= item %></li>
              <% end %>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section class="marketing-editorial-section marketing-editorial-section--faq marketing-editorial-section--faq-shell">
      <div class="app-section-stack gap-6">
        <h2 class="marketing-section-title marketing-section-title--supporting max-w-3xl"><%= t("landing.homepage.faq.title") %></h2>

        <div class="marketing-faq-grid">
          <% t("landing.homepage.faq.items").each do |item| %>
            <details class="marketing-faq-item group">
              <summary class="marketing-faq-item__summary">
                <span><%= item[:question] %></span>
                <span class="marketing-faq-item__icon app-subtle-note shrink-0">+</span>
              </summary>
              <p class="marketing-faq-item__body"><%= item[:answer] %></p>
            </details>
          <% end %>
        </div>
      </div>
    </section>

    <%= render "components/ui/card", class: "app-surface marketing-dark-card border-slate-950 text-white marketing-hero-shell marketing-cta-band" do %>
      <div class="app-section-heading marketing-cta-band__content">
        <div class="app-section-stack gap-3 max-w-2xl">
          <h2 class="marketing-section-title max-w-none text-white"><%= t("landing.homepage.final_cta.title") %></h2>
          <p class="text-sm leading-7 text-slate-300"><%= t("landing.homepage.final_cta.body") %></p>
        </div>
        <div class="flex flex-wrap gap-3">
          <%= render "components/ui/button", href: demo_path, variant: :secondary do %>
            <%= t("landing.homepage.final_cta.cta_demo") %>
          <% end %>
          <%= render "components/ui/button", href: sample_quote_path, variant: :secondary, attrs: { target: "_blank" } do %>
            <%= t("landing.homepage.final_cta.cta_sample") %>
          <% end %>
          <%= render "components/ui/button", href: contact_path, variant: :secondary do %>
            <%= t("landing.homepage.final_cta.cta_contact") %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>
