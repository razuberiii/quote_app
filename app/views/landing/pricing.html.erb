<% content_for :title, t("self_service.marketing.pricing_page.meta_title") %>
<main class="rb-page">
  <header class="rb-page-head">
    <div>
      <p class="eyebrow"><%= t("self_service.marketing.pricing_page.eyebrow") %></p>
      <h1><%= t("self_service.marketing.pricing_page.title") %></h1>
    </div>
    <p><%= t("self_service.marketing.pricing_page.body") %></p>
  </header>

  <% plans = %w[trial solo pro business].zip(%w[$0 $15 $29 $69]).map do |key, fallback_price| %>
    <% { key:, name: t("self_service.marketing.pricing_page.plans.#{key}.name"), price: t("self_service.marketing.pricing_page.plans.#{key}.price", default: fallback_price), note: t("self_service.marketing.pricing_page.plans.#{key}.note"), features: t("self_service.marketing.pricing_page.plans.#{key}.features"), action: t("self_service.marketing.pricing_page.plans.#{key}.action"), style: :secondary, plan: (key unless key.in?(%w[trial business])), contact: key == "business" } %>
  <% end %>
  <div class="pricing-grid">
    <% plans.each do |plan| %>
      <section>
        <span class="pricing-plan"><%= plan[:name] %></span>
        <strong class="pricing-price"><%= plan[:price] %></strong>
        <p class="pricing-description"><%= plan[:note] %></p>
        <ul class="pricing-features">
          <% plan[:features].each do |feature| %><li><%= feature %></li><% end %>
        </ul>
        <% if plan[:contact] %>
          <%= link_to plan[:action], contact_path, class: "button button--secondary" %>
        <% elsif user_signed_in? && plan[:plan].present? %>
          <%= button_to plan[:action], billing_checkout_path(plan: plan[:plan]), class: "button button--secondary button--full" %>
        <% else %>
          <%= link_to plan[:action], new_user_registration_path, class: "button button--#{plan[:style]}" %>
        <% end %>
      </section>
    <% end %>
  </div>
</main>
