<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <style>
      :root {
        --doc-font: "Noto Sans", "Segoe UI", Arial, sans-serif;
      }

      @page {
        size: A4;
        margin: 12mm;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background: #fff;
      }

      body {
        color: #222;
        font-family: var(--doc-font), "Noto Sans CJK SC", "PingFang SC", "Microsoft YaHei", sans-serif;
      }

      .public-quote-main {
        max-width: 100% !important;
        margin: 0 !important;
        position: relative;
        z-index: 1;
      }
      .pdf-render * { box-sizing: border-box; letter-spacing: normal !important; }

      .pdf-render .quote-document {
        position: relative;
        background: #fff;
        color: #222;
        font-size: 8.9pt;
        line-height: 1.32;
        padding-bottom: 8mm;
      }

      .pdf-render .pdf-page-watermark-layer {
        position: fixed;
        top: 50%;
        left: 50%;
        width: 68%;
        transform: translate(-50%, -50%) rotate(-30deg);
        text-align: center;
        z-index: 0;
        pointer-events: none;
      }
      .pdf-render .pdf-page-watermark-image {
        width: auto;
        height: auto;
        max-width: 100%;
        max-height: 240mm;
        object-fit: contain;
        display: block;
        margin: 0 auto;
      }
      .pdf-render .pdf-page-watermark-text {
        color: #2f3f58;
        font-size: 54px;
        font-weight: 700;
        line-height: 1;
        letter-spacing: 0.02em;
        white-space: nowrap;
        text-align: center;
      }
      .pdf-render .quote-document > :not(.pdf-page-watermark-layer) { position: relative; z-index: 1; }
      .pdf-render .quote-document--terminal-closing { padding-bottom: 2mm; }

      .pdf-render .pdf-first-page { page-break-inside: auto; }
      .pdf-render .pdf-annex-flow { page-break-before: always; }

      .pdf-render .pdf-header-block {
        margin-bottom: 3mm;
        page-break-inside: avoid;
        max-height: 30mm;
        overflow: hidden;
      }

      .pdf-render .pdf-header-table { width: 100%; border-collapse: collapse; table-layout: fixed; }
      .pdf-render .pdf-header-table td { vertical-align: top; }
      .pdf-render .pdf-header-company { width: 62%; padding-right: 4mm; }
      .pdf-render .pdf-header-meta { width: 38%; }

      .pdf-render .pdf-company-logo-wrap { margin-bottom: 2mm; }
      .pdf-render .pdf-company-logo { width: auto; max-height: 9mm; max-width: 100%; display: block; }
      .pdf-render .pdf-company-name {
        margin: 0 0 0.8mm 0;
        font-size: 16.5pt;
        line-height: 1.1;
        font-weight: 700;
        text-transform: uppercase;
        overflow-wrap: anywhere;
        word-break: break-word;
      }
      .pdf-render .pdf-company-line {
        margin: 0;
        font-size: 8.2pt;
        line-height: 1.25;
        overflow-wrap: anywhere;
        word-break: break-word;
      }

      .pdf-render .pdf-meta-table { width: 100%; border-collapse: collapse; table-layout: fixed; }
      .pdf-render .pdf-meta-table th,
      .pdf-render .pdf-meta-table td {
        padding: 1.4mm 0;
        min-height: 5mm;
        line-height: 1.25;
        text-align: left;
        vertical-align: top;
        border-top: 1px solid #ececec;
        overflow-wrap: anywhere;
        word-break: break-word;
      }
      .pdf-render .pdf-meta-table tr:first-child td,
      .pdf-render .pdf-meta-table tr:nth-child(2) th,
      .pdf-render .pdf-meta-table tr:nth-child(2) td { border-top: 0; }
      .pdf-render .pdf-meta-table th { width: 22mm; font-size: 8.2pt; font-weight: 700; padding-right: 2mm; }
      .pdf-render .pdf-meta-table td { font-size: 8.5pt; font-weight: 400; }
      .pdf-render .pdf-meta-document-title {
        font-size: 13.5pt !important;
        line-height: 1.1;
        font-weight: 700;
        text-align: left;
        border-top: 0;
        border-bottom: 1px solid #333;
        padding-bottom: 2mm !important;
      }

      .pdf-render .pdf-buyer-block {
        margin-bottom: 3mm;
        page-break-inside: avoid;
        max-height: 24mm;
        overflow: hidden;
      }
      .pdf-render .pdf-light-heading { font-size: 9pt; font-weight: 700; margin: 0; }
      .pdf-render .pdf-light-rule { margin-top: 1mm; border-top: 1px solid #333; }
      .pdf-render .pdf-light-body { padding: 2.5mm 0; font-size: 8.5pt; }
      .pdf-render .pdf-light-body p { margin: 0 0 1px 0; line-height: 1.28; overflow-wrap: anywhere; word-break: break-word; }

      .pdf-render .pdf-main-items { page-break-inside: auto; }
      .pdf-render .pdf-items-table { width: 100%; border-collapse: collapse; table-layout: fixed; border: 1px solid #333; }
      .pdf-render .pdf-items-table thead { display: table-header-group; }
      .pdf-render .pdf-items-table th {
        border: 0;
        border-bottom: 1px solid #333;
        background: #f6f6f6;
        padding: 0;
        height: 6.5mm;
        font-size: 8.1pt;
        font-weight: 700;
        text-align: center;
        letter-spacing: normal;
      }
      .pdf-render .pdf-items-table td {
        border: 0;
        border-top: 1px solid #e6e6e6;
        padding: 1.8mm 1.5mm;
        font-size: 8.8pt;
        line-height: 1.3;
        vertical-align: top;
        overflow-wrap: anywhere; word-break: break-word;
      }
      .pdf-render .pdf-items-table tr { page-break-inside: auto; }
      .pdf-render .pdf-items-table > thead > tr > th:nth-child(2),
      .pdf-render .pdf-items-table > tbody > tr > td:nth-child(2) { border-left: 1px solid #e1e1e1; }
      .pdf-render .pdf-items-table > thead > tr > th:nth-child(3),
      .pdf-render .pdf-items-table > tbody > tr > td:nth-child(3),
      .pdf-render .pdf-items-table > thead > tr > th:nth-child(4),
      .pdf-render .pdf-items-table > tbody > tr > td:nth-child(4),
      .pdf-render .pdf-items-table > thead > tr > th:nth-child(5),
      .pdf-render .pdf-items-table > tbody > tr > td:nth-child(5) { border-left: 1px solid #d6d6d6; }
      .pdf-render .pdf-items-table > thead > tr > th:nth-child(2) { text-align: left; padding-left: 2.2mm; }
      .pdf-render .pdf-items-table tr.pdf-row--product td { padding-top: 3mm; padding-bottom: 3mm; }
      .pdf-render .pdf-items-table tr.pdf-row--charge td { padding-top: 1.8mm; padding-bottom: 1.8mm; }
      .pdf-render .pdf-items-table tr.pdf-row--charge .pdf-col-qty,
      .pdf-render .pdf-items-table tr.pdf-row--charge .pdf-col-money { vertical-align: middle; }

      .pdf-render .pdf-col-no,
      .pdf-render .pdf-col-qty,
      .pdf-render .pdf-col-money { font-variant-numeric: tabular-nums; }
      .pdf-render .pdf-col-no { text-align: center; }
      .pdf-render .pdf-col-qty { text-align: center; }
      .pdf-render .pdf-col-money { text-align: right; }
      .pdf-render .pdf-col-desc { padding-left: 4px; padding-right: 4px; }

      .pdf-render .pdf-item-details-layout { width: 100%; border-collapse: collapse; table-layout: fixed; }
      .pdf-render .pdf-item-details-layout td { border: 0 !important; border-left: 0 !important; padding: 0; vertical-align: top; }
      .pdf-render .pdf-item-details-image-cell { width: 17mm; padding-right: 3mm; }
      .pdf-render .pdf-item-details-text-cell { width: auto; }

      .pdf-render .pdf-item-thumb-box {
        width: 17mm;
        max-width: 17mm;
        display: block;
        margin: 0;
        padding: 0;
        line-height: 0;
      }
      .pdf-render .pdf-item-thumb {
        display: block;
        width: auto;
        height: auto;
        max-width: 17mm;
        max-height: 17mm;
        margin: 0;
        border: 0;
      }

      .pdf-render .pdf-item-name { font-size: 9pt; font-weight: 700; }
      .pdf-render .pdf-items-table tr.pdf-row--charge .pdf-item-name { font-size: 8.6pt; }
      .pdf-render .pdf-item-model { margin-top: 1px; font-size: 8.3pt; line-height: 1.28; }
      .pdf-render .pdf-items-table tr.pdf-row--charge .pdf-item-model { font-size: 8.1pt; }
      .pdf-render .pdf-item-subtitle { margin-top: 2px; font-size: 8pt; font-weight: 700; }
      .pdf-render .pdf-item-list { margin: 1px 0 0 0; padding-left: 10px; list-style: disc; }
      .pdf-render .pdf-item-list li { margin: 0 0 1px 0; font-size: 8pt; line-height: 1.28; }

      .pdf-render .pdf-bottom-band {
        margin-top: 3mm;
        border-top: 0 !important;
        padding-top: 0;
        page-break-inside: avoid;
      }
      .pdf-render .pdf-bottom-band-table { width: 100%; border-collapse: collapse; table-layout: fixed; border-top: 0 !important; }
      .pdf-render .pdf-bottom-band-table td { vertical-align: top; padding: 0; }
      .pdf-render .pdf-bottom-band-left { padding-right: 4mm; }
      .pdf-render .pdf-bottom-band-right { text-align: right; }
      .pdf-render .pdf-bottom-terms-table { width: 100%; border-collapse: collapse; table-layout: fixed; }
      .pdf-render .pdf-bottom-terms-table th,
      .pdf-render .pdf-bottom-terms-table td {
        border-bottom: 1px solid #ececec;
        height: 6mm;
        min-height: 6mm;
        padding: 1.2mm 0;
        vertical-align: top;
        overflow-wrap: anywhere;
        word-break: break-word;
      }
      .pdf-render .pdf-bottom-terms-table th {
        width: 24mm;
        padding-right: 1.5mm;
        text-align: left;
        font-size: 8pt;
        font-weight: 700;
      }
      .pdf-render .pdf-bottom-terms-table td {
        font-size: 8.5pt;
        font-weight: 400;
        line-height: 1.28;
      }

      .pdf-render .pdf-totals-wrap {
        width: 68mm;
        margin-left: auto;
        page-break-inside: avoid;
      }
      .pdf-render .pdf-total-table {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid #333;
        border-top: 1px solid #333;
      }
      .pdf-render .pdf-total-table th,
      .pdf-render .pdf-total-table td {
        font-weight: 400;
        padding: 2.2mm 3mm;
        border-bottom: 1px solid #ececec;
        line-height: 5.6mm;
      }
      .pdf-render .pdf-total-table th { font-size: 8.8pt; text-align: left; }
      .pdf-render .pdf-total-table td { font-size: 9.2pt; text-align: right; font-variant-numeric: tabular-nums; }
      .pdf-render .pdf-total-grand-row th,
      .pdf-render .pdf-total-grand-row td {
        font-size: 12pt;
        font-weight: 700;
        line-height: 7.5mm;
        border-top: 1.5px solid #333;
        border-bottom: 0;
        background: transparent;
      }
      .pdf-render .pdf-total-grand-label { padding-top: 2.5mm; padding-bottom: 2.5mm; }
      .pdf-render .pdf-total-grand-value { padding-top: 2.5mm; padding-bottom: 2.5mm; background: #f7f7f7; }

      .pdf-render .pdf-annex-section { margin-top: 6mm; page-break-inside: auto; }
      .pdf-render .pdf-annex-keep-first,
      .pdf-render .pdf-detail-keep-first { page-break-inside: avoid; break-inside: avoid-page; }

      .pdf-render .pdf-section-heading {
        margin: 5mm 0 1.5mm;
        font-size: 9.4pt;
        font-weight: 700;
      }
      .pdf-render .pdf-section-divider {
        border-top: 1px solid #333;
        margin: 0 0 2mm;
      }
      .pdf-render .pdf-section-body { padding: 0; }
      .pdf-render .pdf-section-body--kv { page-break-inside: auto; }
      .pdf-render .pdf-section-body--scope { page-break-inside: auto; }
      .pdf-render .pdf-section-endline { border-top: 1px solid #ececec; margin-top: 2mm; }

      .pdf-render .pdf-kv-table { width: 100%; border-collapse: collapse; table-layout: fixed; }
      .pdf-render .pdf-kv-table th,
      .pdf-render .pdf-kv-table td {
        font-size: 8.5pt;
        line-height: 1.35;
        vertical-align: top;
        min-height: 5.5mm;
        padding: 2.2mm 1.5mm;
        border-bottom: 1px solid #ececec;
        overflow-wrap: anywhere;
        word-break: break-word;
      }
      .pdf-render .pdf-kv-table th { width: 28%; font-weight: 700; text-align: left; }
      .pdf-render .pdf-kv-table td { width: 72%; font-weight: 400; }

      .pdf-render .pdf-box-title {
        border: 1px solid #333;
        background: #f0f0f0;
        padding: 5px 7px;
        font-size: 9.2pt;
        font-weight: 700;
      }
      .pdf-render .pdf-box-body {
        border-left: 1px solid #333;
        border-right: 1px solid #333;
        border-bottom: 1px solid #333;
        padding: 6px 7px;
      }

      .pdf-render .pdf-section-body--container { padding: 0; }
      .pdf-render .pdf-container-table { width: 100%; border-collapse: collapse; table-layout: fixed; margin-top: 0; }
      .pdf-render .pdf-container-table th,
      .pdf-render .pdf-container-table td {
        border-bottom: 1px solid #e1e1e1;
        padding: 4px 5px;
        font-size: 8.5pt;
        text-align: left;
        vertical-align: top;
        overflow-wrap: anywhere;
        word-break: break-word;
      }
      .pdf-render .pdf-container-table thead th {
        background: #f9f9f9;
        font-weight: 700;
        border-top: 1px solid #333;
        border-bottom: 1px solid #333;
      }
      .pdf-render .pdf-container-table th:first-child,
      .pdf-render .pdf-container-table td:first-child { padding-left: 2mm; }
      .pdf-render .pdf-container-table th:last-child,
      .pdf-render .pdf-container-table td:last-child { padding-right: 2mm; }
      .pdf-render .pdf-container-table tbody tr:last-child td { border-bottom: 1px solid #ececec; }
      .pdf-render .pdf-container-capacity { text-align: center; }

      .pdf-render .pdf-scope-list { margin: 0; padding-left: 12px; }
      .pdf-render .pdf-scope-list li { margin: 0 0 2px 0; font-size: 8.5pt; line-height: 1.35; overflow-wrap: anywhere; word-break: break-word; }

      .pdf-render .pdf-detail-table { width: 100%; border-collapse: collapse; table-layout: fixed; }
      .pdf-render .pdf-detail-table-row { page-break-inside: avoid; break-inside: avoid-page; }
      .pdf-render .pdf-detail-table-cell { width: 50%; vertical-align: top; padding: 0 0 3mm; }
      .pdf-render .pdf-detail-table-cell.is-left { padding-right: 3mm; }
      .pdf-render .pdf-detail-table-cell.is-right { padding-left: 3mm; }
      .pdf-render .pdf-detail-table-cell--single { text-align: center; padding-left: 0; padding-right: 0; }
      .pdf-render .pdf-detail-figure { margin: 0; padding-bottom: 0.8mm; }
      .pdf-render .pdf-detail-image-wrap { border: none; background: transparent; padding: 0; text-align: center; }
      .pdf-render .pdf-detail-image {
        display: block;
        width: auto;
        height: auto;
        max-width: 100%;
        margin: 0 auto;
        border: 0;
      }
      .pdf-render .pdf-detail-image.is-wide { max-height: 24mm; }
      .pdf-render .pdf-detail-image.is-normal { max-height: 34mm; }
      .pdf-render .pdf-detail-image.is-tall { max-height: 46mm; }
      .pdf-render .pdf-detail-image-wrap.is-wide-single { max-width: 95mm; margin: 0 auto; }
      .pdf-render .pdf-detail-image.is-wide-single { max-width: 95mm; max-height: 24mm; }
      .pdf-render .pdf-detail-caption {
        margin: 1.5mm 0 0;
        padding-bottom: 1.2mm;
        font-size: 8pt;
        text-align: center;
        line-height: 1.25;
        overflow-wrap: anywhere;
        word-break: break-word;
      }
      .pdf-render .pdf-section-endline--detail { margin-top: 1.5mm; }

      .pdf-render .pdf-annex-section--formal-closing .pdf-formal-closing-block {
        min-height: 60mm;
        page-break-inside: avoid;
        break-inside: avoid-page;
      }
      .pdf-render .pdf-annex-section--formal-closing .pdf-formal-closing-block--terminal {
        min-height: 0;
        page-break-inside: auto;
        break-inside: auto;
      }

      .pdf-render .pdf-bank-block { margin-top: 4mm; border-bottom: 1px solid #333; }
      .pdf-render .pdf-bank-title { font-size: 9pt; font-weight: 700; border-bottom: 1px solid #d9d9d9; }
      .pdf-render .pdf-bank-body p { margin: 0 0 1px 0; font-size: 8.5pt; overflow-wrap: anywhere; word-break: break-word; }

      .pdf-render .pdf-signatures-shell { margin-top: 5mm; padding-top: 0; }
      .pdf-render .pdf-signatures-table { width: 100%; border-collapse: collapse; table-layout: fixed; }
      .pdf-render .pdf-signatures-table td { width: 33.33%; vertical-align: top; padding: 0 3mm; }
      .pdf-render .pdf-signature-area { height: 16mm; text-align: center; }
      .pdf-render .quote-sales-signature-image {
        display: inline-block;
        width: auto;
        height: auto;
        max-width: 100%;
        max-height: 100%;
      }
      .pdf-render .pdf-signature-line { border-top: 1px solid #333; }
      .pdf-render .pdf-signatures-table p { margin: 2mm 0 0; font-size: 8pt; text-align: center; }

    </style>
  </head>
  <body class="public-quote-body pdf-render">
    <main class="public-quote-main">
      <%= yield %>
    </main>
  </body>
</html>
