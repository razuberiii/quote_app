<main class="deal-workspace deal-detail">
  <header class="deal-hero">
    <div><%= link_to "← Deals", deals_path, class: "deal-back" %><p class="eyebrow"><%= @deal.customer&.name || "Buyer to confirm" %></p><h1><%= deal_title(@deal) %></h1><p><%= @deal.quote_no %> · <%= deal_version_label(@deal) %> · Owner <%= current_user.full_name.presence || current_user.username %></p></div>
    <dl><div><dt>Stage</dt><dd class="deal-stage deal-stage--<%= @progress.stage %>"><i></i><%= @progress.stage_label %></dd></div><div><dt>Current amount</dt><dd><%= @deal.currency %> <%= number_with_delimiter(@deal.grand_total) %></dd></div><div><dt>Last buyer activity</dt><dd><%= @progress.signal %></dd></div></dl>
    <div class="deal-primary-action"><span>Next action</span><strong><%= @progress.action_label %></strong><%= link_to @progress.action_label, deal_action_path(@deal, @progress), class: "button button--primary" %><details><summary>More</summary><div><%= link_to "Edit working draft", edit_quote_path(@deal) %><%= link_to "Deliver current Version", deliver_deal_path(@deal, version_id: @versions.first&.id) if @versions.any? %><%= link_to "Add buyer response", new_response_deal_path(@deal, version_id: @versions.first&.id) if @versions.any? %><%= link_to "Record acceptance", new_acceptance_deal_path(@deal, version_id: @versions.first&.id) if @versions.any? && !@acceptance %></div></details></div>
  </header>
  <nav class="deal-tabs"><% [["overview","Overview"],["quote","Quote"],["conversation","Conversation"],["versions","Versions"],["documents","Documents"]].each do |key,label| %><%= link_to label, deal_path(@deal, tab: key), class: ("is-active" if @tab == key) %><% end %></nav>

  <% if @tab == "overview" %><div class="deal-overview-grid"><section class="deal-situation"><p class="section-kicker">Current signals</p><div><article><span>Latest response</span><strong><%= @responses.first&.kind&.humanize || @questions.first&.body&.truncate(48) || "No buyer response" %></strong><small><%= @responses.first ? time_ago_in_words(@responses.first.received_at) + " ago" : "Waiting for buyer input" %></small></article><article><span>Latest delivery</span><strong><%= @deliveries.first ? "#{@deliveries.first.channel.humanize} · #{@deliveries.first.status.humanize}" : "Not delivered" %></strong><small><%= @deliveries.first&.recipient.presence || "Choose a channel after publishing" %></small></article><article class="<%= 'is-blocked' unless @progress.action_key == 'wait' %>"><span>Risk / blocker</span><strong><%= @progress.action_key == "wait" ? "No active blocker" : @progress.action_label %></strong><small><%= @progress.signal %></small></article></div></section><section class="deal-facts"><h2>Commercial snapshot</h2><dl><div><dt>Buyer</dt><dd><%= @deal.customer&.name %></dd></div><div><dt>Items</dt><dd><%= @deal.quote_items.size %></dd></div><div><dt>Currency</dt><dd><%= @deal.currency %></dd></div><div><dt>Valid until</dt><dd><%= @deal.valid_until || "Not set" %></dd></div><div><dt>Deliveries</dt><dd><%= @deliveries.size %> across <%= @deliveries.map(&:channel).uniq.size %> channel(s)</dd></div><div><dt>Acceptance</dt><dd><%= @acceptance ? "#{@acceptance.acceptance_method.humanize} · locked" : "Not recorded" %></dd></div></dl><div class="deal-close-actions"><% if @progress.stage == "closed" %><%= button_to "Reopen Deal", reopen_deal_path(@deal), method: :patch, class: "button button--secondary" %><% else %><%= button_to "Close as won", close_deal_path(@deal), method: :patch, params: { outcome: "won" }, class: "button button--secondary" %><%= button_to "Close as lost", close_deal_path(@deal), method: :patch, params: { outcome: "lost" }, class: "button button--ghost" %><% end %></div></section><section class="deal-timeline"><header><h2>Recent timeline</h2><span>All activity stays with this deal</span></header><ol><% @activities.first(8).each do |activity| %><li><i></i><div><strong><%= activity.kind.humanize %></strong><span><%= activity.metadata["channel"]&.humanize || activity.metadata["label"] || @deal.customer&.name %></span></div><time><%= time_ago_in_words(activity.created_at) %> ago</time></li><% end %><% if @activities.empty? %><li><i></i><div><strong>Deal created</strong><span>Working quote started</span></div><time><%= time_ago_in_words(@deal.created_at) %> ago</time></li><% end %></ol></section></div>
  <% elsif @tab == "quote" %><section class="deal-tab-panel deal-quote-panel"><div><p class="section-kicker">Working draft</p><h2>Build once. Deliver through any channel.</h2><p>The Working draft stays internal. Publishing freezes a Version; Buyer Room, PDF, Excel and external delivery all point to the same snapshot.</p></div><div><%= link_to "Continue in Quote Studio", edit_quote_path(@deal), class: "button button--primary" %><%= link_to "Deliver current Version", deliver_deal_path(@deal, version_id: @versions.first.id), class: "button button--secondary" if @versions.any? %></div></section>
  <% elsif @tab == "conversation" %>
    <section class="conversation-stream">
      <header><p class="section-kicker">Buyer conversation</p><h2>Questions and change requests, with context.</h2></header>
      <div class="conversation-toolbar"><%= link_to "Add buyer response", new_response_deal_path(@deal, version_id: @versions.first&.id), class: "button button--secondary" if @versions.any? %><%= link_to "Record acceptance", new_acceptance_deal_path(@deal, version_id: @versions.first&.id), class: "button button--primary" if @versions.any? && !@acceptance %></div>
      <% @responses.each do |message| %><article class="channel-response" id="<%= dom_id(message) %>"><div><span><%= message.kind.humanize %> · <%= message.source.humanize %></span><strong><%= message.buyer_name.presence || @deal.customer&.name %></strong><time><%= time_ago_in_words(message.received_at) %> ago</time></div><p><%= message.body.presence || "File received for review" %></p><aside><span>Version <%= message.quote_revision.number %></span><strong><%= message.status.humanize %></strong><small><%= message.context_type.humanize %><%= " · #{message.context_key}" if message.context_key.present? %></small></aside><%= render "response_review", response: message if message.difference_review.present? %></article><% end %>
      <% (@questions.to_a + @requests.to_a).sort_by(&:created_at).reverse.each do |message| %>
        <article>
          <div><span><%= message.is_a?(BuyerQuestion) ? "Question · #{message.context_key.presence || 'Quote'}" : "Change request" %></span><strong><%= message.buyer_name.presence || message.buyer_email %></strong><time><%= time_ago_in_words(message.created_at) %> ago</time></div>
          <p><%= message.respond_to?(:body) ? message.body : message.message %></p>
          <% if message.is_a?(BuyerQuestion) && message.seller_reply.present? %>
            <blockquote><span>Seller reply</span><%= message.seller_reply %></blockquote>
          <% elsif message.is_a?(BuyerQuestion) %>
            <%= form_with scope: :buyer_question, url: reply_question_deal_path(@deal, question_id: message.id), method: :patch, class: "conversation-reply" do |form| %>
              <%= form.text_area :seller_reply, placeholder: "Reply with the product and option context preserved", required: true, rows: 3 %>
              <%= form.submit "Reply", class: "button button--primary" %>
            <% end %>
          <% end %>
        </article>
      <% end %>
      <% if @questions.empty? && @requests.empty? && @responses.empty? %><div class="deal-zero"><h2>No buyer responses yet.</h2><p>Buyer Room questions, email, returned files, PO and external messages appear in one Conversation.</p></div><% end %>
    </section>
  <% elsif @tab == "versions" %><section class="versions-list"><header><p class="section-kicker">Published versions</p><h2>Frozen content and every delivery channel.</h2></header><% @versions.each do |version| %><article><span>Version <%= version.number %></span><div><strong><%= version.status == "current" ? "Current published Version" : version.status.humanize %></strong><small>Published <%= time_ago_in_words(version.published_at || version.created_at) %> ago · <%= pluralize(version.version_deliveries.size, "delivery") %></small><% version.version_deliveries.order(delivered_at: :desc).each do |delivery| %><small><%= delivery.channel.humanize %> · <%= delivery.status.humanize %> · <%= delivery.view_status_label %></small><% end %></div><strong><%= version.currency %> <%= number_with_delimiter(version.total) %></strong><%= link_to(version.number == @versions.first.number && @versions.second ? "Compare changes" : "View", quote_revision_path(version), class: "deal-next") %></article><% end %></section>
  <% else %><section class="documents-hub"><header><div><p class="section-kicker">Deal documents</p><h2>One Version. Every output.</h2><p>Generated files remain tied to their immutable commercial source.</p></div><%= link_to "Create delivery", deliver_deal_path(@deal, version_id: @versions.first&.id), class: "button button--primary" if @versions.any? %></header>
    <div class="document-group"><div class="document-group__title"><span>01</span><div><h3>Published quote files</h3><p>Buyer Room, PDF and Excel generated from a frozen Version.</p></div></div><div class="document-list"><% @versions.each do |version| %><article><div class="document-type">V<%= version.number %></div><div><strong><%= @deal.quote_no %> · Version <%= version.number %></strong><small><%= version.status.humanize %> · <%= version.currency %> <%= number_with_delimiter(version.total) %> · Published <%= time_ago_in_words(version.published_at) %> ago</small></div><div class="document-actions"><%= link_to "Buyer Room", buyer_room_path(version.secure_token, preview: 1), target: "_blank" %><%= link_to "Generate / send", deliver_deal_path(@deal, version_id: version.id) %></div></article><% version.version_deliveries.select { |delivery| delivery.generated_file.attached? }.each do |delivery| %><article class="document-file-row"><div class="document-type"><%= delivery.generated_file.filename.extension.upcase %></div><div><strong><%= delivery.generated_file.filename %></strong><small>Version <%= version.number %> · <%= delivery.status.humanize %> · <%= number_to_human_size(delivery.generated_file.byte_size) %><%= " · #{delivery.recipient}" if delivery.recipient.present? %></small><small>Generated <%= time_ago_in_words(delivery.generated_at || delivery.created_at) %> ago · <%= delivery.channel.humanize %></small></div><div class="document-actions"><%= link_to "Download", download_delivery_deal_path(@deal, delivery_id: delivery.id) %><%= link_to "Delivery history", deal_path(@deal, tab: "versions", anchor: "version-#{version.id}") %></div></article><% end %><% end %></div></div>
    <div class="document-group"><div class="document-group__title"><span>02</span><div><h3>Buyer files</h3><p>Returned workbooks, PO, signed files and evidence with review state.</p></div></div><div class="document-list"><% @responses.select { |r| r.attachment.attached? }.each do |response| %><article><div class="document-type"><%= response.kind == "purchase_order" ? "PO" : "IN" %></div><div><strong><%= response.attachment.filename %></strong><small>Version <%= response.quote_revision.number %> · <%= response.status.humanize %> · <%= number_to_human_size(response.attachment.byte_size) %></small></div><div class="document-actions"><%= link_to "Review", deal_path(@deal, tab: "conversation", anchor: dom_id(response)) %></div></article><% end %><% if @responses.none? { |r| r.attachment.attached? } %><div class="document-empty"><strong>No buyer files yet</strong><span>Returned Excel, PO and signed evidence will appear here with their Version context.</span></div><% end %></div></div>
    <div class="document-group"><div class="document-group__title"><span>03</span><div><h3>Final documents</h3><p>Files generated only from the locked Acceptance snapshot.</p></div></div><div class="document-list"><% @final_documents.each do |document| %><article><div class="document-type">FD</div><div><strong><%= document.title %> · <%= document.number %></strong><small>Accepted Version <%= document.quote_revision.number %> · <%= document.status.humanize %> · <%= number_to_human_size(document.file_size) %></small></div><div class="document-actions"><%= link_to "Preview", final_document_path(document) %><%= link_to "Download", pdf_final_document_path(document) if document.file.attached? %></div></article><% end %><% if @acceptance %><div class="document-create"><strong>Generate from Acceptance</strong><%= form_with url: final_documents_path, class: "final-document-form" do |form| %><%= hidden_field_tag :quote_acceptance_id, @acceptance.id %><%= select_tag :document_type, options_for_select(FinalDocument::TYPES.map { |type| [type.humanize, type] }, current_user.company.default_final_document_type), class: "app-ui-input" %><%= text_field_tag :custom_title, nil, class: "app-ui-input", placeholder: "Custom title if selected" %><%= form.submit "Generate file", class: "button button--primary" %><% end %></div><% elsif @final_documents.empty? %><div class="document-empty"><strong>Available after Acceptance</strong><span>Order Confirmation, PI and final offers use the buyer’s immutable accepted selection.</span></div><% end %></div></div>
  </section><% end %>
</main>
