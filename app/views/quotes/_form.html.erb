<% status_value = quote.status.to_s.presence || "draft" %>
<% subtotal_value = quote.subtotal.to_d %>
<% add_ons_value = quote.quote_items.reject(&:marked_for_destruction?).sum { |item| item.addon_total.to_d } %>
<% grand_total_value = quote.grand_total.to_d %>
<% discount_pct_value = subtotal_value.positive? ? ((quote.discount_amount.to_d / subtotal_value) * 100).round(2) : 0 %>
<% days_left_value = quote.valid_until.present? ? (quote.valid_until - Date.current).to_i : nil %>
<% submit_label = local_assigns[:submit_label].presence || (quote.persisted? ? t("quotes.view.form.update_quote") : t("quotes.view.form.create_quote")) %>
<% submit_loading_label = quote.persisted? ? t("quotes.view.form.updating") : t("quotes.view.form.creating") %>
<% pi_mode = quote.pi_document? %>
<% monetary_error_messages = quote.errors.full_messages.select { |message| message.match?(/unit price|line total|grand total|addon charges|tax amount|shipping amount|discount amount|final amount/i) } %>
<%
  products_payload = (@products || []).map do |p|
    image_attachments = []
    if p.image_attachment.present?
      image_attachments << { blob_id: p.image.blob.id, url: rails_blob_path(p.image, only_path: true), label: t("quotes.view.form.product_main_image") }
    end
    p.gallery_images.each_with_index do |attachment, idx|
      image_attachments << { blob_id: attachment.blob.id, url: rails_blob_path(attachment, only_path: true), label: t("quotes.view.form.product_gallery_image", index: idx + 1) }
    end

    {
      id: p.id,
      name: p.name,
      price: p.default_price.to_s("F"),
      currency: p.price_currency,
      default_specs: p.effective_default_specs,
      default_addons: p.effective_default_addons,
      spec_presets: p.available_spec_preset_payloads,
      addon_presets: p.available_addon_preset_payloads,
      default_spec_preset_id: p.default_spec_preset_id,
      default_addon_preset_id: p.default_addon_preset_id,
      image_options: image_attachments
    }
  end.to_json
  quote_preset_payload = (@quote_presets_by_module || {}).to_json
  quote_master_preset_payload = if @quote_preset_master.present?
    QuotePreset::MODULE_KEYS.index_with do |module_key|
      preset = @quote_preset_master.preset_for(module_key)
      preset&.id
    end
  else
    {}
  end.to_json
  product_picture_options = (@products || []).filter_map do |product|
    attachments = []
    attachments << product.image_attachment if product.respond_to?(:image_attachment) && product.image_attachment&.blob.present?
    attachments.concat(Array(product.try(:gallery_images_attachments)))
    pictures = attachments.filter_map do |attachment|
      blob = attachment&.blob
      next if blob.blank?

      { label: "#{product.name} - #{blob.filename}", blob_id: blob.id.to_s, url: rails_blob_path(blob, only_path: true), source: "product_gallery" }
    end
    next if pictures.blank?

    [ product.name, pictures.uniq { |entry| entry[:blob_id] } ]
  end
  quote_uploaded_picture_options = quote.quote_items.filter_map do |item|
    next unless item.item_image.attached?

    blob = item.item_image.blob
    next if blob.blank? || !blob.persisted?
    { label: "#{item.description.to_s.truncate(40)} - #{blob.filename}", blob_id: blob.id.to_s, url: rails_blob_path(blob, only_path: true), source: "quote_upload" }
  end.uniq { |entry| entry[:blob_id] }
  detail_block_items = quote.detail_pictures_block_data["items"]
  detail_block_blob_ids = Array(detail_block_items).map { |item| item["image_blob_id"].to_s }.reject(&:blank?).uniq
  detail_block_blob_map = ActiveStorage::Blob.where(id: detail_block_blob_ids).index_by { |blob| blob.id.to_s }
  detail_block_picture_options = detail_block_blob_ids.filter_map do |blob_id|
    blob = detail_block_blob_map[blob_id]
    next if blob.blank? || !blob.persisted?

    {
      label: blob.filename.to_s,
      blob_id: blob.id.to_s,
      url: rails_blob_path(blob, only_path: true),
      source: "quote_upload"
    }
  end
  detail_picture_catalog_entries = (quote_uploaded_picture_options + detail_block_picture_options + product_picture_options.flat_map(&:last)).uniq { |entry| entry[:blob_id] }
  detail_picture_catalog_payload = detail_picture_catalog_entries.to_json
%>

<div class="quote-edit-shell app-section-stack" id="quote-edit-root" data-has-errors="<%= quote.errors.any? %>">
  <section class="quote-edit-summary app-stat-grid quote-edit-summary--workspace">
    <article class="quote-edit-summary-card">
      <span class="summary-label"><%= t("quotes.view.form.current_status") %></span>
      <strong id="quote-summary-status-text"><%= status_value.capitalize %></strong>
      <span id="quote-summary-status-badge"><%= quote_status_badge(status_value) %></span>
    </article>
    <article class="quote-edit-summary-card quote-edit-summary-card-grand">
      <span class="summary-label"><%= t("quotes.view.form.grand_total") %></span>
      <strong id="quote-summary-grand-total"><%= quote_money(grand_total_value, quote.currency) %></strong>
    </article>
    <article class="quote-edit-summary-card">
      <span class="summary-label"><%= t("quotes.view.form.discount_rate") %></span>
      <strong id="quote-summary-discount-rate"><%= discount_pct_value %>%</strong>
    </article>
    <article class="quote-edit-summary-card">
      <span class="summary-label"><%= t("quotes.view.form.expiry") %></span>
      <strong id="quote-summary-expiry">
        <% if days_left_value.nil? %>
          <%= t("quotes.view.form.no_date") %>
        <% elsif days_left_value.negative? %>
          <%= t("quotes.view.form.expired") %>
        <% else %>
          <%= t("quotes.view.form.days_left", count: days_left_value) %>
        <% end %>
      </strong>
    </article>
  </section>

  <%= form_with model: form_model, html: { id: "quote-form", novalidate: true } do |f| %>
    <% if quote.errors.any? %>
      <div class="error-messages">
        <h2><%= t("quotes.view.form.error_summary", count: quote.errors.count) %></h2>
        <ul>
          <% quote.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="quote-form-inline-error js-quote-client-error" role="alert" hidden>
      <strong><%= t("quotes.view.form.complete_required_fields") %></strong>
      <ul class="js-quote-client-error-list"></ul>
    </div>

    <%= f.hidden_field :quote_no if quote.quote_no.present? %>
    <details class="quote-form-section quote-form-panel quote-form-collapsible" open>
      <summary class="quote-form-section-summary quote-form-section-summary--card">
        <strong><%= t("quotes.view.form.basic_information") %></strong>
        <span class="app-form-section-note"><%= t("quotes.view.form.basic_information_hint") %></span>
      </summary>
      <div class="quote-form-section-body">
      <div class="quote-form-grid">
        <div>
          <%= f.label :template_id, t("quotes.view.form.template") %>
          <%= f.select :template_id,
                       (@template_options || []).map { |t| ["#{t.name} (#{t.layout_type})", t.id] },
                       { include_blank: false },
                       { class: ui_input_classes, data: { searchable_select: true, search_placeholder: t("quotes.view.form.search_template") } } %>
        </div>
        <div>
          <%= f.label :currency %>
          <%= f.select :currency, [ "USD", "EUR", "GBP", "CNY", "JPY", "AUD", "CAD", "SGD", "HKD", "MXN", "BRL", "COP", "CLP", "PEN", "ARS" ], {}, { class: ui_input_classes, disabled: pi_mode } %>
          <%= hidden_field_tag "quote[currency]", quote.currency if pi_mode %>
        </div>
        <div>
          <%= f.label :issued_on, t("quotes.view.form.quote_date") %>
          <%= f.date_field :issued_on, class: ui_input_classes %>
        </div>
        <div>
          <%= f.label :valid_until %>
          <%= f.date_field :valid_until, class: ui_input_classes, min: Date.current.to_s %>
        </div>
        <div class="quote-form-grid-span-2">
          <%= f.label :custom_title, t("quotes.view.form.custom_title") %>
          <%= f.text_field :custom_title, placeholder: t("quotes.view.form.custom_title_placeholder"), class: ui_input_classes %>
        </div>
        <% unless pi_mode %>
        <div>
          <%= f.label :status, t("quotes.view.form.status") %>
          <%= f.hidden_field :status, value: quote.status.presence || "draft" %>
          <div class="quote-status-lock-field">
            <%= quote_status_badge(quote.status.presence || "draft") %>
            <p class="quote-form-hint"><%= t("quotes.view.form.status_locked_draft") %></p>
            <p class="quote-form-hint"><%= t("quotes.view.form.status_locked_draft_hint") %></p>
          </div>
        </div>
        <% end %>
      </div>
      </div>
    </details>

    <details class="quote-form-section quote-form-panel quote-form-collapsible" open>
      <summary class="quote-form-section-summary quote-form-section-summary--card">
        <strong><%= t("quotes.view.form.business_terms") %></strong>
        <span class="app-form-section-note"><%= t("quotes.view.form.business_terms_hint") %></span>
      </summary>
      <div class="quote-form-section-body">
      <% business_presets = Array(@quote_presets_by_module&.dig("business_terms")) %>
      <% if business_presets.any? %>
        <div class="quote-form-add-row quote-form-add-row--preset-actions">
          <p class="quote-form-hint quote-preset-control-hint"><%= t("quotes.view.form.preset_selector_hint", default: "Choosing a preset will overwrite this module's content. Click × to clear.") %></p>
          <div class="quote-preset-control">
            <select id="quote-module-preset-business_terms" class="<%= ui_input_classes %> quote-inline-select" data-searchable-select="true" data-search-placeholder="<%= t("quotes.view.form.select_preset", default: "Search preset") %>">
              <option value=""><%= t("quotes.view.form.select_preset", default: "Select preset") %></option>
              <% business_presets.each do |preset| %>
                <option value="<%= preset[:id] || preset["id"] %>" <%= "selected" if @quote_preset_master&.business_terms_preset_id.to_i == (preset[:id] || preset["id"]).to_i %>><%= preset[:name] || preset["name"] %></option>
              <% end %>
            </select>
            <button type="button" class="quote-preset-clear-btn js-clear-module-preset" data-module-key="business_terms" aria-label="<%= t("quotes.view.form.clear_selected_preset", default: "Clear selected preset") %>">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6L18 18M18 6L6 18" /></svg>
            </button>
          </div>
        </div>
      <% end %>
      <div class="quote-form-grid">
        <div>
          <%= f.label :payment_term %>
          <%= f.text_field :payment_term, placeholder: t("quotes.view.form.payment_term_placeholder"), class: ui_input_classes %>
        </div>
        <div>
          <%= f.label :trade_term, t("quotes.view.form.trade_terms") %>
          <%= f.text_field :trade_term, placeholder: t("quotes.view.form.trade_terms_placeholder"), class: ui_input_classes %>
        </div>
        <div class="quote-form-grid-span-2">
          <%= f.label :delivery_notes %>
          <%= f.text_area :delivery_notes, rows: 2, placeholder: t("quotes.view.form.delivery_notes_placeholder"), class: ui_input_classes %>
        </div>
        <div class="quote-form-grid-span-2">
          <%= f.label :terms_text, t("quotes.view.form.terms") %>
          <%= f.text_area :terms_text, rows: 3, maxlength: Quote::MAX_TERMS_TEXT_LENGTH, placeholder: t("quotes.view.form.terms_placeholder"), class: ui_input_classes %>
        </div>
        <div class="quote-form-grid-span-2">
          <%= f.label :scope_of_supply, t("quotes.view.form.scope_of_supply") %>
          <%= f.text_area :scope_of_supply, rows: 3, maxlength: Quote::MAX_SCOPE_OF_SUPPLY_LENGTH, placeholder: t("quotes.view.form.scope_of_supply_placeholder"), class: ui_input_classes %>
          <p class="quote-form-hint quote-form-hint--scope"><%= t("quotes.view.form.scope_of_supply_hint") %></p>
        </div>
        <div class="quote-form-grid-span-2">
          <%= f.label :legal_disclaimer %>
          <%= f.text_area :legal_disclaimer, rows: 2, placeholder: t("quotes.view.form.legal_disclaimer_placeholder"), class: ui_input_classes %>
        </div>
      </div>
      </div>
    </details>

    <% advanced_sections_open = quote.advanced_mode? || quote.advanced_sections_have_values? %>
    <% advanced_visibility = quote.advanced_visibility_data(template: quote.template) %>
    <details class="quote-form-section quote-form-panel quote-form-advanced" <%= "open" if advanced_sections_open %> <%= "hidden" unless advanced_sections_open %>>
      <summary class="quote-form-section-summary">
        <strong><%= t("quotes.view.form.advanced_quote_sections", default: "Extended Quote Modules") %></strong>
        <span class="quote-form-hint"><%= t("quotes.view.form.advanced_quote_sections_hint", default: "Optional for medium-to-high complexity quotes. Keep off for daily lightweight quoting.") %></span>
      </summary>
      <div class="quote-form-grid mt-3 quote-advanced-master-toggle">
        <div class="quote-form-grid-span-2">
          <%= f.hidden_field :advanced_mode, value: (quote.advanced_mode? ? "1" : "0"), class: "js-advanced-mode-input" %>
          <%= hidden_field_tag "quote[advanced_visibility][show_trade_terms_advanced]", advanced_visibility["show_trade_terms_advanced"] ? "1" : "0", class: "js-advanced-visibility-trade" %>
          <%= hidden_field_tag "quote[advanced_visibility][show_logistics_block]", advanced_visibility["show_logistics_block"] ? "1" : "0", class: "js-advanced-visibility-logistics" %>
        </div>
      </div>

      <% advanced_trade_terms = quote.advanced_trade_terms_data %>
      <% advanced_logistics = quote.advanced_logistics_data %>
      <% advanced_trade_presets = Array(@quote_presets_by_module&.dig("advanced_trade_terms")) %>
      <% advanced_logistics_presets = Array(@quote_presets_by_module&.dig("advanced_logistics")) %>
      <% container_loading_presets = Array(@quote_presets_by_module&.dig("container_loading")) %>
      <% configuration_presets = Array(@quote_presets_by_module&.dig("configuration_block")) %>
      <% formal_closing_presets = Array(@quote_presets_by_module&.dig("formal_closing")) %>
      <% configuration_block = quote.configuration_block_data %>
      <% configuration_rows = quote_configuration_block_rows(configuration_block) %>
      <% detail_pictures_block = quote.detail_pictures_block_data %>
      <% detail_picture_items = quote_detail_picture_items(detail_pictures_block) %>
      <% detail_pictures_enabled = ActiveModel::Type::Boolean.new.cast(detail_pictures_block["enabled"]) || detail_picture_items.any? %>
      <% container_loading_block = quote.container_loading_block_data %>
      <% container_loading_rows = quote_container_loading_rows(container_loading_block) %>
      <% container_loading_enabled = ActiveModel::Type::Boolean.new.cast(container_loading_block["enabled"]) || container_loading_rows.any? %>
      <% container_loading_headers = quote_container_loading_headers(container_loading_block) %>
      <% container_loading_note_enabled = quote_container_loading_note_enabled?(container_loading_block, rows: container_loading_rows) %>
      <% formal_closing_block = quote.formal_closing_block_data %>
      <div class="quote-form-grid">
        <div class="quote-form-grid-span-2 quote-advanced-subsection-head">
          <h4><%= t("quotes.view.form.advanced_trade_terms_title", default: "Extended Trade Terms (Supplement)") %></h4>
          <p class="quote-form-hint"><%= t("quotes.view.form.commercial_summary_editor_hint", default: "Edit this as the commercial summary module for formal quotes.") %></p>
          <p class="quote-form-hint"><%= t("quotes.view.form.advanced_trade_terms_hint", default: "Existing payment term/trade term stay as primary fields. These are supplemental notes.") %></p>
          <% if advanced_trade_presets.any? %>
            <div class="quote-form-add-row quote-form-add-row--preset-actions">
              <p class="quote-form-hint quote-preset-control-hint"><%= t("quotes.view.form.preset_selector_hint", default: "Choosing a preset will overwrite this module's content. Click × to clear.") %></p>
              <div class="quote-preset-control">
                <select id="quote-module-preset-advanced_trade_terms" class="<%= ui_input_classes %> quote-inline-select" data-searchable-select="true" data-search-placeholder="<%= t("quotes.view.form.select_preset", default: "Search preset") %>">
                  <option value=""><%= t("quotes.view.form.select_preset", default: "Select preset") %></option>
                  <% advanced_trade_presets.each do |preset| %>
                    <option value="<%= preset[:id] || preset["id"] %>" <%= "selected" if @quote_preset_master&.advanced_trade_terms_preset_id.to_i == (preset[:id] || preset["id"]).to_i %>><%= preset[:name] || preset["name"] %></option>
                  <% end %>
                </select>
                <button type="button" class="quote-preset-clear-btn js-clear-module-preset" data-module-key="advanced_trade_terms" aria-label="<%= t("quotes.view.form.clear_selected_preset", default: "Clear selected preset") %>">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6L18 18M18 6L6 18" /></svg>
                </button>
              </div>
            </div>
          <% end %>
        </div>
        <div>
          <label><%= t("quotes.view.form.hs_code", default: "HS Code") %></label>
          <%= text_field_tag "quote[advanced_trade_terms][hs_code]", advanced_trade_terms["hs_code"], class: ui_input_classes, placeholder: "8703.10" %>
        </div>
        <div>
          <label><%= t("quotes.view.form.warranty_scope_note", default: "Warranty Scope Note") %></label>
          <%= text_field_tag "quote[advanced_trade_terms][warranty_scope_note]", advanced_trade_terms["warranty_scope_note"], class: ui_input_classes %>
        </div>
        <div>
          <label><%= t("quotes.view.form.support_scope_note", default: "Support Scope Note") %></label>
          <%= text_field_tag "quote[advanced_trade_terms][support_scope_note]", advanced_trade_terms["support_scope_note"], class: ui_input_classes %>
        </div>
        <div class="quote-form-grid-span-2">
          <label><%= t("quotes.view.form.validity_clause_note", default: "Validity Clause Note") %></label>
          <%= text_area_tag "quote[advanced_trade_terms][validity_clause_note]", advanced_trade_terms["validity_clause_note"], rows: 2, class: ui_input_classes %>
        </div>
        <div class="quote-form-grid-span-2">
          <label><%= t("quotes.view.form.delivery_commitment_note", default: "Delivery Commitment Note") %></label>
          <%= text_area_tag "quote[advanced_trade_terms][delivery_commitment_note]", advanced_trade_terms["delivery_commitment_note"], rows: 2, class: ui_input_classes %>
        </div>
        <div class="quote-form-grid-span-2">
          <label><%= t("quotes.view.form.payment_clause_note", default: "Payment Clause Note") %></label>
          <%= text_area_tag "quote[advanced_trade_terms][payment_clause_note]", advanced_trade_terms["payment_clause_note"], rows: 2, class: ui_input_classes %>
        </div>

        <div class="quote-form-grid-span-2 quote-advanced-subsection-head quote-advanced-subsection-head--logistics">
          <h4><%= t("quotes.view.form.advanced_logistics_title", default: "Extended Logistics (Supplement)") %></h4>
          <p class="quote-form-hint"><%= t("quotes.view.form.logistics_summary_editor_hint", default: "Edit this as the logistics summary module for formal quotes.") %></p>
          <% if advanced_logistics_presets.any? %>
            <div class="quote-form-add-row quote-form-add-row--preset-actions">
              <p class="quote-form-hint quote-preset-control-hint"><%= t("quotes.view.form.preset_selector_hint", default: "Choosing a preset will overwrite this module's content. Click × to clear.") %></p>
              <div class="quote-preset-control">
                <select id="quote-module-preset-advanced_logistics" class="<%= ui_input_classes %> quote-inline-select" data-searchable-select="true" data-search-placeholder="<%= t("quotes.view.form.select_preset", default: "Search preset") %>">
                  <option value=""><%= t("quotes.view.form.select_preset", default: "Select preset") %></option>
                  <% advanced_logistics_presets.each do |preset| %>
                    <option value="<%= preset[:id] || preset["id"] %>" <%= "selected" if @quote_preset_master&.advanced_logistics_preset_id.to_i == (preset[:id] || preset["id"]).to_i %>><%= preset[:name] || preset["name"] %></option>
                  <% end %>
                </select>
                <button type="button" class="quote-preset-clear-btn js-clear-module-preset" data-module-key="advanced_logistics" aria-label="<%= t("quotes.view.form.clear_selected_preset", default: "Clear selected preset") %>">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6L18 18M18 6L6 18" /></svg>
                </button>
              </div>
            </div>
          <% end %>
        </div>
        <div>
          <label><%= t("quotes.view.form.container_type", default: "Container Type") %></label>
          <%= text_field_tag "quote[advanced_logistics][container_type]", advanced_logistics["container_type"], class: ui_input_classes, placeholder: "40HQ" %>
        </div>
        <div>
          <label><%= t("quotes.view.form.freight_note", default: "Freight Note") %></label>
          <%= text_field_tag "quote[advanced_logistics][freight_note]", advanced_logistics["freight_note"], class: ui_input_classes %>
        </div>
        <div class="quote-form-grid-span-2">
          <label><%= t("quotes.view.form.shipping_scope_note", default: "Shipping Scope Note") %></label>
          <%= text_area_tag "quote[advanced_logistics][shipping_scope_note]", advanced_logistics["shipping_scope_note"], rows: 2, class: ui_input_classes %>
        </div>
        <div class="quote-form-grid-span-2">
          <label><%= t("quotes.view.form.container_loading_note", default: "Container Loading Note") %></label>
          <p class="quote-form-hint"><%= t("quotes.view.form.container_loading_editor_hint", default: "Use matrix rows first. This note is fallback narrative when no valid rows are provided.") %></p>
          <%= text_area_tag "quote[advanced_logistics][container_loading_note]", advanced_logistics["container_loading_note"], rows: 2, class: ui_input_classes %>
        </div>

        <div class="quote-form-grid-span-2 quote-advanced-subsection-head quote-advanced-subsection-head--logistics">
          <h4><%= t("quote_document.sections.container_loading", default: "Container Loading") %></h4>
          <p class="quote-form-hint"><%= t("quotes.view.form.container_loading_matrix_editor_hint", default: "Lightweight matrix rows. If empty, output falls back to Container Loading Note narrative.") %></p>
          <% if container_loading_presets.any? %>
            <div class="quote-form-add-row quote-form-add-row--preset-actions">
              <p class="quote-form-hint quote-preset-control-hint"><%= t("quotes.view.form.preset_selector_hint", default: "Choosing a preset will overwrite this module's content. Click × to clear.") %></p>
              <div class="quote-preset-control">
                <select id="quote-module-preset-container_loading" class="<%= ui_input_classes %> quote-inline-select" data-searchable-select="true" data-search-placeholder="<%= t("quotes.view.form.select_preset", default: "Search preset") %>">
                  <option value=""><%= t("quotes.view.form.select_preset", default: "Select preset") %></option>
                  <% container_loading_presets.each do |preset| %>
                    <option value="<%= preset[:id] || preset["id"] %>" <%= "selected" if @quote_preset_master&.container_loading_preset_id.to_i == (preset[:id] || preset["id"]).to_i %>><%= preset[:name] || preset["name"] %></option>
                  <% end %>
                </select>
                <button type="button" class="quote-preset-clear-btn js-clear-module-preset" data-module-key="container_loading" aria-label="<%= t("quotes.view.form.clear_selected_preset", default: "Clear selected preset") %>">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6L18 18M18 6L6 18" /></svg>
                </button>
