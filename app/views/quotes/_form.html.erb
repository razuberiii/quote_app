<% status_value = quote.status.to_s.presence || "draft" %>
<% subtotal_value = quote.subtotal.to_d %>
<% add_ons_value = quote.quote_items.reject(&:marked_for_destruction?).sum { |item| item.addon_total.to_d } %>
<% grand_total_value = quote.grand_total.to_d %>
<% discount_pct_value = subtotal_value.positive? ? ((quote.discount_amount.to_d / subtotal_value) * 100).round(2) : 0 %>
<% days_left_value = quote.valid_until.present? ? (quote.valid_until - Date.current).to_i : nil %>
<% was_viewed = quote.viewed_at.present? %>
<% submit_loading_label = quote.persisted? ? t("quotes.view.form.updating") : t("quotes.view.form.creating") %>
<% monetary_error_messages = quote.errors.full_messages.select { |message| message.match?(/unit price|line total|grand total|addon charges|tax amount|shipping amount|discount amount|final amount/i) } %>
<% products_payload = (@products || []).map { |p| { id: p.id, name: p.name, price: p.default_price.to_s("F"), currency: p.price_currency, default_specs: p.effective_default_specs, default_addons: p.effective_default_addons, spec_presets: p.available_spec_preset_payloads, addon_presets: p.available_addon_preset_payloads, default_spec_preset_id: p.default_spec_preset_id, default_addon_preset_id: p.default_addon_preset_id } }.to_json %>

<div class="quote-edit-shell app-section-stack" id="quote-edit-root" data-viewed="<%= was_viewed %>" data-has-errors="<%= quote.errors.any? %>">
  <section class="quote-edit-summary app-stat-grid quote-edit-summary--workspace">
    <article class="quote-edit-summary-card">
      <span class="summary-label"><%= t("quotes.view.form.current_status") %></span>
      <strong id="quote-summary-status-text"><%= status_value.capitalize %></strong>
      <span id="quote-summary-status-badge"><%= quote_status_badge(status_value) %></span>
    </article>
    <article class="quote-edit-summary-card quote-edit-summary-card-grand">
      <span class="summary-label"><%= t("quotes.view.form.grand_total") %></span>
      <strong id="quote-summary-grand-total"><%= quote_money(grand_total_value, quote.currency) %></strong>
    </article>
    <article class="quote-edit-summary-card">
      <span class="summary-label"><%= t("quotes.view.form.discount_rate") %></span>
      <strong id="quote-summary-discount-rate"><%= discount_pct_value %>%</strong>
    </article>
    <article class="quote-edit-summary-card">
      <span class="summary-label"><%= t("quotes.view.form.expiry") %></span>
      <strong id="quote-summary-expiry">
        <% if days_left_value.nil? %>
          <%= t("quotes.view.form.no_date") %>
        <% elsif days_left_value.negative? %>
          <%= t("quotes.view.form.expired") %>
        <% else %>
          <%= t("quotes.view.form.days_left", count: days_left_value) %>
        <% end %>
      </strong>
    </article>
    <article class="quote-edit-summary-card">
      <span class="summary-label"><%= t("quotes.view.form.viewed") %></span>
      <strong id="quote-summary-viewed"><%= was_viewed ? t("quotes.view.form.yes") : t("quotes.view.form.no") %></strong>
    </article>
  </section>

  <%= form_with model: form_model, html: { id: "quote-form", novalidate: true } do |f| %>
    <% if quote.errors.any? %>
      <div class="error-messages">
        <h2><%= t("quotes.view.form.error_summary", count: quote.errors.count) %></h2>
        <ul>
          <% quote.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="quote-form-inline-error js-quote-client-error" role="alert" hidden>
      <strong><%= t("quotes.view.form.complete_required_fields") %></strong>
      <ul class="js-quote-client-error-list"></ul>
    </div>

    <%= f.hidden_field :quote_no if quote.quote_no.present? %>

    <section class="quote-form-section quote-form-panel">
      <div class="app-form-section-head">
        <h3><%= t("quotes.view.form.basic_information") %></h3>
        <p class="app-form-section-note"><%= t("quotes.view.form.basic_information_hint") %></p>
      </div>
      <div class="quote-form-grid">
        <div>
          <%= f.label :template_id, t("quotes.view.form.template") %>
          <%= f.select :template_id,
                       (@template_options || []).map { |t| ["#{t.name} (#{t.layout_type})", t.id] },
                       { include_blank: false },
                       { class: ui_input_classes, data: { searchable_select: true, search_placeholder: t("quotes.view.form.search_template") } } %>
        </div>
        <div>
          <%= f.label :currency %>
          <%= f.select :currency, [ "USD", "EUR", "GBP", "CNY", "JPY", "AUD", "CAD", "SGD", "HKD" ], {}, { class: ui_input_classes } %>
        </div>
        <div>
          <%= f.label :issued_on, t("quotes.view.form.quote_date") %>
          <%= f.date_field :issued_on, class: ui_input_classes %>
        </div>
        <div>
          <%= f.label :valid_until %>
          <%= f.date_field :valid_until, class: ui_input_classes %>
        </div>
        <div class="quote-form-grid-span-2">
          <%= f.label :custom_title, t("quotes.view.form.custom_title") %>
          <%= f.text_field :custom_title, placeholder: t("quotes.view.form.custom_title_placeholder"), class: ui_input_classes %>
        </div>
        <div>
          <%= f.label :status %>
          <%= f.select :status,
                       [[t("quotes.view.form.status_options.draft"), "draft"], [t("quotes.view.form.status_options.sent"), "sent"], [t("quotes.view.form.status_options.viewed"), "viewed"], [t("quotes.view.form.status_options.negotiating"), "negotiating"], [t("quotes.view.form.status_options.won"), "won"], [t("quotes.view.form.status_options.lost"), "lost"], [t("quotes.view.form.status_options.expired"), "expired"]],
                       {},
                       { class: ui_input_classes } %>
        </div>
      </div>
    </section>

    <section class="quote-form-section quote-form-panel">
      <div class="app-form-section-head">
        <h3><%= t("quotes.view.form.business_terms") %></h3>
        <p class="app-form-section-note"><%= t("quotes.view.form.business_terms_hint") %></p>
      </div>
      <div class="quote-form-grid">
        <div>
          <%= f.label :payment_term %>
          <%= f.text_field :payment_term, placeholder: t("quotes.view.form.payment_term_placeholder"), class: ui_input_classes %>
        </div>
        <div>
          <%= f.label :trade_term, t("quotes.view.form.trade_terms") %>
          <%= f.text_field :trade_term, placeholder: t("quotes.view.form.trade_terms_placeholder"), class: ui_input_classes %>
        </div>
        <div class="quote-form-grid-span-2">
          <%= f.label :delivery_notes %>
          <%= f.text_area :delivery_notes, rows: 2, placeholder: t("quotes.view.form.delivery_notes_placeholder"), class: ui_input_classes %>
        </div>
        <div class="quote-form-grid-span-2">
          <%= f.label :terms_text, t("quotes.view.form.terms") %>
          <%= f.text_area :terms_text, rows: 3, placeholder: t("quotes.view.form.terms_placeholder"), class: ui_input_classes %>
        </div>
        <div class="quote-form-grid-span-2">
          <%= f.label :legal_disclaimer %>
          <%= f.text_area :legal_disclaimer, rows: 2, placeholder: t("quotes.view.form.legal_disclaimer_placeholder"), class: ui_input_classes %>
        </div>
      </div>
    </section>

    <section class="quote-form-section quote-form-panel">
      <div class="app-form-section-head">
        <h3><%= t("quotes.view.form.internal_information") %></h3>
        <p class="app-form-section-note"><%= t("quotes.view.form.internal_information_hint") %></p>
      </div>
      <div class="quote-form-grid">
        <div class="quote-form-grid-span-2">
          <%= f.label :notes %>
          <%= f.text_area :notes, rows: 3, placeholder: t("quotes.view.form.internal_notes_placeholder"), class: ui_input_classes %>
        </div>
        <div class="quote-conditional" data-show-when-status="won">
          <%= f.label :final_amount, t("quotes.view.form.final_amount") %>
          <%= f.number_field :final_amount, step: 0.01, class: ui_input_classes("js-final-amount") %>
        </div>
        <div class="quote-conditional" data-show-when-status="won">
          <%= f.label :win_reason %>
          <%= f.select :win_reason,
                       Quote.reason_options_for(:win).map { |reason| [reason.humanize, reason] },
                       { include_blank: t("quotes.view.form.select_win_reason") },
                       { class: ui_input_classes("js-win-reason") } %>
        </div>
        <div class="quote-conditional quote-conditional-detail" data-show-when-status="won" data-reason-detail-for="win">
          <%= f.label :win_reason_detail, t("quotes.view.form.win_reason_details") %>
          <%= f.text_field :win_reason_detail,
                           placeholder: t("quotes.view.form.win_reason_details_placeholder"),
                           class: ui_input_classes("js-win-reason-detail") %>
        </div>
        <div class="quote-conditional" data-show-when-status="lost">
          <%= f.label :loss_reason %>
          <%= f.select :loss_reason,
                       Quote.reason_options_for(:loss).map { |reason| [reason.humanize, reason] },
                       { include_blank: t("quotes.view.form.select_loss_reason") },
                       { class: ui_input_classes("js-loss-reason") } %>
        </div>
        <div class="quote-conditional quote-conditional-detail" data-show-when-status="lost" data-reason-detail-for="loss">
          <%= f.label :loss_reason_detail, t("quotes.view.form.loss_reason_details") %>
          <%= f.text_field :loss_reason_detail,
                           placeholder: t("quotes.view.form.loss_reason_details_placeholder"),
                           class: ui_input_classes("js-loss-reason-detail") %>
        </div>
        <div class="quote-conditional quote-form-grid-span-2" data-show-when-status="sent,viewed,negotiating,expired">
          <%= f.label :stalled_reason, t("quotes.view.form.stalled_reason") %>
          <%= f.select :stalled_reason,
                       Quote.reason_options_for(:stalled).map { |reason| [reason.humanize, reason] },
                       { include_blank: t("quotes.view.form.select_stalled_reason") },
                       { class: ui_input_classes("js-stalled-reason") } %>
        </div>
        <div class="quote-conditional quote-conditional-detail quote-form-grid-span-2" data-show-when-status="sent,viewed,negotiating,expired" data-reason-detail-for="stalled">
          <%= f.label :stalled_reason_detail, t("quotes.view.form.pressure_reason_details") %>
          <%= f.text_field :stalled_reason_detail,
                           placeholder: t("quotes.view.form.pressure_reason_details_placeholder"),
                           class: ui_input_classes("js-stalled-reason-detail") %>
        </div>
      </div>
    </section>

    <section class="quote-form-section quote-form-section-totals quote-form-panel">
      <div class="quote-totals-inputs">
        <div class="app-form-section-head">
          <h3><%= t("quotes.view.form.totals_inputs") %></h3>
          <p class="app-form-section-note quote-money-context"><%= t("quotes.view.form.settlement_currency") %>: <strong class="js-currency-code"><%= quote.currency %></strong></p>
        </div>
        <div class="quote-form-grid">
          <div>
            <%= f.label :tax_amount, t("quotes.view.form.tax_vat") %>
            <div class="quote-money-input">
              <%= f.number_field :tax_amount, step: 0.01, class: ui_input_classes("js-tax-input") %>
            </div>
          </div>
          <div>
            <%= f.label :shipping_amount, t("quotes.view.form.shipping_handling") %>
            <div class="quote-money-input">
              <%= f.number_field :shipping_amount, step: 0.01, class: ui_input_classes("js-shipping-input") %>
            </div>
          </div>
          <div class="quote-discount-row js-discount-row" <%= "hidden" unless quote.discount_amount.to_d.positive? %>>
            <%= f.label :discount_amount, t("quotes.view.form.discount") %>
            <div class="quote-money-input">
              <%= f.number_field :discount_amount, step: 0.01, class: ui_input_classes("js-discount-input") %>
            </div>
            <button type="button" class="quote-inline-link js-remove-discount"><%= t("quotes.view.form.remove_discount") %></button>
          </div>
        </div>
        <button type="button" class="quote-inline-link js-add-discount" <%= "hidden" if quote.discount_amount.to_d.positive? %>><%= t("quotes.view.form.add_discount") %></button>
      </div>

      <aside class="quote-live-totals">
        <h4><%= t("quotes.view.form.totals") %></h4>
        <p><span><%= t("quotes.view.form.subtotal") %></span><strong id="quote-live-subtotal"><%= quote_money(subtotal_value, quote.currency) %></strong></p>
        <p><span><%= t("quotes.view.form.addons_total") %></span><strong id="quote-live-addons"><%= quote_money(add_ons_value, quote.currency) %></strong></p>
        <p><span><%= t("quotes.view.form.tax_vat") %></span><strong id="quote-live-tax"><%= quote_money(quote.tax_amount.to_d, quote.currency) %></strong></p>
        <p><span><%= t("quotes.view.form.shipping") %></span><strong id="quote-live-shipping"><%= quote_money(quote.shipping_amount.to_d, quote.currency) %></strong></p>
        <p class="quote-live-reduction js-live-original-total" <%= "hidden" unless quote.discount_amount.to_d.positive? %>><span><%= t("quotes.view.form.original_total") %></span><strong id="quote-live-original-total"><%= quote_money((subtotal_value + quote.tax_amount.to_d + quote.shipping_amount.to_d), quote.currency) %></strong></p>
        <p class="quote-live-discount js-live-discount-row" <%= "hidden" unless quote.discount_amount.to_d.positive? %>><span><%= t("quotes.view.form.discount") %></span><strong id="quote-live-discount"><%= quote_money(quote.discount_amount.to_d, quote.currency) %></strong></p>
        <p class="quote-live-grand"><span><%= t("quotes.view.form.grand_total") %></span><strong id="quote-live-grand"><%= quote_money(grand_total_value, quote.currency) %></strong></p>
        <p class="quote-live-saved js-live-saved-row" <%= "hidden" unless quote.discount_amount.to_d.positive? %>><span><%= t("quotes.view.form.you_save") %></span><strong id="quote-live-saved"><%= quote_money(quote.discount_amount.to_d, quote.currency) %></strong></p>
      </aside>
    </section>

    <section class="quote-form-section quote-form-panel">
      <div class="app-form-section-head">
        <h3><%= t("quotes.view.form.quote_items") %></h3>
        <p class="app-form-section-note"><%= t("quotes.view.form.quote_items_hint") %></p>
      </div>
      <p class="quote-form-hint">
        <%= t("quotes.view.form.quote_item_hint_1") %>
      </p>
      <p class="quote-form-hint">
        <%= t("quotes.view.form.quote_item_hint_2") %>
      </p>
      <p class="quote-form-hint"><%= t("quotes.view.form.quote_item_hint_3") %></p>
      <p class="quote-form-hint"><%= t("quotes.view.form.quote_item_hint_4") %></p>
      <p class="quote-form-hint quote-form-hint-warning" id="quote-currency-mismatch-warning" hidden>
        <%= t("quotes.view.form.currency_mismatch_warning") %>
      </p>
      <% if monetary_error_messages.any? %>
        <div class="quote-form-inline-error" role="alert">
          <strong><%= t("quotes.view.form.pricing_attention_needed") %></strong>
          <ul>
            <% monetary_error_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div data-products="<%= products_payload %>" id="quote-items-wrapper">
        <div class="table-responsive quote-items-responsive">
          <table class="quote-items-table app-data-table">
            <thead>
              <tr>
                <th><%= t("quotes.view.form.product_name") %></th>
                <th><%= t("quotes.view.form.specifications") %></th>
                <th><%= t("quotes.view.form.add_ons") %></th>
                <th><%= t("quotes.view.form.unit_price") %></th>
                <th><%= t("quotes.view.form.quantity") %></th>
                <th><%= t("quotes.view.form.remove") %></th>
              </tr>
            </thead>
            <tbody id="quote-items-body">
              <%= f.fields_for :quote_items do |item_fields| %>
                <% item = item_fields.object %>
                <% product_name = item.product&.name.presence || item.description.to_s %>
                <tr class="quote-item-row">
                  <td class="quote-col-product">
                    <div class="product-search">
                      <input type="text" class="js-product-name" value="<%= product_name %>" placeholder="<%= t("quotes.view.form.type_to_search_product") %>">
                      <div class="js-product-dropdown"></div>
                    </div>
                    <div class="js-product-feedback product-feedback" aria-live="polite"></div>
                    <%= item_fields.hidden_field :product_id, class: "js-product-id" %>
                  </td>
                  <%= item_fields.hidden_field :description, class: "js-description" %>
                  <td class="quote-col-specs">
                    <% spec_payloads = item.product&.available_spec_preset_payloads || [] %>
                    <select class="js-spec-preset-select quote-inline-select <%= ui_input_classes %>" data-default-id="<%= item.product&.default_spec_preset_id %>">
                      <option value=""><%= t("quotes.view.form.custom_specs") %></option>
                      <% spec_payloads.each do |preset| %>
                        <option value="<%= preset[:id] %>" <%= "selected" if item.product&.default_spec_preset_id.to_s == preset[:id].to_s %>><%= preset[:name] %></option>
                      <% end %>
                    </select>
                    <%= item_fields.text_area :specifications_text, rows: 2, class: "js-specifications sr-only-input", placeholder: "Power: 5kW&#10;Voltage: 220V" %>
                    <div class="quote-kv-summary js-spec-summary"></div>
                    <button type="button" class="quote-kv-open js-open-spec-editor"><%= t("quotes.view.form.edit_specs") %></button>
                    <div class="quote-kv-editor js-spec-editor" data-kind="spec">
                      <div class="quote-kv-editor-head">
                        <strong><%= t("quotes.view.form.specifications") %></strong>
                        <button type="button" class="quote-kv-close js-kv-close"><%= t("quotes.view.form.close") %></button>
                      </div>
                      <div class="quote-kv-bulk">
                        <textarea class="quote-kv-bulk-input js-spec-bulk-input" rows="3" placeholder="<%= t("quotes.view.form.spec_bulk_placeholder") %>"></textarea>
                        <div class="quote-kv-bulk-actions">
                          <button type="button" class="quote-kv-parse js-spec-bulk-apply"><%= t("quotes.view.form.apply_text") %></button>
                          <span class="quote-kv-bulk-check js-spec-bulk-check" aria-live="polite"></span>
                        </div>
                      </div>
                      <div class="quote-kv-rows js-kv-rows">
                        <% spec_rows = item.specification_pairs.presence || [ { key: "", value: "" } ] %>
                        <% spec_rows.each do |pair| %>
                          <div class="quote-kv-row">
                            <input type="text" class="js-kv-key" value="<%= pair[:key] %>" placeholder="<%= t("quotes.view.form.spec_key_placeholder") %>">
                            <input type="text" class="js-kv-value" value="<%= pair[:value] %>" placeholder="<%= t("quotes.view.form.spec_value_placeholder") %>">
                            <button type="button" class="quote-kv-remove js-kv-remove" aria-label="<%= t("quotes.view.form.remove_specification") %>">&times;</button>
                          </div>
                        <% end %>
                      </div>
                      <div class="quote-kv-actions">
                        <button type="button" class="quote-kv-add js-kv-add"><%= t("quotes.view.form.add_spec") %></button>
                        <button type="button" class="quote-kv-clear js-kv-clear-all"><%= t("quotes.view.form.clear_all") %></button>
                      </div>
                    </div>
                  </td>
                  <td class="quote-col-addons">
                    <% addon_payloads = item.product&.available_addon_preset_payloads || [] %>
                    <select class="js-addon-preset-select quote-inline-select <%= ui_input_classes %>" data-default-id="<%= item.product&.default_addon_preset_id %>">
                      <option value=""><%= t("quotes.view.form.custom_add_ons") %></option>
                      <% addon_payloads.each do |preset| %>
                        <option value="<%= preset[:id] %>" <%= "selected" if item.product&.default_addon_preset_id.to_s == preset[:id].to_s %>><%= preset[:name] %></option>
                      <% end %>
                    </select>
                    <%= item_fields.text_area :addon_charges_text, rows: 2, class: "js-addon-charges sr-only-input", placeholder: "Packaging: 30&#10;Installation: 120" %>
                    <div class="quote-kv-summary js-addon-summary"></div>
                    <button type="button" class="quote-kv-open js-open-addon-editor"><%= t("quotes.view.form.edit_add_ons") %></button>
                    <div class="quote-kv-editor js-addon-editor" data-kind="addon">
                      <div class="quote-kv-editor-head">
                        <strong><%= t("quotes.view.form.add_ons") %></strong>
                        <button type="button" class="quote-kv-close js-kv-close"><%= t("quotes.view.form.close") %></button>
                      </div>
                      <div class="quote-kv-bulk">
                        <textarea class="quote-kv-bulk-input js-addon-bulk-input" rows="3" placeholder="<%= t("quotes.view.form.addon_bulk_placeholder") %>"></textarea>
                        <div class="quote-kv-bulk-actions">
                          <button type="button" class="quote-kv-parse js-addon-bulk-apply"><%= t("quotes.view.form.apply_text") %></button>
                          <span class="quote-kv-bulk-check js-addon-bulk-check" aria-live="polite"></span>
                        </div>
                      </div>
                      <div class="quote-kv-rows js-kv-rows">
                        <% addon_rows = item.addon_charge_entries.presence || [ { name: "", amount: "" } ] %>
                        <% addon_rows.each do |entry| %>
                          <div class="quote-kv-row quote-kv-row-addon">
                            <input type="text" class="js-addon-name" value="<%= entry[:name] %>" placeholder="<%= t("quotes.view.form.addon_name_placeholder") %>">
                            <input type="number" step="0.01" min="0" class="js-addon-amount" value="<%= entry[:amount] %>" placeholder="0.00">
                            <button type="button" class="quote-kv-remove js-kv-remove" aria-label="<%= t("quotes.view.form.remove_add_on") %>">&times;</button>
                          </div>
                        <% end %>
                      </div>
                      <div class="quote-kv-actions">
                        <button type="button" class="quote-kv-add js-kv-add"><%= t("quotes.view.form.add_add_on") %></button>
                        <button type="button" class="quote-kv-clear js-kv-clear-all"><%= t("quotes.view.form.clear_all") %></button>
                      </div>
                    </div>
                  </td>
                  <td class="quote-col-price">
                    <%= item_fields.number_field :unit_price, step: 0.01, class: ui_input_classes("js-unit-price"), placeholder: "0.00" %>
                  </td>
                  <td class="quote-col-qty">
                    <%= item_fields.number_field :quantity, min: 1, placeholder: "1", class: ui_input_classes("js-quantity") %>
                  </td>
                  <td class="quote-col-remove">
                    <%= item_fields.hidden_field :_destroy, class: "js-destroy-flag" %>
                    <button type="button" class="quote-item-remove-icon js-remove-item" aria-label="<%= t("quotes.view.form.remove_item") %>">&times;</button>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <div class="quote-form-add-row">
          <button type="button" class="<%= ui_button_classes(:secondary) %>" id="add-quote-item"><%= t("quotes.view.form.add_item") %></button>
        </div>
      </div>
    </section>

    <div class="quote-form-submit">
      <%= f.submit nil, class: ui_button_classes(:primary), data: { default_label: (quote.persisted? ? t("quotes.view.form.update_quote") : t("quotes.view.form.create_quote")) } %>
    </div>
  <% end %>
</div>

<script>
  (function() {
    const root = document.getElementById("quote-edit-root");
    const wrapper = document.getElementById("quote-items-wrapper");
    const form = document.getElementById("quote-form");
    if (!wrapper || !root) return;

    const products = JSON.parse(wrapper.dataset.products || "[]");
    const body = document.getElementById("quote-items-body");
    const addBtn = document.getElementById("add-quote-item");
    const statusInput = document.querySelector("[name='quote[status]']");
    const currencyInput = document.querySelector("[name='quote[currency]']");
    const validUntilInput = document.querySelector("[name='quote[valid_until]']");
    const finalAmountInput = document.querySelector(".js-final-amount");
    const winReasonInput = document.querySelector(".js-win-reason");
    const winReasonDetailInput = document.querySelector(".js-win-reason-detail");
    const lossReasonInput = document.querySelector(".js-loss-reason");
    const lossReasonDetailInput = document.querySelector(".js-loss-reason-detail");
    const stalledReasonInput = document.querySelector(".js-stalled-reason");
    const stalledReasonDetailInput = document.querySelector(".js-stalled-reason-detail");
    const taxInput = document.querySelector(".js-tax-input");
    const shippingInput = document.querySelector(".js-shipping-input");
    const discountInput = document.querySelector(".js-discount-input");
    const discountRow = document.querySelector(".js-discount-row");
    const addDiscountBtn = document.querySelector(".js-add-discount");
    const removeDiscountBtn = document.querySelector(".js-remove-discount");

    const statusText = document.getElementById("quote-summary-status-text");
    const statusBadge = document.getElementById("quote-summary-status-badge");
    const summaryGrand = document.getElementById("quote-summary-grand-total");
    const summaryDiscount = document.getElementById("quote-summary-discount-rate");
    const summaryExpiry = document.getElementById("quote-summary-expiry");

    const liveSubtotal = document.getElementById("quote-live-subtotal");
    const liveAddons = document.getElementById("quote-live-addons");
    const liveTax = document.getElementById("quote-live-tax");
    const liveShipping = document.getElementById("quote-live-shipping");
    const liveDiscount = document.getElementById("quote-live-discount");
    const liveOriginalTotal = document.getElementById("quote-live-original-total");
    const liveGrand = document.getElementById("quote-live-grand");
    const liveSaved = document.getElementById("quote-live-saved");
    const liveDiscountRow = document.querySelector(".js-live-discount-row");
    const liveOriginalRow = document.querySelector(".js-live-original-total");
    const liveSavedRow = document.querySelector(".js-live-saved-row");
    const mismatchWarning = document.getElementById("quote-currency-mismatch-warning");
    const submitButton = form?.querySelector("input[type='submit'], button[type='submit']");
    const clientErrorBox = form?.querySelector(".js-quote-client-error");
    const clientErrorList = form?.querySelector(".js-quote-client-error-list");

    const statusLabels = {
      draft: "<%= j(t('quotes.view.form.status_options.draft')) %>",
      sent: "<%= j(t('quotes.view.form.status_options.sent')) %>",
      viewed: "<%= j(t('quotes.view.form.status_options.viewed')) %>",
      negotiating: "<%= j(t('quotes.view.form.status_options.negotiating')) %>",
      won: "<%= j(t('quotes.view.form.status_options.won')) %>",
      lost: "<%= j(t('quotes.view.form.status_options.lost')) %>",
      expired: "<%= j(t('quotes.view.form.status_options.expired')) %>"
    };
    const statusBadgeClasses = {
      draft: "app-status-badge app-status-badge--blue",
      sent: "app-status-badge app-status-badge--blue",
      viewed: "app-status-badge app-status-badge--indigo",
      negotiating: "app-status-badge app-status-badge--amber",
      won: "app-status-badge app-status-badge--green",
      lost: "app-status-badge app-status-badge--red",
      expired: "app-status-badge app-status-badge--red"
    };

    const currencySymbols = {
      USD: "$",
      EUR: "€",
      GBP: "£",
      CNY: "¥",
      JPY: "¥",
      AUD: "A$",
      CAD: "C$",
      SGD: "S$",
      HKD: "HK$"
    };

    let rowCounter = body.querySelectorAll(".quote-item-row").length;
    let discountEnabled = !!(discountRow && !discountRow.hidden);

    function parseNumber(value) {
      const number = parseFloat(value || "0");
      return Number.isFinite(number) ? number : 0;
    }

    function parseInteger(value) {
      const number = parseInt(value || "0", 10);
      return Number.isFinite(number) ? number : 0;
    }

    function parseAddonTotal(text) {
      return String(text || "").split(/\r?\n/).reduce((sum, line) => {
        const parts = line.split(/[:=：]/, 2);
        if (parts.length < 2) return sum;
        const amount = parseNumber(parts[1]);
        return amount >= 0 ? sum + amount : sum;
      }, 0);
    }

    function currentCurrency() {
      return (currencyInput?.value || "USD").toUpperCase();
    }

    function refreshCurrencyCodeTags() {
      const code = currentCurrency();
      document.querySelectorAll(".js-currency-code").forEach((el) => {
        el.textContent = code;
      });
    }

    function formatMoney(amount, currencyCode) {
      const value = parseNumber(amount).toFixed(2);
      const code = (currencyCode || "USD").toUpperCase();
      const symbol = currencySymbols[code] || code;
      if (symbol === code) return `${code} ${value}`;
      return `${symbol}${value}`;
    }

    function decodeRichText(text) {
      const el = document.createElement("textarea");
      el.innerHTML = String(text || "");
      return el.value;
    }

    function escapeHtml(text) {
      return String(text || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function normalizeSpecificationText(text) {
      return decodeRichText(text)
        .replace(/&#10;|&#x0a;|&#13;|&#x0d;/gi, "\n")
        .replace(/\r\n?/g, "\n")
        .trim();
    }

    function refreshCurrencyMismatchWarning() {
      if (!mismatchWarning) return;
      const quoteCurrency = currentCurrency();
      let hasMismatch = false;

      body.querySelectorAll(".quote-item-row").forEach((row) => {
        if (hasMismatch) return;
        const destroyField = row.querySelector(".js-destroy-flag");
        if (destroyField && destroyField.value === "1") return;
        if (row.style.display === "none") return;

        const productId = row.querySelector(".js-product-id")?.value;
        if (!productId) return;
        const selected = products.find((p) => String(p.id) === String(productId));
        if (!selected) return;

        const productCurrency = (selected.currency || "").trim().toUpperCase();
        if (quoteCurrency && productCurrency && quoteCurrency !== productCurrency) {
          hasMismatch = true;
        }
      });

      mismatchWarning.hidden = !hasMismatch;
    }

    function calculateTotals() {
      let baseSubtotal = 0;
      let addonTotal = 0;

      body.querySelectorAll(".quote-item-row").forEach((row) => {
        const destroyField = row.querySelector(".js-destroy-flag");
        if (destroyField && destroyField.value === "1") return;
        if (row.style.display === "none") return;

        const unitPrice = parseNumber(row.querySelector(".js-unit-price")?.value);
        const qty = Math.max(parseInteger(row.querySelector(".js-quantity")?.value), 0);
        const lineBase = unitPrice * qty;
        const lineAddon = parseAddonTotal(row.querySelector(".js-addon-charges")?.value);
        baseSubtotal += lineBase;
        addonTotal += lineAddon;
      });

      const subtotal = baseSubtotal + addonTotal;
      const tax = parseNumber(taxInput?.value);
      const shipping = parseNumber(shippingInput?.value);
      const discount = parseNumber(discountInput?.value);
      const originalTotal = subtotal + tax + shipping;
      const grandTotal = subtotal + tax + shipping - discount;
      const discountRate = subtotal > 0 ? ((discount / subtotal) * 100) : 0;

      return { subtotal, addonTotal, tax, shipping, discount, originalTotal, grandTotal, discountRate };
    }

    function toggleDiscountVisibility(enabled) {
      discountEnabled = !!enabled;
      if (discountRow) discountRow.hidden = !enabled;
      if (addDiscountBtn) addDiscountBtn.hidden = enabled;
      if (!enabled && discountInput) discountInput.value = "0";
    }

    function updateTotalsUI() {
      const totals = calculateTotals();
      const code = currentCurrency();
      refreshCurrencyCodeTags();
      liveSubtotal.textContent = formatMoney(totals.subtotal, code);
      liveAddons.textContent = formatMoney(totals.addonTotal, code);
      liveTax.textContent = formatMoney(totals.tax, code);
      liveShipping.textContent = formatMoney(totals.shipping, code);
      if (liveDiscount) liveDiscount.textContent = formatMoney(totals.discount, code);
      if (liveOriginalTotal) liveOriginalTotal.textContent = formatMoney(totals.originalTotal, code);
      liveGrand.textContent = formatMoney(totals.grandTotal, code);
      if (liveSaved) liveSaved.textContent = formatMoney(totals.discount, code);
      summaryGrand.textContent = formatMoney(totals.grandTotal, code);
      summaryDiscount.textContent = `${totals.discountRate.toFixed(2)}%`;
      const hasDiscount = totals.discount > 0;
      if (hasDiscount) discountEnabled = true;
      if (liveDiscountRow) liveDiscountRow.hidden = !hasDiscount;
      if (liveOriginalRow) liveOriginalRow.hidden = !hasDiscount;
      if (liveSavedRow) liveSavedRow.hidden = !hasDiscount;
      toggleDiscountVisibility(hasDiscount || discountEnabled);
      refreshCurrencyMismatchWarning();
      return totals;
    }

    function fieldLabel(field) {
      if (!field || !form) return "This field";
      const id = field.id;
      if (id) {
        const label = form.querySelector(`label[for='${CSS.escape(id)}']`);
        if (label) return label.textContent.replace(/\s+/g, " ").trim();
      }

      const section = field.closest("td, div");
      const fallbackLabel = section?.querySelector("label");
      return fallbackLabel?.textContent?.replace(/\s+/g, " ").trim() || field.getAttribute("aria-label") || field.name || "This field";
    }

    function clientValidationMessage(field) {
      if (!field) return "is invalid";
      if (field.validity.valueMissing) return "is required.";
      if (field.validity.typeMismatch) return "has an invalid format.";
      if (field.validity.patternMismatch) return "has an invalid format.";
      if (field.validity.rangeUnderflow) return `must be at least ${field.min}.`;
      if (field.validity.rangeOverflow) return `must be no more than ${field.max}.`;
      if (field.validity.stepMismatch) return "has an invalid value.";
      if (field.validity.badInput) return "has an invalid value.";
      return "is invalid.";
    }

    function fieldLabelElement(field) {
      if (!field || !form || !field.id) return null;
      return form.querySelector(`label[for='${CSS.escape(field.id)}']`);
    }

    function clearFieldHighlights() {
      if (!form) return;
      form.querySelectorAll(".quote-field-invalid").forEach((field) => field.classList.remove("quote-field-invalid"));
      form.querySelectorAll(".quote-field-label-invalid").forEach((label) => label.classList.remove("quote-field-label-invalid"));
    }

    function highlightInvalidFields(fields) {
      clearFieldHighlights();
      fields.forEach((field) => {
        if (!field) return;
        field.classList.add("quote-field-invalid");
        fieldLabelElement(field)?.classList.add("quote-field-label-invalid");
      });
    }

    function clearClientErrors() {
      clearFieldHighlights();
      if (!clientErrorBox || !clientErrorList) return;
      clientErrorBox.hidden = true;
      clientErrorList.innerHTML = "";
    }

    function showClientErrors(fields) {
      if (!clientErrorBox || !clientErrorList) return;

      const uniqueMessages = [];
      fields.forEach((field) => {
        if (!field) return;
        const label = fieldLabel(field);
        const message = clientValidationMessage(field);
        const text = `${label}: ${message}`;
        if (!uniqueMessages.includes(text)) uniqueMessages.push(text);
      });

      clientErrorList.innerHTML = uniqueMessages.map((text) => `<li>${escapeHtml(text)}</li>`).join("");
      clientErrorBox.hidden = uniqueMessages.length === 0;
      if (!clientErrorBox.hidden) {
        clientErrorBox.scrollIntoView({ behavior: "smooth", block: "center" });
      }
    }

    function createSpecRow(key = "", value = "") {
      const safeKey = escapeHtml(key);
      const safeValue = escapeHtml(value);
      return `
        <div class="quote-kv-row">
          <input type="text" class="js-kv-key" value="${safeKey}" placeholder="e.g. Power">
          <input type="text" class="js-kv-value" value="${safeValue}" placeholder="e.g. 5kW">
          <button type="button" class="quote-kv-remove js-kv-remove" aria-label="Remove specification">&times;</button>
        </div>
      `;
    }

    function createAddonRow(name = "", amount = "") {
      const safeName = escapeHtml(name);
      const safeAmount = escapeHtml(amount);
      return `
        <div class="quote-kv-row quote-kv-row-addon">
          <input type="text" class="js-addon-name" value="${safeName}" placeholder="e.g. Packaging">
          <input type="number" step="0.01" min="0" class="js-addon-amount" value="${safeAmount}" placeholder="0.00">
          <button type="button" class="quote-kv-remove js-kv-remove" aria-label="Remove add-on">&times;</button>
        </div>
      `;
    }

    function specsToText(specs) {
      return Array(specs).map((entry) => {
        const name = entry?.name || entry?.["name"];
        const value = entry?.value || entry?.["value"];
        if (!name || !value) return null;
        return `${name}: ${value}`;
      }).filter(Boolean).join("\n");
    }

    function addonsToText(addons) {
      return Array(addons).map((entry) => {
        const name = entry?.name || entry?.["name"];
        const price = entry?.price || entry?.["price"] || entry?.amount || entry?.["amount"];
        if (!name || price === undefined || price === null || price === "") return null;
        return `${name}: ${price}`;
      }).filter(Boolean).join("\n");
    }

    function parseSpecPairsFromText(text) {
      const rows = [];
      const invalidLines = [];
      String(text || "").split(/\r?\n/).forEach((rawLine, index) => {
        const line = rawLine.trim();
        if (!line) return;
        const separatorIndex = line.search(/[:=：]/);
        if (separatorIndex <= 0 || separatorIndex >= line.length - 1) {
          invalidLines.push(index + 1);
          return;
        }

        const key = line.slice(0, separatorIndex).trim();
        const value = line.slice(separatorIndex + 1).trim();
        if (!key || !value) {
          invalidLines.push(index + 1);
          return;
        }
        rows.push({ key, value });
      });

      return { rows, invalidLines };
    }

    function parseAddonRowsFromText(text) {
      const rows = [];
      const invalidLines = [];
      String(text || "").split(/\r?\n/).forEach((rawLine, index) => {
        const line = rawLine.trim();
        if (!line) return;
        const separatorIndex = line.search(/[:=：]/);
        if (separatorIndex <= 0 || separatorIndex >= line.length - 1) {
          invalidLines.push(index + 1);
          return;
        }

        const name = line.slice(0, separatorIndex).trim();
        const amountRaw = line.slice(separatorIndex + 1).trim();
        const amountText = amountRaw.replace(/,/g, "").replace(/[^\d.+-]/g, "");
        const amount = parseFloat(amountText);
        if (!name || !Number.isFinite(amount) || amount < 0) {
          invalidLines.push(index + 1);
          return;
        }
        rows.push({ name, amount: amount.toFixed(2) });
      });

      return { rows, invalidLines };
    }

    function updateExpirySummary() {
      if (!validUntilInput || !summaryExpiry) return;
      const value = validUntilInput.value;
      if (!value) {
        summaryExpiry.textContent = "No date";
        return;
      }

      const target = new Date(`${value}T00:00:00`);
      if (Number.isNaN(target.getTime())) {
        summaryExpiry.textContent = "Invalid date";
        return;
      }

      const today = new Date();
      const startOfToday = new Date(today.getFullYear(), today.getMonth(), today.getDate());
      const diffMs = target.getTime() - startOfToday.getTime();
      const daysLeft = Math.floor(diffMs / 86400000);

      if (daysLeft < 0) {
        summaryExpiry.textContent = "Expired";
      } else {
        summaryExpiry.textContent = `${daysLeft} day(s) left`;
      }
    }

    function applyStatusUI() {
      if (!statusInput) return;
      const status = (statusInput.value || "draft").toLowerCase();
      const label = statusLabels[status] || status;
      if (statusText) statusText.textContent = label;
      if (statusBadge) {
        const badgeClasses = statusBadgeClasses[status] || "app-status-badge app-status-badge--slate";
        statusBadge.innerHTML = `<span class="${badgeClasses}">${label}</span>`;
      }

      document.querySelectorAll("[data-show-when-status]").forEach((element) => {
        const expected = (element.dataset.showWhenStatus || "")
          .toLowerCase()
          .split(",")
          .map((value) => value.trim())
          .filter(Boolean);
        const visible = expected.includes(status);
        element.style.display = visible ? "block" : "none";
        element.querySelectorAll("input, select, textarea").forEach((field) => {
          field.disabled = !visible;
        });
      });

      if (finalAmountInput) finalAmountInput.required = status === "won" && !finalAmountInput.disabled;
      if (winReasonInput) winReasonInput.required = status === "won" && !winReasonInput.disabled;
      if (lossReasonInput) lossReasonInput.required = status === "lost" && !lossReasonInput.disabled;
      if (stalledReasonInput) stalledReasonInput.required = false;

      document.querySelectorAll("[data-reason-detail-for]").forEach((element) => {
        const kind = element.dataset.reasonDetailFor;
        const sourceInput =
          kind === "win" ? winReasonInput :
          kind === "loss" ? lossReasonInput :
          stalledReasonInput;
        const detailInput =
          kind === "win" ? winReasonDetailInput :
          kind === "loss" ? lossReasonDetailInput :
          stalledReasonDetailInput;

        const shouldShow = !sourceInput?.disabled && sourceInput?.value === "other";
        element.style.display = shouldShow ? "block" : "none";
        if (detailInput) {
          detailInput.disabled = !shouldShow;
          detailInput.required = shouldShow;
        }
      });

      if (status === "won" && finalAmountInput && !String(finalAmountInput.value || "").trim()) {
        const totals = calculateTotals();
        finalAmountInput.value = totals.grandTotal.toFixed(2);
      }
    }

    function findProductByName(name) {
      const normalized = (name || "").trim().toLowerCase();
      if (!normalized) return null;
      return products.find((p) => (p.name || "").trim().toLowerCase() === normalized) || null;
    }

    function productMatches(productName, keyword) {
      return (productName || "").toLowerCase().includes((keyword || "").toLowerCase());
    }

    function renderDropdown(dropdown, items) {
      if (!dropdown) return;
      if (!items.length) {
        dropdown.innerHTML = '<div class="product-option-empty">No matching product</div>';
        return;
      }

      dropdown.innerHTML = items.map((p) =>
        `<button type="button" class="js-product-option" role="option" aria-selected="false" data-id="${p.id}" data-name="${p.name}" data-price="${p.price}">${p.name}</button>`
      ).join("");
    }

    function openDropdown(row, dropdown) {
      if (!dropdown) return;
      body.querySelectorAll(".quote-item-row.is-dropdown-open").forEach((openRow) => {
        if (openRow !== row) {
          openRow.classList.remove("is-dropdown-open");
          const openDropdownEl = openRow.querySelector(".js-product-dropdown");
          if (openDropdownEl) openDropdownEl.classList.remove("is-open");
        }
      });

      row.classList.add("is-dropdown-open");
      dropdown.setAttribute("role", "listbox");
      dropdown.classList.add("is-open");
      positionDropdown(row, dropdown);
    }

    function closeDropdown(row, dropdown) {
      if (!dropdown) return;
      dropdown.classList.remove("is-open");
      dropdown.classList.remove("open-up");
      row.classList.remove("is-dropdown-open");
      dropdown.querySelectorAll(".js-product-option.is-active").forEach((el) => el.classList.remove("is-active"));
    }

    function positionDropdown(row, dropdown) {
      if (!dropdown) return;
      const searchBox = row.querySelector(".product-search");
      if (!searchBox) return;

      dropdown.classList.remove("open-up");
      dropdown.style.maxHeight = "";

      const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
      const boxRect = searchBox.getBoundingClientRect();
      const safeGap = 10;
      const minHeight = 140;
      const maxHeight = 260;

      const spaceBelow = viewportHeight - boxRect.bottom - safeGap;
      const spaceAbove = boxRect.top - safeGap;

      if (spaceBelow < 180 && spaceAbove > spaceBelow) {
        dropdown.classList.add("open-up");
        dropdown.style.maxHeight = `${Math.max(minHeight, Math.min(maxHeight, Math.floor(spaceAbove)))}px`;
      } else {
        dropdown.style.maxHeight = `${Math.max(minHeight, Math.min(maxHeight, Math.floor(spaceBelow)))}px`;
      }
    }

      function bindRow(row) {
        const productNameInput = row.querySelector(".js-product-name");
        const productDropdown = row.querySelector(".js-product-dropdown");
      const productFeedback = row.querySelector(".js-product-feedback");
      const productIdInput = row.querySelector(".js-product-id");
      const descInput = row.querySelector(".js-description");
      const priceInput = row.querySelector(".js-unit-price");
      const removeBtn = row.querySelector(".js-remove-item");
      const destroyField = row.querySelector(".js-destroy-flag");
      const qtyInput = row.querySelector(".js-quantity");
      const addonInput = row.querySelector(".js-addon-charges");
      const specsInput = row.querySelector(".js-specifications");
      const specPresetSelect = row.querySelector(".js-spec-preset-select");
      const addonPresetSelect = row.querySelector(".js-addon-preset-select");
      const specsEditor = row.querySelector(".js-spec-editor");
      const addonEditor = row.querySelector(".js-addon-editor");
      const specSummary = row.querySelector(".js-spec-summary");
      const addonSummary = row.querySelector(".js-addon-summary");
      const openSpecBtn = row.querySelector(".js-open-spec-editor");
      const openAddonBtn = row.querySelector(".js-open-addon-editor");
      const specBulkInput = row.querySelector(".js-spec-bulk-input");
      const specBulkCheck = row.querySelector(".js-spec-bulk-check");
      const addonBulkInput = row.querySelector(".js-addon-bulk-input");
      const addonBulkCheck = row.querySelector(".js-addon-bulk-check");
      let feedbackTimer = null;
      let activeOptionIndex = -1;

      function closeEditor(editor) {
        if (!editor) return;
        editor.classList.remove("is-open");
      }

      function openEditor(editor) {
        if (!editor) return;
        document.querySelectorAll(".quote-kv-editor.is-open").forEach((el) => {
          if (el !== editor) el.classList.remove("is-open");
        });
        editor.classList.add("is-open");
      }

      function renderSpecSummary() {
        if (!specSummary) return;
        const lines = String(specsInput?.value || "").split(/\r?\n/).map((line) => line.trim()).filter(Boolean);
        if (!lines.length) {
          specSummary.innerHTML = '<span class="quote-kv-summary-empty">No specs</span>';
          return;
        }
        specSummary.innerHTML = lines.map((line) => `<span class="quote-kv-chip">${escapeHtml(line)}</span>`).join("");
      }

      function renderAddonSummary() {
        if (!addonSummary) return;
        const lines = String(addonInput?.value || "").split(/\r?\n/).map((line) => line.trim()).filter(Boolean);
        if (!lines.length) {
          addonSummary.innerHTML = '<span class="quote-kv-summary-empty">No add-ons</span>';
          return;
        }
        addonSummary.innerHTML = lines.map((line) => `<span class="quote-kv-chip">${escapeHtml(line)}</span>`).join("");
      }

      function setFeedback(type, text, autoclear = false) {
        if (!productFeedback) return;
        if (feedbackTimer) {
          window.clearTimeout(feedbackTimer);
          feedbackTimer = null;
        }
        productFeedback.className = "js-product-feedback product-feedback";
        if (type) productFeedback.classList.add(`product-feedback-${type}`);
        productFeedback.textContent = text || "";

        if (autoclear && text) {
          feedbackTimer = window.setTimeout(() => {
            productFeedback.className = "js-product-feedback product-feedback";
            productFeedback.textContent = "";
          }, 1200);
        }
      }

      function optionButtons() {
        return Array.from(productDropdown?.querySelectorAll(".js-product-option") || []);
      }

      function setActiveOption(index) {
        const options = optionButtons();
        if (!options.length) {
          activeOptionIndex = -1;
          return;
        }

        if (index < 0) index = options.length - 1;
        if (index >= options.length) index = 0;
        activeOptionIndex = index;

        options.forEach((option, idx) => {
          option.classList.toggle("is-active", idx === activeOptionIndex);
          option.setAttribute("aria-selected", idx === activeOptionIndex ? "true" : "false");
          option.classList.remove("is-hovered");
        });

        const active = options[activeOptionIndex];
        if (active) {
          active.scrollIntoView({ block: "nearest" });
        }
      }

      function clearSpecEditor() {
        if (!specsEditor || !specsInput) return;
        const rowsWrap = specsEditor.querySelector(".js-kv-rows");
        if (!rowsWrap) return;
        rowsWrap.innerHTML = createSpecRow();
        syncSpecsText();
      }

      function clearAddonEditor() {
        if (!addonEditor || !addonInput) return;
        const rowsWrap = addonEditor.querySelector(".js-kv-rows");
        if (!rowsWrap) return;
        rowsWrap.innerHTML = createAddonRow();
        syncAddonText();
        updateTotalsUI();
      }

      function fillSelect(select, presets, defaultId, customLabel) {
        if (!select) return;
        const selectedBefore = select.value;
        const options = [`<option value="">${customLabel}</option>`].concat(
          (presets || []).map((preset) => `<option value="${escapeHtml(String(preset.id))}">${escapeHtml(preset.name)}</option>`)
        );
        select.innerHTML = options.join("");
        select.dataset.defaultId = defaultId ? String(defaultId) : "";

        const fallbackPresetId = defaultId ? String(defaultId) : ((presets || [])[0] ? String(presets[0].id) : "");
        const nextValue = selectedBefore && (presets || []).some((preset) => String(preset.id) === String(selectedBefore)) ? selectedBefore : fallbackPresetId;
        select.value = nextValue;
      }

      function specPresetById(selected, presetId) {
        return (selected?.spec_presets || []).find((preset) => String(preset.id) === String(presetId));
      }

      function addonPresetById(selected, presetId) {
        return (selected?.addon_presets || []).find((preset) => String(preset.id) === String(presetId));
      }

      function applySpecPreset(selected, presetId, previousProductId) {
        const preset = specPresetById(selected, presetId);
        if (specsInput) {
          if (preset?.entries?.length) {
            specsInput.value = normalizeSpecificationText(specsToText(preset.entries));
            setSpecEditorFromText(specsInput.value);
          } else if (previousProductId !== String(selected.id)) {
            clearSpecEditor();
          }
        }
      }

      function applyAddonPreset(selected, presetId, previousProductId) {
        const preset = addonPresetById(selected, presetId);
        if (addonInput) {
          if (preset?.entries?.length) {
            addonInput.value = addonsToText(preset.entries);
            if (addonBulkInput) {
              addonBulkInput.value = addonInput.value;
              renderAddonBulkCheck();
            }
            const parsedAddons = parseAddonRowsFromText(addonInput.value);
            const rowsWrap = addonEditor?.querySelector(".js-kv-rows");
            if (rowsWrap && parsedAddons.rows.length) {
              rowsWrap.innerHTML = parsedAddons.rows.map((entry) => createAddonRow(entry.name, entry.amount)).join("");
              refreshCurrencyCodeTags();
              syncAddonText();
            }
          } else if (previousProductId !== String(selected.id)) {
            clearAddonEditor();
          }
        }
      }

      function applyProductSelection(selected) {
        if (!selected) return;
        const previousProductId = String(productIdInput.value || "");
        productIdInput.value = selected.id;
        const quoteCurrency = currentCurrency();
        const productCurrency = (selected.currency || "").trim().toUpperCase();
        const isCurrencyMismatch = quoteCurrency && productCurrency && quoteCurrency !== productCurrency;

        if (!priceInput.value && !isCurrencyMismatch) {
          priceInput.value = selected.price;
        }
        if (!descInput.value) descInput.value = selected.name;

        fillSelect(specPresetSelect, selected.spec_presets || [], selected.default_spec_preset_id, "Custom specs");
        fillSelect(addonPresetSelect, selected.addon_presets || [], selected.default_addon_preset_id, "Custom add-ons");
        applySpecPreset(selected, specPresetSelect?.value || selected.default_spec_preset_id || selected.spec_presets?.[0]?.id || "", previousProductId);
        applyAddonPreset(selected, addonPresetSelect?.value || selected.default_addon_preset_id || selected.addon_presets?.[0]?.id || "", previousProductId);

        productNameInput.classList.add("is-matched");
        if (isCurrencyMismatch) {
          setFeedback("warning", `Reference price is in ${productCurrency}. Quote currency is ${quoteCurrency}. Enter quote price manually.`);
        } else {
          setFeedback("", "");
        }
      }

      function syncProduct() {
        const keyword = (productNameInput.value || "").trim();
        const matched = findProductByName(keyword);
        const filtered = keyword ? products.filter((p) => productMatches(p.name, keyword)).slice(0, 8) : products.slice(0, 12);
        renderDropdown(productDropdown, filtered);
        openDropdown(row, productDropdown);
        setActiveOption(0);

        if (matched) {
          applyProductSelection(matched);
        } else {
          productIdInput.value = "";
          productNameInput.classList.remove("is-matched");
          if (!descInput.value && productNameInput.value.trim()) {
            descInput.value = productNameInput.value.trim();
          }
          if (keyword) {
            setFeedback("muted", "No exact match. This will be saved as a custom item.");
          } else {
            setFeedback("", "");
          }
        }
        updateTotalsUI();
      }

      if (productNameInput) {
        productNameInput.addEventListener("input", syncProduct);
        productNameInput.addEventListener("change", syncProduct);
        productNameInput.addEventListener("focus", syncProduct);
        productNameInput.addEventListener("keydown", (event) => {
          const options = optionButtons();
          const dropdownOpen = productDropdown?.classList.contains("is-open");

          if (event.key === "ArrowDown") {
            event.preventDefault();
            if (!dropdownOpen) {
              renderDropdown(productDropdown, products.slice(0, 12));
              openDropdown(row, productDropdown);
            }
            setActiveOption(activeOptionIndex + 1);
            return;
          }

          if (event.key === "ArrowUp") {
            event.preventDefault();
            if (!dropdownOpen) {
              renderDropdown(productDropdown, products.slice(0, 12));
              openDropdown(row, productDropdown);
            }
            setActiveOption(activeOptionIndex - 1);
            return;
          }

          if (event.key === "Enter" && dropdownOpen && options.length) {
            event.preventDefault();
            const target = options[activeOptionIndex] || options[0];
            if (!target) return;
            const selected = products.find((p) => String(p.id) === String(target.dataset.id));
            if (!selected) return;

            productNameInput.value = selected.name;
            applyProductSelection(selected);
            closeDropdown(row, productDropdown);
            updateTotalsUI();
            return;
          }

          if (event.key === "Escape" && dropdownOpen) {
            event.preventDefault();
            closeDropdown(row, productDropdown);
          }
        });
      }

      if (priceInput) {
        priceInput.addEventListener("input", updateTotalsUI);
      }
      if (qtyInput) {
        qtyInput.addEventListener("input", updateTotalsUI);
      }
      if (specPresetSelect) {
        specPresetSelect.addEventListener("change", () => {
          const selectedProduct = products.find((p) => String(p.id) === String(productIdInput.value));
          if (!selectedProduct) return;
          applySpecPreset(selectedProduct, specPresetSelect.value, String(selectedProduct.id));
        });
      }
      if (addonPresetSelect) {
        addonPresetSelect.addEventListener("change", () => {
          const selectedProduct = products.find((p) => String(p.id) === String(productIdInput.value));
          if (!selectedProduct) return;
          applyAddonPreset(selectedProduct, addonPresetSelect.value, String(selectedProduct.id));
          updateTotalsUI();
        });
      }
      function syncSpecsText() {
        if (!specsInput || !specsEditor) return;
        const lines = [];
        specsEditor.querySelectorAll(".quote-kv-row").forEach((kvRow) => {
          const key = (kvRow.querySelector(".js-kv-key")?.value || "").trim();
          const value = (kvRow.querySelector(".js-kv-value")?.value || "").trim();
          if (!key && !value) return;
          if (key && value) lines.push(`${key}: ${value}`);
        });
        specsInput.value = lines.join("\n");
        renderSpecSummary();
      }

      function setSpecEditorFromText(text) {
        if (!specsEditor) return;
        const rowsWrap = specsEditor.querySelector(".js-kv-rows");
        if (!rowsWrap) return;

        const parsedRows = String(text || "")
          .split(/\r?\n/)
          .map((line) => line.trim())
          .filter(Boolean)
          .map((line) => {
            const parts = line.split(/[:=：]/, 2);
            return {
              key: (parts[0] || "").trim(),
              value: (parts[1] || "").trim()
            };
          })
          .filter((pair) => pair.key && pair.value);

        if (!parsedRows.length) return;
        rowsWrap.innerHTML = parsedRows.map((pair) => createSpecRow(pair.key, pair.value)).join("");
        syncSpecsText();
      }

      function renderSpecBulkCheck() {
        if (!specBulkCheck || !specBulkInput) return;
        const text = String(specBulkInput.value || "").trim();
        if (!text) {
          specBulkCheck.textContent = "";
          specBulkCheck.classList.remove("is-error");
          specBulkCheck.classList.remove("is-ok");
          return;
        }

        const result = parseSpecPairsFromText(text);
        if (result.invalidLines.length) {
          specBulkCheck.textContent = `Invalid format at line ${result.invalidLines.join(", ")}. Use key: value`;
          specBulkCheck.classList.add("is-error");
          specBulkCheck.classList.remove("is-ok");
          return;
        }

        specBulkCheck.textContent = `${result.rows.length} row(s) ready`;
        specBulkCheck.classList.remove("is-error");
        specBulkCheck.classList.add("is-ok");
      }

      function renderAddonBulkCheck() {
        if (!addonBulkCheck || !addonBulkInput) return;
        const text = String(addonBulkInput.value || "").trim();
        if (!text) {
          addonBulkCheck.textContent = "";
          addonBulkCheck.classList.remove("is-error");
          addonBulkCheck.classList.remove("is-ok");
          return;
        }

        const result = parseAddonRowsFromText(text);
        if (result.invalidLines.length) {
          addonBulkCheck.textContent = `Invalid format at line ${result.invalidLines.join(", ")}. Use name: amount`;
          addonBulkCheck.classList.add("is-error");
          addonBulkCheck.classList.remove("is-ok");
          return;
        }

        addonBulkCheck.textContent = `${result.rows.length} row(s) ready`;
        addonBulkCheck.classList.remove("is-error");
        addonBulkCheck.classList.add("is-ok");
      }

      function syncAddonText() {
        if (!addonInput || !addonEditor) return;
        const lines = [];
        addonEditor.querySelectorAll(".quote-kv-row-addon").forEach((kvRow) => {
          const name = (kvRow.querySelector(".js-addon-name")?.value || "").trim();
          const amount = parseNumber(kvRow.querySelector(".js-addon-amount")?.value);
          if (!name) return;
          if (amount < 0) return;
          lines.push(`${name}: ${amount.toFixed(2)}`);
        });
        addonInput.value = lines.join("\n");
        renderAddonSummary();
      }

      function ensureEditorRow(editor, kind) {
        if (!editor) return;
        const rows = editor.querySelectorAll(".quote-kv-row");
        if (rows.length) return;
        const rowsWrap = editor.querySelector(".js-kv-rows");
        if (!rowsWrap) return;
        rowsWrap.insertAdjacentHTML("beforeend", kind === "addon" ? createAddonRow() : createSpecRow());
        refreshCurrencyCodeTags();
      }

      if (specsEditor) {
        if (specBulkInput) {
          specBulkInput.addEventListener("input", renderSpecBulkCheck);
        }

        specsEditor.addEventListener("click", (event) => {
          const addBtn = event.target.closest(".js-kv-add");
          const removeBtn = event.target.closest(".js-kv-remove");
          const clearAllBtn = event.target.closest(".js-kv-clear-all");
          const bulkApplyBtn = event.target.closest(".js-spec-bulk-apply");
          const rowsWrap = specsEditor.querySelector(".js-kv-rows");
          if (!rowsWrap) return;

          if (bulkApplyBtn) {
            if (!specBulkInput) return;
            const result = parseSpecPairsFromText(specBulkInput.value);
            renderSpecBulkCheck();
            if (result.invalidLines.length || !result.rows.length) return;
            rowsWrap.innerHTML = result.rows.map((pair) => createSpecRow(pair.key, pair.value)).join("");
            syncSpecsText();
            return;
          }

          if (clearAllBtn) {
            rowsWrap.innerHTML = createSpecRow();
            if (specBulkInput) {
              specBulkInput.value = "";
              renderSpecBulkCheck();
            }
            syncSpecsText();
            return;
          }

          if (addBtn) {
            rowsWrap.insertAdjacentHTML("beforeend", createSpecRow());
            rowsWrap.scrollTop = rowsWrap.scrollHeight;
            syncSpecsText();
            return;
          }

          if (removeBtn) {
            const targetRow = removeBtn.closest(".quote-kv-row");
            if (targetRow) targetRow.remove();
            ensureEditorRow(specsEditor, "spec");
            syncSpecsText();
          }
        });

        specsEditor.addEventListener("input", () => {
          syncSpecsText();
        });

        specsEditor.addEventListener("keydown", (event) => {
          if (event.key !== "Escape") return;
          event.preventDefault();
          closeEditor(specsEditor);
        });
      }

      if (addonEditor) {
        if (addonBulkInput) {
          addonBulkInput.addEventListener("input", renderAddonBulkCheck);
        }

        addonEditor.addEventListener("click", (event) => {
          const addBtn = event.target.closest(".js-kv-add");
          const removeBtn = event.target.closest(".js-kv-remove");
          const clearAllBtn = event.target.closest(".js-kv-clear-all");
          const bulkApplyBtn = event.target.closest(".js-addon-bulk-apply");
          const rowsWrap = addonEditor.querySelector(".js-kv-rows");
          if (!rowsWrap) return;

          if (bulkApplyBtn) {
            if (!addonBulkInput) return;
            const result = parseAddonRowsFromText(addonBulkInput.value);
            renderAddonBulkCheck();
            if (result.invalidLines.length || !result.rows.length) return;
            rowsWrap.innerHTML = result.rows.map((entry) => createAddonRow(entry.name, entry.amount)).join("");
            refreshCurrencyCodeTags();
            syncAddonText();
            updateTotalsUI();
            return;
          }

          if (clearAllBtn) {
            rowsWrap.innerHTML = createAddonRow();
            if (addonBulkInput) {
              addonBulkInput.value = "";
              renderAddonBulkCheck();
            }
            refreshCurrencyCodeTags();
            syncAddonText();
            updateTotalsUI();
            return;
          }

          if (addBtn) {
            rowsWrap.insertAdjacentHTML("beforeend", createAddonRow());
            rowsWrap.scrollTop = rowsWrap.scrollHeight;
            refreshCurrencyCodeTags();
            syncAddonText();
            updateTotalsUI();
            return;
          }

          if (removeBtn) {
            const targetRow = removeBtn.closest(".quote-kv-row");
            if (targetRow) targetRow.remove();
            ensureEditorRow(addonEditor, "addon");
            refreshCurrencyCodeTags();
            syncAddonText();
            updateTotalsUI();
          }
        });

        addonEditor.addEventListener("input", () => {
          syncAddonText();
          updateTotalsUI();
        });

        addonEditor.addEventListener("keydown", (event) => {
          if (event.key !== "Escape") return;
          event.preventDefault();
          closeEditor(addonEditor);
        });
      }

      if (addonInput) {
        syncAddonText();
      }

      if (specsInput) {
        syncSpecsText();
      }

      row.querySelectorAll(".js-kv-close").forEach((btn) => {
        btn.addEventListener("click", (event) => {
          closeEditor(event.target.closest(".quote-kv-editor"));
        });
      });

      if (openSpecBtn) {
        openSpecBtn.addEventListener("click", () => {
          if (specBulkInput) {
            specBulkInput.value = specsInput?.value || "";
            renderSpecBulkCheck();
          }
          openEditor(specsEditor);
        });
      }

      if (openAddonBtn) {
        openAddonBtn.addEventListener("click", () => {
          if (addonBulkInput) {
            addonBulkInput.value = addonInput?.value || "";
            renderAddonBulkCheck();
          }
          openEditor(addonEditor);
        });
      }

      if (productDropdown && productNameInput) {
        productDropdown.addEventListener("mousedown", (event) => {
          if (event.target.closest(".js-product-option")) {
            event.preventDefault();
            productNameInput.focus();
          }
        });

        productDropdown.addEventListener("keydown", (event) => {
          const options = optionButtons();
          const dropdownOpen = productDropdown.classList.contains("is-open");
          if (!dropdownOpen || !options.length) return;

          if (event.key === "ArrowDown") {
            event.preventDefault();
            setActiveOption(activeOptionIndex + 1);
            return;
          }

          if (event.key === "ArrowUp") {
            event.preventDefault();
            setActiveOption(activeOptionIndex - 1);
            return;
          }

          if (event.key === "Enter") {
            event.preventDefault();
            const target = options[activeOptionIndex] || options[0];
            if (!target) return;
            target.click();
            return;
          }

          if (event.key === "Escape") {
            event.preventDefault();
            closeDropdown(row, productDropdown);
            productNameInput.focus();
          }
        });

        productDropdown.addEventListener("click", (event) => {
          const target = event.target.closest(".js-product-option");
          if (!target) return;

          productNameInput.value = target.dataset.name;
          const selected = products.find((p) => String(p.id) === String(target.dataset.id));
          applyProductSelection(selected);
          closeDropdown(row, productDropdown);
          productNameInput.focus();
          updateTotalsUI();
        });

        document.addEventListener("click", (event) => {
          const clickPath = typeof event.composedPath === "function" ? event.composedPath() : [];
          const clickedInsideRow = clickPath.includes(row) || row.contains(event.target);
          if (!clickedInsideRow) {
            closeDropdown(row, productDropdown);
            closeEditor(specsEditor);
            closeEditor(addonEditor);
          }
        });

        window.addEventListener("resize", () => {
          if (productDropdown.classList.contains("is-open")) {
            positionDropdown(row, productDropdown);
          }
        });

        window.addEventListener("scroll", () => {
          if (productDropdown.classList.contains("is-open")) {
            positionDropdown(row, productDropdown);
          }
        }, true);
      }

      if (removeBtn) {
        removeBtn.addEventListener("click", () => {
          if (destroyField) destroyField.value = "1";
          row.style.display = "none";
          updateTotalsUI();
          applyStatusUI();
        });
      }
    }

    function addRow() {
      const index = rowCounter++;
      const tr = document.createElement("tr");
      tr.className = "quote-item-row is-new";
      tr.innerHTML = `
        <td class="quote-col-product">
          <div class="product-search">
            <input type="text" class="js-product-name" placeholder="Type to search product">
            <div class="js-product-dropdown"></div>
          </div>
          <div class="js-product-feedback product-feedback" aria-live="polite"></div>
          <input type="hidden" name="quote[quote_items_attributes][${index}][product_id]" class="js-product-id">
          <input type="hidden" name="quote[quote_items_attributes][${index}][description]" class="js-description">
        </td>
        <td class="quote-col-specs">
          <select class="js-spec-preset-select quote-inline-select" data-default-id="">
            <option value="">Custom specs</option>
          </select>
          <textarea rows="2" class="js-specifications sr-only-input" name="quote[quote_items_attributes][${index}][specifications_text]" placeholder="Power: 5kW&#10;Voltage: 220V"></textarea>
          <div class="quote-kv-summary js-spec-summary"></div>
          <button type="button" class="quote-kv-open js-open-spec-editor">Edit specs</button>
          <div class="quote-kv-editor js-spec-editor" data-kind="spec">
            <div class="quote-kv-editor-head">
              <strong>Specifications</strong>
              <button type="button" class="quote-kv-close js-kv-close">Close</button>
            </div>
            <div class="quote-kv-bulk">
              <textarea class="quote-kv-bulk-input js-spec-bulk-input" rows="3" placeholder="One line per item, e.g.&#10;Power: 5kW&#10;Voltage: 220V"></textarea>
              <div class="quote-kv-bulk-actions">
                <button type="button" class="quote-kv-parse js-spec-bulk-apply">Apply text</button>
                <span class="quote-kv-bulk-check js-spec-bulk-check" aria-live="polite"></span>
              </div>
            </div>
            <div class="quote-kv-rows js-kv-rows">
              ${createSpecRow()}
            </div>
            <div class="quote-kv-actions">
              <button type="button" class="quote-kv-add js-kv-add">+ Spec</button>
              <button type="button" class="quote-kv-clear js-kv-clear-all">Clear all</button>
            </div>
          </div>
        </td>
        <td class="quote-col-addons">
          <select class="js-addon-preset-select quote-inline-select" data-default-id="">
            <option value="">Custom add-ons</option>
          </select>
          <textarea rows="2" class="js-addon-charges sr-only-input" name="quote[quote_items_attributes][${index}][addon_charges_text]" placeholder="Packaging: 30&#10;Installation: 120"></textarea>
          <div class="quote-kv-summary js-addon-summary"></div>
          <button type="button" class="quote-kv-open js-open-addon-editor">Edit add-ons</button>
          <div class="quote-kv-editor js-addon-editor" data-kind="addon">
            <div class="quote-kv-editor-head">
              <strong>Add-ons</strong>
              <button type="button" class="quote-kv-close js-kv-close">Close</button>
            </div>
            <div class="quote-kv-bulk">
              <textarea class="quote-kv-bulk-input js-addon-bulk-input" rows="3" placeholder="One line per item, e.g.&#10;Packaging: 30&#10;Installation = 120"></textarea>
              <div class="quote-kv-bulk-actions">
                <button type="button" class="quote-kv-parse js-addon-bulk-apply">Apply text</button>
                <span class="quote-kv-bulk-check js-addon-bulk-check" aria-live="polite"></span>
              </div>
            </div>
            <div class="quote-kv-rows js-kv-rows">
              ${createAddonRow()}
            </div>
            <div class="quote-kv-actions">
              <button type="button" class="quote-kv-add js-kv-add">+ Add-on</button>
              <button type="button" class="quote-kv-clear js-kv-clear-all">Clear all</button>
            </div>
          </div>
        </td>
        <td class="quote-col-price">
          <input type="number" step="0.01" name="quote[quote_items_attributes][${index}][unit_price]" class="js-unit-price" placeholder="0.00">
        </td>
        <td class="quote-col-qty">
          <input type="number" min="1" value="1" name="quote[quote_items_attributes][${index}][quantity]" class="js-quantity">
        </td>
        <td class="quote-col-remove">
          <input type="hidden" name="quote[quote_items_attributes][${index}][_destroy]" value="0" class="js-destroy-flag">
          <button type="button" class="quote-item-remove-icon js-remove-item" aria-label="Remove item">&times;</button>
        </td>
      `;

      body.appendChild(tr);
      bindRow(tr);
      updateTotalsUI();
      window.setTimeout(() => tr.classList.remove("is-new"), 420);
    }

    body.querySelectorAll(".quote-item-row").forEach(bindRow);
    if (addBtn) addBtn.addEventListener("click", addRow);

    [taxInput, shippingInput, discountInput, currencyInput].forEach((input) => {
      if (!input) return;
      input.addEventListener("input", updateTotalsUI);
      input.addEventListener("change", updateTotalsUI);
    });

    if (addDiscountBtn) {
      addDiscountBtn.addEventListener("click", () => {
        toggleDiscountVisibility(true);
        if (discountInput && parseNumber(discountInput.value) <= 0) discountInput.value = "0.00";
        if (discountInput) discountInput.focus();
        updateTotalsUI();
      });
    }

    if (removeDiscountBtn) {
      removeDiscountBtn.addEventListener("click", () => {
        toggleDiscountVisibility(false);
        updateTotalsUI();
      });
    }

    if (statusInput) {
      statusInput.addEventListener("change", () => {
        applyStatusUI();
        updateTotalsUI();
      });
    }

    [winReasonInput, lossReasonInput, stalledReasonInput].forEach((input) => {
      if (!input) return;
      input.addEventListener("change", applyStatusUI);
    });

    if (validUntilInput) {
      validUntilInput.addEventListener("change", updateExpirySummary);
    }

    updateTotalsUI();
    updateExpirySummary();
    applyStatusUI();

    if (form && submitButton) {
      form.querySelectorAll("input, select, textarea").forEach((field) => {
        field.addEventListener("input", clearClientErrors);
        field.addEventListener("change", clearClientErrors);
      });

      form.addEventListener("submit", (event) => {
        const invalidFields = Array.from(form.querySelectorAll(":invalid")).filter((field) => !field.disabled && field.offsetParent !== null);
        if (invalidFields.length > 0) {
          event.preventDefault();
          highlightInvalidFields(invalidFields);
          showClientErrors(invalidFields);
          window.showAppToast?.("Please complete the required fields.", "error");
          const firstInvalid = invalidFields[0];
          if (firstInvalid && typeof firstInvalid.focus === "function") {
            firstInvalid.focus({ preventScroll: true });
          }
          return;
        }

        if (submitButton.dataset.submitting === "true") {
          event.preventDefault();
          return;
        }

        submitButton.dataset.submitting = "true";
        submitButton.disabled = true;
        if (submitButton.tagName === "INPUT") {
          submitButton.dataset.originalValue = submitButton.value;
          submitButton.value = "<%= j submit_loading_label %>";
        } else {
          submitButton.dataset.originalValue = submitButton.textContent;
          submitButton.textContent = "<%= j submit_loading_label %>";
        }
      });
    }

    if (root.dataset.hasErrors === "true") {
      const errorTarget = document.querySelector(".quote-form-inline-error, .error-messages");
      if (errorTarget) {
        setTimeout(() => {
          errorTarget.scrollIntoView({ behavior: "smooth", block: "center" });
        }, 120);
      }
    }
  })();
</script>
