<% content_for :title, "Rubusoo | Manage Quote Versions. Share with Buyers." %>

<section class="marketing-hero">
  <div class="marketing-hero-bg"></div>
  <div class="marketing-hero-content">
    <p class="marketing-kicker">BUILT FOR B2B SALES AND EXPORT TEAMS</p>
    <h1>Manage Quote Versions. Buyers See Live Updates.</h1>
    <p class="marketing-subtitle">
      Every revision saved. Buyers see the latest. No confusion.
    </p>
    <div class="marketing-cta-row">
      <%= link_to "Start for Free", new_user_registration_path, class: "btn btn-primary marketing-cta-primary" %>
      <%= link_to "View Demo", @demo_path, class: "btn btn-secondary marketing-cta-secondary" %>
      <%= link_to "See Live Example", @sample_quote_path, class: "marketing-sample-link", target: "_blank" %>
    </div>
  </div>
</section>

<section class="marketing-section">
  <div class="marketing-section-head">
    <h2>What You Can Do</h2>
    <p>Core workflows for small teams and foreign trade operations.</p>
  </div>
  <div class="marketing-grid marketing-grid-4">
    <article class="marketing-feature">
      <div class="marketing-icon">V</div>
      <h3>Manage Revisions</h3>
      <p>Every revision tracked. History never lost. Price changes stay visible.</p>
    </article>
    <article class="marketing-feature">
      <div class="marketing-icon">L</div>
      <h3>Share Public Link</h3>
      <p>Buyers see live quotes from any device. No login. No friction.</p>
    </article>
    <article class="marketing-feature">
      <div class="marketing-icon">Q</div>
      <h3>Build Quotes Fast</h3>
      <p>Compose from templates. Customize quickly. Send with confidence.</p>
    </article>
    <article class="marketing-feature">
      <div class="marketing-icon">E</div>
      <h3>Export to PDF/XLSX</h3>
      <p>Export to PDF or Excel. Buyer-ready and accounting-approved.</p>
    </article>
  </div>
</section>

<section class="marketing-section marketing-soft">
  <div class="marketing-section-head">
    <h2>Why Rubusoo</h2>
    <p>A practical quoting stack without enterprise overhead.</p>
  </div>
  <div class="marketing-grid marketing-grid-4">
    <article class="marketing-advantage">
      <h3>Built for Small Teams</h3>
      <p>No unnecessary features. Clear workflows. Built for your sales rhythm.</p>
    </article>
    <article class="marketing-advantage">
      <h3>Better Follow-ups</h3>
      <p>Know where every deal stands. Quote history in context. Next steps visible.</p>
    </article>
    <article class="marketing-advantage">
      <h3>Professional Output</h3>
      <p>Every quote reflects your brand. Buyer-ready. Finance-clear.</p>
    </article>
    <article class="marketing-advantage">
      <h3>Template Driven</h3>
      <p>Your design language. Reused across quotes. Safe, no messy customization.</p>
    </article>
  </div>
</section>

<section class="marketing-section">
  <div class="marketing-section-head">
    <h2>How It Works</h2>
  </div>
  <div class="marketing-steps">
    <article class="marketing-step">
      <span>1</span>
      <h3>Add Your Data</h3>
      <p>Add your products and customers.</p>
    </article>
    <article class="marketing-step">
      <span>2</span>
      <h3>Create the Quote</h3>
      <p>Compose items, pricing, and terms. Use templates to move faster.</p>
    </article>
    <article class="marketing-step">
      <span>3</span>
      <h3>Share or Export</h3>
      <p>Send a live link to buyers. Or export to PDF for approvals.</p>
    </article>
    <article class="marketing-step">
      <span>4</span>
      <h3>Revise and Close</h3>
      <p>Revise anytime. Every version stays in history. Close faster.</p>
    </article>
  </div>
</section>

<section class="marketing-section marketing-faq">
  <div class="marketing-section-head">
    <h2>FAQ</h2>
  </div>
  <details>
    <summary>Can we use this with a small sales team?</summary>
    <p>Yes. Built for lean teams. Minimal setup. Fast workflows. Professional output from day one.</p>
  </details>
  <details>
    <summary>Do buyers need an account to view a quote link?</summary>
    <p>No. They click a link, view the quote in the browser, and print. No account needed.</p>
  </details>
  <details>
    <summary>Can we still export files for finance approval?</summary>
    <p>Yes. PDF and Excel exports keep your accounting and approval workflows intact.</p>
  </details>
  <details>
    <summary>What happens when we need to change pricing?</summary>
    <p>Revisions are instant. Every version stays in history. Buyers always see the latest. No confusion.</p>
  </details>
</section>

<% contact_email = @contact_email || ContactMailer.contact_email_for_environment %>
<section class="marketing-section marketing-contact" id="contact-us">
  <div class="marketing-section-head">
    <h2>Contact Us</h2>
    <p>Tell us your team size and current quoting workflow.</p>
    <p style="margin-top: 12px; font-size: 0.95em; color: #666;">Built for teams who need clear revision control and buyer visibility.</p>
  </div>

  <%= form_with model: (@contact_request || ContactRequest.new), url: contact_requests_path, local: true, class: "marketing-contact-form", id: "contact-form" do |f| %>
    <%= f.hidden_field :website, value: "", autocomplete: "off" %>
    <div class="marketing-contact-grid">
      <div>
        <%= f.label :name, "Name" %>
        <%= f.text_field :name, required: true %>
      </div>
      <div>
        <%= f.label :email, "Email" %>
        <%= f.email_field :email, required: true %>
      </div>
      <div>
        <%= f.label :company, "Company" %>
        <%= f.text_field :company, required: true %>
      </div>
      <div class="marketing-contact-message-wrap">
        <%= f.label :message, "Message" %>
        <%= f.text_area :message, rows: 5, required: true, placeholder: "Share your quote process, team setup, and rollout timeline." %>
      </div>
    </div>
    
    <% unless ENV["SKIP_TURNSTILE_VERIFICATION"] == "true" %>
      <!-- Cloudflare Turnstile - Hidden by default -->
      <div id="contact-turnstile-container" style="margin: 20px 0; display: none; text-align: center; padding: 20px; background: #f5f5f5; border-radius: 8px;">
        <p style="margin: 0 0 15px 0; color: #666; font-size: 14px;">Please verify you're human:</p>
        <div class="cf-turnstile"></div>
        <%= f.hidden_field :cf_turnstile_response, value: "", id: "cf_turnstile_response_contact" %>
      </div>
    <% end %>

    <div class="marketing-contact-actions">
      <%= f.submit "Send Message", class: "btn btn-primary", id: "contact-submit-btn" %>
      <span>or <%= mail_to contact_email, "email us directly", subject: "Rubusoo Inquiry" %></span>
    </div>
  <% end %>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const contactForm = document.getElementById('contact-form');
      const turnstileContainer = document.getElementById('contact-turnstile-container');
      const submitBtn = document.getElementById('contact-submit-btn');
      const turnstileResponse = document.getElementById('cf_turnstile_response_contact');
      let turnstileShown = false;

      if (contactForm && turnstileContainer && submitBtn) {
        submitBtn.addEventListener('click', function(e) {
          // If Turnstile not shown yet, show it and prevent submit
          if (!turnstileShown) {
            e.preventDefault();
            turnstileContainer.style.display = 'block';
            turnstileShown = true;
            
            // Scroll to verification
            turnstileContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
            
            // Re-render Turnstile if not already rendered
            setTimeout(() => {
              const widget = turnstileContainer.querySelector('.cf-turnstile');
              if (widget && !widget.dataset.rendered) {
                if (typeof turnstile !== 'undefined') {
                  turnstile.render(widget, {
                    sitekey: '<%= ENV.fetch("TURNSTILE_SITE_KEY", "0x4AAAAAACkKXqa756rWhUr7") %>',
                    theme: 'light',
                    callback: function(token) {
                      turnstileResponse.value = token;
                    }
                  });
                  widget.dataset.rendered = 'true';
                }
              }
            }, 100);
            return false;
          }
          
          // If Turnstile shown but not completed, prevent submit
          if (!turnstileResponse.value) {
            e.preventDefault();
            alert('Please complete the verification.');
            return false;
          }
          
          // Allow form submission
          return true;
        });
      }
    });
  </script>
</section>

<footer class="marketing-footer">
  <p>© <%= Time.current.year %> Rubusoo. All rights reserved.</p>
  <div class="marketing-footer-links">
    <a href="#">Privacy Policy</a>
