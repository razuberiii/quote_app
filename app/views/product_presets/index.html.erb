<section class="app-page-shell product-presets-page-shell">
  <header class="app-page-header">
    <div class="app-page-header-main">
      <h1><%= t("product_presets.view.index.title") %></h1>
      <p class="product-presets-page-subtitle"><%= t("product_presets.view.index.subtitle") %></p>
    </div>
  </header>

  <div class="product-presets-hub">
    <article class="product-presets-card" id="spec-presets">
      <div class="product-presets-card-head">
        <div>
          <h2><%= t("product_presets.view.index.spec_title") %></h2>
          <p><%= t("product_presets.view.index.spec_caption") %></p>
        </div>
        <div class="product-presets-card-actions">
          <%= link_to t("product_presets.view.index.manage_specs"), spec_presets_path, class: "btn btn-primary" %>
          <%= link_to t("product_presets.view.index.new_spec_preset"), spec_presets_path(anchor: "new"), class: "btn btn-secondary" %>
        </div>
      </div>

      <% if @spec_presets.any? %>
        <div class="product-presets-chip-list">
          <% @spec_presets.limit(8).each do |preset| %>
            <span class="product-presets-chip"><strong><%= preset.name %></strong><small><%= t("product_presets.view.index.spec_count", count: preset.normalized_entries.size) %></small></span>
          <% end %>
        </div>
      <% else %>
        <p class="team-members-hint"><%= t("product_presets.view.index.no_spec_presets") %></p>
      <% end %>
    </article>

    <article class="product-presets-card" id="addon-presets">
      <div class="product-presets-card-head">
        <div>
          <h2><%= t("product_presets.view.index.addon_title") %></h2>
          <p><%= t("product_presets.view.index.addon_caption") %></p>
        </div>
        <div class="product-presets-card-actions">
          <%= link_to t("product_presets.view.index.manage_addons"), addon_presets_path, class: "btn btn-primary" %>
          <%= link_to t("product_presets.view.index.new_addon_preset"), addon_presets_path(anchor: "new"), class: "btn btn-secondary" %>
        </div>
      </div>

      <% if @addon_presets.any? %>
        <div class="product-presets-chip-list">
          <% @addon_presets.limit(8).each do |preset| %>
            <span class="product-presets-chip"><strong><%= preset.name %></strong><small><%= t("product_presets.view.index.addon_count", count: preset.normalized_entries.size) %></small></span>
          <% end %>
        </div>
      <% else %>
        <p class="team-members-hint"><%= t("product_presets.view.index.no_addon_presets") %></p>
      <% end %>
    </article>
  </div>
</section>
