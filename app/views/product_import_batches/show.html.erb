<main class="deal-workspace catalog-import">
  <header class="deal-page-header"><div><p class="eyebrow">Catalog review</p><h1><%= pluralize(@candidates.size, "candidate") %> found</h1><p>Verify identity, evidence and price provenance before applying.</p></div><span class="status-signal"><%= @batch.status.humanize %></span></header>
  <% if @batch.warnings.any? %><section class="import-warnings"><strong>Needs attention</strong><ul><% @batch.warnings.each do |warning| %><li><%= warning %></li><% end %></ul></section><% end %>
  <% if @candidates.empty? %><section class="library-empty"><h2>No safe product rows were detected</h2><p>Your file is preserved. Retry with CSV or create deal-only items during Smart Intake.</p><%= link_to "Start a Deal", new_inquiry_path, class: "button button--primary" %></section>
  <% else %><%= form_with url: product_import_batch_path(@batch), method: :patch, class: "candidate-review" do %>
    <% @candidates.each do |candidate| data = candidate.candidate_data %><article class="candidate-row"><div class="candidate-identity"><span><%= data["sku"].presence || "No SKU" %></span><h2><%= data["name"] %></h2><p><%= data["description"].presence || "No description in source" %></p></div><dl><div><dt>Price</dt><dd><%= data["explicit_price"].present? ? "#{data["currency"] || "—"} #{data["explicit_price"]}" : "Price required" %></dd></div><div><dt>Evidence</dt><dd><%= candidate.evidence.first&.values_at("source", "location")&.compact&.join(" · ") %></dd></div><div><dt>Confidence</dt><dd><%= number_to_percentage(candidate.confidence.to_f * 100, precision: 0) %></dd></div></dl><div class="candidate-decision"><%= select_tag "candidates[#{candidate.id}][decision]", options_for_select(ProductImportCandidate::DECISIONS.map { |value| [value.humanize, value] }, candidate.decision) %><%= select_tag "candidates[#{candidate.id}][matched_product_id]", options_from_collection_for_select(@products, :id, :name, candidate.matched_product_id), include_blank: "No existing match" %></div></article><% end %>
    <footer class="candidate-actions"><%= submit_tag "Save review", class: "button button--secondary" %><%= button_tag "Apply approved candidates", formaction: apply_product_import_batch_path(@batch), formmethod: :post, class: "button button--primary" %></footer>
  <% end %><% end %>
</main>
