<section class="app-page-shell app-page-shell--settings-form preset-admin-shell">
  <header class="app-page-header" id="new">
    <div class="app-page-header-main">
      <h1><%= t("addon_presets.view.index.title") %></h1>
      <p><%= t("addon_presets.view.index.create_title") %> · <%= t("addon_presets.view.index.library_title") %></p>
    </div>
    <div class="app-page-header-actions">
      <%= link_to t("addon_presets.view.index.back_to_product_presets"), product_presets_path, class: "form-page-back-link" %>
    </div>
  </header>

  <article class="app-surface team-members-panel">
    <div class="app-section-heading">
      <h2><%= t("addon_presets.view.index.create_title") %></h2>
    </div>
    <%= render "form", addon_preset: @addon_preset %>
  </article>

  <article class="app-table-surface product-preset-library-panel">
    <div class="app-section-heading product-preset-library-head">
      <h2><%= t("addon_presets.view.index.library_title") %></h2>
    </div>
    <% if @addon_presets.any? %>
      <div class="table-responsive">
        <table class="app-data-table product-preset-library-table">
          <thead>
            <tr>
              <th><%= t("addon_presets.view.index.name") %></th>
              <th><%= t("addon_presets.view.index.addons") %></th>
              <th><%= t("quotes.view.form.actions", default: "Actions") %></th>
            </tr>
          </thead>
          <tbody>
            <% @addon_presets.each do |preset| %>
              <tr>
                <td class="product-preset-library-name-cell"><strong class="product-preset-library-name"><%= preset.name %></strong></td>
                <td class="product-preset-library-values"><%= preset.normalized_entries.map { |entry| "#{entry[:name]}: #{entry[:price]}" }.join(" • ") %></td>
                <td class="product-preset-library-actions-cell">
                  <div class="product-preset-library-actions">
                    <%= link_to t("addon_presets.view.index.edit"), edit_addon_preset_path(preset), class: ui_button_classes(:primary) %>
                    <%= button_to t("addon_presets.view.index.delete"), addon_preset_path(preset), method: :delete, data: { turbo_confirm: t("addon_presets.view.index.delete_confirm") }, class: ui_button_classes(:danger) %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="team-members-hint"><%= t("addon_presets.view.index.empty") %></p>
    <% end %>
  </article>
</section>
