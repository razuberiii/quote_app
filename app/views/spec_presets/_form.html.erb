<%= form_with model: spec_preset, class: "settings-form-grid" do |f| %>
  <div>
    <%= f.label :name, t("spec_presets.view.form.preset_name") %>
    <%= f.text_field :name, placeholder: t("spec_presets.view.form.name_placeholder"), class: ui_input_classes %>
  </div>

  <div class="settings-grid-span-2">
    <%= f.label :entries_text, t("spec_presets.view.form.specifications_text") %>
    <%= f.text_area :entries_text, value: spec_preset.entries_text, rows: 8, placeholder: t("spec_presets.view.form.entries_placeholder"), class: ui_input_classes %>
    <p class="team-members-hint"><%= t("spec_presets.view.form.hint_html") %></p>
  </div>

  <div class="settings-grid-span-2 settings-actions">
    <%= f.submit(spec_preset.persisted? ? t("spec_presets.view.form.update") : t("spec_presets.view.form.create"), class: "btn btn-primary") %>
  </div>
<% end %>
