<% watermark_text = template_watermark_text(@template, @quote.company.name) %>
<% watermark_image_url = template_watermark_image_url(@template) %>
<% web_watermark_opacity = [[template_watermark_opacity(@template).to_f * 0.6, 0.05].max, 0.1].min %>
<% quote_reopened = @quote.status.to_s == "draft" && @quote.reopened_at.present? %>

<article class="public-quote-canvas"
         style="--doc-accent: <%= @template.accent_color %>; --doc-on-accent: <%= contrast_text_color(@template.accent_color) %>; --doc-font: '<%= @template.font_family %>'; --quote-watermark-opacity: <%= web_watermark_opacity %>;">
  <%= render "public/quote_shares/document_body",
             quote: @quote,
             template: @template,
             document_kind: @document_kind,
             watermark_text: watermark_text,
             watermark_image_url: watermark_image_url,
             snapshot: nil,
             preview_mode: false,
             show_public_actions: false,
             decision_state: "inactive",
             status_message: nil,
             has_newer_revision: false,
             latest_share_url: nil,
             share: nil,
             revision_reason_options: [],
             quote_deleted: false,
             quote_reopened: quote_reopened,
             seller_signature_image_url: quote_seller_signature_image_url(@quote),
             seller_stamp_image_url: quote_seller_stamp_image_url(@quote) %>
</article>
