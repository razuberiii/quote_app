<%= render "components/ui/card", class: "dashboard-panel app-surface dashboard-quick-create" do %>
  <div class="dashboard-quick-create-head">
    <div>
      <h2><%= t("dashboard.onboarding.quick_create.title") %></h2>
      <p class="dashboard-quick-create-subtitle"><%= t("dashboard.onboarding.quick_create.subtitle") %></p>
    </div>
  </div>

  <div class="dashboard-quick-create-actions">
    <%= render "components/ui/button", href: new_customer_path, variant: :secondary, class: "dashboard-quick-create-action",
                                       attrs: { data: { controller: "tooltip", tooltip_content_value: t("shortcuts.tooltips.new_customer"), action: "mouseenter->tooltip#show mouseleave->tooltip#hide" } } do %>
      <%= t("dashboard.onboarding.quick_create.new_customer") %><kbd class="app-shortcut-badge">Shift+C</kbd>
    <% end %>

    <%= render "components/ui/button", href: new_product_path, variant: :secondary, class: "dashboard-quick-create-action",
                                       attrs: { data: { controller: "tooltip", tooltip_content_value: t("shortcuts.tooltips.new_product"), action: "mouseenter->tooltip#show mouseleave->tooltip#hide" } } do %>
      <%= t("dashboard.onboarding.quick_create.new_product") %><kbd class="app-shortcut-badge">Shift+P</kbd>
    <% end %>

    <%= render "components/ui/button", href: @quick_create_quote_path, variant: :primary, class: "dashboard-quick-create-action",
                                       attrs: { data: { controller: "tooltip", tooltip_content_value: t("shortcuts.tooltips.new_quote"), action: "mouseenter->tooltip#show mouseleave->tooltip#hide" } } do %>
      <%= t("dashboard.onboarding.quick_create.new_quote") %><kbd class="app-shortcut-badge">Shift+Q</kbd>
    <% end %>
  </div>
<% end %>
