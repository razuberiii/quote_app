<% content_for :meta_robots, "noindex,follow" %>

<section class="marketing-content-shell marketing-auth-shell">
  <div class="marketing-auth-grid">
    <div class="marketing-auth-intro">
      <p class="app-section-caption uppercase tracking-[0.16em]"><%= t("users.sessions.view.new.title") %></p>
      <h1 class="marketing-auth-title">Welcome back.</h1>
      <p class="marketing-auth-body">Continue the Deal, deliver the next Version, or respond while buyer intent is still fresh.</p>
    </div>

    <%= render "components/ui/card", class: "app-surface marketing-auth-card" do %>
      <div class="app-section-stack gap-5">
        <div class="app-section-stack gap-2">
          <h2 class="marketing-auth-card-title"><%= t("users.sessions.view.new.title") %></h2>
          <p class="app-subtle-note">Use your Rubusoo account to open the workspace.</p>
        </div>

        <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "app-form-stack" }) do |f| %>
          <div>
            <%= f.label :login, "Email or username" %>
            <%= f.text_field :login, autofocus: true, autocomplete: "username", class: ui_input_classes %>
          </div>

          <div>
            <%= f.label :password, t("users.sessions.view.new.password") %>
            <%= f.password_field :password, autocomplete: "current-password", class: ui_input_classes %>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="auth-remember">
              <%= f.check_box :remember_me %>
              <%= f.label :remember_me, t("users.sessions.view.new.remember_me") %>
            </div>
          <% end %>

          <div>
            <%= f.submit t("users.sessions.view.new.submit"), class: "app-ui-button app-ui-button--primary auth-submit-button" %>
          </div>
        <% end %>

        <div class="auth-links">
          <% if devise_mapping.registerable? %>
            <%= link_to t("users.sessions.view.new.sign_up"), new_registration_path(resource_name) %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>
