<% quote = card[:quote] %>
<% signal = card[:push_signal] %>
<% signal_presenter = QuoteSignalPresenter.new(locale: I18n.locale) %>
<% signal_cta = signal[:quote_signal].present? ? signal_presenter.signal_cta(signal: signal[:quote_signal], quote: quote) : nil %>
<article class="quote-card" onclick="window.location='<%= quote_path(card[:quote]) %>'">
  <div class="quote-card-action-callout <%= "is-urgent" if signal[:state] == "risk" %>">
    <span class="quote-card-callout-label"><%= t("customers.view.quote_card.next_action") %></span>
    <div>
      <strong><%= signal[:summary] %></strong>
      <span><%= signal[:detail] %></span>
    </div>
  </div>

  <div class="quote-card-layout">
    <div class="quote-card-main">
      <div class="quote-card-heading">
        <h4><%= card[:title] %></h4>
      </div>
      <div class="quote-card-signal-row">
        <span class="quote-card-signal-pill is-<%= signal[:state] %>"><%= signal[:summary] %></span>
        <% if quote.win_reason.present? && card[:display_status] == "won" %>
          <span class="quote-card-signal-detail"><%= t("customers.view.quote_card.win_reason", reason: quote.display_win_reason) %></span>
        <% elsif quote.loss_reason.present? && card[:display_status] == "lost" %>
          <span class="quote-card-signal-detail"><%= t("customers.view.quote_card.loss_reason", reason: quote.display_loss_reason) %></span>
        <% elsif quote.stalled_reason.present? && %w[sent viewed negotiating expired].include?(card[:display_status]) %>
          <span class="quote-card-signal-detail"><%= t("customers.view.quote_card.pressure", reason: quote.display_stalled_reason) %></span>
        <% elsif quote.valid_until.present? && card[:display_status] == "expired" %>
          <span class="quote-card-signal-detail"><%= t("customers.view.quote_card.expired_on", date: quote.valid_until.strftime("%Y-%m-%d")) %></span>
        <% end %>
      </div>
      <div class="quote-card-meta">
        <p>
          <strong><%= t("customers.view.quote_card.total") %>:</strong>
          <span class="quote-total-value"><%= quote_money(card[:current_total], card[:currency]) %></span>
        </p>
        <p><strong><%= t("customers.view.quote_card.updated") %>:</strong> <%= card[:updated_at]&.strftime("%Y-%m-%d") || "-" %></p>
        <% if quote.valid_until.present? %>
          <% days_left = (quote.valid_until - Date.current).to_i %>
          <% if days_left.negative? %>
            <p><strong><%= t("customers.view.quote_card.valid_until") %>:</strong> <%= quote_status_badge("expired", label: t("customers.view.quote_card.valid_until_expired", date: quote.valid_until.strftime("%Y-%m-%d"))) %></p>
          <% elsif days_left <= 3 %>
            <p><strong><%= t("customers.view.quote_card.valid_until") %>:</strong> <%= status_badge(t("customers.view.quote_card.valid_until_days_left", date: quote.valid_until.strftime("%Y-%m-%d"), count: days_left), :amber) %></p>
          <% else %>
            <p><strong><%= t("customers.view.quote_card.valid_until") %>:</strong> <%= quote.valid_until.strftime("%Y-%m-%d") %></p>
          <% end %>
        <% end %>
      </div>

      <% if card[:changed_from_original] %>
        <div class="quote-card-diff">
          <span><strong><%= t("customers.view.quote_card.original") %>:</strong> <%= quote_money(card[:original_total], card[:currency]) %></span>
          <span class="diff-value <%= card[:diff_amount].negative? ? "down" : "up" %>">
            <%= card[:trend] == :up ? "↑" : (card[:trend] == :down ? "↓" : "→") %>
            <%= quote_money(card[:diff_amount], card[:currency]) %>
            (<%= card[:diff_pct] %>%)
          </span>
        </div>
      <% end %>
    </div>

    <div class="quote-card-side">
      <div class="quote-card-badges">
        <span class="revision-pill">V<%= card[:revision] %></span>
        <%= quote_status_badge(card[:display_status], label: t("quotes.view.form.status_options.#{card[:display_status]}", default: card[:display_status].to_s.humanize)) %>
      </div>
    </div>
  </div>

  <div class="quote-card-actions" onclick="event.stopPropagation();">
    <% primary_label = signal_cta&.label || signal[:label] %>
    <%= link_to primary_label, quote_path(card[:quote]), class: ui_button_classes(:primary, "quote-action-primary") %>
    <% if quote.can_edit_revision? %>
      <%= link_to t("quotes.view.show.toolbar.edit"), edit_quote_path(card[:quote]), class: ui_button_classes(:secondary, "quote-card-secondary-action") %>
    <% end %>
    <% if quote.can_create_new_revision? %>
      <%= button_to t("quotes.view.show.toolbar.new_revision"), duplicate_quote_path(card[:quote]), method: :post, form: { data: { turbo: false }, onsubmit: "event.stopPropagation();" }, class: ui_button_classes(:secondary, "quote-card-secondary-action") %>
    <% end %>
    <% if quote.can_reopen? %>
      <%= button_to t("quotes.view.show.toolbar.reopen_quote"),
                    reopen_quote_path(card[:quote]),
                    method: :post,
                    form: { data: { turbo_confirm: t("quotes.view.show.toolbar.reopen_confirm") }, onsubmit: "event.stopPropagation();" },
                    class: ui_button_classes(:secondary, "quote-card-secondary-action") %>
    <% end %>
    <% if quote.can_copy_and_reprice? %>
      <%= button_to t("quotes.view.show.toolbar.copy_reprice"), duplicate_and_reprice_quote_path(card[:quote]), method: :post, form: { data: { turbo: false }, onsubmit: "event.stopPropagation();" }, class: ui_button_classes(:secondary, "quote-card-secondary-action") %>
    <% end %>
    <% if quote.can_delete_quote_family? %>
      <%= button_to t("quotes.view.show.toolbar.delete_quote"),
                    quote_path(card[:quote]),
                    method: :delete,
                    form: { data: { turbo_confirm: t("quotes.view.show.toolbar.delete_confirm", quote_no: quote.quote_no) },
                            onsubmit: "event.stopPropagation(); if (!confirm('#{j(t("quotes.view.show.toolbar.delete_final_warning"))}')) return false; if (prompt('#{j(t("quotes.view.show.toolbar.delete_prompt"))}') !== 'DELETE') return false;" },
                    class: ui_button_classes(:danger, "quote-card-secondary-action") %>
    <% end %>
  </div>
</article>
