<div class="dashboard-detail-grid dashboard-detail-grid--reports">
  <%= render "components/ui/card", class: "dashboard-panel dashboard-panel--data dashboard-overview-panel app-surface" do %>
    <div class="app-section-heading">
      <div>
        <h2>Sales Ownership</h2>
        <p class="app-section-caption">Account load and quote outcomes by internal owner.</p>
      </div>
    </div>
    <% sales_rows = @performance_report[:sales_ownership].first(3) %>
    <% if sales_rows.any? %>
      <ul class="dashboard-overview-list dashboard-report-list">
        <% sales_rows.each do |row| %>
          <li class="dashboard-report-row">
            <div class="dashboard-report-main">
              <div class="dashboard-report-topline">
                <span><%= row[:owner_name] %></span>
                <small><%= pluralize(row[:account_count], "account") %></small>
              </div>
              <strong class="dashboard-overview-value"><%= row[:open_quotes] %> open <span>•</span> <%= row[:won_quotes] %> won</strong>
            </div>
            <div class="dashboard-report-meta">
              <span><%= row[:quote_threads] %> threads</span>
              <span><%= row[:win_rate] %>% win rate</span>
              <% if row[:overdue_accounts].positive? %>
                <span><%= row[:overdue_accounts] %> overdue</span>
              <% end %>
              <% if row[:last_quote_at].present? %>
                <span>latest <%= format_in_user_time(row[:last_quote_at], current_user) %></span>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
      <% if @performance_report[:sales_ownership].size > sales_rows.size %>
        <p class="dashboard-panel-note">Showing top <%= sales_rows.size %> owners by current quote load and outcomes.</p>
      <% end %>
    <% else %>
      <p class="team-members-hint">Assign internal owners to customers to see ownership load here.</p>
    <% end %>
  <% end %>

  <%= render "components/ui/card", class: "dashboard-panel dashboard-panel--data dashboard-overview-panel app-surface" do %>
    <div class="app-section-heading">
      <div>
        <h2>Customer Portfolio</h2>
        <p class="app-section-caption">Most active accounts ranked by open and won quote threads.</p>
      </div>
    </div>
    <% portfolio_rows = @performance_report[:customer_portfolio].first(3) %>
    <% if portfolio_rows.any? %>
      <ul class="dashboard-overview-list dashboard-report-list">
        <% portfolio_rows.each do |row| %>
          <li class="dashboard-report-row">
            <div class="dashboard-report-main">
              <div class="dashboard-report-topline">
                <span><%= row[:owner_name] %></span>
                <small><%= row[:overdue_follow_up] ? "follow-up overdue" : "follow-up normal" %></small>
              </div>
              <strong class="dashboard-overview-value"><%= link_to row[:name], customer_path(row[:customer]), class: "dashboard-report-link" %></strong>
            </div>
            <div class="dashboard-report-meta">
              <span><%= row[:open_quotes] %> open</span>
              <span><%= row[:won_quotes] %> won</span>
              <span><%= row[:quote_threads] %> threads</span>
              <span><%= row[:win_rate] %>% win rate</span>
              <% if row[:last_quote_at].present? %>
                <span>latest <%= format_in_user_time(row[:last_quote_at], current_user) %></span>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
      <% if @performance_report[:customer_portfolio].size > portfolio_rows.size %>
        <p class="dashboard-panel-note">Showing top <%= portfolio_rows.size %> accounts by active quote momentum.</p>
      <% end %>
    <% else %>
      <p class="team-members-hint">Customer portfolio data will appear once quotes are active.</p>
    <% end %>
  <% end %>
</div>
