<main class="deal-workspace deal-detail">
  <header class="deal-hero">
    <div><%= link_to "← Deals", deals_path, class: "deal-back" %><p class="eyebrow"><%= @deal.customer&.name || "Buyer to confirm" %></p><h1><%= deal_title(@deal) %></h1><p><%= @deal.quote_no %> · <%= deal_version_label(@deal) %> · Owner <%= current_user.full_name.presence || current_user.username %></p></div>
    <dl><div><dt>Stage</dt><dd class="deal-stage deal-stage--<%= @progress.stage %>"><i></i><%= @progress.stage_label %></dd></div><div><dt>Current amount</dt><dd><%= @deal.currency %> <%= number_with_delimiter(@deal.grand_total) %></dd></div><div><dt>Last buyer activity</dt><dd><%= @progress.signal %></dd></div></dl>
    <div class="deal-primary-action"><span>Next action</span><strong><%= @progress.action_label %></strong><%= link_to @progress.action_label, deal_action_path(@deal, @progress), class: "button button--primary" %><details><summary>More</summary><div><%= link_to "Edit working quote", edit_quote_path(@deal) %><%= link_to "Legacy document view", quote_path(@deal) %><%= link_to "Buyer profile", customer_path(@deal.customer) if @deal.customer %></div></details></div>
  </header>
  <nav class="deal-tabs"><% [["overview","Overview"],["quote","Quote"],["conversation","Conversation"],["versions","Versions"],["documents","Documents"]].each do |key,label| %><%= link_to label, deal_path(@deal, tab: key), class: ("is-active" if @tab == key) %><% end %></nav>

  <% if @tab == "overview" %><div class="deal-overview-grid"><section class="deal-focus"><p class="section-kicker">Move this deal</p><h2><%= @progress.action_label %></h2><p><%= @progress.signal %>. Rubusoo selected this as the single action most likely to move the deal forward.</p><%= link_to @progress.action_label, deal_action_path(@deal, @progress), class: "button button--primary" %></section><section class="deal-facts"><h2>Commercial snapshot</h2><dl><div><dt>Buyer</dt><dd><%= @deal.customer&.name %></dd></div><div><dt>Items</dt><dd><%= @deal.quote_items.size %></dd></div><div><dt>Currency</dt><dd><%= @deal.currency %></dd></div><div><dt>Valid until</dt><dd><%= @deal.valid_until || "Not set" %></dd></div><div><dt>Incoterm</dt><dd><%= @deal.trade_term.presence || "Not set" %></dd></div><div><dt>Accepted selection</dt><dd><%= @acceptance ? "Locked" : "Not accepted" %></dd></div></dl></section><section class="deal-timeline"><header><h2>Recent timeline</h2><span>All activity stays with this deal</span></header><ol><% @activities.first(8).each do |activity| %><li><i></i><div><strong><%= activity.kind.humanize %></strong><span><%= activity.metadata["label"] || @deal.customer&.name %></span></div><time><%= time_ago_in_words(activity.created_at) %> ago</time></li><% end %><% if @activities.empty? %><li><i></i><div><strong>Deal created</strong><span>Working quote started</span></div><time><%= time_ago_in_words(@deal.created_at) %> ago</time></li><% end %></ol></section></div>
  <% elsif @tab == "quote" %><section class="deal-tab-panel deal-quote-panel"><div><p class="section-kicker">Working quote</p><h2>Build the buyer’s decision page.</h2><p>Edit products, pricing and commercial terms in Quote Studio. Publishing locks a new buyer-facing Version.</p></div><div><%= link_to "Continue in Quote Studio", edit_quote_path(@deal), class: "button button--primary" %><%= link_to "Preview Buyer Room", public_preview_quote_path(@deal), class: "button button--secondary", target: "_blank" %></div></section>
  <% elsif @tab == "conversation" %>
    <section class="conversation-stream">
      <header><p class="section-kicker">Buyer conversation</p><h2>Questions and change requests, with context.</h2></header>
      <% (@questions.to_a + @requests.to_a).sort_by(&:created_at).reverse.each do |message| %>
        <article>
          <div><span><%= message.is_a?(BuyerQuestion) ? "Question · #{message.context_key.presence || 'Quote'}" : "Change request" %></span><strong><%= message.buyer_name.presence || message.buyer_email %></strong><time><%= time_ago_in_words(message.created_at) %> ago</time></div>
          <p><%= message.respond_to?(:body) ? message.body : message.message %></p>
          <% if message.is_a?(BuyerQuestion) && message.seller_reply.present? %>
            <blockquote><span>Seller reply</span><%= message.seller_reply %></blockquote>
          <% elsif message.is_a?(BuyerQuestion) %>
            <%= form_with scope: :buyer_question, url: reply_question_deal_path(@deal, question_id: message.id), method: :patch, class: "conversation-reply" do |form| %>
              <%= form.text_area :seller_reply, placeholder: "Reply with the product and option context preserved", required: true, rows: 3 %>
              <%= form.submit "Reply", class: "button button--primary" %>
            <% end %>
          <% end %>
        </article>
      <% end %>
      <% if @questions.empty? && @requests.empty? %><div class="deal-zero"><h2>No buyer messages yet.</h2><p>Contextual questions and change requests will appear here.</p></div><% end %>
    </section>
  <% elsif @tab == "versions" %><section class="versions-list"><header><p class="section-kicker">Published versions</p><h2>A clear commercial history, not source control.</h2></header><% @versions.each do |version| %><article><span>Version <%= version.number %></span><div><strong><%= version.status == "current" ? "Current buyer version" : version.status.humanize %></strong><small>Published <%= version.sent_at ? time_ago_in_words(version.sent_at) + " ago" : "as draft" %></small></div><strong><%= version.currency %> <%= number_with_delimiter(version.total) %></strong><%= link_to(version.number == @versions.first.number && @versions.second ? "Compare changes" : "View", quote_revision_path(version), class: "deal-next") %></article><% end %></section>
  <% else %><section class="documents-grid"><header><p class="section-kicker">Deal documents</p><h2>Only documents that belong to this commercial process.</h2></header><article><span>Quote PDF</span><strong><%= deal_version_label(@deal) %></strong><%= link_to "Open document", quote_path(@deal), class: "deal-next" %></article><% if @pi %><article><span>Proforma invoice</span><strong><%= @pi.number %></strong><div class="document-actions"><%= link_to "Open PI", proforma_invoice_path(@pi), class: "deal-next" %><%= button_to "Mark sent", mark_sent_proforma_invoice_path(@pi), method: :patch, class: "button button--secondary" unless @pi.sent_at? %></div></article><% elsif @acceptance %><article class="is-action"><span>Proforma invoice</span><strong>Ready to generate</strong><%= button_to "Generate PI", proforma_invoices_path, params: { quote_acceptance_id: @acceptance.id }, class: "button button--primary" %></article><% end %></section><% end %>
</main>
