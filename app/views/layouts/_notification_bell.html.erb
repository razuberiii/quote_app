<% unread_notifications = current_user.notifications.unread.recent.limit(10) %>
<% unread_count = unread_notifications.count %>

<div class="notification-bell-container">
  <details class="notification-bell-dropdown">
    <summary class="notification-bell-trigger" aria-label="<%= t("notifications.aria_label", count: unread_count) %>">
      <span class="notification-bell-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
      </span>
        <span class="notification-badge<%= ' is-zero' if unread_count == 0 %>" id="notification-badge-count"<%= ' hidden' if unread_count == 0 %>><%= unread_count > 9 ? "9+" : unread_count %></span>
    </summary>
    <div class="notification-bell-menu" id="notification-bell-menu">
      <%= render "layouts/notification_bell_menu", unread_notifications: unread_notifications %>
    </div>
  </details>
</div>
