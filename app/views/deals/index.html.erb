<main class="deal-workspace deals-index">
  <header class="deal-page-header"><div><p class="eyebrow">Commercial pipeline</p><h1>Deals</h1><p>One record from inquiry to close. One next action per active deal.</p></div><%= link_to "New deal", new_inquiry_path(mode: "manual"), class: "button button--primary" %></header>
  <form class="deal-filters" method="get"><label>Search<input type="search" name="q" value="<%= params[:q] %>" placeholder="Buyer, product or deal"></label><label>Outcome<select name="outcome"><option>All active outcomes</option><option>Won</option><option>Lost</option></select></label><label>Attention<select name="attention"><option>All deals</option><option>Needs attention</option><option>Waiting</option></select></label><button class="button button--secondary">Filter</button></form>
  <% @groups.each do |label, rows| %><% next if rows.empty? %><section class="deal-group"><header><h2><%= label %></h2><span><%= rows.size %></span></header><div class="deal-table"><div class="deal-table__head"><span>Buyer / deal</span><span>Stage</span><span>Amount</span><span>Latest activity</span><span>Next action</span></div><% rows.each do |deal, progress| %><article class="deal-row"><%= link_to deal_path(deal), class: "deal-row__identity" do %><strong><%= deal.customer&.name || "Buyer to confirm" %></strong><span><%= deal_title(deal) %></span><small><%= deal_version_label(deal) %> · Updated <%= time_ago_in_words(deal.updated_at) %> ago</small><% end %><span class="deal-stage deal-stage--<%= progress.stage %>"><i></i><%= progress.stage_label %></span><strong class="deal-money"><%= deal.currency %> <%= number_with_delimiter(deal.grand_total) %></strong><span class="deal-signal"><%= progress.signal %><small><%= time_ago_in_words(progress.signal_at || deal.updated_at) %> ago</small></span><%= link_to progress.action_label, deal_action_path(deal, progress), class: "deal-next" %></article><% end %></div></section><% end %>
  <% if @deals.empty? %><div class="deal-zero"><h2>Your first deal starts with an inquiry.</h2><%= link_to "Import inquiry", new_inquiry_path, class: "button button--primary" %></div><% end %>
</main>
