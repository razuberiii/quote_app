<style>
  .commercial-pdf{--accent:<%= @snapshot.dig("document_design", "accent_color").presence || "#1F4E79" %>;font-family:<%= @snapshot.dig("document_design", "font_family").presence || "Arial" %>,sans-serif;color:#17211c;background:#fff;font-size:9.5pt}.commercial-pdf>header{display:grid;grid-template-columns:1fr 62mm;gap:16mm;padding:4mm 0 9mm;border-top:4mm solid var(--accent);border-bottom:1px solid #b9c3bd}.commercial-pdf__brand{margin:8mm 0 10mm;color:var(--accent);font-size:8.5pt;font-weight:700;letter-spacing:.14em;text-transform:uppercase}.commercial-pdf h1{margin:0 0 2mm;font:700 27pt/1.05 Georgia,serif}.commercial-pdf h2{margin:0 0 4mm;font:700 12pt Georgia,serif}.commercial-pdf p{line-height:1.5}.commercial-pdf dl{margin:0}.commercial-pdf>header dl{display:grid;grid-template-columns:24mm 1fr;gap:2mm 3mm;padding-top:12mm}.commercial-pdf dt{color:#657269;font-size:7.5pt;text-transform:uppercase;letter-spacing:.07em}.commercial-pdf dd{margin:0;font-weight:700}.commercial-pdf__intro{padding:7mm 0 5mm;max-width:130mm}.commercial-pdf table{width:100%;border-collapse:collapse;table-layout:fixed}.commercial-pdf th{padding:3mm 2mm;background:#17211c;color:#fff;font-size:7.5pt;text-align:left;text-transform:uppercase}.commercial-pdf td{padding:4mm 2mm;border-bottom:1px solid #dfe4e0;vertical-align:top;overflow-wrap:anywhere}.commercial-pdf td small,.commercial-pdf td strong{display:block}.commercial-pdf th:nth-child(1){width:24%}.commercial-pdf th:nth-child(2){width:34%}.commercial-pdf th:nth-child(3){width:11%}.commercial-pdf th:nth-child(4),.commercial-pdf th:nth-child(5){width:15.5%;text-align:right}.commercial-pdf td:nth-child(4),.commercial-pdf td:nth-child(5){text-align:right}.commercial-pdf__bottom{display:grid;grid-template-columns:1fr 70mm;gap:15mm;margin-top:9mm;break-inside:avoid}.commercial-pdf__bottom>div:first-child dl{display:grid;grid-template-columns:25mm 1fr;gap:2mm}.commercial-pdf__total{padding:6mm;background:#eef2ef;border-top:2px solid var(--accent)}.commercial-pdf__total span,.commercial-pdf__total small{display:block}.commercial-pdf__total strong{display:block;margin:3mm 0;font:700 19pt Georgia,serif}.commercial-pdf>footer{display:flex;justify-content:space-between;margin-top:13mm;padding-top:4mm;border-top:1px solid #cfd6d1;color:#657269;font-size:8pt}
</style>
<% company = @snapshot["seller_company"].presence || { "name" => @revision.company.name, "email" => @revision.company.email, "phone" => @revision.company.phone }; customer = { "name" => @snapshot["customer_name"] }; items = Array(@snapshot["quote_items"]) %>
<article class="commercial-pdf commercial-pdf--modern">
  <header><div><p class="commercial-pdf__brand"><%= company["name"] %></p><h1><%= t("self_service.buyer_room.pdf.title") %></h1><p><%= t("self_service.buyer_room.pdf.prepared_for_html", customer: content_tag(:strong, customer["company_name"].presence || customer["name"])) %></p></div><dl><dt><%= t("self_service.buyer_room.pdf.quote") %></dt><dd><%= @revision.quote.quote_no %></dd><dt><%= t("self_service.buyer_room.pdf.revision") %></dt><dd><%= @revision.number %></dd><dt><%= t("self_service.buyer_room.pdf.issued") %></dt><dd><%= (@revision.sent_at || @revision.published_at)&.to_date %></dd><dt><%= t("self_service.buyer_room.pdf.valid_until") %></dt><dd><%= @revision.expires_at&.to_date %></dd></dl></header>
  <section class="commercial-pdf__intro"><p><%= t("self_service.buyer_room.pdf.intro") %></p></section>
  <section><h2><%= t("self_service.buyer_room.pdf.scope") %></h2><table><thead><tr><th><%= t("self_service.buyer_room.pdf.product") %></th><th><%= t("self_service.buyer_room.pdf.specification") %></th><th><%= t("self_service.buyer_room.pdf.quantity") %></th><th><%= t("self_service.buyer_room.pdf.unit_price") %></th><th><%= t("self_service.buyer_room.pdf.amount") %></th></tr></thead><tbody><% items.each do |item| %><tr><td><strong><%= item["product_name"].presence || item["description"] %></strong><small><%= item["sku_snapshot"] %></small></td><td><%= Array(item["specifications"]).map { |spec| "#{spec['key'] || spec['name']}: #{spec['value']}" }.join(" · ").presence || item["description"] %></td><td><%= item["quantity"] %> <%= item["unit_snapshot"] %></td><td><%= @revision.currency %> <%= number_with_delimiter(item["unit_price"].to_d, delimiter: ",") %></td><td><strong><%= @revision.currency %> <%= number_with_delimiter(item["unit_price"].to_d * item["quantity"].to_d, delimiter: ",") %></strong></td></tr><% end %></tbody></table></section>
  <section class="commercial-pdf__bottom"><div><h2><%= t("self_service.buyer_room.pdf.terms") %></h2><dl><dt><%= t("self_service.buyer_room.pdf.incoterm") %></dt><dd><%= @snapshot["trade_term"].presence || t("self_service.buyer_room.agreed") %></dd><dt><%= t("self_service.buyer_room.pdf.payment") %></dt><dd><%= @snapshot["payment_term"].presence || t("self_service.buyer_room.agreed") %></dd><dt><%= t("self_service.buyer_room.pdf.delivery") %></dt><dd><%= @snapshot["delivery_notes"].presence || t("self_service.buyer_room.agreed") %></dd></dl></div><div class="commercial-pdf__total"><span><%= t("self_service.buyer_room.pdf.total") %></span><strong><%= @revision.currency %> <%= number_with_delimiter(@revision.total, delimiter: ",") %></strong><small><%= t("self_service.buyer_room.pdf.total_note", number: @revision.number) %></small></div></section>
  <footer><strong><%= company["name"] %></strong><span><%= [company["email"], company["phone"]].compact_blank.join(" · ") %></span></footer>
</article>
