<style>
  .commercial-pdf{--accent:<%= @snapshot.dig("document_design", "accent_color").presence || "#1F4E79" %>;font-family:<%= @snapshot.dig("document_design", "font_family").presence || '"Noto Sans CJK SC"' %>,"Noto Sans","Segoe UI",Arial,sans-serif;color:#17211c;background:#fff;font-size:10pt;line-height:1.58}.commercial-pdf>header{display:grid;grid-template-columns:1fr 62mm;gap:14mm;padding:4mm 0 9mm;border-top:3mm solid var(--accent);border-bottom:1px solid #b9c3bd}.commercial-pdf__brand{margin:7mm 0 8mm;color:var(--accent);font-size:8pt;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.commercial-pdf h1{margin:0 0 3mm;font-family:inherit;font-size:25pt;font-weight:700;line-height:1.16;letter-spacing:-.02em}.commercial-pdf h2{margin:0 0 4mm;font-family:inherit;font-size:12pt;font-weight:700;line-height:1.3}.commercial-pdf p{line-height:1.58}.commercial-pdf dl{margin:0}.commercial-pdf>header dl{display:grid;grid-template-columns:24mm 1fr;gap:2.4mm 3mm;padding-top:10mm}.commercial-pdf dt{color:#657269;font-size:7.5pt;text-transform:uppercase;letter-spacing:.05em}.commercial-pdf dd{margin:0;font-weight:650;line-height:1.45}.commercial-pdf__intro{padding:7mm 0 6mm;max-width:140mm}.commercial-pdf table{width:100%;border-collapse:collapse;table-layout:fixed}.commercial-pdf th{padding:3.2mm 2.4mm;background:#17211c;color:#fff;font-size:7.5pt;text-align:left;text-transform:uppercase;letter-spacing:.02em}.commercial-pdf td{padding:4.5mm 2.4mm;border-bottom:1px solid #dfe4e0;vertical-align:top;line-height:1.52;overflow-wrap:anywhere}.commercial-pdf td small,.commercial-pdf td strong{display:block}.commercial-pdf th:nth-child(1){width:24%}.commercial-pdf th:nth-child(2){width:34%}.commercial-pdf th:nth-child(3){width:11%}.commercial-pdf th:nth-child(4),.commercial-pdf th:nth-child(5){width:15.5%;text-align:right}.commercial-pdf td:nth-child(4),.commercial-pdf td:nth-child(5){text-align:right}.commercial-pdf__custom{margin-top:8mm;padding-top:5mm;border-top:1px solid #cfd6d1;break-inside:avoid}.commercial-pdf__custom dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4mm 10mm}.commercial-pdf__custom dl div{min-width:0}.commercial-pdf__custom dd{overflow-wrap:anywhere}.commercial-pdf__bottom{display:grid;grid-template-columns:1fr 70mm;gap:14mm;margin-top:10mm;break-inside:avoid}.commercial-pdf__bottom>div:first-child dl{display:grid;grid-template-columns:25mm 1fr;gap:2.5mm}.commercial-pdf__total{padding:6mm;background:#eef2ef;border-top:2px solid var(--accent)}.commercial-pdf__total span,.commercial-pdf__total small{display:block}.commercial-pdf__total strong{display:block;margin:3mm 0;font-family:inherit;font-size:18pt;font-weight:700;line-height:1.2}.commercial-pdf>footer{display:flex;justify-content:space-between;margin-top:13mm;padding-top:4mm;border-top:1px solid #cfd6d1;color:#657269;font-size:8pt}
</style>
<% company = @snapshot["seller_company"].presence || { "name" => @revision.company.name, "email" => @revision.company.email, "phone" => @revision.company.phone }; customer = { "name" => @snapshot["customer_name"] }; items = Array(@snapshot["quote_items"]) %>
<% custom_fields = Array(@snapshot["custom_fields"]).select { |field| @snapshot.fetch("custom_field_values", {})[field["key"]].present? } %>
<article class="commercial-pdf commercial-pdf--modern">
  <header><div><p class="commercial-pdf__brand"><%= company["name"] %></p><h1><%= t("self_service.buyer_room.pdf.title") %></h1><p><%= t("self_service.buyer_room.pdf.prepared_for_html", customer: content_tag(:strong, customer["company_name"].presence || customer["name"])) %></p></div><dl><dt><%= t("self_service.buyer_room.pdf.quote") %></dt><dd><%= @revision.quote.quote_no %></dd><dt><%= t("self_service.buyer_room.pdf.revision") %></dt><dd><%= @revision.number %></dd><dt><%= t("self_service.buyer_room.pdf.issued") %></dt><dd><%= (@revision.sent_at || @revision.published_at)&.to_date %></dd><dt><%= t("self_service.buyer_room.pdf.valid_until") %></dt><dd><%= @revision.expires_at&.to_date %></dd></dl></header>
  <section class="commercial-pdf__intro"><p><%= t("self_service.buyer_room.pdf.intro") %></p></section>
  <section><h2><%= t("self_service.buyer_room.pdf.scope") %></h2><table><thead><tr><th><%= t("self_service.buyer_room.pdf.product") %></th><th><%= t("self_service.buyer_room.pdf.specification") %></th><th><%= t("self_service.buyer_room.pdf.quantity") %></th><th><%= t("self_service.buyer_room.pdf.unit_price") %></th><th><%= t("self_service.buyer_room.pdf.amount") %></th></tr></thead><tbody><% items.each do |item| %><tr><td><strong><%= item["product_name"].presence || item["description"] %></strong><small><%= item["sku_snapshot"] %></small></td><td><%= Array(item["specifications"]).map { |spec| "#{spec['key'] || spec['name']}: #{spec['value']}" }.join(" · ").presence || item["description"] %></td><td><%= item["quantity"] %> <%= item["unit_snapshot"] %></td><td><%= @revision.currency %> <%= number_with_precision(item["unit_price"].to_d, precision: 2, delimiter: ",") %></td><td><strong><%= @revision.currency %> <%= number_with_precision(item["unit_price"].to_d * item["quantity"].to_d, precision: 2, delimiter: ",") %></strong></td></tr><% end %></tbody></table></section>
  <% if custom_fields.any? %><section class="commercial-pdf__custom"><h2><%= t("self_service.buyer_room.custom_fields_title", default: "Quote details") %></h2><dl><% custom_fields.each do |field| %><div><dt><%= field["label"] %></dt><dd><%= @snapshot.fetch("custom_field_values", {})[field["key"]] %></dd></div><% end %></dl></section><% end %>
  <section class="commercial-pdf__bottom"><div><h2><%= t("self_service.buyer_room.pdf.terms") %></h2><dl><dt><%= t("self_service.buyer_room.pdf.incoterm") %></dt><dd><%= @snapshot["trade_term"].presence || t("self_service.buyer_room.agreed") %></dd><dt><%= t("self_service.buyer_room.pdf.payment") %></dt><dd><%= @snapshot["payment_term"].presence || t("self_service.buyer_room.agreed") %></dd><dt><%= t("self_service.buyer_room.pdf.delivery") %></dt><dd><%= @snapshot["delivery_notes"].presence || t("self_service.buyer_room.agreed") %></dd></dl></div><div class="commercial-pdf__total"><span><%= t("self_service.buyer_room.pdf.total") %></span><strong><%= @revision.currency %> <%= number_with_precision(@revision.total, precision: 2, delimiter: ",") %></strong><small><%= t("self_service.buyer_room.pdf.total_note", number: @revision.number) %></small></div></section>
  <footer><strong><%= company["name"] %></strong><span><%= [company["email"], company["phone"]].compact_blank.join(" · ") %></span></footer>
</article>
