<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <style>
      :root {
        --doc-font: "Noto Sans", "Segoe UI", Arial, sans-serif;
        --doc-page-padding-x: 1.35rem;
        --doc-page-padding-top: 1.35rem;
        --doc-page-padding-bottom: 1.6rem;
      }

      @page {
        size: A4;
        margin: 10mm;
      }

      html, body {
        background: #ffffff !important;
      }

      body {
        margin: 0;
        padding: 0;
        color: #111827;
        font-family: var(--doc-font), "Noto Sans CJK SC", "Noto Sans CJK JP", "Noto Sans CJK TC", "PingFang SC", "Microsoft YaHei", sans-serif;
      }

      .public-quote-main {
        max-width: 100% !important;
        margin: 0 !important;
      }
    </style>
  <% 
    # Get dynamic colors from instance variables for PDF rendering
    pdf_accent_color = @template.accent_color.presence || "#1F4E79"
  %>
  <style>
    /* Dynamic colors applied to PDF */
    .pdf-render .quote-doc-kicker {
      color: <%= pdf_accent_color %> !important;
      letter-spacing: 0.08em !important;
      font-weight: 700 !important;
      font-size: 0.75rem !important;
      margin: 0 !important;
      text-align: right !important;
      text-transform: uppercase !important;
    }
    .pdf-render .quote-total-grand {
      margin-top: 0.06in !important;
      border-top: 1px solid #9fb4c8 !important;
      padding: 0.075in 0 !important;
      background-color: transparent !important;
      color: #1f3650 !important;
    }
    .pdf-render .quote-total-grand span,
    .pdf-render .quote-total-grand strong {
      color: inherit !important;
    }
  </style>
  <body class="public-quote-body pdf-render">
    <main class="public-quote-main">
      <%= yield %>
    </main>

    <style>
      .pdf-render .quote-document {
        border: none !important;
        border-radius: 0 !important;
        padding: var(--doc-page-padding-top) var(--doc-page-padding-x) var(--doc-page-padding-bottom) !important;
        box-shadow: none !important;
        background: #fff !important;
        color: #222 !important;
        position: relative !important;
        /* PDF quotation typography tokens (baseline/current values). */
        --q-pdf-doc-title-size: 1.45rem !important;
        --q-pdf-doc-title-lh: 1.5 !important;
        --q-pdf-doc-title-w: 700 !important;
        --q-pdf-section-title-size: 13px !important;
        --q-pdf-section-title-lh: 1.5 !important;
        --q-pdf-section-title-w: 700 !important;
        --q-pdf-body-size: 12px !important;
        --q-pdf-body-lh: 1.5 !important;
        --q-pdf-body-w: 400 !important;
        --q-pdf-meta-size: 11px !important;
        --q-pdf-meta-lh: 1.5 !important;
        --q-pdf-meta-w: 400 !important;
        --q-pdf-table-head-size: 11px !important;
        --q-pdf-table-head-lh: 1.5 !important;
        --q-pdf-table-head-w: 700 !important;
        --q-pdf-table-body-size: 12px !important;
        --q-pdf-table-body-lh: 1.5 !important;
        --q-pdf-table-body-w: 400 !important;
        --q-pdf-item-detail-size: 10px !important;
        --q-pdf-item-detail-lh: 1.35 !important;
        --q-pdf-item-detail-w: 400 !important;
        --q-pdf-total-primary-size: 1.16rem !important;
        --q-pdf-total-primary-lh: 1.5 !important;
        --q-pdf-total-primary-w: 800 !important;
        --q-pdf-total-primary-label-size: 12px !important;
        --q-pdf-total-primary-label-lh: 1.5 !important;
        --q-pdf-total-primary-label-w: 500 !important;
        --q-pdf-total-secondary-size: 12px !important;
        --q-pdf-total-secondary-lh: 1.5 !important;
        --q-pdf-total-secondary-w: 400 !important;
        --q-pdf-notes-size: 10.8px !important;
        --q-pdf-notes-lh: 1.5 !important;
        --q-pdf-notes-w: 400 !important;
        --q-pdf-closing-size: 10px !important;
        --q-pdf-closing-lh: 1.4 !important;
        --q-pdf-closing-w: 400 !important;
      }

      .pdf-render .quote-watermarked {
        position: relative !important;
        overflow: hidden !important;
        isolation: isolate !important;
      }

      .pdf-render .quote-watermarked::before {
        content: attr(data-watermark) !important;
        position: absolute !important;
        top: 50% !important;
        left: 50% !important;
        display: inline-block !important;
        white-space: nowrap !important;
        line-height: 1 !important;
        color: rgba(15, 23, 42, 0.35) !important;
        font-size: 64px !important;
        font-weight: 700 !important;
        letter-spacing: 0.18em !important;
        transform: translate(-50%, -50%) rotate(-22deg) !important;
        transform-origin: center center !important;
        pointer-events: none !important;
        z-index: 3 !important;
        opacity: 0.08 !important;
      }

      .pdf-render .quote-watermarked > * {
        position: relative !important;
        z-index: 2 !important;
      }

      .pdf-render .quote-watermark-image {
        position: absolute !important;
        top: 50% !important;
        left: 50% !important;
        max-width: 48% !important;
        max-height: 44% !important;
        opacity: 0.08 !important;
        transform: translate(-50%, -50%) rotate(-18deg) !important;
        pointer-events: none !important;
        z-index: 3 !important;
        object-fit: contain !important;
      }

      /* Sparse quotes: keep watermark but reduce visual dominance in the empty middle area. */
      .pdf-render .pdf-content-sparse.quote-watermarked::before {
        font-size: 52px !important;
        letter-spacing: 0.14em !important;
        opacity: 0.05 !important;
      }

      .pdf-render .pdf-content-sparse .quote-watermark-image {
        max-width: 40% !important;
        max-height: 34% !important;
        opacity: 0.05 !important;
      }

      .pdf-render,
      .pdf-render p,
      .pdf-render td,
      .pdf-render th,
      .pdf-render div,
      .pdf-render span,
      .pdf-render h1,
      .pdf-render h2,
      .pdf-render h3 {
        line-height: 1.5 !important;
      }

      .pdf-render .table-responsive {
        margin-top: 0.08in !important;
        overflow: visible !important;
      }

      .pdf-render .quote-doc-header {
        border-bottom: 1px solid #edf2f7 !important;
        padding-bottom: 0.85rem !important;
        margin-bottom: 1rem !important;
      }

      .pdf-render .pdf-head-table {
        width: 100% !important;
        border-collapse: collapse !important;
      }

      .pdf-render .pdf-head-table td {
        vertical-align: top !important;
        padding: 0 !important;
      }

      .pdf-render .pdf-head-left {
        width: 60% !important;
        padding-right: 0.12in !important;
        text-align: left !important;
      }

      .pdf-render .pdf-head-right {
        width: 40% !important;
        text-align: right !important;
        font-size: 11px !important;
        color: #222 !important;
      }

      .pdf-render .pdf-head-left h1,
      .pdf-render .pdf-head-left .pdf-doc-company-lines,
      .pdf-render .pdf-head-left .pdf-doc-company-lines p {
        text-align: left !important;
      }

      .pdf-render .pdf-head-right .quote-doc-kicker,
      .pdf-render .pdf-head-right .pdf-doc-number,
      .pdf-render .pdf-head-right p {
        text-align: right !important;
      }

      .pdf-render .pdf-head-right p {
        margin: 0 0 0.015in 0 !important;
        white-space: normal !important;
        overflow-wrap: anywhere !important;
        word-break: break-word !important;
      }

      .pdf-render .quote-doc-kicker {
        letter-spacing: 0.08em !important;
        font-weight: 700 !important;
        font-size: 0.75rem !important;
        margin: 0 !important;
        text-align: right !important;
        margin-bottom: 0.25rem !important;
      }

      .pdf-render .quote-doc-header h1 {
        font-size: var(--q-pdf-doc-title-size) !important;
        line-height: var(--q-pdf-doc-title-lh) !important;
        font-weight: var(--q-pdf-doc-title-w) !important;
        margin: 0 !important;
        letter-spacing: 0 !important;
        text-transform: none !important;
        color: #222 !important;
        text-align: left !important;
      }

      .pdf-render .pdf-doc-company-lines {
        margin-top: 0.02in !important;
      }

      .pdf-render .pdf-doc-company-lines p {
        margin: 0 0 0.015in 0 !important;
        color: #888 !important;
        font-size: 11px !important;
        overflow-wrap: anywhere !important;
        word-break: break-word !important;
      }

      .pdf-render .pdf-doc-number {
        font-size: 13px !important;
        margin-bottom: 0.02in !important;
      }

      .pdf-render .pdf-doc-number.is-doc-number strong {
        font-size: 13.5px !important;
        font-weight: 800 !important;
      }

      .pdf-render .pdf-logo-band {
        margin-bottom: 0.08in !important;
      }

      .pdf-render .pdf-logo-left { text-align: left !important; }
      .pdf-render .pdf-logo-right { text-align: right !important; }
      .pdf-render .pdf-logo-center { text-align: center !important; }

      .pdf-render .quote-doc-logo {
        width: auto !important;
        max-height: 80px !important;
      }

      .pdf-render .quote-meta-grid {
        display: block !important;
        margin-bottom: 0.21in !important;
        padding-bottom: 0.1in !important;
        padding-top: 0.1in !important;
        border-top: 1px solid #ddd !important;
        border-bottom: 1px solid #ddd !important;
      }

      .pdf-render .pdf-party-col {
        float: left !important;
        width: 48.5% !important;
      }

      .pdf-render .pdf-party-col + .pdf-party-col {
        margin-left: 3% !important;
      }

      .pdf-render .pdf-clear {
        clear: both !important;
      }

      .pdf-render .quote-meta-card {
        background: #fff !important;
        border: none !important;
        border-radius: 0 !important;
        padding: 0 !important;
        text-align: left !important;
      }

      .pdf-render .quote-meta-card h3 {
        margin: 0 0 0.05in 0 !important;
        font-size: 11.5px !important;
        letter-spacing: 0.03em !important;
        text-transform: uppercase !important;
        color: #222 !important;
      }

      .pdf-render .quote-meta-card p {
        margin: 0 0 0.02in 0 !important;
        font-size: var(--q-pdf-meta-size) !important;
        line-height: var(--q-pdf-meta-lh) !important;
        font-weight: var(--q-pdf-meta-w) !important;
        color: #888 !important;
        overflow-wrap: anywhere !important;
        word-break: break-word !important;
      }

      .pdf-render .quote-meta-card .pdf-party-name {
        font-size: 12.5px !important;
        margin-bottom: 0.03in !important;
        color: #222 !important;
      }

      .pdf-render .quote-doc-table {
        width: 100% !important;
        border-collapse: collapse !important;
        border-spacing: 0 !important;
        table-layout: fixed !important;
        border: none !important;
        margin-bottom: 0.25in !important;
      }

      .pdf-render .quote-doc-table thead {
        background: var(--doc-accent, #1f4e79) !important;
      }

      .pdf-render .quote-doc-table thead th {
        font-size: var(--q-pdf-table-head-size) !important;
        line-height: var(--q-pdf-table-head-lh) !important;
        font-weight: var(--q-pdf-table-head-w) !important;
        color: var(--doc-on-accent, #ffffff) !important;
        border-bottom: 1px solid #ddd !important;
        padding: 0.064in 0.07in !important;
        text-align: left !important;
      }

      .pdf-render .quote-doc-table.has-images th:nth-child(1) { width: 6.5% !important; }
      .pdf-render .quote-doc-table.has-images th:nth-child(2) { width: 10% !important; }
      .pdf-render .quote-doc-table.has-images th:nth-child(3) { width: auto !important; }
      .pdf-render .quote-doc-table.has-images th:nth-child(4) { width: 9% !important; }
      .pdf-render .quote-doc-table.has-images th:nth-child(5) { width: 15% !important; }
      .pdf-render .quote-doc-table.has-images th:nth-child(6) { width: 17% !important; }

      .pdf-render .quote-doc-table.no-images th:nth-child(1) { width: 6.5% !important; }
      .pdf-render .quote-doc-table.no-images th:nth-child(2) { width: auto !important; }
      .pdf-render .quote-doc-table.no-images th:nth-child(3) { width: 9% !important; }
      .pdf-render .quote-doc-table.no-images th:nth-child(4) { width: 15% !important; }
      .pdf-render .quote-doc-table.no-images th:nth-child(5) { width: 17% !important; }

      .pdf-render .quote-doc-table tbody td {
        border-bottom: 1px solid #ddd !important;
        padding: 0.07in 0.07in !important;
        font-size: var(--q-pdf-table-body-size) !important;
        line-height: var(--q-pdf-table-body-lh) !important;
        font-weight: var(--q-pdf-table-body-w) !important;
        vertical-align: top !important;
        overflow-wrap: anywhere !important;
        word-break: break-word !important;
        color: #222 !important;
      }

      .pdf-render .quote-doc-table tr.pdf-filler-row td {
        color: transparent !important;
        padding-top: 0.085in !important;
        padding-bottom: 0.085in !important;
      }

      .pdf-render .quote-item-desc {
        display: block !important;
      }

      .pdf-render .quote-item-desc-main {
        font-weight: 600 !important;
        color: #222 !important;
        overflow-wrap: anywhere !important;
        word-break: break-word !important;
      }

      .pdf-render .quote-item-desc-meta {
        margin-top: 0.02in !important;
      }

      .pdf-render .quote-item-desc-group {
        display: block !important;
        margin-top: 0.01in !important;
      }

      .pdf-render .quote-item-desc-group-label {
        display: block !important;
        font-size: var(--q-pdf-item-detail-size) !important;
        line-height: var(--q-pdf-item-detail-lh) !important;
        font-weight: 600 !important;
        color: #4b5563 !important;
        overflow-wrap: anywhere !important;
        word-break: break-word !important;
      }

      .pdf-render .quote-item-desc-sub {
        display: block !important;
        font-size: var(--q-pdf-item-detail-size) !important;
        color: #6b7280 !important;
        line-height: var(--q-pdf-item-detail-lh) !important;
        font-weight: var(--q-pdf-item-detail-w) !important;
        overflow-wrap: anywhere !important;
        word-break: break-word !important;
      }

      .pdf-render .quote-item-desc-bullet {
        color: #9aa4b2 !important;
      }

      .pdf-render .quote-item-desc-sub.is-addon {
        padding-left: 0.03in !important;
        color: #7b8794 !important;
      }

      .pdf-render .quote-doc-table th.is-money,
      .pdf-render .quote-doc-table td.is-money {
        text-align: right !important;
        white-space: nowrap !important;
        overflow-wrap: normal !important;
        word-break: normal !important;
        font-variant-numeric: tabular-nums !important;
      }

      .pdf-render .quote-doc-table th.is-right,
      .pdf-render .quote-doc-table td.is-right {
        text-align: right !important;
        white-space: nowrap !important;
        overflow-wrap: normal !important;
        word-break: normal !important;
        font-variant-numeric: tabular-nums !important;
      }

      .pdf-render .quote-doc-table th.is-left,
      .pdf-render .quote-doc-table td.is-left {
        text-align: left !important;
      }

      .pdf-render .quote-item-image {
        width: auto !important;
        max-width: 64px !important;
        max-height: 64px !important;
      }

      .pdf-render .quote-total-box {
        margin-top: 0.2in !important;
        float: right !important;
        display: block !important;
        width: 320px !important;
        max-width: 320px !important;
        background: #ffffff !important;
        border: 1px solid #d4dde7 !important;
        border-radius: 0 !important;
        padding: 0.12in 0.14in !important;
        page-break-before: avoid !important;
        break-before: avoid-page !important;
        break-inside: avoid-page !important;
      }

      .pdf-render .pdf-summary-stack {
        clear: both !important;
        width: 320px !important;
        max-width: 320px !important;
        margin-left: auto !important;
        margin-top: 0.08in !important;
        page-break-inside: avoid !important;
        break-inside: avoid-page !important;
      }

      .pdf-render .pdf-summary-stack .quote-total-box {
        float: none !important;
        width: auto !important;
        max-width: none !important;
        margin-top: 0 !important;
      }

      .pdf-render .quote-total-box p {
        display: block !important;
        margin: 0 0 0.02in 0 !important;
        font-size: var(--q-pdf-total-secondary-size) !important;
        line-height: var(--q-pdf-total-secondary-lh) !important;
        font-weight: var(--q-pdf-total-secondary-w) !important;
      }

      .pdf-render .quote-total-box p > span {
        float: left !important;
        color: #4b5563 !important;
      }

      .pdf-render .quote-total-box p.quote-total-grand > span {
        color: #222 !important;
      }

      .pdf-render .quote-total-box p > strong {
        float: right !important;
        text-align: right !important;
        min-width: 1.3in !important;
        font-variant-numeric: tabular-nums !important;
      }

      .pdf-render .quote-total-discount,
      .pdf-render .quote-total-saved {
        color: #b91c1c !important;
      }

      .pdf-render .quote-total-reduction strong {
        text-decoration: line-through !important;
        text-decoration-color: #fca5a5 !important;
      }

      .pdf-render .quote-total-box p:after {
        content: "" !important;
        display: block !important;
        clear: both !important;
      }

      .pdf-render .quote-total-grand {
        margin-top: 0.2rem !important;
        border-top: 1px solid #b9c6d5 !important;
        padding: 0.07in 0 0 !important;
        page-break-inside: avoid !important;
        break-inside: avoid !important;
      }

      .pdf-render .quote-total-grand span {
        color: #0f172a !important;
        font-size: var(--q-pdf-total-primary-label-size) !important;
        line-height: var(--q-pdf-total-primary-label-lh) !important;
        font-weight: var(--q-pdf-total-primary-label-w) !important;
        letter-spacing: 0.01em !important;
      }

      .pdf-render .quote-total-grand strong {
        color: #1d3552 !important;
        font-size: var(--q-pdf-total-primary-size) !important;
        line-height: var(--q-pdf-total-primary-lh) !important;
        font-weight: var(--q-pdf-total-primary-w) !important;
      }

      .pdf-render .quote-engagement-note {
        margin: 0.06in 0 0 0 !important;
        padding-top: 0.04in !important;
        border-top: 1px solid #d9e1ea !important;
        color: #5b6472 !important;
        font-size: var(--q-pdf-closing-size) !important;
        line-height: var(--q-pdf-closing-lh) !important;
        font-weight: var(--q-pdf-closing-w) !important;
      }

      .pdf-render .pdf-engagement-note {
        clear: none !important;
        width: auto !important;
        max-width: none !important;
        margin-left: 0 !important;
        margin-top: 0.05in !important;
        text-align: left !important;
      }

      .pdf-render .quote-public-footnote {
        clear: both !important;
        margin: 0.12in 0 0 0 !important;
        text-align: right !important;
        color: #9aa3af !important;
        font-size: 9px !important;
      }

      .pdf-render .pdf-summary-stack + .quote-section-block {
        margin-top: 0.12in !important;
      }

      .pdf-render .pdf-content-sparse .pdf-summary-stack {
        margin-top: 0.04in !important;
      }

      .pdf-render .quote-section-block {
        margin-top: 0.16in !important;
        clear: both !important;
        border-top: 1px solid #d4d4d4 !important;
        padding-top: 0.07in !important;
        page-break-inside: auto !important;
        break-inside: auto !important;
        text-align: left !important;
      }
      .pdf-render .quote-total-box + .quote-section-block--scope {
        margin-top: 0.13in !important;
      }
      .pdf-render .quote-section-block--scope h3 {
        margin-bottom: 0.035in !important;
      }
      .pdf-render .quote-section-block--scope + .quote-section-block {
        margin-top: 0.14in !important;
      }

      .pdf-render .quote-section-block h3 {
        margin: 0 0 0.025in 0 !important;
        font-size: var(--q-pdf-section-title-size) !important;
        line-height: var(--q-pdf-section-title-lh) !important;
        letter-spacing: 0.03em !important;
        font-weight: var(--q-pdf-section-title-w) !important;
        text-transform: uppercase !important;
        color: #222 !important;
        page-break-after: avoid !important;
        break-after: avoid-page !important;
      }

      .pdf-render .quote-section-block p,
      .pdf-render .quote-section-block div {
        margin: 0.005in 0 !important;
        font-size: var(--q-pdf-notes-size) !important;
        line-height: var(--q-pdf-notes-lh) !important;
        font-weight: var(--q-pdf-notes-w) !important;
        overflow-wrap: anywhere !important;
        word-break: break-word !important;
      }

      .pdf-render .quote-sales-signature-image {
        max-width: 220px !important;
        max-height: 80px !important;
        object-fit: contain !important;
      }

      .pdf-render .quote-doc-table tbody {
        page-break-inside: auto !important;
        break-inside: auto !important;
      }

      .pdf-render .quote-doc-table tr {
        page-break-inside: auto !important;
        break-inside: auto !important;
      }

      .pdf-render .quote-total-box,
      .pdf-render .quote-signature-block {
        page-break-inside: avoid !important;
        break-inside: avoid-page !important;
      }

      .pdf-render .pdf-density-compact .quote-doc-table thead th,
      .pdf-render .pdf-density-compact .quote-doc-table tbody td {
        padding-top: 0.05in !important;
        padding-bottom: 0.05in !important;
      }

      .pdf-render .pdf-density-spacious .quote-doc-table thead th,
      .pdf-render .pdf-density-spacious .quote-doc-table tbody td {
        padding-top: 0.09in !important;
        padding-bottom: 0.09in !important;
      }
    </style>
  </body>
</html>
