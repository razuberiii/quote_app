<main class="deal-workspace deal-detail">
  <header class="deal-hero">
    <div><%= link_to "← Deals", deals_path, class: "deal-back" %><p class="eyebrow"><%= @deal.customer&.name || "Buyer to confirm" %></p><h1><%= deal_title(@deal) %></h1><p><%= @deal.quote_no %> · <%= deal_version_label(@deal) %> · Owner <%= current_user.full_name.presence || current_user.username %></p></div>
    <dl><div><dt>Stage</dt><dd class="deal-stage deal-stage--<%= @progress.stage %>"><i></i><%= @progress.stage_label %></dd></div><div><dt>Current amount</dt><dd><%= @deal.currency %> <%= number_with_delimiter(@deal.grand_total) %></dd></div><div><dt>Last buyer activity</dt><dd><%= @progress.signal %></dd></div></dl>
    <div class="deal-primary-action"><span>Next action</span><strong><%= @progress.action_label %></strong><%= link_to @progress.action_label, deal_action_path(@deal, @progress), class: "button button--primary" %><details><summary>More</summary><div><%= link_to "Edit working draft", edit_quote_path(@deal) %><%= link_to "Deliver current Version", deliver_deal_path(@deal, version_id: @versions.first&.id) if @versions.any? %><%= link_to "Add buyer response", new_response_deal_path(@deal, version_id: @versions.first&.id) if @versions.any? %><%= link_to "Record acceptance", new_acceptance_deal_path(@deal, version_id: @versions.first&.id) if @versions.any? && !@acceptance %><%= link_to "Buyer profile", customer_path(@deal.customer) if @deal.customer %></div></details></div>
  </header>
  <nav class="deal-tabs"><% [["overview","Overview"],["quote","Quote"],["conversation","Conversation"],["versions","Versions"],["documents","Documents"]].each do |key,label| %><%= link_to label, deal_path(@deal, tab: key), class: ("is-active" if @tab == key) %><% end %></nav>

  <% if @tab == "overview" %><div class="deal-overview-grid"><section class="deal-focus"><p class="section-kicker">Move this deal</p><h2><%= @progress.action_label %></h2><p><%= @progress.signal %>. Rubusoo selected this as the single action most likely to move the deal forward.</p><%= link_to @progress.action_label, deal_action_path(@deal, @progress), class: "button button--primary" %></section><section class="deal-facts"><h2>Commercial snapshot</h2><dl><div><dt>Buyer</dt><dd><%= @deal.customer&.name %></dd></div><div><dt>Items</dt><dd><%= @deal.quote_items.size %></dd></div><div><dt>Currency</dt><dd><%= @deal.currency %></dd></div><div><dt>Valid until</dt><dd><%= @deal.valid_until || "Not set" %></dd></div><div><dt>Deliveries</dt><dd><%= @deliveries.size %> across <%= @deliveries.map(&:channel).uniq.size %> channel(s)</dd></div><div><dt>Acceptance</dt><dd><%= @acceptance ? "#{@acceptance.acceptance_method.humanize} · locked" : "Not recorded" %></dd></div></dl><div class="deal-close-actions"><% if @progress.stage == "closed" %><%= button_to "Reopen Deal", reopen_deal_path(@deal), method: :patch, class: "button button--secondary" %><% else %><%= button_to "Close as won", close_deal_path(@deal), method: :patch, params: { outcome: "won" }, class: "button button--secondary" %><%= button_to "Close as lost", close_deal_path(@deal), method: :patch, params: { outcome: "lost" }, class: "button button--ghost" %><% end %></div></section><section class="deal-timeline"><header><h2>Recent timeline</h2><span>All activity stays with this deal</span></header><ol><% @activities.first(8).each do |activity| %><li><i></i><div><strong><%= activity.kind.humanize %></strong><span><%= activity.metadata["channel"]&.humanize || activity.metadata["label"] || @deal.customer&.name %></span></div><time><%= time_ago_in_words(activity.created_at) %> ago</time></li><% end %><% if @activities.empty? %><li><i></i><div><strong>Deal created</strong><span>Working quote started</span></div><time><%= time_ago_in_words(@deal.created_at) %> ago</time></li><% end %></ol></section></div>
  <% elsif @tab == "quote" %><section class="deal-tab-panel deal-quote-panel"><div><p class="section-kicker">Working draft</p><h2>Build once. Deliver through any channel.</h2><p>The Working draft stays internal. Publishing freezes a Version; Buyer Room, PDF, Excel and external delivery all point to the same snapshot.</p></div><div><%= link_to "Continue in Quote Studio", edit_quote_path(@deal), class: "button button--primary" %><%= link_to "Deliver current Version", deliver_deal_path(@deal, version_id: @versions.first.id), class: "button button--secondary" if @versions.any? %></div></section>
  <% elsif @tab == "conversation" %>
    <section class="conversation-stream">
      <header><p class="section-kicker">Buyer conversation</p><h2>Questions and change requests, with context.</h2></header>
      <div class="conversation-toolbar"><%= link_to "Add buyer response", new_response_deal_path(@deal, version_id: @versions.first&.id), class: "button button--secondary" if @versions.any? %><%= link_to "Record acceptance", new_acceptance_deal_path(@deal, version_id: @versions.first&.id), class: "button button--primary" if @versions.any? && !@acceptance %></div>
      <% @responses.each do |message| %><article class="channel-response"><div><span><%= message.kind.humanize %> · <%= message.source.humanize %></span><strong><%= message.buyer_name.presence || @deal.customer&.name %></strong><time><%= time_ago_in_words(message.received_at) %> ago</time></div><p><%= message.body.presence || "File received for review" %></p><aside><span>Version <%= message.quote_revision.number %></span><strong><%= message.status.humanize %></strong><small><%= message.context_type.humanize %><%= " · #{message.context_key}" if message.context_key.present? %></small></aside></article><% end %>
      <% (@questions.to_a + @requests.to_a).sort_by(&:created_at).reverse.each do |message| %>
        <article>
          <div><span><%= message.is_a?(BuyerQuestion) ? "Question · #{message.context_key.presence || 'Quote'}" : "Change request" %></span><strong><%= message.buyer_name.presence || message.buyer_email %></strong><time><%= time_ago_in_words(message.created_at) %> ago</time></div>
          <p><%= message.respond_to?(:body) ? message.body : message.message %></p>
          <% if message.is_a?(BuyerQuestion) && message.seller_reply.present? %>
            <blockquote><span>Seller reply</span><%= message.seller_reply %></blockquote>
          <% elsif message.is_a?(BuyerQuestion) %>
            <%= form_with scope: :buyer_question, url: reply_question_deal_path(@deal, question_id: message.id), method: :patch, class: "conversation-reply" do |form| %>
              <%= form.text_area :seller_reply, placeholder: "Reply with the product and option context preserved", required: true, rows: 3 %>
              <%= form.submit "Reply", class: "button button--primary" %>
            <% end %>
          <% end %>
        </article>
      <% end %>
      <% if @questions.empty? && @requests.empty? && @responses.empty? %><div class="deal-zero"><h2>No buyer responses yet.</h2><p>Buyer Room questions, email, returned files, PO and external messages appear in one Conversation.</p></div><% end %>
    </section>
  <% elsif @tab == "versions" %><section class="versions-list"><header><p class="section-kicker">Published versions</p><h2>Frozen content and every delivery channel.</h2></header><% @versions.each do |version| %><article><span>Version <%= version.number %></span><div><strong><%= version.status == "current" ? "Current published Version" : version.status.humanize %></strong><small>Published <%= time_ago_in_words(version.published_at || version.created_at) %> ago · <%= pluralize(version.version_deliveries.size, "delivery") %></small><% version.version_deliveries.order(delivered_at: :desc).each do |delivery| %><small><%= delivery.channel.humanize %> · <%= delivery.status.humanize %> · <%= delivery.view_status_label %></small><% end %></div><strong><%= version.currency %> <%= number_with_delimiter(version.total) %></strong><%= link_to(version.number == @versions.first.number && @versions.second ? "Compare changes" : "View", quote_revision_path(version), class: "deal-next") %></article><% end %></section>
  <% else %><section class="documents-grid"><header><p class="section-kicker">Deal documents</p><h2>Outputs generated from immutable snapshots.</h2></header><article><span>Published quotation</span><strong><%= deal_version_label(@deal) %></strong><%= link_to "Deliver / export", deliver_deal_path(@deal, version_id: @versions.first&.id), class: "deal-next" if @versions.any? %></article><% @final_documents.each do |document| %><article><span><%= document.document_type.humanize %></span><strong><%= document.number %> · <%= document.status.humanize %></strong><%= button_to "Mark sent", mark_sent_final_document_path(document), method: :patch, class: "button button--secondary" unless document.sent_at? %></article><% end %><% if @acceptance %><article class="is-action"><span>Generate final document</span><strong>Optional, based on Acceptance snapshot</strong><%= form_with url: final_documents_path, class: "final-document-form" do |form| %><%= hidden_field_tag :quote_acceptance_id, @acceptance.id %><%= select_tag :document_type, options_for_select(FinalDocument::TYPES.map { |type| [type.humanize, type] }, current_user.company.default_final_document_type), class: "app-ui-input" %><%= text_field_tag :custom_title, nil, class: "app-ui-input", placeholder: "Custom title if selected" %><%= form.submit "Generate", class: "button button--primary" %><% end %></article><% end %></section><% end %>
</main>
