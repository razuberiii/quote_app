<style>
  .commercial-pdf{font-family:Arial,sans-serif;color:#17211c;background:#fff;font-size:10pt}.commercial-pdf>header{display:grid;grid-template-columns:1fr 62mm;gap:16mm;padding:4mm 0 9mm;border-bottom:2px solid #183f32}.commercial-pdf__brand{margin:0 0 12mm;color:#a4542d;font-size:9pt;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.commercial-pdf h1{margin:0 0 2mm;font:700 27pt/1.05 Georgia,serif}.commercial-pdf h2{margin:0 0 4mm;font:700 13pt Georgia,serif}.commercial-pdf p{line-height:1.5}.commercial-pdf dl{margin:0}.commercial-pdf>header dl{display:grid;grid-template-columns:24mm 1fr;gap:1.5mm 3mm}.commercial-pdf dt{color:#657269;font-size:8pt;text-transform:uppercase;letter-spacing:.07em}.commercial-pdf dd{margin:0;font-weight:700}.commercial-pdf__intro{padding:8mm 0 6mm;max-width:130mm}.commercial-pdf table{width:100%;border-collapse:collapse;table-layout:fixed}.commercial-pdf th{padding:3mm 2mm;border-bottom:1px solid #9aa79f;color:#657269;font-size:7.5pt;text-align:left;text-transform:uppercase}.commercial-pdf td{padding:4mm 2mm;border-bottom:1px solid #dfe4e0;vertical-align:top;overflow-wrap:anywhere}.commercial-pdf td small,.commercial-pdf td strong{display:block}.commercial-pdf th:nth-child(1){width:24%}.commercial-pdf th:nth-child(2){width:34%}.commercial-pdf th:nth-child(3){width:11%}.commercial-pdf th:nth-child(4),.commercial-pdf th:nth-child(5){width:15.5%;text-align:right}.commercial-pdf td:nth-child(4),.commercial-pdf td:nth-child(5){text-align:right}.commercial-pdf__bottom{display:grid;grid-template-columns:1fr 70mm;gap:15mm;margin-top:9mm;break-inside:avoid}.commercial-pdf__bottom>div:first-child dl{display:grid;grid-template-columns:25mm 1fr;gap:2mm}.commercial-pdf__total{padding:6mm;background:#f1eee7}.commercial-pdf__total span,.commercial-pdf__total small{display:block}.commercial-pdf__total strong{display:block;margin:3mm 0;font:700 19pt Georgia,serif}.commercial-pdf>footer{display:flex;justify-content:space-between;margin-top:13mm;padding-top:4mm;border-top:1px solid #cfd6d1;color:#657269;font-size:8pt}
</style>
<% company = { "name" => @revision.company.name, "email" => @revision.company.email, "phone" => @revision.company.phone }; customer = { "name" => @snapshot["customer_name"] }; items = Array(@snapshot["quote_items"]) %>
<article class="commercial-pdf commercial-pdf--modern">
  <header><div><p class="commercial-pdf__brand"><%= company["name"] %></p><h1>Commercial quotation</h1><p>Prepared for <strong><%= customer["company_name"].presence || customer["name"] %></strong></p></div><dl><dt>Quote</dt><dd><%= @revision.quote.quote_no %></dd><dt>Revision</dt><dd><%= @revision.number %></dd><dt>Issued</dt><dd><%= @revision.sent_at&.to_date %></dd><dt>Valid until</dt><dd><%= @revision.expires_at&.to_date %></dd></dl></header>
  <section class="commercial-pdf__intro"><p>Thank you for the opportunity to prepare this proposal. The equipment, commercial scope and delivery basis below reflect the confirmed inquiry.</p></section>
  <section><h2>Equipment & scope</h2><table><thead><tr><th>Product</th><th>Specification</th><th>Qty</th><th>Unit price</th><th>Amount</th></tr></thead><tbody><% items.each do |item| %><tr><td><strong><%= item["product_name"].presence || item["description"] %></strong><small><%= item["sku_snapshot"] %></small></td><td><%= Array(item["specifications"]).map { |spec| "#{spec['key'] || spec['name']}: #{spec['value']}" }.join(" · ").presence || item["description"] %></td><td><%= item["quantity"] %> <%= item["unit_snapshot"] %></td><td><%= @revision.currency %> <%= number_with_delimiter(item["unit_price"].to_d, delimiter: ",") %></td><td><strong><%= @revision.currency %> <%= number_with_delimiter(item["unit_price"].to_d * item["quantity"].to_d, delimiter: ",") %></strong></td></tr><% end %></tbody></table></section>
  <section class="commercial-pdf__bottom"><div><h2>Commercial terms</h2><dl><dt>Incoterm</dt><dd><%= @snapshot["trade_term"].presence || "As agreed" %></dd><dt>Payment</dt><dd><%= @snapshot["payment_term"].presence || "As agreed" %></dd><dt>Delivery</dt><dd><%= @snapshot["delivery_notes"].presence || "As agreed" %></dd></dl></div><div class="commercial-pdf__total"><span>Total</span><strong><%= @revision.currency %> <%= number_with_delimiter(@revision.total, delimiter: ",") %></strong><small>Revision <%= @revision.number %> · subject to the terms above</small></div></section>
  <footer><strong><%= company["name"] %></strong><span><%= company["email"] %> · <%= company["phone"] %></span></footer>
</article>
