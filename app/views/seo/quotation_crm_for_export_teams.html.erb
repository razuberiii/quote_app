<section class="app-page-shell marketing-page-shell">
  <%= render "components/ui/card", class: "app-surface marketing-hero-shell marketing-hero-shell--crm" do %>
    <div class="grid gap-8 lg:grid-cols-[minmax(0,0.94fr)_minmax(0,1.06fr)] lg:items-start">
      <div class="marketing-section-heading">
        <p class="marketing-section-kicker"><%= t("seo.view.quotation_crm_for_export_teams.hero.kicker") %></p>
        <h1 class="marketing-section-title max-w-none"><%= t("seo.view.quotation_crm_for_export_teams.hero.title") %></h1>
        <p class="marketing-section-body">
          <%= t("seo.view.quotation_crm_for_export_teams.hero.body") %>
        </p>
        <div class="flex flex-wrap gap-3">
          <%= render "components/ui/button", href: demo_path, variant: :primary do %>
            <%= t("seo.view.quotation_crm_for_export_teams.hero.cta_demo") %>
          <% end %>
        </div>
      </div>

      <article class="marketing-static-timeline marketing-static-timeline--spotlight">
        <p class="marketing-section-kicker"><%= t("seo.view.quotation_crm_for_export_teams.signals.timeline.label") %></p>
        <div class="marketing-static-timeline__lede">
          <p class="marketing-static-timeline__lead-copy"><%= t("seo.view.quotation_crm_for_export_teams.signals.timeline.body") %></p>
        </div>
        <div class="marketing-static-timeline__items">
          <div class="marketing-static-timeline__item">
            <p class="app-subtle-note"><%= t("seo.view.quotation_crm_for_export_teams.signals.activity.body") %></p>
          </div>
          <div class="marketing-static-timeline__item is-accented">
            <p class="app-stat-label"><%= t("seo.view.quotation_crm_for_export_teams.signals.execution.label") %></p>
            <p class="app-subtle-note mt-2"><%= t("seo.view.quotation_crm_for_export_teams.signals.execution.body") %></p>
          </div>
        </div>
      </article>
    </div>
  <% end %>

  <section class="marketing-editorial-band marketing-editorial-band--notes">
    <article class="marketing-annotation-block">
      <h2 class="text-2xl font-semibold tracking-tight text-slate-950"><%= t("seo.view.quotation_crm_for_export_teams.fit.connected.title") %></h2>
      <p class="app-section-caption mt-2"><%= t("seo.view.quotation_crm_for_export_teams.fit.connected.body") %></p>
    </article>
    <article class="marketing-annotation-block">
      <h2 class="text-2xl font-semibold tracking-tight text-slate-950"><%= t("seo.view.quotation_crm_for_export_teams.fit.outcome.title") %></h2>
      <p class="app-section-caption mt-2"><%= t("seo.view.quotation_crm_for_export_teams.fit.outcome.body") %></p>
    </article>
  </section>

  <%= render "seo/continue_reading",
    related_topics: [
      { label: t("seo.view.shared.links.foreign_trade_quotation_software"), path: foreign_trade_quotation_software_path },
      { label: t("seo.view.shared.links.quote_revision_control"), path: quote_revision_control_path }
    ],
    comparison_link: { label: t("seo.view.shared.links.quotation_software_vs_erp"), path: quotation_software_vs_erp_path },
    cta: { label: t("seo.view.shared.links.open_demo_workspace"), path: demo_path } %>
</section>

