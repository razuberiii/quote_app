<% watermark_text = template_watermark_text(@template, @share.company.name) %>
<% watermark_image_url = template_watermark_image_url(@template) %>
<% web_watermark_opacity = [[template_watermark_opacity(@template).to_f * 0.6, 0.05].max, 0.1].min %>
<% quote = @share.quote %>
<% quote_deleted = quote.respond_to?(:deleted?) && quote.deleted? %>
<% quote_reopened = quote.status.to_s == "draft" && quote.reopened_at.present? %>
<% seller_signature_image_url = @snapshot["seller_signature_image_url"].to_s.presence || quote_seller_signature_image_url(quote) %>
<% seller_stamp_image_url = @snapshot["seller_stamp_image_url"].to_s.presence || quote_seller_stamp_image_url(quote) %>
<% decision_state =
    if quote.accepted_at.present?
      "accepted"
    elsif quote.changes_requested_at.present?
      "changes_requested"
    elsif !quote_reopened && quote.latest_revision_for_quote_no? && %w[sent viewed negotiating].include?(quote.status.to_s)
      "active"
    else
      "inactive"
    end %>
<% revision_reason_options = [
     [ "price adjustment", "Price adjustment" ],
     [ "specification change", "Specification change" ],
     [ "delivery terms", "Delivery terms" ],
     [ "other", "Other" ]
   ] %>
<% show_public_actions = !@preview_mode && !quote.pi_document? && decision_state == "active" %>

<article class="public-quote-canvas"
         style="--doc-accent: <%= @template.accent_color %>; --doc-on-accent: <%= contrast_text_color(@template.accent_color) %>; --doc-font: '<%= @template.font_family %>'; --quote-watermark-opacity: <%= web_watermark_opacity %>;">
  <%= render "public/quote_shares/document_body",
             quote: quote,
             template: @template,
             document_kind: @document_kind,
             watermark_text: watermark_text,
             watermark_image_url: watermark_image_url,
             snapshot: @snapshot,
             preview_mode: @preview_mode,
             show_public_actions: show_public_actions,
             decision_state: decision_state,
             status_message: @status_message,
             has_newer_revision: @has_newer_revision,
             latest_share_url: @latest_share_url,
             share: @share,
             revision_reason_options: revision_reason_options,
             quote_deleted: quote_deleted,
             quote_reopened: quote_reopened,
             seller_signature_image_url: seller_signature_image_url,
             seller_stamp_image_url: seller_stamp_image_url %>
</article>

<script>
  (() => {
    const bindModal = (openSelector, modalSelector, closeSelector, focusSelector) => {
      const openButtons = Array.from(document.querySelectorAll(openSelector));
      const modal = document.querySelector(modalSelector);
      if (!openButtons.length || !modal) return;
      const closeButtons = Array.from(modal.querySelectorAll(closeSelector));

      const closeModal = () => {
        modal.classList.remove("is-open");
        window.setTimeout(() => { modal.hidden = true; }, 180);
      };

      openButtons.forEach((button) => {
        if (button.dataset.bound === "true") return;
        button.dataset.bound = "true";
        button.addEventListener("click", () => {
          modal.hidden = false;
          window.requestAnimationFrame(() => modal.classList.add("is-open"));
          const focusTarget = modal.querySelector(focusSelector);
          if (focusTarget) focusTarget.focus();
        });
      });

      closeButtons.forEach((button) => button.addEventListener("click", closeModal));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !modal.hidden) closeModal();
      });
    };

    bindModal(".js-open-revision-request", ".js-revision-modal", ".js-close-revision-request", "textarea");
    bindModal(".js-open-accept-request", ".js-accept-modal", ".js-close-accept-request", "button[type='submit']");
  })();
</script>

<% unless @preview_mode %>
<script>
  (() => {
    const quoteShareId = <%= raw @share.token.to_json %>;
    const apiEndpoint = <%= raw public_quote_view_events_path.to_json %>;
    if (!quoteShareId || !apiEndpoint) return;

    const startTime = Date.now();
    let sent = false;

    const sendDuration = () => {
      if (sent) return;

      const duration = Date.now() - startTime;
      if (duration < 1000) return;

      sent = true;
      const payload = JSON.stringify({
        quote_share_id: quoteShareId,
        duration_ms: duration
      });

      if (navigator.sendBeacon) {
        const ok = navigator.sendBeacon(apiEndpoint, new Blob([payload], { type: "application/json" }));
        if (ok) return;
      }

      fetch(apiEndpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: payload,
        keepalive: true
      }).catch(() => {});
    };

    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "hidden") sendDuration();
    });
    window.addEventListener("pagehide", sendDuration);
    window.addEventListener("beforeunload", sendDuration);
  })();
</script>
<% end %>
