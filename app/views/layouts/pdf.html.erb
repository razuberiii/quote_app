<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <style>
      <%= File.read(Rails.root.join("app/assets/stylesheets/style.css")) %>

      html, body {
        background: #ffffff !important;
      }

      body {
        margin: 0;
        padding: 0;
        color: #111827;
        font-family: "Noto Sans CJK SC", "Noto Sans CJK JP", "Noto Sans CJK TC", "Noto Sans", "PingFang SC", "Microsoft YaHei", sans-serif;
      }

      .public-quote-main {
        max-width: 100% !important;
        margin: 0 !important;
      }

      .quote-document {
        box-shadow: none !important;
      }
    </style>
  </head>
  <body class="public-quote-body">
    <main class="public-quote-main">
      <%= yield %>
    </main>
  </body>
</html>
