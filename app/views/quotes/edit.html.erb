<h1>
  Edit Quote <%= @quote.quote_no %> (V<%= @quote.revision_number %>)
  <span class="status-badge status-<%= (@quote.status.presence || "draft") %>"><%= (@quote.status.presence || "draft").capitalize %></span>
</h1>

<%= render "form", quote: @quote, form_model: @quote %>

<%= link_to "Back to Quote", @quote, class: "form-page-back-link" %>
