<% content_for :meta_robots, "noindex,follow" %>

<section class="auth-page">
  <div class="auth-card">
    <h1><%= t("users.sessions.view.new.title") %></h1>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div>
        <%= f.label :email, t("users.sessions.view.new.email") %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
      </div>

      <div>
        <%= f.label :password, t("users.sessions.view.new.password") %>
        <%= f.password_field :password, autocomplete: "current-password" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="auth-remember">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me, t("users.sessions.view.new.remember_me") %>
        </div>
      <% end %>

      <div>
        <%= f.submit t("users.sessions.view.new.submit"), class: "btn btn-primary" %>
      </div>
    <% end %>

    <div class="auth-links">
      <% if devise_mapping.registerable? %>
        <%= link_to t("users.sessions.view.new.sign_up"), new_registration_path(resource_name) %>
      <% end %>
    </div>
  </div>
</section>
