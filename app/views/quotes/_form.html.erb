            <%= text_field_tag "quote[container_loading_block][headers][container_type]", container_loading_headers[:container_type], maxlength: Quote::MAX_CONTAINER_LOADING_HEADER_LENGTH, class: ui_input_classes("js-container-loading-header-type"), placeholder: t("quotes.view.form.container_loading_type_placeholder", default: "Container Type") %>
            <%= text_field_tag "quote[container_loading_block][headers][capacity]", container_loading_headers[:capacity], maxlength: Quote::MAX_CONTAINER_LOADING_HEADER_LENGTH, class: ui_input_classes("js-container-loading-header-capacity"), placeholder: t("quotes.view.form.container_loading_capacity_placeholder", default: "Capacity") %>
