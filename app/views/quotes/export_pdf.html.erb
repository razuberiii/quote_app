<% raw_document_kind = @document_kind || params[:document_kind] || params[:doc] || params[:kind] %>
<% document_kind = @template.normalize_document_kind(raw_document_kind || @template.default_document_kind) %>
<% spec_label = @quote.resolved_spec_label %>
<% addon_label = @quote.resolved_addon_label %>
<% watermark_text = template_watermark_text(@template, @quote.company.name) %>
<% watermark_image_url = quote_watermark_data_uri || template_watermark_image_url(@template) %>
<% template_watermark_alpha = template_watermark_opacity(@template).to_f %>
<% pdf_watermark_opacity = [[template_watermark_alpha * 0.16, 0.012].max, 0.035].min %>
<% pdf_items = @quote.quote_items.ordered.to_a %>
<% seller_signature_image_url = quote_seller_signature_data_uri(@quote) || quote_seller_signature_image_url(@quote) %>
<% seller_stamp_image_url = quote_seller_stamp_data_uri(@quote) || quote_seller_stamp_image_url(@quote) %>
<% document_number_value = quote_document_number_value(@quote, document_kind) %>
<% show_watermark = watermark_text.present? || watermark_image_url.present? %>

<% logo_uri = quote_logo_data_uri if @template.show_logo %>
<% issued_on_text = @quote.issued_on&.strftime("%Y-%m-%d").to_s.strip %>
<% valid_until_text = @quote.valid_until&.strftime("%Y-%m-%d").to_s.strip %>
<% number_label = @template.resolved_document_number_label(document_kind) %>
<% sales_owner_text = if @template.show_customer_owner && Customer.internal_owner_enabled? && @quote.customer.internal_owner_display_name != "-"
  @quote.customer.internal_owner_display_name.to_s.strip
end %>

<% company_name = @quote.company.name.to_s.strip %>
<% company_line = @quote.company.address.to_s.squish.presence || "" %>
<% company_contact_line = [@quote.company.phone, @quote.company.email, @quote.company.website].map { |v| v.to_s.squish.presence }.compact.join(" | ") %>
<% buyer_name = @quote.customer.name.to_s.strip %>
<% buyer_contact = @quote.customer.contact_name.to_s.strip %>
<% buyer_phone = @quote.customer.formatted_phone.to_s.strip %>
<% buyer_email = @quote.customer.email.to_s.strip %>

<% advanced_trade_terms = @quote.advanced_trade_terms_data %>
<% advanced_logistics = @quote.advanced_logistics_data %>
<% commercial_summary_rows = quote_commercial_summary_rows(advanced_trade_terms) %>
<% logistics_summary_rows = quote_logistics_summary_rows(advanced_logistics) %>
<% container_loading_block = @quote.container_loading_block_data %>
<% container_loading_rows = quote_container_loading_rows(container_loading_block) %>
<% configuration_block = @quote.configuration_block_data %>
<% configuration_rows = quote_configuration_block_rows(configuration_block) %>
<% detail_pictures_block = @quote.detail_pictures_block_data %>
<% detail_picture_items = quote_detail_picture_items(detail_pictures_block) %>
<% main_item_blob_ids = quote_pdf_primary_item_image_blob_ids(pdf_items) %>
<% detail_picture_cards = quote_pdf_filtered_detail_picture_cards(detail_picture_items, main_item_blob_ids: main_item_blob_ids, inline_for_pdf: true) %>
<% detail_picture_rows = detail_picture_cards.each_slice(2).to_a %>

<% show_trade_terms = @quote.advanced_section_enabled?("show_trade_terms_advanced", template: @template) && commercial_summary_rows.any? %>
<% show_configuration = @quote.advanced_mode && configuration_rows.any? %>
<% show_shipping = @quote.advanced_section_enabled?("show_logistics_block", template: @template) && logistics_summary_rows.any? %>
<% show_container_loading = @quote.advanced_section_enabled?("show_logistics_block", template: @template) && ActiveModel::Type::Boolean.new.cast(container_loading_block["enabled"]) && container_loading_rows.any? %>
<% show_detail_pictures = @quote.advanced_mode && ActiveModel::Type::Boolean.new.cast(detail_pictures_block["enabled"]) && detail_picture_cards.any? %>

<% scope_text = @quote.scope_of_supply.to_s.strip %>
<% scope_nodes = quote_scope_list_nodes(scope_text) %>
<% show_scope_of_supply = document_kind != "pi" && @template.show_scope_of_supply && scope_nodes.any? %>

<% formal_closing_block = @quote.formal_closing_block_data %>
<% formal_trade_term = formal_closing_block["trade_term"].presence || @quote.trade_term %>
<% formal_payment_term = formal_closing_block["payment_term"].presence || @quote.payment_term %>
<% formal_delivery = formal_closing_block["delivery_time"].presence || @quote.delivery_notes %>
<% formal_remittance_note = formal_closing_block["remittance_note"].to_s.squish.presence %>
<% bank_route = formal_closing_block["bank_route"].to_s.squish.presence %>
<% beneficiary_details = formal_closing_block["beneficiary_details"].to_s.squish.presence %>
<% closing_term_rows = [] %>
<% closing_term_rows << { label: "Trade Terms", value: formal_trade_term } if formal_trade_term.present? %>
<% closing_term_rows << { label: "Payment Terms", value: formal_payment_term } if formal_payment_term.present? %>
<% closing_term_rows << { label: "Delivery", value: formal_delivery } if formal_delivery.present? %>
<% closing_term_rows << { label: "Remittance Note", value: formal_remittance_note } if formal_remittance_note.present? %>
<% seller_signature_enabled = ActiveModel::Type::Boolean.new.cast(formal_closing_block["seller_signature_enabled"] || formal_closing_block[:seller_signature_enabled]) || seller_signature_image_url.present? %>
<% seller_stamp_enabled = ActiveModel::Type::Boolean.new.cast(formal_closing_block["seller_stamp_enabled"] || formal_closing_block[:seller_stamp_enabled]) || seller_stamp_image_url.present? %>
<% buyer_signature_enabled = ActiveModel::Type::Boolean.new.cast(formal_closing_block["buyer_signature_line_enabled"] || formal_closing_block[:buyer_signature_line_enabled]) %>
<% show_signature_section = seller_signature_enabled || seller_stamp_enabled || buyer_signature_enabled %>
<% show_formal_closing = closing_term_rows.any? || bank_route.present? || beneficiary_details.present? || show_signature_section %>

<% commercial_fields = [] %>
<% commercial_fields << { label: "Trade Terms", value: @quote.trade_term.to_s.squish } if @quote.trade_term.to_s.squish.present? %>
<% commercial_fields << { label: "Payment Terms", value: @quote.payment_term.to_s.squish } if @quote.payment_term.to_s.squish.present? %>
<% validity_value = valid_until_text.presence || advanced_trade_terms["validity_clause_note"].to_s.squish.presence %>
<% commercial_fields << { label: "Validity", value: validity_value } if validity_value.present? %>
<% commercial_fields = commercial_fields.first(3) %>

<% show_annex = show_trade_terms || show_configuration || show_shipping || show_container_loading || show_scope_of_supply || show_detail_pictures || show_formal_closing %>
<% terminal_closing = show_annex && show_formal_closing %>

<article class="quote-document quote-document--formal-pdf<%= ' quote-document--terminal-closing' if terminal_closing %>">
  <% if show_watermark %>
    <div class="pdf-page-watermark-layer" aria-hidden="true" style="opacity:<%= format('%.4f', pdf_watermark_opacity) %>;">
      <% if watermark_image_url.present? %>
        <img src="<%= watermark_image_url %>" alt="" class="pdf-page-watermark-image">
      <% elsif watermark_text.present? %>
        <div class="pdf-page-watermark-text"><%= watermark_text %></div>
      <% end %>
    </div>
  <% end %>

  <section class="pdf-first-page">
    <header class="pdf-header-block">
      <table class="pdf-header-table">
        <tr>
          <td class="pdf-header-company">
            <% if logo_uri.present? %>
              <div class="pdf-company-logo-wrap">
                <img src="<%= logo_uri %>" class="pdf-company-logo" alt="Company logo">
              </div>
            <% end %>
            <h1 class="pdf-company-name"><%= company_name.upcase %></h1>
            <% if company_line.present? %><p class="pdf-company-line"><%= company_line %></p><% end %>
            <% if company_contact_line.present? %><p class="pdf-company-line"><%= company_contact_line %></p><% end %>
          </td>
          <td class="pdf-header-meta">
            <table class="pdf-meta-table">
              <tr><td colspan="2" class="pdf-meta-document-title">QUOTATION</td></tr>
              <tr><th>Quote #</th><td><%= document_number_value %></td></tr>
              <% if issued_on_text.present? %><tr><th>Date</th><td><%= issued_on_text %></td></tr><% end %>
              <% if @template.show_currency %><tr><th>Currency</th><td><%= @quote.currency %></td></tr><% end %>
              <% if sales_owner_text.present? %><tr><th>Sales Owner</th><td><%= sales_owner_text %></td></tr><% end %>
              <% if @quote.status.present? %><tr><th>Status</th><td><%= @quote.status.to_s.humanize %></td></tr><% end %>
            </table>
          </td>
        </tr>
      </table>
    </header>

    <section class="pdf-buyer-block">
      <div class="pdf-light-heading">BUYER</div>
      <div class="pdf-light-rule"></div>
      <div class="pdf-light-body">
        <% if buyer_name.present? %><p><strong><%= buyer_name %></strong></p><% end %>
        <% if buyer_contact.present? %><p>Contact: <%= buyer_contact %></p><% end %>
        <% if buyer_phone.present? %><p>Phone: <%= buyer_phone %></p><% end %>
        <% if buyer_email.present? %><p>Email: <%= buyer_email %></p><% end %>
      </div>
    </section>

    <section class="pdf-main-items">
      <table class="quote-items-table quote-doc-table pdf-items-table">
        <colgroup>
          <col style="width: 4.5%;">
          <col style="width: 59.5%;">
          <col style="width: 8%;">
          <col style="width: 14%;">
          <col style="width: 14%;">
        </colgroup>
        <thead>
          <tr>
            <th>No.</th>
            <th>Item Details</th>
            <th>Qty</th>
            <th>Unit Price</th>
            <th>Amount</th>
          </tr>
        </thead>
        <tbody>
          <% pdf_items.each_with_index do |item, idx| %>
            <% item_name = item.product&.name.presence || item.description.presence || "Item" %>
            <% item_model_text = item.description.to_s.squish %>
            <% show_item_model = item_model_text.present? && item_model_text != item_name.to_s.squish %>
            <% spec_rows = item.specification_pairs %>
            <% addon_rows = item.addon_charge_entries %>
            <% is_charge_row = item.respond_to?(:fee_item?) ? item.fee_item? : item.item_type.to_s.start_with?("fee_") %>
            <% has_item_image = !is_charge_row && item.effective_image_attachment.present? %>
            <% item_data_uri = quote_item_image_data_uri(item) %>
            <tr class="<%= is_charge_row ? 'pdf-row--charge' : 'pdf-row--product' %>">
              <td class="pdf-col-no"><%= idx + 1 %></td>
              <td class="pdf-col-desc">
                <% if has_item_image && item_data_uri.present? %>
                  <table class="pdf-item-details-layout"><tr>
                    <td class="pdf-item-details-image-cell">
                      <span class="pdf-item-thumb-box">
                        <img src="<%= item_data_uri %>" class="quote-item-image pdf-item-thumb" alt="Item image">
                      </span>
                    </td>
                    <td class="pdf-item-details-text-cell">
                      <div class="pdf-item-name"><%= item_name %></div>
                      <% if show_item_model %><div class="pdf-item-model"><%= item_model_text %></div><% end %>
                      <% if spec_rows.any? %>
                        <div class="pdf-item-subtitle"><%= spec_label %>:</div>
                        <ul class="pdf-item-list">
                          <% spec_rows.each do |row| %><li><%= row[:key] %> - <%= row[:value] %></li><% end %>
                        </ul>
                      <% end %>
                      <% if addon_rows.any? %>
                        <div class="pdf-item-subtitle"><%= addon_label %>:</div>
                        <ul class="pdf-item-list">
                          <% addon_rows.each do |row| %>
                            <li><%= row[:name] %> (<%= template_money(row[:amount], @quote.currency, @template, show_currency: @template.show_currency) %>)</li>
                          <% end %>
                        </ul>
                      <% end %>
                    </td>
                  </tr></table>
                <% else %>
                  <div class="pdf-item-name"><%= item_name %></div>
                  <% if show_item_model %><div class="pdf-item-model"><%= item_model_text %></div><% end %>
                  <% if spec_rows.any? %>
                    <div class="pdf-item-subtitle"><%= spec_label %>:</div>
                    <ul class="pdf-item-list">
                      <% spec_rows.each do |row| %><li><%= row[:key] %> - <%= row[:value] %></li><% end %>
                    </ul>
                  <% end %>
                  <% if addon_rows.any? %>
                    <div class="pdf-item-subtitle"><%= addon_label %>:</div>
                    <ul class="pdf-item-list">
                      <% addon_rows.each do |row| %>
                        <li><%= row[:name] %> (<%= template_money(row[:amount], @quote.currency, @template, show_currency: @template.show_currency) %>)</li>
                      <% end %>
                    </ul>
                  <% end %>
                <% end %>
              </td>
              <td class="pdf-col-qty"><%= item.quantity %></td>
              <td class="pdf-col-money"><%= template_money(item.unit_price, @quote.currency, @template, show_currency: @template.show_currency) %></td>
              <td class="pdf-col-money"><%= template_money(item.line_total, @quote.currency, @template, show_currency: @template.show_currency) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <section class="pdf-bottom-band">
        <table class="pdf-bottom-band-table">
          <colgroup><col style="width:56%;"><col style="width:44%;"></colgroup>
          <tr>
            <td class="pdf-bottom-band-left">
              <table class="pdf-bottom-terms-table">
                <tbody>
                  <% commercial_fields.each do |row| %>
                    <tr>
                      <th><%= row[:label] %></th>
                      <td><%= row[:value] %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </td>
            <td class="pdf-bottom-band-right">
              <div class="pdf-totals-wrap">
                <table class="quote-total-box pdf-total-table">
                  <tr><th>Subtotal</th><td><%= template_money(@quote.subtotal, @quote.currency, @template, show_currency: @template.show_currency) %></td></tr>
                  <% if @template.show_tax %><tr><th>Tax / VAT</th><td><%= template_money(@quote.tax_amount, @quote.currency, @template, show_currency: @template.show_currency) %></td></tr><% end %>
                  <% if @template.show_shipping %><tr><th>Shipping</th><td><%= template_money(@quote.shipping_amount, @quote.currency, @template, show_currency: @template.show_currency) %></td></tr><% end %>
                  <tr class="pdf-total-grand-row"><th class="pdf-total-grand-label">Grand Total</th><td class="pdf-total-grand-value"><strong><%= template_money(@quote.grand_total, @quote.currency, @template, show_currency: @template.show_currency) %></strong></td></tr>
                </table>
              </div>
            </td>
          </tr>
        </table>
      </section>
    </section>
  </section>

  <% if show_annex %>
    <section class="pdf-annex-flow">
      <% if show_trade_terms %>
        <section class="pdf-annex-section">
          <h3 class="pdf-section-heading">TRADE TERMS</h3>
          <div class="pdf-section-divider"></div>
          <div class="pdf-section-body pdf-section-body--kv">
            <table class="pdf-kv-table"><tbody><% commercial_summary_rows.each do |row| %><tr><th><%= row[:label] %></th><td><%= row[:value] %></td></tr><% end %></tbody></table>
          </div>
        </section>
      <% end %>

      <% if show_configuration %>
        <section class="pdf-annex-section">
          <h3 class="pdf-section-heading">CONFIGURATION</h3>
          <div class="pdf-section-divider"></div>
          <div class="pdf-section-body pdf-section-body--kv">
            <table class="pdf-kv-table"><tbody><% configuration_rows.each do |row| %><tr><th><%= row[:label] %></th><td><%= row[:value] %></td></tr><% end %></tbody></table>
          </div>
        </section>
      <% end %>

      <% if show_shipping %>
        <section class="pdf-annex-section">
          <h3 class="pdf-section-heading">SHIPPING &amp; LOGISTICS</h3>
          <div class="pdf-section-divider"></div>
          <div class="pdf-section-body pdf-section-body--kv">
            <table class="pdf-kv-table"><tbody><% logistics_summary_rows.each do |row| %><tr><th><%= row[:label] %></th><td><%= row[:value] %></td></tr><% end %></tbody></table>
          </div>
        </section>
      <% end %>

      <% if show_container_loading %>
        <section class="pdf-annex-section">
          <h3 class="pdf-section-heading">CONTAINER LOADING</h3>
          <div class="pdf-section-divider"></div>
          <div class="pdf-section-body pdf-section-body--container">
            <table class="quote-mini-table quote-mini-table--container-loading pdf-container-table">
              <thead><tr><th>Variant / Trim</th><th>Container Type</th><th>Load Capacity</th><th>Loading Note</th></tr></thead>
              <tbody>
                <% container_loading_rows.each do |row| %>
                  <tr><td><%= row[:variant].presence || "-" %></td><td><%= row[:container_type].presence || "-" %></td><td class="pdf-container-capacity"><%= row[:capacity].presence || "-" %></td><td><%= row[:note].presence || "-" %></td></tr>
                <% end %>
              </tbody>
            </table>
            <div class="pdf-section-endline"></div>
          </div>
        </section>
      <% end %>

      <% if show_scope_of_supply %>
        <section class="pdf-annex-section">
          <h3 class="pdf-section-heading">SCOPE OF SUPPLY</h3>
          <div class="pdf-section-divider"></div>
          <div class="pdf-section-body pdf-section-body--scope">
            <ul class="quote-scope-list quote-scope-list--pdf pdf-scope-list">
              <% scope_nodes.each do |node| %><li><%= node[:text] %></li><% end %>
            </ul>
            <div class="pdf-section-endline"></div>
          </div>
        </section>
      <% end %>

      <% if show_detail_pictures %>
        <section class="pdf-annex-section pdf-annex-section--detail-pictures">
          <div class="pdf-detail-keep-first">
            <h3 class="pdf-section-heading">DETAIL PICTURES</h3>
            <div class="pdf-section-divider"></div>
            <div class="pdf-section-body pdf-section-body--detail">
              <table class="pdf-detail-table">
                <tbody>
                  <% detail_picture_rows.each_with_index do |pair, row_idx| %>
                    <tr class="pdf-detail-table-row">
                      <% if pair.size == 1 %>
                        <% item = pair.first %>
                        <% single_wide = row_idx == detail_picture_rows.size - 1 && item[:ratio].to_f >= 2.2 %>
                        <td class="pdf-detail-table-cell pdf-detail-table-cell--single" colspan="2">
                          <div class="pdf-detail-figure">
                            <div class="pdf-detail-image-wrap <%= 'is-wide-single' if single_wide %>">
                              <img src="<%= item[:image_src] %>" alt="Detail picture <%= item[:position] %>" class="quote-detail-picture-image pdf-detail-image is-<%= item[:picture_kind] %><%= ' is-wide-single' if single_wide %>">
                            </div>
                            <% if item[:caption].present? %><p class="pdf-detail-caption"><%= item[:caption] %></p><% end %>
                          </div>
                        </td>
                      <% else %>
                        <% pair.each_with_index do |item, i| %>
                          <td class="pdf-detail-table-cell <%= i.zero? ? 'is-left' : 'is-right' %>">
                            <div class="pdf-detail-figure">
                              <div class="pdf-detail-image-wrap">
                                <img src="<%= item[:image_src] %>" alt="Detail picture <%= item[:position] %>" class="quote-detail-picture-image pdf-detail-image is-<%= item[:picture_kind] %>">
                              </div>
                              <% if item[:caption].present? %><p class="pdf-detail-caption"><%= item[:caption] %></p><% end %>
                            </div>
                          </td>
                        <% end %>
                      <% end %>
                    </tr>
                  <% end %>
                </tbody>
              </table>
              <div class="pdf-section-endline pdf-section-endline--detail"></div>
            </div>
          </div>
        </section>
      <% end %>

      <% if show_formal_closing %>
        <section class="pdf-annex-section pdf-annex-section--formal-closing">
          <div class="pdf-annex-keep-first pdf-formal-closing-block<%= ' pdf-formal-closing-block--terminal' if terminal_closing %>">
            <h3 class="pdf-section-heading">FORMAL CLOSING</h3>
            <div class="pdf-section-divider"></div>
            <div class="pdf-section-body pdf-section-body--kv">
              <% if closing_term_rows.any? %>
                <table class="pdf-kv-table"><tbody><% closing_term_rows.each do |row| %><tr><th><%= row[:label] %></th><td><%= row[:value] %></td></tr><% end %></tbody></table>
              <% end %>

              <% if bank_route.present? || beneficiary_details.present? %>
                <div class="pdf-bank-block">
                  <div class="pdf-box-title pdf-bank-title">BANK / BENEFICIARY DETAILS</div>
                  <div class="pdf-box-body pdf-bank-body">
                    <% if bank_route.present? %><p>Bank Route: <%= bank_route %></p><% end %>
                    <% if beneficiary_details.present? %><p>Beneficiary: <%= beneficiary_details %></p><% end %>
                  </div>
                </div>
              <% end %>

              <% if show_signature_section %>
                <div class="pdf-signatures-shell">
                  <table class="pdf-signatures-table">
                    <tr>
                      <td>
                        <% if seller_stamp_enabled %>
                          <div class="pdf-signature-area"><% if seller_stamp_image_url.present? %><img src="<%= seller_stamp_image_url %>" alt="Seller Stamp" class="quote-sales-signature-image"><% end %></div>
                          <div class="pdf-signature-line"></div>
                          <p>Seller Stamp</p>
                        <% else %>
                          <div class="pdf-signature-area"></div>
                        <% end %>
                      </td>
                      <td>
                        <% if seller_signature_enabled %>
                          <div class="pdf-signature-area"><% if seller_signature_image_url.present? %><img src="<%= seller_signature_image_url %>" alt="Sales Signature" class="quote-sales-signature-image"><% end %></div>
                          <div class="pdf-signature-line"></div>
                          <p>Sales Signature</p>
                        <% else %>
                          <div class="pdf-signature-area"></div>
                        <% end %>
                      </td>
                      <td>
                        <% if buyer_signature_enabled %>
                          <div class="pdf-signature-area"></div>
                          <div class="pdf-signature-line"></div>
                          <p>Buyer Signature</p>
                        <% else %>
                          <div class="pdf-signature-area"></div>
                        <% end %>
                      </td>
                    </tr>
                  </table>
                </div>
              <% else %>
                <div class="pdf-section-endline"></div>
              <% end %>
            </div>
          </div>
        </section>
      <% end %>
    </section>
  <% end %>

</article>
