<% end %>

<script>
  const PREVIEW_I18N = <%= {
    "en" => {
      "valid_until"    => I18n.t("quote_document.labels.valid_until",   locale: "en"),
      "sales_owner"    => I18n.t("quote_document.labels.sales_owner",   locale: "en"),
      "subtotal"       => I18n.t("quote_document.labels.subtotal",      locale: "en"),
      "tax_vat"        => I18n.t("quote_document.labels.tax_vat",       locale: "en"),
      "shipping"       => I18n.t("quote_document.labels.shipping",      locale: "en"),
      "grand_total"    => I18n.t("quote_document.labels.grand_total",   locale: "en"),
      "payment_terms"  => I18n.t("quote_document.labels.payment_terms", locale: "en"),
      "notes"          => I18n.t("quote_document.labels.notes",         locale: "en"),
      "scope_of_supply" => I18n.t("quote_templates.defaults.scope_of_supply_label", locale: "en"),
      "doc_title_quote" => I18n.t("quote_document.titles.quotation",    locale: "en"),
      "doc_title_pi"    => I18n.t("quote_document.titles.pi",           locale: "en"),
    },
    "zh-CN" => {
      "valid_until"    => I18n.t("quote_document.labels.valid_until",   locale: :"zh-CN"),
      "sales_owner"    => I18n.t("quote_document.labels.sales_owner",   locale: :"zh-CN"),
      "subtotal"       => I18n.t("quote_document.labels.subtotal",      locale: :"zh-CN"),
      "tax_vat"        => I18n.t("quote_document.labels.tax_vat",       locale: :"zh-CN"),
      "shipping"       => I18n.t("quote_document.labels.shipping",      locale: :"zh-CN"),
      "grand_total"    => I18n.t("quote_document.labels.grand_total",   locale: :"zh-CN"),
      "payment_terms"  => I18n.t("quote_document.labels.payment_terms", locale: :"zh-CN"),
      "notes"          => I18n.t("quote_document.labels.notes",         locale: :"zh-CN"),
      "scope_of_supply" => I18n.t("quote_templates.defaults.scope_of_supply_label", locale: :"zh-CN"),
      "doc_title_quote" => I18n.t("quote_document.titles.quotation",    locale: :"zh-CN"),
      "doc_title_pi"    => I18n.t("quote_document.titles.pi",           locale: :"zh-CN"),
    },
    "es-419" => {
      "valid_until"    => I18n.t("quote_document.labels.valid_until",   locale: :"es-419"),
      "sales_owner"    => I18n.t("quote_document.labels.sales_owner",   locale: :"es-419"),
      "subtotal"       => I18n.t("quote_document.labels.subtotal",      locale: :"es-419"),
      "tax_vat"        => I18n.t("quote_document.labels.tax_vat",       locale: :"es-419"),
      "shipping"       => I18n.t("quote_document.labels.shipping",      locale: :"es-419"),
      "grand_total"    => I18n.t("quote_document.labels.grand_total",   locale: :"es-419"),
      "payment_terms"  => I18n.t("quote_document.labels.payment_terms", locale: :"es-419"),
      "notes"          => I18n.t("quote_document.labels.notes",         locale: :"es-419"),
      "scope_of_supply" => I18n.t("quote_templates.defaults.scope_of_supply_label", locale: :"es-419"),
      "doc_title_quote" => I18n.t("quote_document.titles.quotation",    locale: :"es-419"),
      "doc_title_pi"    => I18n.t("quote_document.titles.pi",           locale: :"es-419"),
    }
  }.to_json.html_safe %>;

  (() => {
    const form = document.querySelector("[data-template-editor-form]");
    if (!form) return;
    const alreadyBound = form.dataset.previewBound === "true";
    form.dataset.previewBound = "true";

    const preview = form.querySelector("[data-template-preview]");
    if (!preview) return;

    const qs = (selector) => form.querySelector(selector);
    const qsp = (selector) => preview.querySelector(selector);
    const slugInput = qs("input[name='quote_template[slug]']");
    const nameInput = qs("input[name='quote_template[name]']");
    const slugFeedback = qs("[data-template-slug-feedback]");
    const slugTakenMessageTemplate = form.dataset.slugTakenMessage || "This identifier is already used: %{slug}";
    const existingSlugs = (() => {
      try {
        const parsed = JSON.parse(form.dataset.existingSlugs || "[]");
        return new Set(parsed.map((value) => String(value || "").trim().toLowerCase()).filter(Boolean));
      } catch (_) {
        return new Set();
      }
    })();

    const normalizeSlug = (value) => String(value || "")
      .normalize("NFKD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");

    const syncSlugValidation = (report = false) => {
      if (!slugInput) return false;

      const slugSource = slugInput.value.trim().length > 0 ? slugInput.value : (nameInput?.value || "");
      const normalized = normalizeSlug(slugSource);
      const isTaken = normalized.length > 0 && existingSlugs.has(normalized);
      const message = isTaken ? slugTakenMessageTemplate.replace("%{slug}", normalized) : "";

      slugInput.setCustomValidity(message);
      if (slugFeedback) {
        slugFeedback.textContent = message;
        slugFeedback.hidden = !isTaken;
      }

      if (report && isTaken) slugInput.reportValidity();
      return isTaken;
    };

    if (!alreadyBound && slugInput) {
      slugInput.addEventListener("input", () => syncSlugValidation(false));
      slugInput.addEventListener("blur", () => syncSlugValidation(true));
      if (nameInput) nameInput.addEventListener("input", () => syncSlugValidation(false));
      form.addEventListener("submit", (event) => {
        if (!syncSlugValidation(true)) return;
        event.preventDefault();
      });
      syncSlugValidation(false);
    }

    const documentKindFields = Array.from(form.querySelectorAll("[data-template-doc-kind-field]"));
    const syncDocumentKindFields = (kind) => {
      documentKindFields.forEach((node) => {
        node.hidden = node.dataset.templateDocKindField !== kind;
      });
    };
    const statusNode = form.querySelector("[data-template-preview-status]");
    const contrastNode = form.querySelector("[data-template-preview-contrast]");
    const scenarioNode = form.querySelector("[data-template-preview-scenario]");
    const viewportButtons = Array.from(form.querySelectorAll("[data-template-preview-viewport-btn]"));
    const previewWatermarkImage = qsp("[data-template-preview-watermark-image]");
    const previewSignatureImage = qsp("[data-template-preview-signature-image] img");
    let watermarkImageObjectUrl = "";
    let signatureImageObjectUrl = "";
    const viewportClasses = [
      "template-preview-viewport-desktop",
      "template-preview-viewport-tablet",
      "template-preview-viewport-mobile"
    ];
    const initialSignature = (() => {
      const parts = [];
      form.querySelectorAll("input[name], select[name], textarea[name]").forEach((field) => {
        if (field.disabled) return;
        const type = field.type ? field.type.toLowerCase() : "";
        if (type === "file") return;
        if (type === "hidden" && /authenticity_token|utf8|_method/.test(field.name)) return;
        if (type === "checkbox" || type === "radio") {
          parts.push(`${field.name}:${field.checked ? "1" : "0"}`);
          return;
        }
        parts.push(`${field.name}:${field.value}`);
      });
      return parts.sort().join("|");
    })();

    const showNode = (selector, visible) => {
      const nodes = preview.querySelectorAll(selector);
      if (!nodes.length) return;
      nodes.forEach((node) => {
        const changed = node.hidden === visible;
        node.hidden = !visible;
        if (changed) {
          node.classList.remove("is-preview-flash");
          window.requestAnimationFrame(() => {
            node.classList.add("is-preview-flash");
          });
        }
      });
    };

    const formatNumber = (value, decimals, separator) => {
      const fixed = Number(value || 0).toFixed(decimals);
      const [intPart, decPart] = fixed.split(".");
      let grouped = intPart;

      if (separator === "comma") grouped = intPart.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
      if (separator === "space") grouped = intPart.replace(/\B(?=(\d{3})+(?!\d))/g, " ");

      if (decimals === 0) return grouped;
      return `${grouped}.${decPart}`;
    };

    const formatMoney = (value, options) => {
      const amount = formatNumber(value, options.decimals, options.separator);
      if (!options.showCurrency) return amount;

      if (options.mode === "code_prefix") return `USD ${amount}`;
      if (options.mode === "code_suffix") return `${amount} USD`;
      return `$${amount}`;
    };

    const hexToRgb = (hex) => {
      const raw = String(hex || "").trim().replace("#", "");
      if (!/^[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$/.test(raw)) return null;
      const normalized = raw.length === 3 ? raw.split("").map((ch) => ch + ch).join("") : raw;
      return {
        r: Number.parseInt(normalized.slice(0, 2), 16),
        g: Number.parseInt(normalized.slice(2, 4), 16),
        b: Number.parseInt(normalized.slice(4, 6), 16)
      };
    };

    const relativeLuminance = (rgb) => {
      const linear = [rgb.r, rgb.g, rgb.b].map((value) => {
        const channel = value / 255;
        return channel <= 0.03928 ? channel / 12.92 : ((channel + 0.055) / 1.055) ** 2.4;
      });
      return 0.2126 * linear[0] + 0.7152 * linear[1] + 0.0722 * linear[2];
    };

    const contrastRatio = (hexA, hexB) => {
      const rgbA = hexToRgb(hexA);
      const rgbB = hexToRgb(hexB);
      if (!rgbA || !rgbB) return null;
      const lumA = relativeLuminance(rgbA);
      const lumB = relativeLuminance(rgbB);
      const lighter = Math.max(lumA, lumB);
      const darker = Math.min(lumA, lumB);
      return (lighter + 0.05) / (darker + 0.05);
    };

    const currentSignature = () => {
      const parts = [];
      form.querySelectorAll("input[name], select[name], textarea[name]").forEach((field) => {
        if (field.disabled) return;
        const type = field.type ? field.type.toLowerCase() : "";
        if (type === "file") return;
        if (type === "hidden" && /authenticity_token|utf8|_method/.test(field.name)) return;
        if (type === "checkbox" || type === "radio") {
          parts.push(`${field.name}:${field.checked ? "1" : "0"}`);
          return;
        }
        parts.push(`${field.name}:${field.value}`);
      });
      return parts.sort().join("|");
    };

    const updateSaveStatus = () => {
      if (!statusNode) return;
      const dirty = currentSignature() !== initialSignature;
      statusNode.textContent = dirty ? "Unsaved changes" : "Saved";
      statusNode.classList.toggle("is-dirty", dirty);
      statusNode.classList.toggle("is-saved", !dirty);
    };

    const updateContrastWarning = (accent) => {
      if (!contrastNode) return;
      const whiteContrast = contrastRatio(accent, "#ffffff");
      const textContrast = contrastRatio(accent, "#0f172a");
      const warnings = [];
      if (whiteContrast && whiteContrast < 4.5) warnings.push("white text on accent");
      if (textContrast && textContrast < 3.0) warnings.push("accent text on white background");

      if (warnings.length === 0) {
        contrastNode.hidden = true;
        contrastNode.textContent = "";
        return;
      }

      contrastNode.hidden = false;
      contrastNode.textContent = `Contrast check: low readability risk for ${warnings.join(" and ")}.`;
    };

    const applyViewport = (viewport) => {
      if (!viewport) return;
      preview.classList.remove(...viewportClasses);
      preview.classList.add(`template-preview-viewport-${viewport}`);
      viewportButtons.forEach((button) => {
        const active = button.dataset.templatePreviewViewportBtn === viewport;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", active ? "true" : "false");
      });
    };

    const applyScenario = (scenario) => {
      const scenarios = {
        standard: {
          desc1: "Pump body SS304",
          spec1: "316L / IP55",
          addon1: "Wooden Case (+$35)",
          qty1: "2",
          unit1: 900,
          line1: 1800,
          desc2: "Motor 5.5kW",
          qty2: "1",
          unit2: 620,
          line2: 620,
          desc3: "Installation kit",
          qty3: "3",
          unit3: 130,
          line3: 390
        },
        long_text: {
          desc1: "High-pressure stainless steel pump body with anti-corrosion treatment and reinforced flange",
          spec1: "316L / IP55 / 380V 50Hz",
          addon1: "Export packaging, reinforced frame, moisture-proof wrapping (+$120)",
          qty1: "2",
          unit1: 980,
          line1: 1960,
          desc2: "Motor with inverter-ready control set and thermal protection",
          qty2: "1",
          unit2: 760,
          line2: 760,
          desc3: "Installation + commissioning support package",
          qty3: "1",
          unit3: 480,
          line3: 480
        },
        spec_heavy: {
          desc1: "Pump body SS304",
          spec1: "Flow 25m3/h | Head 58m | Seal: Sic/Sic",
          addon1: "Spare seal set (+$55), base plate (+$40), wiring loom (+$22)",
          qty1: "1",
          unit1: 1320,
          line1: 1320,
          desc2: "Motor 7.5kW",
          qty2: "2",
          unit2: 690,
          line2: 1380,
          desc3: "Commissioning kit",
          qty3: "2",
          unit3: 210,
          line3: 420
        }
      };
      const data = scenarios[scenario] || scenarios.standard;
      const setText = (selector, value) => {
        const node = qsp(selector);
        if (!node) return;
        node.textContent = value;
      };
      const setAmount = (selector, value) => {
        const node = qsp(selector);
        if (!node) return;
        node.dataset.rawAmount = String(value);
      };

      setText("[data-template-preview-item-desc-1]", data.desc1);
      setText("[data-template-preview-item-spec-1]", data.spec1);
      setText("[data-template-preview-item-addon-1]", data.addon1);
      setText("[data-template-preview-item-qty-1]", data.qty1);
      setAmount("[data-template-preview-item-unit-1]", data.unit1);
      setAmount("[data-template-preview-item-line-1]", data.line1);
      setText("[data-template-preview-item-desc-2]", data.desc2);
      setText("[data-template-preview-item-qty-2]", data.qty2);
      setAmount("[data-template-preview-item-unit-2]", data.unit2);
      setAmount("[data-template-preview-item-line-2]", data.line2);
      setText("[data-template-preview-item-desc-3]", data.desc3);
      setText("[data-template-preview-item-qty-3]", data.qty3);
      setAmount("[data-template-preview-item-unit-3]", data.unit3);
      setAmount("[data-template-preview-item-line-3]", data.line3);

      const subtotal = (data.line1 || 0) + (data.line2 || 0) + (data.line3 || 0);
      const tax = 281;
      const shipping = 120;
      const grandTotal = subtotal + tax + shipping;
      setAmount("[data-template-preview-subtotal]", subtotal);
      setAmount("[data-template-preview-tax-amount]", tax);
      setAmount("[data-template-preview-shipping-amount]", shipping);
      setAmount("[data-template-preview-grand-total]", grandTotal);
    };

    const updatePreview = () => {
      const accent = qs("[data-template-preview-target='accent']")?.value || "#1F4E79";
      const font = qs("[data-template-preview-target='font']")?.value || "Noto Sans";
      const layout = qs("[data-template-preview-target='layout']")?.value || "classic";
      const density = qs("[data-template-preview-target='density']")?.value || "standard";
      const logoPosition = qs("[data-template-preview-target='logo-position']")?.value || "right";
      const titleQuote = qs("[data-template-preview-target='title-quote']")?.value?.trim() || "QUOTATION";
      const documentKind = qs("[data-template-preview-target='document-kind']")?.value || "quotation";
      const webviewLocale = qs("[data-template-preview-target='webview-locale']")?.value || "en";
      const localeLabels = PREVIEW_I18N[webviewLocale] || PREVIEW_I18N["en"];
      syncDocumentKindFields(documentKind);
      const labelDesc = qs("[data-template-preview-target='label-description']")?.value?.trim() || "Description";
      const labelQty = qs("[data-template-preview-target='label-qty']")?.value?.trim() || "Qty";
      const labelUnitPrice = qs("[data-template-preview-target='label-unit-price']")?.value?.trim() || "Unit Price";
      const labelLineTotal = qs("[data-template-preview-target='label-line-total']")?.value?.trim() || "Line Total";
      const labelScopeOfSupply = qs("[data-template-preview-target='label-scope-of-supply']")?.value?.trim() || localeLabels.scope_of_supply || "Scope of Supply";
      const defaultScopeOfSupplyContent = qs("[data-template-preview-target='default-scope-of-supply-content']")?.value?.trim() || "Pump body, motor, base frame, and installation kit.";
      const labelSpec = qs("[data-template-preview-target='label-spec']")?.value?.trim() || "Spec";
      const labelAddon = qs("[data-template-preview-target='label-addon']")?.value?.trim() || "Add-on";
      const numberLabelQuote = qs("[data-template-preview-target='number-label-quote']")?.value?.trim() || "Quote #";
      const numberLabelPi = qs("[data-template-preview-target='number-label-pi']")?.value?.trim() || "PI #";
      const footerQuote = qs("[data-template-preview-target='footer-quote']")?.value?.trim();
      const closingMessage = qs("[name='quote_template[closing_message]']")?.value?.trim();
      const footerFallback = qs("[data-template-preview-target='footer-fallback']")?.value?.trim();
      const decimals = Number.parseInt(qs("[data-template-preview-target='amount-decimals']")?.value || "2", 10);
      const separator = qs("[data-template-preview-target='thousand-separator']")?.value || "comma";
      const currencyMode = qs("[data-template-preview-target='currency-display-mode']")?.value || "symbol_prefix";
      const showCurrency = !!qs("[data-template-preview-toggle='currency']")?.checked;
      const showWatermark = !!qs("[data-template-preview-toggle='watermark']")?.checked;
      const watermarkTextInput = qs("[data-template-preview-target='watermark-text']")?.value?.trim() || "";
      const watermarkOpacityRaw = Number.parseInt(qs("[data-template-preview-target='watermark-opacity']")?.value || "12", 10);
      const signatureName = qs("[data-template-preview-target='signature-name']")?.value?.trim() || "";
      const watermarkUploadInput = qs("[data-template-preview-target='watermark-image-upload']");
      const signatureUploadInput = qs("[data-template-preview-target='signature-image-upload']");
      const removeWatermarkImage = !!qs("[name='quote_template[remove_watermark_image]']")?.checked;
      const removeSignatureImage = !!qs("[name='quote_template[remove_signature_image]']")?.checked;
      let hasWatermarkImage = previewWatermarkImage && !!previewWatermarkImage.getAttribute("src") && !removeWatermarkImage;
      let hasSignatureImage = previewSignatureImage && !!previewSignatureImage.getAttribute("src") && !removeSignatureImage;

      preview.classList.remove("template-preview-classic", "template-preview-modern", "template-preview-industry");
      preview.classList.add(`template-preview-${layout}`);
      preview.style.setProperty("--template-accent", accent);
      const watermarkOpacity = Number.isNaN(watermarkOpacityRaw) ? 12 : Math.min(40, Math.max(3, watermarkOpacityRaw));
      preview.style.setProperty("--quote-watermark-opacity", (watermarkOpacity / 100).toFixed(2));
      preview.style.fontFamily = `${font}, sans-serif`;
      hasWatermarkImage = hasWatermarkImage || watermarkImageActive();
      const watermarkText = hasWatermarkImage ? "" : (watermarkTextInput || "CONFIDENTIAL");
      preview.classList.toggle("quote-watermarked", showWatermark && watermarkText.length > 0);
      preview.dataset.watermark = showWatermark ? watermarkText : "";
      if (previewWatermarkImage) {
        const shouldShow = showWatermark && hasWatermarkImage;
        previewWatermarkImage.hidden = !shouldShow;
      }

      if (!removeWatermarkImage && watermarkUploadInput && previewWatermarkImage && watermarkUploadInput.files && watermarkUploadInput.files[0]) {
        const file = watermarkUploadInput.files[0];
        if (file.type && file.type.startsWith("image/")) {
          if (watermarkImageObjectUrl) URL.revokeObjectURL(watermarkImageObjectUrl);
          watermarkImageObjectUrl = URL.createObjectURL(file);
          previewWatermarkImage.src = watermarkImageObjectUrl;
          preview.classList.toggle("quote-watermarked", false);
          previewWatermarkImage.hidden = !showWatermark;
          hasWatermarkImage = true;
        }
      }

      if (!removeSignatureImage && signatureUploadInput && previewSignatureImage && signatureUploadInput.files && signatureUploadInput.files[0]) {
        const file = signatureUploadInput.files[0];
        if (file.type && file.type.startsWith("image/")) {
          if (signatureImageObjectUrl) URL.revokeObjectURL(signatureImageObjectUrl);
          signatureImageObjectUrl = URL.createObjectURL(file);
          previewSignatureImage.src = signatureImageObjectUrl;
          hasSignatureImage = true;
        }
      }

      const densityNode = qsp("[data-template-preview-density]");
      if (densityNode) {
        densityNode.classList.remove("preview-density-compact", "preview-density-standard", "preview-density-spacious");
        densityNode.classList.add(`preview-density-${density}`);
      }

      const header = qsp("[data-template-preview-logo-position]");
      if (header) {
        header.classList.remove("preview-header-left", "preview-header-right", "preview-header-center");
        header.classList.add(`preview-header-${logoPosition}`);
      }

      const titleNode = qsp("[data-template-preview-title]");
      if (titleNode) {
        if (documentKind === "proforma_invoice") {
          const piTitle = qs("[name='quote_template[pi_title]']")?.value?.trim() || "PROFORMA INVOICE";
          titleNode.textContent = piTitle;
        } else {
          titleNode.textContent = titleQuote;
        }
      }
      const descNode = qsp("[data-template-preview-label-description]");
      if (descNode) descNode.textContent = labelDesc;
      const qtyNode = qsp("[data-template-preview-label-qty]");
      if (qtyNode) qtyNode.textContent = labelQty;
      const unitPriceNode = qsp("[data-template-preview-label-unit-price]");
      if (unitPriceNode) unitPriceNode.textContent = labelUnitPrice;
      const lineTotalNode = qsp("[data-template-preview-label-line-total]");
      if (lineTotalNode) lineTotalNode.textContent = labelLineTotal;
      const scopeLabelNode = qsp("[data-template-preview-label-scope-of-supply]");
      if (scopeLabelNode) scopeLabelNode.textContent = labelScopeOfSupply;
      const scopeContentNode = qsp("[data-template-preview-scope-default-value]");
      if (scopeContentNode) scopeContentNode.textContent = defaultScopeOfSupplyContent;
      const specNode = qsp("[data-template-preview-spec-label]");
      if (specNode) specNode.textContent = labelSpec;
      const addonNode = qsp("[data-template-preview-addon-label]");
      if (addonNode) addonNode.textContent = labelAddon;
      const numberLabelNode = qsp("[data-template-preview-number-label]");
      if (numberLabelNode) numberLabelNode.textContent = documentKind === "proforma_invoice" ? numberLabelPi : numberLabelQuote;

      const footerNode = qsp("[data-template-preview-footer]");
      if (footerNode) {
        const piFooter = qs("[name='quote_template[pi_footer_note]']")?.value?.trim();
        footerNode.textContent = documentKind === "proforma_invoice" ? (piFooter || footerFallback || "Thank you for your business.") : (footerQuote || footerFallback || "Thank you for your business.");
      }
      const closingNode = qsp("[data-template-preview-closing]");
      if (closingNode) closingNode.textContent = closingMessage || "<No closing message>";
      const signatureNameNode = qsp("[data-template-preview-signature-name-value]");
      if (signatureNameNode) signatureNameNode.textContent = signatureName;

      preview.querySelectorAll("[data-template-preview-amount]").forEach((node) => {
        const raw = Number.parseFloat(node.dataset.rawAmount || "0");
        node.textContent = formatMoney(raw, {
          decimals: Number.isNaN(decimals) ? 2 : decimals,
          separator,
          mode: currencyMode,
          showCurrency
        });
      });

      showNode("[data-template-preview-logo]", !!qs("[data-template-preview-toggle='logo']")?.checked);
      showNode("[data-template-preview-tax]", !!qs("[data-template-preview-toggle='tax']")?.checked);
      showNode("[data-template-preview-shipping]", !!qs("[data-template-preview-toggle='shipping']")?.checked);
      showNode("[data-template-preview-payment]", !!qs("[data-template-preview-toggle='payment']")?.checked);
      showNode("[data-template-preview-notes]", !!qs("[data-template-preview-toggle='notes']")?.checked);
      const showScopeOfSupply = !!qs("[data-template-preview-toggle='scope-of-supply']")?.checked && documentKind !== "proforma_invoice";
      showNode("[data-template-preview-scope-of-supply]", showScopeOfSupply);
      const defaultScopeContainer = qs("[data-template-default-scope-container]");
      if (defaultScopeContainer) defaultScopeContainer.hidden = !showScopeOfSupply;
      const showSignature = !!qs("[data-template-preview-toggle='signature']")?.checked;
      showNode("[data-template-preview-signature-image]", showSignature && hasSignatureImage);
      showNode("[data-template-preview-signature-name]", showSignature && signatureName.length > 0);
      showNode("[data-template-preview-customer-owner]", !!qs("[data-template-preview-toggle='customer-owner']")?.checked);
      showNode("[data-template-preview-valid-until]", !!qs("[data-template-preview-toggle='valid-until']")?.checked);
      showNode("[data-template-preview-terms]", !!qs("[data-template-preview-toggle='terms']")?.checked);
      showNode("[data-template-preview-images]", !!qs("[data-template-preview-toggle='images']")?.checked);
      showNode("[data-template-preview-closing]", !!qs("[data-template-preview-toggle='closing']")?.checked);
      showNode("[data-template-preview-saas-branding]", !!qs("[data-template-preview-toggle='saas-branding']")?.checked);
      updateWatermarkModeUI();
      updateContrastWarning(accent);

      // Update locale-dependent labels in the preview
      preview.querySelectorAll("[data-preview-i18n-label]").forEach((node) => {
        const key = node.dataset.previewI18nLabel;
        if (localeLabels[key]) node.textContent = localeLabels[key];
      });

      updateSaveStatus();
    };

    if (!alreadyBound) {
      form.addEventListener("input", updatePreview);
      form.addEventListener("change", updatePreview);
    }

    const showWatermarkToggle = qs("[data-template-preview-toggle='watermark']");
    const watermarkTextInput = qs("[data-template-preview-target='watermark-text']");
    const watermarkFileInput = qs("[data-template-preview-target='watermark-image-upload']");
    const watermarkOpacityInput = qs("[data-template-preview-target='watermark-opacity']");
    const removeWatermarkImageInput = qs("[name='quote_template[remove_watermark_image]']");
    const watermarkTextContainer = qs("[data-watermark-text-container]");
    const watermarkModeHint = qs("[data-watermark-mode-hint]");
    const showSignatureToggle = qs("[data-template-preview-toggle='signature']");
    const signatureNameInput = qs("[data-template-preview-target='signature-name']");
    const signatureFileInput = qs("[data-template-preview-target='signature-image-upload']");
    const hasExistingWatermarkImage = watermarkFileInput?.dataset.existingFile === "true";

    const watermarkImageActive = () => {
      const hasNewUpload = !!(watermarkFileInput && watermarkFileInput.files && watermarkFileInput.files[0]);
      const removeExisting = !!removeWatermarkImageInput?.checked;
      const hasExisting = hasExistingWatermarkImage && !removeExisting;
      return hasNewUpload || hasExisting;
    };

    const updateWatermarkModeUI = () => {
      const imageMode = watermarkImageActive();
      if (watermarkTextInput) watermarkTextInput.disabled = imageMode;
      if (watermarkTextContainer) watermarkTextContainer.classList.toggle("is-disabled", imageMode);
      if (watermarkModeHint) {
        watermarkModeHint.textContent = imageMode ?
          "Image watermark mode is active. Remove image to edit text watermark." :
          "Text watermark mode is active. Upload an image to switch to image mode.";
      }
    };

    const bindFilePickers = () => {
      form.querySelectorAll("[data-file-picker-trigger]").forEach((button) => {
        const inputId = button.dataset.filePickerTrigger;
        const input = form.querySelector(`#${inputId}`);
        if (!input) return;
        button.addEventListener("click", () => input.click());
      });

      form.querySelectorAll("[data-file-picker-input]").forEach((input) => {
        const fileNameTarget = input.dataset.filePickerName;
        const fileNameNode = fileNameTarget ? form.querySelector(`#${fileNameTarget}`) : null;
        if (!fileNameNode) return;
        const updateFileName = () => {
          fileNameNode.textContent = input.files && input.files[0] ? input.files[0].name : "No file selected";
        };
        input.addEventListener("change", updateFileName);
        updateFileName();
      });
    };
    if (!alreadyBound) bindFilePickers();

    if (!alreadyBound && watermarkTextInput && showWatermarkToggle) {
      watermarkTextInput.addEventListener("input", () => {
        if (watermarkTextInput.value.trim()) showWatermarkToggle.checked = true;
      });
    }
    if (!alreadyBound && watermarkFileInput && showWatermarkToggle) {
      watermarkFileInput.addEventListener("change", () => {
        if (watermarkFileInput.files && watermarkFileInput.files[0]) {
          showWatermarkToggle.checked = true;
          if (removeWatermarkImageInput) removeWatermarkImageInput.checked = false;
        }
        updateWatermarkModeUI();
      });
    }
    if (!alreadyBound && removeWatermarkImageInput) {
      removeWatermarkImageInput.addEventListener("change", updateWatermarkModeUI);
    }
    if (!alreadyBound && signatureFileInput && showSignatureToggle) {
      signatureFileInput.addEventListener("change", () => {
        if (signatureFileInput.files && signatureFileInput.files[0]) showSignatureToggle.checked = true;
      });
    }
    if (!alreadyBound && signatureNameInput && showSignatureToggle) {
      signatureNameInput.addEventListener("input", () => {
        if (signatureNameInput.value.trim()) showSignatureToggle.checked = true;
      });
    }
    if (!alreadyBound) form.addEventListener("submit", () => {
      if (!statusNode) return;
      statusNode.textContent = "Saving...";
      statusNode.classList.remove("is-dirty", "is-saved");
      statusNode.classList.add("is-saving");
    });

    if (!alreadyBound) {
      viewportButtons.forEach((button) => {
        button.addEventListener("click", () => {
          applyViewport(button.dataset.templatePreviewViewportBtn);
        });
      });
    }

    if (!alreadyBound && scenarioNode) {
      scenarioNode.addEventListener("change", () => {
        applyScenario(scenarioNode.value);
        updatePreview();
      });
    }

    applyViewport("desktop");
    applyScenario(scenarioNode?.value || "standard");
    updateWatermarkModeUI();
    updatePreview();

    // Sync-all locale select (no button): selecting a language applies to all output channels.
    const syncSelect = form.querySelector("[data-output-lang-sync-select]");
    const syncTargets = Array.from(form.querySelectorAll("[data-output-lang-target]"));
    const applyLocaleToAll = (locale) => {
      if (!locale) return;
      syncTargets.forEach((field) => {
        if (!field) return;
        field.value = locale;
        field.dispatchEvent(new Event("change", { bubbles: true }));
      });
    };
    if (syncSelect && syncTargets[0] && syncTargets[0].value) {
      syncSelect.value = syncTargets[0].value;
    }
    if (!alreadyBound && syncSelect) {
      syncSelect.addEventListener("change", () => {
        applyLocaleToAll(syncSelect.value);
      });
    }
  })();
</script>

<script>
  (() => {
    const runDocKindFirstPaintSync = () => {
      const form = document.querySelector("[data-template-editor-form]");
      if (!form) return;

      const kindSelect = form.querySelector("[data-template-preview-target='document-kind']");
      if (!kindSelect) return;

      const syncFields = () => {
        const kind = kindSelect.value || "quotation";
        form.querySelectorAll("[data-template-doc-kind-field]").forEach((node) => {
          node.hidden = node.dataset.templateDocKindField !== kind;
        });
      };

      syncFields();

      if (form.dataset.docKindSyncBound !== "true") {
        form.dataset.docKindSyncBound = "true";
        kindSelect.addEventListener("change", () => {
          syncFields();
          form.dispatchEvent(new Event("change", { bubbles: true }));
        });
      }

      // Force one preview pass after Turbo render so first paint is correct.
      window.requestAnimationFrame(() => {
        form.dispatchEvent(new Event("change", { bubbles: true }));
      });
    };

    document.addEventListener("turbo:load", runDocKindFirstPaintSync);
    runDocKindFirstPaintSync();
  })();
</script>
