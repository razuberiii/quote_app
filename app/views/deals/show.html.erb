<main class="deal-workspace deal-detail">
  <header class="deal-hero">
    <div><%= link_to t("self_service.deals.detail.back"), deals_path, class: "deal-back" %><p class="eyebrow"><%= @deal.customer&.name || t("self_service.deals.buyer_pending") %></p><h1><%= deal_title(@deal) %></h1><p><%= @deal.quote_no %> · <%= deal_version_label(@deal) %> · <%= t("self_service.deals.detail.owner", name: current_user.full_name.presence || current_user.username) %></p></div>
    <dl><div><dt><%= t("self_service.deals.detail.stage") %></dt><dd class="deal-stage deal-stage--<%= @progress.stage %>"><i></i><%= @progress.stage_label %></dd></div><div><dt><%= t("self_service.deals.detail.current_amount") %></dt><dd><%= @deal.currency %> <%= number_with_delimiter(@deal.grand_total) %></dd></div><div><dt><%= t("self_service.deals.detail.last_buyer_activity") %></dt><dd><%= @progress.signal %></dd></div></dl>
    <div class="deal-primary-action"><span><%= t("self_service.deals.detail.next_action") %></span><strong><%= @progress.action_label %></strong><%= link_to @progress.action_label, deal_action_path(@deal, @progress), class: "button button--primary" %><details><summary><%= t("self_service.deals.detail.more") %></summary><div><%= link_to t("self_service.deals.detail.edit_draft"), edit_quote_path(@deal) %><%= link_to t("self_service.deals.detail.deliver_version"), deliver_deal_path(@deal, version_id: @versions.first&.id) if @versions.any? %><%= link_to t("self_service.deals.detail.add_response"), new_response_deal_path(@deal, version_id: @versions.first&.id) if @versions.any? %><%= link_to t("self_service.deals.detail.record_acceptance"), new_acceptance_deal_path(@deal, version_id: @versions.first&.id) if @versions.any? && !@acceptance %></div></details></div>
  </header>
  <nav class="deal-tabs"><% %w[overview quote conversation versions documents].each do |key| %><%= link_to t("self_service.deals.detail.tabs.#{key}"), deal_path(@deal, tab: key), class: ("is-active" if @tab == key) %><% end %></nav>

  <% if @tab == "overview" %><div class="deal-overview-grid"><section class="deal-situation"><p class="section-kicker"><%= t("self_service.deals.detail.signals.title") %></p><div><article><span><%= t("self_service.deals.detail.signals.latest_response") %></span><strong><%= @responses.first ? t("self_service.deals.detail.response_kinds.#{@responses.first.kind}", default: @responses.first.kind.humanize) : (@questions.first&.body&.truncate(48) || t("self_service.deals.detail.signals.no_response")) %></strong><small><%= @responses.first ? t("self_service.deals.ago", time: time_ago_in_words(@responses.first.received_at)) : t("self_service.deals.detail.signals.waiting") %></small></article><article><span><%= t("self_service.deals.detail.signals.latest_delivery") %></span><strong><%= @deliveries.first ? t("self_service.deals.detail.signals.delivery_state", channel: t("self_service.deals.detail.channels.#{@deliveries.first.channel}", default: @deliveries.first.channel.humanize), status: t("self_service.deals.detail.statuses.#{@deliveries.first.status}", default: @deliveries.first.status.humanize)) : t("self_service.deals.detail.signals.not_delivered") %></strong><small><%= @deliveries.first&.recipient.presence || t("self_service.deals.detail.signals.choose_channel") %></small></article><article class="<%= 'is-blocked' unless @progress.action_key == 'wait' %>"><span><%= t("self_service.deals.detail.signals.risk") %></span><strong><%= @progress.action_key == "wait" ? t("self_service.deals.detail.signals.no_blocker") : @progress.action_label %></strong><small><%= @progress.signal %></small></article></div></section><section class="deal-facts"><h2><%= t("self_service.deals.detail.facts.title") %></h2><dl><div><dt><%= t("self_service.deals.detail.facts.buyer") %></dt><dd><%= @deal.customer&.name || t("self_service.deals.buyer_pending") %></dd></div><div><dt><%= t("self_service.deals.detail.facts.items") %></dt><dd><%= @deal.quote_items.size %></dd></div><div><dt><%= t("self_service.deals.detail.facts.currency") %></dt><dd><%= @deal.currency %></dd></div><div><dt><%= t("self_service.deals.detail.facts.valid_until") %></dt><dd><%= @deal.valid_until || t("self_service.deals.detail.not_set") %></dd></div><div><dt><%= t("self_service.deals.detail.facts.deliveries") %></dt><dd><%= t("self_service.deals.detail.facts.delivery_count", count: @deliveries.size, channels: @deliveries.map(&:channel).uniq.size) %></dd></div><div><dt><%= t("self_service.deals.detail.facts.acceptance") %></dt><dd><%= @acceptance ? t("self_service.deals.detail.facts.accepted", method: t("self_service.deals.detail.acceptance_methods.#{@acceptance.acceptance_method}", default: @acceptance.acceptance_method.humanize)) : t("self_service.deals.detail.facts.not_recorded") %></dd></div></dl><div class="deal-close-actions"><% if @progress.stage == "closed" %><%= button_to t("self_service.deals.detail.reopen"), reopen_deal_path(@deal), method: :patch, class: "button button--secondary" %><% else %><%= button_to t("self_service.deals.detail.close_won"), close_deal_path(@deal), method: :patch, params: { outcome: "won" }, class: "button button--secondary" %><%= button_to t("self_service.deals.detail.close_lost"), close_deal_path(@deal), method: :patch, params: { outcome: "lost" }, class: "button button--ghost" %><% end %></div></section><section class="deal-timeline"><header><h2><%= t("self_service.deals.detail.timeline.title") %></h2><span><%= t("self_service.deals.detail.timeline.help") %></span></header><ol><% @activities.first(8).each do |activity| %><li><i></i><div><strong><%= t("self_service.deals.detail.activity_kinds.#{activity.kind}", default: activity.kind.humanize) %></strong><span><%= activity.metadata["label"] || @deal.customer&.name %></span></div><time><%= t("self_service.deals.ago", time: time_ago_in_words(activity.created_at)) %></time></li><% end %><% if @activities.empty? %><li><i></i><div><strong><%= t("self_service.deals.detail.timeline.created") %></strong><span><%= t("self_service.deals.detail.timeline.draft_started") %></span></div><time><%= t("self_service.deals.ago", time: time_ago_in_words(@deal.created_at)) %></time></li><% end %></ol></section></div>
  <% elsif @tab == "quote" %><section class="deal-tab-panel deal-quote-panel"><div><p class="section-kicker"><%= t("self_service.deals.detail.quote_panel.kicker") %></p><h2><%= t("self_service.deals.detail.quote_panel.title") %></h2><p><%= t("self_service.deals.detail.quote_panel.body") %></p></div><div><%= link_to t("self_service.deals.detail.quote_panel.edit"), edit_quote_path(@deal), class: "button button--primary" %><%= link_to t("self_service.deals.detail.quote_panel.deliver"), deliver_deal_path(@deal, version_id: @versions.first.id), class: "button button--secondary" if @versions.any? %></div></section>
  <% elsif @tab == "conversation" %>
    <section class="conversation-stream">
      <header><p class="section-kicker"><%= t("self_service.deals.detail.conversation.kicker") %></p><h2><%= t("self_service.deals.detail.conversation.title") %></h2></header>
      <div class="conversation-toolbar"><%= link_to t("self_service.deals.detail.conversation.add_response"), new_response_deal_path(@deal, version_id: @versions.first&.id), class: "button button--secondary" if @versions.any? %><%= link_to t("self_service.deals.detail.record_acceptance"), new_acceptance_deal_path(@deal, version_id: @versions.first&.id), class: "button button--primary" if @versions.any? && !@acceptance %></div>
      <% @responses.each do |message| %><article class="channel-response" id="<%= dom_id(message) %>"><div><span><%= t("self_service.deals.detail.response_kinds.#{message.kind}", default: message.kind.humanize) %> · <%= t("self_service.deals.detail.response_sources.#{message.source}", default: message.source.humanize) %></span><strong><%= message.buyer_name.presence || @deal.customer&.name %></strong><time><%= t("self_service.deals.ago", time: time_ago_in_words(message.received_at)) %></time></div><p><%= message.body.presence || t("self_service.deals.detail.conversation.file_received") %></p><aside><span><%= t("self_service.deals.detail.versions.version", number: message.quote_revision.number) %></span><strong><%= t("self_service.deals.detail.statuses.#{message.status}", default: message.status.humanize) %></strong><small><%= message.context_type.humanize %><%= " · #{message.context_key}" if message.context_key.present? %></small></aside><%= render "response_review", response: message if message.difference_review.present? %></article><% end %>
      <% (@questions.to_a + @requests.to_a).sort_by(&:created_at).reverse.each do |message| %>
        <article>
          <div><span><%= message.is_a?(BuyerQuestion) ? t("self_service.deals.detail.conversation.question", context: message.context_key.presence || t("self_service.deals.detail.conversation.quote_context")) : t("self_service.deals.detail.conversation.change_request") %></span><strong><%= message.buyer_name.presence || message.buyer_email %></strong><time><%= t("self_service.deals.ago", time: time_ago_in_words(message.created_at)) %></time></div>
          <p><%= message.respond_to?(:body) ? message.body : message.message %></p>
          <% if message.is_a?(BuyerQuestion) && message.seller_reply.present? %>
            <blockquote><span><%= t("self_service.deals.detail.conversation.seller_reply") %></span><%= message.seller_reply %></blockquote>
          <% elsif message.is_a?(BuyerQuestion) %>
            <%= form_with scope: :buyer_question, url: reply_question_deal_path(@deal, question_id: message.id), method: :patch, class: "conversation-reply" do |form| %>
              <%= form.text_area :seller_reply, placeholder: t("self_service.deals.detail.conversation.reply_placeholder"), required: true, rows: 3 %>
              <%= form.submit t("self_service.deals.detail.conversation.reply"), class: "button button--primary" %>
            <% end %>
          <% end %>
        </article>
      <% end %>
      <% if @questions.empty? && @requests.empty? && @responses.empty? %><div class="deal-zero"><h2><%= t("self_service.deals.detail.conversation.empty") %></h2><p><%= t("self_service.deals.detail.conversation.empty_help") %></p></div><% end %>
    </section>
  <% elsif @tab == "versions" %><section class="versions-list"><header><p class="section-kicker"><%= t("self_service.deals.detail.versions.kicker") %></p><h2><%= t("self_service.deals.detail.versions.title") %></h2></header><% @versions.each do |version| %><article><span><%= t("self_service.deals.detail.versions.version", number: version.number) %></span><div><strong><%= version.status == "current" ? t("self_service.deals.detail.versions.current") : t("self_service.deals.detail.version_statuses.#{version.status}", default: version.status.humanize) %></strong><small><%= t("self_service.deals.detail.versions.published", time: time_ago_in_words(version.published_at || version.created_at), count: version.version_deliveries.size) %></small><% version.version_deliveries.order(delivered_at: :desc).each do |delivery| %><small><%= t("self_service.deals.detail.channels.#{delivery.channel}", default: delivery.channel.humanize) %> · <%= t("self_service.deals.detail.statuses.#{delivery.status}", default: delivery.status.humanize) %></small><% end %></div><strong><%= version.currency %> <%= number_with_delimiter(version.total) %></strong><%= link_to(version.number == @versions.first.number && @versions.second ? t("self_service.deals.detail.versions.compare") : t("self_service.deals.detail.versions.view"), quote_revision_path(version), class: "deal-next") %></article><% end %><% if @versions.empty? %><div class="deal-zero"><h2><%= t("self_service.deals.detail.versions.empty") %></h2><p><%= t("self_service.deals.detail.versions.empty_help") %></p></div><% end %></section>
  <% else %><section class="documents-hub"><header><div><p class="section-kicker"><%= t("self_service.deals.detail.documents.kicker") %></p><h2><%= t("self_service.deals.detail.documents.title") %></h2><p><%= t("self_service.deals.detail.documents.subtitle") %></p></div><%= link_to t("self_service.deals.detail.documents.generate_or_deliver"), deliver_deal_path(@deal, version_id: @versions.first.id), class: "button button--primary" if @versions.any? %></header>
    <div class="document-group"><div class="document-group__title"><span>01</span><div><h3><%= t("self_service.deals.detail.documents.published_title") %></h3><p><%= t("self_service.deals.detail.documents.published_help") %></p></div></div><div class="document-list"><% @versions.each do |version| %><article><div class="document-type">V<%= version.number %></div><div><strong><%= @deal.quote_no %> · <%= t("self_service.deals.detail.versions.version", number: version.number) %></strong><small><%= t("self_service.deals.detail.version_statuses.#{version.status}", default: version.status.humanize) %> · <%= version.currency %> <%= number_with_delimiter(version.total) %> · <%= t("self_service.deals.detail.documents.published_ago", time: time_ago_in_words(version.published_at || version.created_at)) %></small></div><div class="document-actions"><%= link_to t("self_service.deals.detail.documents.buyer_room"), buyer_room_path(version.secure_token, preview: 1), target: "_blank" %><%= link_to t("self_service.deals.detail.documents.generate_send"), deliver_deal_path(@deal, version_id: version.id) %></div></article><% version.version_deliveries.select { |delivery| delivery.generated_file.attached? }.each do |delivery| %><article class="document-file-row"><div class="document-type"><%= delivery.generated_file.filename.extension.upcase %></div><div><strong><%= delivery.generated_file.filename %></strong><small><%= t("self_service.deals.detail.versions.version", number: version.number) %> · <%= t("self_service.deals.detail.statuses.#{delivery.status}", default: delivery.status.humanize) %> · <%= number_to_human_size(delivery.generated_file.byte_size) %><%= " · #{delivery.recipient}" if delivery.recipient.present? %></small><small><%= t("self_service.deals.detail.documents.generated_ago", time: time_ago_in_words(delivery.generated_at || delivery.created_at), channel: t("self_service.deals.detail.channels.#{delivery.channel}", default: delivery.channel.humanize)) %></small></div><div class="document-actions"><%= link_to t("self_service.deals.detail.documents.download"), download_delivery_deal_path(@deal, delivery_id: delivery.id) %><%= link_to t("self_service.deals.detail.documents.delivery_history"), deal_path(@deal, tab: "versions", anchor: "version-#{version.id}") %></div></article><% end %><% end %></div></div>
    <div class="document-group"><div class="document-group__title"><span>02</span><div><h3><%= t("self_service.deals.detail.documents.buyer_title") %></h3><p><%= t("self_service.deals.detail.documents.buyer_help") %></p></div></div><div class="document-list"><% @responses.select { |r| r.attachment.attached? }.each do |response| %><article><div class="document-type"><%= response.kind == "purchase_order" ? "PO" : "IN" %></div><div><strong><%= response.attachment.filename %></strong><small>Version <%= response.quote_revision.number %> · <%= response.status.humanize %> · <%= number_to_human_size(response.attachment.byte_size) %></small></div><div class="document-actions"><%= link_to "Review", deal_path(@deal, tab: "conversation", anchor: dom_id(response)) %></div></article><% end %><% if @responses.none? { |r| r.attachment.attached? } %><div class="document-empty"><strong><%= t("self_service.deals.detail.documents.buyer_empty") %></strong><span><%= t("self_service.deals.detail.documents.buyer_empty_help") %></span></div><% end %></div></div>
    <div class="document-group"><div class="document-group__title"><span>03</span><div><h3><%= t("self_service.deals.detail.documents.final_title") %></h3><p><%= t("self_service.deals.detail.documents.final_help") %></p></div></div><div class="document-list"><% @final_documents.each do |document| %><article><div class="document-type">FD</div><div><strong><%= document.title %> · <%= document.number %></strong><small>Accepted Version <%= document.quote_revision.number %> · <%= document.status.humanize %> · <%= number_to_human_size(document.file_size) %></small></div><div class="document-actions"><%= link_to "Preview", final_document_path(document) %><%= link_to "Download", pdf_final_document_path(document) if document.file.attached? %></div></article><% end %><% if @acceptance %><div class="document-create"><strong>Generate from Acceptance</strong><%= form_with url: final_documents_path, class: "final-document-form" do |form| %><%= hidden_field_tag :quote_acceptance_id, @acceptance.id %><%= select_tag :document_type, options_for_select(FinalDocument::TYPES.map { |type| [type.humanize, type] }, current_user.company.default_final_document_type), class: "app-ui-input" %><%= text_field_tag :custom_title, nil, class: "app-ui-input", placeholder: "Custom title if selected" %><%= form.submit "Generate file", class: "button button--primary" %><% end %></div><% elsif @final_documents.empty? %><div class="document-empty"><strong><%= t("self_service.deals.detail.documents.final_empty") %></strong><span><%= t("self_service.deals.detail.documents.final_empty_help") %></span></div><% end %></div></div>
  </section><% end %>
</main>
