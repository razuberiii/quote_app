                  <%= text_field_tag "quote[container_loading_block][rows][#{idx}][variant]", row[:variant], maxlength: Quote::MAX_CONTAINER_LOADING_CELL_LENGTH, class: ui_input_classes("js-container-loading-variant"), list: "container-loading-variant-options", placeholder: t("quotes.view.form.container_loading_variant_placeholder", default: "Variant / Version") %>
                  <%= text_field_tag "quote[container_loading_block][rows][#{idx}][container_type]", row[:container_type], maxlength: Quote::MAX_CONTAINER_LOADING_CELL_LENGTH, class: ui_input_classes("js-container-loading-type"), list: "container-loading-type-options", placeholder: t("quotes.view.form.container_loading_type_placeholder", default: "Container Type") %>
                  <%= text_field_tag "quote[container_loading_block][rows][#{idx}][capacity]", row[:capacity], maxlength: Quote::MAX_CONTAINER_LOADING_CELL_LENGTH, class: ui_input_classes("js-container-loading-capacity"), list: "container-loading-capacity-options", placeholder: t("quotes.view.form.container_loading_capacity_placeholder", default: "Capacity") %>
                  <%= text_field_tag "quote[container_loading_block][rows][#{idx}][note]", row[:note], maxlength: Quote::MAX_CONTAINER_LOADING_CELL_LENGTH, class: ui_input_classes("js-container-loading-note"), placeholder: t("quotes.view.form.container_loading_note_placeholder", default: "Note (optional)"), hidden: !container_loading_note_enabled %>
