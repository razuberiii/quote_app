<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="alert alert-danger" role="alert">
        <h4 class="alert-heading">Verification Link Invalid or Expired</h4>
        <p>The email verification link you used is invalid or has expired.</p>
        <hr/>
        <p class="mb-0">
          If you need a new verification link, please 
          <%= link_to "sign up", new_user_registration_path %> again.
        </p>
      </div>
    </div>
  </div>
</div>
