<section class="app-page-shell marketing-page-shell">
  <%= render "components/ui/card", class: "app-surface marketing-section-card" do %>
    <%= render "components/ui/section_header",
      kicker: t("landing.view.privacy.hero.kicker"),
      title: t("landing.view.privacy.hero.title"),
      body: t("landing.view.privacy.hero.body"),
      tag: :h1,
      title_class: "max-w-none" %>

    <div class="mt-6 grid gap-4 text-sm leading-7 text-slate-700">
      <p class="m-0 text-slate-500"><%= t("landing.view.privacy.last_updated") %></p>

      <section class="rounded-2xl border border-slate-200 bg-white p-4">
        <h2 class="m-0 text-lg font-semibold text-slate-900"><%= t("landing.view.privacy.sections.data_collect.title") %></h2>
        <p class="mt-2 mb-0"><%= t("landing.view.privacy.sections.data_collect.body") %></p>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white p-4">
        <h2 class="m-0 text-lg font-semibold text-slate-900"><%= t("landing.view.privacy.sections.data_use.title") %></h2>
        <p class="mt-2 mb-0"><%= t("landing.view.privacy.sections.data_use.body") %></p>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white p-4">
        <h2 class="m-0 text-lg font-semibold text-slate-900"><%= t("landing.view.privacy.sections.data_share.title") %></h2>
        <p class="mt-2 mb-0"><%= t("landing.view.privacy.sections.data_share.body") %></p>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white p-4">
        <h2 class="m-0 text-lg font-semibold text-slate-900"><%= t("landing.view.privacy.sections.retention.title") %></h2>
        <p class="mt-2 mb-0"><%= t("landing.view.privacy.sections.retention.body") %></p>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white p-4">
        <h2 class="m-0 text-lg font-semibold text-slate-900"><%= t("landing.view.privacy.sections.contact.title") %></h2>
        <p class="mt-2 mb-0"><%= t("landing.view.privacy.sections.contact.body") %></p>
      </section>
    </div>
  <% end %>
</section>
