<%= link_to "\u2190 #{t("quotes.view.show.back_to_customer")}", @quote.customer, class: "quote-back-link quote-back-link-top" %>

<% watermark_text = template_watermark_text(@template, @quote.company.name) %>
<% watermark_image_url = template_watermark_image_url(@template) %>
<% workflow_state = @quote.workflow_state %>
<% current_latest_revision = @quote_revisions.present? ? @quote_revisions.first&.id == @quote.id : @quote.latest_revision_for_quote_no? %>
<% quote_document_locale = @quote_document_locale || I18n.locale %>
<div class="quote-document quote-document-shell<%= " quote-watermarked" if watermark_text.present? %>"
     data-watermark="<%= watermark_text %>"
     data-has-newer-revision="<%= @has_newer_revision ? "true" : "false" %>"
     data-current-latest="<%= current_latest_revision ? "true" : "false" %>"
     style="--quote-accent: <%= @template.accent_color %>; --quote-watermark-opacity: <%= template_watermark_opacity(@template) %>;">
  <% if watermark_image_url.present? %>
    <img src="<%= watermark_image_url %>" alt="<%= t('quote_document.labels.watermark', default: 'Watermark') %>" class="quote-watermark-image">
  <% end %>
  <% active_template = @template %>
  <% spec_label = @quote.resolved_spec_label %>
  <% addon_label = @quote.resolved_addon_label %>
  <% viewer_tz = user_preferred_time_zone(current_user) %>
  <% discount_amount = @quote.discount_amount.to_d %>
  <% original_total = (@quote.subtotal.to_d + @quote.tax_amount.to_d + @quote.shipping_amount.to_d).round(2) %>
  <% has_discount = discount_amount.positive? %>
  <% savings_amount = has_discount ? discount_amount : 0.to_d %>
  <% I18n.with_locale(quote_document_locale) do %>
    <header class="quote-doc-header">
      <div>
        <p class="quote-doc-kicker"><%= @template.resolved_document_title(@document_kind).titleize %></p>
        <h1><%= @template.resolved_document_number_label(@document_kind) %> <%= @quote.quote_no %> <span class="quote-doc-version">V<%= @quote.revision_number %></span></h1>
        <% if @quote.custom_title.present? %>
          <p class="quote-doc-subtitle"><%= @quote.custom_title %></p>
        <% end %>
      </div>
      <%= quote_status_badge(@quote.status) %>
    </header>
  <% end %>
  <% if @has_newer_revision && @latest_revision_quote.present? %>
    <p class="quote-superseded-notice">
      <%= t("quotes.view.show.superseded_notice") %>
      <%= link_to t("quotes.view.show.view_latest_version", revision: @latest_revision_quote.revision_number), quote_path(@latest_revision_quote), class: "quote-back-link-inline" %>
    </p>
  <% end %>
  <% if @quote.status.to_s == "draft" && @quote.reopened_at.present? %>
    <p class="quote-superseded-notice">
      <%= t("quotes.view.show.reopened_notice") %>
    </p>
  <% end %>
<% days_left = @quote.valid_until.present? ? (@quote.valid_until - Date.current).to_i : nil %>
<% total_views = @quote.quote_shares.sum(&:view_count) %>
<% viewed_flag = @quote.viewed_at.present? || total_views.positive? %>
<% next_action_text =
    case workflow_state
    when "lost"
      t("quotes.view.show.next_action_lost")
    when "accepted"
      t("quotes.view.show.next_action_accepted")
    when "draft"
      t("quotes.view.show.next_action_draft")
    when "expired"
      t("quotes.view.show.next_action_expired")
    else
      viewed_flag ? t("quotes.view.show.next_action_viewed") : t("quotes.view.show.next_action_not_viewed")
    end %>
<% urgency_text =
      if days_left.nil?
        t("quotes.view.show.urgency_no_expiry")
      elsif days_left.negative?
        t("quotes.view.show.urgency_expired", count: days_left.abs)
      elsif days_left <= 3
        t("quotes.view.show.urgency_expiring", count: days_left)
      else
        t("quotes.view.show.urgency_valid", count: days_left)
      end %>
  <section class="quote-signal-strip <%= 'is-urgent' if days_left.present? && days_left <= 3 %>">
    <div class="quote-signal-item">
      <span class="quote-signal-label"><%= t("quotes.view.show.momentum") %></span>
      <strong><%= urgency_text %></strong>
    </div>
    <div class="quote-signal-item">
      <span class="quote-signal-label"><%= t("quotes.view.show.engagement") %></span>
      <strong><%= viewed_flag ? t("quotes.view.show.viewed_count", count: total_views) : t("quotes.view.show.not_viewed_yet") %></strong>
    </div>
    <div class="quote-signal-item">
      <span class="quote-signal-label"><%= t("quotes.view.show.next_action") %></span>
      <strong><%= next_action_text %></strong>
    </div>
  </section>

  <details class="quote-engagement-details">
    <summary><%= t("quotes.view.show.engagement_details") %></summary>
    <% access_events = @quote.quote_shares.flat_map { |share| Array(share.view_events) } %>
    <% country_counts = Hash.new(0) %>
    <% ip_counts = Hash.new(0) %>
    <% access_events.each do |event| %>
      <% country = event["country"].presence || t("quotes.view.show.unknown") %>
      <% ip = event["ip"].presence || t("quotes.view.show.unknown") %>
      <% country_counts[country] += 1 %>
      <% ip_counts[ip] += 1 %>
    <% end %>
    <% top_countries = country_counts.sort_by { |(_, count)| -count }.first(3) %>
    <% top_ips = ip_counts.sort_by { |(_, count)| -count }.first(3) %>
    <% recent_accesses = access_events.last(5).reverse %>
    <% recent_access_lines = recent_accesses.map do |event| %>
      <% tags = [] %>
      <% tags << event["country"] if event["country"].present? %>
      <% tags << event["ip"] if event["ip"].present? %>
      <% event_at = begin
           Time.iso8601(event["at"].to_s)
         rescue StandardError
           nil
         end %>
      <% formatted_at = event_at ? format_in_user_time(event_at, current_user) : event["at"] %>
      <% "#{formatted_at}#{tags.any? ? " [#{tags.join(' | ')}]" : ""}" %>
    <% end %>
    <div class="quote-engagement-details-grid">
      <p><strong><%= t("quotes.view.show.time_zone") %>:</strong> <%= viewer_tz.name %></p>
      <p><strong><%= t("quotes.view.show.sent") %>:</strong> <%= format_in_user_time(@quote.sent_at, current_user) %> <%= "(#{relative_in_user_time(@quote.sent_at, current_user)})" if @quote.sent_at.present? %></p>
      <p><strong><%= t("quotes.view.show.last_shared") %>:</strong> <span id="quote-last-shared-at"><%= format_in_user_time(@quote.quote_shares.maximum(:created_at), current_user) %></span></p>
      <p><strong><%= t("quotes.view.show.first_viewed") %>:</strong> <%= format_in_user_time(@quote.quote_shares.minimum(:first_viewed_at), current_user) %></p>
      <p><strong><%= t("quotes.view.show.last_viewed") %>:</strong> <%= format_in_user_time(@quote.viewed_at, current_user) %> <%= "(#{relative_in_user_time(@quote.viewed_at, current_user)})" if @quote.viewed_at.present? %></p>
      <p><strong><%= t("quotes.view.show.total_views") %>:</strong> <%= @quote.quote_shares.sum(&:view_count) %></p>
      <p><strong><%= t("quotes.view.show.top_countries") %>:</strong> <%= top_countries.any? ? top_countries.map { |country, count| "#{country} (#{count})" }.join(", ") : "-" %></p>
      <p><strong><%= t("quotes.view.show.top_ips") %>:</strong> <%= top_ips.any? ? top_ips.map { |ip, count| "#{ip} (#{count})" }.join(", ") : "-" %></p>
      <p><strong><%= t("quotes.view.show.recent_accesses") %>:</strong> <%= recent_access_lines.any? ? recent_access_lines.join(" | ") : "-" %></p>
    </div>
  </details>

  <% if @revision_diff.present? && @previous_revision_quote.present? %>
    <div id="quote-revision-diff">
      <%= render "revision_diff" %>
    </div>
  <% end %>

  <% if @quote_decision_review.present? %>
    <%= render "decision_review" %>
  <% end %>

  <% if @quote_decision_timeline.any? %>
    <%= render "decision_timeline" %>
  <% end %>

  <% I18n.with_locale(quote_document_locale) do %>
  <section class="quote-meta-grid">
    <article class="quote-meta-card">
      <h3><%= t("quote_document.labels.seller") %></h3>
      <p><strong><%= @quote.company.name %></strong></p>
      <% if active_template.show_customer_owner && Customer.internal_owner_enabled? && @quote.customer.internal_owner_display_name != "-" %>
        <p><%= t("quote_document.labels.sales_owner") %>: <%= @quote.customer.internal_owner_display_name %></p>
      <% end %>
      <p><%= @quote.company.address.presence || "-" %></p>
      <p><%= @quote.company.phone.presence || "-" %></p>
      <p><%= @quote.company.email.presence || "-" %></p>
      <p><%= @quote.company.website.presence || "-" %></p>
    </article>

    <article class="quote-meta-card">
      <h3><%= t("quote_document.labels.buyer") %></h3>
      <p><strong><%= t("quote_document.labels.company", default: "Company") %>:</strong> <%= @quote.customer.name.presence || "-" %></p>
      <p><strong><%= t("quote_document.labels.primary_contact", default: "Primary Contact") %>:</strong> <%= @quote.customer.contact_name.presence || "-" %></p>
      <p><strong><%= t("quote_document.labels.email", default: "Email") %>:</strong> <%= @quote.customer.email.presence || "-" %></p>
      <p><strong><%= t("quote_document.labels.phone", default: "Phone") %>:</strong> <%= @quote.customer.phone.presence || "-" %></p>
      <p><strong><%= t("quote_document.labels.address", default: "Address") %>:</strong> <%= @quote.customer.address.presence || "-" %></p>
    </article>

    <article class="quote-meta-card">
      <h3><%= t("quote_document.labels.quote_info", default: "Quote Info") %></h3>
      <div class="quote-info-list">
        <p class="quote-info-row is-doc-number"><span><%= @template.resolved_document_number_label(@document_kind) %></span><strong><%= @quote.quote_no %></strong></p>
        <% if @quote.custom_title.present? %>
          <p class="quote-info-row"><span><%= t("quote_document.labels.title", default: "Title") %></span><strong><%= @quote.custom_title %></strong></p>
        <% end %>
        <p class="quote-info-row"><span><%= @document_kind == "pi" ? t("quote_document.labels.pi_date") : t("quote_document.labels.quote_date") %></span><strong><%= @quote.issued_on&.strftime("%Y-%m-%d") || "-" %></strong></p>
        <% if @quote.valid_until.present? %>
          <p class="quote-info-row is-valid-until">
            <span><%= t("quote_document.labels.valid_until") %></span>
            <strong>
              <%= @quote.valid_until.strftime("%Y-%m-%d") %>
              <% if days_left.negative? %>
                <%= quote_status_badge("expired", label: "Expired") %>
              <% elsif days_left <= 3 %>
                <%= status_badge("#{days_left}d left", :amber) %>
              <% end %>
            </strong>
          </p>
        <% end %>
        <p class="quote-info-row"><span><%= t("quote_document.labels.currency") %></span><strong><%= @quote.currency %></strong></p>
        <% if @quote.trade_term.present? %>
          <p class="quote-info-row"><span><%= t("quote_document.labels.trade_terms") %></span><strong><%= @quote.trade_term %></strong></p>
        <% end %>
        <p class="quote-info-row"><span><%= t("quote_document.labels.status", default: "Status") %></span><strong><%= @quote.status&.capitalize %></strong></p>
        <% if @quote.win_reason.present? %>
          <p class="quote-info-row"><span><%= t("quote_document.labels.win_reason", default: "Win Reason") %></span><strong><%= @quote.display_win_reason %></strong></p>
        <% end %>
        <% if @quote.loss_reason.present? %>
          <p class="quote-info-row"><span><%= t("quote_document.labels.loss_reason", default: "Loss Reason") %></span><strong><%= @quote.display_loss_reason %></strong></p>
        <% end %>
        <% if @quote.stalled_reason.present? %>
          <p class="quote-info-row"><span><%= t("quote_document.labels.stalled_reason", default: "Stalled Reason") %></span><strong><%= @quote.display_stalled_reason %></strong></p>
        <% end %>
        <% if @quote.accepted_at.present? %>
          <p class="quote-info-row"><span><%= t("quote_document.labels.accepted_at", default: "Accepted At") %></span><strong><%= @quote.accepted_at.strftime("%Y-%m-%d %H:%M") %></strong></p>
        <% end %>
        <% if @quote.changes_requested_at.present? %>
          <p class="quote-info-row"><span><%= t("quote_document.labels.revision_requested", default: "Revision Requested") %></span><strong><%= @quote.changes_requested_at.strftime("%Y-%m-%d %H:%M") %></strong></p>
          <% if @quote.request_reason.present? %>
            <p class="quote-info-row"><span><%= t("quote_document.labels.request_reason", default: "Request Reason") %></span><strong><%= @quote.request_reason.humanize %></strong></p>
          <% end %>
          <% if @quote.changes_request_message.present? %>
            <p class="quote-info-row"><span><%= t("quote_document.labels.client_request", default: "Client Request") %></span><strong><%= @quote.changes_request_message %></strong></p>
          <% end %>
        <% end %>
        <% if @quote.reopened_at.present? %>
          <p class="quote-info-row"><span><%= t("quote_document.labels.reopened_at", default: "Reopened At") %></span><strong><%= @quote.reopened_at.strftime("%Y-%m-%d %H:%M") %></strong></p>
        <% end %>
      </div>
    </article>

  </section>

  <div class="app-section-heading">
    <h3><%= t("quote_document.labels.items", default: "Items") %></h3>
    <span class="app-subtle-note"><%= pluralize(@quote.quote_items.ordered.size, "line item") %></span>
  </div>
  <div class="table-responsive quote-items-responsive">
    <table class="quote-items-table quote-doc-table app-data-table">
      <colgroup>
        <% if active_template.show_images? %>
          <col class="quote-col-image">
        <% end %>
        <col class="quote-col-description">
        <col class="quote-col-qty">
        <col class="quote-col-money">
        <col class="quote-col-money">
      </colgroup>
      <thead>
        <tr>
          <% if active_template.show_images? %>
            <th><%= t("quote_document.labels.image") %></th>
          <% end %>
          <th><%= @template.resolved_table_label("description") %></th>
          <th class="quote-col-right"><%= @template.resolved_table_label("qty") %></th>
          <th class="quote-col-right quote-col-money"><%= @template.resolved_table_label("unit_price") %></th>
          <th class="quote-col-right quote-col-money"><%= @template.resolved_table_label("line_total") %></th>
        </tr>
      </thead>
      <tbody>
        <% @quote.quote_items.ordered.each do |item| %>
          <tr>
            <% if active_template.show_images? %>
              <td>
                <% if item.product&.display_image.present? %>
                  <%= image_tag item.product.display_image, class: "quote-item-image" %>
                <% else %>
                  -
                <% end %>
              </td>
            <% end %>
            <td>
              <div class="quote-item-desc">
                <div class="quote-item-desc-main"><%= item.product&.name.presence || t("quote_document.labels.item") %></div>
                <% if item.specification_pairs.any? || item.addon_charge_entries.any? %>
                  <div class="quote-item-desc-meta">
                    <% if item.specification_pairs.any? %>
                      <div class="quote-item-desc-group">
                        <div class="quote-item-desc-group-label"><%= spec_label %>:</div>
                        <% item.specification_pairs.each do |pair| %>
                          <div class="quote-item-desc-sub"><span class="quote-item-desc-bullet">&bull;</span><%= pair[:key] %> - <%= pair[:value] %></div>
                        <% end %>
                      </div>
                    <% end %>
                    <% if item.addon_charge_entries.any? %>
                      <div class="quote-item-desc-group is-addon">
                        <div class="quote-item-desc-group-label"><%= addon_label %>:</div>
                        <% item.addon_charge_entries.each do |entry| %>
                          <div class="quote-item-desc-sub is-addon"><span class="quote-item-desc-bullet">&bull;</span><%= entry[:name] %> (<%= quote_money(entry[:amount], @quote.currency, show_symbol: active_template.show_currency) %>)</div>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </td>
            <td class="quote-col-right"><%= item.quantity %></td>
            <td class="quote-col-right quote-col-money"><%= quote_money(item.unit_price, @quote.currency, show_symbol: active_template.show_currency) %></td>
            <td class="quote-col-right quote-col-money"><%= quote_money(item.line_total, @quote.currency, show_symbol: active_template.show_currency) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <aside class="quote-total-box">
    <p><span><%= t("quote_document.labels.subtotal") %></span><strong><%= quote_money(@quote.subtotal, @quote.currency, show_symbol: active_template.show_currency) %></strong></p>
    <% if active_template.show_tax %>
      <p><span><%= t("quote_document.labels.tax_vat") %></span><strong><%= quote_money(@quote.tax_amount, @quote.currency, show_symbol: active_template.show_currency) %></strong></p>
    <% end %>
    <% if active_template.show_shipping %>
      <p><span><%= t("quote_document.labels.shipping") %></span><strong><%= quote_money(@quote.shipping_amount, @quote.currency, show_symbol: active_template.show_currency) %></strong></p>
    <% end %>
    <% if has_discount %>
      <p class="quote-total-discount"><span><%= t("quote_document.labels.discount") %></span><strong>-<%= quote_money(discount_amount, @quote.currency, show_symbol: active_template.show_currency) %></strong></p>
      <p class="quote-total-reduction"><span><%= t("quote_document.labels.original_total", default: "Original Total") %></span><strong><%= quote_money(original_total, @quote.currency, show_symbol: active_template.show_currency) %></strong></p>
    <% end %>
    <p class="quote-total-grand"><span><%= t("quote_document.labels.grand_total") %></span><strong><%= quote_money(@quote.grand_total, @quote.currency, show_symbol: active_template.show_currency) %></strong></p>
    <% if has_discount %>
      <p class="quote-total-saved"><span><%= t("quote_document.labels.you_save", default: "You Save") %></span><strong><%= quote_money(savings_amount, @quote.currency, show_symbol: active_template.show_currency) %></strong></p>
    <% end %>
    <% if (closing_message = active_template.resolved_closing_message).present? %>
      <p class="quote-engagement-note"><%= closing_message %></p>
    <% end %>
  </aside>

  <% terms_lines = [] %>
  <% if active_template.show_terms_section %>
    <% terms_lines << [ t("quote_document.labels.payment_terms"), @quote.payment_term ] if active_template.show_payment_term && @quote.payment_term.present? %>
    <% terms_lines << [ t("quote_document.labels.trade_terms"), @quote.trade_term ] if @quote.trade_term.present? %>
    <% terms_lines << [ t("quote_document.labels.terms"), @quote.terms_text ] if @quote.terms_text.present? %>
    <% terms_lines << [ t("quote_document.labels.legal_disclaimer"), @quote.legal_disclaimer ] if @quote.legal_disclaimer.present? %>
    <% terms_lines << [ t("quote_document.labels.delivery_notes"), @quote.delivery_notes ] if @quote.delivery_notes.present? %>
  <% end %>
  <% if terms_lines.any? %>
    <section class="quote-section-block">
      <h3><%= t("quote_document.sections.terms_and_conditions") %></h3>
      <% terms_lines.each do |label, value| %>
        <p><strong><%= label %>:</strong> <%= value %></p>
      <% end %>
    </section>
  <% end %>

  <% if active_template.show_notes && @quote.notes.present? %>
    <section class="quote-section-block">
      <h3><%= t("quote_document.labels.notes") %></h3>
      <p><%= simple_format(@quote.notes) %></p>
    </section>
  <% end %>
  <% company_documents = @quote.company.company_documents.includes(file_attachment: :blob).ordered %>
  <% if company_documents.any? %>
    <section class="quote-section-block">
      <h3><%= t("quote_document.sections.company_credentials") %></h3>
      <% company_documents.each do |document| %>
        <p><strong><%= document.title %></strong> <span class="quote-form-hint">(<%= document.document_type_label %>)</span></p>
      <% end %>
    </section>
  <% end %>

  <% footer_note = @template.resolved_footer_note(@document_kind) %>
  <% signature_image_url = template_signature_image_url(active_template) %>
  <% signature_name = template_signature_name(active_template) %>
  <% show_signature_section = active_template.show_signature_block && (signature_image_url.present? || signature_name.present?) %>
  <% if footer_note.present? %>
    <section class="quote-section-block">
      <h3><%= t("quote_document.sections.footer", default: "Footer") %></h3>
      <div><%= simple_format(footer_note) %></div>
    </section>
  <% end %>
  <% if show_signature_section %>
    <section class="quote-section-block quote-signature-block">
      <h3><%= t("quote_document.sections.signature") %></h3>
      <% if signature_image_url.present? %>
        <p><img src="<%= signature_image_url %>" alt="<%= t("quote_document.labels.sales_signature", default: "Sales signature") %>" class="quote-sales-signature-image"></p>
      <% end %>
      <% if signature_name.present? %>
        <p><strong><%= t("quote_document.labels.authorized_by") %>:</strong> <%= signature_name %></p>
      <% end %>
    </section>
  <% end %>
  <% if active_template.show_saas_branding %>
    <p class="quote-public-footnote"><%= active_template.saas_branding_footer_text %></p>
  <% end %>
  <% end %>
</div>

<div class="quote-toolbar quote-toolbar-surface app-toolbar-surface app-toolbar-surface--compact">
  <div class="quote-toolbar-left">
    <% if @quote.can_edit_revision? %>
      <div class="quote-template-picker">
        <label for="template_select_<%= @quote.id %>"><%= t("quotes.view.show.toolbar.template") %></label>
        <%= select_tag :template_id,
                       options_from_collection_for_select(@template_options, :id, :name, @template.id),
                       id: "template_select_#{@quote.id}",
                       class: "js-template-select #{ui_input_classes}",
                       data: { update_url: update_template_quote_path(@quote), doc: @document_kind, searchable_select: true, search_placeholder: t("quotes.view.show.toolbar.search_template") } %>
      </div>
    <% end %>

    <details class="quote-toolbar-export">
      <summary class="<%= ui_button_classes(:secondary) %> quote-btn quote-btn-secondary"><%= t("quotes.view.show.toolbar.export") %></summary>
      <div class="quote-toolbar-export-menu">
        <%= button_to t("quotes.view.show.toolbar.download_pdf"),
                      export_pdf_quote_path(@quote),
                      method: :get,
                      params: { doc: @document_kind, document_kind: @document_kind },
                      form: { data: { turbo: false } },
                      class: "#{ui_button_classes(:secondary)} quote-btn quote-btn-secondary" %>
        <%= link_to t("quotes.view.show.toolbar.download_excel"), export_xlsx_quote_path(@quote, doc: @document_kind), class: "#{ui_button_classes(:secondary)} quote-btn quote-btn-secondary", data: { turbo: false } %>
      </div>
    </details>
  </div>

  <div class="quote-toolbar-right">
    <div class="quote-toolbar-right-secondary">
      <% if @quote.can_edit_revision? %>
        <%= link_to t("quotes.view.show.toolbar.edit"), edit_quote_path(@quote), class: "#{ui_button_classes(:secondary)} quote-btn quote-btn-secondary" %>
      <% end %>
      <% if @quote.can_create_new_revision? %>
        <%= button_to t("quotes.view.show.toolbar.new_revision"), duplicate_quote_path(@quote), method: :post, form: { data: { turbo: false } }, class: "#{ui_button_classes(:secondary)} quote-btn quote-btn-secondary" %>
      <% end %>
      <% if @quote.can_reopen? %>
        <%= button_to t("quotes.view.show.toolbar.reopen_quote"),
                      reopen_quote_path(@quote),
                      method: :post,
                      form: { data: { turbo_confirm: t("quotes.view.show.toolbar.reopen_confirm") } },
                      class: "#{ui_button_classes(:secondary)} quote-btn quote-btn-secondary" %>
      <% end %>
      <% if @quote.can_copy_and_reprice? %>
        <%= button_to t("quotes.view.show.toolbar.copy_reprice"), duplicate_and_reprice_quote_path(@quote), method: :post, form: { data: { turbo: false } }, class: "#{ui_button_classes(:secondary)} quote-btn quote-btn-secondary" %>
      <% end %>
      <% if @quote.can_switch_document? %>
        <% if @document_kind == "pi" %>
          <%= link_to t("quotes.view.show.toolbar.switch_to_quotation"), quote_path(@quote, doc: "quote", document_kind: "quote"), class: "#{ui_button_classes(:secondary)} quote-btn quote-btn-secondary" %>
        <% else %>
          <%= link_to t("quotes.view.show.toolbar.switch_to_pi"), quote_path(@quote, doc: "pi", document_kind: "pi"), class: "#{ui_button_classes(:secondary)} quote-btn quote-btn-secondary" %>
        <% end %>
      <% end %>
    </div>
    <div class="quote-toolbar-right-primary">
      <% if @quote.can_send_reminder? %>
        <% if ENV["SKIP_TURNSTILE_VERIFICATION"] == "true" %>
          <%= button_to t("quotes.view.show.toolbar.send_reminder"),
                        send_reminder_quote_path(@quote, doc: @document_kind),
                        method: :post,
                        class: "#{ui_button_classes(:secondary)} quote-btn quote-btn-secondary" %>
        <% else %>
          <% reminder_form_id = "quote-reminder-form-#{@quote.id}" %>
          <% reminder_modal_id = "quote-reminder-modal-#{@quote.id}" %>
          <% reminder_response_id = "quote-reminder-turnstile-response-#{@quote.id}" %>
          <div class="quote-reminder-verification">
            <%= form_with url: send_reminder_quote_path(@quote, doc: @document_kind),
                          method: :post,
                          local: true,
                          html: { id: reminder_form_id, class: "quote-reminder-form", data: { turbo: false } } do %>
              <%= hidden_field_tag :cf_turnstile_response, "", id: reminder_response_id %>
              <button type="button"
                      class="<%= "#{ui_button_classes(:secondary)} quote-btn quote-btn-secondary js-quote-reminder-open" %>"
                      data-reminder-modal-id="<%= reminder_modal_id %>">
                <%= t("quotes.view.show.toolbar.send_reminder") %>
              </button>
            <% end %>

            <div class="quote-turnstile-modal"
                 id="<%= reminder_modal_id %>"
                 hidden
                 data-reminder-form-id="<%= reminder_form_id %>"
                 data-reminder-response-id="<%= reminder_response_id %>">
              <div class="quote-turnstile-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="<%= "#{reminder_modal_id}-title" %>">
                <button type="button" class="quote-turnstile-modal__close js-quote-reminder-close" aria-label="<%= t("quotes.view.show.toolbar.close_verification") %>">×</button>
                <h3 id="<%= "#{reminder_modal_id}-title" %>"><%= t("quotes.view.show.toolbar.verify_before_reminder") %></h3>
                <p><%= t("quotes.view.show.toolbar.verify_before_reminder_hint") %></p>
                <div class="quote-turnstile-modal__loading js-quote-reminder-loading"><%= t("quotes.view.show.toolbar.loading_verification") %></div>
                <div class="quote-turnstile-modal__widget js-quote-reminder-widget" hidden></div>
                <div class="quote-turnstile-modal__success js-quote-reminder-success" hidden><%= t("quotes.view.show.toolbar.verified_sending") %></div>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
      <% if @quote.can_share_publicly? %>
        <div class="share-link-group">
          <button type="button"
                  class="quote-btn quote-btn-primary js-share-public-link"
                  data-share-url="<%= share_quote_path(@quote, doc: @document_kind, format: :json) %>">
            <%= t("quotes.view.show.toolbar.share_public_link") %>
          </button>
          <div class="share-link-panel" id="quote-share-panel" hidden>
            <div class="share-link-panel-message" id="quote-share-message"></div>
            <div class="share-link-panel-actions">
              <button type="button" class="share-link-panel-btn" id="quote-share-copy-btn"><%= t("quotes.view.show.toolbar.copy_link") %></button>
              <a href="#" target="_blank" rel="noopener" class="share-link-panel-btn is-link" id="quote-share-open-link"><%= t("quotes.view.show.toolbar.open") %></a>
            </div>
          </div>
        </div>
      <% end %>
      <% if @quote.can_delete_quote_family? %>
        <%= button_to t("quotes.view.show.toolbar.delete_quote"),
                      quote_path(@quote),
                      method: :delete,
                      form: { data: { turbo_confirm: t("quotes.view.show.toolbar.delete_confirm", quote_no: @quote.quote_no) },
                              onsubmit: "if (!confirm('#{j(t("quotes.view.show.toolbar.delete_final_warning"))}')) return false; if (prompt('#{j(t("quotes.view.show.toolbar.delete_prompt"))}') !== 'DELETE') return false;" },
                      class: "#{ui_button_classes(:danger)} quote-btn quote-btn-danger" %>
      <% end %>
    </div>
  </div>
</div>

<section class="quote-history app-surface">
  <div class="app-section-heading">
    <h3><%= t("quotes.view.show.history.title") %></h3>
    <span class="app-subtle-note"><%= t("quotes.view.show.history.subtitle") %></span>
  </div>
  <% revisions = @quote.customer.quotes.not_archived.where(quote_no: @quote.quote_no).order(revision_number: :desc).to_a %>
  <% latest_revision = revisions.first %>
  <p class="quote-history-meta">
    <span><strong><%= revisions.size %></strong> <%= t("quotes.view.show.history.revisions_count") %></span>
    <span><%= t("quotes.view.show.history.current_updated") %>: <strong><%= format_in_user_time(@quote.updated_at, current_user) %></strong></span>
  </p>
  <div class="quote-history-tabs">
    <% revisions.each do |q| %>
      <% is_current = q.id == @quote.id %>
      <% tab_class = "history-tab#{' active' if is_current}" %>
      <% label = "V#{q.revision_number}" %>
      <% if is_current %>
        <span class="<%= tab_class %>">
          <%= label %>
          <span class="history-tab-tag"><%= t("quotes.view.show.history.current") %></span>
          <% if latest_revision&.id == q.id %>
            <span class="history-tab-tag history-tab-tag-latest"><%= t("quotes.view.show.history.latest") %></span>
          <% end %>
        </span>
      <% else %>
        <%= link_to quote_path(q), class: tab_class do %>
          <%= label %>
          <% if latest_revision&.id == q.id %>
            <span class="history-tab-tag history-tab-tag-latest"><%= t("quotes.view.show.history.latest") %></span>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
  <% archivable_revisions = revisions.select(&:can_archive_revision?) %>
  <% if archivable_revisions.any? %>
    <div class="quote-history-archive-list">
      <% archivable_revisions.each do |q| %>
        <%= button_to t("quotes.view.show.history.archive_revision", revision: q.revision_number), archive_quote_path(q), method: :post, form: { data: { turbo_confirm: t("quotes.view.show.history.archive_confirm", revision: q.revision_number) } }, class: "#{ui_button_classes(:secondary)} quote-btn quote-btn-secondary" %>
      <% end %>
    </div>
  <% end %>
</section>

<script>
  (() => {
    const button = document.querySelector(".js-share-public-link");
    const panel = document.getElementById("quote-share-panel");
    const message = document.getElementById("quote-share-message");
    const copyButton = document.getElementById("quote-share-copy-btn");
    const openLink = document.getElementById("quote-share-open-link");
    const lastSharedAt = document.getElementById("quote-last-shared-at");
    if (!button || !panel || !message || !copyButton || !openLink || button.dataset.bound === "true") return;
    button.dataset.bound = "true";

    const csrf = document.querySelector("meta[name='csrf-token']")?.content;
    const sharePanelState = window.__quoteSharePanelState || {
      visible: false,
      message: "",
      isError: false,
      currentShareUrl: "",
      openHref: "#",
      openHidden: true
    };
    window.__quoteSharePanelState = sharePanelState;
    let currentShareUrl = "";

    const syncPanelState = () => {
      sharePanelState.visible = !panel.hidden;
      sharePanelState.message = message.textContent || "";
      sharePanelState.isError = panel.classList.contains("is-error");
      sharePanelState.currentShareUrl = currentShareUrl;
      sharePanelState.openHref = openLink.getAttribute("href") || "#";
      sharePanelState.openHidden = openLink.hidden;
    };

    const showPanel = (text, isError = false) => {
      message.textContent = text;
      panel.classList.toggle("is-error", isError);
      panel.hidden = false;
      syncPanelState();
    };

    const hidePanel = () => {
      panel.hidden = true;
      syncPanelState();
    };

    const copyText = async (text) => {
      try {
        if (navigator.clipboard?.writeText && window.isSecureContext) {
          await navigator.clipboard.writeText(text);
          return true;
        }
      } catch (_) {
        // Fallback to legacy copy path below.
      }

      try {
        const textarea = document.createElement("textarea");
        textarea.value = text;
        textarea.setAttribute("readonly", "");
        textarea.style.position = "fixed";
        textarea.style.top = "-9999px";
        textarea.style.left = "-9999px";
        document.body.appendChild(textarea);
        textarea.focus();
        textarea.select();
        const ok = document.execCommand("copy");
        document.body.removeChild(textarea);
        return !!ok;
      } catch (_) {
        return false;
      }
    };

    button.addEventListener("click", async () => {
      button.disabled = true;
      try {
        const response = await fetch(button.dataset.shareUrl, {
          method: "POST",
          headers: {
            "Accept": "application/json",
            "Content-Type": "application/json",
            "X-CSRF-Token": csrf || ""
          },
          credentials: "same-origin",
          body: JSON.stringify({})
        });

        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !payload.url) {
          throw new Error(payload.message || "<%= j(t("quotes.view.show.toolbar.unable_generate_public_link")) %>");
        }

        const copied = await copyText(payload.url);
        currentShareUrl = payload.url;
        try {
          const previewUrl = new URL(payload.url, window.location.origin);
          previewUrl.searchParams.set("preview", "1");
          openLink.href = previewUrl.toString();
        } catch (_) {
          const separator = payload.url.includes("?") ? "&" : "?";
          openLink.href = `${payload.url}${separator}preview=1`;
        }
        openLink.hidden = false;
        syncPanelState();
        if (lastSharedAt) {
          const now = new Date();
          const pad = (n) => String(n).padStart(2, "0");
          const stamp = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())} ${pad(now.getHours())}:${pad(now.getMinutes())}`;
          lastSharedAt.textContent = stamp;
        }
        if (copied) {
          showPanel("<%= j(t("quotes.view.show.toolbar.public_link_ready_copied")) %>");
          window.showAppToast?.("<%= j(t("quotes.view.show.toolbar.public_link_copied")) %>", "success");
        } else {
          showPanel("<%= j(t("quotes.view.show.toolbar.public_link_ready_manual")) %>");
          window.showAppToast?.("<%= j(t("quotes.view.show.toolbar.public_link_ready_manual")) %>", "warn");
        }
        window.setTimeout(() => window.refreshQuoteState?.(true), 120);
      } catch (error) {
        currentShareUrl = "";
        openLink.href = "#";
        openLink.hidden = true;
        syncPanelState();
        showPanel(error.message || "<%= j(t("quotes.view.show.toolbar.share_failed")) %>", true);
        window.showAppToast?.(error.message || "<%= j(t("quotes.view.show.toolbar.share_failed")) %>", "error");
      } finally {
        button.disabled = false;
      }
    });

    copyButton.addEventListener("click", async () => {
      if (!currentShareUrl) return;
      const copied = await copyText(currentShareUrl);
      showPanel(copied ? "<%= j(t("quotes.view.show.toolbar.link_copied")) %>" : "<%= j(t("quotes.view.show.toolbar.copy_failed_browser")) %>", !copied);
      window.showAppToast?.(copied ? "<%= j(t("quotes.view.show.toolbar.link_copied")) %>" : "<%= j(t("quotes.view.show.toolbar.copy_failed_browser")) %>", copied ? "success" : "error");
    });

    openLink.addEventListener("click", () => {
      hidePanel();
    });

    document.addEventListener("click", (event) => {
      if (panel.hidden) return;
      if (event.target.closest(".share-link-group")) return;
      hidePanel();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") hidePanel();
    });

    currentShareUrl = sharePanelState.currentShareUrl || "";
    openLink.href = sharePanelState.openHref || "#";
    openLink.hidden = sharePanelState.openHidden !== false;
    if (sharePanelState.visible) {
      showPanel(sharePanelState.message || "<%= j(t("quotes.view.show.toolbar.public_link_ready")) %>", !!sharePanelState.isError);
    } else {
      hidePanel();
    }
  })();

  (() => {
    const exportMenus = document.querySelectorAll(".quote-toolbar-export");
    if (!exportMenus.length) return;

    const closeAll = () => {
      exportMenus.forEach((menu) => {
        menu.removeAttribute("open");
      });
    };

    document.addEventListener("click", (event) => {
      if (event.target.closest(".quote-toolbar-export")) return;
      closeAll();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      closeAll();
    });
  })();
</script>
