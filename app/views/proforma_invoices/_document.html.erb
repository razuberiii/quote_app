<% snapshot = pi.snapshot.deep_stringify_keys %><% items = Array(snapshot["quote_items"]) %>
<article class="pi-document">
  <header class="pi-document__header"><div><span class="pi-logo"><%= pi.company.name.first %></span><strong><%= pi.company.name %></strong></div><div><p>PROFORMA INVOICE</p><h2><%= pi.number %></h2></div></header>
  <section class="pi-parties"><div><span>Seller</span><h3><%= pi.company.name %></h3><p><%= pi.company.address %></p><p><%= pi.company.email %></p></div><div><span>Buyer</span><h3><%= snapshot["customer_name"] %></h3><p><%= snapshot["customer_contact_name"] %></p><p><%= snapshot["customer_address"] %></p><p><%= snapshot["customer_email"] %></p></div><dl><div><dt>PI date</dt><dd><%= pi.created_at.to_date %></dd></div><div><dt>Quote</dt><dd><%= pi.quote.quote_no %></dd></div><div><dt>Accepted</dt><dd><%= pi.quote_acceptance.accepted_at.to_date %></dd></div><div><dt>Currency</dt><dd><%= pi.currency %></dd></div></dl></section>
  <section class="pi-items"><div class="pi-items__head"><span>Product</span><span>Qty</span><span>Unit price</span><span>Amount</span></div><% items.each do |item| %><div class="pi-item"><div><strong><%= item["product_name"] || item["description"] %></strong><small><%= item["sku_snapshot"] %></small><% if Array(item["specifications"]).any? %><p><%= Array(item["specifications"]).map { |spec| "#{spec['key'] || spec['name']}: #{spec['value']}" }.join(" · ") %></p><% end %></div><span><%= item["quantity"] %> <%= item["unit_snapshot"] %></span><span><%= pi.currency %> <%= number_with_delimiter(item["unit_price"]) %></span><strong><%= pi.currency %> <%= number_with_delimiter(item["amount"] || item["line_total"]) %></strong></div><% end %></section>
  <section class="pi-closing"><div><h3>Shipping & payment</h3><dl><div><dt>Incoterm</dt><dd><%= snapshot["trade_term"].presence || "As agreed" %></dd></div><div><dt>Payment</dt><dd><%= snapshot["payment_term"].presence || "As agreed" %></dd></div><div><dt>Delivery</dt><dd><%= snapshot["delivery_notes"].presence || "As agreed" %></dd></div></dl></div><aside><p><span>Accepted quotation</span><strong><%= pi.currency %> <%= number_with_delimiter(pi.total) %></strong></p><p class="pi-total"><span>Amount due</span><strong><%= pi.currency %> <%= number_with_delimiter(pi.total) %></strong></p><small>Generated from immutable acceptance snapshot</small></aside></section>
  <footer><span><%= pi.company.name %></span><span><%= pi.number %></span><span>Commercial document · Rubusoo</span></footer>
</article>
