<style>
  :root{--rb-ink:#17211c;--rb-green:#183f32;--rb-muted:#657269;--rb-line:#dfe4e0}.pi-document{padding:10mm;background:#fff;color:var(--rb-ink);font-family:Arial,sans-serif}.pi-document__header{display:flex;justify-content:space-between;padding-bottom:10mm;border-bottom:2px solid var(--rb-ink)}.pi-document__header>div{display:flex;gap:3mm;align-items:center}.pi-logo{display:grid;width:10mm;height:10mm;place-items:center;background:var(--rb-green);color:#fff;font-weight:800}.pi-document__header>div:last-child{display:block;text-align:right}.pi-document__header p{margin:0;color:var(--rb-green);font-size:8pt;font-weight:800;letter-spacing:.14em}.pi-document__header h2{margin:2mm 0 0;font:700 16pt Georgia,serif}.pi-parties{display:grid;grid-template-columns:1fr 1fr .8fr;gap:8mm;padding:9mm 0}.pi-parties>div>span,.pi-parties p,.pi-item small,.pi-item p,.pi-closing dt,.pi-closing aside small{color:var(--rb-muted);font-size:8pt}.pi-parties h3{margin:2mm 0;font:700 11pt Georgia,serif}.pi-parties p{margin:1mm 0}.pi-parties dl{margin:0}.pi-parties dl div{display:flex;justify-content:space-between;padding:2mm 0;border-bottom:1px solid var(--rb-line);font-size:8pt}.pi-parties dd{margin:0;font-weight:700}.pi-items{border-top:1px solid var(--rb-ink)}.pi-items__head,.pi-item{display:grid;grid-template-columns:minmax(0,2fr) .4fr .7fr .7fr;gap:4mm;align-items:center}.pi-items__head{padding:3mm 0;color:var(--rb-muted);font-size:7pt;font-weight:800;text-transform:uppercase}.pi-item{padding:4mm 0;border-top:1px solid var(--rb-line);font-size:9pt;break-inside:avoid}.pi-item small,.pi-item p{display:block;margin:1mm 0 0}.pi-closing{display:grid;grid-template-columns:1fr .75fr;gap:15mm;margin-top:10mm;padding-top:7mm;border-top:1px solid var(--rb-ink);break-inside:avoid}.pi-closing h3{font:700 13pt Georgia,serif}.pi-closing dl div{display:grid;grid-template-columns:30mm 1fr;padding:2mm 0;font-size:8pt}.pi-closing dd{margin:0;font-weight:700}.pi-closing aside p{display:flex;justify-content:space-between;padding:3mm 0}.pi-closing aside .pi-total{border-block:1px solid var(--rb-ink)}.pi-total strong{color:var(--rb-green);font:700 13pt Georgia,serif}.pi-document>footer{display:flex;justify-content:space-between;margin-top:14mm;padding-top:4mm;border-top:1px solid var(--rb-line);color:var(--rb-muted);font-size:7pt;text-transform:uppercase}
</style>
<%= render "document", pi: @pi %>
