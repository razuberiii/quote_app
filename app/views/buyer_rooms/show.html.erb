<% content_for :title, "#{@revision.quote.quote_no} · #{@revision.company.name}" %>
<% items = Array(@snapshot["quote_items"]) %>
<% shipping = @snapshot["shipping_amount"].to_d %><% tax = @snapshot["tax_amount"].to_d %><% discount = @snapshot["discount_amount"].to_d %>
<main class="buyer-room buyer-storefront" data-controller="buyer-room" data-buyer-room-currency-value="<%= @revision.currency %>" data-buyer-room-shipping-value="<%= shipping %>" data-buyer-room-tax-value="<%= tax %>" data-buyer-room-discount-value="<%= discount %>">
  <header class="buyer-header"><a class="brand" href="#"><span><%= @revision.company.name %></span></a><div class="buyer-header__actions"><div class="buyer-header__trust"><span><%= t("self_service.buyer_room.secure") %></span><strong><%= @revision.quote.quote_no %> · <%= t("self_service.buyer_room.revision", number: @revision.number) %></strong></div><%= render "layouts/theme_switch" %></div></header>
  <% if controller_name == "demos" %><aside class="buyer-demo-note"><strong><%= t("self_service.buyer_room.demo_title") %></strong><span><%= t("self_service.buyer_room.demo_help") %></span></aside><% end %>

  <% if @state != "normal" %><section class="state-banner state-banner--<%= @state %>"><strong><%= t("self_service.buyer_room.state_#{@state == 'preview' ? 'preview' : @state == 'accepted' ? 'accepted' : 'readonly'}") %></strong><span><%= t("self_service.buyer_room.#{@state == 'accepted' ? 'accepted_help' : @state == 'preview' ? 'preview_help' : 'readonly_help'}") %></span></section><% end %>
  <% if params[:event] == "accepted" || @state == "accepted" %>
    <section class="buyer-confirmation"><span>✓</span><p class="eyebrow"><%= t("self_service.buyer_room.accepted_kicker") %></p><h1><%= t("self_service.buyer_room.accepted_title") %></h1><p><%= t("self_service.buyer_room.accepted_body") %></p><dl><div><dt><%= t("self_service.buyer_room.quote") %></dt><dd><%= @revision.quote.quote_no %></dd></div><div><dt><%= t("self_service.buyer_room.version") %></dt><dd><%= @revision.number %></dd></div><div><dt><%= t("self_service.buyer_room.accepted_total") %></dt><dd><%= @revision.currency %> <%= number_with_delimiter(@revision.quote_acceptance&.total || @revision.total) %></dd></div></dl></section>
  <% else %>
    <section class="buyer-cover">
      <div><p class="eyebrow"><%= t("self_service.buyer_room.prepared_for", customer: @revision.quote.customer.name) %></p><h1><%= @snapshot["custom_title"].presence || t("self_service.buyer_room.default_title") %></h1><p class="buyer-intro"><%= @snapshot["notes"].presence || t("self_service.buyer_room.default_intro") %></p><div class="buyer-contact-line"><span><%= t("self_service.buyer_room.prepared_by") %></span><strong><%= @revision.company.name %></strong><% if @revision.company.email.present? %><span>·</span><%= mail_to @revision.company.email, @revision.company.email %><% end %></div></div>
      <dl class="quote-meta"><div><dt><%= t("self_service.buyer_room.quote") %></dt><dd><%= @revision.quote.quote_no %></dd></div><div><dt><%= t("self_service.buyer_room.version") %></dt><dd><%= @state == "preview" ? t("self_service.buyer_room.preview") : @revision.number %></dd></div><div><dt><%= t("self_service.buyer_room.valid_until") %></dt><dd><%= @revision.expires_at&.to_date || t("self_service.buyer_room.open") %></dd></div><div><dt><%= t("self_service.buyer_room.currency") %></dt><dd><%= @revision.currency %></dd></div></dl>
    </section>

    <div class="buyer-grid">
      <article class="buyer-document">
        <section class="doc-section buyer-products"><div class="buyer-section-heading"><p class="section-kicker"><%= t("self_service.buyer_room.products_kicker") %></p><h2><%= t("self_service.buyer_room.products_title") %></h2><p><%= t("self_service.buyer_room.products_help") %></p></div>
          <% items.each_with_index do |item, index| %>
            <% selectable = item["selection_mode"] == "selectable" %>
            <article class="buyer-product buyer-product--visual">
              <div class="buyer-product__image"><% if item["product_image_path"].present? %><%= image_tag item["product_image_path"], alt: item["product_name"] || item["description"] %><% else %><span><%= (index + 1).to_s.rjust(2,"0") %></span><small><%= t("self_service.buyer_room.product_image") %></small><% end %></div>
              <div class="product-copy"><p class="product-index"><%= t("self_service.buyer_room.item", number: (index + 1).to_s.rjust(2,"0")) %> · <%= item["sku_snapshot"].presence || t("self_service.buyer_room.configured") %></p><h3><%= item["product_name"].presence || item["description"] %></h3><p><%= item["description"] unless item["description"] == item["product_name"] %></p>
                <% if Array(item["specifications"]).any? %><dl class="buyer-spec-grid"><% Array(item["specifications"]).each do |spec| %><div><dt><%= spec["key"] || spec[:key] || spec["name"] %></dt><dd><span><%= spec["value"] || spec[:value] %></span><button type="button" data-action="buyer-room#openQuestion" data-context="spec:<%= index %>:<%= spec['key'] || spec[:key] %>" data-context-label="<%= item['product_name'] || item['description'] %> · <%= spec['key'] || spec[:key] %>"><%= t("self_service.buyer_room.ask_short") %></button></dd></div><% end %></dl><% end %>
                <div class="buyer-product__controls"><label><span><%= t("self_service.buyer_room.quantity") %> <%= selectable ? t("self_service.buyer_room.selectable") : t("self_service.buyer_room.fixed") %></span><input type="number" min="1" value="<%= item['quantity'] %>" <%= "readonly" unless selectable %> data-buyer-room-target="quantity" data-index="<%= index %>" data-unit-price="<%= item['unit_price'] %>" data-action="input->buyer-room#recalculate"></label><div><span><%= t("self_service.buyer_room.unit_price") %></span><strong><%= @revision.currency %> <%= number_with_delimiter(item["unit_price"]) %></strong></div><div><span><%= t("self_service.buyer_room.lead_time") %></span><strong><%= item["lead_time_snapshot"].presence || t("self_service.buyer_room.see_terms") %></strong></div></div>
                <% if Array(item["addon_charges"]).any? %><fieldset class="buyer-accessories"><legend><%= t("self_service.buyer_room.optional_accessories") %></legend><% Array(item["addon_charges"]).each do |addon| %><label><input type="checkbox" value="<%= index %>:<%= addon['name'] || addon[:name] %>" data-buyer-room-target="accessory" data-price="<%= addon['amount'] || addon[:amount] %>" data-action="change->buyer-room#recalculate"><span><strong><%= addon["name"] || addon[:name] %></strong><small>＋ <%= @revision.currency %> <%= number_with_delimiter(addon["amount"] || addon[:amount]) %></small></span></label><% end %></fieldset><% end %>
                <button class="text-action" type="button" data-action="buyer-room#openQuestion" data-context="product:<%= index %>" data-context-label="<%= item['product_name'] || item['description'] %>"><%= t("self_service.buyer_room.ask_product") %></button>
              </div>
            </article>
          <% end %>
        </section>

        <% if items.any? { |item| Array(item["addon_charges"]).any? } %><section class="doc-section buyer-plans"><div class="buyer-section-heading"><p class="section-kicker"><%= t("self_service.buyer_room.plans_kicker") %></p><h2><%= t("self_service.buyer_room.plans_title") %></h2></div><div class="buyer-plan-grid"><button type="button" data-buyer-room-target="plan" data-plan="essential" data-action="buyer-room#selectPlan"><span><%= t("self_service.buyer_room.essential") %></span><strong><%= t("self_service.buyer_room.essential_title") %></strong><small><%= t("self_service.buyer_room.essential_help") %></small></button><button type="button" class="is-selected" data-buyer-room-target="plan" data-plan="recommended" data-action="buyer-room#selectPlan"><span><%= t("self_service.buyer_room.recommended") %></span><strong><%= t("self_service.buyer_room.recommended_title") %></strong><small><%= t("self_service.buyer_room.recommended_help") %></small><em><%= t("self_service.buyer_room.seller_choice") %></em></button><button type="button" data-buyer-room-target="plan" data-plan="complete" data-action="buyer-room#selectPlan"><span><%= t("self_service.buyer_room.complete") %></span><strong><%= t("self_service.buyer_room.complete_title") %></strong><small><%= t("self_service.buyer_room.complete_help") %></small></button></div></section><% end %>

        <section class="doc-section buyer-commercial"><div class="buyer-section-heading"><p class="section-kicker"><%= t("self_service.buyer_room.terms_kicker") %></p><h2><%= t("self_service.buyer_room.terms_title") %></h2></div><dl class="terms-grid"><div><dt><%= t("self_service.buyer_room.incoterm") %></dt><dd><%= @snapshot["trade_term"].presence || t("self_service.buyer_room.pending") %></dd></div><div><dt><%= t("self_service.buyer_room.payment") %></dt><dd><%= @snapshot["payment_term"].presence || t("self_service.buyer_room.pending") %></dd></div><div><dt><%= t("self_service.buyer_room.delivery") %></dt><dd><%= @snapshot["delivery_notes"].presence || t("self_service.buyer_room.agreed") %></dd></div><div><dt><%= t("self_service.buyer_room.validity") %></dt><dd><%= @revision.expires_at&.to_date || "—" %></dd></div><div><dt><%= t("self_service.buyer_room.shipping") %></dt><dd><%= @revision.currency %> <%= number_with_delimiter(shipping) %></dd></div><div><dt><%= t("self_service.buyer_room.packaging") %></dt><dd><%= items.filter_map { |item| item["packing_snapshot"].presence }.uniq.join(", ").presence || t("self_service.buyer_room.export_packaging") %></dd></div></dl><% if @snapshot["terms_text"].present? %><div class="buyer-terms-copy"><%= simple_format(@snapshot["terms_text"]) %></div><% end %><button class="text-action" type="button" data-action="buyer-room#openQuestion" data-context="term:commercial" data-context-label="<%= t("self_service.buyer_room.terms_title") %>"><%= t("self_service.buyer_room.ask_terms") %></button></section>
      </article>

      <aside class="selection-panel"><p class="section-kicker"><%= t("self_service.buyer_room.your_selection") %></p><h2><%= t("self_service.buyer_room.summary") %></h2><div class="selection-panel__meta"><span><%= t("self_service.buyer_room.product_count", count: items.size) %></span><span><%= t("self_service.buyer_room.revision", number: @revision.number) %></span></div><div class="selection-lines"><% items.each do |item| %><p><span><%= item["product_name"].presence || item["description"] %><small><%= item["quantity"] %> × <%= @revision.currency %> <%= item["unit_price"] %></small></span></p><% end %><% if shipping.positive? %><p><span><%= t("self_service.buyer_room.shipping") %></span><strong><%= @revision.currency %> <%= number_with_delimiter(shipping) %></strong></p><% end %></div><div class="total-row"><span><%= t("self_service.buyer_room.total") %><small><%= t("self_service.buyer_room.total_help") %></small></span><strong data-buyer-room-target="total"><%= @revision.currency %> <%= number_with_delimiter(@revision.total) %></strong></div>
        <% if @revision.actionable? %><button class="button button--primary button--full" data-action="buyer-room#openAccept"><%= t("self_service.buyer_room.accept") %></button><button class="button button--secondary button--full" data-action="buyer-room#openChanges"><%= t("self_service.buyer_room.request_changes") %></button><button class="text-action" data-action="buyer-room#openQuestion" data-context="quote" data-context-label="quote"><%= t("self_service.buyer_room.ask") %></button><% end %><% unless @state == "preview" %><div class="selection-panel__downloads"><%= link_to t("self_service.buyer_room.download"), buyer_room_pdf_path(@revision.secure_token), data: { turbo: false } %><a href="#studio-attachments"><%= t("self_service.buyer_room.attachments") %></a></div><% end %>
      </aside>
    </div>
  <% end %>

  <dialog class="rubusoo-dialog" data-buyer-room-target="questionDialog"><form method="post" action="<%= buyer_room_questions_path(@revision.secure_token) %>"><%= hidden_field_tag :authenticity_token, form_authenticity_token %><input type="hidden" name="context_type" value="quote"><input type="hidden" name="context_key" data-buyer-room-target="questionContext"><p class="section-kicker"><%= t("self_service.buyer_room.question_about") %></p><h2 class="dialog-context"><%= t("self_service.buyer_room.entire_quote") %></h2><label class="field-label"><%= t("self_service.buyer_room.your_name") %></label><input name="buyer_name" class="input"><label class="field-label"><%= t("self_service.buyer_room.work_email") %></label><input type="email" name="buyer_email" class="input"><label class="field-label"><%= t("self_service.buyer_room.question") %></label><textarea name="body" required class="textarea" placeholder="<%= t("self_service.buyer_room.question_placeholder") %>"></textarea><div class="dialog-actions"><button type="button" class="button button--ghost" data-action="buyer-room#close"><%= t("self_service.buyer_room.cancel") %></button><button class="button button--primary"><%= t("self_service.buyer_room.send_question") %></button></div></form></dialog>
  <dialog class="rubusoo-dialog" data-buyer-room-target="changesDialog"><form method="post" action="<%= buyer_room_request_changes_path(@revision.secure_token) %>" enctype="multipart/form-data"><%= hidden_field_tag :authenticity_token, form_authenticity_token %><div data-buyer-room-target="selectionCopy"></div><p class="section-kicker"><%= t("self_service.buyer_room.changes_kicker") %></p><h2><%= t("self_service.buyer_room.changes_title") %></h2><p><%= t("self_service.buyer_room.changes_help") %></p><div class="dialog-two"><input name="buyer_name" placeholder="<%= t("self_service.buyer_room.your_name") %>" class="input"><input type="email" name="buyer_email" placeholder="<%= t("self_service.buyer_room.work_email") %>" class="input"></div><textarea name="message" required class="textarea" placeholder="<%= t("self_service.buyer_room.changes_placeholder") %>"></textarea><label class="dialog-upload"><%= t("self_service.buyer_room.supporting_file") %> <input type="file" name="attachment"></label><div class="dialog-actions"><button type="button" class="button button--ghost" data-action="buyer-room#close"><%= t("self_service.buyer_room.cancel") %></button><button class="button button--primary"><%= t("self_service.buyer_room.send_request") %></button></div></form></dialog>
  <dialog class="rubusoo-dialog" data-buyer-room-target="acceptDialog"><form method="post" action="<%= buyer_room_accept_path(@revision.secure_token) %>" data-controller="acceptance-motion" data-action="submit->acceptance-motion#lock" data-acceptance-motion-locking-value="<%= t("self_service.buyer_room.locking") %>" data-acceptance-motion-recording-value="<%= t("self_service.buyer_room.recording") %>"><%= hidden_field_tag :authenticity_token, form_authenticity_token %><div data-buyer-room-target="selectionCopy"></div><p class="section-kicker"><%= t("self_service.buyer_room.acceptance_kicker") %></p><h2><%= t("self_service.buyer_room.acceptance_title", number: @revision.number) %></h2><p><%= t("self_service.buyer_room.acceptance_help") %> <strong data-buyer-room-target="total"></strong></p><div class="dialog-two"><input name="name" required placeholder="<%= t("self_service.buyer_room.full_name") %>" class="input"><input type="email" name="email" required placeholder="<%= t("self_service.buyer_room.work_email") %>" class="input"><input name="job_title" placeholder="<%= t("self_service.buyer_room.job_title") %>" class="input"><input name="po_number" placeholder="<%= t("self_service.buyer_room.po_number") %>" class="input"></div><textarea name="note" placeholder="<%= t("self_service.buyer_room.note") %>" class="textarea"></textarea><label class="accept-check"><input type="checkbox" required> <%= t("self_service.buyer_room.authorization") %></label><p class="acceptance-lock-state" hidden data-acceptance-motion-target="state"><%= t("self_service.buyer_room.locking") %></p><div class="dialog-actions"><button type="button" class="button button--ghost" data-action="buyer-room#close"><%= t("self_service.buyer_room.cancel") %></button><button class="button button--primary"><%= t("self_service.buyer_room.confirm_acceptance") %></button></div></form></dialog>
</main>
