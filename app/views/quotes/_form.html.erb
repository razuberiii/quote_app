      function syncSpecOrderFromSummary() {
        if (!specSummary || !specsInput) return;
        const lines = Array.from(specSummary.querySelectorAll(".quote-kv-chip"))
          .map((chip) => String(chip.textContent || "").trim())
          .filter(Boolean);
        if (!lines.length) return;
        specsInput.value = lines.join("\n");
        setSpecEditorFromText(specsInput.value);
      }

      function syncAddonOrderFromSummary() {
        if (!addonSummary || !addonInput) return;
        const lines = Array.from(addonSummary.querySelectorAll(".quote-kv-chip"))
          .map((chip) => String(chip.textContent || "").trim())
          .filter(Boolean);
        if (!lines.length) return;
        addonInput.value = lines.join("\n");
