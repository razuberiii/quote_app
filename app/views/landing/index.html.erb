<main class="product-landing" data-controller="product-reveal">
  <% hero_lines = t("self_service.marketing.hero.title_lines") %>
  <section class="product-hero" data-controller="product-story" data-product-story-labels-value="<%= t('self_service.marketing.hero.statuses').to_json %>"><div class="product-hero__copy"><p class="eyebrow"><%= t("self_service.marketing.hero.eyebrow") %></p><h1 class="hero-fixed-headline" aria-label="<%= t('self_service.marketing.hero.title') %>"><span><%= hero_lines.first %></span><span class="hero-outcome-line"><%= hero_lines.second %></span></h1><p><%= t("self_service.marketing.hero.body") %></p><div><%= link_to t("self_service.marketing.hero.primary"), new_user_registration_path, class: "button button--primary" %><%= link_to t("self_service.marketing.hero.secondary"), buyer_demo_path, class: "button button--secondary" %></div><small><%= t("self_service.marketing.hero.proof") %></small></div>
    <div class="product-hero__product" aria-label="<%= t('self_service.marketing.hero.workflow_label') %>">
      <div class="product-story__track" aria-hidden="true"><i data-product-story-target="progress"></i></div>
      <article class="hero-inquiry is-active" data-product-story-target="step"><span><%= t("self_service.marketing.hero.story.inquiry_kicker") %></span><p><%= t("self_service.marketing.hero.story.inquiry_html").html_safe %></p><small><%= t("self_service.marketing.hero.story.inquiry_source") %></small></article>
      <article class="hero-extraction" data-product-story-target="step"><header><span><%= t("self_service.marketing.hero.story.draft_kicker") %></span><strong><%= t("self_service.marketing.hero.story.draft_state") %></strong></header><p><span><%= t("self_service.marketing.hero.story.product") %></span><strong><%= t("self_service.marketing.hero.story.product_value") %></strong></p><p><span><%= t("self_service.marketing.hero.story.catalog") %></span><strong><%= t("self_service.marketing.hero.story.catalog_value") %></strong></p><p class="is-missing"><span><%= t("self_service.marketing.hero.story.freight") %></span><strong><%= t("self_service.marketing.hero.story.price_required") %></strong></p></article>
      <article class="hero-room" data-product-story-target="step"><span><%= t("self_service.marketing.hero.story.published_kicker") %></span><h2><%= t("self_service.marketing.hero.story.room_title") %></h2><div><strong><%= t("self_service.marketing.hero.story.scope") %></strong><small><%= t("self_service.marketing.hero.story.scope_value") %></small></div><p><span><%= t("self_service.marketing.hero.story.accepted") %></span><strong>USD 38,450</strong></p></article>
      <footer><span data-product-story-target="status"><%= t("self_service.marketing.hero.statuses").first %></span><div><button type="button" data-action="product-story#previous" aria-label="<%= t('self_service.marketing.hero.previous') %>">←</button><button type="button" data-action="product-story#next" aria-label="<%= t('self_service.marketing.hero.next') %>">→</button></div></footer>
    </div>
  </section>

  <section class="product-problem" id="product-story"><header><p class="eyebrow"><%= t("self_service.marketing.problem.eyebrow") %></p><h2><%= t("self_service.marketing.problem.title") %></h2></header><div><% 3.times do |index| %><article><span><%= format("%02d", index + 1) %></span><h3><%= t("self_service.marketing.problem.items.#{index}.title") %></h3><p><%= t("self_service.marketing.problem.items.#{index}.body") %></p></article><% end %></div></section>

  <section class="product-feature"><div><p class="eyebrow"><%= t("self_service.marketing.intake.eyebrow") %></p><h2><%= t("self_service.marketing.intake.title") %></h2><p><%= t("self_service.marketing.intake.body") %></p><ul><% t("self_service.marketing.intake.points").each do |point| %><li><%= point %></li><% end %></ul></div><div class="feature-extract"><blockquote><%= t("self_service.marketing.intake.sample") %></blockquote><p><span><%= t("self_service.marketing.intake.voltage") %></span><strong>380V / 50Hz</strong><small><%= t("self_service.marketing.intake.voltage_source") %></small></p><p><span><%= t("self_service.marketing.intake.material") %></span><strong><%= t("self_service.marketing.intake.material_value") %></strong><small><%= t("self_service.marketing.intake.material_source") %></small></p><p class="is-missing"><span><%= t("self_service.marketing.intake.freight") %></span><strong><%= t("self_service.marketing.intake.freight_value") %></strong><small><%= t("self_service.marketing.intake.freight_help") %></small></p></div></section>

  <section class="product-feature is-dark"><div><p class="eyebrow"><%= t("self_service.marketing.studio.eyebrow") %></p><h2><%= t("self_service.marketing.studio.title") %></h2><p><%= t("self_service.marketing.studio.body") %></p></div><div class="feature-studio"><aside><%= t("self_service.marketing.studio.outline_html").html_safe %></aside><article><span><%= t("self_service.marketing.studio.prepared") %></span><h3><%= t("self_service.marketing.studio.quote_title") %></h3><div><%= t("self_service.marketing.studio.product") %> <strong>USD 18,900</strong></div><div><%= t("self_service.marketing.studio.kit") %> <strong><%= t("self_service.marketing.studio.included") %></strong></div><p><%= t("self_service.marketing.studio.terms") %></p></article><aside><span><%= t("self_service.marketing.studio.total") %></span><strong>USD 22,640</strong><small><%= t("self_service.marketing.studio.ready") %></small><button type="button"><%= t("self_service.marketing.studio.preview") %></button></aside></div></section>

  <section class="product-feature"><div><p class="eyebrow"><%= t("self_service.marketing.buyer.eyebrow") %></p><h2><%= t("self_service.marketing.buyer.title") %></h2><p><%= t("self_service.marketing.buyer.body") %></p><div><%= link_to t("self_service.marketing.buyer.demo"), buyer_demo_path, class: "button button--primary" %></div></div><div class="feature-buyer"><p class="eyebrow"><%= t("self_service.marketing.buyer.private_quote") %></p><h3><%= t("self_service.marketing.buyer.choose") %></h3><div><article><%= t("self_service.marketing.buyer.essential") %><small><%= t("self_service.marketing.buyer.essential_help") %></small></article><article class="is-selected"><%= t("self_service.marketing.buyer.recommended") %><small><%= t("self_service.marketing.buyer.recommended_help") %></small></article><article><%= t("self_service.marketing.buyer.complete") %><small><%= t("self_service.marketing.buyer.complete_help") %></small></article></div><p><span><%= t("self_service.marketing.buyer.selection") %></span><strong>USD 38,450</strong></p></div></section>

  <section class="product-continuity"><header><p class="eyebrow"><%= t("self_service.marketing.revision.eyebrow") %></p><h2><%= t("self_service.marketing.revision.title") %></h2></header><div><article><span>R1</span><h3><%= t("self_service.marketing.revision.initial") %></h3><p><%= t("self_service.marketing.revision.initial_value") %></p></article><b><%= t("self_service.marketing.revision.changes_html").html_safe %></b><article class="is-current"><span>R2</span><h3><%= t("self_service.marketing.revision.accepted") %></h3><p><%= t("self_service.marketing.revision.accepted_value") %></p></article><b><%= t("self_service.marketing.revision.snapshot") %></b><article><span>PI</span><h3><%= t("self_service.marketing.revision.deposit") %></h3><p>USD 38,450</p></article></div></section>

  <section class="product-use"><header><p class="eyebrow"><%= t("self_service.marketing.use.eyebrow") %></p><h2><%= t("self_service.marketing.use.title") %></h2></header><div><% 3.times do |index| %><article><h3><%= t("self_service.marketing.use.items.#{index}.title") %></h3><p><%= t("self_service.marketing.use.items.#{index}.body") %></p></article><% end %></div></section>

  <section class="product-pricing"><div><p class="eyebrow"><%= t("self_service.marketing.pricing.eyebrow") %></p><h2><%= t("self_service.marketing.pricing.title") %></h2><p><%= t("self_service.marketing.pricing.body") %></p><%= link_to t("self_service.marketing.pricing.compare"), pricing_path, class: "button button--secondary" %></div><article><span>PRO</span><strong>$29<small><%= t("self_service.marketing.pricing.per_month") %></small></strong><p><%= t("self_service.marketing.pricing.features") %></p><%= link_to t("self_service.marketing.pricing.start"), new_user_registration_path, class: "button button--primary" %></article></section>

  <section class="product-faq"><header><p class="eyebrow"><%= t("self_service.marketing.faq.eyebrow") %></p><h2><%= t("self_service.marketing.faq.title") %></h2></header><div><% 4.times do |index| %><details><summary><%= t("self_service.marketing.faq.items.#{index}.question") %></summary><p><%= t("self_service.marketing.faq.items.#{index}.answer") %></p></details><% end %></div></section>

  <section class="product-final"><p class="eyebrow"><%= t("self_service.marketing.final.eyebrow") %></p><h2><%= t("self_service.marketing.final.title") %></h2><div><%= link_to t("self_service.marketing.final.primary"), new_user_registration_path, class: "button button--primary" %><%= link_to t("self_service.marketing.final.secondary"), seller_demo_path, class: "button button--secondary" %></div></section>
</main>
