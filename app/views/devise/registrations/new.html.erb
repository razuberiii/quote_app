<section class="marketing-content-shell marketing-auth-shell">
  <div class="marketing-auth-grid">
    <div class="marketing-auth-intro">
      <p class="app-section-caption uppercase tracking-[0.16em]"><%= t("users.registrations.view.new.title") %></p>
      <h1 class="marketing-auth-title"><%= t("users.registrations.view.new.title") %></h1>
      <p class="marketing-auth-body">Create your workspace and start building quotes with structured revisions, buyer links, and follow-up context.</p>
    </div>

    <%= render "components/ui/card", class: "app-surface marketing-auth-card" do %>
      <div class="app-section-stack gap-5">
        <div class="app-section-stack gap-2">
          <h2 class="marketing-auth-card-title"><%= t("users.registrations.view.new.title") %></h2>
          <p class="app-subtle-note">Set up your account to open the internal workspace.</p>
        </div>

        <% if @validation_error.present? %>
          <div class="error-messages auth-error-messages">
            <h2><%= t("users.registrations.view.new.verification_error") %></h2>
            <ul>
              <li><%= @validation_error %></li>
            </ul>
          </div>
        <% end %>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { id: "signup-form", class: "app-form-stack" }) do |f| %>
          <% if resource.errors.any? %>
            <div class="error-messages auth-error-messages">
              <h2><%= t("users.registrations.view.new.error_summary", count: resource.errors.count) %></h2>
              <ul>
                <% resource.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div>
            <%= f.label :username, "Username" %>
            <%= f.text_field :username, required: true, minlength: 3, maxlength: 32, pattern: "[A-Za-z0-9_]+", autocomplete: "username", class: ui_input_classes %>
            <small>3–32 letters, numbers, or underscores. You can use this to log in.</small>
          </div>

          <div>
            <%= f.label :email, t("users.registrations.view.new.email") %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: ui_input_classes %>
          </div>

          <div>
            <%= f.label :password, t("users.registrations.view.new.password") %>
            <% if @minimum_password_length %>
              <small><%= t("users.registrations.view.new.minimum_password", count: @minimum_password_length) %></small>
            <% end %>
            <%= f.password_field :password, autocomplete: "new-password", class: ui_input_classes %>
          </div>

          <div>
            <%= f.label :password_confirmation, t("users.registrations.view.new.password_confirmation") %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: ui_input_classes %>
          </div>

          <% unless ENV["SKIP_TURNSTILE_VERIFICATION"] == "true" %>
            <%= f.hidden_field :cf_turnstile_response, value: "", id: "cf_turnstile_response" %>
          <% end %>

          <div>
            <%= f.submit t("users.registrations.view.new.create_account"), class: "app-ui-button app-ui-button--primary auth-submit-button", id: "signup-submit-btn" %>
          </div>
        <% end %>

        <div class="auth-links">
          <%= link_to t("users.registrations.view.new.log_in"), new_session_path(resource_name) %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Verification Modal -->
  <div id="signup-verification-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 9999; justify-content: center; align-items: center;">
    <div style="background: white; padding: 30px; border-radius: 12px; max-width: 100%; width: 90%; max-width: 380px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); max-height: 90vh; overflow-y: auto;">
      <h3 style="margin: 0 0 10px 0; text-align: center; color: #333;"><%= t("users.registrations.view.new.security_verification") %></h3>
      <p style="margin: 0 0 20px 0; text-align: center; color: #666; font-size: 14px;"><%= t("users.registrations.view.new.complete_verification") %></p>
      
      <div id="signup-turnstile-loading" style="text-align: center; padding: 20px 0; color: #999;">
        <p><%= t("users.registrations.view.new.loading_verification") %></p>
      </div>
      
      <div id="signup-turnstile-container" style="display: none; text-align: center; overflow-x: auto;">
        <div class="cf-turnstile"></div>
      </div>
      
      <div id="signup-turnstile-success" style="display: none; text-align: center; padding: 20px 0;">
        <p style="color: #28a745; font-size: 16px; margin: 0;"><%= t("users.registrations.view.new.verified_submitting") %></p>
      </div>
    </div>
  </div>

  <script>
    const creatingAccountLabel = "<%= j t("users.registrations.view.new.creating_account") %>";
    const createAccountLabel = "<%= j t("users.registrations.view.new.create_account") %>";

    function initializeSignupForm() {
      const signupForm = document.getElementById('signup-form');
      const submitBtn = document.getElementById('signup-submit-btn');
      const modal = document.getElementById('signup-verification-modal');
      const turnstileResponse = document.getElementById('cf_turnstile_response');
      const loadingDiv = document.getElementById('signup-turnstile-loading');
      const containerDiv = document.getElementById('signup-turnstile-container');
      const successDiv = document.getElementById('signup-turnstile-success');
      
      // Make sure all elements exist
      if (!signupForm || !submitBtn || !modal || !turnstileResponse) {
        return;
      }

      // Clear any old token and state
      turnstileResponse.value = '';
      let verificationComplete = false;
      let isSubmitting = false;

      signupForm.addEventListener('submit', function(e) {
        if (isSubmitting) {
          e.preventDefault();
          return false;
        }

        // If verification already complete and we have a fresh token, submit immediately
        if (verificationComplete && turnstileResponse.value) {
          isSubmitting = true;
          submitBtn.disabled = true;
          submitBtn.textContent = creatingAccountLabel;
          return true;
        }

        e.preventDefault();

        // Reset and show modal
        verificationComplete = false;
        turnstileResponse.value = ''; // Clear any old token
        submitBtn.disabled = true; // CRITICAL: Disable button immediately when opening modal
        modal.style.display = 'flex';
        loadingDiv.style.display = 'block';
        containerDiv.style.display = 'none';
        successDiv.style.display = 'none';
        
        // Wait for Turnstile API to load, then render
        setTimeout(renderTurnstile, 300);
        return false;
      });

      function renderTurnstile() {
        if (typeof turnstile === 'undefined') {
          // API not loaded yet, retry
          setTimeout(renderTurnstile, 200);
          return;
        }

        // Hide loading, show container
        loadingDiv.style.display = 'none';
        containerDiv.style.display = 'block';

        const widget = containerDiv.querySelector('.cf-turnstile');
        
        // Clear any previous render
        if (widget.dataset.rendered === 'true') {
          widget.innerHTML = '';
          widget.removeAttribute('data-rendered');
        }

        turnstile.render(widget, {
          sitekey: '<%= ENV.fetch("TURNSTILE_SITE_KEY", "0x4AAAAAACkKXqa756rWhUr7") %>',
          theme: 'light',
          callback: function(token) {
            turnstileResponse.value = token;
            verificationComplete = true;
            
            // Show success message
            containerDiv.style.display = 'none';
            successDiv.style.display = 'block';
            
            // Auto-submit after 1 second
            setTimeout(() => {
              isSubmitting = true;
              modal.style.display = 'none';
              signupForm.submit();
            }, 1000);
          }
        });
        widget.dataset.rendered = 'true';
      }

      // Close modal on background click (only if verification isn't complete)
      modal.addEventListener('click', function(e) {
        if (e.target === modal && !verificationComplete) {
          modal.style.display = 'none';
          turnstileResponse.value = ''; // Clear incomplete verification
          submitBtn.disabled = false; // Re-enable button
          submitBtn.textContent = createAccountLabel;
        }
      });

      // Restore button state on form reset
      signupForm.addEventListener('reset', function() {
        submitBtn.disabled = false;
        submitBtn.textContent = createAccountLabel;
        turnstileResponse.value = '';
        verificationComplete = false;
        isSubmitting = false;
      });
    }

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', initializeSignupForm);
    // Re-initialize on Turbo navigation
    document.addEventListener('turbo:load', initializeSignupForm);
  </script>
</section>
