<main class="deal-workspace quote-core-detail">
  <header class="deal-hero quote-core-hero">
    <div><%= link_to t("self_service.quote_core.detail.back"), quotes_path, class: "deal-back" %><p class="eyebrow"><%= @quote.customer&.name || t("self_service.quote_core.index.customer_missing") %></p><h1><%= deal_title(@quote) %></h1><p><%= @quote.quote_no %> · <%= quote_version_label(@quote) %> · <%= t("self_service.quote_core.detail.owner", name: current_user.full_name.presence || current_user.username) %></p></div>
    <dl><div><dt><%= t("self_service.quote_core.detail.status") %></dt><dd><span class="quote-state quote-state--<%= @lifecycle.state %>"><i></i><%= @lifecycle.label %></span></dd></div><div><dt><%= t("self_service.quote_core.detail.amount") %></dt><dd><%= @quote.currency %> <%= number_with_delimiter(@quote.grand_total) %></dd></div><div><dt><%= t("self_service.quote_core.detail.latest") %></dt><dd><%= @lifecycle.signal %></dd></div></dl>
    <div class="deal-primary-action"><span><%= t("self_service.quote_core.detail.next") %></span><strong><%= @lifecycle.action_label %></strong><%= link_to @lifecycle.action_label, quote_action_path(@quote, @lifecycle), class: "button button--primary" %></div>
  </header>

  <nav class="deal-tabs quote-core-tabs"><% %w[quote activity versions].each do |key| %><%= link_to t("self_service.quote_core.detail.tabs.#{key}"), quote_path(@quote, tab: key), class: ("is-active" if @tab == key) %><% end %></nav>

  <% if @tab == "quote" %>
    <section class="quote-core-summary">
      <div class="quote-core-summary__intro"><p class="section-kicker"><%= t("self_service.quote_core.detail.quote.kicker") %></p><h2><%= t("self_service.quote_core.detail.quote.title") %></h2><p><%= t("self_service.quote_core.detail.quote.help") %></p><div><%= link_to t("self_service.quote_core.detail.quote.edit"), edit_quote_path(@quote), class: "button button--primary" %><%= link_to t("self_service.quote_core.detail.quote.preview"), preview_quote_path(@quote), target: "_blank", class: "button button--secondary" %><%= link_to t("self_service.quote_core.detail.quote.publish"), publish_quote_path(@quote), class: "button button--secondary" %></div></div>
      <dl class="quote-core-facts"><div><dt><%= t("self_service.quote_core.detail.quote.customer") %></dt><dd><%= @quote.customer&.name %></dd></div><div><dt><%= t("self_service.quote_core.detail.quote.items") %></dt><dd><%= @quote.quote_items.size %></dd></div><div><dt><%= t("self_service.quote_core.detail.quote.valid_until") %></dt><dd><%= @quote.valid_until || t("self_service.quote_core.detail.not_set") %></dd></div><div><dt><%= t("self_service.quote_core.detail.quote.language") %></dt><dd><%= @quote.buyer_locale %></dd></div><div><dt><%= t("self_service.quote_core.detail.quote.incoterm") %></dt><dd><%= @quote.trade_term.presence || t("self_service.quote_core.detail.not_set") %></dd></div><div><dt><%= t("self_service.quote_core.detail.quote.payment") %></dt><dd><%= @quote.payment_term.presence || t("self_service.quote_core.detail.not_set") %></dd></div></dl>
    </section>
  <% elsif @tab == "activity" %>
    <section class="conversation-stream quote-activity-stream">
      <header><p class="section-kicker"><%= t("self_service.quote_core.detail.activity.kicker") %></p><h2><%= t("self_service.quote_core.detail.activity.title") %></h2><p><%= t("self_service.quote_core.detail.activity.help") %></p></header>
      <div class="conversation-toolbar"><%= link_to t("self_service.quote_core.detail.activity.record"), new_response_quote_path(@quote, version_id: @versions.first&.id), class: "button button--secondary" if @versions.any? %><%= link_to t("self_service.quote_core.detail.activity.accept"), new_acceptance_quote_path(@quote, version_id: @versions.first&.id), class: "button button--primary" if @versions.any? && !@acceptance %></div>
      <% @responses.each do |message| %><article class="channel-response" id="<%= dom_id(message) %>"><div><span><%= t("self_service.deals.detail.response_kinds.#{message.kind}", default: message.kind.humanize) %></span><strong><%= message.buyer_name.presence || @quote.customer&.name %></strong><time><%= t("self_service.deals.ago", time: time_ago_in_words(message.received_at)) %></time></div><p><%= message.body.presence || t("self_service.deals.detail.conversation.file_received") %></p><aside><span>V<%= message.quote_revision.number %></span><strong><%= t("self_service.deals.detail.statuses.#{message.status}", default: message.status.humanize) %></strong></aside><%= render "deals/response_review", response: message if message.difference_review.present? %></article><% end %>
      <% (@questions.to_a + @requests.to_a).sort_by(&:created_at).reverse.each do |message| %><article><div><span><%= message.is_a?(BuyerQuestion) ? t("self_service.quote_core.detail.activity.question") : t("self_service.quote_core.detail.activity.change") %></span><strong><%= message.buyer_name.presence || message.buyer_email %></strong><time><%= t("self_service.deals.ago", time: time_ago_in_words(message.created_at)) %></time></div><p><%= message.respond_to?(:body) ? message.body : message.message %></p><% if message.is_a?(ChangeRequest) %><div class="change-request-diff"><span><%= t("self_service.quote_core.change_request_from", number: message.quote_revision.number) %></span><% message.requested_changes.to_h.fetch("quantities", {}).each do |index, quantity| %><p><strong><%= t("self_service.quote_core.change_request_quantity", item: index.to_i + 1) %></strong><del><%= Array(message.quote_revision.snapshot["quote_items"])[index.to_i].to_h["quantity"] %></del><b>→</b><ins><%= quantity %></ins></p><% end %></div><%= button_to t("self_service.quote_core.apply_to_draft"), apply_change_request_quote_path(@quote, change_request_id: message.id), method: :patch, class: "button button--primary" if message.status == "open" %><% elsif message.seller_reply.present? %><blockquote><span><%= t("self_service.deals.detail.conversation.seller_reply") %></span><%= message.seller_reply %></blockquote><% else %><%= form_with scope: :buyer_question, url: reply_question_quote_path(@quote, question_id: message.id), method: :patch, class: "conversation-reply" do |form| %><%= form.text_area :seller_reply, placeholder: t("self_service.deals.detail.conversation.reply_placeholder"), required: true, rows: 3 %><%= form.submit t("self_service.deals.detail.conversation.reply"), class: "button button--primary" %><% end %><% end %></article><% end %>
      <% if @activities.empty? && @responses.empty? && @questions.empty? && @requests.empty? %><div class="deal-zero"><h2><%= t("self_service.quote_core.detail.activity.empty") %></h2><p><%= t("self_service.quote_core.detail.activity.empty_help") %></p></div><% end %>
    </section>
  <% else %>
    <section class="quote-version-output">
      <% if @published_revision %><section class="publish-complete"><div><span><%= t("self_service.publish_complete.kicker") %></span><h2><%= t("self_service.publish_complete.title", number: @published_revision.number) %></h2><p><%= t("self_service.publish_complete.help") %></p></div><div class="publish-complete__actions"><button type="button" class="button button--primary" data-controller="clipboard" data-clipboard-text-value="<%= buyer_room_url(@published_revision.secure_token) %>" data-clipboard-success-message-value="<%= t("self_service.publish_complete.copied") %>" data-action="clipboard#copy"><%= t("self_service.publish_complete.copy") %></button><%= link_to t("self_service.publish_complete.pdf"), quote_version_export_path(@quote, @published_revision, output: "pdf"), class: "button button--secondary" %><%= link_to t("self_service.publish_complete.excel"), quote_version_export_path(@quote, @published_revision, output: "excel"), class: "button button--secondary" %><%= link_to t("self_service.publish_complete.send"), deliver_quote_path(@quote, version_id: @published_revision.id), class: "button button--secondary" %></div></section><% end %>
      <header><div><p class="section-kicker"><%= t("self_service.quote_core.detail.versions.kicker") %></p><h2><%= t("self_service.quote_core.detail.versions.title") %></h2><p><%= t("self_service.quote_core.detail.versions.help") %></p></div></header>
      <% @versions.each do |version| %><article id="version-<%= version.id %>"><div class="quote-version-output__identity"><span>V<%= version.number %></span><div><strong><%= version.number == @versions.first.number ? t("self_service.quote_core.detail.versions.current") : t("self_service.quote_core.detail.versions.previous") %></strong><small><%= l(version.published_at, format: :long) %> · <%= version.currency %> <%= number_with_delimiter(version.total) %></small></div></div><div class="quote-version-output__actions"><%= link_to t("self_service.quote_core.detail.versions.customer_page"), buyer_room_path(version.secure_token, preview: 1), target: "_blank" %><%= link_to "PDF", quote_version_export_path(@quote, version, output: "pdf") %><%= link_to "Excel", quote_version_export_path(@quote, version, output: "excel") %><%= link_to t("self_service.quote_core.detail.versions.send"), deliver_quote_path(@quote, version_id: version.id), class: "button button--primary" %></div></article><% end %>
      <% if @versions.empty? %><div class="deal-zero"><h2><%= t("self_service.quote_core.detail.versions.empty") %></h2><p><%= t("self_service.quote_core.detail.versions.empty_help") %></p><%= link_to t("self_service.quote_core.detail.quote.publish"), publish_quote_path(@quote), class: "button button--primary" %></div><% end %>
    </section>
  <% end %>
</main>
