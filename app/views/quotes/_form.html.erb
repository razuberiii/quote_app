    function setFieldValue(selector, value) {
      const input = form?.querySelector(selector);
      if (!input) return;
      input.value = String(value ?? "");
      input.dispatchEvent(new Event("input", { bubbles: true }));
      input.dispatchEvent(new Event("change", { bubbles: true }));
    }

    function setCheckboxValue(selector, enabled) {
      const input = form?.querySelector(selector);
      if (!input) return;
      input.checked = !!enabled;
      input.dispatchEvent(new Event("change", { bubbles: true }));
    }

    function setFormalClosingImage(kind, payload = {}) {
      const isSignature = kind === "signature";
      const blobInput = isSignature ? formalClosingSellerSignatureBlobInput : formalClosingSellerStampBlobInput;
      const removeInput = isSignature ? formalClosingSellerSignatureRemoveInput : formalClosingSellerStampRemoveInput;
      const previewWrap = isSignature ? formalClosingSellerSignaturePreviewWrap : formalClosingSellerStampPreviewWrap;
      const previewImage = isSignature ? formalClosingSellerSignaturePreview : formalClosingSellerStampPreview;
      const imageUrl = String(payload?.imageUrl || "").trim();
      const blobSignedId = String(payload?.blobSignedId || "").trim();
      const markRemoved = payload?.markRemoved === true;

      if (blobInput) blobInput.value = blobSignedId;
      if (removeInput) removeInput.value = markRemoved ? "1" : "0";
      if (!previewWrap || !previewImage) return;

      if (imageUrl) {
        previewWrap.hidden = false;
        previewImage.hidden = false;
        previewImage.src = imageUrl;
      } else {
        previewImage.src = "";
        previewImage.hidden = true;
        previewWrap.hidden = true;
      }
    }

    function applyBusinessTermsPreset(payload) {
      setFieldValue("[name='quote[payment_term]']", payload.payment_term);
      setFieldValue("[name='quote[trade_term]']", payload.trade_term);
      setFieldValue("[name='quote[delivery_notes]']", payload.delivery_notes);
      setFieldValue("[name='quote[terms_text]']", payload.terms_text);
      setFieldValue("[name='quote[scope_of_supply]']", payload.scope_of_supply);
    }

    function applyAdvancedTradePreset(payload) {
      Object.entries(payload || {}).forEach(([key, value]) => {
        setFieldValue(`[name='quote[advanced_trade_terms][${CSS.escape(key)}]']`, value);
      });
    }

    function applyAdvancedLogisticsPreset(payload) {
      Object.entries(payload || {}).forEach(([key, value]) => {
        setFieldValue(`[name='quote[advanced_logistics][${CSS.escape(key)}]']`, value);
      });
    }

    function applyConfigurationPreset(payload) {
      const rows = Array.isArray(payload?.rows) ? payload.rows : [];
      if (configurationRowsContainer) {
        configurationRowsContainer.querySelectorAll(".js-configuration-row").forEach((row) => row.remove());
        rows.forEach((row, index) => {
          configurationRowsContainer.insertAdjacentHTML("beforeend", newConfigurationRowHtml(index));
          const target = configurationRowsContainer.querySelector(`.js-configuration-row[data-index='${index}']`);
          target?.querySelector(".js-config-label")?.setAttribute("value", String(row.label || ""));
          target?.querySelector(".js-config-value")?.setAttribute("value", String(row.value || ""));
          const labelInput = target?.querySelector(".js-config-label");
          const valueInput = target?.querySelector(".js-config-value");
          if (labelInput) labelInput.value = String(row.label || "");
          if (valueInput) valueInput.value = String(row.value || "");
        });
      }
      refreshConfigurationRows();
    }

    function applyContainerLoadingPreset(payload) {
      const headers = payload?.headers || {};
      setFieldValue("[name='quote[container_loading_block][headers][variant]']", headers.variant);
      setFieldValue("[name='quote[container_loading_block][headers][container_type]']", headers.container_type);
      setFieldValue("[name='quote[container_loading_block][headers][capacity]']", headers.capacity);
      setFieldValue("[name='quote[container_loading_block][headers][note]']", headers.note);

      const rows = Array.isArray(payload?.rows) ? payload.rows : [];
      if (containerLoadingRowsContainer) {
        containerLoadingRowsContainer.querySelectorAll(".js-container-loading-row").forEach((row) => row.remove());
        rows.forEach((row, index) => {
          containerLoadingRowsContainer.insertAdjacentHTML("beforeend", newContainerLoadingRowHtml(index));
          const target = containerLoadingRowsContainer.querySelector(`.js-container-loading-row[data-index='${index}']`);
          if (!target) return;
          const variantInput = target.querySelector(".js-container-loading-variant");
          const typeInput = target.querySelector(".js-container-loading-type");
          const capacityInput = target.querySelector(".js-container-loading-capacity");
          const noteInput = target.querySelector(".js-container-loading-note");
          if (variantInput) variantInput.value = String(row.variant || "");
          if (typeInput) typeInput.value = String(row.container_type || "");
          if (capacityInput) capacityInput.value = String(row.capacity || "");
          if (noteInput) noteInput.value = String(row.note || "");
        });
      }

      const noteEnabled = payload?.note_enabled !== false;
      if (containerLoadingNoteEnabledInput) containerLoadingNoteEnabledInput.checked = noteEnabled;
      if (containerLoadingEnabledInput) {
        const enabled = payload?.enabled === true || rows.length > 0;
        containerLoadingEnabledInput.value = enabled ? "1" : "0";
      }
      refreshContainerLoadingRows();
    }

    function applyFormalClosingPreset(payload) {
      setFieldValue("[name='quote[formal_closing_block][pi_number]']", payload.pi_number);
      setFieldValue("[name='quote[formal_closing_block][delivery_time]']", payload.delivery_time);
      setFieldValue("[name='quote[formal_closing_block][trade_term]']", payload.trade_term);
      setFieldValue("[name='quote[formal_closing_block][payment_term]']", payload.payment_term);
      setFieldValue("[name='quote[formal_closing_block][bank_route]']", payload.bank_route);
      setFieldValue("[name='quote[formal_closing_block][beneficiary_details]']", payload.beneficiary_details);
      setFieldValue("[name='quote[formal_closing_block][remittance_note]']", payload.remittance_note);
      setCheckboxValue("[name='quote[formal_closing_block][buyer_signature_line_enabled]']", payload.buyer_signature_line_enabled);
      setFormalClosingImage("signature", {
        imageUrl: payload.seller_signature_image_url,
        blobSignedId: payload.seller_signature_blob_signed_id
      });
      setFormalClosingImage("stamp", {
        imageUrl: payload.seller_stamp_image_url,
        blobSignedId: payload.seller_stamp_blob_signed_id
      });
