<section class="app-page-shell sales-dashboard"
         data-controller="dashboard-actions dashboard-enhance"
         data-dashboard-actions-show-less-label-value="<%= t("dashboard.view.index.show_less") %>"
         data-dashboard-actions-show-more-template-value="<%= t("dashboard.view.index.show_more", count: "%{count}") %>">
  <header class="app-page-header">
    <div class="app-page-header-main">
      <h1><%= t("dashboard.view.index.title") %></h1>
      <p><%= t("dashboard.view.index.subtitle") %></p>
    </div>
    <div class="app-page-header-actions">
      <div class="kpi-period-toggle" role="tablist" aria-label="<%= t("dashboard.view.index.kpi_period") %>">
        <%= link_to t("dashboard.view.index.weekly"), dashboard_path(kpi_period: "week"), class: "app-filter-pill app-filter-pill--kpi #{@kpi_period == 'week' ? 'is-active' : ''}" %>
        <%= link_to t("dashboard.view.index.monthly"), dashboard_path(kpi_period: "month"), class: "app-filter-pill app-filter-pill--kpi #{@kpi_period == 'month' ? 'is-active' : ''}" %>
      </div>
    </div>
  </header>

  <div class="sales-dashboard-content app-section-stack">
    <% if @show_onboarding %>
      <div class="dashboard-onboarding-secondary">
        <%= render "components/ui/card", class: "dashboard-panel app-surface dashboard-onboarding-shell" do %>
          <section class="dashboard-onboarding-primary" aria-label="<%= t("dashboard.onboarding.quick_start.title") %>">
            <%= render "quick_start_checklist" %>
          </section>
          <section class="dashboard-onboarding-actions-bar" aria-label="<%= t("dashboard.onboarding.quick_create.title") %>">
            <%= render "quick_create" %>
          </section>
        <% end %>
      </div>
    <% end %>

    <div class="dashboard-priority-layer dashboard-priority-layer--urgent">
    <div class="dashboard-urgent-composition">
    <div class="dashboard-urgent-main">
    <div class="dashboard-urgent-main-primary" id="today-focus-section">
    <%= render "components/ui/card", class: "dashboard-panel dashboard-action-center dashboard-module--urgent app-surface" do %>
      <h2><%= t("dashboard.view.index.today_focus") %></h2>
      <p class="app-section-caption"><%= t("dashboard.view.index.today_focus_caption") %></p>
      <% if @primary_action.present? %>
        <div class="dashboard-action-list">
          <div class="dashboard-action-item dashboard-action-item-primary is-<%= @primary_action[:priority] %>">
            <div>
              <span class="dashboard-action-primary-label"><%= t("dashboard.view.index.top_priority") %></span>
              <strong><%= @primary_action[:title] %></strong>
              <p><%= @primary_action[:detail] %></p>
            </div>
            <% if @primary_action[:cta_method].to_sym == :post %>
              <%= button_to @primary_action[:cta_label], @primary_action[:cta_path], method: :post, form: { data: { turbo: false } }, class: ui_button_classes(:secondary, "dashboard-action-link") %>
            <% else %>
              <%= render "components/ui/button", href: @primary_action[:cta_path], variant: :secondary, class: "dashboard-action-link" do %>
                <%= @primary_action[:cta_label] %>
              <% end %>
            <% end %>
          </div>
          <% if @secondary_actions.any? %>
            <div class="dashboard-action-more" data-action-more data-expand-id="primary-actions" hidden>
              <% @secondary_actions.each do |item| %>
                <div class="dashboard-action-item is-<%= item[:priority] %>">
                  <div>
                    <span class="dashboard-action-secondary-label"><%= t("dashboard.view.index.secondary") %></span>
                    <strong><%= item[:title] %></strong>
                    <p><%= item[:detail] %></p>
                  </div>
                  <% if item[:cta_method].to_sym == :post %>
                    <%= button_to item[:cta_label], item[:cta_path], method: :post, form: { data: { turbo: false } }, class: ui_button_classes(:secondary, "dashboard-action-link") %>
                  <% else %>
                    <%= render "components/ui/button", href: item[:cta_path], variant: :secondary, class: "dashboard-action-link" do %>
                      <%= item[:cta_label] %>
                    <% end %>
                  <% end %>
                </div>
              <% end %>
            </div>
            <%= render "components/ui/button",
                       variant: :secondary,
                       class: "dashboard-action-toggle dashboard-inline-toggle",
                       attrs: { data: { action_toggle: true, expanded: "false", action_count: @secondary_actions.size, expand_id: "primary-actions" } } do %>
              <%= t("dashboard.view.index.show_more", count: @secondary_actions.size) %>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="team-members-hint"><%= t("dashboard.view.index.no_high_priority_actions") %></p>
      <% end %>
    <% end %>
    </div>

    <div id="quote-todo-section">
    <%= render "components/ui/card", class: "dashboard-panel dashboard-action-center dashboard-module--urgent app-surface" do %>
      <div class="dashboard-action-summary-head">
        <h2><%= t("dashboard.view.index.quote_todo") %></h2>
      </div>
      <p class="app-section-caption"><%= t("dashboard.view.index.quote_todo_caption") %></p>
      <% if @quote_todo_entries.any? %>
        <div class="dashboard-action-list">
            <% @quote_todo_entries.first(1).each do |entry| %>
              <article class="dashboard-task-item is-<%= entry[:priority] %>">
                <div>
                  <span class="dashboard-action-secondary-label"><%= entry[:customer_name] %></span>
                  <strong><%= entry[:display_name].presence || entry[:quote_no] %></strong>
                  <small class="dashboard-action-item-meta">
                    <span class="dashboard-quote-id"><%= entry[:quote_no] %></span>
                    · <%= quote_status_badge(entry[:status], label: entry[:status].capitalize) %>
                  </small>
                  <p><%= entry[:signal] %></p>
                </div>
                <div class="dashboard-task-actions">
                  <% if entry[:next_action][:method].to_s == "post" %>
                    <%= button_to entry[:next_action][:label],
                                  entry[:next_action][:path],
                                  method: :post,
                                  form: { data: { turbo: false } },
                                  class: ui_button_classes(:secondary, "dashboard-action-link #{entry[:next_action][:style]}") %>
                  <% else %>
                    <%= link_to entry[:next_action][:label], entry[:next_action][:path], class: ui_button_classes(:secondary, "dashboard-action-link #{entry[:next_action][:style]}") %>
                  <% end %>
                </div>
              </article>
            <% end %>
            <% if @quote_todo_entries.size > 1 %>
              <div class="dashboard-action-more" data-action-more data-expand-id="quote-todo-more" hidden>
                <% @quote_todo_entries.drop(1).each do |entry| %>
                  <article class="dashboard-task-item is-<%= entry[:priority] %>">
                    <div>
                      <span class="dashboard-action-secondary-label"><%= entry[:customer_name] %></span>
                      <strong><%= entry[:display_name].presence || entry[:quote_no] %></strong>
                      <small class="dashboard-action-item-meta">
                        <span class="dashboard-quote-id"><%= entry[:quote_no] %></span>
                        · <%= quote_status_badge(entry[:status], label: entry[:status].capitalize) %>
                      </small>
                      <p><%= entry[:signal] %></p>
                    </div>
                    <div class="dashboard-task-actions">
                      <% if entry[:next_action][:method].to_s == "post" %>
                        <%= button_to entry[:next_action][:label],
                                      entry[:next_action][:path],
                                      method: :post,
                                      form: { data: { turbo: false } },
                                      class: ui_button_classes(:secondary, "dashboard-action-link #{entry[:next_action][:style]}") %>
                      <% else %>
                        <%= link_to entry[:next_action][:label], entry[:next_action][:path], class: ui_button_classes(:secondary, "dashboard-action-link #{entry[:next_action][:style]}") %>
                      <% end %>
                    </div>
                  </article>
                <% end %>
              </div>
              <%= render "components/ui/button",
                         variant: :secondary,
                         class: "dashboard-action-toggle dashboard-inline-toggle",
                         attrs: { data: { action_toggle: true, expanded: "false", action_count: @quote_todo_entries.size - 1, expand_id: "quote-todo-more" } } do %>
                <%= t("dashboard.view.index.show_more", count: @quote_todo_entries.size - 1) %>
              <% end %>
            <% end %>
        </div>
      <% else %>
        <p class="team-members-hint"><%= t("dashboard.view.index.quote_todo_empty") %></p>
      <% end %>
    <% end %>
    </div>
    </div>
    </div>

    <div class="dashboard-priority-layer dashboard-priority-layer--health">
      <%= render "components/ui/card", class: "dashboard-panel dashboard-decision-snapshot dashboard-module--snapshot app-surface" do %>
        <div class="dashboard-action-summary-head">
          <h2><%= t("dashboard.view.index.sales_signals") %></h2>
          <span class="dashboard-decision-period"><%= @kpi_period == "month" ? t("dashboard.view.index.this_month") : t("dashboard.view.index.this_week") %></span>
        </div>
        <% outcome_counts = [@decision_snapshot[:accepted_count].to_i, @decision_snapshot[:revision_requested_count].to_i] %>
        <% pressure_counts = [@decision_snapshot[:reopened_count].to_i, @decision_snapshot[:negotiating_stale_count].to_i] %>
        <% outcome_total = outcome_counts.sum %>
        <% pressure_total = pressure_counts.sum %>
        <% attention_base = outcome_total + pressure_total %>
        <% attention_ratio = attention_base.positive? ? ((@decision_snapshot[:public_actionable_count].to_f / attention_base) * 100).round : 0 %>
        <div class="dashboard-decision-flow">
          <div class="dashboard-decision-column">
            <h3><%= t("dashboard.view.index.outcome_signals") %></h3>
            <div class="dashboard-decision-metrics">
              <p class="dashboard-decision-metric">
                <span><%= t("dashboard.view.index.accepted") %></span>
                <strong><%= @decision_snapshot[:accepted_count] %></strong>
              </p>
              <p class="dashboard-decision-metric">
                <span><%= t("dashboard.view.index.revision_requested") %></span>
                <strong class="<%= 'is-attention' if @decision_snapshot[:revision_requested_count].positive? %>"><%= @decision_snapshot[:revision_requested_count] %></strong>
              </p>
            </div>
            <div class="dashboard-decision-column-progress" role="presentation" aria-hidden="true">
              <span class="dashboard-decision-column-progress-fill is-neutral" style="width: <%= outcome_total.positive? ? [((@decision_snapshot[:accepted_count].to_f / outcome_total) * 100).round, 8].max : 0 %>%"></span>
            </div>
          </div>
          <div class="dashboard-decision-column">
            <h3><%= t("dashboard.view.index.pressure_signals") %></h3>
            <div class="dashboard-decision-metrics">
              <p class="dashboard-decision-metric">
                <span><%= t("dashboard.view.index.reopened") %></span>
                <strong><%= @decision_snapshot[:reopened_count] %></strong>
              </p>
              <p class="dashboard-decision-metric">
                <span><%= t("dashboard.view.index.negotiating_stale") %></span>
                <strong><%= @decision_snapshot[:negotiating_stale_count] %></strong>
              </p>
            </div>
            <div class="dashboard-decision-column-progress" role="presentation" aria-hidden="true">
              <span class="dashboard-decision-column-progress-fill is-watch" style="width: <%= pressure_total.positive? ? [((@decision_snapshot[:negotiating_stale_count].to_f / pressure_total) * 100).round, 8].max : 0 %>%"></span>
            </div>
          </div>
          <div class="dashboard-decision-column dashboard-decision-column-attention">
            <h3><%= t("dashboard.view.index.attention_signal") %></h3>
            <div class="dashboard-decision-metrics">
              <p class="dashboard-decision-metric">
                <span><%= t("dashboard.view.index.public_actionable") %></span>
                <strong class="<%= 'is-attention' if @decision_snapshot[:public_actionable_count].positive? %>"><%= @decision_snapshot[:public_actionable_count] %></strong>
              </p>
              <p class="dashboard-decision-metric dashboard-decision-metric-note">
                <span><%= t("dashboard.view.index.awaiting_client_decision") %></span>
              </p>
            </div>
            <div class="dashboard-decision-column-progress" role="presentation" aria-hidden="true">
              <span class="dashboard-decision-column-progress-fill is-danger" style="width: <%= [attention_ratio, 8].max %>%"></span>
            </div>
          </div>
        </div>
        <%= render "shared/quote_funnel" %>
      <% end %>

      <%= render "components/ui/card", class: "dashboard-panel dashboard-metric-overview dashboard-module--snapshot app-surface" do %>
        <div class="app-section-heading">
          <div>
            <h2><%= t("dashboard.view.index.metrics_overview") %></h2>
            <p class="app-section-caption"><%= t("dashboard.view.index.metrics_overview_caption") %></p>
          </div>
        </div>
        <div class="dashboard-metric-overview-grid">
          <% @dashboard_core_metrics.each do |metric| %>
            <article class="dashboard-metric-overview-item">
              <span><%= metric[:label] %></span>
              <strong data-dashboard-enhance-target="count" data-count-final="<%= metric[:value] %>"><%= metric[:value] %></strong>
              <small><%= metric[:detail] %></small>
            </article>
          <% end %>
        </div>
        <div class="dashboard-metric-overview-trend">
          <p class="dashboard-metric-overview-trend-kicker"><%= t("dashboard.view.index.followup_mix_caption") %></p>
          <div class="dashboard-metric-overview-bars" role="img" aria-label="<%= t("dashboard.view.index.followup_mix_caption") %>">
            <% @dashboard_activity_mix.each do |segment| %>
              <span class="dashboard-metric-overview-bar is-<%= segment[:tone] %>" style="width: <%= [segment[:percent], 4].max %>%"></span>
            <% end %>
          </div>
          <ul class="dashboard-metric-overview-legend">
            <% @dashboard_activity_mix.each do |segment| %>
              <li>
                <span class="dashboard-metric-overview-dot is-<%= segment[:tone] %>"></span>
                <span><%= segment[:label] %></span>
                <strong><%= segment[:count] %></strong>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>

    <div class="dashboard-priority-layer dashboard-priority-layer--insight">

    <div class="dashboard-analysis-grid">
      <%= render "dashboard/sales_insights" %>
      <%= render "components/ui/card", class: "dashboard-panel dashboard-panel--data dashboard-module--insight app-surface" do %>
        <div class="app-section-heading">
          <div>
            <h2><%= t("dashboard.view.index.top_quoted_products") %></h2>
            <p class="app-section-caption"><%= t("dashboard.view.index.top_quoted_products_caption") %></p>
          </div>
        </div>
        <div class="table-responsive">
          <%= render "components/ui/table", class: "dashboard-recent-table dashboard-summary-table dashboard-analysis-table dashboard-top-products-table app-table-surface", table_class: "dashboard-recent-table dashboard-summary-table dashboard-analysis-table dashboard-top-products-table app-data-table" do %>
            <thead>
              <tr>
                <th><%= t("dashboard.view.index.product") %></th>
                <th><%= t("dashboard.view.index.quoted") %></th>
                <th><%= t("dashboard.view.index.won") %></th>
                <th><%= t("dashboard.view.index.last_quoted") %></th>
              </tr>
            </thead>
            <tbody>
              <% if @top_quoted_products.any? %>
                <% @top_quoted_products.each do |product| %>
                  <tr data-clickable-href="<%= product_path(product) %>" tabindex="0" aria-label="<%= t("dashboard.view.index.open_product", name: product.name) %>">
                    <td data-label="<%= t("dashboard.view.index.product") %>">
                      <div class="dashboard-mobile-value">
                        <strong class="dashboard-cell-ellipsis"><%= product.name %></strong>
                      </div>
                    </td>
                    <td data-label="<%= t("dashboard.view.index.quoted") %>">
                      <div class="dashboard-mobile-value"><%= product.quoted_count %></div>
                    </td>
                    <td data-label="<%= t("dashboard.view.index.won") %>">
                      <div class="dashboard-mobile-value"><%= product.won_count %></div>
                    </td>
                    <td data-label="<%= t("dashboard.view.index.last_quoted") %>">
                      <div class="dashboard-mobile-value"><%= product.last_quoted_at.present? ? format_in_user_time(product.last_quoted_at, current_user) : "-" %></div>
                    </td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="4" class="customers-empty-row">
                    <%= ui_empty_state(
                          title: t("dashboard.view.index.no_product_activity"),
                          body: t("dashboard.view.index.no_product_activity_body"),
                          icon: :products
                        ) %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          <% end %>
        </div>
        <div class="dashboard-mobile-list" aria-hidden="true">
          <% if @top_quoted_products.any? %>
            <% @top_quoted_products.each do |product| %>
              <article class="dashboard-mobile-item" data-clickable-href="<%= product_path(product) %>" tabindex="0" aria-label="<%= t("dashboard.view.index.open_product", name: product.name) %>">
                <div class="dashboard-mobile-row">
                  <span><%= t("dashboard.view.index.product") %></span>
                  <strong><%= product.name %></strong>
                </div>
                <div class="dashboard-mobile-row">
                  <span><%= t("dashboard.view.index.quoted") %></span>
                  <strong><%= product.quoted_count %></strong>
                </div>
                <div class="dashboard-mobile-row">
                  <span><%= t("dashboard.view.index.won") %></span>
                  <strong><%= product.won_count %></strong>
                </div>
                <div class="dashboard-mobile-row">
                  <span><%= t("dashboard.view.index.last_quoted") %></span>
                  <strong><%= product.last_quoted_at.present? ? format_in_user_time(product.last_quoted_at, current_user) : "-" %></strong>
                </div>
              </article>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
    </div>
  </div>

</section>
