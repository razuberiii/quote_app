<% if impersonating? && real_admin_user.present? %>
  <div class="alert alert-danger admin-impersonation-banner">
    <strong class="admin-impersonation-banner-title"><%= t("admin.impersonation.banner.title") %></strong>
    <span class="admin-impersonation-banner-detail">
      <%= t("admin.impersonation.banner.detail", admin_email: real_admin_user.email, user_email: current_user.email) %>
    </span>
    <%= button_to t("admin.impersonation.banner.exit"),
                  admin_impersonation_path,
                  method: :delete,
                  class: ui_button_classes(:danger),
                  form: { class: "admin-impersonation-exit-form" },
                  data: { turbo_confirm: t("admin.impersonation.banner.exit_confirm") } %>
  </div>
<% end %>
