<% advanced_collapsible = local_assigns.fetch(:advanced_collapsible, false) %>
<% existing_template_slugs = current_user.company.quote_templates.where.not(id: quote_template.id).pluck(:slug).compact %>
<%= form_with model: quote_template, html: { class: "template-editor-form", data: { template_editor_form: true, existing_slugs: existing_template_slugs.to_json, slug_taken_message: t("quote_templates.view.form.preset_slug_taken") } } do |f| %>
  <% if quote_template.errors.any? %>
    <div class="error-messages">
      <h2><%= t("quote_templates.view.form.error_summary", count: quote_template.errors.count) %></h2>
      <ul>
        <% quote_template.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="template-identity-row">
    <div>
      <%= f.label :name, t("quote_templates.view.form.preset_name") %>
      <%= f.text_field :name, required: true, placeholder: t("quote_templates.view.form.preset_name_placeholder") %>
    </div>
    <div>
      <%= f.label :slug, t("quote_templates.view.form.preset_slug") %>
      <%= f.text_field :slug, placeholder: t("quote_templates.view.form.preset_slug_placeholder") %>
      <p class="template-sub"><%= t("quote_templates.view.form.preset_slug_hint") %></p>
      <p class="template-sub" data-template-slug-feedback hidden></p>
      <% if quote_template.errors[:slug].any? %>
        <p class="field-error-message"><%= quote_template.errors.full_messages_for(:slug).first %></p>
      <% end %>
    </div>
    <div>
      <%= f.label :document_kind, t("quote_templates.view.form.default_document_view") %>
      <%= f.select :document_kind, [[t("quote_templates.view.form.document_kind.quotation"), "quotation"], [t("quote_templates.view.form.document_kind.proforma_invoice"), "proforma_invoice"]], {}, data: { template_preview_target: "document-kind" } %>
    </div>
  </section>

  <div class="template-editor-layout">
    <div class="template-editor-sections">
      <section class="template-editor-section template-editor-section-visual">
        <header>
          <h3><%= t("quote_templates.view.form.visual_style") %></h3>
          <p><%= t("quote_templates.view.form.visual_style_hint") %></p>
        </header>
        <div class="template-form-grid">
          <div>
            <%= f.label :layout_type, t("quote_templates.view.form.layout_type") %>
            <%= f.select :layout_type, QuoteTemplate.layout_types.keys.map { |it| [it.titleize, it] }, {}, data: { template_preview_target: "layout" } %>
          </div>
          <div>
            <%= f.label :layout_density, t("quote_templates.view.form.layout_density") %>
            <%= f.select :layout_density, [[t("quote_templates.view.form.layout_density_options.compact"), "compact"], [t("quote_templates.view.form.layout_density_options.standard"), "standard"], [t("quote_templates.view.form.layout_density_options.spacious"), "spacious"]], {}, data: { template_preview_target: "density" } %>
          </div>
          <div>
            <%= f.label :accent_color, t("quote_templates.view.form.accent_color") %>
            <%= f.color_field :accent_color, data: { template_preview_target: "accent" } %>
          </div>
          <div>
            <%= f.label :font_family, t("quote_templates.view.form.font_family") %>
            <%= f.select :font_family, ["Inter", "Noto Sans", "Segoe UI", "Arial", "Helvetica"], {}, data: { template_preview_target: "font" } %>
          </div>
          <div>
            <%= f.label :logo_position, t("quote_templates.view.form.logo_position") %>
            <%= f.select :logo_position, [[t("quote_templates.view.form.logo_position_options.right"), "right"], [t("quote_templates.view.form.logo_position_options.left"), "left"], [t("quote_templates.view.form.logo_position_options.center"), "center"]], {}, data: { template_preview_target: "logo-position" } %>
          </div>
        </div>
      </section>

      <section class="template-editor-section">
        <header>
          <h3><%= t("quote_templates.view.form.document_structure") %></h3>
          <p><%= t("quote_templates.view.form.document_structure_hint") %></p>
        </header>
        <div class="template-toggle-grid">
          <label><%= f.check_box :show_logo, data: { template_preview_toggle: "logo" } %> <%= t("quote_templates.view.form.show_logo") %></label>
          <label><%= f.check_box :show_tax, data: { template_preview_toggle: "tax" } %> <%= t("quote_templates.view.form.show_tax") %></label>
          <label><%= f.check_box :show_shipping, data: { template_preview_toggle: "shipping" } %> <%= t("quote_templates.view.form.show_shipping") %></label>
          <label><%= f.check_box :show_payment_term, data: { template_preview_toggle: "payment" } %> <%= t("quote_templates.view.form.show_payment_term") %></label>
          <label><%= f.check_box :show_customer_owner, data: { template_preview_toggle: "customer-owner" } %> <%= t("quote_templates.view.form.show_sales_owner") %></label>
          <label><%= f.check_box :show_notes, data: { template_preview_toggle: "notes" } %> <%= t("quote_templates.view.form.show_notes") %></label>
          <label><%= f.check_box :show_scope_of_supply, data: { template_preview_toggle: "scope-of-supply" } %> <%= t("quote_templates.view.form.show_scope_of_supply") %></label>
          <label><%= f.check_box :show_signature_block, data: { template_preview_toggle: "signature" } %> <%= t("quote_templates.view.form.show_signature_block") %></label>
          <label><%= f.check_box :show_images, data: { template_preview_toggle: "images" } %> <%= t("quote_templates.view.form.show_product_images") %></label>
          <label><%= f.check_box :show_valid_until, data: { template_preview_toggle: "valid-until" } %> <%= t("quote_templates.view.form.show_valid_until") %></label>
          <label><%= f.check_box :show_terms_section, data: { template_preview_toggle: "terms" } %> <%= t("quote_templates.view.form.show_terms_section") %></label>
          <label><%= f.check_box :show_currency, data: { template_preview_toggle: "currency" } %> <%= t("quote_templates.view.form.show_currency") %></label>
          <label><%= f.check_box :show_closing_message, data: { template_preview_toggle: "closing" } %> <%= t("quote_templates.view.form.show_closing_message") %></label>
          <label><%= f.check_box :show_watermark, data: { template_preview_toggle: "watermark" } %> <%= t("quote_templates.view.form.show_watermark") %></label>
          <label><%= f.check_box :show_saas_branding, data: { template_preview_toggle: "saas-branding" } %> <%= t("quote_templates.view.form.show_saas_branding") %></label>
          <label><%= f.check_box :show_public_revision_summary %> <%= t("quote_templates.view.form.show_public_revision_summary") %></label>
          <label><%= f.check_box :show_pdf_revision_summary %> <%= t("quote_templates.view.form.show_pdf_revision_summary") %></label>
          <label><%= f.check_box :show_excel_revision_summary %> <%= t("quote_templates.view.form.show_excel_revision_summary") %></label>
          <label><%= f.check_box :excel_show_grid_lines %> <%= t("quote_templates.view.form.show_excel_gridlines") %></label>
        </div>
        <div class="template-form-grid"
             data-template-default-scope-container
             data-template-doc-kind-field="quotation"
             <%= "hidden" unless quote_template.show_scope_of_supply? && quote_template.document_kind != "proforma_invoice" %>>
          <div class="template-span-2">
            <%= f.label :default_scope_of_supply_content, t("quote_templates.view.form.default_scope_of_supply_content") %>
            <%= f.text_area :default_scope_of_supply_content,
                            rows: 3,
                            placeholder: t("quote_templates.view.form.default_scope_of_supply_content_placeholder"),
                            data: { template_preview_target: "default-scope-of-supply-content" } %>
            <p class="template-sub"><%= t("quote_templates.view.form.default_scope_of_supply_content_hint") %></p>
          </div>
        </div>
        <p class="template-sub"><%= t("quote_templates.view.form.show_watermark_hint") %></p>
        <div class="template-form-grid">
          <div>
            <%= f.label :signature_name, t("quote_templates.view.form.signature_name") %>
            <%= f.text_field :signature_name, placeholder: t("quote_templates.view.form.signature_name_placeholder"), data: { template_preview_target: "signature-name" } %>
            <p class="template-sub"><%= t("quote_templates.view.form.signature_name_hint") %></p>
          </div>
          <div>
            <%= f.label :signature_image, t("quote_templates.view.form.signature_image") %>
            <div class="app-file-picker" data-file-picker>
              <%= f.file_field :signature_image, id: "quote_template_signature_image", accept: "image/*", class: "app-file-input", data: { template_preview_target: "signature-image-upload", file_picker_input: true, file_picker_name: "signature-file-name" } %>
              <button type="button" class="app-file-picker-btn" data-file-picker-trigger="quote_template_signature_image"><%= t("quote_templates.view.form.choose_file") %></button>
              <span class="app-file-picker-name" id="signature-file-name"><%= quote_template.signature_image.attached? ? quote_template.signature_image.filename.to_s : t("quote_templates.view.form.no_file_selected") %></span>
            </div>
            <p class="template-sub"><%= t("quote_templates.view.form.signature_image_hint") %></p>
            <% if quote_template.signature_image.attached? %>
              <label><%= check_box_tag "quote_template[remove_signature_image]", "1", false %> <%= t("quote_templates.view.form.remove_existing_signature_image") %></label>
            <% end %>
          </div>
          <div data-watermark-text-container>
            <%= f.label :watermark_text, t("quote_templates.view.form.watermark_text") %>
            <%= f.text_field :watermark_text, placeholder: t("quote_templates.view.form.watermark_text_placeholder"), data: { template_preview_target: "watermark-text" } %>
            <p class="template-sub" data-watermark-mode-hint><%= t("quote_templates.view.form.watermark_text_hint") %></p>
          </div>
          <div>
            <%= f.label :watermark_image, t("quote_templates.view.form.watermark_image") %>
            <div class="app-file-picker" data-file-picker>
              <%= f.file_field :watermark_image, id: "quote_template_watermark_image", accept: "image/*", class: "app-file-input", data: { template_preview_target: "watermark-image-upload", file_picker_input: true, file_picker_name: "watermark-file-name", existing_file: quote_template.watermark_image.attached? } %>
              <button type="button" class="app-file-picker-btn" data-file-picker-trigger="quote_template_watermark_image"><%= t("quote_templates.view.form.choose_file") %></button>
              <span class="app-file-picker-name" id="watermark-file-name"><%= quote_template.watermark_image.attached? ? quote_template.watermark_image.filename.to_s : t("quote_templates.view.form.no_file_selected") %></span>
            </div>
            <p class="template-sub"><%= t("quote_templates.view.form.watermark_image_hint") %></p>
            <% if quote_template.watermark_image.attached? %>
              <label><%= check_box_tag "quote_template[remove_watermark_image]", "1", false %> <%= t("quote_templates.view.form.remove_existing_watermark_image") %></label>
            <% end %>
          </div>
          <div>
            <%= f.label :watermark_opacity, t("quote_templates.view.form.watermark_intensity") %>
            <%= f.number_field :watermark_opacity, min: 3, max: 40, step: 1, data: { template_preview_target: "watermark-opacity" } %>
            <p class="template-sub"><%= t("quote_templates.view.form.watermark_intensity_hint") %></p>
          </div>
        </div>
      </section>

      <section class="template-editor-section template-editor-section-compact">
        <header>
          <h3><%= t("quote_templates.view.form.output_language_title") %></h3>
          <p><%= t("quote_templates.view.form.output_language_hint") %></p>
          <div class="output-lang-sync-row">
            <select id="output_lang_sync_select" class="<%= ui_input_classes %>" data-output-lang-sync-select aria-label="<%= t("quote_templates.view.form.apply_all_locales") %>">
              <% quote_template.output_locale_options.each do |label, value| %>
                <option value="<%= value %>"><%= label %></option>
              <% end %>
            </select>
          </div>
        </header>
        <div class="template-form-grid">
          <div>
            <%= f.label :webview_locale, t("quote_templates.view.form.output_language_webview") %>
            <%= f.select :webview_locale, quote_template.output_locale_options, {}, class: ui_input_classes, data: { template_preview_target: "webview-locale", output_lang_target: true } %>
          </div>
          <div>
            <%= f.label :public_link_locale, t("quote_templates.view.form.public_link_locale") %>
            <%= f.select :public_link_locale, quote_template.output_locale_options, {}, class: ui_input_classes, data: { output_lang_target: true } %>
          </div>
          <div>
            <%= f.label :pdf_locale, t("quote_templates.view.form.pdf_locale") %>
            <%= f.select :pdf_locale, quote_template.output_locale_options, {}, class: ui_input_classes, data: { output_lang_target: true } %>
          </div>
          <div>
            <%= f.label :excel_locale, t("quote_templates.view.form.excel_locale") %>
            <%= f.select :excel_locale, quote_template.output_locale_options, {}, class: ui_input_classes, data: { output_lang_target: true } %>
          </div>
        </div>
      </section>

      <section class="template-editor-section template-editor-section-compact">
        <header>
          <h3><%= t("quote_templates.view.form.number_format") %></h3>
          <p><%= t("quote_templates.view.form.number_format_hint") %></p>
        </header>
        <div class="template-form-grid">
          <div>
            <%= f.label :amount_decimals, t("quote_templates.view.form.decimal_places") %>
            <%= f.select :amount_decimals, [["0", 0], ["2", 2]], {}, data: { template_preview_target: "amount-decimals" } %>
          </div>
          <div>
            <%= f.label :thousand_separator, t("quote_templates.view.form.thousand_separator") %>
            <%= f.select :thousand_separator, [["1,234.00", "comma"], ["1 234.00", "space"], ["1234.00", "none"]], {}, data: { template_preview_target: "thousand-separator" } %>
          </div>
          <div>
            <%= f.label :currency_display_mode, t("quote_templates.view.form.currency_display") %>
            <%= f.select :currency_display_mode, [["Symbol Prefix ($123)", "symbol_prefix"], ["Code Prefix (USD 123)", "code_prefix"], ["Code Suffix (123 USD)", "code_suffix"]], {}, data: { template_preview_target: "currency-display-mode" } %>
          </div>
        </div>
      </section>

      <% if advanced_collapsible %>
        <details class="template-editor-section template-editor-section-advanced" open>
          <summary class="template-editor-summary">
            <strong><%= t("quote_templates.view.form.labels_text") %></strong>
            <span><%= t("quote_templates.view.form.advanced_settings") %></span>
          </summary>
          <div class="template-editor-section-body">
            <div class="template-form-grid">
              <div>
                <%= f.label :description_label, t("quote_templates.view.form.description_label") %>
                <%= f.text_field :description_label, data: { template_preview_target: "label-description" } %>
              </div>
              <div data-template-doc-kind-field="quotation">
                <%= f.label :scope_of_supply_label, t("quote_templates.view.form.scope_of_supply_label") %>
                <%= f.text_field :scope_of_supply_label, placeholder: t("quote_templates.defaults.scope_of_supply_label"), data: { template_preview_target: "label-scope-of-supply" } %>
              </div>
              <div>
                <%= f.label :spec_label, t("quote_templates.view.form.spec_label") %>
                <%= f.text_field :spec_label, placeholder: t("quote_templates.view.form.spec_placeholder"), data: { template_preview_target: "label-spec" } %>
              </div>
              <div>
                <%= f.label :addon_label, t("quote_templates.view.form.addon_label") %>
                <%= f.text_field :addon_label, placeholder: t("quote_templates.view.form.addon_placeholder"), data: { template_preview_target: "label-addon" } %>
              </div>
              <div>
                <%= f.label :qty_label, t("quote_templates.view.form.qty_label") %>
                <%= f.text_field :qty_label, data: { template_preview_target: "label-qty" } %>
              </div>
              <div>
                <%= f.label :unit_price_label, t("quote_templates.view.form.unit_price_label") %>
                <%= f.text_field :unit_price_label, data: { template_preview_target: "label-unit-price" } %>
              </div>
              <div>
                <%= f.label :line_total_label, t("quote_templates.view.form.line_total_label") %>
                <%= f.text_field :line_total_label, data: { template_preview_target: "label-line-total" } %>
              </div>
              <div data-template-doc-kind-field="quotation">
                <%= f.label :quotation_title, t("quote_templates.view.form.quotation_title") %>
                <%= f.text_field :quotation_title, placeholder: t("quote_templates.view.form.quotation_title_placeholder"), data: { template_preview_target: "title-quote" } %>
              </div>
              <div data-template-doc-kind-field="quotation">
                <%= f.label :quotation_number_label, t("quote_templates.view.form.quotation_number_label") %>
                <%= f.text_field :quotation_number_label, placeholder: t("quote_templates.view.form.quotation_number_placeholder"), data: { template_preview_target: "number-label-quote" } %>
              </div>
              <div data-template-doc-kind-field="proforma_invoice">
                <%= f.label :pi_title, t("quote_templates.view.form.pi_title") %>
                <%= f.text_field :pi_title, placeholder: t("quote_templates.view.form.pi_title_placeholder") %>
              </div>
              <div data-template-doc-kind-field="proforma_invoice">
                <%= f.label :pi_number_label, t("quote_templates.view.form.pi_number_label") %>
                <%= f.text_field :pi_number_label, placeholder: t("quote_templates.view.form.pi_number_placeholder"), data: { template_preview_target: "number-label-pi" } %>
              </div>
              <div class="template-span-2" data-template-doc-kind-field="quotation">
                <%= f.label :quotation_footer_note, t("quote_templates.view.form.quotation_footer_note") %>
                <%= f.text_area :quotation_footer_note, rows: 2, data: { template_preview_target: "footer-quote" } %>
                <p class="template-sub"><%= t("quote_templates.view.form.quotation_footer_note_hint") %></p>
              </div>
              <div class="template-span-2" data-template-doc-kind-field="proforma_invoice">
                <%= f.label :pi_footer_note, t("quote_templates.view.form.pi_footer_note") %>
                <%= f.text_area :pi_footer_note, rows: 2 %>
                <p class="template-sub"><%= t("quote_templates.view.form.pi_footer_note_hint") %></p>
              </div>
              <div class="template-span-2">
                <%= f.label :footer_text, t("quote_templates.view.form.fallback_footer_text") %>
                <%= f.text_area :footer_text, rows: 2, data: { template_preview_target: "footer-fallback" } %>
                <p class="template-sub"><%= t("quote_templates.view.form.fallback_footer_text_hint") %></p>
              </div>
              <div class="template-span-2">
                <%= f.label :closing_message, t("quote_templates.view.form.closing_message") %>
                <%= f.text_area :closing_message, rows: 2, placeholder: QuoteTemplate::DEFAULT_CLOSING_MESSAGE %>
                <p class="template-sub"><%= t("quote_templates.view.form.closing_message_hint") %></p>
              </div>
            </div>
          </div>
        </details>
      <% else %>
        <section class="template-editor-section template-editor-section-advanced">
          <header>
            <h3><%= t("quote_templates.view.form.labels_text") %></h3>
            <p><%= t("quote_templates.view.form.labels_text_hint") %></p>
          </header>
          <div class="template-form-grid">
            <div>
              <%= f.label :description_label, t("quote_templates.view.form.description_label") %>
              <%= f.text_field :description_label, data: { template_preview_target: "label-description" } %>
            </div>
            <div data-template-doc-kind-field="quotation">
              <%= f.label :scope_of_supply_label, t("quote_templates.view.form.scope_of_supply_label") %>
              <%= f.text_field :scope_of_supply_label, placeholder: t("quote_templates.defaults.scope_of_supply_label"), data: { template_preview_target: "label-scope-of-supply" } %>
            </div>
            <div>
              <%= f.label :spec_label, t("quote_templates.view.form.spec_label") %>
              <%= f.text_field :spec_label, placeholder: t("quote_templates.view.form.spec_placeholder"), data: { template_preview_target: "label-spec" } %>
            </div>
            <div>
              <%= f.label :addon_label, t("quote_templates.view.form.addon_label") %>
              <%= f.text_field :addon_label, placeholder: t("quote_templates.view.form.addon_placeholder"), data: { template_preview_target: "label-addon" } %>
            </div>
            <div>
              <%= f.label :qty_label, t("quote_templates.view.form.qty_label") %>
              <%= f.text_field :qty_label, data: { template_preview_target: "label-qty" } %>
            </div>
            <div>
              <%= f.label :unit_price_label, t("quote_templates.view.form.unit_price_label") %>
              <%= f.text_field :unit_price_label, data: { template_preview_target: "label-unit-price" } %>
            </div>
            <div>
              <%= f.label :line_total_label, t("quote_templates.view.form.line_total_label") %>
              <%= f.text_field :line_total_label, data: { template_preview_target: "label-line-total" } %>
            </div>
            <div data-template-doc-kind-field="quotation">
              <%= f.label :quotation_title, t("quote_templates.view.form.quotation_title") %>
              <%= f.text_field :quotation_title, placeholder: t("quote_templates.view.form.quotation_title_placeholder"), data: { template_preview_target: "title-quote" } %>
            </div>
            <div data-template-doc-kind-field="quotation">
              <%= f.label :quotation_number_label, t("quote_templates.view.form.quotation_number_label") %>
              <%= f.text_field :quotation_number_label, placeholder: t("quote_templates.view.form.quotation_number_placeholder"), data: { template_preview_target: "number-label-quote" } %>
            </div>
            <div data-template-doc-kind-field="proforma_invoice">
              <%= f.label :pi_title, t("quote_templates.view.form.pi_title") %>
              <%= f.text_field :pi_title, placeholder: t("quote_templates.view.form.pi_title_placeholder") %>
            </div>
            <div data-template-doc-kind-field="proforma_invoice">
              <%= f.label :pi_number_label, t("quote_templates.view.form.pi_number_label") %>
              <%= f.text_field :pi_number_label, placeholder: t("quote_templates.view.form.pi_number_placeholder"), data: { template_preview_target: "number-label-pi" } %>
            </div>
            <div class="template-span-2" data-template-doc-kind-field="quotation">
              <%= f.label :quotation_footer_note, t("quote_templates.view.form.quotation_footer_note") %>
              <%= f.text_area :quotation_footer_note, rows: 2, data: { template_preview_target: "footer-quote" } %>
              <p class="template-sub"><%= t("quote_templates.view.form.quotation_footer_note_hint") %></p>
            </div>
            <div class="template-span-2" data-template-doc-kind-field="proforma_invoice">
              <%= f.label :pi_footer_note, t("quote_templates.view.form.pi_footer_note") %>
              <%= f.text_area :pi_footer_note, rows: 2 %>
              <p class="template-sub"><%= t("quote_templates.view.form.pi_footer_note_hint") %></p>
            </div>
            <div class="template-span-2">
              <%= f.label :footer_text, t("quote_templates.view.form.fallback_footer_text") %>
              <%= f.text_area :footer_text, rows: 2, data: { template_preview_target: "footer-fallback" } %>
              <p class="template-sub"><%= t("quote_templates.view.form.fallback_footer_text_hint") %></p>
            </div>
