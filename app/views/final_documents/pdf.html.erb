<% document = @document; snapshot = document.snapshot.deep_stringify_keys; acceptance = document.quote_acceptance; items = Array(snapshot["quote_items"]) %>
<style>.final-pdf{font:10pt Arial;color:#121620}.final-pdf header{display:flex;justify-content:space-between;border-bottom:3px solid #4d7cff;padding-bottom:8mm}.final-pdf h1{font-size:26pt;margin:0}.final-pdf h2{font-size:12pt}.final-pdf table{width:100%;border-collapse:collapse;margin-top:8mm}.final-pdf th,.final-pdf td{padding:3mm;border-bottom:1px solid #d8dce5;text-align:left}.final-pdf .money{text-align:right}.final-pdf .total{margin:8mm 0 0 auto;width:70mm;padding:6mm;background:#121620;color:#fff}.final-pdf .total strong{display:block;font-size:20pt;color:#79f2b2}.final-pdf footer{margin-top:12mm;border-top:1px solid #d8dce5;padding-top:4mm}</style>
<article class="final-pdf"><header><div><small><%= document.company.name %></small><h1><%= document.title %></h1><p>Accepted commercial record</p></div><dl><dt>Document</dt><dd><%= document.number %></dd><dt>Quote</dt><dd><%= document.quote.quote_no %></dd><dt>Version</dt><dd><%= acceptance.quote_revision.number %></dd><dt>Accepted</dt><dd><%= acceptance.accepted_at.to_date %></dd></dl></header>
<section><h2>Buyer</h2><p><strong><%= acceptance.buyer_company.presence || snapshot["customer_name"] %></strong><br><%= acceptance.name %> · <%= acceptance.email %></p></section>
<table><thead><tr><th>Product</th><th>SKU / specification</th><th>Qty</th><th class="money">Unit price</th><th class="money">Amount</th></tr></thead><tbody><% items.each do |item| %><tr><td><strong><%= item["description"] %></strong></td><td><%= item["sku_snapshot"] %><br><small><%= Array(item["specifications"]).map { |s| "#{s['key']}: #{s['value']}" }.join(" · ") %></small></td><td><%= item["quantity"] %> <%= item["unit_snapshot"] %></td><td class="money"><%= document.currency %> <%= number_with_delimiter(item["unit_price"]) %></td><td class="money"><%= document.currency %> <%= number_with_delimiter(item["quantity"].to_d * item["unit_price"].to_d) %></td></tr><% end %></tbody></table>
<div class="total"><span>Accepted total</span><strong><%= document.currency %> <%= number_with_delimiter(document.total) %></strong></div>
<section><h2>Accepted terms</h2><p><strong>Payment:</strong> <%= snapshot["payment_term"] %><br><strong>Incoterm:</strong> <%= snapshot["trade_term"] %><br><strong>Delivery:</strong> <%= snapshot["delivery_notes"] %></p></section>
<footer>Acceptance source: <%= acceptance.acceptance_method.humanize %> · Accepted by <%= acceptance.name %> · Generated <%= document.generated_at || Time.current %></footer></article>
