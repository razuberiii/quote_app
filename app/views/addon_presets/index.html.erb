<h1 id="new"><%= t("addon_presets.view.index.title") %></h1>

<p><%= link_to t("addon_presets.view.index.back_to_product_presets"), product_presets_path, class: "form-page-back-link" %></p>

<section class="team-members-panel">
  <h2><%= t("addon_presets.view.index.create_title") %></h2>
  <%= render "form", addon_preset: @addon_preset %>
</section>

<section class="team-members-panel">
  <h2><%= t("addon_presets.view.index.library_title") %></h2>
  <% if @addon_presets.any? %>
    <div class="table-responsive">
      <table class="customers-table saas-table">
        <thead>
          <tr>
            <th><%= t("addon_presets.view.index.name") %></th>
            <th><%= t("addon_presets.view.index.addons") %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @addon_presets.each do |preset| %>
            <tr>
              <td><strong><%= preset.name %></strong></td>
              <td><%= preset.normalized_entries.map { |entry| "#{entry[:name]}: #{entry[:price]}" }.join(" • ") %></td>
              <td class="text-right">
                <%= link_to t("addon_presets.view.index.edit"), edit_addon_preset_path(preset), class: "app-ui-button app-ui-button--secondary" %>
                <%= button_to t("addon_presets.view.index.delete"), addon_preset_path(preset), method: :delete, data: { turbo_confirm: t("addon_presets.view.index.delete_confirm") }, class: "app-ui-button app-ui-button--secondary" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="team-members-hint"><%= t("addon_presets.view.index.empty") %></p>
  <% end %>
</section>
