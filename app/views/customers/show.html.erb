<section class="app-page-shell app-page-shell--customer-detail">
<header class="app-page-header">
  <div class="app-page-header-main">
    <h1><%= @customer.name %></h1>
    <p><%= t("customers.view.show.subtitle") %></p>
    <div class="app-page-header-meta">
      <%= customer_status_badge(@customer) %>
    </div>
  </div>
  <div class="app-page-header-actions">
    <%= link_to customers_path, class: "customer-back-link" do %>
      <span aria-hidden="true">←</span>
      <span><%= t("customers.view.show.back_to_customers") %></span>
    <% end %>
  </div>
</header>

<div class="app-page-split customer-workspace-layout">
  <aside class="app-page-split-side app-section-stack customer-detail-side">
    <%= render "components/ui/card", class: "customer-profile-card app-surface app-panel-muted" do %>
      <div class="customer-profile-card-head">
        <div class="customer-profile-identity">
          <span class="customer-list-avatar customer-profile-avatar" aria-hidden="true">
            <% if @customer.avatar.attached? && @customer.avatar.blob&.persisted? %>
              <%= image_tag @customer.avatar, alt: "#{@customer.name} avatar" %>
            <% else %>
              <span><%= @customer.avatar_initial %></span>
            <% end %>
          </span>
          <div>
            <strong><%= @customer.name %></strong>
            <p><%= @customer.email.presence || t("customers.view.show.no_email") %></p>
            <% if @customer.ordered_tag_names.any? %>
              <div class="customer-profile-tags">
                <% @customer.ordered_tag_names.each do |tag_name| %>
                  <span class="customer-profile-tag"><%= tag_name %></span>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
        <div class="customer-profile-actions">
          <%= render "components/ui/button", href: edit_customer_path(@customer), variant: :secondary, class: "customer-edit-cta" do %>
            <%= t("customers.view.show.edit_customer") %>
          <% end %>
          <% if @customer.raw_status_css == "paused" %>
            <%= button_to t("customers.view.show.resume_customer"), resume_customer_path(@customer), method: :patch, class: ui_button_classes(:secondary) %>
          <% else %>
            <%= button_to t("customers.view.show.pause_customer"), pause_customer_path(@customer), method: :patch, class: ui_button_classes(:danger) %>
          <% end %>
        </div>
      </div>
    <% end %>

    <section class="quote-edit-summary customer-top-summary app-stat-grid customer-side-section customer-side-section--metrics">
      <article class="quote-edit-summary-card app-surface">
        <span class="summary-label"><%= t("customers.view.show.total_quotes") %></span>
        <strong><%= @customer_summary[:total_quotes] %></strong>
      </article>
      <article class="quote-edit-summary-card app-surface">
        <span class="summary-label"><%= t("customers.view.show.latest_quote") %></span>
        <strong><%= @customer_summary[:latest_quote_at]&.strftime("%Y-%m-%d") || t("customers.view.show.no_quote_yet") %></strong>
      </article>
      <article class="quote-edit-summary-card app-surface">
        <span class="summary-label"><%= t("customers.view.show.sales_stage") %></span>
        <strong><%= @customer_summary[:sales_stage] %></strong>
        <%= customer_status_badge(@customer) %>
      </article>
      <article class="quote-edit-summary-card app-surface">
        <span class="summary-label"><%= t("customers.view.show.engagement") %></span>
        <strong><%= @customer_engagement[:label] %></strong>
        <%= status_badge(@customer_engagement[:label], @customer_engagement[:color], "customer-engagement-badge #{@customer_engagement[:css]}") %>
      </article>
    </section>

    <section class="customer-operating-signals app-surface customer-side-section customer-side-section--signals">
      <div class="app-section-heading">
        <h3><%= t("customers.view.show.operating_signals") %></h3>
        <span class="app-subtle-note"><%= t("customers.view.show.operating_signals_hint") %></span>
      </div>
      <div class="customer-operating-grid">
        <% @customer_operating_signals.each do |signal| %>
          <article class="customer-operating-card is-<%= signal[:tone] %>">
            <span class="customer-operating-label"><%= signal[:label] %></span>
            <strong><%= signal[:value] %></strong>
            <p><%= signal[:detail] %></p>
          </article>
        <% end %>
      </div>
    </section>

    <details class="customer-details-collapsible app-surface customer-side-section customer-side-section--secondary">
      <summary><%= t("customers.view.show.company_contact_details") %></summary>
      <div class="customer-details">
        <p><strong><%= t("customers.view.show.company_name") %>:</strong> <%= @customer.name.presence || "-" %></p>
        <p><strong><%= t("customers.view.show.country") %>:</strong> <%= @customer.country.presence || "-" %></p>
        <p><strong><%= t("customers.view.show.customer_level") %>:</strong> <%= t("customers.view.form.level_options.#{@customer.customer_level}", default: @customer.customer_level.to_s.humanize) %></p>
        <p><strong><%= t("customers.view.show.status") %>:</strong> <%= customer_status_badge(@customer) %></p>
        <p><strong><%= t("customers.view.show.primary_contact_name") %>:</strong> <%= @customer.contact_name.presence || "-" %></p>
        <p><strong><%= t("customers.view.show.email") %>:</strong> <%= @customer.email.presence || "-" %></p>
        <p><strong><%= t("customers.view.show.phone") %>:</strong> <%= @customer.formatted_phone.presence || "-" %></p>
        <% if @customer.tax_id.present? %>
          <p><strong><%= t("customers.view.show.tax_id", default: "Tax ID") %>:</strong> <%= [@customer.tax_id_type.presence, @customer.tax_id].compact.join(" ") %></p>
        <% end %>
        <p><strong><%= t("customers.view.show.address") %>:</strong> <%= @customer.address.presence || "-" %></p>
        <p><strong><%= t("customers.view.show.payment_terms") %>:</strong> <%= @customer.payment_terms.to_s.upcase.gsub("_", "/").presence || "-" %></p>
        <p><strong><%= t("customers.view.show.main_product_interest") %>:</strong> <%= @customer.main_product_interest.presence || "-" %></p>
        <p><strong><%= t("customers.view.show.internal_owner") %>:</strong> <%= @customer.internal_owner_display_name %></p>
        <p><strong><%= t("customers.view.show.estimated_annual_volume") %>:</strong> <%= @customer.estimated_annual_volume.present? ? number_with_precision(@customer.estimated_annual_volume, precision: 2, delimiter: ",") : "-" %></p>
        <p><strong><%= t("customers.view.show.timezone") %>:</strong> <%= @customer.timezone.presence || "-" %></p>
        <% if @customer.ordered_tag_names.any? %>
          <p><strong><%= t("customers.view.show.tags") %>:</strong> <%= @customer.ordered_tag_names.join(", ") %></p>
        <% end %>
        <p><strong><%= t("customers.view.show.latest_customer_signal") %>:</strong> <%= @latest_customer_signal_at&.strftime("%Y-%m-%d %H:%M") || t("customers.view.show.no_customer_behavior") %></p>
        <p class="customer-next-follow-up-line follow-up-<%= @customer.follow_up_status %>">
          <strong><%= t("customers.view.show.next_follow_up") %>:</strong> <%= @customer.next_follow_up_date&.strftime("%Y-%m-%d") || t("customers.view.show.not_available") %>
          <% if @customer.follow_up_overdue? %>
            <span class="overdue-badge"><%= t("customers.view.show.overdue_badge") %></span>
          <% elsif @customer.follow_up_due_today? %>
            <span class="today-badge"><%= t("customers.view.show.today_badge") %></span>
          <% elsif @customer.follow_up_status == "upcoming" %>
            <span class="upcoming-badge"><%= t("customers.view.show.due_soon_badge") %></span>
          <% end %>
        </p>
        <% if @customer.notes.present? %>
          <p><strong><%= t("customers.view.show.notes") %>:</strong> <%= @customer.notes %></p>
        <% end %>
      </div>
    </details>

    <section class="customer-follow-up-callout app-surface customer-side-section customer-side-section--action follow-up-<%= @customer.follow_up_status %>">
      <div>
        <span class="summary-label"><%= t("customers.view.show.follow_up_action") %></span>
        <strong><%= @follow_up_text %></strong>
        <div class="customer-follow-up-meta">
          <span><%= t("customers.view.show.last_signal") %>: <%= @days_since_last_signal.nil? ? t("customers.view.show.not_available") : t("customers.view.show.days_ago", count: @days_since_last_signal) %></span>
          <span><%= t("customers.view.show.next_follow_up") %>: <%= @days_until_follow_up.nil? ? t("customers.view.show.not_scheduled") : (@days_until_follow_up.negative? ? t("customers.view.show.days_overdue", count: @days_until_follow_up.abs) : t("customers.view.show.in_days", count: @days_until_follow_up)) %></span>
        </div>
      </div>
      <div class="customer-follow-up-callout-actions">
        <% if @follow_up_primary_action[:method] == :post %>
          <%= button_to @follow_up_primary_action[:label], @follow_up_primary_action[:path], method: :post, class: ui_button_classes(:primary, "customer-inline-cta js-shortcut-follow-up") %>
        <% else %>
          <%= link_to @follow_up_primary_action[:label], @follow_up_primary_action[:path], class: ui_button_classes(:primary, "customer-inline-cta js-shortcut-follow-up") %>
        <% end %>
      </div>
    </section>

    <section class="customer-task-board app-surface customer-side-section customer-side-section--primary">
      <div class="app-section-heading">
        <h3><%= t("customers.view.show.next_tasks") %></h3>
        <span class="app-subtle-note"><%= t("customers.view.show.next_tasks_hint") %></span>
      </div>
      <% if @visible_follow_up_tasks.any? %>
        <div class="customer-task-list">
          <% @visible_follow_up_tasks.each do |task| %>
            <article class="customer-task-card is-<%= task[:priority] %>">
              <div class="customer-task-meta">
                <span class="customer-task-priority"><%= t("customers.view.show.task_priority.#{task[:priority]}", default: task[:priority].upcase) %></span>
                <h4><%= task[:title] %></h4>
                <p><%= task[:detail] %></p>
              </div>
              <% if task[:cta_path].present? && task[:cta_label].present? %>
                <div class="customer-task-actions">
                  <% if task[:cta_path].to_s.include?("/schedule_follow_up") || task[:cta_path].to_s.include?("/mark_follow_up") %>
                    <%= button_to task[:cta_label], task[:cta_path], method: :post, class: ui_button_classes(:primary) %>
                  <% else %>
                    <%= link_to task[:cta_label], task[:cta_path], class: ui_button_classes(:secondary, "customer-task-cta") %>
                  <% end %>
                </div>
              <% else %>
                <div class="customer-task-actions customer-task-actions-note"><%= t("customers.view.show.use_follow_up_controls") %></div>
              <% end %>
            </article>
          <% end %>
        </div>
        <% if @hidden_follow_up_tasks.any? %>
          <button
            type="button"
            class="<%= ui_button_classes(:secondary, 'customer-task-toggle customer-inline-toggle') %>"
            data-task-toggle
            data-expanded="false"
            data-task-count="<%= @hidden_follow_up_tasks.size %>"
          >
            <%= t("customers.view.show.show_all_tasks", count: @hidden_follow_up_tasks.size) %>
          </button>
          <div class="customer-task-list customer-task-more" data-task-more hidden>
            <% @hidden_follow_up_tasks.each do |task| %>
              <article class="customer-task-card is-<%= task[:priority] %>">
                <div class="customer-task-meta">
                  <span class="customer-task-priority"><%= t("customers.view.show.task_priority.#{task[:priority]}", default: task[:priority].upcase) %></span>
                  <h4><%= task[:title] %></h4>
                  <p><%= task[:detail] %></p>
                </div>
                <% if task[:cta_path].present? && task[:cta_label].present? %>
                  <div class="customer-task-actions">
                    <% if task[:cta_path].to_s.include?("/schedule_follow_up") || task[:cta_path].to_s.include?("/mark_follow_up") %>
                      <%= button_to task[:cta_label], task[:cta_path], method: :post, class: ui_button_classes(:primary) %>
                    <% else %>
                      <%= link_to task[:cta_label], task[:cta_path], class: ui_button_classes(:secondary, "customer-task-cta") %>
                    <% end %>
                  </div>
                <% else %>
                  <div class="customer-task-actions customer-task-actions-note"><%= t("customers.view.show.use_follow_up_controls") %></div>
                <% end %>
              </article>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <p class="team-members-hint"><%= t("customers.view.show.no_immediate_tasks") %></p>
      <% end %>
    </section>

    <div class="customer-side-section customer-side-section--assistant">
      <%= render "follow_up_assistant",
                 customer: @customer,
                 follow_up_quote: @follow_up_assistant_quote,
                 message: @suggested_follow_up_message,
                 best_contact_time: @best_contact_time,
                 follow_up_email_ready: @follow_up_email_ready,
                 follow_up_email_block_reason: @follow_up_email_block_reason,
                 quote_signal_label: follow_up_signal_label(@follow_up_quote_view_status, @follow_up_quote_expiry_status, @follow_up_quote_signal&.type) %>
    </div>

    <section class="customer-timeline app-surface customer-side-section customer-side-section--secondary">
      <div class="app-section-heading">
        <h3><%= t("customers.view.show.customer_timeline") %></h3>
        <span class="app-subtle-note"><%= t("customers.view.show.customer_timeline_hint") %></span>
      </div>
      <% if @high_signal_timeline_events.any? || @system_timeline_events.any? %>
        <p class="customer-timeline-hint">
          <%= t("customers.view.show.latest_customer_behavior") %>:
          <strong><%= @latest_customer_signal_at&.strftime("%Y-%m-%d %H:%M") || t("customers.view.show.no_customer_behavior") %></strong>
        </p>

        <% if @visible_high_signal_timeline_events.any? %>
          <h4 class="customer-timeline-subhead"><%= t("customers.view.show.high_signal") %></h4>
          <div class="customer-timeline-list <%= 'customer-timeline-list-scroll' if @high_signal_timeline_events.size > 7 %>">
            <% @visible_high_signal_timeline_events.each do |event| %>
              <article class="customer-timeline-item is-<%= event[:tone] %>">
                <div class="customer-timeline-dot"></div>
                <div class="customer-timeline-content">
                  <p class="customer-timeline-time"><%= event[:at]&.strftime("%Y-%m-%d %H:%M") || "-" %></p>
                  <h4><%= event[:title] %></h4>
                  <p><%= event[:detail] %></p>
                </div>
              </article>
            <% end %>
          </div>
          <% if @hidden_high_signal_timeline_events.any? %>
            <button
              type="button"
              class="<%= ui_button_classes(:secondary, 'customer-timeline-toggle customer-inline-toggle') %>"
              data-high-signal-toggle
              data-expanded="false"
              data-high-count="<%= @hidden_high_signal_timeline_events.size %>"
            >
              <%= t("customers.view.show.show_older_high_signals", count: @hidden_high_signal_timeline_events.size) %>
            </button>
            <div class="customer-timeline-more" data-high-signal-more hidden>
              <% @hidden_high_signal_timeline_events.each do |event| %>
                <article class="customer-timeline-item is-<%= event[:tone] %>">
                  <div class="customer-timeline-dot"></div>
                  <div class="customer-timeline-content">
                    <p class="customer-timeline-time"><%= event[:at]&.strftime("%Y-%m-%d %H:%M") || "-" %></p>
                    <h4><%= event[:title] %></h4>
                    <p><%= event[:detail] %></p>
                  </div>
                </article>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <p class="team-members-hint"><%= t("customers.view.show.no_customer_behavior_signals") %></p>
        <% end %>

        <% if @system_timeline_events.any? %>
          <button
            type="button"
            class="<%= ui_button_classes(:secondary, 'customer-timeline-toggle customer-inline-toggle') %>"
            data-system-timeline-toggle
            data-expanded="false"
            data-system-count="<%= @system_timeline_events.size %>"
          >
            <%= t("customers.view.show.show_system_activity", count: @system_timeline_events.size) %>
          </button>
          <div class="customer-timeline-more customer-timeline-system" data-system-timeline-more hidden>
            <h4 class="customer-timeline-subhead"><%= t("customers.view.show.system_activity") %></h4>
            <% @system_timeline_events.each do |event| %>
              <article class="customer-timeline-item is-<%= event[:tone] %>">
                <div class="customer-timeline-dot"></div>
                <div class="customer-timeline-content">
                  <p class="customer-timeline-time"><%= event[:at]&.strftime("%Y-%m-%d %H:%M") || "-" %></p>
                  <h4><%= event[:title] %></h4>
                  <p><%= event[:detail] %></p>
                </div>
              </article>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <p class="team-members-hint"><%= t("customers.view.show.no_timeline_events") %></p>
      <% end %>
    </section>
  </aside>

  <div class="app-page-split-main app-section-stack customer-detail-main">
    <section class="app-toolbar-surface customer-quote-workbench">
      <div class="app-section-heading customer-quote-action-bar">
        <div>
          <span class="customer-actions-title"><%= t("customers.view.show.quote_actions") %></span>
          <p class="app-section-caption"><%= t("customers.view.show.quote_actions_hint") %></p>
        </div>
        <div class="actions customer-quote-actions">
          <%= link_to t("customers.view.show.new_quote"), new_customer_quote_path(@customer), class: ui_button_classes(:primary, "customer-new-quote-cta js-shortcut-new-quote-current-customer") %>
          <%= button_to t("customers.view.show.delete_customer"),
                        customer_path(@customer),
                        method: :delete,
                        data: { turbo_confirm: t("customers.view.show.delete_customer_confirm", name: @customer.name) },
                        class: ui_button_classes(:danger, "customer-delete-cta") %>
        </div>
      </div>

      <div class="app-section-heading customer-quotes-header">
        <h3>
          <% if @quote_view == "active" %>
            <%= t("customers.view.show.active_quotes", count: @active_quote_cards.size) %>
          <% elsif @quote_view == "recent" %>
            <%= t("customers.view.show.recent_quotes", count: @recent_quote_cards.size) %>
          <% else %>
            <%= t("customers.view.show.all_quotes", count: @all_quote_cards.size) %>
          <% end %>
        </h3>
        <span class="app-subtle-note"><%= t("customers.view.show.quote_workspace_hint") %></span>
      </div>

      <% if @quote_view == "active" %>
        <p class="quotes-mode-note"><%= t("customers.view.show.active_mode_note") %></p>
        <p class="quotes-structure-note">
          <strong><%= @active_quote_cards.size %></strong> <%= t("customers.view.show.active") %>
          <span>• <%= @active_quote_breakdown["draft"] %> <%= t("customers.view.show.quote_status.draft") %></span>
          <span>• <%= @active_quote_breakdown["sent"] %> <%= t("customers.view.show.quote_status.sent") %></span>
          <span>• <%= @active_quote_breakdown["viewed"] %> <%= t("customers.view.show.quote_status.viewed") %></span>
          <span>• <%= @active_quote_breakdown["negotiating"] %> <%= t("customers.view.show.quote_status.negotiating") %></span>
        </p>
      <% elsif @quote_view == "recent" %>
        <p class="quotes-mode-note"><%= t("customers.view.show.recent_mode_note", count: 10) %></p>
      <% end %>

      <div class="quote-summary-grid customer-quote-summary-grid">
        <div class="summary-card summary-normal">
          <span class="summary-label"><%= t("customers.view.show.total_quotes") %></span>
          <strong><%= @quote_summary[:total_count] %></strong>
        </div>
        <div class="summary-card summary-won">
          <span class="summary-label"><%= t("customers.view.show.won_amount") %></span>
          <div class="summary-currency-lines" data-currency-group>
            <% if @quote_summary[:won_amounts_by_currency].any? %>
              <% @quote_summary[:won_amounts_by_currency].each_with_index do |(currency, amount), idx| %>
                <strong class="<%= "currency-line-extra" if idx > 0 %>" <%= "hidden" if idx > 0 %>><%= currency %>: <%= quote_money(amount, currency) %></strong>
              <% end %>
              <% if @quote_summary[:won_amounts_by_currency].size > 1 %>
                <button type="button" class="currency-lines-toggle" data-currency-toggle><%= t("customers.view.show.show_all_currencies") %></button>
              <% end %>
            <% else %>
              <strong>-</strong>
            <% end %>
          </div>
        </div>
        <div class="summary-card summary-lost">
          <span class="summary-label"><%= t("customers.view.show.lost_amount") %></span>
          <div class="summary-currency-lines" data-currency-group>
            <% if @quote_summary[:lost_amounts_by_currency].any? %>
              <% @quote_summary[:lost_amounts_by_currency].each_with_index do |(currency, amount), idx| %>
                <strong class="<%= "currency-line-extra" if idx > 0 %>" <%= "hidden" if idx > 0 %>><%= currency %>: <%= quote_money(amount, currency) %></strong>
              <% end %>
              <% if @quote_summary[:lost_amounts_by_currency].size > 1 %>
                <button type="button" class="currency-lines-toggle" data-currency-toggle><%= t("customers.view.show.show_all_currencies") %></button>
              <% end %>
            <% else %>
              <strong>-</strong>
            <% end %>
          </div>
        </div>
        <div class="summary-card summary-upcoming">
          <span class="summary-label"><%= t("customers.view.show.avg_discount") %></span>
          <strong><%= @quote_summary[:avg_discount_pct] %>%</strong>
        </div>
      </div>

      <div class="app-filter-row app-filter-row--spaced customer-quote-status-filters">
        <% [[t("customers.view.show.filters.all"), "all"], [t("customers.view.show.filters.draft"), "draft"], [t("customers.view.show.filters.sent"), "sent"], [t("customers.view.show.filters.viewed"), "viewed"], [t("customers.view.show.filters.negotiating"), "negotiating"], [t("customers.view.show.filters.won"), "won"], [t("customers.view.show.filters.lost"), "lost"], [t("customers.view.show.filters.expired"), "expired"]].each do |label, value| %>
          <%= link_to label,
                      customer_path(@customer, quote_status: value, quote_query: @quote_query.presence, quote_sort: @quote_sort, quote_view: @quote_view),
                      class: "app-filter-pill #{@quote_status_filter == value ? 'is-active' : ''}" %>
        <% end %>
      </div>

      <div class="app-filter-row app-filter-row--spaced customer-quote-view-filters">
        <%= link_to t("customers.view.show.active_quotes", count: @active_quote_cards.size),
                    customer_path(@customer, quote_status: @quote_status_filter, quote_query: @quote_query.presence, quote_sort: @quote_sort, quote_view: "active"),
                    class: "app-filter-pill #{@quote_view == 'active' ? 'is-active' : ''}" %>
        <%= link_to t("customers.view.show.recent_quotes", count: @recent_quote_cards.size),
                    customer_path(@customer, quote_status: @quote_status_filter, quote_query: @quote_query.presence, quote_sort: @quote_sort, quote_view: "recent"),
                    class: "app-filter-pill #{@quote_view == 'recent' ? 'is-active' : ''}" %>
        <%= link_to t("customers.view.show.filters.all"),
                    customer_path(@customer, quote_status: @quote_status_filter, quote_query: @quote_query.presence, quote_sort: @quote_sort, quote_view: "all"),
                    class: "app-filter-pill #{@quote_view == 'all' ? 'is-active' : ''}" %>
      </div>

      <div class="quote-queue-toolbar customer-quote-toolbar">
        <%= form_with url: customer_path(@customer), method: :get, local: true do |f| %>
          <%= f.hidden_field :quote_status, value: @quote_status_filter %>
          <%= f.hidden_field :quote_view, value: @quote_view %>
          <div class="quote-queue-toolbar-grid">
            <%= f.text_field :quote_query, value: @quote_query, placeholder: t("customers.view.show.search_quotes_placeholder"), class: ui_input_classes %>
            <%= f.select :quote_sort,
                         options_for_select([[t("customers.view.show.sort.priority"), "priority"], [t("customers.view.show.sort.newest"), "newest"], [t("customers.view.show.sort.highest_amount"), "amount_high"], [t("customers.view.show.sort.status"), "status"]], @quote_sort),
                         {},
                         { class: ui_input_classes } %>
            <%= f.button t("customers.view.show.apply"), type: :submit, class: ui_button_classes(:secondary, "customer-toolbar-apply") %>
          </div>
        <% end %>
      </div>
    </section>

    <% if @filtered_quote_cards.any? %>
      <div class="quote-card-list <%= 'quote-card-list-scroll' if @filtered_quote_cards.size > 6 %>">
        <% @filtered_quote_cards.each do |card| %>
          <%= render "quote_card", card: card %>
        <% end %>
      </div>
      <% if @quote_view == "active" && @active_quote_cards.size > 5 %>
        <button
          type="button"
          class="<%= ui_button_classes(:secondary, 'quote-expand-toggle') %>"
          data-active-quote-toggle
          data-expanded="false"
          data-active-count="<%= @active_quote_cards.size %>"
        >
          <%= t("customers.view.show.view_all", count: @active_quote_cards.size) %>
        </button>
        <div class="quote-card-list quote-card-list-scroll" data-active-quote-more hidden>
          <% @active_quote_cards.drop(5).each do |card| %>
            <%= render "quote_card", card: card %>
          <% end %>
        </div>
      <% end %>
      <% if @quote_view == "all" && @quotes_total_pages.to_i > 1 %>
        <div class="quote-pagination">
          <% prev_page = @quotes_page.to_i - 1 %>
          <% next_page = @quotes_page.to_i + 1 %>
          <% if prev_page >= 1 %>
            <%= link_to t("customers.view.show.previous"),
                        customer_path(@customer, quote_status: @quote_status_filter, quote_query: @quote_query.presence, quote_sort: @quote_sort, quote_view: @quote_view, quotes_page: prev_page),
                        class: ui_button_classes(:secondary) %>
          <% end %>
          <span><%= t("customers.view.show.page") %> <strong><%= @quotes_page %></strong> / <%= @quotes_total_pages %></span>
          <% if next_page <= @quotes_total_pages.to_i %>
            <%= link_to t("customers.view.show.next"),
                        customer_path(@customer, quote_status: @quote_status_filter, quote_query: @quote_query.presence, quote_sort: @quote_sort, quote_view: @quote_view, quotes_page: next_page),
                        class: ui_button_classes(:secondary) %>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <%= ui_empty_state(
            title: t("customers.view.show.no_quotes_title"),
            body: t("customers.view.show.no_quotes_body"),
            action_label: t("customers.view.show.new_quote"),
            action_path: new_customer_quote_path(@customer),
            icon: :quotes
          ) %>
    <% end %>
  </div>
</div>

</section>

<script>
  (() => {
    const toggles = document.querySelectorAll("[data-currency-toggle]");
    toggles.forEach((toggle) => {
      if (toggle.dataset.bound === "true") return;
      toggle.dataset.bound = "true";
      toggle.addEventListener("click", () => {
        const group = toggle.closest("[data-currency-group]");
        if (!group) return;
        const extras = group.querySelectorAll(".currency-line-extra");
        const collapsed = toggle.dataset.expanded !== "true";
        extras.forEach((line) => {
          line.hidden = !collapsed;
        });
        toggle.dataset.expanded = collapsed ? "true" : "false";
        toggle.textContent = collapsed ? "<%= j t("customers.view.show.show_less") %>" : "<%= j t("customers.view.show.show_all_currencies") %>";
      });
    });
  })();

  (() => {
    const bindActiveQuoteToggle = () => {
      const toggle = document.querySelector("[data-active-quote-toggle]");
      const extraContainer = document.querySelector("[data-active-quote-more]");
      if (!toggle || !extraContainer || toggle.dataset.bound === "true") return;
      toggle.dataset.bound = "true";

      const count = Number(toggle.dataset.activeCount || 0);
      const applyState = (expanded) => {
        extraContainer.hidden = !expanded;
        toggle.dataset.expanded = expanded ? "true" : "false";
        toggle.textContent = expanded ? "<%= j t("customers.view.show.collapse_list") %>" : `<%= j t("customers.view.show.view_all_prefix") %> ${count}`;
      };

      applyState(false);
      toggle.addEventListener("click", () => applyState(toggle.dataset.expanded !== "true"));
    };

    bindActiveQuoteToggle();
    document.addEventListener("turbo:load", bindActiveQuoteToggle);
  })();

  (() => {
    const bindTaskToggle = () => {
      const toggle = document.querySelector("[data-task-toggle]");
      const extraContainer = document.querySelector("[data-task-more]");
      if (!toggle || !extraContainer || toggle.dataset.bound === "true") return;
      toggle.dataset.bound = "true";

      const count = Number(toggle.dataset.taskCount || 0);
      const applyState = (expanded) => {
        extraContainer.hidden = !expanded;
        toggle.dataset.expanded = expanded ? "true" : "false";
        toggle.textContent = expanded ? "<%= j t("customers.view.show.hide_extra_tasks") %>" : `<%= j t("customers.view.show.show_all_tasks_prefix") %> (${count})`;
      };

      applyState(false);
      toggle.addEventListener("click", () => applyState(toggle.dataset.expanded !== "true"));
    };

    bindTaskToggle();
    document.addEventListener("turbo:load", bindTaskToggle);
  })();

  (() => {
    const bindHighSignalToggle = () => {
      const toggle = document.querySelector("[data-high-signal-toggle]");
      const extraContainer = document.querySelector("[data-high-signal-more]");
      if (!toggle || !extraContainer || toggle.dataset.bound === "true") return;
      toggle.dataset.bound = "true";

      const count = Number(toggle.dataset.highCount || 0);
      const applyState = (expanded) => {
        extraContainer.hidden = !expanded;
        toggle.dataset.expanded = expanded ? "true" : "false";
        toggle.textContent = expanded ? "<%= j t("customers.view.show.hide_older_high_signals") %>" : `<%= j t("customers.view.show.show_older_high_signals_prefix") %> (${count})`;
      };

      applyState(false);
      toggle.addEventListener("click", () => applyState(toggle.dataset.expanded !== "true"));
    };

    bindHighSignalToggle();
    document.addEventListener("turbo:load", bindHighSignalToggle);
  })();

  (() => {
    const bindSystemTimelineToggle = () => {
      const toggle = document.querySelector("[data-system-timeline-toggle]");
      const extraContainer = document.querySelector("[data-system-timeline-more]");
      if (!toggle || !extraContainer || toggle.dataset.bound === "true") return;
      toggle.dataset.bound = "true";

      const count = Number(toggle.dataset.systemCount || 0);
      const applyState = (expanded) => {
        extraContainer.hidden = !expanded;
        toggle.dataset.expanded = expanded ? "true" : "false";
        toggle.textContent = expanded ? "<%= j t("customers.view.show.hide_system_activity") %>" : `<%= j t("customers.view.show.show_system_activity_prefix") %> (${count})`;
      };

      applyState(false);

      toggle.addEventListener("click", () => {
        applyState(toggle.dataset.expanded !== "true");
      });
    };

    bindSystemTimelineToggle();
    document.addEventListener("turbo:load", bindSystemTimelineToggle);
  })();

  (() => {
    const bindFollowUpAssistant = () => {
      const form = document.querySelector("[data-follow-up-assistant-form]");
      if (!form || form.dataset.bound === "true") return;
      form.dataset.bound = "true";

      const csrf = document.querySelector("meta[name='csrf-token']")?.content;
      const messageInput = form.querySelector("[data-follow-up-message]");
      const copyButton = form.querySelector("[data-follow-up-copy]");
      const whatsappButton = form.querySelector("[data-follow-up-whatsapp]");
      const emailButton = form.querySelector("[data-follow-up-email]");
      const feedback = form.querySelector("[data-follow-up-feedback]");
      const quoteIdInput = form.querySelector("input[name='follow_up[quote_id]']");
      const turnstileResponse = form.querySelector("[data-follow-up-turnstile-response]");
      const skipTurnstile = form.dataset.skipTurnstile === "true";

      const emailModal = emailButton ? document.getElementById(emailButton.dataset.turnstileModalId || "") : null;
      const emailModalLoading = emailModal?.querySelector("[data-follow-up-email-loading]");
      const emailModalWidget = emailModal?.querySelector("[data-follow-up-email-widget]");
      const emailModalSuccess = emailModal?.querySelector("[data-follow-up-email-success]");

      const showFeedback = (text, isError = false) => {
        if (feedback) {
          feedback.textContent = text;
          feedback.hidden = false;
          feedback.classList.toggle("is-error", isError);
        }
      };

      const copyText = async (text) => {
        try {
          if (navigator.clipboard?.writeText && window.isSecureContext) {
            await navigator.clipboard.writeText(text);
            return true;
          }
        } catch (_) {
        }

        try {
          const textarea = document.createElement("textarea");
          textarea.value = text;
          textarea.setAttribute("readonly", "");
          textarea.style.position = "fixed";
          textarea.style.top = "-9999px";
          textarea.style.left = "-9999px";
          document.body.appendChild(textarea);
          textarea.focus();
          textarea.select();
          const ok = document.execCommand("copy");
          document.body.removeChild(textarea);
          return !!ok;
        } catch (_) {
          return false;
        }
      };

      const resetEmailVerification = () => {
        if (turnstileResponse) turnstileResponse.value = "";
        if (emailModalLoading) emailModalLoading.hidden = false;
        if (emailModalWidget) emailModalWidget.hidden = true;
        if (emailModalSuccess) emailModalSuccess.hidden = true;
      };

      const closeEmailModal = ({ resetToken = true } = {}) => {
        if (!emailModal) return;
        emailModal.hidden = true;
        if (resetToken) resetEmailVerification();
      };

      const submitEmailFollowUp = () => {
        if (!emailButton) return;
        const actionUrl = emailButton.dataset.emailAction;
        if (!actionUrl) return;

        form.action = actionUrl;
        form.method = "post";
        form.requestSubmit();
      };

      const renderEmailTurnstile = () => {
        if (!emailModal || !emailModalWidget || !emailModalLoading || !emailModalSuccess) return;

        const siteKey = form.dataset.turnstileSiteKey;
        if (!siteKey) return;

        resetEmailVerification();

        const renderWidget = () => {
          if (typeof turnstile === "undefined") {
            window.setTimeout(renderWidget, 180);
            return;
          }

          emailModalLoading.hidden = true;
          emailModalWidget.hidden = false;

          if (emailModal.dataset.widgetId) {
            turnstile.reset(emailModal.dataset.widgetId);
            return;
          }

          const widgetId = turnstile.render(emailModalWidget, {
            sitekey: siteKey,
            theme: "light",
            callback: (token) => {
              if (turnstileResponse) turnstileResponse.value = token;
              emailModalWidget.hidden = true;
              emailModalSuccess.hidden = false;
              window.setTimeout(() => {
                closeEmailModal({ resetToken: false });
                submitEmailFollowUp();
              }, 260);
            },
            "expired-callback": () => {
              if (turnstileResponse) turnstileResponse.value = "";
              emailModalSuccess.hidden = true;
              emailModalWidget.hidden = false;
            },
            "error-callback": () => {
              if (turnstileResponse) turnstileResponse.value = "";
              emailModalSuccess.hidden = true;
              emailModalWidget.hidden = false;
            }
          });

          emailModal.dataset.widgetId = widgetId;
        };

        renderWidget();
      };

      copyButton?.addEventListener("click", async () => {
        const copied = await copyText(messageInput?.value || "");
        const text = copied ? form.dataset.copySuccess : form.dataset.copyFailure;
        showFeedback(text, !copied);
        window.showAppToast?.(text, copied ? "success" : "error");
      });

      whatsappButton?.addEventListener("click", async () => {
        whatsappButton.disabled = true;

        try {
          const response = await fetch(form.dataset.whatsappUrl, {
            method: "POST",
            headers: {
              "Accept": "application/json",
              "Content-Type": "application/json",
              "X-CSRF-Token": csrf || ""
            },
            credentials: "same-origin",
            body: JSON.stringify({
              follow_up: {
                message: messageInput?.value || "",
                quote_id: quoteIdInput?.value || ""
              }
            })
          });

          const payload = await response.json().catch(() => ({}));
          if (!response.ok || !payload.url) {
            throw new Error(payload.message || form.dataset.whatsappFailed);
          }

          window.open(payload.url, "_blank", "noopener");
          if (payload.notice) {
            window.showAppToast?.(payload.notice, "success");
          }

          window.location.href = payload.redirect_url || window.location.href;
        } catch (error) {
          const text = error.message || form.dataset.whatsappFailed;
          showFeedback(text, true);
          window.showAppToast?.(text, "error");
        } finally {
          whatsappButton.disabled = false;
        }
      });

      emailButton?.addEventListener("click", (event) => {
        event.preventDefault();

        if (skipTurnstile) {
          submitEmailFollowUp();
          return;
        }

        if (!emailModal) {
          showFeedback(form.dataset.emailVerifyRequired, true);
          window.showAppToast?.(form.dataset.emailVerifyRequired, "error");
          return;
        }

        emailModal.hidden = false;
        renderEmailTurnstile();
      });

      emailModal?.addEventListener("click", (event) => {
        if (event.target === emailModal || event.target.closest("[data-follow-up-email-modal-close]")) {
          closeEmailModal();
        }
      });
    };

    bindFollowUpAssistant();
    document.addEventListener("turbo:load", bindFollowUpAssistant);
  })();
</script>
