<% watermark_text = template_watermark_text(@template, @quote.company.name) %>
<% watermark_image_url = template_watermark_image_url(@template) %>
<article class="quote-document public-quote-document public-quote-themed public-layout-<%= @template.layout_type %><%= ' quote-watermarked' if watermark_text.present? %>" data-watermark="<%= watermark_text %>" style="--doc-accent: <%= @template.accent_color %>; --doc-on-accent: <%= contrast_text_color(@template.accent_color) %>; --doc-font: '<%= @template.font_family %>'; --quote-watermark-opacity: <%= template_watermark_opacity(@template) %>;">
  <% if watermark_image_url.present? %>
    <img src="<%= watermark_image_url %>" alt="Watermark" class="quote-watermark-image">
  <% end %>
  <% spec_label = @quote.resolved_spec_label %>
  <% addon_label = @quote.resolved_addon_label %>
  <% quote_reopened = @quote.status.to_s == "draft" && @quote.reopened_at.present? %>
  <% signature_image_url = template_signature_image_url(@template) %>
  <% signature_name = template_signature_name(@template) %>
  <% show_signature_section = @template.show_signature_block && (signature_image_url.present? || signature_name.present?) %>
  <% if quote_reopened %>
    <div class="mb-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
      This quote is currently being updated by the seller. Please contact your sales representative for the latest version.
    </div>
  <% end %>
  <header class="quote-doc-header">
    <div>
      <p class="quote-doc-kicker"><%= @template.resolved_document_title(@document_kind).titleize %></p>
      <h1><%= @template.resolved_document_number_label(@document_kind) %> <%= @quote.quote_no %></h1>
      <% if @quote.custom_title.present? %>
        <p class="quote-doc-subtitle"><%= @quote.custom_title %></p>
      <% end %>
    </div>
    <div class="quote-doc-logo-wrap">
      <% if @template.show_logo && @quote.company.logo.attached? %>
        <%= image_tag @quote.company.logo, class: "quote-doc-logo" %>
      <% end %>
    </div>
  </header>

  <section class="quote-meta-grid">
    <article class="quote-meta-card">
      <h3>Seller</h3>
      <p><strong><%= @quote.company.name %></strong></p>
      <% if @template.show_customer_owner && Customer.internal_owner_enabled? && @quote.customer.internal_owner_display_name != "-" %>
        <p>Sales Owner: <%= @quote.customer.internal_owner_display_name %></p>
      <% end %>
      <p><%= @quote.company.address.presence || "-" %></p>
      <p><%= @quote.company.phone.presence || "-" %></p>
      <p><%= @quote.company.email.presence || "-" %></p>
      <p><%= @quote.company.website.presence || "-" %></p>
    </article>

    <article class="quote-meta-card">
      <h3>Buyer</h3>
      <p><strong>Company:</strong> <%= @quote.customer.name.presence || "-" %></p>
      <p><strong>Primary Contact:</strong> <%= @quote.customer.contact_name.presence || "-" %></p>
      <p><strong>Email:</strong> <%= @quote.customer.email.presence || "-" %></p>
      <p><strong>Phone:</strong> <%= @quote.customer.formatted_phone.presence || "-" %></p>
      <% if @quote.customer.tax_id.present? %>
        <p><strong>Tax ID:</strong> <%= [@quote.customer.tax_id_type.presence, @quote.customer.tax_id].compact.join(" ") %></p>
      <% end %>
      <p><strong>Address:</strong> <%= @quote.customer.address.presence || "-" %></p>
    </article>

    <article class="quote-meta-card">
      <h3>Quote Info</h3>
      <div class="quote-info-list">
      <p class="quote-info-row is-doc-number"><span><%= @template.resolved_document_number_label(@document_kind) %></span><strong><%= @quote.quote_no %></strong></p>
      <% if @quote.custom_title.present? %>
        <p class="quote-info-row"><span>Title</span><strong><%= @quote.custom_title %></strong></p>
      <% end %>
        <p class="quote-info-row"><span>Date</span><strong><%= @quote.issued_on&.strftime("%Y-%m-%d") || "-" %></strong></p>
        <% if @template.show_valid_until && @quote.valid_until.present? %>
          <p class="quote-info-row is-valid-until"><span>Valid Until</span><strong><%= @quote.valid_until.strftime("%Y-%m-%d") %></strong></p>
        <% end %>
      <% if @template.show_currency %>
          <p class="quote-info-row"><span>Currency</span><strong><%= @quote.currency %></strong></p>
      <% end %>
      <% if @quote.trade_term.present? %>
          <p class="quote-info-row"><span>Trade Terms</span><strong><%= @quote.trade_term %></strong></p>
      <% end %>
      <% if @template.show_payment_term && @quote.payment_term.present? %>
          <p class="quote-info-row"><span>Payment</span><strong><%= @quote.payment_term %></strong></p>
      <% end %>
      </div>
    </article>
  </section>

  <div class="table-responsive">
    <table class="quote-items-table quote-doc-table">
      <colgroup>
        <% if @template.show_product_images %><col class="quote-col-image"><% end %>
        <col class="quote-col-description">
        <col class="quote-col-qty">
        <col class="quote-col-money">
        <col class="quote-col-money">
      </colgroup>
      <thead>
        <tr>
          <% if @template.show_product_images %><th>Image</th><% end %>
          <th>Item Details</th>
          <th class="quote-col-right">Qty</th>
          <th class="quote-col-right quote-col-money">Unit Price</th>
          <th class="quote-col-right quote-col-money">Line Total</th>
        </tr>
      </thead>
      <tbody>
        <% @quote.quote_items.ordered.each do |item| %>
          <tr>
            <% if @template.show_product_images %>
              <td>
                <% if item.product&.display_image.present? %>
                  <%= image_tag item.product.display_image, class: "quote-item-image" %>
                <% else %>
                  -
                <% end %>
              </td>
            <% end %>
            <td>
              <div class="quote-item-desc">
                <div class="quote-item-desc-main"><%= item.product&.name.presence || "Item" %></div>
                <% if item.specification_pairs.any? || item.addon_charge_entries.any? %>
                  <div class="quote-item-desc-meta">
                    <% if item.specification_pairs.any? %>
                      <div class="quote-item-desc-group">
                        <div class="quote-item-desc-group-label"><%= spec_label %>:</div>
                        <% item.specification_pairs.each do |pair| %>
                          <div class="quote-item-desc-sub"><span class="quote-item-desc-bullet">&bull;</span><%= pair[:key] %> - <%= pair[:value] %></div>
                        <% end %>
                      </div>
                    <% end %>
                    <% if item.addon_charge_entries.any? %>
                      <div class="quote-item-desc-group is-addon">
                        <div class="quote-item-desc-group-label"><%= addon_label %>:</div>
                        <% item.addon_charge_entries.each do |entry| %>
                          <div class="quote-item-desc-sub is-addon"><span class="quote-item-desc-bullet">&bull;</span><%= entry[:name] %> (<%= quote_money(entry[:amount], @quote.currency, show_symbol: @template.show_currency) %>)</div>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </td>
            <td class="quote-col-right"><%= item.quantity %></td>
            <td class="quote-col-right quote-col-money"><%= quote_money(item.unit_price, @quote.currency, show_symbol: @template.show_currency) %></td>
            <td class="quote-col-right quote-col-money"><%= quote_money(item.line_total, @quote.currency, show_symbol: @template.show_currency) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% discount_amount = @quote.discount_amount.to_d %>
  <% has_discount = discount_amount.positive? %>
  <% original_total = @quote.subtotal.to_d + @quote.tax_amount.to_d + @quote.shipping_amount.to_d %>
  <aside class="quote-total-box">
    <p><span>Subtotal</span><strong><%= quote_money(@quote.subtotal, @quote.currency, show_symbol: @template.show_currency) %></strong></p>
    <% if @template.show_tax %>
      <p><span>Tax / VAT</span><strong><%= quote_money(@quote.tax_amount, @quote.currency, show_symbol: @template.show_currency) %></strong></p>
    <% end %>
    <% if @template.show_shipping %>
      <p><span>Shipping</span><strong><%= quote_money(@quote.shipping_amount, @quote.currency, show_symbol: @template.show_currency) %></strong></p>
    <% end %>
    <% if has_discount %>
      <p class="quote-total-discount"><span>Discount</span><strong>-<%= quote_money(discount_amount, @quote.currency, show_symbol: @template.show_currency) %></strong></p>
      <p class="quote-total-reduction"><span>Original Total</span><strong><%= quote_money(original_total, @quote.currency, show_symbol: @template.show_currency) %></strong></p>
    <% end %>
    <p class="quote-total-grand"><span>Grand Total</span><strong><%= quote_money(@quote.grand_total, @quote.currency, show_symbol: @template.show_currency) %></strong></p>
    <% if has_discount %>
      <p class="quote-total-saved"><span>You Save</span><strong><%= quote_money(discount_amount, @quote.currency, show_symbol: @template.show_currency) %></strong></p>
    <% end %>
    <% if (closing_message = @template.resolved_closing_message).present? %>
      <p class="quote-engagement-note"><%= closing_message %></p>
    <% end %>
  </aside>

  <% terms_lines = [] %>
  <% if @template.show_terms_section %>
    <% terms_lines << [ "Payment Terms", @quote.payment_term ] if @template.show_payment_term && @quote.payment_term.present? %>
    <% terms_lines << [ "Trade Terms", @quote.trade_term ] if @quote.trade_term.present? %>
    <% terms_lines << [ "Terms", @quote.terms_text ] if @quote.terms_text.present? %>
    <% terms_lines << [ "Legal Disclaimer", @quote.legal_disclaimer ] if @quote.legal_disclaimer.present? %>
    <% terms_lines << [ "Delivery Notes", @quote.delivery_notes ] if @quote.delivery_notes.present? %>
  <% end %>
  <% if terms_lines.any? %>
    <section class="quote-section-block">
      <h3>Terms & Conditions</h3>
      <% terms_lines.each do |label, value| %>
        <p><strong><%= label %>:</strong> <%= value %></p>
      <% end %>
    </section>
  <% end %>
  <% company_documents = @quote.company.company_documents.includes(file_attachment: :blob).ordered %>
  <% if company_documents.any? %>
    <section class="quote-section-block">
      <h3>Company Credentials</h3>
      <% company_documents.each do |document| %>
        <p>
          <strong><%= document.title %></strong>
          <% if document.file.attached? %>
            <%= link_to "Download", rails_blob_path(document.file, disposition: "attachment") %>
          <% end %>
        </p>
      <% end %>
    </section>
  <% end %>
  <% if show_signature_section %>
    <section class="quote-section-block quote-signature-block">
      <h3>Signature</h3>
      <% if signature_image_url.present? %>
        <p><img src="<%= signature_image_url %>" alt="Sales signature" class="quote-sales-signature-image"></p>
      <% end %>
      <% if signature_name.present? %>
        <p><strong>Authorized by:</strong> <%= signature_name %></p>
      <% end %>
    </section>
  <% end %>

  <div class="no-print quote-public-actions">
    <button type="button" onclick="window.print()">Print</button>
  </div>
  <% if @template.show_saas_branding %>
    <p class="quote-public-footnote"><%= @template.saas_branding_footer_text %></p>
  <% end %>
</article>
