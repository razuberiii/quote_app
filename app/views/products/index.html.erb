<h1>Products</h1>

<div class="search-section">
  <%= form_with url: products_path, method: :get, local: true do |f| %>
    <div class="search-bar">
      <%= f.text_field :query, placeholder: "Search products...", value: @search_query %>
      <%= f.submit "Search" %>
      <% if @search_query.present? %>
        <%= link_to "Clear", products_path, class: "btn btn-secondary" %>
      <% end %>
    </div>
  <% end %>
</div>

<div class="header-actions">
  <%= link_to "+ New Product", new_product_path, class: "btn btn-primary" %>
</div>

<% if @products.any? %>
  <% if @search_query.present? %>
    <p class="search-info">Found <strong><%= @products.count %></strong> product(s) matching "<strong><%= @search_query %></strong>"</p>
  <% end %>
  <div class="table-responsive">
    <table class="products-table">
      <thead>
        <tr>
          <th>Image</th>
          <th>Name</th>
          <th>SKU</th>
          <th>Reference Price (for auto-fill only)</th>
          <th>Description</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @products.each do |product| %>
          <tr>
            <td>
              <% if product.display_image.present? %>
                <%= link_to product_path(product), class: "product-quick-edit-link", title: "View product" do %>
                  <%= image_tag product.display_image, style: "width: 56px; height: 56px; object-fit: cover; border-radius: 8px;" %>
                <% end %>
              <% else %>
                -
              <% end %>
            </td>
            <td>
              <strong>
                <%= link_to product.name, product_path(product), class: "product-quick-edit-link" %>
              </strong>
            </td>
            <td><span class="product-sku"><%= product.sku %></span></td>
            <td><%= number_with_precision(product.default_price, precision: 2) %> <span class="product-price-currency"><%= product.price_currency %></span></td>
            <td><%= truncate(product.description, length: 50) %></td>
            <td class="product-row-actions">
              <div class="product-actions-inline">
                <%= link_to "View", product, class: "product-action-link product-action-view" %>
                <%= link_to "Edit", edit_product_path(product), class: "product-action-link product-action-edit" %>
                <%= link_to "Delete", product_path(product), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "product-action-link product-action-delete" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p>No products yet. <%= link_to "Create one", new_product_path %></p>
<% end %>
