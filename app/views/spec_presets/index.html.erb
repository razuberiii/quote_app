<h1 id="new">Spec Presets</h1>

<p><%= link_to "Back to Product Presets", product_presets_path, class: "form-page-back-link" %></p>

<section class="team-members-panel">
  <h2>Create Spec Preset</h2>
  <%= render "form", spec_preset: @spec_preset %>
</section>

<section class="team-members-panel">
  <h2>Preset Library</h2>
  <% if @spec_presets.any? %>
    <div class="table-responsive">
      <table class="customers-table saas-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Specs</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @spec_presets.each do |preset| %>
            <tr>
              <td><strong><%= preset.name %></strong></td>
              <td><%= preset.normalized_entries.map { |entry| "#{entry[:name]}: #{entry[:value]}" }.join(" • ") %></td>
              <td class="text-right">
                <%= link_to "Edit", edit_spec_preset_path(preset), class: "btn btn-secondary" %>
                <%= button_to "Delete", spec_preset_path(preset), method: :delete, data: { turbo_confirm: "Delete this spec preset?" }, class: "btn btn-secondary" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="team-members-hint">No spec presets yet.</p>
  <% end %>
</section>
