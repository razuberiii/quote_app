<% if @quote.quote_no.present? %>
  <h1>
    New Revision Draft for <%= @quote.quote_no %>
    <span class="status-badge status-<%= (@quote.status.presence || "draft") %>"><%= (@quote.status.presence || "draft").capitalize %></span>
  </h1>
<% else %>
  <h1>
    New Quote
    <span class="status-badge status-<%= (@quote.status.presence || "draft") %>"><%= (@quote.status.presence || "draft").capitalize %></span>
  </h1>
<% end %>

<%= render "form", quote: @quote, form_model: [ @customer, @quote ] %>

<%= link_to "Back to Customer", customer_path(@customer), class: "form-page-back-link" %>
