<article class="quote-document public-quote-document public-quote-themed public-layout-<%= @template.layout_type %>" style="--doc-accent: <%= @template.accent_color %>; --doc-font: '<%= @template.font_family %>';">
  <header class="quote-doc-header">
    <div>
      <p class="quote-doc-kicker"><%= @template.resolved_document_title(@document_kind).titleize %></p>
      <h1><%= @template.resolved_document_number_label(@document_kind) %> <%= @quote.quote_no %></h1>
    </div>
    <div class="quote-doc-logo-wrap">
      <% if @template.show_logo && @quote.company.logo.attached? %>
        <%= image_tag @quote.company.logo, class: "quote-doc-logo" %>
      <% end %>
    </div>
  </header>

  <section class="quote-meta-grid">
    <article class="quote-meta-card">
      <h3>Seller</h3>
      <p><strong><%= @quote.company.name %></strong></p>
      <p><%= @quote.company.address.presence || "-" %></p>
      <p><%= @quote.company.phone.presence || "-" %></p>
      <p><%= @quote.company.email.presence || "-" %></p>
      <p><%= @quote.company.website.presence || "-" %></p>
    </article>

    <article class="quote-meta-card">
      <h3>Buyer</h3>
      <p><strong><%= @quote.customer.name %></strong></p>
      <p>Contact: <%= @quote.customer.contact_name.presence || "-" %></p>
      <p><%= @quote.customer.address.presence || "-" %></p>
      <p><%= @quote.customer.phone.presence || "-" %></p>
      <p><%= @quote.customer.email.presence || "-" %></p>
    </article>

    <article class="quote-meta-card">
      <h3>Quote Info</h3>
      <p><strong>Date:</strong> <%= @quote.issued_on&.strftime("%Y-%m-%d") %></p>
      <% if @template.show_valid_until %>
        <p><strong>Valid Until:</strong> <%= @quote.valid_until&.strftime("%Y-%m-%d") || "-" %></p>
      <% end %>
      <% if @template.show_currency %>
        <p><strong>Currency:</strong> <%= @quote.currency %></p>
      <% end %>
      <% if @template.show_payment_term && @quote.payment_term.present? %>
        <p><strong>Payment:</strong> <%= @quote.payment_term %></p>
      <% end %>
    </article>
  </section>

  <div class="table-responsive">
    <table class="quote-items-table quote-doc-table">
      <thead>
        <tr>
          <% if @template.show_product_images %><th>Image</th><% end %>
          <th>Description</th>
          <th>Qty</th>
          <th>Unit Price</th>
          <th>Line Total</th>
        </tr>
      </thead>
      <tbody>
        <% @quote.quote_items.ordered.each do |item| %>
          <tr>
            <% if @template.show_product_images %>
              <td>
                <% if item.product&.image&.attached? %>
                  <%= image_tag item.product.image, class: "quote-item-image" %>
                <% else %>
                  -
                <% end %>
              </td>
            <% end %>
            <td><%= item.description %></td>
            <td><%= item.quantity %></td>
            <td><%= number_to_currency(item.unit_price, unit: (@template.show_currency ? @quote.currency : "")) %></td>
            <td><%= number_to_currency(item.amount, unit: (@template.show_currency ? @quote.currency : "")) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <aside class="quote-total-box">
    <p><span>Subtotal</span><strong><%= number_to_currency(@quote.subtotal, unit: (@template.show_currency ? @quote.currency : "")) %></strong></p>
    <p><span>Tax / VAT</span><strong><%= number_to_currency(@quote.tax_amount, unit: (@template.show_currency ? @quote.currency : "")) %></strong></p>
    <p><span>Shipping</span><strong><%= number_to_currency(@quote.shipping_amount, unit: (@template.show_currency ? @quote.currency : "")) %></strong></p>
    <p><span>Discount</span><strong><%= number_to_currency(@quote.discount_amount, unit: (@template.show_currency ? @quote.currency : "")) %></strong></p>
    <p class="quote-total-grand"><span>Grand Total</span><strong><%= number_to_currency(@quote.grand_total, unit: (@template.show_currency ? @quote.currency : "")) %></strong></p>
  </aside>

  <% if @template.show_terms_section %>
    <section class="quote-section-block">
      <h3>Terms & Conditions</h3>
      <p><strong>Payment Terms:</strong> <%= @quote.payment_term.presence || "-" %></p>
      <p><strong>Terms:</strong> <%= @quote.terms_text.presence || "-" %></p>
      <p><strong>Legal Disclaimer:</strong> <%= @quote.legal_disclaimer.presence || "-" %></p>
      <p><strong>Delivery Notes:</strong> <%= @quote.delivery_notes.presence || "-" %></p>
    </section>
  <% end %>

  <div class="no-print quote-public-actions">
    <button type="button" onclick="window.print()">Print</button>
  </div>
</article>
