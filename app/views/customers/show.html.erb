<h1><%= @customer.name %></h1>
<%= link_to customers_path, class: "customer-back-link" do %>
  <span aria-hidden="true">←</span>
  <span>Back to Customers</span>
<% end %>

<section class="customer-profile-card">
  <div class="customer-profile-card-head">
    <div class="customer-profile-identity">
      <span class="customer-list-avatar customer-profile-avatar" aria-hidden="true">
        <% if @customer.avatar.attached? && @customer.avatar.blob&.persisted? %>
          <%= image_tag @customer.avatar, alt: "#{@customer.name} avatar" %>
        <% else %>
          <span><%= @customer.avatar_initial %></span>
        <% end %>
      </span>
      <div>
        <strong><%= @customer.name %></strong>
        <p><%= @customer.email.presence || "No email" %></p>
      </div>
    </div>
    <%= link_to "Edit Customer", edit_customer_path(@customer), class: "btn btn-primary customer-edit-cta" %>
  </div>
</section>

<section class="quote-edit-summary customer-top-summary">
  <article class="quote-edit-summary-card">
    <span class="summary-label">Total Quotes</span>
    <strong><%= @customer_summary[:total_quotes] %></strong>
  </article>
  <article class="quote-edit-summary-card">
    <span class="summary-label">Latest Quote</span>
    <strong><%= @customer_summary[:latest_quote_at]&.strftime("%Y-%m-%d") || "No quote yet" %></strong>
  </article>
  <article class="quote-edit-summary-card">
    <span class="summary-label">Sales Stage</span>
    <strong><%= @customer_summary[:sales_stage] %></strong>
    <span class="status-badge status-<%= @customer.status_css %>"><%= @customer.status_label %></span>
  </article>
  <article class="quote-edit-summary-card">
    <span class="summary-label">Engagement</span>
    <strong><%= @customer_engagement[:label] %></strong>
    <span class="status-badge customer-engagement-badge <%= @customer_engagement[:css] %>"><%= @customer_engagement[:label] %></span>
  </article>
</section>

<details class="customer-details-collapsible">
  <summary>Customer Profile Details</summary>
  <div class="customer-details">
    <p><strong>Country:</strong> <%= @customer.country %></p>
    <p><strong>Level:</strong> <%= @customer.customer_level.to_s.humanize %></p>
    <p><strong>Source:</strong> <%= @customer.customer_source.to_s.humanize.presence || "-" %></p>
    <p><strong>Address:</strong> <%= @customer.address.presence || "-" %></p>
    <p><strong>Contact:</strong> <%= @customer.contact_name %></p>
    <p><strong>Email:</strong> <%= @customer.email %></p>
    <p><strong>Phone:</strong> <%= @customer.phone.presence || "-" %></p>
    <p><strong>Payment Terms:</strong> <%= @customer.payment_terms.to_s.upcase.gsub("_", "/").presence || "-" %></p>
    <p><strong>Main Product Interest:</strong> <%= @customer.main_product_interest.presence || "-" %></p>
    <p><strong>Internal Owner:</strong> <%= @customer.internal_owner_display_name %></p>
    <p><strong>Estimated Annual Volume:</strong> <%= @customer.estimated_annual_volume.present? ? number_with_precision(@customer.estimated_annual_volume, precision: 2, delimiter: ",") : "-" %></p>
    <p><strong>Timezone:</strong> <%= @customer.timezone.presence || "-" %></p>
    <p><strong>Status:</strong> <span class="status-badge status-<%= @customer.status_css %>"><%= @customer.status_label %></span></p>
    <% if @customer.customer_tags.any? %>
      <p><strong>Tags:</strong> <%= @customer.customer_tags.order(:name).pluck(:name).join(", ") %></p>
    <% end %>
    <p><strong>Latest Customer Signal:</strong> <%= @latest_customer_signal_at&.strftime("%Y-%m-%d %H:%M") || "No customer behavior yet" %></p>
    <p class="customer-next-follow-up-line follow-up-<%= @customer.follow_up_status %>">
      <strong>Next Follow-up:</strong> <%= @customer.next_follow_up_date&.strftime("%Y-%m-%d") || "N/A" %>
      <% if @customer.follow_up_overdue? %>
        <span class="overdue-badge">OVERDUE</span>
      <% elsif @customer.follow_up_due_today? %>
        <span class="today-badge">TODAY</span>
      <% elsif @customer.follow_up_status == "upcoming" %>
        <span class="upcoming-badge">DUE SOON</span>
      <% end %>
    </p>
    <% if @customer.notes.present? %>
      <p><strong>Notes:</strong> <%= @customer.notes %></p>
    <% end %>
  </div>
</details>

<section class="customer-follow-up-callout follow-up-<%= @customer.follow_up_status %>">
  <div>
    <span class="summary-label">Follow-up Action</span>
    <strong><%= @follow_up_text %></strong>
    <div class="customer-follow-up-meta">
      <span>Last signal: <%= @days_since_last_signal.nil? ? "N/A" : "#{@days_since_last_signal}d ago" %></span>
      <span>Next follow-up: <%= @days_until_follow_up.nil? ? "Not scheduled" : (@days_until_follow_up.negative? ? "#{@days_until_follow_up.abs}d overdue" : "in #{@days_until_follow_up}d") %></span>
    </div>
  </div>
  <div class="customer-follow-up-callout-actions">
    <% if @follow_up_primary_action[:method] == :post %>
      <%= button_to @follow_up_primary_action[:label], @follow_up_primary_action[:path], method: :post, class: "btn btn-primary" %>
    <% else %>
      <%= link_to @follow_up_primary_action[:label], @follow_up_primary_action[:path], class: "btn btn-primary" %>
    <% end %>
  </div>
</section>

<h3 class="customer-actions-title">Quote Actions</h3>
<div class="actions customer-quote-actions">
  <%= link_to "New Quote", new_customer_quote_path(@customer), class: "btn btn-success" %>
  <%= button_to "Delete", customer_path(@customer), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-danger" %>
</div>

<h3>
  <% if @quote_view == "active" %>
    Active Quotes (<%= @active_quote_cards.size %>)
  <% elsif @quote_view == "recent" %>
    Recent Quotes (10)
  <% else %>
    All Quotes (<%= @all_quote_cards.size %>)
  <% end %>
</h3>
<% if @quote_view == "active" %>
  <p class="quotes-mode-note">Showing top 5 by priority. Sorted by action priority.</p>
  <p class="quotes-structure-note">
    <strong><%= @active_quote_cards.size %></strong> Active
    <span>• <%= @active_quote_breakdown["draft"] %> Draft</span>
    <span>• <%= @active_quote_breakdown["sent"] %> Sent</span>
    <span>• <%= @active_quote_breakdown["viewed"] %> Viewed</span>
    <span>• <%= @active_quote_breakdown["negotiating"] %> Negotiating</span>
  </p>
<% end %>

<div class="quote-summary-grid">
  <div class="summary-card summary-normal">
    <span class="summary-label">Total Quotes</span>
    <strong><%= @quote_summary[:total_count] %></strong>
  </div>
  <div class="summary-card summary-won">
    <span class="summary-label">Won Amount</span>
    <div class="summary-currency-lines" data-currency-group>
      <% if @quote_summary[:won_amounts_by_currency].any? %>
        <% @quote_summary[:won_amounts_by_currency].each_with_index do |(currency, amount), idx| %>
          <strong class="<%= "currency-line-extra" if idx > 0 %>" <%= "hidden" if idx > 0 %>><%= currency %>: <%= quote_money(amount, currency) %></strong>
        <% end %>
        <% if @quote_summary[:won_amounts_by_currency].size > 1 %>
          <button type="button" class="currency-lines-toggle" data-currency-toggle>Show all currencies</button>
        <% end %>
      <% else %>
        <strong>-</strong>
      <% end %>
    </div>
  </div>
  <div class="summary-card summary-lost">
    <span class="summary-label">Lost Amount</span>
    <div class="summary-currency-lines" data-currency-group>
      <% if @quote_summary[:lost_amounts_by_currency].any? %>
        <% @quote_summary[:lost_amounts_by_currency].each_with_index do |(currency, amount), idx| %>
          <strong class="<%= "currency-line-extra" if idx > 0 %>" <%= "hidden" if idx > 0 %>><%= currency %>: <%= quote_money(amount, currency) %></strong>
        <% end %>
        <% if @quote_summary[:lost_amounts_by_currency].size > 1 %>
          <button type="button" class="currency-lines-toggle" data-currency-toggle>Show all currencies</button>
        <% end %>
      <% else %>
        <strong>-</strong>
      <% end %>
    </div>
  </div>
  <div class="summary-card summary-upcoming">
    <span class="summary-label">Avg Discount</span>
    <strong><%= @quote_summary[:avg_discount_pct] %>%</strong>
  </div>
</div>

<div class="quote-filter-bar">
  <% [["All", "all"], ["Draft", "draft"], ["Sent", "sent"], ["Viewed", "viewed"], ["Negotiating", "negotiating"], ["Won", "won"], ["Lost", "lost"], ["Expired", "expired"]].each do |label, value| %>
    <%= link_to label,
                customer_path(@customer, quote_status: value, quote_query: @quote_query.presence, quote_sort: @quote_sort, quote_view: @quote_view),
                class: "quote-filter-pill #{'active' if @quote_status_filter == value}" %>
  <% end %>
</div>

<div class="quote-filter-bar">
  <%= link_to "Active Quotes (#{@active_quote_cards.size})",
              customer_path(@customer, quote_status: @quote_status_filter, quote_query: @quote_query.presence, quote_sort: @quote_sort, quote_view: "active"),
              class: "quote-filter-pill #{'active' if @quote_view == 'active'}" %>
  <%= link_to "Recent (10)",
              customer_path(@customer, quote_status: @quote_status_filter, quote_query: @quote_query.presence, quote_sort: @quote_sort, quote_view: "recent"),
              class: "quote-filter-pill #{'active' if @quote_view == 'recent'}" %>
  <%= link_to "All",
              customer_path(@customer, quote_status: @quote_status_filter, quote_query: @quote_query.presence, quote_sort: @quote_sort, quote_view: "all"),
              class: "quote-filter-pill #{'active' if @quote_view == 'all'}" %>
</div>

<div class="quote-queue-toolbar">
  <%= form_with url: customer_path(@customer), method: :get, local: true do |f| %>
    <%= f.hidden_field :quote_status, value: @quote_status_filter %>
    <%= f.hidden_field :quote_view, value: @quote_view %>
    <div class="quote-queue-toolbar-grid">
      <%= f.text_field :quote_query, value: @quote_query, placeholder: "Search quote no, product, notes..." %>
      <%= f.select :quote_sort,
                   options_for_select([["Priority Queue", "priority"], ["Newest", "newest"], ["Highest Amount", "amount_high"], ["Status", "status"]], @quote_sort) %>
      <%= f.submit "Apply", class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>

<% if @filtered_quote_cards.any? %>
  <div class="quote-card-list <%= 'quote-card-list-scroll' if @filtered_quote_cards.size > 6 %>">
    <% @filtered_quote_cards.each do |card| %>
      <%= render "quote_card", card: card %>
    <% end %>
  </div>
  <% if @quote_view == "active" && @active_quote_cards.size > 5 %>
    <button
      type="button"
      class="btn btn-secondary quote-expand-toggle"
      data-active-quote-toggle
      data-expanded="false"
      data-active-count="<%= @active_quote_cards.size %>"
    >
      View all <%= @active_quote_cards.size %>
    </button>
    <div class="quote-card-list quote-card-list-scroll" data-active-quote-more hidden>
      <% @active_quote_cards.drop(5).each do |card| %>
        <%= render "quote_card", card: card %>
      <% end %>
    </div>
  <% end %>
  <% if @quote_view == "all" && @quotes_total_pages.to_i > 1 %>
    <div class="quote-pagination">
      <% prev_page = @quotes_page.to_i - 1 %>
      <% next_page = @quotes_page.to_i + 1 %>
      <% if prev_page >= 1 %>
        <%= link_to "Previous",
                    customer_path(@customer, quote_status: @quote_status_filter, quote_query: @quote_query.presence, quote_sort: @quote_sort, quote_view: @quote_view, quotes_page: prev_page),
                    class: "btn btn-secondary" %>
      <% end %>
      <span>Page <strong><%= @quotes_page %></strong> / <%= @quotes_total_pages %></span>
      <% if next_page <= @quotes_total_pages.to_i %>
        <%= link_to "Next",
                    customer_path(@customer, quote_status: @quote_status_filter, quote_query: @quote_query.presence, quote_sort: @quote_sort, quote_view: @quote_view, quotes_page: next_page),
                    class: "btn btn-secondary" %>
      <% end %>
    </div>
  <% end %>
<% else %>
  <p>No quotes match current filter.</p>
<% end %>

<section class="customer-task-board">
  <h3>Next Tasks</h3>
  <% if @visible_follow_up_tasks.any? %>
    <div class="customer-task-list">
      <% @visible_follow_up_tasks.each do |task| %>
        <article class="customer-task-card is-<%= task[:priority] %>">
          <div class="customer-task-meta">
            <span class="customer-task-priority"><%= task[:priority].upcase %></span>
            <h4><%= task[:title] %></h4>
            <p><%= task[:detail] %></p>
          </div>
          <% if task[:cta_path].present? && task[:cta_label].present? %>
            <div class="customer-task-actions">
              <% if task[:cta_path].to_s.include?("/schedule_follow_up") || task[:cta_path].to_s.include?("/mark_follow_up") %>
                <%= button_to task[:cta_label], task[:cta_path], method: :post, class: "btn btn-primary" %>
              <% else %>
                <%= link_to task[:cta_label], task[:cta_path], class: "btn btn-secondary" %>
              <% end %>
            </div>
          <% else %>
            <div class="customer-task-actions customer-task-actions-note">Use Follow-up Action controls above</div>
          <% end %>
        </article>
      <% end %>
    </div>
    <% if @hidden_follow_up_tasks.any? %>
      <button
        type="button"
        class="btn btn-secondary customer-task-toggle"
        data-task-toggle
        data-expanded="false"
        data-task-count="<%= @hidden_follow_up_tasks.size %>"
      >
        Show all tasks (<%= @hidden_follow_up_tasks.size %>)
      </button>
      <div class="customer-task-list customer-task-more" data-task-more hidden>
        <% @hidden_follow_up_tasks.each do |task| %>
          <article class="customer-task-card is-<%= task[:priority] %>">
            <div class="customer-task-meta">
              <span class="customer-task-priority"><%= task[:priority].upcase %></span>
              <h4><%= task[:title] %></h4>
              <p><%= task[:detail] %></p>
            </div>
            <% if task[:cta_path].present? && task[:cta_label].present? %>
              <div class="customer-task-actions">
                <% if task[:cta_path].to_s.include?("/schedule_follow_up") || task[:cta_path].to_s.include?("/mark_follow_up") %>
                  <%= button_to task[:cta_label], task[:cta_path], method: :post, class: "btn btn-primary" %>
                <% else %>
                  <%= link_to task[:cta_label], task[:cta_path], class: "btn btn-secondary" %>
                <% end %>
              </div>
            <% else %>
              <div class="customer-task-actions customer-task-actions-note">Use Follow-up Action controls above</div>
            <% end %>
          </article>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <p class="team-members-hint">No immediate tasks.</p>
  <% end %>
</section>

<section class="customer-timeline">
  <h3>Customer Timeline</h3>
  <% if @high_signal_timeline_events.any? || @system_timeline_events.any? %>
    <p class="customer-timeline-hint">
      Latest customer behavior:
      <strong><%= @latest_customer_signal_at&.strftime("%Y-%m-%d %H:%M") || "No customer behavior yet" %></strong>
    </p>

    <% if @visible_high_signal_timeline_events.any? %>
      <h4 class="customer-timeline-subhead">High Signal</h4>
      <div class="customer-timeline-list <%= 'customer-timeline-list-scroll' if @high_signal_timeline_events.size > 7 %>">
        <% @visible_high_signal_timeline_events.each do |event| %>
          <article class="customer-timeline-item is-<%= event[:tone] %>">
            <div class="customer-timeline-dot"></div>
            <div class="customer-timeline-content">
              <p class="customer-timeline-time"><%= event[:at]&.strftime("%Y-%m-%d %H:%M") || "-" %></p>
              <h4><%= event[:title] %></h4>
              <p><%= event[:detail] %></p>
            </div>
          </article>
        <% end %>
      </div>
      <% if @hidden_high_signal_timeline_events.any? %>
        <button
          type="button"
          class="btn btn-secondary customer-timeline-toggle"
          data-high-signal-toggle
          data-expanded="false"
          data-high-count="<%= @hidden_high_signal_timeline_events.size %>"
        >
          Show older high signals (<%= @hidden_high_signal_timeline_events.size %>)
        </button>
        <div class="customer-timeline-more" data-high-signal-more hidden>
          <% @hidden_high_signal_timeline_events.each do |event| %>
            <article class="customer-timeline-item is-<%= event[:tone] %>">
              <div class="customer-timeline-dot"></div>
              <div class="customer-timeline-content">
                <p class="customer-timeline-time"><%= event[:at]&.strftime("%Y-%m-%d %H:%M") || "-" %></p>
                <h4><%= event[:title] %></h4>
                <p><%= event[:detail] %></p>
              </div>
            </article>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <p class="team-members-hint">No customer behavior signals yet.</p>
    <% end %>

    <% if @system_timeline_events.any? %>
      <button
        type="button"
        class="btn btn-secondary customer-timeline-toggle"
        data-system-timeline-toggle
        data-expanded="false"
        data-system-count="<%= @system_timeline_events.size %>"
      >
        Show system activity (<%= @system_timeline_events.size %>)
      </button>
      <div class="customer-timeline-more customer-timeline-system" data-system-timeline-more hidden>
        <h4 class="customer-timeline-subhead">System Activity</h4>
        <% @system_timeline_events.each do |event| %>
          <article class="customer-timeline-item is-<%= event[:tone] %>">
            <div class="customer-timeline-dot"></div>
            <div class="customer-timeline-content">
              <p class="customer-timeline-time"><%= event[:at]&.strftime("%Y-%m-%d %H:%M") || "-" %></p>
              <h4><%= event[:title] %></h4>
              <p><%= event[:detail] %></p>
            </div>
          </article>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <p class="team-members-hint">No timeline events yet.</p>
  <% end %>
</section>

<script>
  (() => {
    const toggles = document.querySelectorAll("[data-currency-toggle]");
    toggles.forEach((toggle) => {
      if (toggle.dataset.bound === "true") return;
      toggle.dataset.bound = "true";
      toggle.addEventListener("click", () => {
        const group = toggle.closest("[data-currency-group]");
        if (!group) return;
        const extras = group.querySelectorAll(".currency-line-extra");
        const collapsed = toggle.dataset.expanded !== "true";
        extras.forEach((line) => {
          line.hidden = !collapsed;
        });
        toggle.dataset.expanded = collapsed ? "true" : "false";
        toggle.textContent = collapsed ? "Show less" : "Show all currencies";
      });
    });
  })();

  (() => {
    const bindActiveQuoteToggle = () => {
      const toggle = document.querySelector("[data-active-quote-toggle]");
      const extraContainer = document.querySelector("[data-active-quote-more]");
      if (!toggle || !extraContainer || toggle.dataset.bound === "true") return;
      toggle.dataset.bound = "true";

      const count = Number(toggle.dataset.activeCount || 0);
      const applyState = (expanded) => {
        extraContainer.hidden = !expanded;
        toggle.dataset.expanded = expanded ? "true" : "false";
        toggle.textContent = expanded ? "Collapse list" : `View all ${count}`;
      };

      applyState(false);
      toggle.addEventListener("click", () => applyState(toggle.dataset.expanded !== "true"));
    };

    bindActiveQuoteToggle();
    document.addEventListener("turbo:load", bindActiveQuoteToggle);
  })();

  (() => {
    const bindTaskToggle = () => {
      const toggle = document.querySelector("[data-task-toggle]");
      const extraContainer = document.querySelector("[data-task-more]");
      if (!toggle || !extraContainer || toggle.dataset.bound === "true") return;
      toggle.dataset.bound = "true";

      const count = Number(toggle.dataset.taskCount || 0);
      const applyState = (expanded) => {
        extraContainer.hidden = !expanded;
        toggle.dataset.expanded = expanded ? "true" : "false";
        toggle.textContent = expanded ? "Hide extra tasks" : `Show all tasks (${count})`;
      };

      applyState(false);
      toggle.addEventListener("click", () => applyState(toggle.dataset.expanded !== "true"));
    };

    bindTaskToggle();
    document.addEventListener("turbo:load", bindTaskToggle);
  })();

  (() => {
    const bindHighSignalToggle = () => {
      const toggle = document.querySelector("[data-high-signal-toggle]");
      const extraContainer = document.querySelector("[data-high-signal-more]");
      if (!toggle || !extraContainer || toggle.dataset.bound === "true") return;
      toggle.dataset.bound = "true";

      const count = Number(toggle.dataset.highCount || 0);
      const applyState = (expanded) => {
        extraContainer.hidden = !expanded;
        toggle.dataset.expanded = expanded ? "true" : "false";
        toggle.textContent = expanded ? "Hide older high signals" : `Show older high signals (${count})`;
      };

      applyState(false);
      toggle.addEventListener("click", () => applyState(toggle.dataset.expanded !== "true"));
    };

    bindHighSignalToggle();
    document.addEventListener("turbo:load", bindHighSignalToggle);
  })();

  (() => {
    const bindSystemTimelineToggle = () => {
      const toggle = document.querySelector("[data-system-timeline-toggle]");
      const extraContainer = document.querySelector("[data-system-timeline-more]");
      if (!toggle || !extraContainer || toggle.dataset.bound === "true") return;
      toggle.dataset.bound = "true";

      const count = Number(toggle.dataset.systemCount || 0);
      const applyState = (expanded) => {
        extraContainer.hidden = !expanded;
        toggle.dataset.expanded = expanded ? "true" : "false";
        toggle.textContent = expanded ? "Hide system activity" : `Show system activity (${count})`;
      };

      applyState(false);

      toggle.addEventListener("click", () => {
        applyState(toggle.dataset.expanded !== "true");
      });
    };

    bindSystemTimelineToggle();
    document.addEventListener("turbo:load", bindSystemTimelineToggle);
  })();
</script>
