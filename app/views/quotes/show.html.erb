<div id="quote-page-content">
  <%= render "show_content" %>
</div>

<div id="quote-toast" class="quote-toast" hidden></div>

<script>
  (() => {
    if (window.__quoteTemplateAutoApplyBound) return;
    window.__quoteTemplateAutoApplyBound = true;

    const toast = () => document.getElementById("quote-toast");

    const showToast = (message, error = false) => {
      const el = toast();
      if (!el) return;

      el.textContent = message;
      el.classList.toggle("is-error", error);
      el.hidden = false;
      el.classList.add("is-visible");

      window.clearTimeout(el._timer);
      el._timer = window.setTimeout(() => {
        el.classList.remove("is-visible");
        window.setTimeout(() => { el.hidden = true; }, 220);
      }, 1600);
    };

    document.addEventListener("change", async (event) => {
      const select = event.target.closest(".js-template-select");
      if (!select) return;

      const url = select.dataset.updateUrl;
      const doc = select.dataset.doc || "quote";
      const templateId = select.value;
      const token = document.querySelector("meta[name='csrf-token']")?.content;
      if (!url || !templateId || !token) return;

      try {
        const body = new URLSearchParams({ template_id: templateId, doc });
        const response = await fetch(url, {
          method: "PATCH",
          headers: {
            "Accept": "text/vnd.turbo-stream.html, application/json",
            "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
            "X-CSRF-Token": token
          },
          body
        });

        if (!response.ok) throw new Error("request failed");

        const contentType = response.headers.get("content-type") || "";
        if (contentType.includes("turbo-stream")) {
          const streamHtml = await response.text();
          Turbo.renderStreamMessage(streamHtml);
        }

        showToast("Template updated");
      } catch (_) {
        showToast("Template update failed", true);
      }
    });
  })();
</script>
