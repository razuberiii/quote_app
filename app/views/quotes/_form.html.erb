          <input type="text" class="app-ui-input js-container-loading-capacity" maxlength="<%= Quote::MAX_CONTAINER_LOADING_CELL_LENGTH %>" list="container-loading-capacity-options" name="quote[container_loading_block][rows][${index}][capacity]" placeholder="${escapeAttr("<%= j t("quotes.view.form.container_loading_capacity_placeholder", default: "Capacity") %>")}">
