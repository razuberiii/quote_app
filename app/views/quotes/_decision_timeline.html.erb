<section class="quote-decision-timeline app-surface">
  <div class="app-section-heading">
    <div>
      <h3><%= t("quotes.view.decision_timeline.title") %></h3>
      <p class="app-section-caption"><%= t("quotes.view.decision_timeline.subtitle") %></p>
    </div>
  </div>

  <div class="quote-decision-recap">
    <% @quote_decision_recap.each do |item| %>
      <article class="quote-decision-recap-card">
        <span><%= item[:label] %></span>
        <strong><%= item[:value] %></strong>
        <p><%= item[:detail] %></p>
      </article>
    <% end %>
  </div>

  <% visible_events = @quote_decision_timeline.first(4) %>
  <% hidden_events = @quote_decision_timeline.drop(4) %>

  <div class="quote-decision-list">
    <% visible_events.each do |event| %>
      <article class="quote-decision-item is-<%= event[:kind] %>">
        <div class="quote-decision-dot" aria-hidden="true"></div>
        <div class="quote-decision-content">
          <div class="quote-decision-topline">
            <strong><%= event[:label] %></strong>
            <span><%= format_in_user_time(event[:at], current_user) %></span>
          </div>
          <p><%= event[:detail] %></p>
        </div>
      </article>
    <% end %>
  </div>

  <% if hidden_events.any? %>
    <details class="quote-inline-disclosure quote-inline-disclosure--timeline" data-inline-disclosure-key="decision-timeline-more">
      <summary class="quote-inline-disclosure-summary">
        <span class="quote-inline-disclosure-label quote-inline-disclosure-label--more"><%= quote_inline_disclosure_more_label(hidden_events.size) %></span>
        <span class="quote-inline-disclosure-label quote-inline-disclosure-label--collapse"><%= quote_inline_disclosure_collapse_label %></span>
        <span class="quote-inline-disclosure-caret" aria-hidden="true"></span>
      </summary>
      <div class="quote-decision-list is-secondary quote-inline-disclosure-body">
        <% hidden_events.each do |event| %>
          <article class="quote-decision-item is-<%= event[:kind] %>">
            <div class="quote-decision-dot" aria-hidden="true"></div>
            <div class="quote-decision-content">
              <div class="quote-decision-topline">
                <strong><%= event[:label] %></strong>
                <span><%= format_in_user_time(event[:at], current_user) %></span>
              </div>
              <p><%= event[:detail] %></p>
            </div>
          </article>
        <% end %>
      </div>
    </details>
  <% end %>
</section>
