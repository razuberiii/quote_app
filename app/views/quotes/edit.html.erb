<section class="app-page-shell">
  <header class="app-page-header">
    <div class="app-page-header-main">
      <h1><%= t("quotes.view.edit.title") %></h1>
      <p><%= t("quotes.view.edit.subtitle", quote_no: @quote.quote_no, revision: @quote.revision_number) %></p>
    </div>
    <div class="app-page-header-actions">
      <%= quote_status_badge(@quote.status.presence || "draft") %>
    </div>
  </header>

  <%= render "form", quote: @quote, form_model: @quote %>

  <%= link_to t("quotes.view.edit.back_to_quote"), @quote, class: "form-page-back-link form-page-back-link--quote" %>
</section>
