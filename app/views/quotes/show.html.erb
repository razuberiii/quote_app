<section class="app-page-shell">
  <%= render "commercial_workflow" unless @quote.pi_document? %>
  <% if @just_created %>
    <div class="quote-created-banner js-quote-created-banner">
      <div class="quote-created-banner-body">
        <div class="quote-created-banner-text">
          <p class="quote-created-banner-title"><%= t("quotes.view.show.created_banner.title") %></p>
          <p class="quote-created-banner-subtitle"><%= t("quotes.view.show.created_banner.subtitle") %></p>
        </div>
        <button type="button"
                class="<%= ui_button_classes(:primary, "quote-created-banner-btn js-banner-share-btn") %>"
                data-share-url="<%= share_quote_path(@quote, format: :json) %>">
          <%= t("quotes.view.show.created_banner.action") %>
        </button>
      </div>
    </div>
  <% end %>
  <% live_refresh_enabled = @quote_revisions.present? ? @quote_revisions.first&.id == @quote.id : @quote.latest_revision_for_quote_no? %>
  <div id="quote-page-content"
       data-refresh-url="<%= quote_path(@quote, request.query_parameters.except("created", "fill_reason").merge(format: :turbo_stream)) %>"
       data-live-refresh="<%= live_refresh_enabled %>">
    <%= render "show_content" %>
  </div>

  <div id="quote-toast" class="quote-toast" hidden></div>
</section>

<script>
  (() => {
    if (window.__quoteTemplateAutoApplyBound) return;
    window.__quoteTemplateAutoApplyBound = true;

    const toast = () => document.getElementById("quote-toast");
    const defaultTemplateUpdatedMessage = "<%= j(t("quotes.flash.template_updated")) %>";
    const defaultTemplateUpdateFailedMessage = "<%= j(t("quotes.view.show.toolbar.template_update_failed", default: "Template update failed")) %>";

    const showToast = (message, error = false) => {
      const el = toast();
      if (!el) return;

      el.textContent = message;
      el.classList.toggle("is-error", error);
      el.hidden = false;
      el.classList.add("is-visible");

      window.clearTimeout(el._timer);
      el._timer = window.setTimeout(() => {
        el.classList.remove("is-visible");
        window.setTimeout(() => { el.hidden = true; }, 220);
      }, 1600);
    };

    window.refreshQuoteState = async (force = false, skipBlocking = false) => {};

    const syncSearchableSelectInput = (select) => {
      if (!select) return;
      const wrapper = select.previousElementSibling;
      if (!wrapper) return;
      const input = wrapper.querySelector("input[type='text']");
      const selectedOption = select.options[select.selectedIndex];
      if (input && selectedOption) input.value = selectedOption.textContent || "";
    };

    const refreshQuoteContent = async () => {
      const container = document.getElementById("quote-page-content");
      const refreshUrl = container?.dataset?.refreshUrl;
      if (!refreshUrl) return;

      const response = await fetch(refreshUrl, {
        headers: { "Accept": "text/vnd.turbo-stream.html" },
        credentials: "same-origin"
      });
      if (!response.ok) throw new Error("refresh failed");

      const streamHtml = await response.text();
      if (!streamHtml.trim()) return;
      Turbo.renderStreamMessage(streamHtml);
      window.bindSearchableSelects?.();
    };

    document.addEventListener("focusin", (event) => {
      const select = event.target.closest(".js-template-select");
      if (!select) return;

      select.dataset.previousValue = select.value;
      if (!select.dataset.currentValue) select.dataset.currentValue = select.value;
    });

    document.addEventListener("change", async (event) => {
      const select = event.target.closest(".js-template-select");
      if (!select) return;
      if (select.dataset.busy === "true") return;

      const url = select.dataset.updateUrl;
      const doc = select.dataset.doc || "quote";
      const templateId = select.value;
      const currentValue = select.dataset.currentValue || select.dataset.previousValue || templateId;
      if (templateId === currentValue) return;

      const token = document.querySelector("meta[name='csrf-token']")?.content;
      if (!url || !templateId || !token) return;

      const restoreSelection = () => {
        const fallbackValue = select.dataset.currentValue || select.dataset.previousValue;
        if (!fallbackValue) return;
        select.value = fallbackValue;
        syncSearchableSelectInput(select);
      };

      try {
        select.dataset.busy = "true";
        select.disabled = true;

        const body = new URLSearchParams({ template_id: templateId, doc });
        const response = await fetch(url, {
          method: "PATCH",
          headers: {
            "Accept": "application/json",
            "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
            "X-CSRF-Token": token
          },
          body
        });

        let payload = {};
        try {
          payload = await response.json();
        } catch (_) {
          payload = {};
        }
        if (!response.ok) throw new Error(payload.message || defaultTemplateUpdateFailedMessage);

        select.dataset.currentValue = templateId;
        syncSearchableSelectInput(select);

        try {
          await refreshQuoteContent();
        } catch (_) {
          window.location.reload();
          return;
        }

        showToast(payload.message || defaultTemplateUpdatedMessage);
      } catch (error) {
        restoreSelection();
        showToast(error?.message || defaultTemplateUpdateFailedMessage, true);
      } finally {
        select.dataset.busy = "false";
        select.disabled = false;
      }
    });

    const copyText = async (text) => {
      try {
        if (navigator.clipboard?.writeText && window.isSecureContext) {
          await navigator.clipboard.writeText(text);
          return true;
        }
      } catch (_) {
      }

      try {
        const textarea = document.createElement("textarea");
        textarea.value = text;
        textarea.setAttribute("readonly", "");
        textarea.style.position = "fixed";
        textarea.style.top = "-9999px";
        textarea.style.left = "-9999px";
        document.body.appendChild(textarea);
        textarea.focus();
        textarea.select();
        const ok = document.execCommand("copy");
        document.body.removeChild(textarea);
        return !!ok;
      } catch (_) {
        return false;
      }
    };

    document.addEventListener("click", async (event) => {
      const button = event.target.closest("[data-copy-text]");
      if (!button) return;

      event.preventDefault();
      const copied = await copyText(button.dataset.copyText || "");
      showToast(copied ? "Change summary copied" : "Copy failed on browser", !copied);
    });

    // Strip ?created param from address bar so back-navigation doesn't re-show banner
    if (new URLSearchParams(location.search).has("created")) {
      const _u = new URL(location.href);
      _u.searchParams.delete("created");
      history.replaceState(null, "", _u.pathname + (_u.search || ""));
    }
  })();

  (() => {
    if (window.__quoteBannerShareBound) return;
    window.__quoteBannerShareBound = true;

    const csrf = () => document.querySelector("meta[name='csrf-token']")?.content;

    const copyToClipboard = async (text) => {
      try {
        if (navigator.clipboard?.writeText && window.isSecureContext) {
          await navigator.clipboard.writeText(text);
          return true;
        }
      } catch (_) {}
      try {
        const ta = document.createElement("textarea");
        ta.value = text;
        Object.assign(ta.style, { position: "fixed", top: "-9999px", left: "-9999px" });
        document.body.appendChild(ta);
        ta.focus(); ta.select();
        const ok = document.execCommand("copy");
        document.body.removeChild(ta);
        return !!ok;
      } catch (_) { return false; }
    };

    document.addEventListener("click", async (event) => {
      const btn = event.target.closest(".js-banner-share-btn");
      if (!btn || btn.dataset.busy === "true") return;
      event.preventDefault();

      const shareUrl = btn.dataset.shareUrl;
      if (!shareUrl) return;

      btn.dataset.busy = "true";
      const orig = btn.textContent.trim();

      try {
        const resp = await fetch(shareUrl, {
          method: "POST",
          headers: {
            "Accept": "application/json",
            "Content-Type": "application/json",
            "X-CSRF-Token": csrf() || ""
          },
          credentials: "same-origin",
          body: JSON.stringify({})
        });
        const data = await resp.json().catch(() => ({}));
        if (!resp.ok || !data.url) throw new Error(data.message || "Share failed");

        const copied = await copyToClipboard(data.url);
        window.showAppToast?.(
          copied
            ? "<%= j(t('quotes.view.show.created_banner.link_copied')) %>"
            : "<%= j(t('quotes.view.show.toolbar.public_link_ready_manual')) %>",
          copied ? "success" : "warn"
        );
        const banner = document.querySelector(".js-quote-created-banner");
        if (banner) banner.remove();
      } catch (err) {
        window.showAppToast?.(err.message || "Share failed", "error");
        btn.dataset.busy = "false";
        btn.textContent = orig;
      }
    });
  })();

  (() => {
    if (window.__quoteReminderTurnstileBound) return;
    window.__quoteReminderTurnstileBound = true;

    const siteKey = '<%= ENV.fetch("TURNSTILE_SITE_KEY", "0x4AAAAAACkKXqa756rWhUr7") %>';

    const closeReminderModal = (modal) => {
      if (!modal) return;

      const responseField = document.getElementById(modal.dataset.reminderResponseId);
      const loading = modal.querySelector(".js-quote-reminder-loading");
      const widget = modal.querySelector(".js-quote-reminder-widget");
      const success = modal.querySelector(".js-quote-reminder-success");

      if (responseField) responseField.value = "";
      modal.hidden = true;
      if (loading) loading.hidden = false;
      if (widget) widget.hidden = true;
      if (success) success.hidden = true;
    };

    const renderReminderTurnstile = (modal) => {
      if (!modal) return;

      const loading = modal.querySelector(".js-quote-reminder-loading");
      const widget = modal.querySelector(".js-quote-reminder-widget");
      const success = modal.querySelector(".js-quote-reminder-success");
      const form = document.getElementById(modal.dataset.reminderFormId);
      const responseField = document.getElementById(modal.dataset.reminderResponseId);

      if (!loading || !widget || !success || !form || !responseField) return;

      loading.hidden = false;
      widget.hidden = true;
      success.hidden = true;
      responseField.value = "";

      const renderWidget = () => {
        if (typeof turnstile === "undefined") {
          window.setTimeout(renderWidget, 180);
          return;
        }

        loading.hidden = true;
        widget.hidden = false;

        if (modal.dataset.widgetId) {
          turnstile.reset(modal.dataset.widgetId);
          return;
        }

        const widgetId = turnstile.render(widget, {
          sitekey: siteKey,
          theme: "light",
          callback: (token) => {
            responseField.value = token;
            widget.hidden = true;
            success.hidden = false;
            window.setTimeout(() => form.requestSubmit(), 320);
          },
          "expired-callback": () => {
            responseField.value = "";
            success.hidden = true;
            widget.hidden = false;
          },
          "error-callback": () => {
            responseField.value = "";
            success.hidden = true;
            widget.hidden = false;
          }
        });

        modal.dataset.widgetId = widgetId;
      };

      renderWidget();
    };

    document.addEventListener("click", (event) => {
      const openButton = event.target.closest(".js-quote-reminder-open");
      if (openButton) {
        const modal = document.getElementById(openButton.dataset.reminderModalId);
        if (!modal) return;
        event.preventDefault();
        modal.hidden = false;
        renderReminderTurnstile(modal);
        return;
      }

      const closeButton = event.target.closest(".js-quote-reminder-close");
      if (closeButton) {
        closeReminderModal(closeButton.closest(".quote-turnstile-modal"));
        return;
      }

      if (event.target.classList.contains("quote-turnstile-modal")) {
        closeReminderModal(event.target);
      }
    });
  })();

  (() => {
    if (window.__quoteLiveRefreshBound) return;
    window.__quoteLiveRefreshBound = true;

    const getContainer = () => document.getElementById("quote-page-content");
    const initialContainer = getContainer();
    if (!initialContainer) return;
    if (initialContainer.dataset.liveRefresh !== "true") return;

    const collabPanelSelector = ".quote-collab-panel[data-collab-key]";
    const collabStoragePrefix = `quote:collab-panel:${window.location.pathname}:`;
    const inlineDisclosureSelector = "details[data-inline-disclosure-key]";
    const inlineDisclosureStoragePrefix = `quote:inline-disclosure:${window.location.pathname}:`;
    const hasOpenBlockingModal = () => {
      const blockingModalOpen = Array.from(document.querySelectorAll(".quote-turnstile-modal, .quote-reason-options-modal")).some((modal) => !modal.hidden);
      if (blockingModalOpen) return true;

      const sharePanelOpen = Array.from(document.querySelectorAll(".share-link-panel")).some((panel) => !panel.hidden);
      if (sharePanelOpen) return true;

      const inlineDisclosureOpen = Array.from(document.querySelectorAll(inlineDisclosureSelector)).some((block) => block.open);
      if (inlineDisclosureOpen) return true;

      return Array.from(document.querySelectorAll(".quote-toolbar-export")).some((menu) => menu.hasAttribute("open"));
    };

    const readPersistedPanelState = (panelKey) => {
      if (!panelKey) return null;
      try {
        const raw = window.sessionStorage.getItem(`${collabStoragePrefix}${panelKey}`);
        if (raw === "true") return true;
        if (raw === "false") return false;
        return null;
      } catch (_) {
        return null;
      }
    };
    const persistPanelState = (panelKey, open) => {
      if (!panelKey) return;
      try {
        window.sessionStorage.setItem(`${collabStoragePrefix}${panelKey}`, open ? "true" : "false");
      } catch (_) {
      }
    };
    const readPersistedDisclosureState = (disclosureKey) => {
      if (!disclosureKey) return null;
      try {
        const raw = window.sessionStorage.getItem(`${inlineDisclosureStoragePrefix}${disclosureKey}`);
        if (raw === "true") return true;
        if (raw === "false") return false;
        return null;
      } catch (_) {
        return null;
      }
    };
    const persistDisclosureState = (disclosureKey, open) => {
      if (!disclosureKey) return;
      try {
        window.sessionStorage.setItem(`${inlineDisclosureStoragePrefix}${disclosureKey}`, open ? "true" : "false");
      } catch (_) {
      }
    };

    // Snapshot the live <details>.open states BEFORE async refresh.
    const snapshotCollabPanels = () => {
      const c = getContainer();
      if (!c) return {};
      const snapshot = {};
      c.querySelectorAll(collabPanelSelector).forEach((panel) => {
        const panelKey = panel.dataset.collabKey;
        if (!panelKey) return;
        snapshot[panelKey] = panel.open;
      });
      return snapshot;
    };
    const snapshotInlineDisclosures = () => {
      const c = getContainer();
      if (!c) return {};
      const snapshot = {};
      c.querySelectorAll(inlineDisclosureSelector).forEach((block) => {
        const disclosureKey = block.dataset.inlineDisclosureKey;
        if (!disclosureKey) return;
        snapshot[disclosureKey] = block.open;
      });
      return snapshot;
    };

    const bindCollabPanels = (snapshot = null) => {
      const container = getContainer();
      if (!container) return;
      container.querySelectorAll(collabPanelSelector).forEach((panel) => {
        const panelKey = panel.dataset.collabKey;
        if (!panelKey) return;

        if (panel.dataset.bound !== "true") {
          panel.dataset.bound = "true";
          panel.addEventListener("toggle", () => {
            persistPanelState(panelKey, panel.open);
          });
        }

        const snapshotValue = snapshot && Object.prototype.hasOwnProperty.call(snapshot, panelKey) ? snapshot[panelKey] : null;
        const persistedValue = snapshotValue === null ? readPersistedPanelState(panelKey) : null;

        if (snapshotValue === true || persistedValue === true) {
          panel.setAttribute("open", "");
          return;
        }

        if (snapshotValue === false || persistedValue === false) {
          panel.removeAttribute("open");
        }
      });
    };
    const bindInlineDisclosures = (snapshot = null) => {
      const container = getContainer();
      if (!container) return;
      container.querySelectorAll(inlineDisclosureSelector).forEach((block) => {
        const disclosureKey = block.dataset.inlineDisclosureKey;
        if (!disclosureKey) return;

        if (block.dataset.bound !== "true") {
          block.dataset.bound = "true";
          block.addEventListener("toggle", () => {
            persistDisclosureState(disclosureKey, block.open);
          });
        }

        const snapshotValue = snapshot && Object.prototype.hasOwnProperty.call(snapshot, disclosureKey) ? snapshot[disclosureKey] : null;
        const persistedValue = snapshotValue === null ? readPersistedDisclosureState(disclosureKey) : null;

        if (snapshotValue === true || persistedValue === true) {
          block.setAttribute("open", "");
          return;
        }

        if (snapshotValue === false || persistedValue === false) {
          block.removeAttribute("open");
        }
      });
    };

    let inFlight = false;
    let lastRefreshAt = 0;
    let intervalId = null;

    const stopLiveRefresh = () => {
      const container = getContainer();
      if (container) container.dataset.liveRefresh = "false";
      if (intervalId) {
        window.clearInterval(intervalId);
        intervalId = null;
      }
    };

    const syncRefreshEligibility = () => {
      const container = getContainer();
      if (!container) return false;
      const doc = container.querySelector(".quote-document");
      if (doc?.dataset.currentLatest !== "true") {
        stopLiveRefresh();
        return false;
      }
      if (doc?.dataset.hasNewerRevision === "true") {
        stopLiveRefresh();
        return false;
      }

      return container.dataset.liveRefresh === "true";
    };

    const refreshQuoteState = async (force = false, skipBlocking = false) => {
      const container = getContainer();
      if (!container) return;
      if (!syncRefreshEligibility()) return;
      if (inFlight) return;
      if (!skipBlocking && hasOpenBlockingModal()) return;
      if (!force && document.hidden) return;

      const now = Date.now();
      if (!force && now - lastRefreshAt < 12000) return;

      const refreshUrl = container.dataset.refreshUrl;
      if (!refreshUrl) return;

      // Snapshot the live <details>.open states before async fetch.
      const collabSnapshot = snapshotCollabPanels();
      const disclosureSnapshot = snapshotInlineDisclosures();

      inFlight = true;
      try {
        const response = await fetch(refreshUrl, {
          headers: { "Accept": "text/vnd.turbo-stream.html" },
          credentials: "same-origin"
        });
        if (!response.ok) throw new Error("refresh failed");

        const streamHtml = await response.text();
        if (streamHtml.trim()) {
          // Turbo.renderStreamMessage uses Promise microtasks internally; requestAnimationFrame
          // runs after all pending microtasks AND browser DOM mutations, making it
          // more reliable than setTimeout(0) for post-render state restoration.
          Turbo.renderStreamMessage(streamHtml);
          window.requestAnimationFrame(() => {
            bindCollabPanels(collabSnapshot);
            bindInlineDisclosures(disclosureSnapshot);
            syncRefreshEligibility();
          });
        }
        lastRefreshAt = Date.now();
      } catch (_) {
      } finally {
        inFlight = false;
      }
    };

    window.refreshQuoteState = refreshQuoteState;

    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) refreshQuoteState(true);
    });

    window.addEventListener("focus", () => refreshQuoteState(true));
    intervalId = window.setInterval(() => refreshQuoteState(false), 15000);

    bindCollabPanels();
    bindInlineDisclosures();
  })();
</script>
