<section class="customer-follow-up-assistant app-surface">
  <% follow_up_email_ready = local_assigns.fetch(:follow_up_email_ready, true) %>
  <% follow_up_email_block_reason = local_assigns.fetch(:follow_up_email_block_reason, nil) %>

  <div class="app-section-heading">
    <div>
      <h3><%= t("follow_up.assistant.title") %></h3>
      <span class="app-subtle-note"><%= t("follow_up.assistant.subtitle") %></span>
    </div>
  </div>

  <% unless follow_up_email_ready %>
    <div class="app-inline-notice app-inline-notice--warn">
      <p><%= follow_up_email_block_reason %></p>
      <p>
        <%= link_to t("follow_up.assistant.fix_profile"), edit_user_registration_path, class: "app-inline-notice-link" %>
        ·
        <%= link_to t("follow_up.assistant.fix_company"), edit_company_settings_path, class: "app-inline-notice-link" %>
      </p>
    </div>
  <% end %>

  <%= form_with url: log_follow_up_customer_path(customer), method: :post, local: true, html: {
    class: "follow-up-assistant-form",
    data: {
      follow_up_assistant_form: true,
      whatsapp_url: send_follow_up_whatsapp_customer_path(customer, format: :json),
      turnstile_site_key: ENV.fetch("TURNSTILE_SITE_KEY", "0x4AAAAAACkKXqa756rWhUr7"),
      skip_turnstile: ENV["SKIP_TURNSTILE_VERIFICATION"] == "true",
      copy_success: t("follow_up.flash.message_copied"),
      copy_failure: t("follow_up.flash.copy_failed"),
      whatsapp_failed: t("follow_up.flash.whatsapp_failed"),
      email_verify_required: t("follow_up.flash.email_verification_required")
    }
  } do %>
    <%= hidden_field_tag "follow_up[quote_id]", follow_up_quote&.id %>
    <%= hidden_field_tag :cf_turnstile_response, "", data: { follow_up_turnstile_response: true } %>

    <div class="follow-up-assistant-summary">
      <span><strong><%= t("follow_up.assistant.latest_quote") %>:</strong> <%= follow_up_quote.present? ? follow_up_quote.title : t("follow_up.assistant.no_quote") %></span>
      <span><strong><%= t("follow_up.assistant.quote_signal") %>:</strong> <%= t("follow_up.assistant.signal_labels.#{quote_signal_label}") %></span>
      <% if local_assigns.fetch(:best_contact_time, nil).present? %>
        <span class="follow-up-assistant-contact-hint">
          <strong><%= t("analytics.customer_engagement.best_contact_time") %>:</strong>
          <%= best_contact_time %>
        </span>
      <% end %>
    </div>

    <label class="follow-up-assistant-label" for="follow-up-message"><%= t("follow_up.assistant.suggested_message") %></label>
    <%= text_area_tag "follow_up[message]", message, id: "follow-up-message", rows: 5, class: "#{ui_input_classes} follow-up-assistant-input", data: { follow_up_message: true }, placeholder: t("follow_up.assistant.placeholder") %>
    <p class="follow-up-assistant-hint"><%= t("follow_up.assistant.hint") %></p>
    <p class="follow-up-assistant-feedback" data-follow-up-feedback hidden></p>

    <% wa_btn_title = customer.whatsapp_phone.blank? ? t("follow_up.assistant.disabled_no_phone") : nil %>
    <% email_btn_title = customer.email.blank? ? t("follow_up.assistant.disabled_no_email") : (!follow_up_email_ready ? t("follow_up.assistant.disabled_setup_incomplete") : nil) %>
    <div class="follow-up-assistant-actions">
      <%= button_tag t("follow_up.actions.whatsapp"), type: "button", class: ui_button_classes(:secondary, "follow-up-assistant-btn"), title: wa_btn_title, data: { follow_up_whatsapp: true }, disabled: customer.whatsapp_phone.blank? %>
      <%= button_tag t("follow_up.actions.email"), type: "button", class: ui_button_classes(:primary, "follow-up-assistant-btn"), title: email_btn_title, data: { follow_up_email: true, email_action: send_follow_up_email_customer_path(customer), turnstile_modal_id: "follow-up-email-turnstile-modal-#{customer.id}" }, disabled: customer.email.blank? || !follow_up_email_ready %>
      <%= button_tag t("follow_up.actions.copy"), type: "button", class: ui_button_classes(:secondary, "follow-up-assistant-btn"), data: { follow_up_copy: true } %>
      <%= button_tag t("follow_up.actions.log"), type: "submit", class: ui_button_classes(:secondary, "follow-up-assistant-btn") %>
    </div>
    <% if customer.whatsapp_phone.blank? || customer.email.blank? %>
      <p class="follow-up-assistant-missing-hints">
        <% if customer.whatsapp_phone.blank? %>
          <span><%= t("follow_up.assistant.no_whatsapp_number") %></span>
        <% end %>
        <% if customer.email.blank? %>
          <span><%= t("follow_up.assistant.no_email") %></span>
        <% end %>
        <%= link_to t("follow_up.assistant.go_edit_customer"), edit_customer_path(customer), class: "follow-up-assistant-missing-link" %>
      </p>
    <% end %>

    <div class="quote-turnstile-modal"
         id="follow-up-email-turnstile-modal-<%= customer.id %>"
         data-follow-up-email-modal
         data-email-submit-action="<%= send_follow_up_email_customer_path(customer) %>"
         hidden>
      <div class="quote-turnstile-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="follow-up-email-turnstile-modal-<%= customer.id %>-title">
        <button type="button" class="quote-turnstile-modal__close" data-follow-up-email-modal-close aria-label="<%= t("follow_up.assistant.close_verification") %>">×</button>
        <h3 id="follow-up-email-turnstile-modal-<%= customer.id %>-title"><%= t("follow_up.assistant.verify_before_email") %></h3>
        <p><%= t("follow_up.assistant.verify_before_email_hint") %></p>
        <div class="quote-turnstile-modal__loading" data-follow-up-email-loading><%= t("follow_up.assistant.loading_verification") %></div>
        <div class="quote-turnstile-modal__widget" data-follow-up-email-widget hidden></div>
        <div class="quote-turnstile-modal__success" data-follow-up-email-success hidden><%= t("follow_up.assistant.verified_sending") %></div>
      </div>
    </div>
  <% end %>
</section>