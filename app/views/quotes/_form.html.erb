      function setFeedback(type, text, autoclear = false) {
        if (!productFeedback) return;
        if (feedbackTimer) {
          window.clearTimeout(feedbackTimer);
          feedbackTimer = null;
        }
        productFeedback.className = "js-product-feedback product-feedback";
        if (type) productFeedback.classList.add(`product-feedback-${type}`);
        productFeedback.textContent = text || "";

        if (autoclear && text) {
          feedbackTimer = window.setTimeout(() => {
            productFeedback.className = "js-product-feedback product-feedback";
            productFeedback.textContent = "";
          }, 1200);
        }
      }

      function hasActiveTextSelectionWithinEditor() {
        const activeElement = document.activeElement;
        const activeInsideEditor =
          activeElement &&
          (specsEditor?.contains(activeElement) || addonEditor?.contains(activeElement) || imageEditor?.contains(activeElement));

        if (
          activeInsideEditor &&
          typeof activeElement.selectionStart === "number" &&
          typeof activeElement.selectionEnd === "number" &&
          activeElement.selectionStart !== activeElement.selectionEnd
        ) {
          return true;
        }

        const selection = window.getSelection?.();
        return Boolean(selection && !selection.isCollapsed && String(selection).trim());
      }

      function optionButtons() {
        return Array.from(productDropdown?.querySelectorAll(".js-product-option") || []);
      }

      function setActiveOption(index) {
        const options = optionButtons();
        if (!options.length) {
          activeOptionIndex = -1;
          return;
        }

        if (index < 0) index = options.length - 1;
        if (index >= options.length) index = 0;
        activeOptionIndex = index;

        options.forEach((option, idx) => {
          option.classList.toggle("is-active", idx === activeOptionIndex);
          option.setAttribute("aria-selected", idx === activeOptionIndex ? "true" : "false");
          option.classList.remove("is-hovered");
        });

        const active = options[activeOptionIndex];
        if (active) {
          active.scrollIntoView({ block: "nearest" });
        }
      }

      function clearSpecEditor() {
        if (!specsEditor || !specsInput) return;
        const rowsWrap = specsEditor.querySelector(".js-kv-rows");
        if (!rowsWrap) return;
        rowsWrap.innerHTML = createSpecRow();
        syncSpecsText();
      }

      function clearAddonEditor() {
        if (!addonEditor || !addonInput) return;
        const rowsWrap = addonEditor.querySelector(".js-kv-rows");
        if (!rowsWrap) return;
        rowsWrap.innerHTML = createAddonRow();
        syncAddonText();
        updateTotalsUI();
      }

      function fillSelect(select, presets, defaultId, customLabel) {
        if (!select) return;
        const selectedBefore = select.value;
        const options = [`<option value="">${customLabel}</option>`].concat(
          (presets || []).map((preset) => `<option value="${escapeHtml(String(preset.id))}">${escapeHtml(preset.name)}</option>`)
        );
        select.innerHTML = options.join("");
        select.dataset.defaultId = defaultId ? String(defaultId) : "";

        const fallbackPresetId = defaultId ? String(defaultId) : ((presets || [])[0] ? String(presets[0].id) : "");
        const nextValue = selectedBefore && (presets || []).some((preset) => String(preset.id) === String(selectedBefore)) ? selectedBefore : fallbackPresetId;
        select.value = nextValue;
      }

      function specPresetById(selected, presetId) {
        return (selected?.spec_presets || []).find((preset) => String(preset.id) === String(presetId));
      }

      function addonPresetById(selected, presetId) {
        return (selected?.addon_presets || []).find((preset) => String(preset.id) === String(presetId));
      }

      function syncImageTriggerLabel(hasImage) {
        if (!openImageBtn) return;
        openImageBtn.textContent = hasImage ? imageTriggerLabelChange : imageTriggerLabelAdd;
      }

      function setImagePreview(url) {
        if (!itemImageCurrent || !itemImageThumb || !itemImageEmptyHint) return;
        const hasUrl = Boolean(url);
        itemImageCurrent.classList.toggle("is-empty", !hasUrl);
        itemImageThumb.hidden = !hasUrl;
        itemImageEmptyHint.hidden = hasUrl;
        itemImageThumb.src = hasUrl ? url : "";
        syncImageTriggerLabel(hasUrl);
      }

      function selectGalleryImage(imageOption) {
        if (!imageOption) return;
        if (itemImageBlobIdInput) itemImageBlobIdInput.value = String(imageOption.blob_id || "");
        if (removeItemImageInput) removeItemImageInput.value = "0";
        if (itemImageUploadInput) itemImageUploadInput.value = "";
        setImagePreview(imageOption.url);
      }

      function clearSelectedImage() {
        if (itemImageBlobIdInput) itemImageBlobIdInput.value = "";
        if (removeItemImageInput) removeItemImageInput.value = "1";
        if (itemImageUploadInput) itemImageUploadInput.value = "";
        setImagePreview("");
        itemImageGallery?.querySelectorAll(".quote-item-gallery-option").forEach((el) => el.classList.remove("is-active"));
      }

      function renderImageGallery(selectedProduct) {
        if (!itemImageGallery || !itemImageGalleryEmpty) return;
        const imageOptions = selectedProduct?.image_options || [];
        if (!imageOptions.length) {
          itemImageGallery.innerHTML = "";
          itemImageGalleryEmpty.hidden = false;
          return;
        }

        itemImageGalleryEmpty.hidden = true;
        itemImageGallery.innerHTML = imageOptions.map((imageOption) => {
          const blobId = String(imageOption.blob_id || "");
          const isSelected = String(itemImageBlobIdInput?.value || "") === blobId;
          return `
            <button type="button" class="quote-item-gallery-option ${isSelected ? "is-active" : ""}" data-blob-id="${escapeAttr(blobId)}" data-image-url="${escapeAttr(imageOption.url || "")}">
              <img src="${escapeAttr(imageOption.url || "")}" alt="${escapeAttr(imageOption.label || "")}">
            </button>
          `;
        }).join("");

        itemImageGallery.querySelectorAll(".quote-item-gallery-option").forEach((button) => {
          button.addEventListener("click", () => {
            selectGalleryImage({ blob_id: button.dataset.blobId, url: button.dataset.imageUrl });
            itemImageGallery.querySelectorAll(".quote-item-gallery-option").forEach((el) => el.classList.remove("is-active"));
            button.classList.add("is-active");
          });
