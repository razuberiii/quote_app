<div class="auth-page" style="margin-top: 40px;">
  <div class="auth-card">
    <div style="text-align: center;">
      <h1 style="margin: 0 0 20px 0; color: #dc3545;">✕ Invalid or Expired Link</h1>
      <p style="color: #666; margin: 0 0 30px 0; font-size: 1.05em;">
        The email change link you used is invalid or has expired.
      </p>
      <p style="color: #999; margin: 0 0 30px 0;">
        Links expire after 15 minutes for security reasons.
      </p>
      <%= link_to "Request New Email Change", edit_user_registration_path, class: "btn btn-primary" %>
    </div>
  </div>
</div>
