                          <span class="quote-kv-bulk-check js-spec-bulk-check" aria-live="polite"></span>
                        </div>
                      </div>
                      <div class="quote-kv-rows js-kv-rows">
                        <% spec_rows = item.specification_pairs.presence || [ { key: "", value: "" } ] %>
                        <% spec_rows.each do |pair| %>
                          <div class="quote-kv-row">
                            <input type="text" class="js-kv-key" value="<%= pair[:key] %>" placeholder="<%= t("quotes.view.form.spec_key_placeholder") %>">
                            <input type="text" class="js-kv-value" value="<%= pair[:value] %>" placeholder="<%= t("quotes.view.form.spec_value_placeholder") %>">
                            <button type="button" class="quote-kv-remove js-kv-remove" aria-label="<%= t("quotes.view.form.remove_specification") %>">&times;</button>
                          </div>
