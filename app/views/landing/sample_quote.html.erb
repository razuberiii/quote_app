<%= render "components/ui/card", class: "no-print mb-5 app-surface marketing-section-card" do %>
  <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
    <div class="max-w-2xl">
      <%= render "components/ui/section_header",
        kicker: t("landing.view.sample_quote.kicker"),
        title: t("landing.view.sample_quote.title"),
        body: t("landing.view.sample_quote.subtitle"),
        title_class: "mt-2 text-2xl font-semibold tracking-[-0.03em] text-slate-950",
        body_class: "mt-3 text-sm leading-7 text-slate-600" %>
      <div class="mt-3 app-stat-card text-sm leading-7 text-slate-700">
        <p class="m-0"><strong class="text-slate-950"><%= t("landing.view.sample_quote.preview_label") %></strong> <%= t("landing.view.sample_quote.preview_body") %></p>
        <p class="m-0 mt-1"><%= t("landing.view.sample_quote.preview_supporting") %></p>
      </div>
      <div class="mt-3 flex flex-wrap gap-2">
        <span class="app-status-badge app-status-badge--blue"><%= t("landing.view.sample_quote.buyer_can_accept") %></span>
        <span class="app-status-badge app-status-badge--blue"><%= t("landing.view.sample_quote.buyer_can_request_revision") %></span>
        <span class="app-status-badge app-status-badge--blue"><%= t("landing.view.sample_quote.pdf_excel_available") %></span>
      </div>
    </div>

    <div class="flex flex-wrap gap-3">
      <%= render "components/ui/button", href: demo_path, variant: :primary do %>
        <%= t("landing.view.sample_quote.view_demo_workspace") %>
      <% end %>
      <%= render "components/ui/button", href: new_user_registration_path, variant: :secondary do %>
        <%= t("landing.view.sample_quote.start_for_free") %>
      <% end %>
      <%= render "components/ui/button", href: contact_path, variant: :ghost do %>
        <%= t("landing.shared.navigation.contact") %>
      <% end %>
    </div>
  </div>
<% end %>

<article class="quote-document public-quote-document public-quote-themed public-layout-classic" style="--doc-accent: #1F4E79; --doc-on-accent: <%= contrast_text_color('#1F4E79') %>; --doc-font: 'Noto Sans';">
  <header class="quote-doc-header">
    <div>
      <p class="quote-doc-kicker"><%= @sample_quote[:document_title] %></p>
      <h1><%= t("landing.view.sample_quote.pi_number", number: @sample_quote[:quote_no]) %></h1>
    </div>
  </header>

  <div class="no-print mb-4 app-stat-card app-panel-muted">
    <span class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-500"><%= t("landing.view.sample_quote.buyer_actions") %></span>
    <div class="mt-2 flex flex-wrap items-center gap-3">
      <button type="button" class="<%= ui_button_classes(:primary) %>" disabled aria-disabled="true"><%= t("landing.view.sample_quote.accept_quote") %></button>
      <button type="button" class="<%= ui_button_classes(:secondary) %>" disabled aria-disabled="true"><%= t("landing.view.sample_quote.request_revision") %></button>
      <span class="text-xs text-slate-500"><%= t("landing.view.sample_quote.preview_mode_note") %></span>
    </div>
  </div>

  <section class="quote-meta-grid">
    <article class="quote-meta-card">
      <h3><%= t("quote_document.labels.seller") %></h3>
      <p><strong><%= @sample_quote[:seller][:name] %></strong></p>
      <p><%= @sample_quote[:seller][:address] %></p>
      <p><%= @sample_quote[:seller][:phone] %></p>
      <p><%= @sample_quote[:seller][:email] %></p>
      <p><%= @sample_quote[:seller][:website] %></p>
    </article>

    <article class="quote-meta-card">
      <h3><%= t("quote_document.labels.buyer") %></h3>
      <p><strong><%= @sample_quote[:buyer][:name] %></strong></p>
      <p><%= t("quote_document.labels.contact") %>: <%= @sample_quote[:buyer][:contact_name] %></p>
      <p><%= @sample_quote[:buyer][:address] %></p>
      <p><%= @sample_quote[:buyer][:phone] %></p>
      <p><%= @sample_quote[:buyer][:email] %></p>
    </article>

    <article class="quote-meta-card">
      <h3><%= t("quote_document.labels.quote_info") %></h3>
      <p><strong><%= t("quote_document.labels.quote_date") %>:</strong> <%= @sample_quote[:issued_on] %></p>
      <p><strong><%= t("quote_document.labels.valid_until") %>:</strong> <%= @sample_quote[:valid_until] %></p>
      <p><strong><%= t("quote_document.labels.currency") %>:</strong> <%= @sample_quote[:currency] %></p>
      <p><strong><%= t("quote_document.labels.delivery_notes") %>:</strong> <%= t("landing.view.sample_quote.delivery_days") %></p>
    </article>
  </section>

  <div class="table-responsive">
    <table class="quote-items-table quote-doc-table">
      <thead>
        <tr>
          <th><%= t("quote_document.labels.description", default: "Description") %></th>
          <th><%= t("quote_document.labels.qty", default: "Qty") %></th>
          <th><%= t("quote_document.labels.unit_price", default: "Unit Price") %></th>
          <th><%= t("quote_document.labels.line_total", default: "Line Total") %></th>
        </tr>
      </thead>
      <tbody>
        <% subtotal = 0.to_d %>
        <% @sample_quote[:items].each do |item| %>
          <% line_total = item[:unit_price].to_d * item[:quantity].to_i %>
          <% subtotal += line_total %>
          <tr>
            <td><%= item[:description] %></td>
            <td><%= item[:quantity] %></td>
            <td><%= number_to_currency(item[:unit_price], unit: "USD ") %></td>
            <td><%= number_to_currency(line_total, unit: "USD ") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <aside class="quote-total-box">
    <p><span><%= t("quote_document.labels.subtotal") %></span><strong><%= number_to_currency(subtotal, unit: "USD ") %></strong></p>
    <p><span><%= t("quote_document.labels.tax_vat") %></span><strong><%= number_to_currency(0, unit: "USD ") %></strong></p>
    <p><span><%= t("quote_document.labels.shipping") %></span><strong><%= number_to_currency(0, unit: "USD ") %></strong></p>
    <p><span><%= t("quote_document.labels.discount") %></span><strong><%= number_to_currency(0, unit: "USD ") %></strong></p>
    <p class="quote-total-grand"><span><%= t("quote_document.labels.grand_total") %></span><strong><%= number_to_currency(subtotal, unit: "USD ") %></strong></p>
  </aside>

  <section class="quote-section-block">
    <h3><%= t("quote_document.sections.terms_and_conditions") %></h3>
    <p><strong><%= t("quote_document.labels.payment_terms") %>:</strong> <%= @sample_quote[:terms][:payment] %></p>
    <p><strong><%= t("landing.view.sample_quote.validity") %>:</strong> <%= @sample_quote[:terms][:validity] %></p>
    <p><strong><%= t("landing.view.sample_quote.delivery") %>:</strong> <%= @sample_quote[:terms][:delivery] %></p>
    <p><strong><%= t("quote_document.labels.notes") %>:</strong> <%= @sample_quote[:terms][:notes] %></p>
  </section>

  <div class="no-print quote-public-actions">
    <button type="button" onclick="window.print()"><%= t("landing.view.sample_quote.print") %></button>
  </div>
</article>
