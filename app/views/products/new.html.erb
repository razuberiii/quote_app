<section class="workspace-page workspace-page--editor">
  <header class="workspace-heading">
    <span class="eyebrow"><%= t("self_service.product.new.eyebrow") %></span>
    <h1><%= t("self_service.product.new.title") %></h1>
    <p><%= t("self_service.product.new.body") %></p>
  </header>

  <%= render "form",
             product: @product,
             submit_label: t("products.view.new.submit_label"),
             back_path: products_path,
             back_label: t("products.view.new.back_to_products") %>
</section>
