<%= render "shared/settings_header", title: t("team_invitations.view.index.header_title"), section: :invitations %>

<section class="team-members-panel">
  <p class="team-members-hint"><%= t("team_invitations.view.index.hint") %></p>
  <% if @invitations.any? %>
    <div class="table-responsive">
      <table>
        <thead>
          <tr>
            <th><%= t("team_invitations.view.index.company") %></th>
            <th><%= t("team_invitations.view.index.role") %></th>
            <th><%= t("team_invitations.view.index.invited_by") %></th>
            <th><%= t("team_invitations.view.index.status") %></th>
            <th><%= t("team_invitations.view.index.expires") %></th>
            <th><%= t("team_invitations.view.index.action") %></th>
          </tr>
        </thead>
        <tbody>
          <% @invitations.each do |invitation| %>
            <tr>
              <td><%= invitation.company.name %></td>
              <td><span class="role-badge role-badge-<%= invitation.company_role %>"><%= invitation.company_role.capitalize %></span></td>
              <td><%= invitation.invited_by.email %></td>
              <td><span class="status-badge status-badge-pending"><%= t("team_invitations.view.index.pending") %></span></td>
              <td><%= invitation.expires_at.strftime("%Y-%m-%d %H:%M") %></td>
              <td>
                <%= button_to t("team_invitations.view.index.accept"),
                              accept_team_invitation_path(invitation.token),
                              method: :post,
                              class: "app-ui-button app-ui-button--primary" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="team-members-hint"><%= t("team_invitations.view.index.empty") %></p>
  <% end %>
</section>
