<% doc_accent = @template.accent_color.presence || "#1F4E79" %>
<% raw_document_kind = @document_kind || params[:document_kind] || params[:doc] || params[:kind] %>
<% document_kind = @template.normalize_document_kind(raw_document_kind || @template.default_document_kind) %>
<% spec_label = @quote.resolved_spec_label %>
<% addon_label = @quote.resolved_addon_label %>
<% watermark_text = template_watermark_text(@template, @quote.company.name) %>
<% watermark_image_url = quote_watermark_data_uri || template_watermark_image_url(@template) %>
<% pdf_watermark_opacity = [template_watermark_opacity(@template).to_f * 0.5, 0.08].min %>
<% pdf_items = @quote.quote_items.ordered.to_a %>
<% revision_diff_context = @template.show_pdf_revision_summary? ? quote_revision_diff_context(@quote) : nil %>
<% revision_diff = revision_diff_context&.dig(:diff) %>
<% revision_item_map = revision_diff.present? ? quote_diff_item_map(revision_diff) : {} %>
<% item_key_counters = Hash.new(0) %>
<% valid_until_change = revision_diff.present? ? quote_diff_commercial_change(revision_diff, :valid_until) : nil %>
<% trade_term_change = revision_diff.present? ? quote_diff_commercial_change(revision_diff, :trade_term) : nil %>
<% payment_term_change = revision_diff.present? ? quote_diff_commercial_change(revision_diff, :payment_term) : nil %>
<% scope_of_supply_changed = revision_diff.present? && quote_diff_changed?(revision_diff, :scope_of_supply) %>
<% pdf_min_visual_rows = 4 %>
<% pdf_filler_rows = [pdf_min_visual_rows - pdf_items.size, 0].max %>
<% pdf_sparse_content = pdf_items.size < pdf_min_visual_rows %>
<% signature_image_url = template_signature_image_url(@template) %>
<% signature_name = template_signature_name(@template) %>
<% show_signature_section = @template.show_signature_block && (signature_image_url.present? || signature_name.present?) %>
<style>
  /* Dynamic accent color for PDF rendering */
  .pdf-render .quote-doc-kicker {
    color: <%= doc_accent %> !important;
  }
  .pdf-render .quote-total-grand {
    background-color: transparent !important;
    color: #222 !important;
  }
  .pdf-render .quote-total-grand span,
  .pdf-render .quote-total-grand strong {
    color: #222 !important;
  }
  /* wkhtmltopdf can be inconsistent with CSS var() on pseudo elements */
  .pdf-render .quote-watermarked::before {
    opacity: <%= pdf_watermark_opacity %> !important;
  }
  .pdf-render .quote-watermark-image {
    opacity: <%= pdf_watermark_opacity %> !important;
  }
</style>
<article class="quote-document public-quote-document public-quote-themed public-layout-<%= @template.layout_type %> pdf-density-<%= @template.layout_density %> pdf-logo-<%= @template.logo_position %><%= ' quote-watermarked' if watermark_text.present? %><%= ' pdf-content-sparse' if pdf_sparse_content %>" data-watermark="<%= watermark_text %>" style="--quote-watermark-opacity: <%= pdf_watermark_opacity %>; --doc-accent: <%= doc_accent %>; --doc-on-accent: #ffffff; --doc-font: 'Noto Sans';">
  <% if watermark_image_url.present? %>
    <img src="<%= watermark_image_url %>" alt="Watermark" class="quote-watermark-image">
  <% end %>
  <% title_text = @template.resolved_document_title(document_kind).to_s.upcase %>
  <% number_label = @template.resolved_document_number_label(document_kind) %>
  <% logo_uri = quote_logo_data_uri if @template.show_logo %>
  <% company_header_lines = [@quote.company.address, @quote.company.phone, @quote.company.email, @quote.company.website].compact_blank %>
  <% seller_address = @quote.company.address.to_s.strip %>
  <% seller_phone = @quote.company.phone.to_s.strip %>
  <% seller_email = @quote.company.email.to_s.strip %>
  <% seller_website = @quote.company.website.to_s.strip %>
  <% buyer_name = @quote.customer.name.to_s.strip %>
  <% buyer_contact = @quote.customer.contact_name.to_s.strip %>
  <% buyer_address = @quote.customer.address.to_s.strip %>
  <% buyer_phone = @quote.customer.formatted_phone.to_s.strip %>
  <% buyer_email = @quote.customer.email.to_s.strip %>
  <% issued_on_text = @quote.issued_on&.strftime("%Y-%m-%d").to_s.strip %>
  <% terms_lines = [] %>
  <% if @template.show_terms_section %>
    <% terms_lines << [ "Payment Terms", @quote.payment_term, :payment_term ] if @template.show_payment_term && @quote.payment_term.present? %>
    <% terms_lines << [ "Trade Terms", @quote.trade_term, :trade_term ] if @quote.trade_term.present? %>
    <% terms_lines << [ "Terms", @quote.terms_text, :terms_text ] if @quote.terms_text.present? %>
    <% terms_lines << [ "Legal Disclaimer", @quote.legal_disclaimer, :legal_disclaimer ] if @quote.legal_disclaimer.present? %>
    <% terms_lines << [ "Delivery Notes", @quote.delivery_notes, :delivery_notes ] if @quote.delivery_notes.present? %>
  <% end %>
  <% if logo_uri.present? %>
    <div class="pdf-logo-band pdf-logo-<%= @template.logo_position %>">
      <img src="<%= logo_uri %>" class="quote-doc-logo" alt="Company logo">
    </div>
  <% end %>

  <header class="quote-doc-header pdf-doc-header">
    <table class="pdf-head-table">
      <tr>
        <td class="pdf-head-left">
          <h1><%= @quote.company.name.to_s %></h1>
          <div class="pdf-doc-company-lines">
            <% company_header_lines.each do |line| %>
              <p><%= line %></p>
            <% end %>
          </div>
        </td>
        <td class="pdf-head-right">
          <div class="pdf-doc-meta-block">
            <p class="quote-doc-kicker"><%= title_text %></p>
            <p class="pdf-doc-number is-doc-number"><strong><%= number_label %></strong> <span class="pdf-doc-number-value"><%= @quote.quote_no %></span></p>
            <div class="pdf-doc-meta-grid pdf-doc-meta-grid--primary">
              <% if issued_on_text.present? %>
                <p class="pdf-doc-meta-row">
                  <span><%= document_kind == "pi" ? "PI Date" : "Quote Date" %></span>
                  <strong><%= issued_on_text %></strong>
                </p>
              <% end %>
              <% if @template.show_valid_until && @quote.valid_until.present? %>
                <p class="pdf-doc-meta-row is-valid-until">
                  <span>Valid Until</span>
                  <strong><%= @quote.valid_until.strftime("%Y-%m-%d") %></strong>
                  <% if valid_until_change.present? %><span class="quote-inline-flag quote-inline-flag--updated quote-inline-flag--compact"><%= t("quote_document.inline_diff.updated") %></span><% end %>
                </p>
              <% end %>
            </div>
            <div class="pdf-doc-meta-grid pdf-doc-meta-grid--secondary">
              <% if @template.show_currency %>
                <p class="pdf-doc-meta-row">
                  <span>Currency</span>
                  <strong><%= @quote.currency %></strong>
                </p>
              <% end %>
              <% if @quote.trade_term.present? %>
                <p class="pdf-doc-meta-row">
                  <span>Trade Terms</span>
                  <strong><%= @quote.trade_term %></strong>
                  <% if trade_term_change.present? %><span class="quote-inline-flag quote-inline-flag--updated quote-inline-flag--compact"><%= t("quote_document.inline_diff.updated") %></span><% end %>
                </p>
              <% end %>
              <% if @quote.custom_title.present? %>
                <p class="pdf-doc-meta-row is-wide">
                  <span>Title</span>
                  <strong><%= @quote.custom_title %></strong>
                </p>
              <% end %>
            </div>
          </div>
        </td>
      </tr>
    </table>
  </header>

  <section class="quote-meta-grid">
    <table class="pdf-party-table">
      <tr>
        <td class="quote-meta-card pdf-party-col">
          <h3>Seller</h3>
          <p class="pdf-party-name"><strong><%= @quote.company.name %></strong></p>
          <% if @template.show_customer_owner && Customer.internal_owner_enabled? && @quote.customer.internal_owner_display_name != "-" %>
            <p>Sales Owner: <%= @quote.customer.internal_owner_display_name %></p>
          <% end %>
          <% if seller_address.present? %><p><%= seller_address %></p><% end %>
          <% if seller_phone.present? %><p><%= seller_phone %></p><% end %>
          <% if seller_email.present? %><p><%= seller_email %></p><% end %>
          <% if seller_website.present? %><p><%= seller_website %></p><% end %>
        </td>
        <td class="quote-meta-card pdf-party-col">
          <h3>Buyer</h3>
          <% if buyer_name.present? %>
            <p class="pdf-party-name"><strong><%= buyer_name %></strong></p>
          <% end %>
          <% if buyer_contact.present? %><p>Contact: <%= buyer_contact %></p><% end %>
          <% if buyer_address.present? %><p><%= buyer_address %></p><% end %>
          <% if buyer_phone.present? %><p><%= buyer_phone %></p><% end %>
          <% if buyer_email.present? %><p><%= buyer_email %></p><% end %>
          <% if @quote.customer.tax_id.present? %>
            <p>Tax ID: <%= [@quote.customer.tax_id_type.presence, @quote.customer.tax_id].compact.join(" ") %></p>
          <% end %>
        </td>
      </tr>
    </table>
  </section>

  <div class="table-responsive">
    <table class="quote-items-table quote-doc-table <%= @template.show_images? ? 'has-images' : 'no-images' %>">
      <colgroup>
        <col style="width: 6.5%;">
        <% if @template.show_images? %><col style="width: 10%;"><% end %>
        <col>
        <col style="width: 9%;">
        <col style="width: 15%;">
        <col style="width: 17%;">
      </colgroup>
      <thead>
        <tr>
          <th class="is-left">No.</th>
          <% if @template.show_images? %><th class="is-left">Image</th><% end %>
          <th class="is-left"><%= @template.resolved_table_label("description") %></th>
          <th class="is-right"><%= @template.resolved_table_label("qty") %></th>
          <th class="is-money"><%= @template.resolved_table_label("unit_price") %></th>
          <th class="is-money"><%= @template.resolved_table_label("line_total") %></th>
        </tr>
      </thead>
      <tbody>
        <% pdf_items.each_with_index do |item, idx| %>
          <% row_key = quote_item_diff_key(item, item_key_counters) %>
          <% row_diff = revision_item_map[row_key] || {} %>
          <% row_added = row_diff[:change_type] == :added %>
          <% quantity_changed = row_diff[:quantity_changed] || false %>
          <% unit_price_changed = row_diff[:unit_price_changed] || false %>
          <tr class="<%= 'quote-row-added' if row_added %>">
            <td class="is-left"><%= idx + 1 %></td>
            <% if @template.show_images? %>
              <td class="is-left">
                <% if (item_data_uri = quote_item_image_data_uri(item)).present? %>
                  <img src="<%= item_data_uri %>" class="quote-item-image" alt="Product image">
                <% else %>
                  -
                <% end %>
              </td>
            <% end %>
            <td class="is-left">
              <div class="quote-item-desc">
                <div class="quote-item-desc-main">
                  <%= item.product&.name.presence || item.description.presence || "Item" %>
                  <% if row_added %>
                    <span class="quote-inline-flag quote-inline-flag--added"><%= t("quote_document.inline_diff.added") %></span>
                  <% end %>
                </div>
                <% spec_rows = quote_spec_rows_with_diff(item.specification_pairs, row_diff) %>
                <% addon_rows = quote_addon_rows_with_diff(item.addon_charge_entries, row_diff) %>
                <% if spec_rows.any? || addon_rows.any? %>
                  <div class="quote-item-desc-meta">
                    <% if spec_rows.any? %>
                      <div class="quote-item-desc-group">
                        <div class="quote-item-desc-group-label"><%= spec_label %>:</div>
                        <% spec_rows.each do |spec_row| %>
                          <div class="quote-item-desc-sub">
                            <span class="quote-item-desc-bullet">&bull;</span><%= spec_row[:key] %> -
                            <% case spec_row[:change_type] %>
                            <% when :updated %>
                              <%= quote_inline_diff_text(spec_row[:before], spec_row[:after]) %>
                            <% when :removed %>
                              <span class="quote-inline-old"><%= spec_row[:value] %></span>
                              <span class="quote-inline-flag quote-inline-flag--removed quote-inline-flag--compact"><%= t("quote_document.inline_diff.removed") %></span>
                            <% else %>
                              <%= spec_row[:value] %>
                              <% if spec_row[:change_type] == :added %><span class="quote-inline-flag quote-inline-flag--added quote-inline-flag--compact"><%= t("quote_document.inline_diff.added") %></span><% end %>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                    <% end %>
                    <% if addon_rows.any? %>
                      <div class="quote-item-desc-group is-addon">
                        <div class="quote-item-desc-group-label"><%= addon_label %>:</div>
                        <% addon_rows.each do |addon_row| %>
                          <div class="quote-item-desc-sub is-addon">
                            <span class="quote-item-desc-bullet">&bull;</span><%= addon_row[:name] %>
                            <% case addon_row[:change_type] %>
                            <% when :updated %>
                              <%= quote_inline_diff_money(addon_row[:before], addon_row[:after], @quote.currency, show_symbol: @template.show_currency, template: @template) %>
                            <% when :removed %>
                              (<span class="quote-inline-old"><%= template_money(addon_row[:amount], @quote.currency, @template, show_currency: @template.show_currency) %></span>)
                              <span class="quote-inline-flag quote-inline-flag--removed quote-inline-flag--compact"><%= t("quote_document.inline_diff.removed") %></span>
                            <% else %>
                              (<%= template_money(addon_row[:amount], @quote.currency, @template, show_currency: @template.show_currency) %>)
                              <% if addon_row[:change_type] == :added %><span class="quote-inline-flag quote-inline-flag--added quote-inline-flag--compact"><%= t("quote_document.inline_diff.added") %></span><% end %>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </td>
            <td class="is-right"><%= quantity_changed ? quote_stacked_diff_text(row_diff[:quantity_before], row_diff[:quantity_after]) : item.quantity %></td>
            <td class="is-money"><%= unit_price_changed ? quote_stacked_diff_money(row_diff[:unit_price_before], row_diff[:unit_price_after], @quote.currency, show_symbol: @template.show_currency, template: @template) : template_money(item.unit_price, @quote.currency, @template, show_currency: @template.show_currency) %></td>
            <td class="is-money"><%= (quantity_changed || unit_price_changed) ? quote_stacked_diff_money(row_diff[:line_total_before], row_diff[:line_total_after], @quote.currency, show_symbol: @template.show_currency, template: @template) : template_money(item.line_total, @quote.currency, @template, show_currency: @template.show_currency) %></td>
          </tr>
        <% end %>
        <% Array(revision_diff&.dig(:removed_items)).each do |removed_item| %>
          <tr class="quote-row-removed">
            <td class="is-left">-</td>
            <% if @template.show_images? %><td class="is-left">-</td><% end %>
            <td class="is-left"><span class="quote-inline-old"><%= removed_item[:product_name] %></span> <span class="quote-inline-flag quote-inline-flag--removed quote-inline-flag--compact"><%= t("quote_document.inline_diff.removed") %></span></td>
            <td class="is-right"><span class="quote-inline-old"><%= removed_item[:quantity_before] %></span></td>
            <td class="is-money"><span class="quote-inline-old"><%= template_money(removed_item[:unit_price_before], @quote.currency, @template, show_currency: @template.show_currency) %></span></td>
            <td class="is-money"><span class="quote-inline-old"><%= template_money(removed_item[:line_total_before], @quote.currency, @template, show_currency: @template.show_currency) %></span></td>
          </tr>
        <% end %>
        <% pdf_filler_rows.times do %>
          <tr class="pdf-filler-row" aria-hidden="true">
            <td class="is-left">&nbsp;</td>
            <% if @template.show_images? %>
              <td class="is-left">&nbsp;</td>
            <% end %>
            <td class="is-left">&nbsp;</td>
            <td class="is-right">&nbsp;</td>
            <td class="is-money">&nbsp;</td>
            <td class="is-money">&nbsp;</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% currency_code = @quote.currency.to_s.upcase.presence || "USD" %>
  <% discount_amount = @quote.discount_amount.to_d %>
  <% has_discount = discount_amount.positive? %>
  <% show_discount_row = has_discount %>
  <% original_total = @quote.subtotal.to_d + @quote.tax_amount.to_d + @quote.shipping_amount.to_d %>
  <% grand_amount_text = template_money(@quote.grand_total, @quote.currency, @template, show_currency: @template.show_currency) %>
  <div class="pdf-summary-stack">
    <aside class="quote-total-box pdf-total-box">
      <p><span>Subtotal</span><strong><%= template_money(@quote.subtotal, @quote.currency, @template, show_currency: @template.show_currency) %></strong></p>
      <% if @template.show_tax %>
        <p><span>Tax / VAT</span><strong><%= template_money(@quote.tax_amount, @quote.currency, @template, show_currency: @template.show_currency) %></strong></p>
      <% end %>
      <% if @template.show_shipping %>
        <p><span>Shipping</span><strong><%= template_money(@quote.shipping_amount, @quote.currency, @template, show_currency: @template.show_currency) %></strong></p>
      <% end %>
      <% if show_discount_row %>
        <p class="quote-total-discount"><span>Discount</span><strong><%= has_discount ? "-#{template_money(discount_amount, @quote.currency, @template, show_currency: @template.show_currency)}" : template_money(discount_amount, @quote.currency, @template, show_currency: @template.show_currency) %></strong></p>
        <% if has_discount %>
          <p class="quote-total-reduction"><span>Original Total</span><strong><%= template_money(original_total, @quote.currency, @template, show_currency: @template.show_currency) %></strong></p>
        <% end %>
      <% end %>
      <p class="quote-total-grand">
        <span>Grand Total</span>
        <strong><%= revision_diff.present? && revision_diff[:total_before].to_d != revision_diff[:total_after].to_d ? quote_stacked_diff_money(revision_diff[:total_before], revision_diff[:total_after], @quote.currency, show_symbol: @template.show_currency, template: @template) : grand_amount_text %></strong>
      </p>
      <% if has_discount %>
        <p class="quote-total-saved"><span>You Save</span><strong><%= template_money(discount_amount, @quote.currency, @template, show_currency: @template.show_currency) %></strong></p>
      <% end %>
    </aside>
    <% if (closing_message = @template.resolved_closing_message).present? %>
      <p class="quote-engagement-note pdf-engagement-note"><%= closing_message %></p>
    <% end %>
  </div>

  <% revision_summary = @template.show_pdf_revision_summary? ? QuoteRevisionSummaryService.new(quote: @quote).call : nil %>
  <% if revision_summary.present? %>
    <section class="quote-section-block quote-section-block--revision-summary">
      <h3><%= t("quote_document.revision_summary.title") %></h3>
      <p><%= t("quote_document.revision_summary.compare_versions", current: (revision_diff_context&.dig(:current_revision_number) || revision_summary[:current_revision_number]), previous: (revision_diff_context&.dig(:previous_revision_number) || revision_summary[:previous_revision_number])) %></p>
      <ul class="quote-revision-summary-list">
        <% revision_summary[:lines].first(3).each do |line| %>
          <li><%= line %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% scope_text = @quote.scope_of_supply.to_s.strip %>
  <% show_scope_of_supply = document_kind != "pi" && @template.show_scope_of_supply && scope_text.present? %>
  <% if show_scope_of_supply %>
    <section class="quote-section-block quote-section-block--scope">
      <h3><%= @template.resolved_scope_of_supply_label %> <% if scope_of_supply_changed %><span class="quote-inline-flag quote-inline-flag--updated"><%= t("quote_document.inline_diff.updated") %></span><% end %></h3>
      <%= simple_format(scope_text) %>
    </section>
  <% end %>

  <% if terms_lines.any? %>
    <section class="quote-section-block">
      <h3>Terms & Conditions</h3>
      <% terms_lines.each do |label, value, field_key| %>
        <% field_changed = revision_diff.present? && quote_diff_changed?(revision_diff, field_key) %>
        <p><strong><%= label %>:</strong> <% if field_changed %><span class="quote-inline-flag quote-inline-flag--updated"><%= t("quote_document.inline_diff.updated") %></span><% end %> <%= value %></p>
      <% end %>
    </section>
  <% end %>

  <% if @template.show_notes && @quote.notes.present? %>
    <section class="quote-section-block">
      <h3>Notes</h3>
      <%= simple_format(@quote.notes) %>
    </section>
  <% end %>
  <% company_documents = @quote.company.company_documents.ordered %>
  <% if company_documents.any? %>
    <section class="quote-section-block">
      <h3>Company Credentials</h3>
      <% company_documents.each do |document| %>
        <p><strong><%= document.title %></strong> - <%= document.document_type_label %></p>
      <% end %>
    </section>
  <% end %>
  <% footer_note = @template.resolved_footer_note(@document_kind) %>
  <% show_footer_section = footer_note.present? %>
  <% if show_footer_section || show_signature_section %>
    <section class="quote-ending-stack">
      <% if show_footer_section %>
        <section class="quote-section-block quote-section-block--ending">
          <h3><%= t("quote_document.sections.footer", default: "Footer") %></h3>
          <%= simple_format(footer_note) %>
        </section>
      <% end %>
      <% if show_signature_section %>
        <section class="quote-section-block quote-signature-block quote-section-block--ending">
          <h3>Signature</h3>
          <% if signature_image_url.present? %>
            <p><img src="<%= signature_image_url %>" alt="Sales signature" class="quote-sales-signature-image"></p>
          <% end %>
          <% if signature_name.present? %>
            <p><strong>Authorized by:</strong> <%= signature_name %></p>
          <% end %>
        </section>
      <% end %>
    </section>
  <% end %>
  <% if @template.show_saas_branding %>
    <p class="quote-public-footnote"><%= @template.saas_branding_footer_text %></p>
  <% end %>
</article>
