<button type="button"
  class="theme-switch"
  data-action="theme#toggle"
  aria-label="切换深色模式"
  aria-pressed="false"
  title="切换深色模式">
  <span class="theme-switch__track" aria-hidden="true">
    <svg class="theme-switch__sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.5"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"/></svg>
    <svg class="theme-switch__moon" viewBox="0 0 24 24"><path d="M20 15.1A8.5 8.5 0 0 1 8.9 4a8.5 8.5 0 1 0 11.1 11.1Z"/></svg>
    <span class="theme-switch__thumb"></span>
  </span>
  <span class="sr-only" data-theme-label data-dark-label="切换深色模式" data-light-label="切换浅色模式">切换深色模式</span>
</button>
