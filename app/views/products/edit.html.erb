<section class="workspace-page workspace-page--editor">
  <header class="workspace-heading">
    <span class="eyebrow">Library / Products / Edit</span>
    <h1><%= @product.name %></h1>
    <p>Reusable source data for matching and quote preparation.</p>
  </header>

  <%= render "form",
             product: @product,
             submit_label: t("products.view.edit.submit_label"),
             back_path: @product,
             back_label: t("products.view.edit.back_to_product") %>
</section>
