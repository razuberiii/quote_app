<main class="deal-workspace library-page">
  <header class="deal-page-header">
    <div><p class="eyebrow"><%= t("self_service.library.eyebrow") %></p><h1><%= t("self_service.library.title") %></h1><p><%= t("self_service.library.subtitle") %></p></div>
    <div class="library-header-actions"><%= link_to t("self_service.library.import_catalog"), new_product_import_batch_path, class: "button button--secondary" %><%= link_to t("self_service.library.add_product"), new_product_path, class: "button button--primary" %></div>
  </header>
  <section class="ai-entry ai-entry--catalog"><div><span><%= t("self_service.library.ai_entry.signal") %></span><h2><%= t("self_service.library.ai_entry.title") %></h2><p><%= t("self_service.library.ai_entry.body") %></p></div><%= link_to t("self_service.library.ai_entry.action"), new_product_import_batch_path, class: "button button--primary" %></section>
  <nav class="library-tabs" aria-label="<%= t('self_service.library.navigation') %>"><% %w[products presets].each do |key| %><%= link_to t("self_service.library.tabs.#{key}"), library_path(section: key), class: ("is-active" if @section == key) %><% end %><%= link_to t("settings.document_design"), edit_document_design_path %></nav>
  <% if @section == "products" %>
    <section class="library-grid">
      <% @products.each do |product| %><%= link_to product_path(product), class: "library-product" do %>
        <div><% if product.display_image.present? %><%= image_tag product.display_image %><% else %><span><%= product.name.to_s.first %></span><% end %></div>
        <small><%= product.sku.presence || t("self_service.library.deal_ready") %></small><h2><%= product.name %></h2>
        <p><%= product.default_price.to_d.positive? ? "#{product.currency} #{number_with_delimiter(product.base_price)}" : t("self_service.library.price_required") %> · MOQ <%= product.moq.presence || "—" %></p>
      <% end %><% end %>
      <%= link_to new_product_path, class: "library-add" do %><span>＋</span><strong><%= t("self_service.library.add_to_library") %></strong><small><%= t("self_service.library.add_help") %></small><% end %>
    </section>
  <% elsif @section == "presets" %>
    <section class="library-resource-list">
      <header class="library-resource-heading"><div><p class="section-kicker"><%= t("self_service.library.presets.eyebrow") %></p><h2><%= t("self_service.library.presets.title") %></h2><p><%= t("self_service.library.presets.help") %></p></div><%= link_to t("self_service.library.presets.manage"), quote_presets_path, class: "button button--primary" %></header>
      <% @quote_presets.each do |resource| %><article><div><span><%= t("self_service.library.presets.type") %></span><strong><%= resource.name %></strong><small><%= t("self_service.library.presets.reuse") %></small></div><%= link_to t("self_service.library.edit"), edit_quote_preset_path(resource), class: "deal-next" %></article><% end %>
      <% if @quote_presets.empty? %><div class="library-empty"><h2><%= t("self_service.library.presets.empty") %></h2><p><%= t("self_service.library.presets.empty_help") %></p><%= link_to t("self_service.library.presets.create"), new_quote_preset_path, class: "button button--primary" %></div><% end %>
    </section>
  <% end %>
</main>
