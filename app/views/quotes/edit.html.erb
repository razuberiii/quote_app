<section class="app-page-shell">
  <header class="app-page-header">
    <div class="app-page-header-main">
      <h1>Edit Quote</h1>
      <p>Update quote <strong><%= @quote.quote_no %></strong> revision <strong>V<%= @quote.revision_number %></strong> without breaking the quote flow.</p>
    </div>
    <div class="app-page-header-actions">
      <%= quote_status_badge(@quote.status.presence || "draft") %>
    </div>
  </header>

  <%= render "form", quote: @quote, form_model: @quote %>

  <%= link_to "Back to Quote", @quote, class: "form-page-back-link form-page-back-link--quote" %>
</section>
