<section class="app-page-shell marketing-page-shell">
  <%= render "components/ui/card", class: "app-surface marketing-section-card" do %>
    <%= render "components/ui/section_header",
      kicker: t("landing.view.privacy.hero.kicker"),
      title: t("landing.view.privacy.hero.title"),
      body: t("landing.view.privacy.hero.body"),
      tag: :h1,
      title_class: "max-w-none" %>

    <div class="legal-copy">
      <p class="legal-copy__updated"><%= t("landing.view.privacy.last_updated") %></p>

      <section class="legal-section">
        <h2><%= t("landing.view.privacy.sections.data_collect.title") %></h2>
        <p><%= t("landing.view.privacy.sections.data_collect.body") %></p>
      </section>

      <section class="legal-section"><h2><%= t("landing.view.privacy.sections.data_use.title") %></h2><p><%= t("landing.view.privacy.sections.data_use.body") %></p>
      </section>

      <section class="legal-section"><h2><%= t("landing.view.privacy.sections.data_share.title") %></h2><p><%= t("landing.view.privacy.sections.data_share.body") %></p>
      </section>

      <section class="legal-section"><h2><%= t("landing.view.privacy.sections.retention.title") %></h2><p><%= t("landing.view.privacy.sections.retention.body") %></p>
      </section>

      <section class="legal-section"><h2><%= t("landing.view.privacy.sections.contact.title") %></h2><p><%= t("landing.view.privacy.sections.contact.body") %></p>
      </section>
    </div>
  <% end %>
</section>
