<h1>Edit Customer: <%= @customer.name %></h1>

<%= form_with model: @customer do |f| %>
  <div>
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :country %>
    <%= f.text_field :country %>
  </div>

  <div>
    <%= f.label :address %>
    <%= f.text_field :address %>
  </div>

  <div>
    <%= f.label :contact_name %>
    <%= f.text_field :contact_name %>
  </div>

  <div>
    <%= f.label :email %>
    <%= f.email_field :email %>
  </div>

  <div>
    <%= f.label :phone %>
    <%= f.text_field :phone %>
  </div>

  <div>
    <%= f.label :status %>
    <%= f.select :status, ['potential', 'following', 'closed', 'paused'], { prompt: 'Select Status' } %>
  </div>

  <div>
    <%= f.label :next_follow_up_date %>
    <%= f.date_field :next_follow_up_date %>
  </div>

  <div>
    <%= f.label :last_follow_up_date %>
    <%= f.date_field :last_follow_up_date %>
  </div>

  <div>
    <%= f.label :notes %>
    <%= f.text_area :notes, rows: 4 %>
  </div>

  <div>
    <%= f.submit "Update Customer" %>
  </div>
<% end %>

<%= link_to "Back to Customer", @customer, class: "form-page-back-link" %>
