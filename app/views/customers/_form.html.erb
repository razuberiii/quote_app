<%= form_with model: customer, html: { class: "customer-profile-form", multipart: true } do |f| %>
  <% status_options = Customer::SALES_STATUSES.map { |value| [t("customers.view.form.status_options.#{value}", default: value.humanize), value] } %>
  <% common_country_calling_code_options = [
    ["+1 USA/Canada", "+1"],
    ["+33 France", "+33"],
    ["+34 Spain", "+34"],
    ["+44 UK", "+44"],
    ["+49 Germany", "+49"],
    ["+52 Mexico", "+52"],
    ["+54 Argentina", "+54"],
    ["+55 Brazil", "+55"],
    ["+56 Chile", "+56"],
    ["+57 Colombia", "+57"],
    ["+60 Malaysia", "+60"],
    ["+62 Indonesia", "+62"],
    ["+65 Singapore", "+65"],
    ["+66 Thailand", "+66"],
    ["+81 Japan", "+81"],
    ["+82 South Korea", "+82"],
    ["+84 Vietnam", "+84"],
    ["+86 China", "+86"],
    ["+90 Turkey", "+90"],
    ["+91 India", "+91"],
    ["+971 UAE", "+971"]
  ] %>
  <% if customer.phone_country_code.present? && common_country_calling_code_options.none? { |(_, value)| value == customer.phone_country_code } %>
    common_country_calling_code_options.unshift([customer.phone_country_code, customer.phone_country_code])
  <% end %>
  <% if customer.status.present? && !Customer::SALES_STATUSES.include?(customer.status) %>
    <% legacy_status_label = t("customers.view.form.status_options.#{customer.status}", default: customer.status.humanize) %>
    <% status_options.unshift([t("customers.view.form.legacy_status", status: legacy_status_label), customer.status]) %>
  <% end %>

  <% level_options = Customer::CUSTOMER_LEVELS.map { |value| [t("customers.view.form.level_options.#{value}", default: value.humanize), value] } %>
  <% source_options = Customer::CUSTOMER_SOURCES.map { |value| [t("customers.view.form.source_options.#{value}", default: value.humanize), value] } %>
  <% payment_options = Customer::PAYMENT_TERMS_OPTIONS.map { |value| [t("customers.view.form.payment_options.#{value}", default: value.upcase.gsub("_", "/")), value] } %>
  <% owner_users = (@owner_users || []) %>
  <% selected_owner = owner_users.find { |user| user.id == customer.internal_owner_id } if Customer.internal_owner_enabled? %>
  <% timezone_options = time_zone_options_for_select %>

  <% selected_tags = customer.ordered_customer_tags %>
  <% selected_tag_ids = selected_tags.map(&:id) %>
  <% selected_tag_names = selected_tags.map(&:name) %>
  <% selected_tagging_id_by_tag_id = customer.customer_taggings.index_by(&:customer_tag_id).transform_values(&:id) %>
  <% initial_custom_tags = Array(params.dig(:customer, :new_tag_names)).reject(&:blank?) %>
  <% initial_custom_tags += params.dig(:customer, :custom_tags_input).to_s.split(",") %>
  <% initial_custom_tags = initial_custom_tags.map { |tag| tag.to_s.strip }.reject(&:blank?).uniq %>
  <% selected_tag_names = (Array(params.dig(:customer, :tag_priority_names)).reject(&:blank?) + selected_tag_names + initial_custom_tags).map { |tag| tag.to_s.strip }.reject(&:blank?).uniq %>

  <% if customer.errors.any? %>
    <div class="error-messages">
      <h2><%= t("customers.view.form.error_summary", count: customer.errors.count) %></h2>
      <ul>
        <% customer.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="customer-profile-shell">
    <section class="customer-profile-section customer-profile-identity">
      <div class="customer-profile-section-head">
        <h3><%= t("customers.view.form.company_information") %></h3>
        <p class="app-form-section-note"><%= t("customers.view.form.company_information_hint") %></p>
      </div>
      <div class="customer-identity-grid">
        <div class="customer-avatar-panel">
          <div class="customer-avatar-preview">
            <% has_avatar = customer.avatar.attached? && customer.avatar.blob&.persisted? %>
            <% if has_avatar %>
              <%= image_tag customer.avatar, alt: t("customers.view.form.customer_avatar_alt", name: customer.name), id: "customer_avatar_preview_img" %>
            <% else %>
              <%= tag.img id: "customer_avatar_preview_img", alt: t("customers.view.form.customer_avatar_alt", name: customer.name), hidden: true %>
            <% end %>
            <span id="customer_avatar_preview_fallback" <%= "hidden" if has_avatar %>><%= customer.avatar_initial %></span>
          </div>
          <div class="customer-avatar-fields">
            <%= f.label :avatar, t("customers.view.form.avatar") %>
            <%= f.file_field :avatar, accept: "image/*", data: { live_preview_target: "#customer_avatar_preview_img", live_preview_fallback: "#customer_avatar_preview_fallback" } %>
            <% if customer.avatar.attached? %>
              <label class="customer-avatar-remove"><%= check_box_tag "customer[remove_avatar]", "1", false %> <%= t("customers.view.form.remove_current_avatar") %></label>
            <% end %>
          </div>
        </div>

        <div class="customer-identity-fields">
          <div class="customer-profile-grid customer-profile-grid-2">
            <div class="customer-name-field">
              <%= f.label :name, t("customers.view.form.company_name") %>
              <%= f.text_field :name, placeholder: t("customers.view.form.company_name"), required: true, class: ui_input_classes("customer-name-input") %>
            </div>
            <div>
              <%= f.label :country, t("customers.view.form.country") %>
              <%= f.text_field :country, placeholder: t("customers.view.form.country"), class: ui_input_classes %>
            </div>
            <div>
              <%= f.label :status, t("customers.view.form.status") %>
              <div class="customer-status-select-wrap">
                <%= f.select :status, status_options, { prompt: t("customers.view.form.select_status") }, { class: ui_input_classes } %>
                <% if customer.status.present? %>
                  <%= customer_status_badge(customer) %>
                <% end %>
              </div>
            </div>
            <div>
              <%= f.label :customer_level, t("customers.view.form.customer_level") %>
              <%= f.select :customer_level, level_options, { include_blank: false }, { class: ui_input_classes } %>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="customer-profile-section">
      <div class="customer-profile-section-head">
        <h3><%= t("customers.view.form.primary_contact") %></h3>
        <p class="app-form-section-note"><%= t("customers.view.form.primary_contact_hint") %></p>
      </div>
      <div class="customer-profile-grid customer-profile-grid-2">
        <div>
          <%= f.label :contact_name, t("customers.view.form.primary_contact_name") %>
          <%= f.text_field :contact_name, placeholder: t("customers.view.form.primary_contact_name"), class: ui_input_classes %>
        </div>
        <div>
          <%= f.label :email, t("customers.view.form.email") %>
          <%= f.email_field :email, placeholder: t("customers.view.form.email"), class: ui_input_classes %>
        </div>
        <div>
          <%= f.label :phone_country_code, t("customers.view.form.phone_country_code", default: "Country Code") %>
          <%= f.select :phone_country_code,
                       options_for_select(common_country_calling_code_options, customer.phone_country_code),
                       { include_blank: t("customers.view.form.select_phone_country_code", default: "Select common country code") },
                       { class: ui_input_classes, data: { searchable_select: true, search_placeholder: t("customers.view.form.select_phone_country_code", default: "Select common country code") } } %>
        </div>
        <div>
          <%= f.label :phone, t("customers.view.form.phone") %>
          <%= f.text_field :phone, placeholder: t("customers.view.form.phone"), class: ui_input_classes %>
        </div>
        <div>
          <%= f.label :tax_id_type, t("customers.view.form.tax_id_type", default: "Tax ID Type") %>
          <% tax_id_type_options = Customer::TAX_ID_TYPES.map { |v| [v, v] } %>
          <%= f.select :tax_id_type, tax_id_type_options, { prompt: t("customers.view.form.select_tax_id_type", default: "Select type (optional)") }, { class: ui_input_classes } %>
        </div>
        <div>
          <%= f.label :tax_id, t("customers.view.form.tax_id", default: "Tax ID") %>
          <%= f.text_field :tax_id, placeholder: t("customers.view.form.tax_id_placeholder", default: "e.g. XAXX010101000"), class: ui_input_classes %>
        </div>
        <div>
          <%= f.label :payment_terms, t("customers.view.form.payment_terms") %>
          <%= f.select :payment_terms, payment_options, { prompt: t("customers.view.form.select_payment_terms") }, { class: ui_input_classes } %>
        </div>
        <div>
          <%= f.label :customer_source, t("customers.view.form.source") %>
          <%= f.select :customer_source, source_options, { prompt: t("customers.view.form.select_source") }, { class: ui_input_classes } %>
        </div>
        <div>
          <%= f.label :main_product_interest, t("customers.view.form.main_product_interest") %>
          <%= f.text_field :main_product_interest, placeholder: t("customers.view.form.main_product_interest_placeholder"), class: ui_input_classes %>
        </div>
        <% if Customer.internal_owner_enabled? %>
          <div>
            <label for="customer_internal_owner_id"><%= t("customers.view.form.internal_owner") %></label>
            <div class="owner-picker" data-owner-picker>
              <%= hidden_field_tag "customer[internal_owner_id]", customer.internal_owner_id, id: "customer_internal_owner_id" %>
              <button type="button" class="owner-picker-trigger" data-owner-trigger>
                <span class="owner-picker-avatar">
                  <% selected_owner_avatar_url = selected_owner&.avatar&.attached? && selected_owner.avatar.blob&.persisted? ? url_for(selected_owner.avatar) : nil %>
                  <img src="<%= selected_owner_avatar_url %>" alt="<%= t("customers.view.form.owner_avatar_alt") %>" data-owner-selected-avatar <%= "hidden" if selected_owner_avatar_url.blank? %>>
                  <span data-owner-selected-initial <%= "hidden" if selected_owner_avatar_url.present? %>><%= (selected_owner&.full_name.presence || selected_owner&.email || "?").to_s.first.to_s.upcase %></span>
                </span>
                <span class="owner-picker-meta">
                  <strong data-owner-selected-name><%= selected_owner&.full_name.presence || selected_owner&.email || t("customers.view.form.select_internal_owner") %></strong>
                  <small data-owner-selected-email><%= selected_owner&.email || t("customers.view.form.choose_team_owner") %></small>
                </span>
              </button>
              <div class="owner-picker-menu" data-owner-menu hidden>
                <% owner_users.each do |user| %>
                  <button
                    type="button"
                    class="owner-picker-option"
                    data-owner-option
                    data-owner-id="<%= user.id %>"
                    data-owner-name="<%= user.full_name.presence || user.email %>"
                    data-owner-email="<%= user.email %>"
                    data-owner-avatar-src="<%= user.avatar.attached? && user.avatar.blob&.persisted? ? url_for(user.avatar) : "" %>"
                  >
                    <span class="owner-picker-avatar">
                      <% if user.avatar.attached? && user.avatar.blob&.persisted? %>
                        <%= image_tag user.avatar, alt: t("customers.view.form.owner_avatar_alt") %>
                      <% else %>
                        <span><%= (user.full_name.presence || user.email).to_s.first.to_s.upcase %></span>
                      <% end %>
                    </span>
                    <span class="owner-picker-meta">
                      <strong><%= user.full_name.presence || user.email %></strong>
                      <small><%= user.email %></small>
                    </span>
                  </button>
                <% end %>
              </div>
            </div>
            <p class="customer-field-hint"><%= t("customers.view.form.owner_hint") %></p>
          </div>
        <% end %>
        <div>
          <%= f.label :next_follow_up_date, t("customers.view.form.follow_up_date") %>
          <%= f.date_field :next_follow_up_date, class: ui_input_classes %>
        </div>
      </div>
    </section>

    <section class="customer-profile-section">
      <div class="customer-profile-section-head">
        <h3><%= t("customers.view.form.additional_information") %></h3>
        <p class="app-form-section-note"><%= t("customers.view.form.additional_information_hint") %></p>
      </div>
      <div class="customer-profile-grid customer-profile-grid-2">
        <div class="customer-grid-span-2">
          <%= f.label :address, t("customers.view.form.address") %>
          <%= f.text_area :address, rows: 2, placeholder: t("customers.view.form.address"), class: ui_input_classes %>
        </div>
        <div>
          <%= f.label :estimated_annual_volume, t("customers.view.form.estimated_annual_volume") %>
          <%= f.number_field :estimated_annual_volume, step: 0.01, min: 0, placeholder: "0.00", class: ui_input_classes %>
        </div>
        <div>
          <%= f.label :timezone, t("customers.view.form.timezone") %>
          <%= f.select :timezone,
                       timezone_options,
                       { prompt: t("customers.view.form.select_timezone") },
                       { class: ui_input_classes, data: { searchable_select: true, searchable_kind: "timezone", search_placeholder: t("customers.view.form.search_timezone_placeholder"), phone_field: "#customer_phone" } } %>
        </div>

        <div class="customer-grid-span-2">
          <label><%= t("customers.view.form.tags") %></label>
          <p class="customer-field-hint customer-tag-cloud-hint"><%= t("customers.view.form.drag_priority_hint") %></p>
          <div class="customer-tag-priority customer-tag-priority-hidden" data-tag-priority>
            <div class="customer-tag-priority-list" data-tag-priority-list>
              <% selected_tag_names.each do |tag_name| %>
                <div class="customer-tag-priority-item" data-tag-priority-item data-tag-name="<%= tag_name %>" draggable="true">
                  <span class="customer-tag-priority-name"><%= tag_name %></span>
                  <div class="customer-tag-priority-actions">
                    <button type="button" class="<%= ui_button_classes(:secondary, 'customer-tag-priority-btn customer-tag-priority-remove') %>" data-tag-remove><%= t("customers.view.form.remove") %></button>
                  </div>
                  <%= hidden_field_tag "customer[tag_priority_names][]", tag_name, data: { tag_priority_hidden: true } %>
                </div>
              <% end %>
            </div>
          </div>
          <div class="customer-tag-cloud"
               data-controller="sortable"
               data-sortable-enabled-value="true"
               data-sortable-url-value="<%= customer.persisted? ? reorder_tags_customer_path(customer) : "" %>">
            <% (@available_tags || []).each do |tag| %>
              <label class="customer-tag-chip <%= "is-selected" if selected_tag_ids.include?(tag.id) %>" data-tag-chip data-id="<%= selected_tagging_id_by_tag_id[tag.id] %>">
                <%= check_box_tag "customer[customer_tag_ids][]", tag.id, selected_tag_ids.include?(tag.id), id: "customer_tag_#{tag.id}" %>
                <span data-tag-name="<%= tag.name %>"><%= tag.name %></span>
                <button type="button" class="customer-tag-delete-btn" data-tag-delete aria-label="<%= t("customers.view.form.remove") %>">×</button>
              </label>
            <% end %>
          </div>
          <div class="customer-tag-custom" data-customer-tag-builder>
            <input type="text" placeholder="<%= t("customers.view.form.add_custom_tag_placeholder") %>" data-custom-tag-input class="<%= ui_input_classes %>">
            <button type="button" class="<%= ui_button_classes(:secondary) %>" data-add-custom-tag><%= t("customers.view.form.add") %></button>
            <div class="customer-tag-custom-list" data-custom-tag-list>
              <% initial_custom_tags.each do |tag_name| %>
                <span class="customer-tag-chip customer-tag-chip-custom" data-custom-tag-name="<%= tag_name %>"><%= tag_name %></span>
                <%= hidden_field_tag "customer[new_tag_names][]", tag_name, data: { custom_tag_hidden: tag_name } %>
              <% end %>
            </div>
            <p class="customer-field-hint"><%= t("customers.view.form.tags_hint") %></p>
          </div>
        </div>

        <div class="customer-grid-span-2">
          <%= f.label :notes, t("customers.view.form.notes") %>
          <%= f.text_area :notes, rows: 4, placeholder: t("customers.view.form.notes"), class: ui_input_classes %>
        </div>
      </div>
    </section>

    <div class="customer-form-submit">
      <%= f.submit submit_label, class: ui_button_classes(:primary) %>
    </div>
  </div>
<% end %>

<script>
  (() => {
    const tagRemoveLabel = "<%= j t("customers.view.form.remove") %>";
    const selectInternalOwnerLabel = "<%= j t("customers.view.form.select_internal_owner") %>";
    const chooseTeamOwnerLabel = "<%= j t("customers.view.form.choose_team_owner") %>";

    const bindPhoneCountryCodePreset = () => {
      document.querySelectorAll("[data-phone-country-code-preset]").forEach((presetSelect) => {
        if (presetSelect.dataset.boundPhoneCode === "true") return;
        presetSelect.dataset.boundPhoneCode = "true";

        const targetSelector = presetSelect.dataset.targetInput;
        const targetInput = targetSelector ? document.querySelector(targetSelector) : null;
        if (!targetInput) return;

        const syncPresetFromInput = () => {
          const raw = (targetInput.value || "").trim();
          const option = Array.from(presetSelect.options).find((opt) => opt.value === raw);
          presetSelect.value = option ? raw : "";
        };

        presetSelect.addEventListener("change", () => {
          if (!presetSelect.value) return;
          targetInput.value = presetSelect.value;
        });

        targetInput.addEventListener("input", syncPresetFromInput);
        syncPresetFromInput();
      });
    };

    const bindTagPriority = () => {
      document.querySelectorAll("[data-tag-priority]").forEach((priorityRoot) => {
        if (priorityRoot.dataset.bound === "true") return;
        priorityRoot.dataset.bound = "true";

        const form = priorityRoot.closest("form");
        const list = priorityRoot.querySelector("[data-tag-priority-list]");
        if (!form || !list) return;

        const tagLabel = (name) => {
          const wrapper = document.createElement("div");
          wrapper.className = "customer-tag-priority-item";
          wrapper.dataset.tagPriorityItem = "true";
          wrapper.dataset.tagName = name;
          wrapper.draggable = true;
          wrapper.innerHTML = `
            <span class="customer-tag-priority-name"></span>
            <div class="customer-tag-priority-actions">
              <button type="button" class="app-ui-button app-ui-button--secondary customer-tag-priority-btn customer-tag-priority-remove" data-tag-remove>${tagRemoveLabel}</button>
            </div>
          `;
          wrapper.querySelector(".customer-tag-priority-name").textContent = name;
          const hidden = document.createElement("input");
          hidden.type = "hidden";
          hidden.name = "customer[tag_priority_names][]";
          hidden.value = name;
          hidden.dataset.tagPriorityHidden = "true";
          wrapper.appendChild(hidden);
          return wrapper;
        };

        const findCheckboxByName = (name) =>
          Array.from(form.querySelectorAll("[data-tag-chip] input[type='checkbox']")).find((input) => {
            const chipName = input.parentElement?.querySelector("[data-tag-name]")?.dataset.tagName;
            return chipName === name;
          });

        const appendPriorityTag = (name) => {
          const normalized = name.trim();
          if (!normalized) return;
          const exists = Array.from(list.querySelectorAll("[data-tag-priority-item]"))
            .some((item) => item.dataset.tagName === normalized);
          if (exists) return;

          list.appendChild(tagLabel(normalized));
        };

        const removePriorityTag = (name) => {
          list.querySelectorAll("[data-tag-priority-item]").forEach((item) => {
            if (item.dataset.tagName === name) item.remove();
          });
        };

        const getDropAfterElement = (container, y) => {
          const candidates = [ ...container.querySelectorAll("[data-tag-priority-item]:not(.is-dragging)") ];
          return candidates.reduce((closest, child) => {
            const rect = child.getBoundingClientRect();
            const offset = y - rect.top - rect.height / 2;
            if (offset < 0 && offset > closest.offset) {
              return { offset, element: child };
            }
            return closest;
          }, { offset: Number.NEGATIVE_INFINITY, element: null }).element;
        };

        list.addEventListener("dragstart", (event) => {
          const item = event.target.closest("[data-tag-priority-item]");
          if (!item) return;
          item.classList.add("is-dragging");
          if (event.dataTransfer) {
            event.dataTransfer.effectAllowed = "move";
            event.dataTransfer.setData("text/plain", item.dataset.tagName || "");
          }
        });

        list.addEventListener("dragend", (event) => {
          const item = event.target.closest("[data-tag-priority-item]");
          if (!item) return;
          item.classList.remove("is-dragging");
        });

        list.addEventListener("dragover", (event) => {
          event.preventDefault();
          const dragging = list.querySelector("[data-tag-priority-item].is-dragging");
          if (!dragging) return;

          const afterElement = getDropAfterElement(list, event.clientY);
          if (!afterElement) {
            list.appendChild(dragging);
          } else {
            list.insertBefore(dragging, afterElement);
          }
        });

        form.querySelectorAll("[data-tag-chip] input[type='checkbox']").forEach((input) => {
          const name = input.parentElement?.querySelector("[data-tag-name]")?.dataset.tagName;
          if (!name) return;
          input.addEventListener("change", () => {
            if (input.checked) {
              appendPriorityTag(name);
            } else {
              removePriorityTag(name);
            }
          });
        });

        list.addEventListener("click", (event) => {
          const item = event.target.closest("[data-tag-priority-item]");
          if (!item) return;

          if (event.target.closest("[data-tag-remove]")) {
            const name = item.dataset.tagName;
            item.remove();
            const checkbox = findCheckboxByName(name);
            if (checkbox) checkbox.checked = false;
            if (!checkbox) {
              const builderOwner = priorityRoot.parentElement;
              builderOwner?.querySelectorAll("[data-custom-tag-name]").forEach((chip) => {
                if (chip.dataset.customTagName === name) chip.remove();
              });
              builderOwner?.querySelectorAll("input[data-custom-tag-hidden]").forEach((hidden) => {
                if (hidden.dataset.customTagHidden === name) hidden.remove();
              });
            }
            return;
          }
        });

        list.querySelectorAll("[data-tag-priority-item]").forEach((item) => {
          const checkbox = findCheckboxByName(item.dataset.tagName);
          if (checkbox) checkbox.checked = true;
        });
      });
    };

    const bindTagChipPrioritySort = () => {
      document.querySelectorAll(".customer-grid-span-2").forEach((section) => {
        const cloud = section.querySelector(".customer-tag-cloud");
        const priorityList = section.querySelector("[data-tag-priority-list]");
        if (!cloud || !priorityList || cloud.dataset.boundTagSort === "true") return;
        cloud.dataset.boundTagSort = "true";

        const syncPriorityOrderFromCloud = () => {
          const selectedNames = Array.from(cloud.querySelectorAll("[data-tag-chip]"))
            .map((chip) => {
              const input = chip.querySelector("input[type='checkbox']");
              const name = chip.querySelector("[data-tag-name]")?.dataset.tagName;
              if (!input?.checked || !name) return null;
              return name;
            })
            .filter(Boolean);

          selectedNames.forEach((name) => {
            const item = Array.from(priorityList.querySelectorAll("[data-tag-priority-item]"))
              .find((node) => node.dataset.tagName === name);
            if (item) priorityList.appendChild(item);
          });
        };

        const syncChipState = (chip) => {
          const input = chip.querySelector("input[type='checkbox']");
          const selected = !!input?.checked;
          chip.classList.toggle("is-selected", selected);
        };

        const refreshChipStates = () => {
          cloud.querySelectorAll("[data-tag-chip]").forEach((chip) => syncChipState(chip));
          syncPriorityOrderFromCloud();
        };

        cloud.addEventListener("change", (event) => {
          const input = event.target.closest("input[type='checkbox']");
          if (!input) return;
          const chip = input.closest("[data-tag-chip]");
          if (chip) syncChipState(chip);
          syncPriorityOrderFromCloud();
        });

        cloud.addEventListener("click", (event) => {
          const removeBtn = event.target.closest("[data-tag-delete]");
          if (!removeBtn) return;
          event.preventDefault();
          event.stopPropagation();

          const chip = removeBtn.closest("[data-tag-chip]");
          const input = chip?.querySelector("input[type='checkbox']");
          if (!chip || !input) return;

          if (input.checked) {
            input.checked = false;
            input.dispatchEvent(new Event("change", { bubbles: true }));
          }

          chip.remove();
          syncPriorityOrderFromCloud();
        });

        cloud.addEventListener("sortable:reordered", () => {
          syncPriorityOrderFromCloud();
        });

        refreshChipStates();
      });
    };

    const bindCustomTagBuilder = () => {
      document.querySelectorAll("[data-customer-tag-builder]").forEach((builder) => {
        if (builder.dataset.bound === "true") return;
        builder.dataset.bound = "true";

        const input = builder.querySelector("[data-custom-tag-input]");
        const addBtn = builder.querySelector("[data-add-custom-tag]");
        const list = builder.querySelector("[data-custom-tag-list]");
        const priority = builder.parentElement?.querySelector("[data-tag-priority-list]");
        if (!input || !addBtn || !list) return;

        const existing = () =>
          Array.from(list.querySelectorAll("input[name='customer[new_tag_names][]']"))
            .map((node) => node.value.toLowerCase().trim());

        const appendTag = (rawValue) => {
          const value = rawValue.trim();
          if (!value) return;
          if (existing().includes(value.toLowerCase())) {
            input.value = "";
            return;
          }

          const chip = document.createElement("span");
          chip.className = "customer-tag-chip customer-tag-chip-custom";
          chip.dataset.customTagName = value;
          chip.textContent = value;

          const hidden = document.createElement("input");
          hidden.type = "hidden";
          hidden.name = "customer[new_tag_names][]";
          hidden.value = value;
          hidden.dataset.customTagHidden = value;

          list.appendChild(chip);
          list.appendChild(hidden);
          if (priority) {
            const existingPriority = Array.from(priority.querySelectorAll("[data-tag-priority-item]"))
              .some((node) => node.dataset.tagName === value);
            if (!existingPriority) {
              const item = document.createElement("div");
              item.className = "customer-tag-priority-item";
              item.dataset.tagPriorityItem = "true";
              item.dataset.tagName = value;
              item.draggable = true;
              item.innerHTML = `
                <span class="customer-tag-priority-name"></span>
                <div class="customer-tag-priority-actions">
                  <button type="button" class="app-ui-button app-ui-button--secondary customer-tag-priority-btn customer-tag-priority-remove" data-tag-remove>${tagRemoveLabel}</button>
                </div>
              `;
              item.querySelector(".customer-tag-priority-name").textContent = value;
              const orderHidden = document.createElement("input");
              orderHidden.type = "hidden";
              orderHidden.name = "customer[tag_priority_names][]";
              orderHidden.value = value;
              orderHidden.dataset.tagPriorityHidden = "true";
              item.appendChild(orderHidden);
              priority.appendChild(item);
            }
          }
          input.value = "";
        };

        addBtn.addEventListener("click", () => appendTag(input.value));
        input.addEventListener("keydown", (event) => {
          if (event.key !== "Enter") return;
          event.preventDefault();
          appendTag(input.value);
        });
      });
    };

    const bindOwnerPicker = () => {
      document.querySelectorAll("[data-owner-picker]").forEach((picker) => {
        if (picker.dataset.boundOwner === "true") return;
        picker.dataset.boundOwner = "true";

        const trigger = picker.querySelector("[data-owner-trigger]");
        const menu = picker.querySelector("[data-owner-menu]");
        const hidden = picker.querySelector("#customer_internal_owner_id");
        const selectedName = picker.querySelector("[data-owner-selected-name]");
        const selectedEmail = picker.querySelector("[data-owner-selected-email]");
        const selectedInitial = picker.querySelector("[data-owner-selected-initial]");
        const selectedAvatar = picker.querySelector("[data-owner-selected-avatar]");
        if (!trigger || !menu || !hidden || !selectedName || !selectedEmail) return;

        const closeMenu = () => { menu.hidden = true; };
        const openMenu = () => { menu.hidden = false; };

        trigger.addEventListener("click", () => {
          menu.hidden ? openMenu() : closeMenu();
        });

        picker.querySelectorAll("[data-owner-option]").forEach((option) => {
          option.addEventListener("click", () => {
            hidden.value = option.dataset.ownerId || "";
            selectedName.textContent = option.dataset.ownerName || selectInternalOwnerLabel;
            selectedEmail.textContent = option.dataset.ownerEmail || chooseTeamOwnerLabel;
            if (selectedInitial) {
              selectedInitial.textContent = (option.dataset.ownerName || "?").trim().charAt(0).toUpperCase();
            }
            if (selectedAvatar && selectedInitial) {
              const avatarSrc = option.dataset.ownerAvatarSrc || "";
              if (avatarSrc) {
                selectedAvatar.src = avatarSrc;
                selectedAvatar.hidden = false;
                selectedInitial.hidden = true;
              } else {
                selectedAvatar.src = "";
                selectedAvatar.hidden = true;
                selectedInitial.hidden = false;
              }
            }
            closeMenu();
          });
        });

        document.addEventListener("click", (event) => {
          if (!picker.contains(event.target)) closeMenu();
        });
      });
    };

    bindCustomTagBuilder();
    bindTagPriority();
    bindTagChipPrioritySort();
    bindOwnerPicker();
    bindPhoneCountryCodePreset();
    document.addEventListener("turbo:load", bindTagPriority);
    document.addEventListener("turbo:load", bindCustomTagBuilder);
    document.addEventListener("turbo:load", bindTagChipPrioritySort);
    document.addEventListener("turbo:load", bindOwnerPicker);
    document.addEventListener("turbo:load", bindPhoneCountryCodePreset);
  })();
</script>
