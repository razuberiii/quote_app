<% contact_email = @contact_email || ContactMailer.contact_email_for_environment %>
<section class="marketing-section marketing-contact" id="contact-us">
  <div class="marketing-section-head">
    <h2>Contact Us</h2>
    <p>Tell us your team size and current quoting workflow.</p>
    <p style="margin-top: 12px; font-size: 0.95em; color: #666;">Built for teams who need clear revision control and buyer visibility.</p>
  </div>

  <%= form_with model: (@contact_request || ContactRequest.new), url: contact_requests_path, local: true, class: "marketing-contact-form", id: "contact-form" do |f| %>
    <%= f.hidden_field :website, value: "", autocomplete: "off" %>
    <div class="marketing-contact-grid">
      <div>
        <%= f.label :name, "Name" %>
        <%= f.text_field :name, required: true %>
      </div>
      <div>
        <%= f.label :email, "Email" %>
        <%= f.email_field :email, required: true %>
      </div>
      <div>
        <%= f.label :company, "Company" %>
        <%= f.text_field :company, required: true %>
      </div>
      <div class="marketing-contact-message-wrap">
        <%= f.label :message, "Message" %>
        <%= f.text_area :message, rows: 5, required: true, placeholder: "Share your quote process, team setup, and rollout timeline." %>
      </div>
    </div>
    
    <% unless ENV["SKIP_TURNSTILE_VERIFICATION"] == "true" %>
      <%= f.hidden_field :cf_turnstile_response, value: "", id: "cf_turnstile_response_contact" %>
    <% end %>

    <div class="marketing-contact-actions">
      <%= f.submit "Send Message", class: "btn btn-primary", id: "contact-submit-btn" %>
      <span>or <%= mail_to contact_email, "email us directly", subject: "Rubusoo Inquiry" %></span>
    </div>
  <% end %>

  <!-- Verification Modal -->
  <% unless ENV["SKIP_TURNSTILE_VERIFICATION"] == "true" %>
    <div id="verification-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 9999; justify-content: center; align-items: center; padding: 20px;">
      <div style="background: white; padding: 30px; border-radius: 12px; max-width: 100%; width: 90%; max-width: 380px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); max-height: 90vh; overflow-y: auto;">
        <h3 style="margin: 0 0 10px 0; text-align: center; color: #333;">Security Verification</h3>
        <p style="margin: 0 0 20px 0; text-align: center; color: #666; font-size: 14px;">Please complete the verification to continue</p>
        
        <div id="turnstile-loading" style="text-align: center; padding: 20px 0; color: #999;">
          <p>Loading verification...</p>
        </div>
        
        <div id="turnstile-container" style="display: none; text-align: center; overflow-x: auto;">
          <div class="cf-turnstile"></div>
        </div>
        
        <div id="turnstile-success" style="display: none; text-align: center; padding: 20px 0;">
          <p style="color: #28a745; font-size: 16px; margin: 0;">✓ Verified! Submitting...</p>
        </div>
      </div>
    </div>
  <% end %>

  <script>
    function initializeContactForm() {
      const contactForm = document.getElementById('contact-form');
      const submitBtn = document.getElementById('contact-submit-btn');
      const modal = document.getElementById('verification-modal');
      const turnstileResponse = document.getElementById('cf_turnstile_response_contact');
      const loadingDiv = document.getElementById('turnstile-loading');
      const containerDiv = document.getElementById('turnstile-container');
      const successDiv = document.getElementById('turnstile-success');
      
      // Make sure all elements exist
      if (!contactForm || !submitBtn || !modal || !turnstileResponse) {
        return;
      }

      // Clear any old token and state
      turnstileResponse.value = '';
      let verificationComplete = false;
      let isSubmitting = false;

      // Prevent form submission if already submitting
      contactForm.addEventListener('submit', function(e) {
        if (isSubmitting) {
          e.preventDefault();
          return false;
        }
      });

      submitBtn.addEventListener('click', function(e) {
        e.preventDefault();
        
        // Prevent double-submission
        if (isSubmitting) {
          return;
        }
        
        // If verification already complete and we have a fresh token, submit immediately
        if (verificationComplete && turnstileResponse.value) {
          isSubmitting = true;
          submitBtn.disabled = true;
          submitBtn.textContent = 'Sending...';
          contactForm.submit();
          return;
        }

        // Reset and show modal
        verificationComplete = false;
        turnstileResponse.value = ''; // Clear any old token
        submitBtn.disabled = true; // CRITICAL: Disable button immediately when opening modal
        modal.style.display = 'flex';
        loadingDiv.style.display = 'block';
        containerDiv.style.display = 'none';
        successDiv.style.display = 'none';
        
        // Wait for Turnstile API to load, then render
        setTimeout(renderTurnstile, 300);
      });

      function renderTurnstile() {
        if (typeof turnstile === 'undefined') {
          // API not loaded yet, retry
          setTimeout(renderTurnstile, 200);
          return;
        }

        // Hide loading, show container
        loadingDiv.style.display = 'none';
        containerDiv.style.display = 'block';

        const widget = containerDiv.querySelector('.cf-turnstile');
        
        // Clear any previous render
        if (widget.dataset.rendered === 'true') {
          widget.innerHTML = '';
          widget.removeAttribute('data-rendered');
        }

        turnstile.render(widget, {
          sitekey: '<%= ENV.fetch("TURNSTILE_SITE_KEY", "0x4AAAAAACkKXqa756rWhUr7") %>',
          theme: 'light',
          callback: function(token) {
            turnstileResponse.value = token;
            verificationComplete = true;
            
            // Show success message
            containerDiv.style.display = 'none';
            successDiv.style.display = 'block';
            
            // Auto-submit after 1 second
            setTimeout(() => {
              isSubmitting = true;
              modal.style.display = 'none';
              contactForm.submit();
            }, 1000);
          }
        });
        widget.dataset.rendered = 'true';
      }

      // Close modal on background click (only if verification isn't complete)
      modal.addEventListener('click', function(e) {
        if (e.target === modal && !verificationComplete) {
          modal.style.display = 'none';
          turnstileResponse.value = ''; // Clear incomplete verification
          submitBtn.disabled = false; // Re-enable button
          submitBtn.textContent = 'Send Message';
        }
      });

      // Restore button state on form reset
      contactForm.addEventListener('reset', function() {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Message';
        turnstileResponse.value = '';
        verificationComplete = false;
        isSubmitting = false;
      });
    }

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', initializeContactForm);
    // Re-initialize on Turbo navigation
    document.addEventListener('turbo:load', initializeContactForm);
  </script>
</section>

