<h2><%= t("email_verifications.mailer.title") %></h2>

<p><%= t("email_verifications.mailer.greeting", name: @user.full_name.presence || @user.email) %></p>

<p><%= t("email_verifications.mailer.intro") %></p>

<p>
  <strong style="display: inline-block; padding: 10px 16px; border-radius: 6px; letter-spacing: 0.2em; font-size: 1.1rem; background-color: #f3f5f9; color: #1F4E79;">
    <%= @verification_code %>
  </strong>
</p>

<p><%= t("email_verifications.mailer.code_hint") %></p>

<p><strong><%= t("email_verifications.mailer.expires_note", minutes: @validity_minutes) %></strong></p>

<p><%= t("email_verifications.mailer.ignore_note") %></p>

<p><%= t("email_verifications.mailer.signature_html") %></p>
