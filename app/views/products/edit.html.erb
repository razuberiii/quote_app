<h1>Edit Product: <%= @product.name %></h1>

<%= form_with model: @product do |f| %>
  <% if @product.errors.any? %>
    <div id="error_explanation" class="alert alert-danger">
      <h2><%= pluralize(@product.errors.count, "error") %> prohibited this product from being saved:</h2>
      <ul>
        <% @product.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :sku %>
    <%= f.text_field :sku, class: ("input-error" if @product.errors[:sku].any?) %>
    <% if @product.errors[:sku].any? %>
      <p class="field-error-message"><%= @product.errors.full_messages_for(:sku).first %></p>
    <% end %>
  </div>

  <div>
    <%= f.label :default_price, "Reference Price (for auto-fill only)" %>
    <%= f.number_field :default_price, step: 0.01 %>
  </div>

  <div>
    <%= f.label :price_currency, "Reference Price Currency" %>
    <%= f.select :price_currency, Product::PRICE_CURRENCIES, {}, {} %>
  </div>

  <div>
    <%= f.label :description %>
    <%= f.text_area :description, rows: 4 %>
  </div>

  <% if @product.image.attached? %>
    <div class="product-image-block">
      <p>Current display image:</p>
      <%= image_tag @product.image, class: "product-image-preview" %>
    </div>
  <% end %>

  <div>
    <%= f.label :gallery_images, "Upload More Images" %>
    <%= f.file_field :gallery_images, accept: "image/*", multiple: true, id: "product_gallery_images_edit", data: { has_display: @product.display_image.present? } %>
    <%= hidden_field_tag "product[primary_uploaded_image_index]", "", id: "product_primary_uploaded_image_index_edit" %>
    <div id="product_gallery_preview_edit" class="product-upload-preview" hidden></div>
  </div>

  <% if @product.gallery_images.attached? %>
    <div class="product-gallery-editor">
      <p>Gallery images (hover image to manage):</p>
      <div class="product-gallery-grid">
        <% @product.gallery_images.attachments.each do |attachment| %>
          <% is_current = @product.image.attached? && @product.image.blob_id == attachment.blob_id %>
          <div class="product-gallery-item">
            <div class="product-gallery-thumb-shell">
              <% if is_current %>
                <div class="product-gallery-thumb-wrap is-current">
                  <%= image_tag attachment, class: "product-gallery-thumb", alt: "Gallery image" %>
                </div>
              <% else %>
                <%= link_to set_primary_image_product_path(@product, attachment_id: attachment.id), data: { turbo_method: :patch }, class: "product-gallery-thumb-wrap", title: "Set as display image" do %>
                  <%= image_tag attachment, class: "product-gallery-thumb", alt: "Gallery image" %>
                <% end %>
              <% end %>

              <div class="product-gallery-hover-actions">
                <% unless is_current %>
                  <%= link_to "Set Display",
                              set_primary_image_product_path(@product, attachment_id: attachment.id),
                              data: { turbo_method: :patch },
                              class: "product-gallery-hover-btn product-gallery-hover-btn-primary" %>
                <% end %>
                <%= link_to "Delete",
                            remove_gallery_image_product_path(@product, attachment_id: attachment.id),
                            data: { turbo_method: :delete, turbo_confirm: "Delete this image?" },
                            class: "product-gallery-hover-btn product-gallery-hover-btn-danger" %>
              </div>
            </div>

            <% if is_current %>
              <span class="product-gallery-status">Current display</span>
            <% else %>
              <span class="product-gallery-hint">Hover for actions</span>
            <% end %>
            <label class="product-gallery-select-delete">
              <%= check_box_tag "product[remove_gallery_image_ids][]", attachment.id, false, class: "product-gallery-select-input" %>
              <span class="product-gallery-select-pill">Mark to remove on update</span>
            </label>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div>
    <%= f.submit "Update Product" %>
  </div>
<% end %>

<%= link_to "Back to Product", @product, class: "form-page-back-link" %>

<script>
  (() => {
    const input = document.getElementById("product_gallery_images_edit");
    const preview = document.getElementById("product_gallery_preview_edit");
    const hidden = document.getElementById("product_primary_uploaded_image_index_edit");
    if (!input || !preview || !hidden || input.dataset.previewBound === "true") return;
    input.dataset.previewBound = "true";
    hidden.value = "";
    const hasDisplayImage = input.dataset.hasDisplay === "true";

    let stagedFiles = [];

    const syncInputFiles = () => {
      const dt = new DataTransfer();
      stagedFiles.forEach((file) => dt.items.add(file));
      input.files = dt.files;
    };

    const markSelected = (index) => {
      hidden.value = String(index);
      preview.querySelectorAll(".product-upload-preview-item").forEach((el) => {
        el.classList.toggle("is-selected", Number(el.dataset.index) === index);
      });
    };

    const selectedIndex = () => {
      if (hidden.value === "") return null;
      const parsed = Number.parseInt(hidden.value, 10);
      return Number.isInteger(parsed) ? parsed : null;
    };

    const renderPreview = () => {
      preview.innerHTML = "";
      if (!stagedFiles.length) {
        hidden.value = "";
        preview.hidden = true;
        return;
      }

      stagedFiles.forEach((file, index) => {
        const item = document.createElement("button");
        item.type = "button";
        item.className = "product-upload-preview-item";
        item.dataset.index = String(index);
        item.title = "Click to set as display image";

        const img = document.createElement("img");
        img.className = "product-upload-preview-thumb";
        img.alt = file.name;
        img.src = URL.createObjectURL(file);
        img.onload = () => URL.revokeObjectURL(img.src);

        const label = document.createElement("span");
        label.className = "product-upload-preview-label";
        label.textContent = "Click to set display";

        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "product-upload-preview-remove";
        remove.textContent = "x";
        remove.title = "Remove this file";
        remove.addEventListener("click", (event) => {
          event.stopPropagation();
          stagedFiles = stagedFiles.filter((_, i) => i !== index);
          syncInputFiles();
          renderPreview();
        });

        item.appendChild(img);
        item.appendChild(label);
        item.appendChild(remove);
        item.addEventListener("click", () => {
          const current = selectedIndex();
          if (current === index) {
            hidden.value = "";
            preview.querySelectorAll(".product-upload-preview-item").forEach((el) => el.classList.remove("is-selected"));
          } else {
            markSelected(index);
          }
        });
        preview.appendChild(item);
      });

      const selected = selectedIndex();
      if (selected !== null && selected >= 0 && selected < stagedFiles.length) {
        markSelected(selected);
      } else if (!hasDisplayImage) {
        markSelected(0);
      }
      preview.hidden = false;
    };

    input.addEventListener("change", () => {
      hidden.value = "";
      stagedFiles = Array.from(input.files || []).filter((file) => file.type.startsWith("image/"));
      syncInputFiles();
      renderPreview();
    });
  })();

  (() => {
    const items = document.querySelectorAll(".product-gallery-item");
    const form = document.querySelector("form");
    if (!items.length) return;

    items.forEach((item) => {
      const input = item.querySelector(".product-gallery-select-input");
      if (!input) return;

      const sync = () => item.classList.toggle("is-remove-selected", input.checked);
      sync();
      input.addEventListener("change", sync);
    });

    if (form) {
      form.addEventListener("submit", (event) => {
        const marked = document.querySelectorAll(".product-gallery-select-input:checked").length;
        if (!marked) return;
        const confirmed = window.confirm(`Remove ${marked} marked image(s) on update?`);
        if (!confirmed) event.preventDefault();
      });
    }
  })();
</script>
