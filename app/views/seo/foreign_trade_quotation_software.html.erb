<section class="app-page-shell marketing-page-shell">
  <%= render "components/ui/card", class: "app-surface marketing-hero-shell" do %>
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(320px,0.92fr)] lg:items-start">
      <div class="marketing-section-heading">
        <p class="marketing-section-kicker"><%= t("seo.view.foreign_trade_quotation_software.hero.kicker") %></p>
        <h1 class="marketing-section-title max-w-none"><%= t("seo.view.foreign_trade_quotation_software.hero.title") %></h1>
        <p class="marketing-section-body"><%= t("seo.view.foreign_trade_quotation_software.hero.body") %></p>
        <div class="flex flex-wrap gap-3">
          <%= render "components/ui/button", href: demo_path, variant: :primary do %>
            <%= t("seo.view.foreign_trade_quotation_software.hero.cta_demo") %>
          <% end %>
          <%= render "components/ui/button", href: sample_quote_path, variant: :secondary, attrs: { target: "_blank" } do %>
            <%= t("seo.view.foreign_trade_quotation_software.hero.cta_sample") %>
          <% end %>
        </div>
      </div>
      <aside class="marketing-overview-panel">
        <article class="marketing-overview-panel__row">
          <p class="app-stat-label"><%= t("seo.view.foreign_trade_quotation_software.cards.revision.label") %></p>
          <p class="app-subtle-note mt-2"><%= t("seo.view.foreign_trade_quotation_software.cards.revision.body") %></p>
        </article>
        <article class="marketing-overview-panel__row">
          <p class="app-stat-label"><%= t("seo.view.foreign_trade_quotation_software.cards.buyer.label") %></p>
          <p class="app-subtle-note mt-2"><%= t("seo.view.foreign_trade_quotation_software.cards.buyer.body") %></p>
        </article>
        <article class="marketing-overview-panel__row">
          <p class="app-stat-label"><%= t("seo.view.foreign_trade_quotation_software.cards.exports.label") %></p>
          <p class="app-subtle-note mt-2"><%= t("seo.view.foreign_trade_quotation_software.cards.exports.body") %></p>
        </article>
      </aside>
    </div>
  <% end %>

  <section class="marketing-flow-band">
    <%= render "components/ui/card", class: "app-surface marketing-workflow-card" do %>
      <span class="marketing-workflow-step">01</span>
      <h2 class="mt-3 text-xl font-semibold tracking-tight text-slate-950"><%= t("seo.view.foreign_trade_quotation_software.workflow.step_1.title") %></h2>
      <p class="app-section-caption mt-2"><%= t("seo.view.foreign_trade_quotation_software.workflow.step_1.body") %></p>
    <% end %>
    <%= render "components/ui/card", class: "app-surface marketing-workflow-card" do %>
      <span class="marketing-workflow-step">02</span>
      <h2 class="mt-3 text-xl font-semibold tracking-tight text-slate-950"><%= t("seo.view.foreign_trade_quotation_software.workflow.step_2.title") %></h2>
      <p class="app-section-caption mt-2"><%= t("seo.view.foreign_trade_quotation_software.workflow.step_2.body") %></p>
    <% end %>
    <%= render "components/ui/card", class: "app-surface marketing-workflow-card" do %>
      <span class="marketing-workflow-step">03</span>
      <h2 class="mt-3 text-xl font-semibold tracking-tight text-slate-950"><%= t("seo.view.foreign_trade_quotation_software.workflow.step_3.title") %></h2>
      <p class="app-section-caption mt-2"><%= t("seo.view.foreign_trade_quotation_software.workflow.step_3.body") %></p>
    <% end %>
  </section>

  <%= render "seo/continue_reading",
    related_topics: [
      { label: t("seo.view.shared.links.quote_revision_control"), path: quote_revision_control_path },
      { label: t("seo.view.shared.links.buyer_facing_quotation_link"), path: buyer_facing_quotation_link_path }
    ],
    comparison_link: { label: t("seo.view.shared.links.quotation_software_vs_excel"), path: quotation_software_vs_excel_path },
    cta: { label: t("seo.view.shared.links.open_demo_workspace"), path: demo_path } %>
</section>

