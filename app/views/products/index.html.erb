<section class="app-page-shell">
  <header class="app-page-header">
    <div class="app-page-header-main">
      <h1>Products</h1>
      <p>Keep the catalog dense, searchable, and ready for quoting with less scanning overhead.</p>
    </div>
    <div class="app-page-header-actions">
      <%= render "components/ui/button", href: new_product_path, variant: :primary, class: "page-primary-cta" do %>
        + New Product
      <% end %>
    </div>
  </header>

  <div class="app-section-stack">
    <section class="app-toolbar-surface app-toolbar-surface--compact">
      <%= form_with url: products_path, method: :get, local: true do |f| %>
        <div class="app-search-row">
          <div class="app-search-field">
            <span class="app-search-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" class="app-search-icon-svg" viewBox="0 0 24 24" fill="none">
                <path d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
              </svg>
            </span>
            <%= f.text_field :query,
                             placeholder: "Search products...",
                             value: @search_query,
                             class: "#{ui_input_classes} app-search-input" %>
          </div>
          <% if @search_query.present? %>
            <%= link_to "Clear", products_path, class: "app-search-clear" %>
          <% end %>
        </div>
      <% end %>
    </section>

    <% if @products.any? %>
      <section class="app-listing-shell">
        <div class="app-section-heading">
          <div>
            <h2>Catalog</h2>
            <p class="app-section-caption">Reusable products ready for quoting, presets, and revision-heavy sales flows.</p>
          </div>
        </div>
        <% if @search_query.present? %>
          <p class="search-info">Found <strong><%= @products.count %></strong> product(s) matching "<strong><%= @search_query %></strong>"</p>
        <% end %>
        <div class="table-responsive">
          <%= render "components/ui/table", class: "customers-table products-table saas-table app-table-surface", table_class: "customers-table products-table saas-table app-data-table" do %>
      <thead>
        <tr>
          <th>Image</th>
          <th>Name</th>
          <th>SKU</th>
          <th>Reference Price</th>
          <th>Quoted</th>
          <th>Last Used</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @products.each do |product| %>
          <% stats = @product_quote_stats[product.id] || { quote_count: 0, last_used_at: nil } %>
          <tr data-clickable-href="<%= product_path(product) %>" tabindex="0" aria-label="Open product <%= product.name %>">
            <td>
              <% if product.display_image.present? %>
                <%= image_tag product.display_image, style: "width: 56px; height: 56px; object-fit: cover; border-radius: 8px;" %>
              <% else %>
                -
              <% end %>
            </td>
            <td>
              <strong><%= link_to product.name, product_path(product), class: "product-library-name-link" %></strong>
            </td>
            <td><span class="product-sku"><%= product.sku %></span></td>
            <td><%= number_with_precision(product.default_price, precision: 2) %> <span class="product-price-currency"><%= product.price_currency %></span></td>
            <td><span class="next-action-pill is-muted"><%= stats[:quote_count] %></span></td>
            <td>
              <% if stats[:last_used_at].present? %>
                <%= stats[:last_used_at].strftime("%Y-%m-%d %H:%M") %>
              <% else %>
                <span class="dashboard-engagement-pill is-subtle">Never</span>
              <% end %>
            </td>
            <td class="product-row-actions">
              <details class="product-row-menu">
                <summary class="product-row-menu-trigger" aria-label="Open actions">•••</summary>
                <div class="product-row-menu-content">
                  <%= link_to "View", product_path(product), class: "product-row-menu-item" %>
                  <%= link_to "Edit", edit_product_path(product), class: "product-row-menu-item" %>
                  <%= link_to "Delete",
                              product_path(product),
                              method: :delete,
                              data: { turbo_confirm: "Delete this product?" },
                              class: "product-row-menu-item is-danger" %>
                </div>
              </details>
            </td>
          </tr>
        <% end %>
      </tbody>
          <% end %>
        </div>
      </section>
    <% else %>
      <%= ui_empty_state(
            title: "No products yet",
            body: "Create your first product to build a reusable catalog for quoting, presets, and exports.",
            action_label: "Create Product",
            action_path: new_product_path,
            icon: :products
          ) %>
    <% end %>
  </div>
</section>
