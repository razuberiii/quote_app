<%= link_to "\u2190 #{t("quotes.view.show.back_to_customer")}", @quote.customer, class: "quote-back-link quote-back-link-top" %>

<% watermark_text = template_watermark_text(@template, @quote.company.name) %>
<% watermark_image_url = template_watermark_image_url(@template) %>
<% workflow_state = @quote.workflow_state %>
<% current_latest_revision = @quote_revisions.present? ? @quote_revisions.first&.id == @quote.id : @quote.latest_revision_for_quote_no? %>
<% quote_document_locale = @quote_document_locale || I18n.locale %>
<% web_watermark_opacity = [[template_watermark_opacity(@template).to_f * 0.6, 0.05].max, 0.1].min %>
<% pi_mode = @quote.pi_document? %>
<% reason_missing = (@quote.status.to_s == "won" && @quote.win_reason.blank?) || (@quote.status.to_s == "lost" && @quote.loss_reason.blank?) %>
<% reason_action_label = @quote.status.to_s == "won" ? t("quotes.view.show.toolbar.add_win_reason") : t("quotes.view.show.toolbar.add_loss_reason") %>
<div class="quote-document quote-document-shell"
     data-has-newer-revision="<%= @has_newer_revision ? "true" : "false" %>"
     data-current-latest="<%= current_latest_revision ? "true" : "false" %>"
     style="--quote-accent: <%= @template.accent_color %>; --quote-watermark-opacity: <%= web_watermark_opacity %>;">
  <% viewer_tz = user_preferred_time_zone(current_user) %>
  <% discount_amount = @quote.discount_amount.to_d %>
  <% original_total = (@quote.subtotal.to_d + @quote.tax_amount.to_d + @quote.shipping_amount.to_d).round(2) %>
  <% has_discount = discount_amount.positive? %>
  <% savings_amount = has_discount ? discount_amount : 0.to_d %>
  <% days_left = @quote.valid_until.present? ? (@quote.valid_until - Date.current).to_i : nil %>
  <% total_views = @quote.quote_shares.sum(&:view_count) %>
  <% viewed_flag = @quote.viewed_at.present? || total_views.positive? %>
  <% share_count = @quote.quote_shares.size %>
  <% last_updated_text = format_in_user_time(@quote.updated_at, current_user) %>
  <% interaction_state =
      if !viewed_flag
        t("quotes.view.show.not_viewed_yet")
      elsif @quote.engagement_label == :hot
        t("quotes.view.show.engagement_hot_signal", count: total_views, duration_suffix: "")
      else
        t("quotes.view.show.viewed_count", count: total_views)
      end %>
  <% if @has_newer_revision && @latest_revision_quote.present? %>
    <p class="quote-superseded-notice">
      <%= t("quotes.view.show.superseded_notice") %>
      <%= link_to t("quotes.view.show.view_latest_version", revision: @latest_revision_quote.revision_number), quote_path(@latest_revision_quote), class: "quote-back-link-inline" %>
    </p>
  <% end %>
  <% if @quote.status.to_s == "draft" && @quote.reopened_at.present? %>
    <p class="quote-superseded-notice">
      <%= t("quotes.view.show.reopened_notice") %>
    </p>
  <% end %>
  <%= render "internal_document_body",
             quote: @quote,
             template: @template,
             document_kind: @document_kind,
             quote_document_locale: quote_document_locale,
             watermark_text: watermark_text,
             watermark_image_url: watermark_image_url,
             web_watermark_opacity: web_watermark_opacity,
             pi_mode: pi_mode,
             days_left: days_left,
             has_discount: has_discount,
             discount_amount: discount_amount,
             original_total: original_total,
             savings_amount: savings_amount,
             total_views: total_views,
             interaction_state: interaction_state,
             share_count: share_count,
             last_updated_text: last_updated_text %>

<% last_shared_at = @quote.quote_shares.maximum(:created_at) %>

<section class="quote-workspace-layer">
  <div class="quote-workspace-summary">
  <% if !pi_mode && @revision_diff.present? && @previous_revision_quote.present? %>
    <% revision_item_changes = @revision_diff.fetch(:modified_items, []).size + @revision_diff.fetch(:added_items, []).size + @revision_diff.fetch(:removed_items, []).size %>
    <% revision_removed_items = @revision_diff.fetch(:removed_items, []).size %>
    <% revision_pricing_changed = @revision_diff.fetch(:financial_changes, []).any? || (@revision_diff[:total_before].to_d != @revision_diff[:total_after].to_d) %>
    <details id="quote-revision-diff" class="quote-collab-panel" data-collab-key="revision_diff">
      <summary>
        <span class="quote-collab-title"><%= t("quotes.view.revision_diff.title") %></span>
        <span class="quote-collab-summary"><%= t("quotes.view.revision_diff.compare_versions", current: @quote.revision_number, previous: @previous_revision_quote.revision_number) %></span>
        <span class="quote-collab-summary"><%= t("quotes.view.revision_diff.overview_updated_items", count: revision_item_changes) %></span>
        <% if revision_removed_items.positive? %><span class="quote-collab-summary"><%= t("quotes.view.revision_diff.overview_removed_items", count: revision_removed_items) %></span><% end %>
        <% if revision_pricing_changed %><span class="quote-collab-summary"><%= t("quotes.view.revision_diff.overview_pricing_changed") %></span><% end %>
      </summary>
      <div class="quote-collab-content">
        <%= render "revision_diff" %>
      </div>
    </details>
  <% end %>

  <% if !pi_mode && @quote_decision_review.present? %>
    <details class="quote-collab-panel" data-collab-key="decision_review">
      <summary>
        <span class="quote-collab-title"><%= t("quotes.view.decision_review.title") %></span>
        <span class="quote-collab-summary"><%= @quote_decision_review[:recommended_move][:label] %></span>
        <span class="quote-collab-summary"><%= @quote_decision_review[:revision_scope][:value] %></span>
      </summary>
      <div class="quote-collab-content">
        <%= render "decision_review" %>
      </div>
    </details>
  <% end %>

  <% if !pi_mode && @quote_decision_timeline.any? %>
    <% recent_events = @quote_decision_timeline.first(2) %>
    <details class="quote-collab-panel" data-collab-key="decision_timeline">
      <summary>
        <span class="quote-collab-title"><%= t("quotes.view.decision_timeline.title") %></span>
        <% recent_events.each do |event| %>
          <span class="quote-collab-summary"><%= event[:label] %></span>
        <% end %>
      </summary>
      <div class="quote-collab-content">
        <%= render "decision_timeline" %>
      </div>
    </details>
  <% end %>

  <% access_events = @quote.quote_shares.flat_map { |share| Array(share.view_events) } %>
  <% country_counts = Hash.new(0) %>
  <% ip_counts = Hash.new(0) %>
  <% access_events.each do |event| %>
    <% country = event["country"].presence || t("quotes.view.show.unknown") %>
    <% ip = event["ip"].presence || t("quotes.view.show.unknown") %>
    <% country_counts[country] += 1 %>
    <% ip_counts[ip] += 1 %>
  <% end %>
  <% top_countries = country_counts.sort_by { |(_, count)| -count }.first(3) %>
  <% top_ips = ip_counts.sort_by { |(_, count)| -count }.first(3) %>
  <% recent_accesses = access_events.last(5).reverse %>
  <% recent_access_lines = recent_accesses.map do |event| %>
    <% tags = [] %>
    <% tags << event["country"] if event["country"].present? %>
    <% tags << event["ip"] if event["ip"].present? %>
    <% event_at = begin
         Time.iso8601(event["at"].to_s)
       rescue StandardError
         nil
       end %>
    <% formatted_at = event_at ? format_in_user_time(event_at, current_user) : event["at"] %>
    <% "#{formatted_at}#{tags.any? ? " [#{tags.join(' | ')}]" : ""}" %>
  <% end %>

  <% unless pi_mode %>
  <details class="quote-collab-panel" data-collab-key="engagement_details">
    <summary>
      <span class="quote-collab-title"><%= t("quotes.view.show.engagement_details") %></span>
      <span class="quote-collab-summary"><%= t("quotes.view.show.total_views") %>: <%= total_views %></span>
      <span class="quote-collab-summary"><%= t("quotes.view.show.last_shared") %>: <%= format_in_user_time(last_shared_at, current_user).presence || "-" %></span>
    </summary>
    <div class="quote-collab-content">
      <section class="quote-engagement-details quote-engagement-details--flat">
        <%= render "shared/quote_engagement_panel" %>
        <div class="quote-engagement-details-grid">
          <p><strong><%= t("quotes.view.show.time_zone") %>:</strong> <%= viewer_tz.name %></p>
          <p><strong><%= t("quotes.view.show.sent") %>:</strong> <%= format_in_user_time(@quote.sent_at, current_user) %> <%= "(#{relative_in_user_time(@quote.sent_at, current_user)})" if @quote.sent_at.present? %></p>
          <p><strong><%= t("quotes.view.show.last_shared") %>:</strong> <span id="quote-last-shared-at"><%= format_in_user_time(@quote.quote_shares.maximum(:created_at), current_user) %></span></p>
          <p><strong><%= t("quotes.view.show.first_viewed") %>:</strong> <%= format_in_user_time(@quote.quote_shares.minimum(:first_viewed_at), current_user) %></p>
          <p><strong><%= t("quotes.view.show.last_viewed") %>:</strong> <%= format_in_user_time(@quote.viewed_at, current_user) %> <%= "(#{relative_in_user_time(@quote.viewed_at, current_user)})" if @quote.viewed_at.present? %></p>
          <p><strong><%= t("quotes.view.show.total_views") %>:</strong> <%= @quote.quote_shares.sum(&:view_count) %></p>
          <p><strong><%= t("quotes.view.show.top_countries") %>:</strong> <%= top_countries.any? ? top_countries.map { |country, count| "#{country} (#{count})" }.join(", ") : "-" %></p>
          <p><strong><%= t("quotes.view.show.top_ips") %>:</strong> <%= top_ips.any? ? top_ips.map { |ip, count| "#{ip} (#{count})" }.join(", ") : "-" %></p>
          <p><strong><%= t("quotes.view.show.recent_accesses") %>:</strong> <%= recent_access_lines.any? ? recent_access_lines.join(" | ") : "-" %></p>
        </div>
      </section>
    </div>
  </details>
  <% end %>
  </div>

<section class="quote-workspace-actions">
<div class="quote-toolbar quote-toolbar-surface app-toolbar-surface app-toolbar-surface--compact quote-workspace-toolbar">
  <div class="quote-toolbar-left">
    <% if @quote.can_edit_revision? && !pi_mode %>
      <div class="quote-template-picker">
        <label for="template_select_<%= @quote.id %>"><%= t("quotes.view.show.toolbar.template") %></label>
        <%= select_tag :template_id,
                       options_from_collection_for_select(@template_options, :id, :name, @template.id),
                       id: "template_select_#{@quote.id}",
                       class: "js-template-select #{ui_input_classes}",
                       data: { update_url: update_template_quote_path(@quote), doc: @document_kind } %>
      </div>
    <% end %>

    <% latest_active_share = @quote.quote_shares.active.order(created_at: :desc).first %>
    <% latest_active_share ||= @quote.quote_shares.order(created_at: :desc).first %>
    <% existing_public_share_url = latest_active_share.present? ? public_quote_share_path(latest_active_share.token, doc: @document_kind) : nil %>
    <% if workflow_state == "draft" && !pi_mode %>
      <details class="quote-toolbar-export js-preview-menu">
        <summary class="<%= ui_button_classes(:secondary) %> quote-btn quote-btn-secondary"><%= t("quotes.view.show.toolbar.preview") %></summary>
        <div class="quote-toolbar-export-menu">
          <p class="quote-toolbar-export-hint"><%= t("quotes.view.show.toolbar.preview_no_state_change") %></p>
          <%= link_to t("quotes.view.show.toolbar.preview_pdf"),
                      export_pdf_quote_path(@quote, doc: @document_kind, document_kind: @document_kind, preview: 1),
                      class: "#{ui_button_classes(:secondary)} quote-btn quote-btn-secondary",
                      data: { turbo: false },
                      target: "_blank",
                      rel: "noopener" %>
          <%= link_to t("quotes.view.show.toolbar.preview_excel"),
                      export_xlsx_quote_path(@quote, doc: @document_kind, preview: 1),
                      class: "#{ui_button_classes(:secondary)} quote-btn quote-btn-secondary",
                      data: { turbo: false },
                      target: "_blank",
                      rel: "noopener" %>
          <p class="quote-toolbar-export-hint"><%= t("quotes.view.show.toolbar.preview_excel_download_hint") %></p>
          <%= link_to t("quotes.view.show.toolbar.preview_public_link"),
                      public_preview_quote_path(@quote, doc: @document_kind),
                      class: "#{ui_button_classes(:secondary)} quote-btn quote-btn-secondary",
                      data: { turbo: false },
                      target: "_blank",
                      rel: "noopener" %>
        </div>
      </details>
    <% end %>

    <% send_share_label = if pi_mode
                            t("quotes.view.show.toolbar.export")
                          elsif @quote.can_share_publicly?
                            t("quotes.view.show.toolbar.send_share")
                          else
                            t("quotes.view.show.toolbar.export")
                          end %>
    <% if pi_mode && @quote.can_edit_revision? %>
      <%= link_to t("quotes.view.show.toolbar.edit"),
                  edit_quote_path(@quote),
                  class: "#{ui_button_classes(:secondary)} quote-btn quote-btn-secondary" %>
    <% end %>
    <details class="quote-toolbar-export js-send-share-menu">
      <summary class="<%= ui_button_classes(:primary) %> quote-btn quote-btn-primary"><%= send_share_label %></summary>
      <div class="quote-toolbar-export-menu">
        <% if @quote.can_share_publicly? || existing_public_share_url.present? %>
          <% wa_phone_raw = @quote.customer.whatsapp_phone %>
          <% share_msg_template = quote_share_message_template(@quote, locale: @quote_document_locale) %>
          <% share_comms_available = !pi_mode && (@quote.can_share_publicly? || existing_public_share_url.present?) %>
          <script>
            window.__quoteShareCommsData = {
              messageTemplate: <%= raw share_msg_template.to_json %>,
              phone: <%= raw wa_phone_raw.to_json %>
            };
          </script>
          <div class="share-link-group share-link-group-inline">
            <% share_button_data = {} %>
            <% share_button_data[:share_url] = share_quote_path(@quote, doc: @document_kind, format: :json) if @quote.can_share_publicly? %>
            <% share_button_data[:existing_url] = existing_public_share_url if existing_public_share_url.present? %>
            <% share_button_data[:mark_sent_url] = mark_sent_quote_path(@quote) if @quote.can_mark_sent? %>
            <%= button_tag type: "button",
                           class: "quote-btn quote-btn-primary js-share-public-link js-shortcut-share",
                           data: share_button_data do %>
              <%= @quote.can_share_publicly? ? t("quotes.view.show.toolbar.share_public_link") : t("quotes.view.show.toolbar.copy_open_public_link") %>
            <% end %>
            <div class="share-link-panel" id="quote-share-panel" hidden>
              <div class="share-link-panel-message" id="quote-share-message"></div>
              <% if share_comms_available %>
                <div class="share-link-panel-editor">
                  <label class="share-link-panel-editor-label" for="quote-share-message-editor"><%= t("quotes.view.show.comms.editor_label", default: "Share Message") %></label>
                  <textarea id="quote-share-message-editor" class="share-link-panel-editor-input" rows="5" placeholder="<%= t("quotes.view.show.comms.editor_placeholder", default: "You can edit this message before copying or sending.") %>"></textarea>
                  <p class="share-link-panel-editor-hint"><%= t("quotes.view.show.comms.editor_hint", default: "Tip: personalize the greeting or payment details before sending.") %></p>
                </div>
              <% end %>
              <div class="share-link-panel-actions">
                <button type="button" class="<%= ui_button_classes(:secondary, "share-link-panel-btn") %>" id="quote-share-copy-btn"><%= t("quotes.view.show.toolbar.copy_link") %></button>
                <a href="#" target="_blank" rel="noopener" class="<%= ui_button_classes(:secondary, "share-link-panel-btn is-link") %>" id="quote-share-open-link"><%= t("quotes.view.show.toolbar.open") %></a>
                <% if share_comms_available %>
                  <button type="button" class="<%= ui_button_classes(:secondary, "share-link-panel-btn") %>" id="quote-share-copy-message-btn"><%= t("quotes.view.show.comms.copy_message", default: "Copy Share Message") %></button>
                  <% if wa_phone_raw.present? %>
                    <a href="#" target="_blank" rel="noopener" class="<%= ui_button_classes(:secondary, "share-link-panel-btn is-link") %>" id="quote-share-whatsapp-btn"><%= t("quotes.view.show.comms.send_whatsapp", default: "Send via WhatsApp") %></a>
                  <% else %>
                    <span class="app-ui-button app-ui-button--secondary share-link-panel-btn is-disabled" title="<%= t("quotes.view.show.comms.no_phone_tooltip") %>"><%= t("quotes.view.show.comms.send_whatsapp", default: "Send via WhatsApp") %></span>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
        <%= button_to t("quotes.view.show.toolbar.download_pdf"),
                      export_pdf_quote_path(@quote),
                      method: :get,
                      params: { doc: @document_kind, document_kind: @document_kind },
                      form: { data: { turbo: false }, onsubmit: "if (window.__markQuoteSentLocally) window.__markQuoteSentLocally();" },
                      class: "#{ui_button_classes(:secondary)} quote-btn quote-btn-secondary" %>
        <%= link_to t("quotes.view.show.toolbar.download_excel"),
                    export_xlsx_quote_path(@quote, doc: @document_kind),
                    class: "#{ui_button_classes(:secondary)} quote-btn quote-btn-secondary",
                    data: { turbo: false },
                    onclick: "if (window.__markQuoteSentLocally) window.__markQuoteSentLocally();" %>
      </div>
    </details>

    <% if !pi_mode && (@quote.can_create_new_revision? || @quote.can_reopen?) %>
      <div class="quote-toolbar-op-group" role="group" aria-label="<%= t("quotes.view.show.toolbar.quote_operations", default: "Quote operations") %>">
        <% if @quote.can_create_new_revision? %>
          <%= button_to t("quotes.view.show.toolbar.new_revision"),
                        duplicate_quote_path(@quote),
                        method: :post,
                        form: { data: { turbo: false } },
                        class: "#{ui_button_classes(:secondary)} quote-btn quote-btn-secondary quote-toolbar-op-btn" %>
        <% end %>
        <% if @quote.can_reopen? %>
          <%= button_to t("quotes.view.show.toolbar.reopen_quote"),
                        reopen_quote_path(@quote),
                        method: :post,
                        form: { data: { turbo_confirm: t("quotes.view.show.toolbar.reopen_confirm") } },
                        class: "#{ui_button_classes(:secondary)} quote-btn quote-btn-secondary quote-toolbar-op-btn" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="quote-toolbar-right">
    <div class="quote-toolbar-right-primary">
      <% status_actions_visible = !pi_mode && (@quote.can_mark_negotiating? || @quote.can_mark_won? || @quote.can_mark_lost?) %>
      <% if status_actions_visible %>
        <% status_label = case @quote.workflow_state
                         when "won", "accepted"
                           t("quotes.view.show.toolbar.status_option_won")
                         when "lost"
                           t("quotes.view.show.toolbar.status_option_lost")
                         when "negotiating"
                           t("quotes.view.show.toolbar.status_option_negotiating")
                         when "viewed"
                           t("quotes.view.form.status_options.viewed")
                         when "sent"
                           t("quotes.view.form.status_options.sent")
                         else
                           t("quotes.view.form.status_options.draft")
                         end %>
        <details class="quote-toolbar-export quote-toolbar-status-control">
          <summary class="<%= ui_button_classes(:secondary) %> quote-btn quote-btn-secondary"><%= t("quotes.view.show.toolbar.status_selector", status: status_label) %></summary>
          <div class="quote-toolbar-export-menu quote-toolbar-export-menu--right">
            <% if @quote.can_mark_negotiating? %>
              <%= button_to t("quotes.view.show.toolbar.status_mark_action", status: t("quotes.view.show.toolbar.status_option_negotiating")),
                            mark_negotiating_quote_path(@quote),
                            method: :post,
                            form: { data: { turbo: false } },
                            class: "#{ui_button_classes(:secondary)} quote-btn quote-btn-secondary" %>
            <% end %>
            <% if @quote.can_mark_won? %>
              <button type="button"
                      class="<%= "#{ui_button_classes(:secondary)} quote-btn quote-btn-secondary js-quote-stage-open" %>"
                      data-stage-modal-id="quote-won-modal-<%= @quote.id %>">
                <%= t("quotes.view.show.toolbar.status_mark_action", status: t("quotes.view.show.toolbar.status_option_won")) %>
              </button>
            <% end %>
            <% if @quote.can_mark_lost? %>
              <button type="button"
                      class="<%= "#{ui_button_classes(:secondary)} quote-btn quote-btn-secondary js-quote-stage-open" %>"
                      data-stage-modal-id="quote-lost-modal-<%= @quote.id %>">
                <%= t("quotes.view.show.toolbar.status_mark_action", status: t("quotes.view.show.toolbar.status_option_lost")) %>
              </button>
            <% end %>
          </div>
        </details>
      <% end %>

      <% if reason_missing && !pi_mode %>
        <button type="button"
                class="<%= "#{ui_button_classes(:primary)} quote-btn quote-btn-primary js-quote-reason-open" %>"
                data-reason-modal-id="quote-reason-modal-<%= @quote.id %>">
          <%= reason_action_label %>
        </button>
      <% end %>
      <% if @quote.can_send_reminder? && !pi_mode %>
        <% if ENV["SKIP_TURNSTILE_VERIFICATION"] == "true" %>
          <%= button_to t("quotes.view.show.toolbar.send_reminder"),
                        send_reminder_quote_path(@quote, doc: @document_kind),
                        method: :post,
                        class: "#{ui_button_classes(:secondary)} quote-btn quote-btn-secondary" %>
        <% else %>
          <% reminder_form_id = "quote-reminder-form-#{@quote.id}" %>
          <% reminder_modal_id = "quote-reminder-modal-#{@quote.id}" %>
          <% reminder_response_id = "quote-reminder-turnstile-response-#{@quote.id}" %>
          <div class="quote-reminder-verification">
            <%= form_with url: send_reminder_quote_path(@quote, doc: @document_kind),
                          method: :post,
                          local: true,
                          html: { id: reminder_form_id, class: "quote-reminder-form", data: { turbo: false } } do %>
              <%= hidden_field_tag :cf_turnstile_response, "", id: reminder_response_id %>
              <button type="button"
                      class="<%= "#{ui_button_classes(:secondary)} quote-btn quote-btn-secondary js-quote-reminder-open" %>"
                      data-reminder-modal-id="<%= reminder_modal_id %>">
                <%= t("quotes.view.show.toolbar.send_reminder") %>
              </button>
            <% end %>

            <div class="quote-turnstile-modal"
                 id="<%= reminder_modal_id %>"
                 hidden
                 data-reminder-form-id="<%= reminder_form_id %>"
                 data-reminder-response-id="<%= reminder_response_id %>">
              <div class="quote-turnstile-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="<%= "#{reminder_modal_id}-title" %>">
                <button type="button" class="quote-turnstile-modal__close js-quote-reminder-close" aria-label="<%= t("quotes.view.show.toolbar.close_verification") %>">×</button>
                <h3 id="<%= "#{reminder_modal_id}-title" %>"><%= t("quotes.view.show.toolbar.verify_before_reminder") %></h3>
                <p><%= t("quotes.view.show.toolbar.verify_before_reminder_hint") %></p>
                <div class="quote-turnstile-modal__loading js-quote-reminder-loading"><%= t("quotes.view.show.toolbar.loading_verification") %></div>
                <div class="quote-turnstile-modal__widget js-quote-reminder-widget" hidden></div>
                <div class="quote-turnstile-modal__success js-quote-reminder-success" hidden><%= t("quotes.view.show.toolbar.verified_sending") %></div>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
      <% if @quote.can_delete_quote_family? && !pi_mode %>
