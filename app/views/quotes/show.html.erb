<main class="deal-workspace publish-review">
  <header class="deal-page-header"><div><%= link_to "← Deal", deal_path(@quote, tab: "quote"), class: "deal-back" %><p class="eyebrow">Working draft · publish review</p><h1><%= deal_title(@quote) %></h1><p><%= @quote.quote_no %> · <%= @quote.customer&.name || "Buyer required" %></p></div><%= link_to "Continue editing", edit_quote_path(@quote), class: "button button--secondary" %></header>
  <section class="publish-gate <%= "is-ready" if @readiness_issues.empty? %>">
    <div><span><%= @readiness_issues.empty? ? "Ready to freeze" : "Publish blocked" %></span><h2><%= @readiness_issues.empty? ? "Create an immutable Version" : "Complete the commercial evidence" %></h2><p>A Published Version freezes buyer, items, prices, terms and output settings. Later draft changes cannot alter it.</p></div>
    <% if @readiness_issues.any? %><ul><% @readiness_issues.each do |issue| %><li><%= issue %></li><% end %></ul><%= link_to "Resolve in Quote Studio", edit_quote_path(@quote), class: "button button--primary" %>
    <% else %><div class="publish-actions"><%= link_to "Preview Buyer Room", preview_quote_path(@quote), target: "_blank", class: "button button--secondary" %><%= button_to "Publish Version #{@revisions.size + 1}", quote_revisions_path(quote_id: @quote.id), class: "button button--primary", form: { data: { controller: "publish-motion", action: "submit->publish-motion#seal" } } %></div><% end %>
  </section>
  <section class="version-ledger"><header><p class="eyebrow">Version ledger</p><h2>Formal history</h2></header><% @revisions.each do |revision| %><%= link_to quote_revision_path(revision) do %><span>Version <%= revision.number %></span><strong><%= revision.currency %> <%= number_with_delimiter(revision.total) %></strong><small><%= revision.status.humanize %> · <%= revision.sent_at&.to_fs(:short) %></small><% end %><% end %><% if @revisions.empty? %><p>No content has been published yet.</p><% end %></section>
</main>
