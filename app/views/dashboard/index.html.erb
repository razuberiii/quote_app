<section class="app-page-shell sales-dashboard">
  <header class="app-page-header">
    <div class="app-page-header-main">
      <h1><%= t("dashboard.view.index.title") %></h1>
      <p><%= t("dashboard.view.index.subtitle") %></p>
    </div>
    <div class="app-page-header-actions">
      <div class="kpi-period-toggle" role="tablist" aria-label="<%= t("dashboard.view.index.kpi_period") %>">
        <%= link_to t("dashboard.view.index.weekly"), dashboard_path(kpi_period: "week"), class: "app-filter-pill app-filter-pill--kpi #{@kpi_period == 'week' ? 'is-active' : ''}" %>
        <%= link_to t("dashboard.view.index.monthly"), dashboard_path(kpi_period: "month"), class: "app-filter-pill app-filter-pill--kpi #{@kpi_period == 'month' ? 'is-active' : ''}" %>
      </div>
    </div>
  </header>

  <div class="sales-dashboard-content app-section-stack">
    <section class="app-toolbar-surface app-toolbar-surface--compact">
      <div class="app-section-heading">
        <div>
          <h2><%= t("dashboard.view.index.operating_snapshot") %></h2>
          <p class="app-section-caption"><%= t("dashboard.view.index.operating_snapshot_caption") %></p>
        </div>
      </div>
      <div class="dashboard-alert-strip">
      <% if @risk_snapshot[:overdue].positive? %>
        <span class="dashboard-alert-pill is-danger"><strong><%= @risk_snapshot[:overdue] %></strong> <%= t("dashboard.view.index.overdue_followups") %></span>
      <% end %>
      <% if @risk_snapshot[:due_today].positive? %>
        <span class="dashboard-alert-pill is-today"><strong><%= @risk_snapshot[:due_today] %></strong> <%= t("dashboard.view.index.due_today") %></span>
      <% end %>
      <% if @risk_snapshot[:stalled_high_value].positive? %>
        <span class="dashboard-alert-pill is-watch"><strong><%= @risk_snapshot[:stalled_high_value] %></strong> <%= t("dashboard.view.index.high_value_stalled") %></span>
      <% end %>
      <% if @decision_snapshot[:accepted_count].positive? %>
        <span class="dashboard-alert-pill is-good"><strong><%= @decision_snapshot[:accepted_count] %></strong> <%= t("dashboard.view.index.accepted") %></span>
      <% end %>
      <% if @decision_snapshot[:revision_requested_count].positive? %>
        <span class="dashboard-alert-pill is-watch"><strong><%= @decision_snapshot[:revision_requested_count] %></strong> <%= t("dashboard.view.index.revision_requests") %></span>
      <% end %>
      <% if @decision_snapshot[:negotiating_stale_count].positive? %>
        <span class="dashboard-alert-pill is-danger"><strong><%= @decision_snapshot[:negotiating_stale_count] %></strong> <%= t("dashboard.view.index.negotiating_stale") %></span>
      <% end %>
      <% if @risk_snapshot.values.all?(&:zero?) && @decision_snapshot[:negotiating_stale_count].zero? %>
        <span class="dashboard-alert-pill is-good"><%= t("dashboard.view.index.no_immediate_risk") %></span>
      <% end %>
      </div>
    </section>

    <%= render "components/ui/card", class: "dashboard-panel dashboard-action-summary app-surface" do %>
      <div class="dashboard-action-summary-head">
        <h2><%= t("dashboard.view.index.action_overview", count: @action_required_summary[:total]) %></h2>
        <% if @action_required_summary[:has_risk] %>
          <% risk_text_parts = [] %>
          <% risk_text_parts << t("dashboard.view.index.risk_customers", count: @action_required_summary[:risk_customers]) if @action_required_summary[:risk_customers].positive? %>
          <% risk_text_parts << t("dashboard.view.index.stalled_negotiations", count: @action_required_summary[:decision_alerts]) if @action_required_summary[:decision_alerts].positive? %>
          <span class="dashboard-alert-pill is-danger dashboard-action-summary-risk"><%= risk_text_parts.join(" • ") %></span>
        <% else %>
          <span class="dashboard-alert-pill is-good dashboard-action-summary-risk"><%= t("dashboard.view.index.no_customer_or_decision_risk") %></span>
        <% end %>
      </div>
      <p class="dashboard-action-summary-note">
        <%= t("dashboard.view.index.handle_overdue_first") %>
      </p>
      <% if @action_required_summary[:total].positive? %>
        <%= render "components/ui/button",
                   tag: :button,
                   type: :button,
                   variant: :secondary,
                   class: "dashboard-action-link",
                   attrs: { data: { scroll_target: "action-items-section" } } do %>
          <%= t("dashboard.view.index.jump_to_action_items", count: @action_required_summary[:total]) %>
        <% end %>
      <% end %>
    <% end %>

    <%= render "components/ui/card", class: "dashboard-panel dashboard-decision-snapshot app-surface" do %>
      <div class="dashboard-action-summary-head">
        <h2><%= t("dashboard.view.index.sales_signals") %></h2>
        <span class="dashboard-decision-period"><%= @kpi_period == "month" ? t("dashboard.view.index.this_month") : t("dashboard.view.index.this_week") %></span>
      </div>
      <div class="dashboard-decision-flow">
        <div class="dashboard-decision-column">
          <h3><%= t("dashboard.view.index.outcome_signals") %></h3>
          <div class="dashboard-decision-metrics">
            <p class="dashboard-decision-metric">
              <span><%= t("dashboard.view.index.accepted") %></span>
              <strong><%= @decision_snapshot[:accepted_count] %></strong>
            </p>
            <p class="dashboard-decision-metric">
              <span><%= t("dashboard.view.index.revision_requested") %></span>
              <strong class="<%= 'is-attention' if @decision_snapshot[:revision_requested_count].positive? %>"><%= @decision_snapshot[:revision_requested_count] %></strong>
            </p>
          </div>
        </div>
        <div class="dashboard-decision-column">
          <h3><%= t("dashboard.view.index.pressure_signals") %></h3>
          <div class="dashboard-decision-metrics">
            <p class="dashboard-decision-metric">
              <span><%= t("dashboard.view.index.reopened") %></span>
              <strong><%= @decision_snapshot[:reopened_count] %></strong>
            </p>
            <p class="dashboard-decision-metric">
              <span><%= t("dashboard.view.index.negotiating_stale") %></span>
              <strong><%= @decision_snapshot[:negotiating_stale_count] %></strong>
            </p>
          </div>
        </div>
        <div class="dashboard-decision-column dashboard-decision-column-attention">
          <h3><%= t("dashboard.view.index.attention_signal") %></h3>
          <div class="dashboard-decision-waiting">
            <p>
              <span><%= t("dashboard.view.index.public_actionable") %></span>
              <strong><%= @decision_snapshot[:public_actionable_count] %></strong>
            </p>
            <small><%= t("dashboard.view.index.awaiting_client_decision") %></small>
          </div>
        </div>
      </div>
      <%= render "shared/quote_funnel" %>
    <% end %>

    <div class="dashboard-kpi-row app-stat-grid">
      <article class="dashboard-kpi-card app-stat-card">
        <div class="dashboard-kpi-head">
          <span class="app-stat-label"><%= t("dashboard.view.index.open_deals") %></span>
        </div>
        <strong class="app-stat-value"><%= @dashboard_stats[:open_deals][:value] %></strong>
        <small class="app-stat-meta dashboard-kpi-trend <%= @dashboard_stats[:open_deals][:trend_class] %>"><%= @dashboard_stats[:open_deals][:trend_text] %></small>
      </article>
      <article class="dashboard-kpi-card app-stat-card">
        <div class="dashboard-kpi-head">
          <span class="app-stat-label"><%= t("dashboard.view.index.quotes_this_period", period: (@kpi_period == "month" ? t("dashboard.view.index.period_month") : t("dashboard.view.index.period_week"))) %></span>
        </div>
        <strong class="app-stat-value"><%= @dashboard_stats[:quotes_this_week][:value] %></strong>
        <small class="app-stat-meta dashboard-kpi-trend <%= @dashboard_stats[:quotes_this_week][:trend_class] %>"><%= @dashboard_stats[:quotes_this_week][:trend_text] %></small>
      </article>
      <article class="dashboard-kpi-card app-stat-card">
        <div class="dashboard-kpi-head">
          <span class="app-stat-label"><%= t("dashboard.view.index.pending_followups") %></span>
        </div>
        <strong class="app-stat-value"><%= @dashboard_stats[:pending_follow_ups][:value] %></strong>
        <small class="app-stat-meta dashboard-kpi-trend <%= @dashboard_stats[:pending_follow_ups][:trend_class] %>"><%= @dashboard_stats[:pending_follow_ups][:trend_text] %></small>
      </article>
    </div>

    <div id="today-focus-section">
    <%= render "components/ui/card", class: "dashboard-panel dashboard-action-center app-surface" do %>
      <h2><%= t("dashboard.view.index.today_focus") %></h2>
      <% if @primary_action.present? %>
        <div class="dashboard-action-list">
          <div class="dashboard-action-item dashboard-action-item-primary is-<%= @primary_action[:priority] %>">
            <div>
              <span class="dashboard-action-primary-label"><%= t("dashboard.view.index.top_priority") %></span>
              <strong><%= @primary_action[:title] %></strong>
              <p><%= @primary_action[:detail] %></p>
            </div>
            <% if @primary_action[:cta_method].to_sym == :post %>
              <%= button_to @primary_action[:cta_label], @primary_action[:cta_path], method: :post, form: { data: { turbo: false } }, class: ui_button_classes(:secondary, "dashboard-action-link") %>
            <% else %>
              <%= render "components/ui/button", href: @primary_action[:cta_path], variant: :secondary, class: "dashboard-action-link" do %>
                <%= @primary_action[:cta_label] %>
              <% end %>
            <% end %>
          </div>
          <% if @secondary_actions.any? %>
            <div class="dashboard-action-more" data-action-more hidden>
              <% @secondary_actions.each do |item| %>
                <div class="dashboard-action-item is-<%= item[:priority] %>">
                  <div>
                    <span class="dashboard-action-secondary-label"><%= t("dashboard.view.index.secondary") %></span>
                    <strong><%= item[:title] %></strong>
                    <p><%= item[:detail] %></p>
                  </div>
                  <% if item[:cta_method].to_sym == :post %>
                    <%= button_to item[:cta_label], item[:cta_path], method: :post, form: { data: { turbo: false } }, class: ui_button_classes(:secondary, "dashboard-action-link") %>
                  <% else %>
                    <%= render "components/ui/button", href: item[:cta_path], variant: :secondary, class: "dashboard-action-link" do %>
                      <%= item[:cta_label] %>
                    <% end %>
                  <% end %>
                </div>
              <% end %>
            </div>
            <%= render "components/ui/button",
                       variant: :secondary,
                       class: "dashboard-action-toggle dashboard-inline-toggle",
                       attrs: { data: { action_toggle: true, expanded: "false", action_count: @secondary_actions.size } } do %>
              <%= t("dashboard.view.index.show_more", count: @secondary_actions.size) %>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="team-members-hint"><%= t("dashboard.view.index.no_high_priority_actions") %></p>
      <% end %>
    <% end %>
    </div>

    <div id="deal-radar-section">
    <%= render "components/ui/card", class: "dashboard-panel app-surface" do %>
      <div class="dashboard-action-summary-head">
        <h2><%= t("dashboard.view.index.deal_radar") %></h2>
        <span class="dashboard-alert-pill <%= @deal_radar_signals.any? ? 'is-watch' : 'is-good' %>">
          <%= t("dashboard.view.index.deal_radar_count", count: @deal_radar_signals.size) %>
        </span>
      </div>

      <% if @deal_radar_signals.any? %>
        <div class="dashboard-action-list">
          <% @deal_radar_signals.first(3).each do |entry| %>
            <div class="dashboard-action-item is-<%= entry[:signal].priority %>">
              <div>
                <span class="dashboard-action-secondary-label"><%= entry[:signal].label %></span>
                <strong><%= entry[:quote].customer&.name.presence || t("dashboard.logic.unknown_customer") %> · <%= entry[:quote].custom_title.presence || entry[:quote].quote_items.ordered.first&.product&.name.presence || entry[:quote].quote_items.ordered.first&.description.presence || entry[:quote].quote_no %></strong>
                <small class="dashboard-quote-id"><%= entry[:quote].quote_no %></small>
                <p><%= entry[:detail] %></p>
              </div>
              <%= render "components/ui/button", href: quote_path(entry[:quote]), variant: :secondary, class: "dashboard-action-link" do %>
                <%= t("dashboard.view.index.view_quote") %>
              <% end %>
            </div>
          <% end %>

          <% if @deal_radar_signals.size > 3 %>
            <div class="dashboard-action-more" data-deal-radar-more hidden>
              <% @deal_radar_signals.drop(3).each do |entry| %>
                <div class="dashboard-action-item is-<%= entry[:signal].priority %>">
                  <div>
                    <span class="dashboard-action-secondary-label"><%= entry[:signal].label %></span>
                    <strong><%= entry[:quote].customer&.name.presence || t("dashboard.logic.unknown_customer") %> · <%= entry[:quote].custom_title.presence || entry[:quote].quote_items.ordered.first&.product&.name.presence || entry[:quote].quote_items.ordered.first&.description.presence || entry[:quote].quote_no %></strong>
                    <small class="dashboard-quote-id"><%= entry[:quote].quote_no %></small>
                    <p><%= entry[:detail] %></p>
                  </div>
                  <%= render "components/ui/button", href: quote_path(entry[:quote]), variant: :secondary, class: "dashboard-action-link" do %>
                    <%= t("dashboard.view.index.view_quote") %>
                  <% end %>
                </div>
              <% end %>
            </div>

            <%= render "components/ui/button",
                       variant: :secondary,
                       class: "dashboard-action-toggle dashboard-inline-toggle",
                       attrs: { data: { deal_radar_toggle: true, expanded: "false", action_count: @deal_radar_signals.size - 3 } } do %>
              <%= t("dashboard.view.index.show_more", count: @deal_radar_signals.size - 3) %>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="team-members-hint"><%= t("dashboard.view.index.deal_radar_empty") %></p>
      <% end %>
    <% end %>
    </div>

    <%= render "shared/action_items" %>

    <div class="dashboard-detail-grid dashboard-detail-grid--overview">
      <%= render "components/ui/card", class: "dashboard-panel dashboard-overview-panel app-surface" do %>
        <div class="app-section-heading">
          <div>
            <h2><%= t("dashboard.view.index.recent_quotes") %></h2>
            <p class="app-section-caption"><%= t("dashboard.view.index.recent_quotes_caption") %></p>
          </div>
        </div>
        <div class="table-responsive">
          <%= render "components/ui/table", class: "dashboard-recent-table dashboard-products-table app-table-surface", table_class: "dashboard-recent-table dashboard-products-table app-data-table" do %>
            <thead>
              <tr>
                <th><%= t("dashboard.view.index.quote") %></th>
                <th><%= t("dashboard.view.index.buyer") %></th>
                <th><%= t("dashboard.view.index.status") %></th>
                <th><%= t("dashboard.view.index.engagement") %></th>
                <th><%= t("dashboard.view.index.next_move") %></th>
                <th class="text-right"><%= t("dashboard.view.index.total") %></th>
              </tr>
            </thead>
            <tbody>
              <% if @recent_quotes.any? %>
                <% @recent_quotes.each do |entry| %>
                  <tr>
                    <td data-label="<%= t("dashboard.view.index.quote") %>">
                      <strong><%= link_to(entry[:display_name].presence || entry[:quote_no], quote_path(entry[:quote])) %></strong>
                      <% if entry[:display_name].present? %>
                        <small class="dashboard-quote-id"><%= entry[:quote_no] %></small>
                      <% end %>
                    </td>
                    <td data-label="<%= t("dashboard.view.index.buyer") %>"><%= entry[:customer_name] %></td>
                    <td data-label="<%= t("dashboard.view.index.status") %>">
                      <%= quote_status_badge(entry[:status], label: entry[:status].capitalize) %>
                    </td>
                    <td data-label="<%= t("dashboard.view.index.engagement") %>">
                      <span class="dashboard-engagement-pill <%= entry[:view_signal] == "—" ? "is-subtle" : "" %>"><%= entry[:view_signal] %></span>
                    </td>
                    <td data-label="<%= t("dashboard.view.index.next_move") %>"><span class="dashboard-next-step-btn is-neutral is-static"><%= entry[:next_action][:label] %></span></td>
                    <td data-label="<%= t("dashboard.view.index.total") %>" class="text-right"><%= quote_money(entry[:total], entry[:currency]) %></td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td data-label="<%= t("dashboard.view.index.recent_quotes") %>" colspan="6" class="customers-empty-row">
                    <%= ui_empty_state(
                          title: t("dashboard.view.index.no_quotes_yet"),
                          body: t("dashboard.view.index.no_quotes_yet_body"),
                          action_label: t("dashboard.view.index.new_quote"),
                          action_path: customers_path,
                          icon: :quotes
                        ) %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          <% end %>
        </div>
      <% end %>

      <%= render "components/ui/card", class: "dashboard-panel dashboard-panel--data app-surface" do %>
        <div class="app-section-heading">
          <div>
            <h2><%= t("dashboard.view.index.deal_overview") %></h2>
            <p class="app-section-caption"><%= t("dashboard.view.index.deal_overview_caption") %></p>
          </div>
        </div>
        <ul class="dashboard-overview-list">
          <li>
            <div class="dashboard-overview-label-row">
              <span><%= t("dashboard.view.index.top_product") %></span>
              <small><%= t("dashboard.view.index.last_30_days_quotes", count: @deal_overview[:top_product_sample_size]) %></small>
            </div>
            <strong class="dashboard-overview-value"><%= @deal_overview[:top_product] %></strong>
          </li>
          <li>
            <div class="dashboard-overview-label-row">
              <span><%= t("dashboard.view.index.average_quote_cycle") %></span>
              <small><%= t("dashboard.view.index.closed_deals", count: @deal_overview[:closed_cycle_sample_size]) %></small>
            </div>
            <strong class="dashboard-overview-value"><%= t("dashboard.view.index.days_value", count: @deal_overview[:average_quote_cycle_days]) %></strong>
            <p class="dashboard-overview-insight"><%= @deal_overview[:cycle_insight] %></p>
          </li>
          <li>
            <div class="dashboard-overview-label-row">
              <span><%= t("dashboard.view.index.revision_rate") %></span>
              <small><%= t("dashboard.view.index.active_quotes") %></small>
            </div>
            <strong class="dashboard-overview-value"><%= @deal_overview[:revision_rate] %>%</strong>
            <p class="dashboard-overview-insight"><%= @deal_overview[:revision_insight] %></p>
          </li>
          <li>
            <div class="dashboard-overview-label-row">
              <span><%= t("dashboard.view.index.document_mix") %></span>
              <small><%= t("dashboard.view.index.quotation_vs_pi") %></small>
            </div>
            <strong class="dashboard-overview-value"><%= @deal_overview[:export_mix] %></strong>
            <p class="dashboard-overview-insight"><%= @deal_overview[:decision_insight] %></p>
          </li>
        </ul>
      <% end %>
    </div>

    <section class="dashboard-health-strip dashboard-health-band">
      <% @dashboard_health_snapshot.each do |item| %>
        <article class="dashboard-health-card is-<%= item[:tone] %>">
          <span class="dashboard-health-label"><%= item[:label] %></span>
          <strong><%= item[:value] %></strong>
          <p><%= item[:detail] %></p>
        </article>
      <% end %>
    </section>

    <%= render "shared/performance_reports" %>

    <div class="dashboard-detail-grid dashboard-detail-grid--lists">
      <%= render "components/ui/card", class: "dashboard-panel dashboard-panel--data app-surface" do %>
        <div class="app-section-heading">
          <div>
            <h2><%= t("dashboard.view.index.top_quoted_products") %></h2>
            <p class="app-section-caption"><%= t("dashboard.view.index.top_quoted_products_caption") %></p>
          </div>
        </div>
        <div class="table-responsive">
          <%= render "components/ui/table", class: "dashboard-recent-table dashboard-summary-table app-table-surface", table_class: "dashboard-recent-table dashboard-summary-table app-data-table" do %>
            <thead>
              <tr>
                <th><%= t("dashboard.view.index.product") %></th>
                <th><%= t("dashboard.view.index.quoted") %></th>
                <th><%= t("dashboard.view.index.won") %></th>
                <th><%= t("dashboard.view.index.last_quoted") %></th>
              </tr>
            </thead>
            <tbody>
              <% if @top_quoted_products.any? %>
                <% @top_quoted_products.each do |product| %>
                  <tr data-clickable-href="<%= product_path(product) %>" tabindex="0" aria-label="<%= t("dashboard.view.index.open_product", name: product.name) %>">
                    <td data-label="<%= t("dashboard.view.index.product") %>">
                      <div class="dashboard-mobile-value">
                        <strong><%= product.name %></strong>
                      </div>
                    </td>
                    <td data-label="<%= t("dashboard.view.index.quoted") %>">
                      <div class="dashboard-mobile-value"><%= product.quoted_count %></div>
                    </td>
                    <td data-label="<%= t("dashboard.view.index.won") %>">
                      <div class="dashboard-mobile-value"><%= product.won_count %></div>
                    </td>
                    <td data-label="<%= t("dashboard.view.index.last_quoted") %>">
                      <div class="dashboard-mobile-value"><%= product.last_quoted_at.present? ? format_in_user_time(product.last_quoted_at, current_user) : "-" %></div>
                    </td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="4" class="customers-empty-row">
                    <%= ui_empty_state(
                          title: t("dashboard.view.index.no_product_activity"),
                          body: t("dashboard.view.index.no_product_activity_body"),
                          icon: :products
                        ) %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          <% end %>
        </div>
        <div class="dashboard-mobile-list" aria-hidden="true">
          <% if @top_quoted_products.any? %>
            <% @top_quoted_products.each do |product| %>
              <article class="dashboard-mobile-item" data-clickable-href="<%= product_path(product) %>" tabindex="0" aria-label="<%= t("dashboard.view.index.open_product", name: product.name) %>">
                <div class="dashboard-mobile-row">
                  <span><%= t("dashboard.view.index.product") %></span>
                  <strong><%= product.name %></strong>
                </div>
                <div class="dashboard-mobile-row">
                  <span><%= t("dashboard.view.index.quoted") %></span>
                  <strong><%= product.quoted_count %></strong>
                </div>
                <div class="dashboard-mobile-row">
                  <span><%= t("dashboard.view.index.won") %></span>
                  <strong><%= product.won_count %></strong>
                </div>
                <div class="dashboard-mobile-row">
                  <span><%= t("dashboard.view.index.last_quoted") %></span>
                  <strong><%= product.last_quoted_at.present? ? format_in_user_time(product.last_quoted_at, current_user) : "-" %></strong>
                </div>
              </article>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <%= render "components/ui/card", class: "dashboard-panel app-surface" do %>
        <div class="app-section-heading">
          <div>
            <h2><%= t("dashboard.view.index.reminder_queue") %></h2>
            <p class="app-section-caption"><%= t("dashboard.view.index.reminder_queue_caption") %></p>
          </div>
        </div>
        <div class="table-responsive">
          <%= render "components/ui/table", class: "dashboard-recent-table dashboard-summary-table dashboard-reminder-table app-table-surface", table_class: "dashboard-recent-table dashboard-summary-table dashboard-reminder-table app-data-table" do %>
            <thead>
              <tr>
                <th><%= t("dashboard.view.index.quote") %></th>
                <th><%= t("dashboard.view.index.buyer") %></th>
                <th><%= t("dashboard.view.index.sent") %></th>
                <th class="dashboard-reminder-count-head"><%= t("dashboard.view.index.count") %></th>
              </tr>
            </thead>
            <tbody>
              <% if @reminder_quotes.any? %>
                <% @reminder_quotes.each do |quote| %>
                  <% reminder_title = quote.custom_title.presence || quote.quote_items.ordered.first&.product&.name.presence || quote.quote_items.ordered.first&.description.presence || t("dashboard.view.index.quotation") %>
                  <tr data-clickable-href="<%= quote_path(quote) %>" tabindex="0" aria-label="<%= t("dashboard.view.index.open_quote", no: quote.quote_no) %>">
                    <td data-label="<%= t("dashboard.view.index.quote") %>">
                      <div class="dashboard-mobile-value">
                        <strong><%= reminder_title %></strong>
                        <small class="dashboard-quote-id"><%= quote.quote_no %></small>
                      </div>
                    </td>
                    <td data-label="<%= t("dashboard.view.index.buyer") %>">
                      <div class="dashboard-mobile-value"><%= quote.customer.name %></div>
                    </td>
                    <td data-label="<%= t("dashboard.view.index.sent") %>">
                      <div class="dashboard-mobile-value"><%= format_in_user_time(quote.sent_at, current_user) %></div>
                    </td>
                    <td data-label="<%= t("dashboard.view.index.count") %>" class="dashboard-reminder-count">
                      <div class="dashboard-mobile-value"><%= quote.reminder_count %></div>
                    </td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="4" class="customers-empty-row">
                    <%= ui_empty_state(
                          title: t("dashboard.view.index.no_reminders_pending"),
                          body: t("dashboard.view.index.no_reminders_pending_body"),
                          icon: :quotes
                        ) %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          <% end %>
        </div>
        <div class="dashboard-mobile-list dashboard-mobile-list--reminders" aria-hidden="true">
          <% if @reminder_quotes.any? %>
            <% @reminder_quotes.each do |quote| %>
              <% reminder_title = quote.custom_title.presence || quote.quote_items.ordered.first&.product&.name.presence || quote.quote_items.ordered.first&.description.presence || t("dashboard.view.index.quotation") %>
              <article class="dashboard-mobile-item" data-clickable-href="<%= quote_path(quote) %>" tabindex="0" aria-label="<%= t("dashboard.view.index.open_quote", no: quote.quote_no) %>">
                <div class="dashboard-mobile-row">
                  <span><%= t("dashboard.view.index.quote") %></span>
                  <div class="dashboard-mobile-stack">
                    <strong><%= reminder_title %></strong>
                    <small class="dashboard-quote-id"><%= quote.quote_no %></small>
                  </div>
                </div>
                <div class="dashboard-mobile-row">
                  <span><%= t("dashboard.view.index.buyer") %></span>
                  <strong><%= quote.customer.name %></strong>
                </div>
                <div class="dashboard-mobile-row">
                  <span><%= t("dashboard.view.index.sent") %></span>
                  <strong><%= format_in_user_time(quote.sent_at, current_user) %></strong>
                </div>
                <div class="dashboard-mobile-row">
                  <span><%= t("dashboard.view.index.count") %></span>
                  <strong><%= quote.reminder_count %></strong>
                </div>
              </article>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

    <%= render "dashboard/sales_insights" %>
  </div>
</section>

<script>
  (() => {
    const showLessLabel = "<%= j t("dashboard.view.index.show_less") %>";
    const showMoreLabel = "<%= j t("dashboard.view.index.show_more", count: "%{count}") %>";

    const bindActionToggle = () => {
      document.querySelectorAll("[data-action-toggle]").forEach((toggle) => {
        const extra = document.querySelector("[data-action-more]");
        if (!extra || toggle.dataset.bound === "true") return;
        toggle.dataset.bound = "true";

        const count = Number(toggle.dataset.actionCount || 0);
        const applyState = (expanded) => {
          extra.hidden = !expanded;
          toggle.dataset.expanded = expanded ? "true" : "false";
          toggle.textContent = expanded ? showLessLabel : showMoreLabel.replace("%{count}", String(count));
        };

        applyState(false);

        toggle.addEventListener("click", () => {
          applyState(toggle.dataset.expanded !== "true");
        });
      });

      document.querySelectorAll("[data-action-items-toggle]").forEach((toggle) => {
        const extra = toggle.closest(".dashboard-task-list")?.querySelector("[data-action-items-more]");
        if (!extra || toggle.dataset.bound === "true") return;
        toggle.dataset.bound = "true";

        const count = Number(toggle.dataset.actionCount || 0);
        const applyState = (expanded) => {
          extra.hidden = !expanded;
          toggle.dataset.expanded = expanded ? "true" : "false";
          toggle.textContent = expanded ? showLessLabel : showMoreLabel.replace("%{count}", String(count));
        };

        applyState(false);

        toggle.addEventListener("click", () => {
          applyState(toggle.dataset.expanded !== "true");
        });
      });

      document.querySelectorAll("[data-deal-radar-toggle]").forEach((toggle) => {
        const extra = toggle.closest(".dashboard-action-list")?.querySelector("[data-deal-radar-more]");
        if (!extra || toggle.dataset.bound === "true") return;
        toggle.dataset.bound = "true";

        const count = Number(toggle.dataset.actionCount || 0);
        const applyState = (expanded) => {
          extra.hidden = !expanded;
          toggle.dataset.expanded = expanded ? "true" : "false";
          toggle.textContent = expanded ? showLessLabel : showMoreLabel.replace("%{count}", String(count));
        };

        applyState(false);

        toggle.addEventListener("click", () => {
          applyState(toggle.dataset.expanded !== "true");
        });
      });

      document.querySelectorAll("[data-scroll-target]").forEach((button) => {
        if (button.dataset.boundScroll === "true") return;
        button.dataset.boundScroll = "true";

        button.addEventListener("click", () => {
          const targetId = button.dataset.scrollTarget;
          if (!targetId) return;
          const target = document.getElementById(targetId);
          target?.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      });
    };

    bindActionToggle();
    document.addEventListener("turbo:load", bindActionToggle);
  })();
</script>
