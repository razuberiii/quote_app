<section class="app-page-shell admin-page-shell admin-page-shell--audit-logs">
  <header class="app-page-header">
    <div>
      <h1><%= t("admin.audit_logs.title") %></h1>
      <p><%= t("admin.audit_logs.subtitle") %></p>
    </div>
  </header>

  <section class="app-table-surface">
    <div class="table-responsive admin-table-scroll">
      <table class="app-data-table admin-audit-table">
      <thead>
        <tr>
          <th><%= t("admin.audit_logs.columns.time") %></th>
          <th><%= t("admin.audit_logs.columns.actor") %></th>
          <th><%= t("admin.audit_logs.columns.action") %></th>
          <th><%= t("admin.audit_logs.columns.target") %></th>
          <th><%= t("admin.audit_logs.columns.metadata") %></th>
        </tr>
      </thead>
      <tbody>
        <% @audit_logs.each do |log| %>
          <tr>
            <td><%= format_in_user_time(log.created_at, current_user) %></td>
            <td><%= log.actor&.email || "-" %></td>
            <td><%= log.action %></td>
            <td><%= "#{log.target_type}##{log.target_id}" %></td>
            <td><code class="admin-json-cell"><%= log.metadata.to_json %></code></td>
          </tr>
        <% end %>
      </tbody>
      </table>
    </div>

    <div class="app-pagination">
      <% if @page > 1 %>
        <%= link_to t("admin.pagination.prev"), admin_audit_logs_path(page: @page - 1), class: ui_button_classes(:secondary) %>
      <% end %>
      <span><%= t("admin.pagination.page_of", page: @page, total_pages: [ @total_pages, 1 ].max, total_count: @total_count) %></span>
      <% if @page < @total_pages %>
        <%= link_to t("admin.pagination.next"), admin_audit_logs_path(page: @page + 1), class: ui_button_classes(:secondary) %>
      <% end %>
    </div>
  </section>
</section>
