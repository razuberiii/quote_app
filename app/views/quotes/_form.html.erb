            <p class="quote-form-hint"><%= t("quotes.view.form.formal_closing_hint", default: "Use for settlement closure and signature placeholders, mainly for PI profile output.") %></p>
            <% if formal_closing_presets.any? %>
              <div class="quote-form-add-row quote-form-add-row--preset-actions">
                <p class="quote-form-hint quote-preset-control-hint"><%= t("quotes.view.form.preset_selector_hint", default: "Choosing a preset will overwrite this module's content. Click × to clear.") %></p>
                <div class="quote-preset-control">
                  <select id="quote-module-preset-formal_closing" class="<%= ui_input_classes %> quote-inline-select" data-searchable-select="true" data-search-placeholder="<%= t("quotes.view.form.select_preset", default: "Search preset") %>">
                    <option value=""><%= t("quotes.view.form.select_preset", default: "Select preset") %></option>
                    <% formal_closing_presets.each do |preset| %>
                      <option value="<%= preset[:id] || preset["id"] %>" <%= "selected" if @quote_preset_master&.formal_closing_preset_id.to_i == (preset[:id] || preset["id"]).to_i %>><%= preset[:name] || preset["name"] %></option>
                    <% end %>
                  </select>
                  <button type="button" class="quote-preset-clear-btn js-clear-module-preset" data-module-key="formal_closing" aria-label="<%= t("quotes.view.form.clear_selected_preset", default: "Clear selected preset") %>">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6L18 18M18 6L6 18" /></svg>
                  </button>
                </div>
              </div>
            <% end %>
            <%= hidden_field_tag "quote[seller_signature_image_blob_signed_id]", "", class: "js-formal-closing-seller-signature-blob-id" %>
            <%= hidden_field_tag "quote[seller_stamp_image_blob_signed_id]", "", class: "js-formal-closing-seller-stamp-blob-id" %>
            <%= hidden_field_tag "quote[remove_seller_signature_image]", "0", class: "js-formal-closing-seller-signature-remove" %>
            <%= hidden_field_tag "quote[remove_seller_stamp_image]", "0", class: "js-formal-closing-seller-stamp-remove" %>
          </div>
          <div>
            <label><%= t("quote_document.labels.pi_number", default: "PI #") %></label>
            <%= text_field_tag "quote[formal_closing_block][pi_number]", formal_closing_block["pi_number"], class: ui_input_classes, placeholder: "PI-2026-001" %>
          </div>
          <div>
            <label><%= t("quotes.view.show.field_labels.delivery", default: "Delivery Time") %></label>
            <%= text_field_tag "quote[formal_closing_block][delivery_time]", formal_closing_block["delivery_time"], class: ui_input_classes %>
          </div>
          <div>
            <label><%= t("quote_document.labels.trade_terms", default: "Trade Terms") %></label>
            <%= text_field_tag "quote[formal_closing_block][trade_term]", formal_closing_block["trade_term"], class: ui_input_classes %>
          </div>
          <div>
            <label><%= t("quote_document.labels.payment_terms", default: "Payment Terms") %></label>
            <%= text_field_tag "quote[formal_closing_block][payment_term]", formal_closing_block["payment_term"], class: ui_input_classes %>
          </div>
          <div class="quote-form-grid-span-2">
            <label><%= t("quote_document.labels.bank_route", default: "Bank Route") %></label>
            <%= text_area_tag "quote[formal_closing_block][bank_route]", formal_closing_block["bank_route"], rows: 2, class: ui_input_classes %>
          </div>
          <div class="quote-form-grid-span-2">
            <label><%= t("quote_document.labels.beneficiary_details", default: "Beneficiary Details") %></label>
            <%= text_area_tag "quote[formal_closing_block][beneficiary_details]", formal_closing_block["beneficiary_details"], rows: 2, class: ui_input_classes %>
          </div>
          <div class="quote-form-grid-span-2">
            <label><%= t("quote_document.labels.remittance_note", default: "Remittance Note") %></label>
            <%= text_area_tag "quote[formal_closing_block][remittance_note]", formal_closing_block["remittance_note"], rows: 2, class: ui_input_classes %>
          </div>
          <div>
            <label><%= t("quotes.view.form.seller_signature_image", default: "Seller Signature Image") %></label>
            <%= file_field_tag "quote[seller_signature_image]", accept: "image/png,image/jpeg,image/webp,image/gif,image/svg+xml", class: ui_input_classes("js-formal-closing-seller-signature-upload") %>
            <div class="quote-form-hint js-formal-closing-seller-signature-preview-wrap quote-signature-image-preview" <%= "hidden" unless quote.seller_signature_image.attached? %>>
              <img src="<%= quote.seller_signature_image.attached? ? url_for(quote.seller_signature_image) : "" %>" alt="<%= t("quote_document.labels.seller_signature_line", default: "Seller Signature") %>" class="quote-sales-signature-image js-formal-closing-seller-signature-preview" <%= "hidden" unless quote.seller_signature_image.attached? %>>
              <button type="button" class="quote-signature-image-remove js-formal-closing-seller-signature-remove-btn" aria-label="<%= t("quotes.view.form.remove_seller_signature_image", default: "Remove seller signature image") %>">&times;</button>
            </div>
          </div>
          <div>
            <label><%= t("quotes.view.form.seller_stamp_image", default: "Seller Stamp Image") %></label>
            <%= file_field_tag "quote[seller_stamp_image]", accept: "image/png,image/jpeg,image/webp,image/gif,image/svg+xml", class: ui_input_classes("js-formal-closing-seller-stamp-upload") %>
            <div class="quote-form-hint js-formal-closing-seller-stamp-preview-wrap quote-signature-image-preview" <%= "hidden" unless quote.seller_stamp_image.attached? %>>
              <img src="<%= quote.seller_stamp_image.attached? ? url_for(quote.seller_stamp_image) : "" %>" alt="<%= t("quote_document.labels.seller_stamp_line", default: "Seller Stamp") %>" class="quote-sales-signature-image js-formal-closing-seller-stamp-preview" <%= "hidden" unless quote.seller_stamp_image.attached? %>>
              <button type="button" class="quote-signature-image-remove js-formal-closing-seller-stamp-remove-btn" aria-label="<%= t("quotes.view.form.remove_seller_stamp_image", default: "Remove seller stamp image") %>">&times;</button>
            </div>
          </div>
          <div class="quote-form-grid-span-2">
            <label><%= check_box_tag "quote[formal_closing_block][buyer_signature_line_enabled]", "1", ActiveModel::Type::Boolean.new.cast(formal_closing_block["buyer_signature_line_enabled"]) %> <%= t("quote_document.labels.buyer_signature_line", default: "Show Buyer Signature Line") %></label>
          </div>
        <% end %>
      </div>
    </details>

    <details class="quote-form-section quote-form-panel quote-form-collapsible" open>
      <summary class="quote-form-section-summary quote-form-section-summary--card">
        <strong><%= t("quotes.view.form.internal_information") %></strong>
        <span class="app-form-section-note"><%= t("quotes.view.form.internal_information_hint") %></span>
      </summary>
      <div class="quote-form-section-body">
      <div class="quote-form-grid">
        <div class="quote-form-grid-span-2">
          <%= f.label :notes %>
          <%= f.text_area :notes, rows: 3, maxlength: Quote::MAX_NOTES_LENGTH, placeholder: t("quotes.view.form.internal_notes_placeholder"), class: ui_input_classes %>
        </div>
        <div class="quote-conditional" data-show-when-status="won,accepted">
          <%= f.label :final_amount, t("quotes.view.form.final_amount") %>
          <%= f.number_field :final_amount, step: 0.01, class: ui_input_classes("js-final-amount") %>
        </div>
        <div class="quote-conditional" data-show-when-status="won,accepted">
          <%= f.label :win_reason %>
          <%= f.select :win_reason,
                       Quote.reason_option_pairs_for(:win, company: quote.company),
                       { include_blank: t("quotes.view.form.select_win_reason") },
                       { class: ui_input_classes("js-win-reason"), data: { reason_kind: "win" } } %>
        </div>
        <div class="quote-conditional quote-conditional-detail" data-show-when-status="won,accepted" data-reason-detail-for="win">
          <%= f.label :win_reason_detail, t("quotes.view.form.win_reason_details") %>
          <%= f.text_field :win_reason_detail,
                           placeholder: t("quotes.view.form.win_reason_details_placeholder"),
                           class: ui_input_classes("js-win-reason-detail") %>
        </div>
        <div class="quote-conditional" data-show-when-status="lost">
          <%= f.label :loss_reason %>
          <%= f.select :loss_reason,
                       Quote.reason_option_pairs_for(:loss, company: quote.company),
                       { include_blank: t("quotes.view.form.select_loss_reason") },
                       { class: ui_input_classes("js-loss-reason"), data: { reason_kind: "loss" } } %>
        </div>
        <div class="quote-conditional quote-form-grid-span-2" data-show-when-status="won,accepted,lost">
          <%= render "shared/quote_reason_options_modal",
                     modal_id: "quote-reason-options-modal-form-#{quote.id || "new"}",
                     current_status: quote.status %>
        </div>
        <div class="quote-conditional quote-conditional-detail" data-show-when-status="lost" data-reason-detail-for="loss">
          <%= f.label :loss_reason_detail, t("quotes.view.form.loss_reason_details") %>
          <%= f.text_field :loss_reason_detail,
                           placeholder: t("quotes.view.form.loss_reason_details_placeholder"),
                           class: ui_input_classes("js-loss-reason-detail") %>
        </div>
        <div class="quote-conditional quote-form-grid-span-2" data-show-when-status="sent,viewed,negotiating,expired">
          <%= f.label :stalled_reason, t("quotes.view.form.stalled_reason") %>
          <%= f.select :stalled_reason,
                       Quote.reason_options_for(:stalled).map { |reason| [reason.humanize, reason] },
                       { include_blank: t("quotes.view.form.select_stalled_reason") },
                       { class: ui_input_classes("js-stalled-reason") } %>
        </div>
        <div class="quote-conditional quote-conditional-detail quote-form-grid-span-2" data-show-when-status="sent,viewed,negotiating,expired" data-reason-detail-for="stalled">
          <%= f.label :stalled_reason_detail, t("quotes.view.form.pressure_reason_details") %>
          <%= f.text_field :stalled_reason_detail,
                           placeholder: t("quotes.view.form.pressure_reason_details_placeholder"),
                           class: ui_input_classes("js-stalled-reason-detail") %>
        </div>
      </div>
      </div>
    </details>

    <details class="quote-form-section quote-form-section-totals quote-form-panel quote-form-collapsible" open>
      <summary class="quote-form-section-summary quote-form-section-summary--card">
        <strong><%= t("quotes.view.form.totals_inputs") %></strong>
        <span class="app-form-section-note quote-money-context"><%= t("quotes.view.form.settlement_currency") %>: <strong class="js-currency-code"><%= quote.currency %></strong></span>
      </summary>
      <div class="quote-form-section-body">
      <div class="quote-totals-inputs">
        <div class="quote-form-grid">
          <div>
            <%= f.label :tax_amount, t("quotes.view.form.tax_vat") %>
            <div class="quote-money-input">
              <%= f.number_field :tax_amount, step: 0.01, class: ui_input_classes("js-tax-input"), readonly: pi_mode %>
            </div>
          </div>
          <div>
            <%= f.label :shipping_amount, t("quotes.view.form.shipping_handling") %>
            <div class="quote-money-input">
              <%= f.number_field :shipping_amount, step: 0.01, class: ui_input_classes("js-shipping-input"), readonly: pi_mode %>
            </div>
          </div>
          <div class="quote-discount-row js-discount-row" <%= "hidden" unless quote.discount_amount.to_d.positive? %>>
            <%= f.label :discount_amount, t("quotes.view.form.discount") %>
            <div class="quote-money-input">
              <%= f.number_field :discount_amount, step: 0.01, class: ui_input_classes("js-discount-input"), readonly: pi_mode %>
            </div>
            <button type="button" class="quote-inline-link js-remove-discount" <%= "hidden" if pi_mode %>><%= t("quotes.view.form.remove_discount") %></button>
          </div>
        </div>
        <button type="button" class="quote-inline-link js-add-discount" <%= "hidden" if quote.discount_amount.to_d.positive? || pi_mode %>><%= t("quotes.view.form.add_discount") %></button>
      </div>

      <aside class="quote-live-totals">
        <h4><%= t("quotes.view.form.totals") %></h4>
        <p><span><%= t("quotes.view.form.subtotal") %></span><strong id="quote-live-subtotal"><%= quote_money(subtotal_value, quote.currency) %></strong></p>
        <p><span><%= t("quotes.view.form.addons_total") %></span><strong id="quote-live-addons"><%= quote_money(add_ons_value, quote.currency) %></strong></p>
        <p><span><%= t("quotes.view.form.tax_vat") %></span><strong id="quote-live-tax"><%= quote_money(quote.tax_amount.to_d, quote.currency) %></strong></p>
        <p><span><%= t("quotes.view.form.shipping") %></span><strong id="quote-live-shipping"><%= quote_money(quote.shipping_amount.to_d, quote.currency) %></strong></p>
        <p class="quote-live-reduction js-live-original-total" <%= "hidden" unless quote.discount_amount.to_d.positive? %>><span><%= t("quotes.view.form.original_total") %></span><strong id="quote-live-original-total"><%= quote_money((subtotal_value + quote.tax_amount.to_d + quote.shipping_amount.to_d), quote.currency) %></strong></p>
        <p class="quote-live-discount js-live-discount-row" <%= "hidden" unless quote.discount_amount.to_d.positive? %>><span><%= t("quotes.view.form.discount") %></span><strong id="quote-live-discount"><%= quote_money(quote.discount_amount.to_d, quote.currency) %></strong></p>
        <p class="quote-live-grand"><span><%= t("quotes.view.form.grand_total") %></span><strong id="quote-live-grand"><%= quote_money(grand_total_value, quote.currency) %></strong></p>
        <p class="quote-live-saved js-live-saved-row" <%= "hidden" unless quote.discount_amount.to_d.positive? %>><span><%= t("quotes.view.form.you_save") %></span><strong id="quote-live-saved"><%= quote_money(quote.discount_amount.to_d, quote.currency) %></strong></p>
      </aside>
      </div>
    </details>

    <details class="quote-form-section quote-form-panel quote-form-collapsible" open>
      <summary class="quote-form-section-summary quote-form-section-summary--card">
        <strong><%= t("quotes.view.form.quote_items") %></strong>
        <span class="app-form-section-note"><%= t("quotes.view.form.quote_items_hint") %></span>
      </summary>
      <div class="quote-form-section-body">
      <% fee_item_presets = Array(@quote_presets_by_module&.dig("standard_fee_items")) %>
      <% fee_items_preset_settings_path = quote_presets_path(module_key: "standard_fee_items") %>
      <div class="quote-form-add-row quote-form-add-row--preset-actions">
        <button type="button" class="<%= "#{ui_button_classes(:secondary)} quote-add-item-btn" %>" id="toggle-quote-advanced-mode"><%= t("quotes.view.form.enable_extended_quote_info", default: "Enable Extended Quote Info") %></button>
        <div class="js-fee-preset-controls" <%= "hidden" unless advanced_sections_open %>>
          <% if fee_item_presets.any? %>
            <p class="quote-form-hint quote-preset-control-hint"><%= t("quotes.view.form.standard_fee_items_selector_hint", settings_path: fee_items_preset_settings_path, default: "Select standard logistics fee preset (Templates / Quote Presets / Standard Fee Items).") %></p>
            <div class="quote-preset-control">
              <select id="quote-module-preset-standard_fee_items" class="<%= ui_input_classes %> quote-inline-select" data-searchable-select="true" data-search-placeholder="<%= t("quotes.view.form.select_preset", default: "Search preset") %>">
                <option value=""><%= t("quotes.view.form.select_preset", default: "Select preset") %></option>
                <% fee_item_presets.each do |preset| %>
                  <% preset_payload = preset[:payload] || preset["payload"] || {} %>
                  <option value="<%= preset[:id] || preset["id"] %>" data-payload="<%= preset_payload.to_json %>"><%= preset[:name] || preset["name"] %></option>
                <% end %>
              </select>
              <button type="button" class="quote-preset-clear-btn js-clear-module-preset" data-module-key="standard_fee_items" aria-label="<%= t("quotes.view.form.clear_selected_preset", default: "Clear selected preset") %>">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6L18 18M18 6L6 18" /></svg>
              </button>
            </div>
          <% else %>
            <p class="quote-form-hint quote-form-hint-warning">
              <%= t("quotes.view.form.standard_fee_items_not_configured", default: "Standard logistics fee preset is not configured.") %>
              <%= link_to t("quotes.view.form.configure_standard_fee_items", default: "Configure now"), fee_items_preset_settings_path, class: "quote-kv-add" %>
            </p>
          <% end %>
        </div>
        <button type="button" class="<%= "#{ui_button_classes(:secondary)} quote-add-item-btn" %>" id="insert-quote-fee-items" <%= "hidden" unless advanced_sections_open %> <%= "disabled" unless fee_item_presets.any? %>><%= t("quotes.view.form.insert_standard_fee_items", default: "Insert Standard Logistics Fee Items") %></button>
      </div>
      <p class="quote-form-hint quote-form-hint-warning" id="quote-currency-mismatch-warning" hidden>
        <%= t("quotes.view.form.currency_mismatch_warning") %>
      </p>
      <% if monetary_error_messages.any? %>
        <div class="quote-form-inline-error" role="alert">
          <strong><%= t("quotes.view.form.pricing_attention_needed") %></strong>
          <ul>
            <% monetary_error_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div data-products="<%= products_payload %>" id="quote-items-wrapper">
        <div class="table-responsive quote-items-responsive">
          <table class="quote-items-table app-data-table">
            <thead>
              <tr>
                <th><%= t("quotes.view.form.product_name") %></th>
                <th><%= t("quotes.view.form.specifications") %></th>
                <th><%= t("quotes.view.form.add_ons") %></th>
                <th><%= t("quotes.view.form.unit_price") %></th>
                <th><%= t("quotes.view.form.quantity") %></th>
                <th><%= t("quotes.view.form.remove") %></th>
              </tr>
            </thead>
            <tbody id="quote-items-body">
              <%= f.fields_for :quote_items do |item_fields| %>
                <% item = item_fields.object %>
                <% item_image_attached = item.item_image.attached? && item.item_image.blob&.persisted? %>
                <% product_name = item.product&.name.presence || item.description.to_s %>
                <tr class="quote-item-row">
                  <td class="quote-col-product" data-label="<%= t("quotes.view.form.product_name") %>">
                    <div class="product-search">
                      <input type="text" class="js-product-name <%= ui_input_classes %>" value="<%= product_name %>" placeholder="<%= t("quotes.view.form.type_to_search_product") %>">
                      <div class="js-product-dropdown"></div>
                    </div>
                    <div class="js-product-feedback product-feedback" aria-live="polite"></div>
                    <%= item_fields.hidden_field :id if item.persisted? %>
                    <%= item_fields.hidden_field :product_id, class: "js-product-id" %>
                    <%= item_fields.hidden_field :item_type, class: "js-item-type" %>
                    <%= item_fields.hidden_field :item_image_blob_id, value: "", class: "js-item-image-blob-id" %>
                    <%= item_fields.hidden_field :remove_item_image, value: "0", class: "js-remove-item-image" %>
                    <div class="quote-item-image-tools">
                      <button
                        type="button"
                        class="quote-kv-open js-open-image-editor"
                        data-label-add="<%= t("quotes.view.form.add_image") %>"
                        data-label-change="<%= t("quotes.view.form.change_image") %>"
                      ><%= item_image_attached ? t("quotes.view.form.change_image") : t("quotes.view.form.add_image") %></button>
                    </div>
                    <div class="quote-kv-editor js-item-image-editor" data-kind="image" hidden>
                      <div class="quote-kv-editor-head">
                        <strong><%= t("quotes.view.form.item_image") %></strong>
                        <button type="button" class="quote-kv-close js-kv-close"><%= t("quotes.view.form.close") %></button>
                      </div>
                      <div class="quote-item-image-gallery js-item-image-gallery"></div>
                      <p class="quote-form-hint js-item-image-gallery-empty" hidden><%= t("quotes.view.form.product_gallery_empty") %></p>
                      <div class="quote-item-image-current js-item-image-current<%= ' is-empty' unless item_image_attached %>">
                        <p class="quote-item-image-current-label"><%= t("quotes.view.form.current_selected_image") %></p>
                        <% if item_image_attached %>
                          <%= image_tag item.item_image, class: "quote-item-current-thumb js-item-image-thumb", alt: t("quotes.view.form.item_image_preview") %>
                        <% else %>
                          <img src="" class="quote-item-current-thumb js-item-image-thumb" alt="<%= t("quotes.view.form.item_image_preview") %>" hidden>
                        <% end %>
                        <span class="quote-form-hint js-item-image-empty-hint" <%= "hidden" if item_image_attached %>><%= t("quotes.view.form.no_image_selected") %></span>
                      </div>
                      <div class="quote-item-image-upload">
                        <%= item_fields.file_field :item_image, accept: "image/png,image/jpeg,image/webp,image/gif", class: "quote-item-image-upload-input js-item-image-upload" %>
                      </div>
                      <div class="quote-kv-actions">
                        <button type="button" class="quote-kv-clear js-item-image-remove"><%= t("quotes.view.form.remove_image") %></button>
                      </div>
                    </div>
                  </td>
                  <%= item_fields.hidden_field :description, class: "js-description" %>
                  <td class="quote-col-specs" data-label="<%= t("quotes.view.form.specifications") %>">
                    <% spec_payloads = item.product&.available_spec_preset_payloads || [] %>
                    <select class="js-spec-preset-select quote-inline-select <%= ui_input_classes %>" data-default-id="<%= item.product&.default_spec_preset_id %>">
                      <option value=""><%= t("quotes.view.form.custom_specs") %></option>
                      <% spec_payloads.each do |preset| %>
                        <option value="<%= preset[:id] %>" <%= "selected" if item.product&.default_spec_preset_id.to_s == preset[:id].to_s %>><%= preset[:name] %></option>
                      <% end %>
                    </select>
                    <%= item_fields.text_area :specifications_text, rows: 2, class: "js-specifications sr-only-input", placeholder: "Power: 5kW&#10;Voltage: 220V", hidden: true %>
                    <div class="quote-kv-summary js-spec-summary"
                         data-controller="sortable"
                         data-sortable-enabled-value="true"
                         data-sortable-draggable-selector-value=".quote-kv-chip"
                         data-sortable-filter-value=".quote-kv-summary-empty"></div>
                    <button type="button" class="quote-kv-open js-open-spec-editor"><%= t("quotes.view.form.edit_specs") %></button>
                    <div class="quote-kv-editor js-spec-editor" data-kind="spec" hidden>
                      <div class="quote-kv-editor-head">
                        <strong><%= t("quotes.view.form.specifications") %></strong>
                        <button type="button" class="quote-kv-close js-kv-close"><%= t("quotes.view.form.close") %></button>
                      </div>
                      <div class="quote-kv-bulk">
                        <textarea class="quote-kv-bulk-input js-spec-bulk-input" rows="3" placeholder="<%= t("quotes.view.form.spec_bulk_placeholder") %>"></textarea>
                        <div class="quote-kv-bulk-actions">
                          <button type="button" class="quote-kv-parse js-spec-bulk-apply"><%= t("quotes.view.form.apply_text") %></button>
                          <span class="quote-kv-bulk-check js-spec-bulk-check" aria-live="polite"></span>
                        </div>
                      </div>
                      <div class="quote-kv-rows js-kv-rows">
                        <% spec_rows = item.specification_pairs.presence || [ { key: "", value: "" } ] %>
                        <% spec_rows.each do |pair| %>
                          <div class="quote-kv-row">
                            <input type="text" class="js-kv-key" value="<%= pair[:key] %>" placeholder="<%= t("quotes.view.form.spec_key_placeholder") %>">
                            <input type="text" class="js-kv-value" value="<%= pair[:value] %>" placeholder="<%= t("quotes.view.form.spec_value_placeholder") %>">
                            <button type="button" class="quote-kv-remove js-kv-remove" aria-label="<%= t("quotes.view.form.remove_specification") %>">&times;</button>
                          </div>
                        <% end %>
                      </div>
                      <div class="quote-kv-actions">
                        <button type="button" class="quote-kv-add js-kv-add"><%= t("quotes.view.form.add_spec") %></button>
                        <button type="button" class="quote-kv-clear js-kv-clear-all"><%= t("quotes.view.form.clear_all") %></button>
                      </div>
                    </div>
                  </td>
                  <td class="quote-col-addons" data-label="<%= t("quotes.view.form.add_ons") %>">
                    <% addon_payloads = item.product&.available_addon_preset_payloads || [] %>
                    <select class="js-addon-preset-select quote-inline-select <%= ui_input_classes %>" data-default-id="<%= item.product&.default_addon_preset_id %>">
                      <option value=""><%= t("quotes.view.form.custom_add_ons") %></option>
                      <% addon_payloads.each do |preset| %>
                        <option value="<%= preset[:id] %>" <%= "selected" if item.product&.default_addon_preset_id.to_s == preset[:id].to_s %>><%= preset[:name] %></option>
                      <% end %>
                    </select>
                    <%= item_fields.text_area :addon_charges_text, rows: 2, class: "js-addon-charges sr-only-input", placeholder: "Packaging: 30&#10;Installation: 120", hidden: true %>
                    <div class="quote-kv-summary js-addon-summary"
                         data-controller="sortable"
                         data-sortable-enabled-value="true"
                         data-sortable-draggable-selector-value=".quote-kv-chip"
                         data-sortable-filter-value=".quote-kv-summary-empty"></div>
                    <button type="button" class="quote-kv-open js-open-addon-editor"><%= t("quotes.view.form.edit_add_ons") %></button>
                    <div class="quote-kv-editor js-addon-editor" data-kind="addon" hidden>
                      <div class="quote-kv-editor-head">
                        <strong><%= t("quotes.view.form.add_ons") %></strong>
                        <button type="button" class="quote-kv-close js-kv-close"><%= t("quotes.view.form.close") %></button>
                      </div>
                      <div class="quote-kv-bulk">
                        <textarea class="quote-kv-bulk-input js-addon-bulk-input" rows="3" placeholder="<%= t("quotes.view.form.addon_bulk_placeholder") %>"></textarea>
                        <div class="quote-kv-bulk-actions">
                          <button type="button" class="quote-kv-parse js-addon-bulk-apply"><%= t("quotes.view.form.apply_text") %></button>
                          <span class="quote-kv-bulk-check js-addon-bulk-check" aria-live="polite"></span>
                        </div>
                      </div>
                      <div class="quote-kv-rows js-kv-rows">
                        <% addon_rows = item.addon_charge_entries.presence || [ { name: "", amount: "" } ] %>
                        <% addon_rows.each do |entry| %>
                          <div class="quote-kv-row quote-kv-row-addon">
                            <input type="text" class="js-addon-name" value="<%= entry[:name] %>" placeholder="<%= t("quotes.view.form.addon_name_placeholder") %>">
                            <input type="number" step="0.01" min="0" class="js-addon-amount" value="<%= entry[:amount] %>" placeholder="0.00">
                            <button type="button" class="quote-kv-remove js-kv-remove" aria-label="<%= t("quotes.view.form.remove_add_on") %>">&times;</button>
                          </div>
                        <% end %>
                      </div>
                      <div class="quote-kv-actions">
                        <button type="button" class="quote-kv-add js-kv-add"><%= t("quotes.view.form.add_add_on") %></button>
                        <button type="button" class="quote-kv-clear js-kv-clear-all"><%= t("quotes.view.form.clear_all") %></button>
                      </div>
                    </div>
                  </td>
                  <td class="quote-col-price" data-label="<%= t("quotes.view.form.unit_price") %>">
                    <%= item_fields.number_field :unit_price, step: 0.01, class: ui_input_classes("js-unit-price"), placeholder: "0.00" %>
                  </td>
                  <td class="quote-col-qty" data-label="<%= t("quotes.view.form.quantity") %>">
                    <%= item_fields.number_field :quantity, min: 1, placeholder: "1", class: ui_input_classes("js-quantity") %>
                  </td>
                  <td class="quote-col-remove" data-label="<%= t("quotes.view.form.remove") %>">
                    <%= item_fields.hidden_field :_destroy, class: "js-destroy-flag" %>
                    <button type="button" class="quote-item-remove-icon js-remove-item" aria-label="<%= t("quotes.view.form.remove_item") %>">&times;</button>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <div class="quote-form-add-row">
          <button type="button" class="<%= "#{ui_button_classes(:secondary)} quote-add-item-btn" %>" id="add-quote-item" <%= "disabled" if pi_mode %>><%= t("quotes.view.form.add_item") %></button>
        </div>
      </div>
      </div>
    </details>

    <div class="quote-form-submit">
      <%= f.submit submit_label, class: ui_button_classes(:primary), data: { default_label: submit_label } %>
    </div>
  <% end %>
</div>

<script>
  (function() {
    const isVisibleNode = (element) => {
      if (!element || !document.body.contains(element)) return false;
      const style = window.getComputedStyle(element);
      const rect = element.getBoundingClientRect();
      return style.display !== "none" && style.visibility !== "hidden" && rect.width > 0 && rect.height > 0;
    };

    const pickActiveElement = (selector) => {
      const matches = Array.from(document.querySelectorAll(selector));
      return matches.find(isVisibleNode) || matches[matches.length - 1] || null;
    };

    const root = pickActiveElement("#quote-edit-root");
    const wrapper = pickActiveElement("#quote-items-wrapper");
    const form = pickActiveElement("#quote-form");
    if (!wrapper || !root) return;
    const piMode = <%= pi_mode ? "true" : "false" %>;

    const products = JSON.parse(wrapper.dataset.products || "[]");
    const quotePresetsPayload = <%= raw(quote_preset_payload) %>;
    const quoteMasterPresetMap = <%= raw(quote_master_preset_payload) %>;
    const body = wrapper.querySelector("#quote-items-body");
    const advancedDetails = root.querySelector("details.quote-form-advanced");
    const advancedModeInput = form?.querySelector(".js-advanced-mode-input");
    const addBtn = form?.querySelector("#add-quote-item") || document.getElementById("add-quote-item");
    const advancedModeToggleBtn = form?.querySelector("#toggle-quote-advanced-mode") || document.getElementById("toggle-quote-advanced-mode");
    const insertFeeItemsBtn = form?.querySelector("#insert-quote-fee-items");
    const feePresetControls = form?.querySelector(".js-fee-preset-controls");
    const statusInput = document.querySelector("[name='quote[status]']");
    const currencyInput = document.querySelector("[name='quote[currency]']");
    const validUntilInput = document.querySelector("[name='quote[valid_until]']");
    const finalAmountInput = document.querySelector(".js-final-amount");
    const winReasonInput = document.querySelector(".js-win-reason");
    const winReasonDetailInput = document.querySelector(".js-win-reason-detail");
    const lossReasonInput = document.querySelector(".js-loss-reason");
    const lossReasonDetailInput = document.querySelector(".js-loss-reason-detail");
    const stalledReasonInput = document.querySelector(".js-stalled-reason");
    const stalledReasonDetailInput = document.querySelector(".js-stalled-reason-detail");
    const taxInput = document.querySelector(".js-tax-input");
    const shippingInput = document.querySelector(".js-shipping-input");
    const discountInput = document.querySelector(".js-discount-input");
    const discountRow = document.querySelector(".js-discount-row");
    const addDiscountBtn = document.querySelector(".js-add-discount");
    const removeDiscountBtn = document.querySelector(".js-remove-discount");
    const modulePresetSelects = Array.from(form?.querySelectorAll("select[id^='quote-module-preset-']") || []);
    const formalClosingSellerSignatureBlobInput = form?.querySelector(".js-formal-closing-seller-signature-blob-id");
    const formalClosingSellerStampBlobInput = form?.querySelector(".js-formal-closing-seller-stamp-blob-id");
    const formalClosingSellerSignatureUploadInput = form?.querySelector(".js-formal-closing-seller-signature-upload");
    const formalClosingSellerStampUploadInput = form?.querySelector(".js-formal-closing-seller-stamp-upload");
    const formalClosingSellerSignatureRemoveInput = form?.querySelector(".js-formal-closing-seller-signature-remove");
    const formalClosingSellerStampRemoveInput = form?.querySelector(".js-formal-closing-seller-stamp-remove");
    const formalClosingSellerSignatureRemoveBtn = form?.querySelector(".js-formal-closing-seller-signature-remove-btn");
    const formalClosingSellerStampRemoveBtn = form?.querySelector(".js-formal-closing-seller-stamp-remove-btn");
    const formalClosingSellerSignaturePreviewWrap = form?.querySelector(".js-formal-closing-seller-signature-preview-wrap");
    const formalClosingSellerStampPreviewWrap = form?.querySelector(".js-formal-closing-seller-stamp-preview-wrap");
    const formalClosingSellerSignaturePreview = form?.querySelector(".js-formal-closing-seller-signature-preview");
    const formalClosingSellerStampPreview = form?.querySelector(".js-formal-closing-seller-stamp-preview");

    const statusText = document.getElementById("quote-summary-status-text");
    const statusBadge = document.getElementById("quote-summary-status-badge");
    const summaryGrand = document.getElementById("quote-summary-grand-total");
    const summaryDiscount = document.getElementById("quote-summary-discount-rate");
    const summaryExpiry = document.getElementById("quote-summary-expiry");

    const liveSubtotal = document.getElementById("quote-live-subtotal");
    const liveAddons = document.getElementById("quote-live-addons");
    const liveTax = document.getElementById("quote-live-tax");
    const liveShipping = document.getElementById("quote-live-shipping");
    const liveDiscount = document.getElementById("quote-live-discount");
    const liveOriginalTotal = document.getElementById("quote-live-original-total");
    const liveGrand = document.getElementById("quote-live-grand");
    const liveSaved = document.getElementById("quote-live-saved");
    const liveDiscountRow = document.querySelector(".js-live-discount-row");
    const liveOriginalRow = document.querySelector(".js-live-original-total");
    const liveSavedRow = document.querySelector(".js-live-saved-row");
    const mismatchWarning = document.getElementById("quote-currency-mismatch-warning");
    const submitButton = form?.querySelector("input[type='submit'], button[type='submit']");
    const clientErrorBox = form?.querySelector(".js-quote-client-error");
    const clientErrorList = form?.querySelector(".js-quote-client-error-list");
    const advancedTradeVisibilityInput = form?.querySelector(".js-advanced-visibility-trade");
    const advancedLogisticsVisibilityInput = form?.querySelector(".js-advanced-visibility-logistics");
    const detailPicturesEnabledInput = form?.querySelector(".js-detail-pictures-enabled");
    const containerLoadingEnabledInput = form?.querySelector(".js-container-loading-enabled");
    const containerLoadingNoteEnabledInput = form?.querySelector(".js-container-loading-note-enabled");

    const enforcePiReadonlyMode = () => {
      if (!piMode || !form) return;

      [
        "[name='quote[currency]']",
        "[name='quote[tax_amount]']",
        "[name='quote[shipping_amount]']",
        "[name='quote[discount_amount]']",
        "[name='quote[advanced_mode]']"
