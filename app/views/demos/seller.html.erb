<main class="seller-demo">
  <header class="seller-demo__mast"><div><p class="eyebrow"><%= t("self_service.seller_demo.eyebrow") %></p><h1><%= t("self_service.seller_demo.title") %></h1><p><%= t("self_service.seller_demo.subtitle") %></p></div><div><%= link_to t("self_service.seller_demo.buyer_room"), buyer_demo_path, class: "button button--primary" %><%= link_to t("self_service.seller_demo.start"), new_user_registration_path, class: "button button--secondary" %></div></header>
  <% if @quote %>
    <nav class="seller-demo__nav"><a href="#home"><%= t("self_service.seller_demo.nav.home") %></a><a href="#inquiry"><%= t("self_service.seller_demo.nav.inquiry") %></a><a href="#studio"><%= t("self_service.seller_demo.nav.studio") %></a><a href="#revision"><%= t("self_service.seller_demo.nav.revision") %></a><a href="#activity"><%= t("self_service.seller_demo.nav.activity") %></a><a href="#pi"><%= t("self_service.seller_demo.nav.pi") %></a></nav>
    <section id="home" class="seller-demo__section"><header><span><%= t("self_service.seller_demo.nav.home") %></span><h2><%= t("self_service.seller_demo.overview_title") %></h2></header><div class="seller-demo__metrics"><article><span><%= t("self_service.seller_demo.metrics.open_value") %></span><strong><%= @quote.currency %> <%= number_with_delimiter(@quote.grand_total) %></strong><small><%= t("self_service.seller_demo.metrics.open_help") %></small></article><article><span><%= t("self_service.seller_demo.metrics.latest_revision") %></span><strong>R<%= @revision&.number || 0 %></strong><small><%= @revision&.status&.humanize || t("self_service.seller_demo.metrics.draft") %></small></article><article><span><%= t("self_service.seller_demo.metrics.buyer_signals") %></span><strong><%= @quote.buyer_activities.size %></strong><small><%= t("self_service.seller_demo.metrics.signals_help") %></small></article></div></section>
    <section id="inquiry" class="seller-demo__section seller-demo__split"><header><span><%= t("self_service.seller_demo.inquiry_kicker") %></span><h2><%= t("self_service.seller_demo.inquiry_title") %></h2></header><blockquote><%= t("self_service.seller_demo.inquiry_quote") %></blockquote><div class="seller-demo__facts"><p><span><%= t("self_service.seller_demo.facts.destination") %></span><strong><%= t("self_service.seller_demo.facts.destination_value") %></strong></p><p><span><%= t("self_service.seller_demo.facts.basis") %></span><strong>CIF · USD</strong></p><p><span><%= t("self_service.seller_demo.facts.confirmed") %></span><strong>380V / 50Hz · <%= t("self_service.seller_demo.five_units") %></strong></p><p class="is-warning"><span><%= t("self_service.seller_demo.facts.price_status") %></span><strong><%= t("self_service.seller_demo.facts.freight_required") %></strong></p></div></section>
    <section id="studio" class="seller-demo__section"><header><span><%= t("self_service.seller_demo.nav.studio") %></span><h2><%= t("self_service.seller_demo.studio_title") %></h2></header><div class="seller-demo__studio"><aside><strong><%= t("self_service.seller_demo.cover") %></strong><strong><%= t("self_service.seller_demo.products") %></strong><strong><%= t("self_service.seller_demo.options") %></strong><strong><%= t("self_service.seller_demo.pricing") %></strong><strong><%= t("self_service.seller_demo.shipping") %></strong><strong><%= t("self_service.seller_demo.terms") %></strong><strong><%= t("self_service.seller_demo.acceptance") %></strong></aside><article><p class="eyebrow"><%= t("self_service.seller_demo.prepared_for") %> <%= @quote.customer.name %></p><h3><%= t("self_service.seller_demo.package_title") %></h3><p><%= t("self_service.seller_demo.package_help") %></p><% @quote.quote_items.each do |item| %><div><span><%= item.description %><small><%= item.sku_snapshot.presence || item.product&.sku %> · <%= item.lead_time_snapshot.presence || t("self_service.seller_demo.working_days") %></small></span><strong><%= item.quantity %> × <%= @quote.currency %> <%= number_with_delimiter(item.unit_price) %></strong></div><% end %></article><aside><span><%= t("self_service.seller_demo.total") %></span><strong><%= @quote.currency %> <%= number_with_delimiter(@quote.grand_total) %></strong><small><%= t("self_service.seller_demo.valid_until") %> <%= @quote.valid_until %></small></aside></div></section>
    <section id="revision" class="seller-demo__section"><header><span><%= t("self_service.seller_demo.revision_history") %></span><h2><%= t("self_service.seller_demo.revision_title") %></h2></header><div class="seller-demo__revision"><article><span>R1 · <%= t("self_service.seller_demo.superseded") %></span><strong><%= t("self_service.seller_demo.initial_scope") %></strong><p><%= t("self_service.seller_demo.initial_help") %></p></article><b>→</b><article class="is-current"><span>R<%= @revision&.number || 2 %> · <%= t("self_service.seller_demo.current") %></span><strong><%= t("self_service.seller_demo.current_scope") %></strong><p><%= t("self_service.seller_demo.current_help") %></p></article></div></section>
    <section id="activity" class="seller-demo__section"><header><span><%= t("self_service.seller_demo.nav.activity") %></span><h2><%= t("self_service.seller_demo.activity_title") %></h2></header><div class="seller-demo__activity"><article><span><%= t("self_service.seller_demo.voltage_question") %></span><h3><%= t("self_service.seller_demo.voltage_body") %></h3><p><%= t("self_service.seller_demo.procurement") %></p></article><article><span><%= t("self_service.seller_demo.quantity_request") %></span><h3><%= t("self_service.seller_demo.quantity_body") %></h3><p><%= t("self_service.seller_demo.quantity_help") %></p></article></div></section>
    <section id="pi" class="seller-demo__section seller-demo__pi"><header><span><%= t("self_service.seller_demo.pi_kicker") %></span><h2><%= t("self_service.seller_demo.pi_title") %></h2></header><div><span><%= t("self_service.seller_demo.proforma_invoice") %></span><strong>PI-2026-0042</strong><p><%= @quote.customer.name %> · <%= @quote.currency %> <%= number_with_delimiter(@quote.grand_total) %></p><small><%= t("self_service.seller_demo.awaiting_deposit") %></small></div></section>
  <% else %><section class="seller-demo__empty"><h2><%= t("self_service.seller_demo.empty_title") %></h2><p><%= t("self_service.seller_demo.empty_help") %></p></section><% end %>
</main>
