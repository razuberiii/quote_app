    let rowCounter = body.querySelectorAll(".quote-item-row").length;
    let discountEnabled = !!(discountRow && !discountRow.hidden);

    function parseNumber(value) {
      const number = parseFloat(value || "0");
      return Number.isFinite(number) ? number : 0;
    }

    function parseInteger(value) {
      const number = parseInt(value || "0", 10);
      return Number.isFinite(number) ? number : 0;
    }

    function parseLooseNumber(value) {
      if (value === null || value === undefined) return Number.NaN;
      const normalized = String(value).replace(/\u00a0/g, " ").replace(/,/g, "").trim();
      if (!normalized) return Number.NaN;
      return Number(normalized);
    }

    function parseFeePresetRows(presetPayload) {
      if (!presetPayload || typeof presetPayload !== "object") return [];
      const rawRows = presetPayload.rows;
      const rows = Array.isArray(rawRows) ? rawRows : (rawRows && typeof rawRows === "object" ? Object.values(rawRows) : []);
      return rows
        .map((row) => {
          const name = String(row?.name || "").trim();
          const unitPriceNumber = parseLooseNumber(row?.unit_price);
          const quantityNumber = parseLooseNumber(row?.quantity ?? 1);
          if (!name || !Number.isFinite(unitPriceNumber) || !Number.isFinite(quantityNumber) || quantityNumber <= 0 || unitPriceNumber < 0) return null;
          return {
            item_type: "fee_custom",
            title: name,
            description: name,
            unit_price: unitPriceNumber.toFixed(2),
            quantity: Math.floor(quantityNumber)
          };
        })
        .filter(Boolean);
    }

    function normalizePresetText(value) {
      return String(value || "")
        .replace(/\u00a0/g, " ")
        .replace(/\s+/g, " ")
        .trim()
        .toLowerCase();
    }

    function searchableInputForSelect(select) {
      if (!select) return null;
      const wrapper = select.previousElementSibling;
      if (!wrapper) return null;
      if (!wrapper.querySelector) return null;
      return wrapper.querySelector("input[type='text']");
    }

    function feePresetSelectNode() {
      const activeForm = insertFeeItemsBtn?.closest("form") || form || pickActiveElement("#quote-form");
      return activeForm?.querySelector("#quote-module-preset-standard_fee_items") || null;
    }

    function syncSearchableSelectInput(select) {
      if (!select) return;
      const input = searchableInputForSelect(select);
      if (!input) return;
      if (String(select.value || "").trim().length === 0) {
        input.value = "";
        return;
      }
      const selected = Array.from(select.options || []).find((option) => String(option.value || "") === String(select.value || ""));
      input.value = selected ? String(selected.textContent || "").trim() : "";
    }

    function resolveSelectValueFromSearchInput(select) {
      if (!select) return;
      if (String(select.value || "").trim().length > 0) return;
      const input = searchableInputForSelect(select);
      const typed = normalizePresetText(input?.value);
      if (!typed) return;
      const matched = Array.from(select.options || []).find((option) => normalizePresetText(option.textContent) === typed);
      if (!matched) return;
      select.value = String(matched.value || "");
      syncSearchableSelectInput(select);
    }

    function resolveSelectedFeePreset() {
      const result = { status: "not_selected", preset: null, rows: [] };
      const standardFeePresetSelect = feePresetSelectNode();
      if (!standardFeePresetSelect) return result;
      resolveSelectValueFromSearchInput(standardFeePresetSelect);
      const selectedId = String(standardFeePresetSelect.value || "").trim();
      if (!selectedId) return result;
      const selectedOption = Array.from(standardFeePresetSelect.options || []).find((option) => String(option.value || "").trim() === selectedId) || null;
      if (!selectedOption) return result;
      let selectedPayload = {};
      const payloadText = selectedOption.dataset?.payload;
      if (payloadText) {
        try {
          selectedPayload = JSON.parse(payloadText);
        } catch (_error) {
          selectedPayload = {};
        }
      }
      const rows = parseFeePresetRows(selectedPayload);
      result.preset = { id: selectedId, name: String(selectedOption.textContent || "").trim(), payload: selectedPayload };
      result.rows = rows;
      result.status = rows.length > 0 ? "selected" : "selected_but_no_rows";
      return result;
    }

    function parseAddonTotal(text) {
      return String(text || "").split(/\r?\n/).reduce((sum, line) => {
        const parts = line.split(/[:=：]/, 2);
        if (parts.length < 2) return sum;
        const amount = parseNumber(parts[1]);
        return amount >= 0 ? sum + amount : sum;
      }, 0);
    }

    function currentCurrency() {
      return (currencyInput?.value || "USD").toUpperCase();
    }

    function refreshCurrencyCodeTags() {
      const code = currentCurrency();
      document.querySelectorAll(".js-currency-code").forEach((el) => {
        el.textContent = code;
      });
    }

    function formatMoney(amount, currencyCode) {
      const value = parseNumber(amount).toFixed(2);
      const code = (currencyCode || "USD").toUpperCase();
      const symbol = currencySymbols[code] || code;
      if (symbol === code) return `${code} ${value}`;
      return `${symbol}${value}`;
    }

    function decodeRichText(text) {
      const el = document.createElement("textarea");
      el.innerHTML = String(text || "");
      return el.value;
    }

    function escapeHtml(text) {
      return String(text || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function escapeAttr(text) {
      return escapeHtml(text).replace(/`/g, "&#96;");
    }

    function normalizeSpecificationText(text) {
      return decodeRichText(text)
        .replace(/&#10;|&#x0a;|&#13;|&#x0d;/gi, "\n")
        .replace(/\r\n?/g, "\n")
        .trim();
    }

    function advancedModeEnabled() {
      return String(advancedModeInput?.value || "0") === "1";
    }

    function setAdvancedMode(enabled, options = {}) {
      if (!advancedModeInput) return;
      advancedModeInput.value = enabled ? "1" : "0";

      if (advancedDetails) {
        advancedDetails.hidden = !enabled;
        advancedDetails.open = enabled;
      }

      if (insertFeeItemsBtn) insertFeeItemsBtn.hidden = !enabled;
      if (feePresetControls) feePresetControls.hidden = !enabled;
      if (advancedModeToggleBtn) advancedModeToggleBtn.textContent = enabled ? disableExtendedLabel : enableExtendedLabel;

      if (!enabled) {
        if (advancedTradeVisibilityInput) advancedTradeVisibilityInput.value = "0";
        if (advancedLogisticsVisibilityInput) advancedLogisticsVisibilityInput.value = "0";
      } else {
        if (advancedTradeVisibilityInput) advancedTradeVisibilityInput.value = "1";
        if (advancedLogisticsVisibilityInput) advancedLogisticsVisibilityInput.value = "1";
      }
    }

    function setEmptyHintVisibility(container, rowSelector, hintSelector) {
      if (!container) return;
      const hint = container.querySelector(hintSelector);
      if (!hint) return;
      const rows = Array.from(container.querySelectorAll(rowSelector));
      hint.hidden = rows.length > 0;
