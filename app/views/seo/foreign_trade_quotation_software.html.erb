<div class="seo-page-shell">
<section class="marketing-section seo-hero-block" id="introduction">
  <div class="seo-hero-grid">
    <div class="marketing-section-head">
      <p class="marketing-kicker"><%= t("seo.view.foreign_trade_quotation_software.hero.kicker") %></p>
      <h1><%= t("seo.view.foreign_trade_quotation_software.hero.title") %></h1>
      <p class="seo-summary"><strong><%= t("seo.view.foreign_trade_quotation_software.hero.summary") %></strong></p>
      <p><%= t("seo.view.foreign_trade_quotation_software.hero.paragraph_1") %></p>
      <p><%= t("seo.view.foreign_trade_quotation_software.hero.paragraph_2") %></p>
      <div class="marketing-proof-strip">
        <span><%= t("seo.view.foreign_trade_quotation_software.hero.proof_1") %></span>
        <span><%= t("seo.view.foreign_trade_quotation_software.hero.proof_2") %></span>
        <span><%= t("seo.view.foreign_trade_quotation_software.hero.proof_3") %></span>
      </div>
      <div class="marketing-cta-row seo-hero-actions">
        <%= link_to t("seo.view.foreign_trade_quotation_software.hero.start_free"), new_user_registration_path, class: "btn btn-primary marketing-cta-primary" %>
        <%= link_to t("seo.view.foreign_trade_quotation_software.hero.live_example"), sample_quote_path, class: "btn btn-secondary marketing-cta-secondary", target: "_blank" %>
      </div>
    </div>
    <aside class="seo-hero-artifact">
      <article class="seo-signal-card is-strong">
        <span class="seo-signal-label"><%= t("seo.view.foreign_trade_quotation_software.signals.primary_gain.label") %></span>
        <strong><%= t("seo.view.foreign_trade_quotation_software.signals.primary_gain.title") %></strong>
        <p><%= t("seo.view.foreign_trade_quotation_software.signals.primary_gain.detail") %></p>
      </article>
      <article class="seo-signal-card">
        <span class="seo-signal-label"><%= t("seo.view.foreign_trade_quotation_software.signals.workflow.label") %></span>
        <strong><%= t("seo.view.foreign_trade_quotation_software.signals.workflow.title") %></strong>
        <p><%= t("seo.view.foreign_trade_quotation_software.signals.workflow.detail") %></p>
      </article>
      <article class="seo-signal-card">
        <span class="seo-signal-label"><%= t("seo.view.foreign_trade_quotation_software.signals.fit.label") %></span>
        <strong><%= t("seo.view.foreign_trade_quotation_software.signals.fit.title") %></strong>
        <p><%= t("seo.view.foreign_trade_quotation_software.signals.fit.detail") %></p>
      </article>
    </aside>
  </div>
</section>

