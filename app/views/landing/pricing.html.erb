<% content_for :title, "Pricing · Rubusoo" %>
<main class="rb-page">
  <header class="rb-page-head">
    <div>
      <p class="eyebrow">Simple, honest pricing</p>
      <h1>Close the first deal before you pay.</h1>
    </div>
    <p>Start with every core workflow unlocked. Upgrade when your team and quote volume grow—not because a buyer needs to open a link.</p>
  </header>

  <% plans = [
    { name: "Trial", price: "$0", note: "14 days · no card required", features: ["5 sent quotations", "Buyer Rooms", "PDF and Excel export"], action: "Start free", style: :secondary },
    { name: "Solo", price: "$15", note: "per month · one seller", features: ["30 sent quotations", "Revision history", "Buyer activity signals"], action: "Choose Solo", style: :secondary, plan: "solo" },
    { name: "Pro", price: "$29", note: "per month · up to 3 users", features: ["150 sent quotations", "Team workspace", "Acceptance and PI conversion"], action: "Choose Pro", style: :secondary, plan: "pro" },
    { name: "Business", price: "$69", note: "per month · growing teams", features: ["Team controls", "Assisted catalog import", "Priority support"], action: "Talk to us", style: :secondary, contact: true }
  ] %>
  <div class="pricing-grid">
    <% plans.each do |plan| %>
      <section>
        <span class="pricing-plan"><%= plan[:name] %></span>
        <strong class="pricing-price"><%= plan[:price] %></strong>
        <p class="pricing-description"><%= plan[:note] %></p>
        <ul class="pricing-features">
          <% plan[:features].each do |feature| %><li><%= feature %></li><% end %>
        </ul>
        <% if plan[:contact] %>
          <%= link_to plan[:action], contact_path, class: "button button--secondary" %>
        <% elsif user_signed_in? && plan[:plan] %>
          <%= button_to plan[:action], billing_checkout_path(plan: plan[:plan]), class: "button button--secondary button--full" %>
        <% else %>
          <%= link_to plan[:action], new_user_registration_path, class: "button button--#{plan[:style]}" %>
        <% end %>
      </section>
    <% end %>
  </div>
</main>
