<main class="deal-workspace operator-console">
  <header class="deal-page-header"><div><p class="eyebrow">Private operations</p><h1>Operator Console</h1><p>Support access, account safety and an auditable record of exceptional actions. This is not a customer dashboard.</p></div><%= link_to "Audit log", admin_audit_logs_path, class: "button button--secondary" %></header>
  <section class="operator-signals"><article><span>Total accounts</span><strong><%= @total_users %></strong></article><article><span>New · 7 days</span><strong><%= @new_users_last_7_days %></strong></article><article><span>Active</span><strong><%= @active_users_count %></strong></article><article class="is-risk"><span>Suspended</span><strong><%= @suspended_users_count %></strong></article></section>
  <section class="operator-action"><div><p class="eyebrow">Controlled broadcast</p><h2>Send an operational notice</h2><p>Use only for service-affecting information. The action is recorded in the audit trail.</p></div><%= form_with url: admin_notifications_path, method: :post, scope: :announcement, local: true do |f| %><%= f.label :title, "Title" %><%= f.text_field :title, required: true, maxlength: 120 %><%= f.label :message, "Message" %><%= f.text_area :message, rows: 5, required: true %><%= f.label :link_url, "Reference URL (optional)" %><%= f.url_field :link_url %><%= f.submit "Review and send", class: "button button--primary", data: { turbo_confirm: t("admin.notifications.actions.confirm_send_all") } %><% end %></section>
</main>
