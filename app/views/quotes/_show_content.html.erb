<script>
  window.__mountTurnstileModalToBody ||= (modal) => {
    if (!modal || modal.dataset.bodyMounted === "true") return;
    if (modal.parentElement !== document.body) {
      document.body.appendChild(modal);
    }
    modal.dataset.bodyMounted = "true";
  };

  window.__mountAllTurnstileModals ||= () => {
    document.querySelectorAll(".quote-turnstile-modal").forEach((modal) => {
      window.__mountTurnstileModalToBody(modal);
    });
  };

  window.__mountAllTurnstileModals();

  (() => {
    const button = document.querySelector(".js-share-public-link");
    const shareMenu = button?.closest(".quote-toolbar-export");
    const panel = document.getElementById("quote-share-panel");
    const message = document.getElementById("quote-share-message");
    const copyButton = document.getElementById("quote-share-copy-btn");
    const openLink = document.getElementById("quote-share-open-link");
    const copyMessageButton = document.getElementById("quote-share-copy-message-btn");
    const whatsappButton = document.getElementById("quote-share-whatsapp-btn");
    const messageEditor = document.getElementById("quote-share-message-editor");
    const lastSharedAt = document.getElementById("quote-last-shared-at");
    if (!button || !panel || !message || !copyButton || !openLink || button.dataset.bound === "true") return;
    button.dataset.bound = "true";

    const csrf = document.querySelector("meta[name='csrf-token']")?.content;
    const commsData = window.__quoteShareCommsData || {};
    const quoteId = "<%= @quote.id %>";
    const draftStorageKey = `quote-share-draft:${quoteId}`;
    const sharePanelState = window.__quoteSharePanelState || {
      visible: false,
      message: "",
      isError: false,
      currentShareUrl: "",
      openHref: "#",
      openHidden: true,
      messageDraft: "",
      shareMenuOpen: false
    };
    window.__quoteSharePanelState = sharePanelState;
    let currentShareUrl = "";

    const persistMessageDraft = () => {
      if (!messageEditor) return;
      try {
        sessionStorage.setItem(draftStorageKey, messageEditor.value || "");
      } catch (_) {
        // Ignore storage failures in restricted browser modes.
      }
    };

    const readPersistedMessageDraft = () => {
      try {
        return sessionStorage.getItem(draftStorageKey) || "";
      } catch (_) {
        return "";
      }
    };

    const setTemporaryButtonLabel = (buttonEl, text) => {
      if (!buttonEl || !text) return;
      const original = buttonEl.dataset.defaultLabel || buttonEl.textContent || "";
      buttonEl.dataset.defaultLabel = original;
      buttonEl.textContent = text;
      buttonEl.disabled = true;
      window.setTimeout(() => {
        buttonEl.textContent = original;
        buttonEl.disabled = false;
      }, 1200);
    };

    const markSentLocally = ({ refresh = true } = {}) => {
      const statusBadge = document.querySelector(".quote-doc-header .app-status-badge");
      if (statusBadge) {
        statusBadge.className = "app-status-badge app-status-badge--blue";
        statusBadge.textContent = "<%= j(t('quotes.view.form.status_options.sent')) %>";
      }

      const statusSummary = document.querySelector(".quote-toolbar-status-control > summary");
      if (statusSummary) {
        statusSummary.textContent = "<%= j(t('quotes.view.show.toolbar.status_selector', status: t('quotes.view.form.status_options.sent'))) %>";
      }

      const statusFieldLabels = [
        "<%= j(t('quotes.view.pdf.status', default: 'Status')) %>",
        "Status",
        "状态"
      ].map((label) => (label || "").trim().toLowerCase());
      const quoteInfoRows = document.querySelectorAll(".quote-summary-info dt");
      quoteInfoRows.forEach((labelEl) => {
        const normalized = (labelEl.textContent || "").trim().toLowerCase();
        if (!statusFieldLabels.includes(normalized)) return;
        const valueEl = labelEl.nextElementSibling;
        if (valueEl) valueEl.textContent = "<%= j(t('quotes.view.form.status_options.sent')) %>";
      });

      document.querySelectorAll(".js-preview-menu").forEach((menu) => {
        menu.hidden = true;
        menu.removeAttribute("open");
      });

      if (refresh) {
        // Trigger an immediate re-render so action buttons reflect sent state without waiting polling.
        window.setTimeout(() => {
          window.refreshQuoteState?.(true, true);
        }, 120);

        // Fallback refresh in case the first refresh races with file-share update timing.
        window.setTimeout(() => {
          window.refreshQuoteState?.(true, true);
        }, 1400);
      }
    };
    window.__markQuoteSentLocally = () => markSentLocally({ refresh: true });

    const syncPanelState = () => {
      sharePanelState.visible = !panel.hidden;
      sharePanelState.message = message.textContent || "";
      sharePanelState.isError = panel.classList.contains("is-error");
      sharePanelState.currentShareUrl = currentShareUrl;
      sharePanelState.openHref = openLink.getAttribute("href") || "#";
      sharePanelState.openHidden = openLink.hidden;
      sharePanelState.messageDraft = messageEditor?.value || "";
      sharePanelState.shareMenuOpen = !!shareMenu?.hasAttribute("open");
      persistMessageDraft();
    };

    const showPanel = (text, isError = false) => {
      if (shareMenu) shareMenu.setAttribute("open", "");
      message.textContent = text;
      panel.classList.toggle("is-error", isError);
      panel.hidden = false;
      syncPanelState();

      // If panel extends beyond viewport, auto-scroll page so action buttons are visible.
      window.requestAnimationFrame(() => {
        const rect = panel.getBoundingClientRect();
        const viewportBottom = window.innerHeight;
        const margin = 16;

        if (rect.bottom > viewportBottom - margin) {
          const delta = rect.bottom - viewportBottom + margin;
          window.scrollBy({ top: delta, behavior: "smooth" });
        } else if (rect.top < margin) {
          const delta = rect.top - margin;
          window.scrollBy({ top: delta, behavior: "smooth" });
        }
      });
    };

    const hidePanel = () => {
      panel.hidden = true;
      syncPanelState();
    };

    const copyText = async (text) => {
      try {
        if (navigator.clipboard?.writeText && window.isSecureContext) {
          await navigator.clipboard.writeText(text);
          return true;
        }
      } catch (_) {
        // Fallback to legacy copy path below.
      }

      try {
        const textarea = document.createElement("textarea");
        textarea.value = text;
        textarea.setAttribute("readonly", "");
        textarea.style.position = "fixed";
        textarea.style.top = "-9999px";
        textarea.style.left = "-9999px";
        document.body.appendChild(textarea);
        textarea.focus();
        textarea.select();
        const ok = document.execCommand("copy");
        document.body.removeChild(textarea);
        return !!ok;
      } catch (_) {
        return false;
      }
    };

    const buildDefaultMessage = () => (commsData.messageTemplate || "").replace("__SHARE_URL__", currentShareUrl);
    const buildMessage = () => {
      const draft = messageEditor?.value?.trim();
      return draft || buildDefaultMessage();
    };
    const whatsappPhone = (commsData.phone || "").replace(/[^\d+]/g, "");

    const syncWhatsappHref = () => {
      if (!whatsappButton) return;

      if (!currentShareUrl || !whatsappPhone) {
        whatsappButton.href = "#";
        return;
      }

      whatsappButton.href = `https://wa.me/${whatsappPhone}?text=${encodeURIComponent(buildMessage())}`;
    };

    const ensureMarkedSent = async () => {
      const markSentUrl = button.dataset.markSentUrl || "";
      if (!markSentUrl) return;

      const response = await fetch(markSentUrl, {
        method: "POST",
        headers: {
          "Accept": "text/vnd.turbo-stream.html, text/html, application/xhtml+xml",
          "X-CSRF-Token": csrf || ""
        },
        credentials: "same-origin"
      });

      if (response.ok) {
        markSentLocally({ refresh: false });
      }
    };

    button.addEventListener("click", async () => {
      button.disabled = true;
      try {
        // Optimistic UI: reflect sent status immediately for keyboard shortcut flow.
        markSentLocally({ refresh: false });

        const existingUrl = button.dataset.existingUrl || "";
        const shareUrl = button.dataset.shareUrl || "";
        if (!shareUrl && existingUrl) {
          await ensureMarkedSent();
          currentShareUrl = existingUrl;
          openLink.href = existingUrl;
          openLink.hidden = false;
          if (messageEditor) {
            messageEditor.value = readPersistedMessageDraft() || buildDefaultMessage();
            persistMessageDraft();
          }
          syncWhatsappHref();
          const canAutoCopy = navigator.userActivation?.isActive ?? true;
          const copied = canAutoCopy ? await copyText(existingUrl) : false;
          syncPanelState();
          if (copied) {
            showPanel("<%= j(t("quotes.view.show.toolbar.public_link_ready_copied")) %>");
            window.showAppToast?.("<%= j(t("quotes.view.show.toolbar.public_link_copied")) %>", "success");
          } else {
            showPanel("<%= j(t("quotes.view.show.toolbar.public_link_ready_manual")) %>");
            window.showAppToast?.("<%= j(t("quotes.view.show.toolbar.public_link_ready_manual")) %>", "warn");
          }
          return;
        }

        const response = await fetch(shareUrl, {
          method: "POST",
          headers: {
            "Accept": "application/json",
            "Content-Type": "application/json",
            "X-CSRF-Token": csrf || ""
          },
          credentials: "same-origin",
          body: JSON.stringify({})
        });

        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !payload.url) {
          throw new Error(payload.message || "<%= j(t("quotes.view.show.toolbar.unable_generate_public_link")) %>");
        }

        await ensureMarkedSent();
        markSentLocally({ refresh: false });
        const canAutoCopy = navigator.userActivation?.isActive ?? true;
        const copied = canAutoCopy ? await copyText(payload.url) : false;
        currentShareUrl = payload.url;
        if (messageEditor) {
          messageEditor.value = buildDefaultMessage();
          persistMessageDraft();
        }
        syncWhatsappHref();
        try {
          const previewUrl = new URL(payload.url, window.location.origin);
          previewUrl.searchParams.set("preview", "1");
          openLink.href = previewUrl.toString();
        } catch (_) {
          const separator = payload.url.includes("?") ? "&" : "?";
          openLink.href = `${payload.url}${separator}preview=1`;
        }
        openLink.hidden = false;
        syncPanelState();
        if (lastSharedAt) {
          const now = new Date();
          const pad = (n) => String(n).padStart(2, "0");
          const stamp = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())} ${pad(now.getHours())}:${pad(now.getMinutes())}`;
          lastSharedAt.textContent = stamp;
        }
        if (copied) {
          showPanel("<%= j(t("quotes.view.show.toolbar.public_link_ready_copied")) %>");
          window.showAppToast?.("<%= j(t("quotes.view.show.toolbar.public_link_copied")) %>", "success");
        } else {
          showPanel("<%= j(t("quotes.view.show.toolbar.public_link_ready_manual")) %>");
          window.showAppToast?.("<%= j(t("quotes.view.show.toolbar.public_link_ready_manual")) %>", "warn");
        }

        // Refresh action area once after successful send so server-driven button states switch immediately.
        window.setTimeout(() => {
          window.refreshQuoteState?.(true, true);
        }, 220);
      } catch (error) {
        currentShareUrl = "";
        syncWhatsappHref();
        openLink.href = "#";
        openLink.hidden = true;
        syncPanelState();
        showPanel(error.message || "<%= j(t("quotes.view.show.toolbar.share_failed")) %>", true);
        window.showAppToast?.(error.message || "<%= j(t("quotes.view.show.toolbar.share_failed")) %>", "error");
      } finally {
        button.disabled = false;
      }
    });

    copyButton.addEventListener("click", async () => {
      if (!currentShareUrl) return;
      const copied = await copyText(currentShareUrl);
      showPanel(copied ? "<%= j(t("quotes.view.show.toolbar.link_copied")) %>" : "<%= j(t("quotes.view.show.toolbar.copy_failed_browser")) %>", !copied);
      if (copied) {
        setTemporaryButtonLabel(copyButton, "<%= j(t("quotes.view.show.toolbar.link_copied")) %>");
      }
      window.showAppToast?.(copied ? "<%= j(t("quotes.view.show.toolbar.link_copied")) %>" : "<%= j(t("quotes.view.show.toolbar.copy_failed_browser")) %>", copied ? "success" : "error");
    });

    copyMessageButton?.addEventListener("click", async () => {
      if (!currentShareUrl) return;
      const copied = await copyText(buildMessage());
      showPanel(copied ? "<%= j(t("quotes.view.show.comms.message_copied", default: "Message copied!")) %>" : "<%= j(t("quotes.view.show.toolbar.copy_failed_browser")) %>", !copied);
      if (copied) {
        setTemporaryButtonLabel(copyMessageButton, "<%= j(t("quotes.view.show.comms.message_copied", default: "Message copied!")) %>");
      }
      window.showAppToast?.(copied ? "<%= j(t("quotes.view.show.comms.message_copied", default: "Message copied!")) %>" : "<%= j(t("quotes.view.show.toolbar.copy_failed_browser")) %>", copied ? "success" : "error");
    });

    whatsappButton?.addEventListener("click", (event) => {
      if (!currentShareUrl || !whatsappPhone) {
        event.preventDefault();
        return;
      }

      hidePanel();
      window.showAppToast?.("<%= j(t("quotes.view.show.comms.whatsapp_opened", default: "WhatsApp opened")) %>", "success");
    });

    openLink.addEventListener("click", () => {
      hidePanel();
    });

    messageEditor?.addEventListener("input", () => {
      persistMessageDraft();
      syncPanelState();
      syncWhatsappHref();
    });

    document.addEventListener("click", (event) => {
      if (panel.hidden) return;
      if (event.target.closest(".share-link-group")) return;
      hidePanel();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") hidePanel();
    });

    currentShareUrl = sharePanelState.currentShareUrl || "";
    if (sharePanelState.shareMenuOpen && shareMenu) {
      shareMenu.setAttribute("open", "");
    }
    if (messageEditor) {
      messageEditor.value = sharePanelState.messageDraft || readPersistedMessageDraft() || (currentShareUrl ? buildDefaultMessage() : "");
    }
    syncWhatsappHref();
    openLink.href = sharePanelState.openHref || "#";
    openLink.hidden = sharePanelState.openHidden !== false;
    if (sharePanelState.visible) {
      showPanel(sharePanelState.message || "<%= j(t("quotes.view.show.toolbar.public_link_ready")) %>", !!sharePanelState.isError);
    } else {
      hidePanel();
    }
  })();

  (() => {
    const modals = document.querySelectorAll(".quote-reason-modal");
    if (!modals.length) return;

    const closeReasonModal = (modal) => {
      if (!modal) return;
      modal.hidden = true;
    };

    const syncReasonDetail = (modal) => {
      const select = modal.querySelector(".js-quote-reason-kind");
      const detailWrap = modal.querySelector(".js-quote-reason-detail-wrap");
      if (!select || !detailWrap) return;
      detailWrap.hidden = select.value !== "other";
    };

    modals.forEach((modal) => {
      window.__mountTurnstileModalToBody(modal);
      syncReasonDetail(modal);
      if (modal.dataset.openByDefault === "true") {
        modal.hidden = false;
      }
    });

    document.addEventListener("change", (event) => {
      if (!event.target.matches(".js-quote-reason-kind")) return;
      syncReasonDetail(event.target.closest(".quote-reason-modal"));
    });

    document.addEventListener("click", (event) => {
      const openButton = event.target.closest(".js-quote-reason-open");
      if (openButton) {
        const modal = document.getElementById(openButton.dataset.reasonModalId);
        if (!modal) return;
        event.preventDefault();
        modal.hidden = false;
        syncReasonDetail(modal);
        return;
      }

      const closeButton = event.target.closest(".js-quote-reason-close");
      if (closeButton) {
        closeReasonModal(closeButton.closest(".quote-reason-modal"));
        return;
      }

      if (event.target.classList.contains("quote-reason-modal")) {
        closeReasonModal(event.target);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      modals.forEach((modal) => closeReasonModal(modal));
    });
  })();

  (() => {
    const undoData = document.getElementById("quote-status-undo-data");
    if (!undoData) return;

    const postUrl = undoData.dataset.url;
    const token = undoData.dataset.token;
    const expiresAtRaw = undoData.dataset.expiresAt;
    if (!postUrl || !token || !expiresAtRaw) return;

    const expiresAt = new Date(expiresAtRaw);
    if (Number.isNaN(expiresAt.getTime()) || expiresAt.getTime() <= Date.now()) return;

    const wrap = document.createElement("div");
    wrap.className = "quote-status-undo";
    const text = document.createElement("span");
    text.className = "quote-status-undo-text";
    const button = document.createElement("button");
    button.type = "button";
    button.className = "<%= j(ui_button_classes(:secondary, "quote-status-undo-btn")) %>";
    button.textContent = "<%= j(t("quotes.view.show.toolbar.undo")) %>";
    wrap.append(text, button);
    document.body.appendChild(wrap);

    const updateCountdown = () => {
      const left = Math.max(0, Math.ceil((expiresAt.getTime() - Date.now()) / 1000));
      text.textContent = "<%= j(t("quotes.view.show.toolbar.undo_status_change_prefix")) %> (${left}s)";
      if (left <= 0) {
        wrap.remove();
        return false;
      }

      return true;
    };

    if (!updateCountdown()) return;

    const timer = window.setInterval(() => {
      if (!updateCountdown()) {
        window.clearInterval(timer);
      }
    }, 250);

    button.addEventListener("click", () => {
      button.disabled = true;
      const form = document.createElement("form");
      form.method = "post";
      form.action = postUrl;

      const csrfToken = document.querySelector("meta[name='csrf-token']")?.content;
      if (csrfToken) {
        const csrfInput = document.createElement("input");
        csrfInput.type = "hidden";
        csrfInput.name = "authenticity_token";
        csrfInput.value = csrfToken;
        form.appendChild(csrfInput);
      }

      const tokenInput = document.createElement("input");
      tokenInput.type = "hidden";
      tokenInput.name = "token";
      tokenInput.value = token;
      form.appendChild(tokenInput);

      document.body.appendChild(form);
      form.submit();
    });
  })();

  (() => {
    const exportMenus = document.querySelectorAll(".quote-toolbar-export");
    if (!exportMenus.length) return;
    const previewSummary = document.querySelector(".js-preview-menu > summary");
    const sendShareSummary = document.querySelector(".js-send-share-menu > summary");

    const closeAll = () => {
      exportMenus.forEach((menu) => {
        menu.removeAttribute("open");
      });
    };

    exportMenus.forEach((menu) => {
      menu.addEventListener("toggle", () => {
        if (!menu.open) return;

        exportMenus.forEach((other) => {
          if (other === menu) return;
          other.removeAttribute("open");
        });
      });
    });

    document.addEventListener("click", (event) => {
      if (event.target.closest(".quote-toolbar-export")) return;
      closeAll();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeAll();
        return;
      }

      const isTyping = event.target && [ "INPUT", "TEXTAREA", "SELECT" ].includes(event.target.tagName);
      if (isTyping) return;

      if (event.altKey && event.key.toLowerCase() === "p" && previewSummary) {
        event.preventDefault();
        previewSummary.click();
      }

      if (event.altKey && event.key.toLowerCase() === "s" && sendShareSummary) {
        event.preventDefault();
        sendShareSummary.click();
      }
    });
  })();

  (() => {
    const modals = document.querySelectorAll(".quote-stage-modal");
    if (!modals.length) return;

    const syncReasonDetail = (modal) => {
      if (!modal) return;

      const select = modal.querySelector(".js-quote-reason-kind");
      const detailWrap = modal.querySelector(".js-quote-reason-detail-wrap");
      if (!select || !detailWrap) return;

      detailWrap.hidden = select.value !== "other";
    };

    const closeStageModal = (modal) => {
      if (!modal) return;

      modal.hidden = true;
    };

    modals.forEach((modal) => {
      window.__mountTurnstileModalToBody(modal);
      syncReasonDetail(modal);
      if (modal.dataset.openByDefault === "true") {
        modal.hidden = false;
      }
    });

    document.addEventListener("change", (event) => {
      const modal = event.target.closest(".quote-stage-modal");
      if (!modal) return;
      if (!event.target.matches(".js-quote-reason-kind")) return;
      syncReasonDetail(modal);
    });

    document.addEventListener("click", (event) => {
      const openButton = event.target.closest(".js-quote-stage-open");
      if (openButton) {
        const modal = document.getElementById(openButton.dataset.stageModalId);
        if (!modal) return;
        event.preventDefault();
        modal.hidden = false;
        syncReasonDetail(modal);
        return;
      }

      const closeButton = event.target.closest(".js-quote-stage-close");
      if (closeButton) {
        closeStageModal(closeButton.closest(".quote-stage-modal"));
        return;
      }

      if (event.target.classList.contains("quote-stage-modal")) {
        closeStageModal(event.target);
      }
    });
  })();
</script>
