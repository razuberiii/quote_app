<section class="quote-revision-panel app-surface">
  <div class="quote-revision-head">
    <div>
      <h3><%= t("quotes.view.revision_diff.title") %></h3>
      <p><%= t("quotes.view.revision_diff.compare_versions", current: @quote.revision_number, previous: @previous_revision_quote.revision_number) %></p>
    </div>
    <% if @change_summary.present? %>
      <button type="button"
              class="app-button app-button--secondary quote-copy-summary-btn"
              data-copy-text="<%= @change_summary %>">
        <%= t("quotes.view.revision_diff.copy_change_summary") %>
      </button>
    <% end %>
  </div>

  <% if @revision_diff[:modified_items].blank? && @revision_diff[:added_items].blank? && @revision_diff[:removed_items].blank? && @revision_diff[:commercial_changes].blank? %>
    <p class="quote-revision-empty"><%= t("quotes.view.revision_diff.empty") %></p>
  <% else %>
    <div class="quote-revision-grid">
      <% if @revision_diff[:modified_items].any? %>
        <article class="quote-revision-card">
          <h4><%= t("quotes.view.revision_diff.modified") %></h4>
          <ul>
            <% @revision_diff[:modified_items].each do |item| %>
              <li>
                <strong><%= item[:product_name] %></strong>
                <span><%= t("quotes.view.revision_diff.qty_change", before: item[:quantity_before], after: item[:quantity_after]) %></span>
                <span><%= t("quotes.view.revision_diff.unit_change", before: quote_money(item[:unit_price_before], @quote.currency), after: quote_money(item[:unit_price_after], @quote.currency)) %></span>
              </li>
            <% end %>
          </ul>
        </article>
      <% end %>

      <% if @revision_diff[:added_items].any? %>
        <article class="quote-revision-card">
          <h4><%= t("quotes.view.revision_diff.added") %></h4>
          <ul>
            <% @revision_diff[:added_items].each do |item| %>
              <li>
                <strong><%= item[:product_name] %></strong>
                <span><%= t("quotes.view.revision_diff.qty", value: item[:quantity_after]) %></span>
                <span><%= t("quotes.view.revision_diff.unit", value: quote_money(item[:unit_price_after], @quote.currency)) %></span>
              </li>
            <% end %>
          </ul>
        </article>
      <% end %>

      <% if @revision_diff[:removed_items].any? %>
        <article class="quote-revision-card">
          <h4><%= t("quotes.view.revision_diff.removed") %></h4>
          <ul>
            <% @revision_diff[:removed_items].each do |item| %>
              <li>
                <strong><%= item[:product_name] %></strong>
                <span><%= t("quotes.view.revision_diff.qty", value: item[:quantity_before]) %></span>
                <span><%= t("quotes.view.revision_diff.unit", value: quote_money(item[:unit_price_before], @quote.currency)) %></span>
              </li>
            <% end %>
          </ul>
        </article>
      <% end %>

      <% if @revision_diff[:commercial_changes].any? %>
        <article class="quote-revision-card quote-revision-card--commercial">
          <h4><%= t("quotes.view.revision_diff.commercial_terms") %></h4>
          <ul>
            <% @revision_diff[:commercial_changes].each do |change| %>
              <li>
                <strong><%= change[:label] %></strong>
                <span><%= change[:before] %> -> <%= change[:after] %></span>
              </li>
            <% end %>
          </ul>
        </article>
      <% end %>
    </div>
  <% end %>

  <p class="quote-revision-total">
    <span><%= t("quotes.view.revision_diff.total_updated") %></span>
    <strong><%= quote_money(@revision_diff[:total_before], @quote.currency) %> -> <%= quote_money(@revision_diff[:total_after], @quote.currency) %></strong>
  </p>
</section>
