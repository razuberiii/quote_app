                  <% configuration_presets.each do |preset| %>
                    <option value="<%= preset[:id] || preset["id"] %>" <%= "selected" if @quote_preset_master&.configuration_block_preset_id.to_i == (preset[:id] || preset["id"]).to_i %>><%= preset[:name] || preset["name"] %></option>
                  <% end %>
                </select>
                <button type="button" class="quote-preset-clear-btn js-clear-module-preset" data-module-key="configuration_block" aria-label="<%= t("quotes.view.form.clear_selected_preset", default: "Clear selected preset") %>">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6L18 18M18 6L6 18" /></svg>
                </button>
              </div>
            </div>
          <% end %>
          <div class="quote-advanced-module-list js-configuration-rows"
               data-name-prefix="quote[configuration_block][rows]"
               data-empty-label="<%= t("quotes.view.form.configuration_empty_label", default: "No valid rows, this block stays hidden in output.") %>">
            <% if configuration_rows.any? %>
              <% configuration_rows.each_with_index do |row, idx| %>
                <div class="quote-advanced-module-row js-configuration-row" data-index="<%= idx %>">
                  <%= text_field_tag "quote[configuration_block][rows][#{idx}][label]", row[:label], class: ui_input_classes("js-config-label"), placeholder: t("quotes.view.form.configuration_label_placeholder", default: "Label") %>
                  <%= text_field_tag "quote[configuration_block][rows][#{idx}][value]", row[:value], class: ui_input_classes("js-config-value"), placeholder: t("quotes.view.form.configuration_value_placeholder", default: "Value") %>
                  <%= hidden_field_tag "quote[configuration_block][rows][#{idx}][position]", row[:position].presence || (idx + 1), class: "js-config-position" %>
                  <button type="button" class="quote-kv-remove js-config-row-remove" aria-label="<%= t("quotes.view.form.remove", default: "Remove") %>">&times;</button>
                </div>
              <% end %>
            <% end %>
            <p class="quote-form-hint js-configuration-empty" <%= "hidden" if configuration_rows.any? %>><%= t("quotes.view.form.configuration_empty_label", default: "No valid rows, this block stays hidden in output.") %></p>
          </div>
          <button type="button" class="quote-kv-add js-config-row-add"><%= t("quotes.view.form.add_configuration_row", default: "Add Configuration Row") %></button>
        </div>

        <div class="quote-form-grid-span-2 quote-advanced-subsection-head quote-advanced-subsection-head--logistics">
          <h4><%= t("quote_document.sections.detail_pictures", default: "Detail Pictures") %></h4>
          <p class="quote-form-hint"><%= t("quotes.view.form.detail_pictures_editor_hint", default: "Select from product gallery or upload quote images in batch, then preview before saving.") %></p>
          <div class="quote-detail-gallery-toolbar">
            <button type="button" class="quote-kv-add js-open-detail-gallery"><%= t("quotes.view.form.open_selected_product_gallery", default: "Open Selected Product Gallery") %></button>
          </div>
          <div class="quote-detail-gallery-picker js-detail-gallery-picker" hidden>
            <div class="quote-detail-gallery-picker-head">
              <p class="quote-form-hint"><%= t("quotes.view.form.selected_product_gallery_hint", default: "Only shows images from products currently selected in quote items.") %></p>
              <div class="quote-detail-gallery-actions">
                <button type="button"
                        class="quote-kv-open js-detail-gallery-select-all"
                        data-label-select-all="<%= t("quotes.view.form.select_all", default: "Select All") %>"
                        data-label-deselect-all="<%= t("quotes.view.form.deselect_all", default: "Deselect All") %>"><%= t("quotes.view.form.select_all", default: "Select All") %></button>
              </div>
            </div>
            <div class="quote-detail-gallery-grid js-detail-gallery-grid"></div>
            <p class="quote-form-hint js-detail-gallery-empty" hidden><%= t("quotes.view.form.selected_product_gallery_empty", default: "No gallery images found for currently selected products.") %></p>
