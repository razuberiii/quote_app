<div class="quote-document" style="--quote-accent: <%= @template.accent_color %>;">
  <% active_template = @template %>
  <header class="quote-doc-header">
    <div>
      <p class="quote-doc-kicker"><%= @template.resolved_document_title(@document_kind).titleize %></p>
      <h1><%= @template.resolved_document_number_label(@document_kind) %> <%= @quote.quote_no %> <span class="quote-doc-version">V<%= @quote.revision_number %></span></h1>
      <%= link_to "← Back to Customer", @quote.customer, class: "quote-back-link quote-back-link-inline" %>
    </div>
    <span class="status-badge status-<%= @quote.status %>"><%= @quote.status&.capitalize %></span>
  </header>
  <% days_left = @quote.valid_until.present? ? (@quote.valid_until - Date.current).to_i : nil %>
  <% total_views = @quote.quote_shares.sum(&:view_count) %>
  <% viewed_flag = @quote.viewed_at.present? || total_views.positive? %>
  <% urgency_text =
      if days_left.nil?
        "No expiry date set."
      elsif days_left.negative?
        "Expired #{days_left.abs} day(s) ago. Follow up now."
      elsif days_left <= 3
        "Expiring in #{days_left} day(s). Recommended to follow up today."
      else
        "Valid for #{days_left} more day(s)."
      end %>
  <section class="quote-signal-strip <%= 'is-urgent' if days_left.present? && days_left <= 3 %>">
    <div class="quote-signal-item">
      <span class="quote-signal-label">Momentum</span>
      <strong><%= urgency_text %></strong>
    </div>
    <div class="quote-signal-item">
      <span class="quote-signal-label">Engagement</span>
      <strong><%= viewed_flag ? "Viewed (#{total_views} view#{'s' unless total_views == 1})" : "Not viewed yet" %></strong>
    </div>
    <div class="quote-signal-item">
      <span class="quote-signal-label">Next Action</span>
      <strong><%= viewed_flag ? "Discuss terms and close" : "Share public link to trigger first view" %></strong>
    </div>
  </section>

  <section class="quote-meta-grid">
    <article class="quote-meta-card">
      <h3>Seller</h3>
      <p><strong><%= @quote.company.name %></strong></p>
      <p><%= @quote.company.address.presence || "-" %></p>
      <p><%= @quote.company.phone.presence || "-" %></p>
      <p><%= @quote.company.email.presence || "-" %></p>
      <p><%= @quote.company.website.presence || "-" %></p>
    </article>

    <article class="quote-meta-card">
      <h3>Buyer</h3>
      <p><strong><%= @quote.customer.name %></strong></p>
      <p>Contact: <%= @quote.customer.contact_name.presence || "-" %></p>
      <p><%= @quote.customer.address.presence || "-" %></p>
      <p><%= @quote.customer.phone.presence || "-" %></p>
      <p><%= @quote.customer.email.presence || "-" %></p>
    </article>

    <article class="quote-meta-card">
      <h3>Quote Info</h3>
      <p><strong>Quote Date:</strong> <%= @quote.issued_on&.strftime("%Y-%m-%d") %></p>
      <p>
        <strong>Valid Until:</strong>
        <% if @quote.valid_until.present? %>
          <%= @quote.valid_until.strftime("%Y-%m-%d") %>
          <% if days_left.negative? %>
            <span class="status-badge status-expired">Expired</span>
          <% elsif days_left <= 3 %>
            <span class="status-badge status-paused"><%= days_left %>d left</span>
          <% end %>
        <% else %>
          -
        <% end %>
      </p>
      <p><strong>Currency:</strong> <%= @quote.currency %></p>
      <p><strong>Trade Terms:</strong> <%= @quote.trade_term.presence || "-" %></p>
      <p><strong>Status:</strong> <%= @quote.status&.capitalize %></p>
    </article>

    <article class="quote-meta-card">
      <h3>Engagement</h3>
      <p><strong>Sent:</strong> <%= @quote.sent_at ? @quote.sent_at.strftime("%Y-%m-%d %H:%M") : "-" %></p>
      <p><strong>Last Shared:</strong> <span id="quote-last-shared-at"><%= @quote.quote_shares.maximum(:created_at)&.strftime("%Y-%m-%d %H:%M") || "-" %></span></p>
      <p><strong>First Viewed:</strong> <%= @quote.quote_shares.minimum(:first_viewed_at)&.strftime("%Y-%m-%d %H:%M") || "-" %></p>
      <p><strong>Last Viewed:</strong> <%= @quote.viewed_at ? @quote.viewed_at.strftime("%Y-%m-%d %H:%M") : "-" %></p>
      <p><strong>Total Views:</strong> <%= @quote.quote_shares.sum(&:view_count) %></p>
    </article>
  </section>

  <h3>Items</h3>
  <div class="table-responsive">
    <table class="quote-items-table quote-doc-table">
      <thead>
        <tr>
          <% if active_template.show_images? %>
            <th>Image</th>
          <% end %>
          <th>Description</th>
          <th>Qty</th>
          <th>Unit Price</th>
          <th>Line Total</th>
        </tr>
      </thead>
      <tbody>
        <% @quote.quote_items.ordered.each do |item| %>
          <tr>
            <% if active_template.show_images? %>
              <td>
                <% if item.product&.display_image.present? %>
                  <%= image_tag item.product.display_image, class: "quote-item-image" %>
                <% else %>
                  -
                <% end %>
              </td>
            <% end %>
            <td><%= item.description %></td>
            <td><%= item.quantity %></td>
            <td><%= quote_money(item.unit_price, @quote.currency, show_symbol: active_template.show_currency) %></td>
            <td>
              <%= quote_money(item.line_total, @quote.currency, show_symbol: active_template.show_currency) %>
              <% details = quote_item_details_lines(item, show_symbol: active_template.show_currency) %>
              <% if details.any? %>
                <div class="quote-item-details">
                  <% details.each do |line| %>
                    <div><%= line %></div>
                  <% end %>
                </div>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <aside class="quote-total-box">
    <p><span>Subtotal</span><strong><%= quote_money(@quote.subtotal, @quote.currency, show_symbol: active_template.show_currency) %></strong></p>
    <% if active_template.show_tax %>
      <p><span>Tax / VAT</span><strong><%= quote_money(@quote.tax_amount, @quote.currency, show_symbol: active_template.show_currency) %></strong></p>
    <% end %>
    <% if active_template.show_shipping %>
      <p><span>Shipping</span><strong><%= quote_money(@quote.shipping_amount, @quote.currency, show_symbol: active_template.show_currency) %></strong></p>
    <% end %>
    <p><span>Discount</span><strong><%= quote_money(@quote.discount_amount, @quote.currency, show_symbol: active_template.show_currency) %></strong></p>
    <p class="quote-total-grand"><span>Grand Total</span><strong><%= quote_money(@quote.grand_total, @quote.currency, show_symbol: active_template.show_currency) %></strong></p>
  </aside>

  <% if active_template.show_terms_section && (@quote.payment_term.present? || @quote.terms_text.present? || @quote.legal_disclaimer.present? || @quote.delivery_notes.present?) %>
    <section class="quote-section-block">
      <h3>Terms & Conditions</h3>
      <% if active_template.show_payment_term %>
        <p><strong>Payment Terms:</strong> <%= @quote.payment_term.presence || "-" %></p>
      <% end %>
      <p><strong>Trade Terms:</strong> <%= @quote.trade_term.presence || "-" %></p>
      <p><strong>Terms:</strong> <%= @quote.terms_text.presence || "-" %></p>
      <p><strong>Legal Disclaimer:</strong> <%= @quote.legal_disclaimer.presence || "-" %></p>
      <p><strong>Delivery Notes:</strong> <%= @quote.delivery_notes.presence || "-" %></p>
    </section>
  <% end %>

  <% if active_template.show_notes && @quote.notes.present? %>
    <section class="quote-section-block">
      <h3>Internal Notes</h3>
      <p><%= simple_format(@quote.notes) %></p>
    </section>
  <% end %>

  <% footer_note = @template.resolved_footer_note(@document_kind) %>
  <% if footer_note.present? %>
    <section class="quote-section-block">
      <h3>Footer Note</h3>
      <div><%= simple_format(footer_note) %></div>
    </section>
  <% end %>
</div>

<div class="quote-toolbar">
  <div class="quote-toolbar-main">
    <div class="quote-template-picker">
      <label for="template_select_<%= @quote.id %>">Template</label>
      <%= select_tag :template_id,
                     options_from_collection_for_select(@template_options, :id, :name, @template.id),
                     id: "template_select_#{@quote.id}",
                     class: "js-template-select",
                     data: { update_url: update_template_quote_path(@quote), doc: @document_kind } %>
    </div>

    <%= link_to "Back to Customer", @quote.customer, class: "quote-back-link" %>
    <%= button_to "Download PDF",
                  export_pdf_quote_path(@quote),
                  method: :get,
                  params: { doc: @document_kind, document_kind: @document_kind },
                  form: { data: { turbo: false } },
                  class: "quote-btn quote-btn-secondary" %>
    <%= link_to "Edit", edit_quote_path(@quote), class: "quote-btn quote-btn-secondary" %>
    <%= button_to "New Revision", duplicate_quote_path(@quote), method: :post, form: { data: { turbo: false } }, class: "quote-btn quote-btn-secondary" %>
    <%= button_to "Copy & Reprice", duplicate_and_reprice_quote_path(@quote), method: :post, form: { data: { turbo: false } }, class: "quote-btn quote-btn-secondary" %>
    <% if @document_kind == "pi" %>
      <%= link_to "Switch to Quotation", quote_path(@quote, doc: "quote", document_kind: "quote"), class: "quote-btn quote-btn-secondary" %>
    <% else %>
      <%= link_to "Switch to PI", quote_path(@quote, doc: "pi", document_kind: "pi"), class: "quote-btn quote-btn-secondary" %>
    <% end %>
    <div class="share-link-group">
      <button type="button"
              class="quote-btn quote-btn-primary js-share-public-link"
              data-share-url="<%= share_quote_path(@quote, doc: @document_kind, format: :json) %>">
        Share Public Link
      </button>
      <div class="share-link-panel" id="quote-share-panel" hidden>
        <div class="share-link-panel-message" id="quote-share-message"></div>
        <div class="share-link-panel-actions">
          <button type="button" class="share-link-panel-btn" id="quote-share-copy-btn">Copy Link</button>
          <a href="#" target="_blank" rel="noopener" class="share-link-panel-btn is-link" id="quote-share-open-link">Open</a>
        </div>
      </div>
    </div>
    <%= link_to "Download Excel", export_xlsx_quote_path(@quote, doc: @document_kind), class: "quote-btn quote-btn-secondary" %>
  </div>

  <div class="quote-toolbar-danger">
    <%= button_to "Delete Quote", quote_path(@quote), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this quote? This action cannot be undone." }, class: "quote-btn quote-btn-danger" %>
  </div>
</div>

<section class="quote-history">
  <h3>History</h3>
  <% revisions = @quote.customer.quotes.where(quote_no: @quote.quote_no).order(revision_number: :desc).to_a %>
  <% latest_revision = revisions.first %>
  <p class="quote-history-meta">
    <span><strong><%= revisions.size %></strong> revision(s)</span>
    <span>Current updated: <strong><%= @quote.updated_at&.strftime("%Y-%m-%d %H:%M") || "-" %></strong></span>
  </p>
  <div class="quote-history-tabs">
    <% revisions.each do |q| %>
      <% is_current = q.id == @quote.id %>
      <% tab_class = "history-tab#{' active' if is_current}" %>
      <% label = "V#{q.revision_number}" %>
      <% if is_current %>
        <span class="<%= tab_class %>">
          <%= label %>
          <span class="history-tab-tag">Current</span>
          <% if latest_revision&.id == q.id %>
            <span class="history-tab-tag history-tab-tag-latest">Latest</span>
          <% end %>
        </span>
      <% else %>
        <%= link_to quote_path(q), class: tab_class do %>
          <%= label %>
          <% if latest_revision&.id == q.id %>
            <span class="history-tab-tag history-tab-tag-latest">Latest</span>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</section>

<script>
  (() => {
    const button = document.querySelector(".js-share-public-link");
    const panel = document.getElementById("quote-share-panel");
    const message = document.getElementById("quote-share-message");
    const copyButton = document.getElementById("quote-share-copy-btn");
    const openLink = document.getElementById("quote-share-open-link");
    const lastSharedAt = document.getElementById("quote-last-shared-at");
    if (!button || !panel || !message || !copyButton || !openLink || button.dataset.bound === "true") return;
    button.dataset.bound = "true";

    const csrf = document.querySelector("meta[name='csrf-token']")?.content;
    let timer = null;
    let currentShareUrl = "";

    const showPanel = (text, isError = false) => {
      message.textContent = text;
      panel.classList.toggle("is-error", isError);
      panel.hidden = false;
      if (timer) window.clearTimeout(timer);
      timer = window.setTimeout(() => { panel.hidden = true; }, 4200);
    };

    const hidePanel = () => {
      panel.hidden = true;
      if (timer) window.clearTimeout(timer);
    };

    const copyText = async (text) => {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(text);
        return true;
      }
      return false;
    };

    button.addEventListener("click", async () => {
      button.disabled = true;
      try {
        const response = await fetch(button.dataset.shareUrl, {
          method: "POST",
          headers: {
            "Accept": "application/json",
            "Content-Type": "application/json",
            "X-CSRF-Token": csrf || ""
          },
          credentials: "same-origin",
          body: JSON.stringify({})
        });

        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !payload.url) {
          throw new Error(payload.message || "Unable to generate public link");
        }

        const copied = await copyText(payload.url);
        currentShareUrl = payload.url;
        openLink.href = payload.url;
        openLink.hidden = false;
        if (lastSharedAt) {
          const now = new Date();
          const pad = (n) => String(n).padStart(2, "0");
          const stamp = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())} ${pad(now.getHours())}:${pad(now.getMinutes())}`;
          lastSharedAt.textContent = stamp;
        }
        if (copied) {
          showPanel("Public link ready. Copied to clipboard.");
        } else {
          showPanel("Public link ready. Copy manually if needed.");
        }
      } catch (error) {
        currentShareUrl = "";
        openLink.href = "#";
        openLink.hidden = true;
        showPanel(error.message || "Share failed", true);
      } finally {
        button.disabled = false;
      }
    });

    copyButton.addEventListener("click", async () => {
      if (!currentShareUrl) return;
      const copied = await copyText(currentShareUrl);
      showPanel(copied ? "Link copied." : "Copy failed on browser.", !copied);
    });

    openLink.addEventListener("click", () => {
      hidePanel();
    });

    document.addEventListener("click", (event) => {
      if (panel.hidden) return;
      if (event.target.closest(".share-link-group")) return;
      hidePanel();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") hidePanel();
    });
  })();
</script>
