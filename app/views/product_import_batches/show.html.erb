<main class="deal-workspace catalog-import">
  <header class="deal-page-header"><div><p class="eyebrow"><%= t("self_service.catalog_review.eyebrow", default: "Catalog review") %></p><h1><%= t("self_service.catalog_review.title", count: @candidates.size, default: "%{count} candidates found") %></h1><p><%= t("self_service.catalog_review.subtitle", default: "Check identity, source evidence and price provenance. Your decision is saved before anything enters Library.") %></p></div><span class="status-signal"><%= t("self_service.catalog_review.status.#{@batch.status}", default: @batch.status.humanize) %></span></header>
  <nav class="task-priority" aria-label="<%= t("self_service.priority.title", default: "Task priority") %>"><div class="is-now"><span><%= t("self_service.priority.now", default: "Required now") %></span><strong><%= t("self_service.catalog_review.now", default: "Choose create, merge, variant or ignore for every candidate") %></strong></div><div><span><%= t("self_service.priority.later", default: "Before quoting") %></span><strong><%= t("self_service.catalog_review.later", default: "Confirm price again inside the Deal") %></strong></div></nav>
  <% if @batch.warnings.any? %><section class="import-warnings"><strong><%= t("self_service.catalog_review.warnings", default: "Needs attention") %></strong><ul><% @batch.warnings.each do |warning| %><li><%= warning %></li><% end %></ul></section><% end %>
  <% if @candidates.empty? %><section class="library-empty"><h2><%= t("self_service.catalog_review.empty_title", default: "No reliable product candidate was found") %></h2><p><%= t("self_service.catalog_review.empty_body", default: "The source file is preserved. You can retry, enter products manually, or continue with Deal-only items.") %></p><%= link_to t("self_service.catalog_review.start_deal", default: "Continue with an inquiry"), new_inquiry_path, class: "button button--primary" %></section>
  <% else %><%= form_with url: product_import_batch_path(@batch), method: :patch, class: "candidate-review" do %>
    <% @candidates.each do |candidate| data = candidate.candidate_data %><article class="candidate-row candidate-row--editable">
      <div class="candidate-identity"><span><%= data["sku"].presence || t("self_service.catalog_review.no_sku", default: "No SKU") %></span><label><small><%= t("self_service.catalog_review.name", default: "Product name") %></small><input name="candidates[<%= candidate.id %>][candidate_data][name]" value="<%= data["name"] %>" required></label><label><small><%= t("self_service.catalog_review.description", default: "Description") %></small><textarea name="candidates[<%= candidate.id %>][candidate_data][description]" rows="2"><%= data["description"] %></textarea></label></div>
      <div class="candidate-facts"><label><span>SKU / Model</span><input name="candidates[<%= candidate.id %>][candidate_data][sku]" value="<%= data["sku"] %>"></label><label><span><%= t("self_service.catalog_review.category") %></span><input name="candidates[<%= candidate.id %>][candidate_data][category]" value="<%= data["category"] %>"></label><label><span><%= t("self_service.catalog_review.unit") %></span><input name="candidates[<%= candidate.id %>][candidate_data][unit]" value="<%= data["unit"] %>"></label><label><span>MOQ</span><input name="candidates[<%= candidate.id %>][candidate_data][moq]" value="<%= data["moq"] %>"></label><label><span><%= t("self_service.catalog_review.lead_time") %></span><input name="candidates[<%= candidate.id %>][candidate_data][lead_time]" value="<%= data["lead_time"] %>"></label><label><span><%= t("self_service.catalog_review.packing") %></span><input name="candidates[<%= candidate.id %>][candidate_data][packing]" value="<%= data["packing"] %>"></label><label><span><%= t("self_service.catalog_review.price") %></span><input name="candidates[<%= candidate.id %>][candidate_data][explicit_price]" value="<%= data["explicit_price"] %>" placeholder="<%= t("self_service.catalog_review.price_missing") %>"></label><label><span><%= t("self_service.catalog_review.currency") %></span><input name="candidates[<%= candidate.id %>][candidate_data][currency]" value="<%= data["currency"] %>"></label><p><strong><%= t("self_service.catalog_review.evidence") %></strong><span><%= candidate.evidence.first&.values_at("source", "location")&.compact&.join(" · ") %></span><em><%= number_to_percentage(candidate.confidence.to_f * 100, precision: 0) %></em></p></div>
      <div class="candidate-decision"><label><span><%= t("self_service.catalog_review.decision", default: "Decision") %></span><%= select_tag "candidates[#{candidate.id}][decision]", options_for_select(ProductImportCandidate::DECISIONS.map { |value| [t("self_service.catalog_review.decisions.#{value}", default: value.humanize), value] }, candidate.decision) %></label><label><span><%= t("self_service.catalog_review.existing", default: "Possible existing product") %></span><%= select_tag "candidates[#{candidate.id}][matched_product_id]", options_from_collection_for_select(@products, :id, :name, candidate.matched_product_id), include_blank: t("self_service.catalog_review.no_match", default: "No existing match") %></label></div>
    </article><% end %>
    <footer class="candidate-actions"><%= submit_tag t("self_service.catalog_review.save", default: "Save review"), class: "button button--secondary" %><%= button_tag t("self_service.catalog_review.apply", default: "Apply approved candidates"), formaction: apply_product_import_batch_path(@batch), formmethod: :post, class: "button button--primary" %></footer>
  <% end %><% end %>
</main>
