<% quote = card[:quote] %>
<% signal = card[:push_signal] %>
<article class="quote-card" onclick="window.location='<%= quote_path(card[:quote]) %>'">
  <div class="quote-card-action-callout <%= "is-urgent" if signal[:state] == "risk" %>">
    <span class="quote-card-callout-label">Next Action</span>
    <div>
      <strong><%= signal[:summary] %></strong>
      <span><%= signal[:detail] %></span>
    </div>
  </div>

  <div class="quote-card-layout">
    <div class="quote-card-main">
      <div class="quote-card-heading">
        <h4><%= card[:title] %></h4>
      </div>
      <div class="quote-card-signal-row">
        <span class="quote-card-signal-pill is-<%= signal[:state] %>"><%= signal[:summary] %></span>
        <% if quote.win_reason.present? && card[:display_status] == "won" %>
          <span class="quote-card-signal-detail">Win reason: <%= quote.win_reason.humanize %></span>
        <% elsif quote.loss_reason.present? && card[:display_status] == "lost" %>
          <span class="quote-card-signal-detail">Loss reason: <%= quote.loss_reason.humanize %></span>
        <% elsif quote.stalled_reason.present? && %w[sent viewed negotiating expired].include?(card[:display_status]) %>
          <span class="quote-card-signal-detail">Pressure: <%= quote.stalled_reason.humanize %></span>
        <% elsif quote.valid_until.present? && card[:display_status] == "expired" %>
          <span class="quote-card-signal-detail">Expired on <%= quote.valid_until.strftime("%Y-%m-%d") %></span>
        <% end %>
      </div>
      <div class="quote-card-meta">
        <p>
          <strong>Total:</strong>
          <span class="quote-total-value"><%= quote_money(card[:current_total], card[:currency]) %></span>
        </p>
        <p><strong>Updated:</strong> <%= card[:updated_at]&.strftime("%Y-%m-%d") || "-" %></p>
        <% if quote.valid_until.present? %>
          <% days_left = (quote.valid_until - Date.current).to_i %>
          <% if days_left.negative? %>
            <p><strong>Valid Until:</strong> <%= quote_status_badge("expired", label: "#{quote.valid_until.strftime("%Y-%m-%d")} (Expired)") %></p>
          <% elsif days_left <= 3 %>
            <p><strong>Valid Until:</strong> <%= status_badge("#{quote.valid_until.strftime("%Y-%m-%d")} (#{days_left}d left)", :amber) %></p>
          <% else %>
            <p><strong>Valid Until:</strong> <%= quote.valid_until.strftime("%Y-%m-%d") %></p>
          <% end %>
        <% end %>
      </div>

      <% if card[:changed_from_original] %>
        <div class="quote-card-diff">
          <span><strong>Original:</strong> <%= quote_money(card[:original_total], card[:currency]) %></span>
          <span class="diff-value <%= card[:diff_amount].negative? ? "down" : "up" %>">
            <%= card[:trend] == :up ? "↑" : (card[:trend] == :down ? "↓" : "→") %>
            <%= quote_money(card[:diff_amount], card[:currency]) %>
            (<%= card[:diff_pct] %>%)
          </span>
        </div>
      <% end %>
    </div>

    <div class="quote-card-side">
      <div class="quote-card-badges">
        <span class="revision-pill">V<%= card[:revision] %></span>
        <%= quote_status_badge(card[:display_status]) %>
      </div>
    </div>
  </div>

  <div class="quote-card-actions" onclick="event.stopPropagation();">
    <% if signal[:method] == :post %>
      <%= button_to signal[:label],
                    signal[:path],
                    method: :post,
                    form: { data: { turbo: false }, onsubmit: "event.stopPropagation();" },
                    class: ui_button_classes(:primary, "quote-action-primary") %>
    <% else %>
      <%= link_to signal[:label], signal[:path], class: ui_button_classes(:primary, "quote-action-primary") %>
    <% end %>
    <% if quote.can_edit_revision? %>
      <%= link_to "Edit", edit_quote_path(card[:quote]), class: ui_button_classes(:secondary, "quote-card-secondary-action") %>
    <% end %>
    <% if quote.can_create_new_revision? %>
      <%= button_to "New Revision", duplicate_quote_path(card[:quote]), method: :post, form: { data: { turbo: false }, onsubmit: "event.stopPropagation();" }, class: ui_button_classes(:secondary, "quote-card-secondary-action") %>
    <% end %>
    <% if quote.can_reopen? %>
      <%= button_to "Reopen Quote",
                    reopen_quote_path(card[:quote]),
                    method: :post,
                    form: { data: { turbo_confirm: "Reopening this quote will allow editing again and mark the public version as outdated. Customers will not be able to accept it until a new version is shared." }, onsubmit: "event.stopPropagation();" },
                    class: ui_button_classes(:secondary, "quote-card-secondary-action") %>
    <% end %>
    <% if quote.can_copy_and_reprice? %>
      <%= button_to "Copy & Reprice", duplicate_and_reprice_quote_path(card[:quote]), method: :post, form: { data: { turbo: false }, onsubmit: "event.stopPropagation();" }, class: ui_button_classes(:secondary, "quote-card-secondary-action") %>
    <% end %>
    <% if quote.can_delete_quote_family? %>
      <%= button_to "Delete Quote",
                    quote_path(card[:quote]),
                    method: :delete,
                    form: { data: { turbo_confirm: "Delete the entire quote thread #{quote.quote_no} including all revisions and expire any public links? This cannot be undone." },
                            onsubmit: "event.stopPropagation(); if (!confirm('Final warning: this will expire public links and remove the full quote thread.')) return false; if (prompt('Type DELETE to confirm quote thread removal') !== 'DELETE') return false;" },
                    class: ui_button_classes(:danger, "quote-card-secondary-action") %>
    <% end %>
  </div>
</article>
