<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : t("app.brand_name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for?(:meta_description) ? yield(:meta_description) : seo_description %>">
    <meta name="robots" content="<%= content_for?(:meta_robots) ? yield(:meta_robots) : "index,follow" %>">
    <% canonical_url = content_for?(:canonical_url) ? yield(:canonical_url) : "#{request.base_url}#{request.path}" %>
    <% if canonical_url.present? %>
      <link rel="canonical" href="<%= canonical_url %>">
    <% end %>
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Rubusoo">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="<%= favicon_href %>" type="image/png">
    <link rel="shortcut icon" href="<%= favicon_href %>" type="image/png">
    <link rel="apple-touch-icon" href="<%= favicon_href %>">

    <%# Canonical CSS path: tailwind + components only. Do not add new global stylesheets for feature/page work. %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <!-- Cloudflare Turnstile -->
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  </head>

  <body class="app-root"<% if user_signed_in? %>
    style="--brand-primary: <%= ui_brand_color %>; --brand-on-primary: <%= ui_brand_text_color %>;"
    data-controller="shortcuts"
    data-shortcuts-new-customer-url-value="<%= new_customer_path %>"
    data-shortcuts-new-product-url-value="<%= new_product_path %>"
    data-shortcuts-customer-picker-url-value="<%= shortcut_candidates_customers_path %>"
    data-shortcuts-command-palette-url-value="<%= command_palette_search_path %>"
  <% end %>>
    <nav class="navbar">
      <div class="navbar-container">
        <div class="navbar-brand-wrap">
          <h1><%= link_to t("app.brand_name"), root_path %></h1>
          <% if user_signed_in? %>
            <span class="navbar-company-context"><%= current_user.company.name %></span>
          <% end %>
        </div>
        <% if user_signed_in? %>
          <% products_nav_active = ["products", "product_presets", "addon_presets", "spec_presets"].include?(controller_path) %>
          <% account_nav_active = ["users/registrations", "company_settings", "team_invitations", "email_changes"].include?(controller_path) %>
          <button class="navbar-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" aria-label="<%= t('landing.shared.navigation.toggle') %>">
            <span></span>
            <span></span>
            <span></span>
          </button>
          <ul class="navbar-menu" id="primary-navigation">
            <%= ui_nav_link t("nav.dashboard"), dashboard_path, icon: :dashboard %>
            <%= ui_nav_link t("nav.customers"), customers_path, icon: :customers %>
            <li class="nav-group <%= "is-active" if products_nav_active %>">
              <details class="nav-group-details">
                <summary class="app-nav-link nav-group-trigger <%= "is-active" if products_nav_active %>">
                  <span class="app-nav-link-icon"><%= ui_nav_icon(:products) %></span>
                  <span class="app-nav-link-label"><%= t("nav.products") %></span>
                  <span class="nav-group-caret" aria-hidden="true">▾</span>
                </summary>
                <div class="nav-group-menu app-dropdown-panel">
                  <%= link_to t("nav.products"), products_path, class: ["app-dropdown-link", "nav-group-link", ("is-active" if controller_path == "products")].compact.join(" ") %>
                  <%= link_to t("nav.presets"), product_presets_path, class: ["app-dropdown-link", "nav-group-link", ("is-active" if ["product_presets", "addon_presets", "spec_presets"].include?(controller_path))].compact.join(" ") %>
                </div>
              </details>
            </li>
            <%= ui_nav_link t("nav.template"), quote_templates_path, icon: :templates %>
            <% if current_user.can_manage_team? %>
              <%= ui_nav_link t("nav.team"), team_members_path, icon: :team %>
            <% end %>
            <% if current_user.admin? %>
              <%= ui_nav_link t("nav.admin"), admin_users_path, icon: :admin %>
            <% end %>
          </ul>
          <% invite_count = pending_team_invitations_count %>
          <div class="navbar-controls">
            <div class="account-menu">
                    <button class="account-menu-trigger <%= "is-active" if account_nav_active %>"
                      type="button"
                      aria-expanded="false"
                      aria-controls="account-dropdown">
                <span class="account-avatar">
                  <% if current_user.avatar.attached? %>
                    <%= image_tag current_user.avatar, alt: t("application.avatar_alt"), class: "account-avatar-img" %>
                  <% else %>
                    <%= current_user.email.to_s.first.to_s.upcase %>
                  <% end %>
                </span>
                <span><%= t("account.menu") %></span>
                <% if invite_count.positive? %>
                  <span class="account-notice-badge"><%= invite_count %></span>
                <% end %>
              </button>
              <div class="account-dropdown app-dropdown-panel" id="account-dropdown" hidden>
                <p class="account-dropdown-group-label app-dropdown-group-label"><%= t("account.settings") %></p>
                <%= link_to t("account.account_settings"), edit_user_registration_path, class: "app-dropdown-link account-dropdown-link" %>
                <% if current_user.can_manage_templates? %>
                  <%= link_to t("account.company_settings"), edit_company_settings_path, class: "app-dropdown-link account-dropdown-link" %>
                <% end %>
                <p class="account-dropdown-group-label app-dropdown-group-label"><%= t("account.workspace") %></p>
                <%= link_to t("account.my_invitations", count: invite_count), team_invitations_path, class: "app-dropdown-link account-dropdown-link" %>
                <%= link_to t("account.logout"), destroy_user_session_path, class: "app-dropdown-link account-dropdown-link", data: { turbo_method: :delete } %>
              </div>
            </div>
            <%# Notification bell %>
            <%= render "layouts/notification_bell" %>
            <div class="locale-nav-item">
              <%= render "layouts/locale_nav" %>
            </div>
          </div>
        <% else %>
          <button class="navbar-toggle" type="button" aria-expanded="false" aria-controls="public-navigation" aria-label="<%= t('landing.shared.navigation.toggle') %>">
            <span></span>
            <span></span>
            <span></span>
          </button>
          <ul class="navbar-menu navbar-menu-public" id="public-navigation">
            <li><%= link_to t("nav.home"), root_path %></li>
            <li><%= link_to t("nav.start_free"), new_user_registration_path, class: "navbar-cta-link" %></li>
            <li><%= link_to t("nav.login"), new_user_session_path %></li>
          </ul>
          <%= render "layouts/locale_nav" %>
        <% end %>
      </div>
    </nav>

    <main>
      <% breadcrumbs = app_breadcrumb_items %>
      <% if breadcrumbs.any? %>
        <nav class="app-breadcrumb" aria-label="<%= t('application.breadcrumb_aria') %>">
          <ol class="app-breadcrumb-list">
            <% breadcrumbs.each_with_index do |item, index| %>
              <% is_last = index == breadcrumbs.length - 1 %>
              <li class="app-breadcrumb-item">
                <% if item[:path].present? && !is_last %>
                  <%= link_to item[:label], item[:path], class: "app-breadcrumb-link" %>
                <% else %>
                  <span class="app-breadcrumb-current"><%= item[:label] %></span>
                <% end %>
              </li>
            <% end %>
          </ol>
        </nav>
      <% end %>

      <% if notice %>
        <div class="alert alert-success"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="alert alert-danger"><%= alert %></div>
      <% end %>
      <%= yield %>
    </main>
    <% if user_signed_in? %>
      <%= render "layouts/personal_notes_widget" %>
    <% end %>
    <div id="app-toast-container" class="app-toast-container" aria-live="polite" aria-atomic="true"></div>
    <% if user_signed_in? %>
    <div id="shortcuts-modal" class="app-shortcuts-backdrop" hidden
         role="dialog" aria-modal="true" aria-labelledby="shortcuts-modal-title"
         data-action="click->shortcuts#backdropClick">
      <div class="app-shortcuts-dialog">
        <button type="button" class="app-shortcuts-close js-shortcuts-close"
                data-action="click->shortcuts#closeHelp"
                aria-label="<%= t('shortcuts.close') %>">&#x2715;</button>
        <h3 id="shortcuts-modal-title" class="app-shortcuts-title"><%= t('shortcuts.title') %></h3>
        <div class="app-shortcuts-groups">
          <section class="app-shortcuts-group">
            <p class="app-shortcuts-group-title"><%= t('shortcuts.groups.global') %></p>
            <dl class="app-shortcuts-list">
              <div class="app-shortcuts-row"><dt><kbd>Cmd/Ctrl + K</kbd></dt><dd><%= t('shortcuts.items.command_palette') %></dd></div>
              <div class="app-shortcuts-row"><dt><kbd>Shift + C</kbd></dt><dd><%= t('shortcuts.items.new_customer') %></dd></div>
              <div class="app-shortcuts-row"><dt><kbd>Shift + P</kbd></dt><dd><%= t('shortcuts.items.new_product') %></dd></div>
              <div class="app-shortcuts-row"><dt><kbd>Shift + Q</kbd></dt><dd><%= t('shortcuts.items.new_quote') %></dd></div>
              <div class="app-shortcuts-row"><dt><kbd>/</kbd></dt><dd><%= t('shortcuts.items.search') %></dd></div>
              <div class="app-shortcuts-row"><dt><kbd>?</kbd></dt><dd><%= t('shortcuts.items.help') %></dd></div>
            </dl>
          </section>

          <section class="app-shortcuts-group">
            <p class="app-shortcuts-group-title"><%= t('shortcuts.groups.customer_page') %></p>
            <dl class="app-shortcuts-list">
              <div class="app-shortcuts-row"><dt><kbd>Shift + Q</kbd></dt><dd><%= t('shortcuts.items.new_quote_for_current_customer') %></dd></div>
            </dl>
          </section>

          <section class="app-shortcuts-group">
            <p class="app-shortcuts-group-title"><%= t('shortcuts.groups.quote_page') %></p>
            <dl class="app-shortcuts-list">
              <div class="app-shortcuts-row"><dt><kbd>Shift + S</kbd></dt><dd><%= t('shortcuts.items.share_quote') %></dd></div>
            </dl>
          </section>

          <section class="app-shortcuts-group">
            <p class="app-shortcuts-group-title"><%= t('shortcuts.groups.lists') %></p>
            <dl class="app-shortcuts-list">
              <div class="app-shortcuts-row"><dt><kbd>J / K</kbd></dt><dd><%= t('shortcuts.items.move_list_selection') %></dd></div>
              <div class="app-shortcuts-row"><dt><kbd>Enter</kbd></dt><dd><%= t('shortcuts.items.open_selected_row') %></dd></div>
            </dl>
          </section>
        </div>
      </div>
    </div>

    <div id="shortcut-quote-picker-modal" class="app-shortcuts-backdrop" hidden
         role="dialog" aria-modal="true" aria-labelledby="shortcut-quote-picker-title"
         data-action="click->shortcuts#quotePickerBackdropClick">
      <div class="app-shortcuts-dialog app-shortcuts-dialog--wide">
        <button type="button" class="app-shortcuts-close"
                data-action="click->shortcuts#closeQuotePicker"
                aria-label="<%= t('shortcuts.close') %>">&#x2715;</button>
        <h3 id="shortcut-quote-picker-title" class="app-shortcuts-title"><%= t('shortcuts.quote_picker.title') %></h3>
        <p class="app-shortcuts-subtitle"><%= t('shortcuts.quote_picker.subtitle') %></p>
        <input id="shortcut-quote-customer-search"
               type="text"
               class="app-shortcuts-search"
               placeholder="<%= t('shortcuts.quote_picker.search_placeholder') %>"
               autocomplete="off"
               data-action="input->shortcuts#onQuoteSearchInput">
        <ul id="shortcut-quote-customer-results" class="app-shortcuts-customer-list"></ul>
        <p id="shortcut-quote-customer-empty" class="app-shortcuts-empty"><%= t('shortcuts.quote_picker.empty') %></p>
      </div>
    </div>

    <div id="command-palette-modal" class="app-shortcuts-backdrop" hidden
         role="dialog" aria-modal="true" aria-labelledby="command-palette-title"
         data-action="click->shortcuts#commandPaletteBackdropClick">
      <div class="app-shortcuts-dialog app-shortcuts-dialog--wide">
        <button type="button" class="app-shortcuts-close"
                data-action="click->shortcuts#closeCommandPalette"
                aria-label="<%= t('shortcuts.close') %>">&#x2715;</button>
        <h3 id="command-palette-title" class="app-shortcuts-title"><%= t('shortcuts.palette.title') %></h3>
        <input id="command-palette-search"
               type="text"
               class="app-shortcuts-search"
               placeholder="<%= t('shortcuts.palette.placeholder') %>"
               autocomplete="off"
               data-action="input->shortcuts#onCommandPaletteInput keydown->shortcuts#onCommandPaletteKeydown">
        <div id="command-palette-results" class="app-command-palette-results"></div>
      </div>
    </div>
    <% end %>
    <footer class="global-app-footer">
      <span class="app-version-pill">v0.94 Beta</span>
      <% if user_signed_in? %>
        <span class="app-shortcuts-footnote"><%= t("shortcuts.discoverability") %></span>
      <% end %>
    </footer>

    <script>
      (() => {
        const setupToastApi = () => {
          if (window.showAppToast) return;
          window.showAppToast = (text, type = "info") => {
            const container = document.getElementById("app-toast-container");
            if (!container || !text) return;
            const toast = document.createElement("div");
            toast.className = `app-toast is-${type}`;
            toast.textContent = text;
            container.appendChild(toast);
            window.setTimeout(() => toast.classList.add("is-visible"), 10);
            window.setTimeout(() => {
              toast.classList.remove("is-visible");
              window.setTimeout(() => toast.remove(), 220);
            }, 2400);
          };
        };

        const setupDirtyGuards = () => {
          if (window.__settingsDirtyGuardBound) return;
          window.__settingsDirtyGuardBound = true;

          const getFormSnapshot = (form) => {
            const data = new FormData(form);
            const entries = [];
            data.forEach((value, key) => {
              if (key === "authenticity_token" || key === "_method") return;
              if (value instanceof File) {
                entries.push([key, value.name || ""]);
              } else {
                entries.push([key, String(value)]);
              }
            });
            entries.sort((a, b) => a[0].localeCompare(b[0]));
            return JSON.stringify(entries);
          };

          const trackedForms = new Set();
          const refreshTrackedForms = () => {
            document.querySelectorAll("form[data-dirty-guard='true']").forEach((form) => {
              if (trackedForms.has(form)) return;
              form.dataset.initialSnapshot = getFormSnapshot(form);
              form.dataset.dirty = "false";
              form.addEventListener("input", () => {
                form.dataset.dirty = String(form.dataset.initialSnapshot !== getFormSnapshot(form));
              });
              form.addEventListener("change", () => {
                form.dataset.dirty = String(form.dataset.initialSnapshot !== getFormSnapshot(form));
              });
              form.addEventListener("submit", () => {
                form.dataset.skipDirtyGuard = "true";
              });
              trackedForms.add(form);
            });
          };

          const hasDirtyForm = () => Array.from(trackedForms).some((form) => {
            if (!document.body.contains(form)) return false;
            if (form.dataset.skipDirtyGuard === "true") return false;
            return form.dataset.dirty === "true";
          });

          refreshTrackedForms();
          document.addEventListener("turbo:load", refreshTrackedForms);

          window.addEventListener("beforeunload", (event) => {
            if (!hasDirtyForm()) return;
            event.preventDefault();
            event.returnValue = "";
          });

          document.addEventListener("turbo:before-visit", (event) => {
            if (!hasDirtyForm()) return;
            if (window.confirm("You have unsaved changes. Leave this page?")) return;
            event.preventDefault();
          });
        };

        const setupNavGroups = () => {
          const desktopNavMatcher = window.matchMedia("(min-width: 1461px)");
          const closeTimers = new WeakMap();
          const hoverCloseDelayMs = 180;

          const clearCloseTimer = (details) => {
            const timerId = closeTimers.get(details);
            if (!timerId) return;
            window.clearTimeout(timerId);
            closeTimers.delete(details);
          };

          const scheduleClose = (details) => {
            clearCloseTimer(details);
            const timerId = window.setTimeout(() => {
              if (details.dataset.pinned === "true") return;
              details.removeAttribute("open");
              closeTimers.delete(details);
            }, hoverCloseDelayMs);
            closeTimers.set(details, timerId);
          };

          const closeNavGroups = (except) => {
            document.querySelectorAll(".nav-group-details[open]").forEach((details) => {
              if (except && details === except) return;
              clearCloseTimer(details);
              details.removeAttribute("open");
              details.dataset.pinned = "false";
            });
          };

          document.querySelectorAll(".nav-group-details").forEach((details) => {
            if (details.dataset.bound === "true") return;
            details.dataset.bound = "true";
            details.dataset.pinned = "false";

            const summary = details.querySelector(".nav-group-trigger");
            if (summary) {
              summary.addEventListener("click", (event) => {
                event.preventDefault();
                const isOpen = details.hasAttribute("open");
                const isPinned = details.dataset.pinned === "true";

                if (!isOpen) {
                  closeNavGroups(details);
                  details.setAttribute("open", "open");
                  details.dataset.pinned = "true";
                  return;
                }

                if (isPinned) {
                  details.removeAttribute("open");
                  details.dataset.pinned = "false";
                  return;
                }

                details.dataset.pinned = "true";
              });
            }

            details.addEventListener("mouseenter", () => {
              if (!desktopNavMatcher.matches) return;
              clearCloseTimer(details);
              if (details.dataset.pinned === "true") return;
              closeNavGroups(details);
              details.setAttribute("open", "open");
            });

            details.addEventListener("mouseleave", () => {
              if (!desktopNavMatcher.matches) return;
              if (details.dataset.pinned === "true") return;
              scheduleClose(details);
            });

            details.querySelectorAll(".nav-group-menu a").forEach((link) => {
              if (link.dataset.bound === "true") return;
              link.dataset.bound = "true";
              link.addEventListener("click", () => {
                clearCloseTimer(details);
                details.removeAttribute("open");
                details.dataset.pinned = "false";
              });
            });
          });

          if (window.__navGroupOutsideBound !== true) {
            window.__navGroupOutsideBound = true;

            document.addEventListener("click", (event) => {
              const insideNavGroup = event.target.closest(".nav-group");
              if (insideNavGroup) return;
              closeNavGroups();
            });

            document.addEventListener("keydown", (event) => {
              if (event.key !== "Escape") return;
              closeNavGroups();
            });
          }
        };

        const setupAccountMenu = () => {
          const accountMenu = document.querySelector(".account-menu");
          const accountTrigger = document.querySelector(".account-menu-trigger");
          const accountDropdown = document.getElementById("account-dropdown");
          if (!accountMenu || !accountTrigger || !accountDropdown) return;

          const desktopNavMatcher = window.matchMedia("(min-width: 1461px)");
          const hoverCloseDelayMs = 180;

          const openAccountMenu = (pinned) => {
            accountMenu.classList.add("is-open");
            accountMenu.dataset.pinned = pinned ? "true" : "false";
            accountDropdown.hidden = false;
            accountTrigger.setAttribute("aria-expanded", "true");
          };

          const closeAccountMenu = () => {
            accountMenu.classList.remove("is-open");
            accountMenu.dataset.pinned = "false";
            accountDropdown.hidden = true;
            accountTrigger.setAttribute("aria-expanded", "false");
          };

          const clearCloseTimer = () => {
            if (!accountMenu.dataset.closeTimer) return;
            window.clearTimeout(Number(accountMenu.dataset.closeTimer));
            accountMenu.dataset.closeTimer = "";
          };

          const scheduleClose = () => {
            clearCloseTimer();
            accountMenu.dataset.closeTimer = String(window.setTimeout(() => {
              if (accountMenu.dataset.pinned === "true") return;
              closeAccountMenu();
            }, hoverCloseDelayMs));
          };

          if (accountTrigger.dataset.bound !== "true") {
            accountTrigger.dataset.bound = "true";

            accountTrigger.addEventListener("click", () => {
              clearCloseTimer();
              const isOpen = accountMenu.classList.contains("is-open");
              const isPinned = accountMenu.dataset.pinned === "true";

              if (!isOpen) {
                openAccountMenu(true);
                return;
              }

              if (isPinned) {
                closeAccountMenu();
                return;
              }

              openAccountMenu(true);
            });
          }

          if (accountMenu.dataset.hoverBound !== "true") {
            accountMenu.dataset.hoverBound = "true";

            accountMenu.addEventListener("mouseenter", () => {
              if (!desktopNavMatcher.matches) return;
              clearCloseTimer();
              if (accountMenu.dataset.pinned === "true") return;
              openAccountMenu(false);
            });

            accountMenu.addEventListener("mouseleave", () => {
              if (!desktopNavMatcher.matches) return;
              if (accountMenu.dataset.pinned === "true") return;
              scheduleClose();
            });

            accountDropdown.querySelectorAll("a").forEach((link) => {
              if (link.dataset.bound === "true") return;
              link.dataset.bound = "true";
              link.addEventListener("click", () => {
                clearCloseTimer();
                closeAccountMenu();
              });
            });
          }

          if (window.__accountMenuOutsideBound !== true) {
            window.__accountMenuOutsideBound = true;

            document.addEventListener("click", (event) => {
              if (event.target.closest(".account-menu")) return;
              const _menu = document.querySelector(".account-menu");
              const _dropdown = document.getElementById("account-dropdown");
              if (!_menu || !_dropdown || _dropdown.hidden) return;
              if (_menu.dataset.closeTimer) {
                window.clearTimeout(Number(_menu.dataset.closeTimer));
                _menu.dataset.closeTimer = "";
              }
              _menu.classList.remove("is-open");
              _menu.dataset.pinned = "false";
              _dropdown.hidden = true;
              _menu.querySelector("[aria-controls='account-dropdown']")?.setAttribute("aria-expanded", "false");
            });

            document.addEventListener("keydown", (event) => {
              if (event.key !== "Escape") return;
              const _menu = document.querySelector(".account-menu");
              const _dropdown = document.getElementById("account-dropdown");
              if (!_menu || !_dropdown || _dropdown.hidden) return;
              if (_menu.dataset.closeTimer) {
                window.clearTimeout(Number(_menu.dataset.closeTimer));
                _menu.dataset.closeTimer = "";
              }
              _menu.classList.remove("is-open");
              _menu.dataset.pinned = "false";
              _dropdown.hidden = true;
              _menu.querySelector("[aria-controls='account-dropdown']")?.setAttribute("aria-expanded", "false");
            });
          }
        };

        const setupNotificationBell = () => {
          const bellDropdown = document.querySelector(".notification-bell-dropdown");
          if (!bellDropdown) return;

          const closeBell = () => {
            bellDropdown.removeAttribute("open");
          };

          if (bellDropdown.dataset.bound !== "true") {
            bellDropdown.dataset.bound = "true";

            bellDropdown.querySelectorAll("a").forEach((link) => {
              if (link.dataset.bellBound === "true") return;
              link.dataset.bellBound = "true";
              link.addEventListener("click", () => {
                closeBell();
              });
            });

            bellDropdown.addEventListener("toggle", () => {
              if (!bellDropdown.open) return;

              const menu = document.getElementById("notification-bell-menu");
              if (menu && !menu.querySelector(".notification-list")) {
                menu.innerHTML = '<p class="notification-empty"><%= j(t("notifications.loading", default: "Loading notifications...")) %></p>';
              }

              if (typeof window.refreshNotificationBell === "function") {
                window.refreshNotificationBell();
              }
            });
          }

          if (window.__notificationBellOutsideBound !== true) {
            window.__notificationBellOutsideBound = true;

            document.addEventListener("click", (event) => {
              if (event.target.closest(".notification-bell-container")) return;
              document.querySelectorAll(".notification-bell-dropdown[open]").forEach((menu) => {
                menu.removeAttribute("open");
              });
            });

            document.addEventListener("keydown", (event) => {
              if (event.key !== "Escape") return;
              document.querySelectorAll(".notification-bell-dropdown[open]").forEach((menu) => {
                menu.removeAttribute("open");
              });
            });
          }
        };

        const setupLocaleNavDropdown = () => {
          const localeDropdowns = document.querySelectorAll(".locale-nav-dropdown");
          if (!localeDropdowns.length) return;

          localeDropdowns.forEach((dropdown) => {
            if (dropdown.dataset.bound === "true") return;
            dropdown.dataset.bound = "true";

            dropdown.querySelectorAll(".locale-nav-link").forEach((link) => {
              if (link.dataset.localeBound === "true") return;
              link.dataset.localeBound = "true";
              link.addEventListener("click", () => {
                dropdown.removeAttribute("open");
              });
            });
          });

          if (window.__localeDropdownOutsideBound !== true) {
            window.__localeDropdownOutsideBound = true;

            document.addEventListener("click", (event) => {
              if (event.target.closest(".locale-nav")) return;
              document.querySelectorAll(".locale-nav-dropdown[open]").forEach((menu) => {
                menu.removeAttribute("open");
              });
            });

            document.addEventListener("keydown", (event) => {
              if (event.key !== "Escape") return;
              document.querySelectorAll(".locale-nav-dropdown[open]").forEach((menu) => {
                menu.removeAttribute("open");
              });
            });
          }
        };

        const onLoad = () => {
          setupToastApi();
          setupDirtyGuards();
          setupNavGroups();
          setupAccountMenu();
          setupNotificationBell();
          setupLocaleNavDropdown();

          const container = document.querySelector(".navbar-container");          const toggle = document.querySelector(".navbar-toggle");
          if (container && toggle && toggle.dataset.bound !== "true") {
            toggle.dataset.bound = "true";

            toggle.addEventListener("click", () => {
              const isOpen = container.classList.toggle("menu-open");
              toggle.setAttribute("aria-expanded", String(isOpen));
            });
          }
        };

        onLoad();
        document.addEventListener("turbo:load", onLoad);

        // Realtime notification badge polling (every 30 seconds)
        <% if user_signed_in? %>
        (() => {
          if (window.__notifPollBound) return;
          window.__notifPollBound = true;

          const updateBadge = (count) => {
            const badge = document.getElementById("notification-badge-count");
            if (!badge) return;
            badge.textContent = count > 9 ? "9+" : String(count);
            badge.hidden = count === 0;
          };

          const updateBellMenu = (menuHtml) => {
            if (typeof menuHtml !== "string") return;
            const menu = document.getElementById("notification-bell-menu");
            if (!menu) return;
            menu.innerHTML = menuHtml;
          };

          const pollUnreadCount = async () => {
            try {
              const resp = await fetch("<%= unread_count_notifications_path %>", {
                headers: { "Accept": "application/json", "X-Requested-With": "XMLHttpRequest" },
                credentials: "same-origin"
              });
              if (!resp.ok) return;
              const { count, menu_html: menuHtml } = await resp.json();
              updateBadge(count);
              updateBellMenu(menuHtml);
            } catch (_) {}
          };

          window.refreshNotificationBell = pollUnreadCount;
          window.setInterval(window.refreshNotificationBell, 30000);
        })();
        <% end %>
      })();
    </script>
  </body>
</html>
