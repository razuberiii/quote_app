<main class="deal-workspace publish-review">
  <header class="deal-page-header"><div><%= link_to t("self_service.publish.back"), deal_path(@quote, tab: "quote"), class: "deal-back" %><p class="eyebrow"><%= t("self_service.publish.eyebrow") %></p><h1><%= deal_title(@quote) %></h1><p><%= @quote.quote_no %> · <%= @quote.customer&.name || t("self_service.publish.buyer_required") %></p></div><%= link_to t("self_service.publish.continue"), edit_quote_path(@quote), class: "button button--secondary" %></header>
  <section class="publish-gate <%= "is-ready" if @readiness_issues.empty? %>">
    <div><span><%= @readiness_issues.empty? ? t("self_service.publish.ready_signal") : t("self_service.publish.blocked_signal") %></span><h2><%= @readiness_issues.empty? ? t("self_service.publish.ready_title") : t("self_service.publish.blocked_title") %></h2><p><%= t("self_service.publish.description") %></p></div>
    <% if @readiness_issues.any? %><ul><% @readiness_issues.each do |issue| %><li><%= issue %></li><% end %></ul><%= link_to t("self_service.publish.resolve"), edit_quote_path(@quote), class: "button button--primary" %>
    <% else %><div class="publish-actions"><%= link_to t("self_service.publish.preview"), preview_quote_path(@quote), target: "_blank", class: "button button--secondary" %><%= button_to t("self_service.publish.button", number: @revisions.size + 1), quote_revisions_path(quote_id: @quote.id), class: "button button--primary", form: { data: { controller: "publish-motion", action: "submit->publish-motion#seal" } } %></div><% end %>
  </section>
  <section class="version-ledger"><header><p class="eyebrow"><%= t("self_service.publish.ledger") %></p><h2><%= t("self_service.publish.history") %></h2></header><% @revisions.each do |revision| %><%= link_to quote_revision_path(revision) do %><span>Version <%= revision.number %></span><strong><%= revision.currency %> <%= number_with_delimiter(revision.total) %></strong><small><%= revision.status.humanize %> · <%= revision.sent_at&.to_fs(:short) %></small><% end %><% end %><% if @revisions.empty? %><p><%= t("self_service.publish.empty") %></p><% end %></section>
</main>
