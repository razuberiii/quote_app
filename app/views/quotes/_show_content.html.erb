<%= link_to "← Back to Customer", @quote.customer, class: "quote-back-link quote-back-link-top" %>

<div class="quote-document" style="--quote-accent: <%= @template.accent_color %>;">
  <% active_template = @template %>
  <% spec_label = @quote.resolved_spec_label %>
  <% addon_label = @quote.resolved_addon_label %>
  <header class="quote-doc-header">
    <div>
      <p class="quote-doc-kicker"><%= @template.resolved_document_title(@document_kind).titleize %></p>
      <h1><%= @template.resolved_document_number_label(@document_kind) %> <%= @quote.quote_no %> <span class="quote-doc-version">V<%= @quote.revision_number %></span></h1>
      <% if @quote.custom_title.present? %>
        <p class="quote-doc-subtitle"><%= @quote.custom_title %></p>
      <% end %>
    </div>
    <span class="status-badge status-<%= @quote.status %>"><%= @quote.status&.capitalize %></span>
  </header>
  <% days_left = @quote.valid_until.present? ? (@quote.valid_until - Date.current).to_i : nil %>
  <% total_views = @quote.quote_shares.sum(&:view_count) %>
  <% viewed_flag = @quote.viewed_at.present? || total_views.positive? %>
  <% urgency_text =
      if days_left.nil?
        "No expiry date set."
      elsif days_left.negative?
        "Expired #{days_left.abs} day(s) ago. Follow up now."
      elsif days_left <= 3
        "Expiring in #{days_left} day(s). Recommended to follow up today."
      else
        "Valid for #{days_left} more day(s)."
      end %>
  <section class="quote-signal-strip <%= 'is-urgent' if days_left.present? && days_left <= 3 %>">
    <div class="quote-signal-item">
      <span class="quote-signal-label">Momentum</span>
      <strong><%= urgency_text %></strong>
    </div>
    <div class="quote-signal-item">
      <span class="quote-signal-label">Engagement</span>
      <strong><%= viewed_flag ? "Viewed (#{total_views} view#{'s' unless total_views == 1})" : "Not viewed yet" %></strong>
    </div>
    <div class="quote-signal-item">
      <span class="quote-signal-label">Next Action</span>
      <strong><%= viewed_flag ? "Discuss terms and close" : "Share public link to trigger first view" %></strong>
    </div>
  </section>

  <details class="quote-engagement-details">
    <summary>Engagement Details</summary>
    <% access_events = @quote.quote_shares.flat_map { |share| Array(share.view_events) } %>
    <% country_counts = Hash.new(0) %>
    <% access_events.each do |event| %>
      <% country = event["country"].presence || "Unknown" %>
      <% country_counts[country] += 1 %>
    <% end %>
    <% top_countries = country_counts.sort_by { |(_, count)| -count }.first(3) %>
    <% recent_accesses = access_events.last(5).reverse %>
    <div class="quote-engagement-details-grid">
      <p><strong>Sent:</strong> <%= @quote.sent_at ? @quote.sent_at.strftime("%Y-%m-%d %H:%M") : "-" %></p>
      <p><strong>Last Shared:</strong> <span id="quote-last-shared-at"><%= @quote.quote_shares.maximum(:created_at)&.strftime("%Y-%m-%d %H:%M") || "-" %></span></p>
      <p><strong>First Viewed:</strong> <%= @quote.quote_shares.minimum(:first_viewed_at)&.strftime("%Y-%m-%d %H:%M") || "-" %></p>
      <p><strong>Last Viewed:</strong> <%= @quote.viewed_at ? @quote.viewed_at.strftime("%Y-%m-%d %H:%M") : "-" %></p>
      <p><strong>Total Views:</strong> <%= @quote.quote_shares.sum(&:view_count) %></p>
      <p><strong>Top Countries:</strong> <%= top_countries.any? ? top_countries.map { |country, count| "#{country} (#{count})" }.join(", ") : "-" %></p>
      <p><strong>Recent Accesses:</strong> <%= recent_accesses.any? ? recent_accesses.map { |event| "#{event['at']}#{event['country'].present? ? " [#{event['country']}]" : ""}" }.join(" | ") : "-" %></p>
    </div>
  </details>

  <section class="quote-meta-grid">
    <article class="quote-meta-card">
      <h3>Seller</h3>
      <p><strong><%= @quote.company.name %></strong></p>
      <% if active_template.show_customer_owner && Customer.internal_owner_enabled? && @quote.customer.internal_owner_display_name != "-" %>
        <p>Sales Owner: <%= @quote.customer.internal_owner_display_name %></p>
      <% end %>
      <p><%= @quote.company.address.presence || "-" %></p>
      <p><%= @quote.company.phone.presence || "-" %></p>
      <p><%= @quote.company.email.presence || "-" %></p>
      <p><%= @quote.company.website.presence || "-" %></p>
    </article>

    <article class="quote-meta-card">
      <h3>Buyer</h3>
      <p><strong><%= @quote.customer.name %></strong></p>
      <p>Contact: <%= @quote.customer.contact_name.presence || "-" %></p>
      <p><%= @quote.customer.address.presence || "-" %></p>
      <p><%= @quote.customer.phone.presence || "-" %></p>
      <p><%= @quote.customer.email.presence || "-" %></p>
    </article>

    <article class="quote-meta-card">
      <h3>Quote Info</h3>
      <div class="quote-info-list">
        <p class="quote-info-row is-doc-number"><span><%= @template.resolved_document_number_label(@document_kind) %></span><strong><%= @quote.quote_no %></strong></p>
        <% if @quote.custom_title.present? %>
          <p class="quote-info-row"><span>Title</span><strong><%= @quote.custom_title %></strong></p>
        <% end %>
        <p class="quote-info-row"><span><%= @document_kind == "pi" ? "PI Date" : "Quote Date" %></span><strong><%= @quote.issued_on&.strftime("%Y-%m-%d") || "-" %></strong></p>
        <% if @quote.valid_until.present? %>
          <p class="quote-info-row is-valid-until">
            <span>Valid Until</span>
            <strong>
              <%= @quote.valid_until.strftime("%Y-%m-%d") %>
              <% if days_left.negative? %>
                <span class="status-badge status-expired">Expired</span>
              <% elsif days_left <= 3 %>
                <span class="status-badge status-paused"><%= days_left %>d left</span>
              <% end %>
            </strong>
          </p>
        <% end %>
        <p class="quote-info-row"><span>Currency</span><strong><%= @quote.currency %></strong></p>
        <% if @quote.trade_term.present? %>
          <p class="quote-info-row"><span>Trade Terms</span><strong><%= @quote.trade_term %></strong></p>
        <% end %>
        <p class="quote-info-row"><span>Status</span><strong><%= @quote.status&.capitalize %></strong></p>
        <% if @quote.accepted_at.present? %>
          <p class="quote-info-row"><span>Accepted At</span><strong><%= @quote.accepted_at.strftime("%Y-%m-%d %H:%M") %></strong></p>
        <% end %>
        <% if @quote.changes_requested_at.present? %>
          <p class="quote-info-row"><span>Revision Requested</span><strong><%= @quote.changes_requested_at.strftime("%Y-%m-%d %H:%M") %></strong></p>
          <% if @quote.changes_request_message.present? %>
            <p class="quote-info-row"><span>Client Request</span><strong><%= @quote.changes_request_message %></strong></p>
          <% end %>
        <% end %>
        <% if @quote.reopened_at.present? %>
          <p class="quote-info-row"><span>Reopened At</span><strong><%= @quote.reopened_at.strftime("%Y-%m-%d %H:%M") %></strong></p>
        <% end %>
      </div>
    </article>

  </section>

  <h3>Items</h3>
  <div class="table-responsive">
    <table class="quote-items-table quote-doc-table">
      <colgroup>
        <% if active_template.show_images? %>
          <col class="quote-col-image">
        <% end %>
        <col class="quote-col-description">
        <col class="quote-col-qty">
        <col class="quote-col-money">
        <col class="quote-col-money">
      </colgroup>
      <thead>
        <tr>
          <% if active_template.show_images? %>
            <th>Image</th>
          <% end %>
          <th>Item Details</th>
          <th class="quote-col-right">Qty</th>
          <th class="quote-col-right quote-col-money">Unit Price</th>
          <th class="quote-col-right quote-col-money">Line Total</th>
        </tr>
      </thead>
      <tbody>
        <% @quote.quote_items.ordered.each do |item| %>
          <tr>
            <% if active_template.show_images? %>
              <td>
                <% if item.product&.display_image.present? %>
                  <%= image_tag item.product.display_image, class: "quote-item-image" %>
                <% else %>
                  -
                <% end %>
              </td>
            <% end %>
            <td>
              <div class="quote-item-desc">
                <div class="quote-item-desc-main"><%= item.product&.name.presence || "Item" %></div>
                <% if item.specification_pairs.any? || item.addon_charge_entries.any? %>
                  <div class="quote-item-desc-meta">
                    <% if item.specification_pairs.any? %>
                      <div class="quote-item-desc-group">
                        <div class="quote-item-desc-group-label"><%= spec_label %>:</div>
                        <% item.specification_pairs.each do |pair| %>
                          <div class="quote-item-desc-sub"><span class="quote-item-desc-bullet">&bull;</span><%= pair[:key] %> - <%= pair[:value] %></div>
                        <% end %>
                      </div>
                    <% end %>
                    <% if item.addon_charge_entries.any? %>
                      <div class="quote-item-desc-group is-addon">
                        <div class="quote-item-desc-group-label"><%= addon_label %>:</div>
                        <% item.addon_charge_entries.each do |entry| %>
                          <div class="quote-item-desc-sub is-addon"><span class="quote-item-desc-bullet">&bull;</span><%= entry[:name] %> (<%= quote_money(entry[:amount], @quote.currency, show_symbol: active_template.show_currency) %>)</div>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </td>
            <td class="quote-col-right"><%= item.quantity %></td>
            <td class="quote-col-right quote-col-money"><%= quote_money(item.unit_price, @quote.currency, show_symbol: active_template.show_currency) %></td>
            <td class="quote-col-right quote-col-money"><%= quote_money(item.line_total, @quote.currency, show_symbol: active_template.show_currency) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <aside class="quote-total-box">
    <p><span>Subtotal</span><strong><%= quote_money(@quote.subtotal, @quote.currency, show_symbol: active_template.show_currency) %></strong></p>
    <% if active_template.show_tax %>
      <p><span>Tax / VAT</span><strong><%= quote_money(@quote.tax_amount, @quote.currency, show_symbol: active_template.show_currency) %></strong></p>
    <% end %>
    <% if active_template.show_shipping %>
      <p><span>Shipping</span><strong><%= quote_money(@quote.shipping_amount, @quote.currency, show_symbol: active_template.show_currency) %></strong></p>
    <% end %>
    <p><span>Discount</span><strong><%= quote_money(@quote.discount_amount, @quote.currency, show_symbol: active_template.show_currency) %></strong></p>
    <p class="quote-total-grand"><span>Grand Total</span><strong><%= quote_money(@quote.grand_total, @quote.currency, show_symbol: active_template.show_currency) %></strong></p>
    <% if (closing_message = active_template.resolved_closing_message).present? %>
      <p class="quote-engagement-note"><%= closing_message %></p>
    <% end %>
  </aside>

  <% terms_lines = [] %>
  <% if active_template.show_terms_section %>
    <% terms_lines << [ "Payment Terms", @quote.payment_term ] if active_template.show_payment_term && @quote.payment_term.present? %>
    <% terms_lines << [ "Trade Terms", @quote.trade_term ] if @quote.trade_term.present? %>
    <% terms_lines << [ "Terms", @quote.terms_text ] if @quote.terms_text.present? %>
    <% terms_lines << [ "Legal Disclaimer", @quote.legal_disclaimer ] if @quote.legal_disclaimer.present? %>
    <% terms_lines << [ "Delivery Notes", @quote.delivery_notes ] if @quote.delivery_notes.present? %>
  <% end %>
  <% if terms_lines.any? %>
    <section class="quote-section-block">
      <h3>Terms & Conditions</h3>
      <% terms_lines.each do |label, value| %>
        <p><strong><%= label %>:</strong> <%= value %></p>
      <% end %>
    </section>
  <% end %>

  <% if active_template.show_notes && @quote.notes.present? %>
    <section class="quote-section-block">
      <h3>Internal Notes</h3>
      <p><%= simple_format(@quote.notes) %></p>
    </section>
  <% end %>

  <% footer_note = @template.resolved_footer_note(@document_kind) %>
  <% if footer_note.present? %>
    <section class="quote-section-block">
      <h3>Footer Note</h3>
      <div><%= simple_format(footer_note) %></div>
    </section>
  <% end %>
  <% if active_template.show_saas_branding %>
    <p class="quote-public-footnote"><%= active_template.saas_branding_footer_text %></p>
  <% end %>
</div>

<div class="quote-toolbar">
  <div class="quote-toolbar-left">
    <% if @quote.can_edit_revision? %>
      <div class="quote-template-picker">
        <label for="template_select_<%= @quote.id %>">Template</label>
        <%= select_tag :template_id,
                       options_from_collection_for_select(@template_options, :id, :name, @template.id),
                       id: "template_select_#{@quote.id}",
                       class: "js-template-select",
                       data: { update_url: update_template_quote_path(@quote), doc: @document_kind } %>
      </div>
    <% end %>

    <details class="quote-toolbar-export">
      <summary class="quote-btn quote-btn-secondary">Export</summary>
      <div class="quote-toolbar-export-menu">
        <%= button_to "Download PDF",
                      export_pdf_quote_path(@quote),
                      method: :get,
                      params: { doc: @document_kind, document_kind: @document_kind },
                      form: { data: { turbo: false } },
                      class: "quote-btn quote-btn-secondary" %>
        <%= link_to "Download Excel", export_xlsx_quote_path(@quote, doc: @document_kind), class: "quote-btn quote-btn-secondary" %>
      </div>
    </details>
  </div>

  <div class="quote-toolbar-right">
    <div class="quote-toolbar-right-secondary">
      <% if @quote.can_edit_revision? %>
        <%= link_to "Edit", edit_quote_path(@quote), class: "quote-btn quote-btn-secondary" %>
      <% end %>
      <% if @quote.can_create_new_revision? %>
        <%= button_to "New Revision", duplicate_quote_path(@quote), method: :post, form: { data: { turbo: false } }, class: "quote-btn quote-btn-secondary" %>
      <% end %>
      <% if @quote.can_reopen? %>
        <%= button_to "Reopen", reopen_quote_path(@quote), method: :post, form: { data: { turbo_confirm: "Reopen this quotation lifecycle and restore active flow?" } }, class: "quote-btn quote-btn-secondary" %>
      <% end %>
      <% if @quote.can_copy_and_reprice? %>
        <%= button_to "Copy & Reprice", duplicate_and_reprice_quote_path(@quote), method: :post, form: { data: { turbo: false } }, class: "quote-btn quote-btn-secondary" %>
      <% end %>
      <% if @quote.can_switch_document? %>
        <% if @document_kind == "pi" %>
          <%= link_to "Switch to Quotation", quote_path(@quote, doc: "quote", document_kind: "quote"), class: "quote-btn quote-btn-secondary" %>
        <% else %>
          <%= link_to "Switch to PI", quote_path(@quote, doc: "pi", document_kind: "pi"), class: "quote-btn quote-btn-secondary" %>
        <% end %>
      <% end %>
    </div>
    <div class="quote-toolbar-right-primary">
      <% if @quote.can_share_publicly? %>
        <div class="share-link-group">
          <button type="button"
                  class="quote-btn quote-btn-primary js-share-public-link"
                  data-share-url="<%= share_quote_path(@quote, doc: @document_kind, format: :json) %>">
            Share Public Link
          </button>
          <div class="share-link-panel" id="quote-share-panel" hidden>
            <div class="share-link-panel-message" id="quote-share-message"></div>
            <div class="share-link-panel-actions">
              <button type="button" class="share-link-panel-btn" id="quote-share-copy-btn">Copy Link</button>
              <a href="#" target="_blank" rel="noopener" class="share-link-panel-btn is-link" id="quote-share-open-link">Open</a>
            </div>
          </div>
        </div>
      <% end %>
      <% if @quote.can_delete_revision? %>
        <%= button_to "Delete Quote", quote_path(@quote), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this quote? This action cannot be undone." }, class: "quote-btn quote-btn-danger" %>
      <% end %>
    </div>
  </div>
</div>

<section class="quote-history">
  <h3>History</h3>
  <% revisions = @quote.customer.quotes.where(quote_no: @quote.quote_no).order(revision_number: :desc).to_a %>
  <% latest_revision = revisions.first %>
  <p class="quote-history-meta">
    <span><strong><%= revisions.size %></strong> revision(s)</span>
    <span>Current updated: <strong><%= @quote.updated_at&.strftime("%Y-%m-%d %H:%M") || "-" %></strong></span>
  </p>
  <div class="quote-history-tabs">
    <% revisions.each do |q| %>
      <% is_current = q.id == @quote.id %>
      <% tab_class = "history-tab#{' active' if is_current}" %>
      <% label = "V#{q.revision_number}" %>
      <% if is_current %>
        <span class="<%= tab_class %>">
          <%= label %>
          <span class="history-tab-tag">Current</span>
          <% if latest_revision&.id == q.id %>
            <span class="history-tab-tag history-tab-tag-latest">Latest</span>
          <% end %>
        </span>
      <% else %>
        <%= link_to quote_path(q), class: tab_class do %>
          <%= label %>
          <% if latest_revision&.id == q.id %>
            <span class="history-tab-tag history-tab-tag-latest">Latest</span>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</section>

<script>
  (() => {
    const button = document.querySelector(".js-share-public-link");
    const panel = document.getElementById("quote-share-panel");
    const message = document.getElementById("quote-share-message");
    const copyButton = document.getElementById("quote-share-copy-btn");
    const openLink = document.getElementById("quote-share-open-link");
    const lastSharedAt = document.getElementById("quote-last-shared-at");
    if (!button || !panel || !message || !copyButton || !openLink || button.dataset.bound === "true") return;
    button.dataset.bound = "true";

    const csrf = document.querySelector("meta[name='csrf-token']")?.content;
    let timer = null;
    let currentShareUrl = "";

    const showPanel = (text, isError = false) => {
      message.textContent = text;
      panel.classList.toggle("is-error", isError);
      panel.hidden = false;
      if (timer) window.clearTimeout(timer);
      timer = window.setTimeout(() => { panel.hidden = true; }, 4200);
    };

    const hidePanel = () => {
      panel.hidden = true;
      if (timer) window.clearTimeout(timer);
    };

    const copyText = async (text) => {
      try {
        if (navigator.clipboard?.writeText && window.isSecureContext) {
          await navigator.clipboard.writeText(text);
          return true;
        }
      } catch (_) {
        // Fallback to legacy copy path below.
      }

      try {
        const textarea = document.createElement("textarea");
        textarea.value = text;
        textarea.setAttribute("readonly", "");
        textarea.style.position = "fixed";
        textarea.style.top = "-9999px";
        textarea.style.left = "-9999px";
        document.body.appendChild(textarea);
        textarea.focus();
        textarea.select();
        const ok = document.execCommand("copy");
        document.body.removeChild(textarea);
        return !!ok;
      } catch (_) {
        return false;
      }
    };

    button.addEventListener("click", async () => {
      button.disabled = true;
      try {
        const response = await fetch(button.dataset.shareUrl, {
          method: "POST",
          headers: {
            "Accept": "application/json",
            "Content-Type": "application/json",
            "X-CSRF-Token": csrf || ""
          },
          credentials: "same-origin",
          body: JSON.stringify({})
        });

        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !payload.url) {
          throw new Error(payload.message || "Unable to generate public link");
        }

        const copied = await copyText(payload.url);
        currentShareUrl = payload.url;
        try {
          const previewUrl = new URL(payload.url, window.location.origin);
          previewUrl.searchParams.set("preview", "1");
          openLink.href = previewUrl.toString();
        } catch (_) {
          const separator = payload.url.includes("?") ? "&" : "?";
          openLink.href = `${payload.url}${separator}preview=1`;
        }
        openLink.hidden = false;
        if (lastSharedAt) {
          const now = new Date();
          const pad = (n) => String(n).padStart(2, "0");
          const stamp = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())} ${pad(now.getHours())}:${pad(now.getMinutes())}`;
          lastSharedAt.textContent = stamp;
        }
        if (copied) {
          showPanel("Public link ready. Copied to clipboard.");
          window.showAppToast?.("Public link copied.", "success");
        } else {
          showPanel("Public link ready. Copy manually if needed.");
          window.showAppToast?.("Public link ready. Copy manually if needed.", "warn");
        }
      } catch (error) {
        currentShareUrl = "";
        openLink.href = "#";
        openLink.hidden = true;
        showPanel(error.message || "Share failed", true);
        window.showAppToast?.(error.message || "Share failed", "error");
      } finally {
        button.disabled = false;
      }
    });

    copyButton.addEventListener("click", async () => {
      if (!currentShareUrl) return;
      const copied = await copyText(currentShareUrl);
      showPanel(copied ? "Link copied." : "Copy failed on browser.", !copied);
      window.showAppToast?.(copied ? "Link copied." : "Copy failed on browser.", copied ? "success" : "error");
    });

    openLink.addEventListener("click", () => {
      hidePanel();
    });

    document.addEventListener("click", (event) => {
      if (panel.hidden) return;
      if (event.target.closest(".share-link-group")) return;
      hidePanel();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") hidePanel();
    });
  })();

  (() => {
    const exportMenus = document.querySelectorAll(".quote-toolbar-export");
    if (!exportMenus.length) return;

    const closeAll = () => {
      exportMenus.forEach((menu) => {
        menu.removeAttribute("open");
      });
    };

    document.addEventListener("click", (event) => {
      if (event.target.closest(".quote-toolbar-export")) return;
      closeAll();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      closeAll();
    });
  })();
</script>
