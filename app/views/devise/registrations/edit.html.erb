<%= render "shared/settings_header", title: "Account Settings", section: :account %>

<section class="team-members-panel">
  <h2>Personal Profile</h2>
  <p class="team-members-hint">Manage your working identity. Security verification is not required for profile-only changes.</p>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { id: "edit_user_profile", method: :put, multipart: true, data: { turbo: false, dirty_guard: true } }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="account-avatar-row">
      <div class="account-avatar-preview">
        <% has_avatar = resource.avatar.attached? && resource.avatar.blob&.persisted? %>
        <% if has_avatar %>
          <%= image_tag resource.avatar, alt: "Avatar", id: "user_avatar_preview_img" %>
        <% else %>
          <%= tag.img id: "user_avatar_preview_img", alt: "Avatar", hidden: true %>
        <% end %>
        <span id="user_avatar_preview_fallback" <%= "hidden" if has_avatar %>><%= resource.email.to_s.first.to_s.upcase %></span>
      </div>
      <div class="account-avatar-actions">
        <%= f.label :avatar, "Upload Avatar" %>
        <%= f.file_field :avatar, accept: "image/*", data: { live_preview_target: "#user_avatar_preview_img", live_preview_fallback: "#user_avatar_preview_fallback" } %>
        <% if resource.avatar.attached? %>
          <%= button_tag "Remove Current Avatar",
                         type: "submit",
                         name: "user[remove_avatar]",
                         value: "1",
                         class: "btn btn-secondary account-remove-avatar-btn",
                         data: { turbo: false } %>
        <% end %>
      </div>
    </div>

    <div>
      <%= f.label :full_name, "Display Name" %>
      <%= f.text_field :full_name, placeholder: "How teammates and clients see your name" %>
    </div>

    <div>
      <%= f.label :contact_phone, "Contact Number" %>
      <%= f.text_field :contact_phone, placeholder: "+1 ..." %>
    </div>

    <div>
      <%= f.label :job_title, "Job Title" %>
      <%= f.text_field :job_title, placeholder: "Sales Manager / Founder" %>
    </div>

    <div>
      <%= f.label :time_zone, "Time Zone" %>
      <%= f.select :time_zone,
                   options_for_select(time_zone_options_for_select, resource.time_zone.presence || "UTC"),
                   {},
                   { id: "user_time_zone_select", data: { searchable_select: true, searchable_kind: "timezone", search_placeholder: "Search city, country, or GMT offset", phone_field: "#user_contact_phone" } } %>
    </div>

    <div>
      <%= f.label :language, "Language" %>
      <%= f.select :language, options_for_select([["English", "en"]], resource.language.presence || "en") %>
    </div>

    <%= f.hidden_field :email, value: resource.email %>
    <%= f.submit "Update Profile", class: "btn btn-primary" %>
  <% end %>
</section>

<section class="team-members-panel">
  <h2>Security Settings</h2>
  <p class="team-members-hint">Change email or password here. Current password is required for security updates.</p>

  <!-- Email Display & Change -->
  <div style="margin-bottom: 30px; padding-bottom: 20px; border-bottom: 1px solid #eee;">
    <label style="display: block; margin-bottom: 8px; font-weight: 500; color: #333;">Email Address</label>
    <div style="display: flex; align-items: center; gap: 10px;">
      <span style="padding: 8px 12px; background: #f5f5f5; border-radius: 4px; color: #666; flex: 1;">
        <%= resource.email %>
      </span>
      <button type="button" class="btn btn-secondary" id="change-email-btn" style="white-space: nowrap;">
        Change Email
      </button>
    </div>
    <p style="margin-top: 8px; font-size: 0.9em; color: #999;">
      You'll need to verify the new email address before it becomes active.
    </p>
  </div>

  <!-- Password Change Form -->
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { id: "edit_user_security", method: :put, data: { turbo: false, dirty_guard: true } }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :password, "New password (optional)" %>
      <%= f.password_field :password, autocomplete: "new-password" %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirm new password" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
    </div>

    <div>
      <%= f.label :current_password, "Current password (required for security changes)" %>
      <%= f.password_field :current_password, autocomplete: "current-password" %>
    </div>

    <%= f.submit "Update Security Settings", class: "btn btn-primary" %>
  <% end %>
</section>

<section class="team-members-panel">
  <h2>Company Invitations</h2>
  <p class="team-members-hint">
    You currently have <strong><%= pending_team_invitations_count %></strong> pending company invitation(s).
    <%= link_to "Open Invitations", team_invitations_path %>
  </p>
</section>
<!-- Email Change Modal -->
<div id="email-change-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 9999; justify-content: center; align-items: center;">
  <div style="background: white; padding: 30px; border-radius: 12px; max-width: 100%; width: 90%; max-width: 420px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); max-height: 90vh; overflow-y: auto;">
    <h3 style="margin: 0 0 10px 0; color: #333;">Change Email Address</h3>
    <p style="margin: 0 0 20px 0; color: #666; font-size: 14px;">We'll send a verification link to your new email address. You must click it to complete the change.</p>

    <form id="email-change-form">
      <div style="margin-bottom: 15px;">
        <label style="display: block; margin-bottom: 6px; font-weight: 500; font-size: 14px; color: #333;">New Email Address</label>
        <input type="email" id="new-email-input" required placeholder="your-new-email@example.com" style="width: 100%; padding: 8px 12px; border: 1px solid #ddd; border-radius: 4px; font-size: 14px; box-sizing: border-box;">
      </div>

      <div style="margin-bottom: 20px;">
        <label style="display: block; margin-bottom: 6px; font-weight: 500; font-size: 14px; color: #333;">Current Password</label>
        <input type="password" id="current-password-input" required placeholder="Enter your password to confirm" style="width: 100%; padding: 8px 12px; border: 1px solid #ddd; border-radius: 4px; font-size: 14px; box-sizing: border-box;">
        <p style="margin: 6px 0 0 0; font-size: 0.85em; color: #999;">For security, we need to verify your password.</p>
      </div>

      <div id="email-change-error" style="display: none; margin-bottom: 15px; padding: 12px; background: #fee; border: 1px solid #fcc; border-radius: 4px; color: #c33; font-size: 14px;"></div>

      <div id="email-change-success" style="display: none; margin-bottom: 15px; padding: 12px; background: #efe; border: 1px solid #cfc; border-radius: 4px; color: #3c3; font-size: 14px;"></div>

      <div style="display: flex; gap: 10px;">
        <button type="submit" class="btn btn-primary" id="email-change-submit-btn" style="flex: 1;">Send Verification Email</button>
        <button type="button" class="btn btn-secondary" id="email-change-cancel-btn" style="flex: 1;">Cancel</button>
      </div>
    </form>
  </div>
</div>

<!-- Email Change Verification Modal -->
<div id="email-change-verification-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 10000; justify-content: center; align-items: center;">
  <div style="background: white; padding: 30px; border-radius: 12px; max-width: 100%; width: 90%; max-width: 380px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); max-height: 90vh; overflow-y: auto;">
    <h3 style="margin: 0 0 10px 0; text-align: center; color: #333;">Security Verification</h3>
    <p style="margin: 0 0 20px 0; text-align: center; color: #666; font-size: 14px;">Please complete the verification to continue</p>

    <div id="email-change-turnstile-loading" style="text-align: center; padding: 20px 0; color: #999;">
      <p>Loading verification...</p>
    </div>

    <div id="email-change-turnstile-container" style="display: none; text-align: center; overflow-x: auto;">
      <div class="cf-turnstile"></div>
    </div>

    <div id="email-change-turnstile-success" style="display: none; text-align: center; padding: 20px 0;">
      <p style="color: #28a745; font-size: 16px; margin: 0;">✓ Verified! Sending...</p>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const changeEmailBtn = document.getElementById('change-email-btn');
    const emailChangeModal = document.getElementById('email-change-modal');
    const verificationModal = document.getElementById('email-change-verification-modal');
    const emailChangeForm = document.getElementById('email-change-form');
    const cancelBtn = document.getElementById('email-change-cancel-btn');
    const submitBtn = document.getElementById('email-change-submit-btn');
    const errorDiv = document.getElementById('email-change-error');
    const successDiv = document.getElementById('email-change-success');
    const newEmailInput = document.getElementById('new-email-input');
    const currentPasswordInput = document.getElementById('current-password-input');
    const loadingDiv = document.getElementById('email-change-turnstile-loading');
    const containerDiv = document.getElementById('email-change-turnstile-container');
    const turnstileSuccessDiv = document.getElementById('email-change-turnstile-success');
    const skipTurnstile = <%= ENV["SKIP_TURNSTILE_VERIFICATION"] == "true" ? "true" : "false" %>;

    if (!changeEmailBtn || !emailChangeModal || !verificationModal || !emailChangeForm) {
      return;
    }

    let verificationComplete = false;
    let isSubmitting = false;
    let turnstileToken = '';

    changeEmailBtn.addEventListener('click', function() {
      emailChangeModal.style.display = 'flex';
      newEmailInput.value = '';
      currentPasswordInput.value = '';
      verificationComplete = false;
      turnstileToken = '';
      errorDiv.style.display = 'none';
      successDiv.style.display = 'none';
    });

    cancelBtn.addEventListener('click', function() {
      emailChangeModal.style.display = 'none';
    });

    emailChangeModal.addEventListener('click', function(e) {
      if (e.target === emailChangeModal) {
        emailChangeModal.style.display = 'none';
      }
    });

    emailChangeForm.addEventListener('submit', function(e) {
      e.preventDefault();

      if (isSubmitting) {
        return;
      }

      const newEmail = newEmailInput.value.trim();
      const currentPassword = currentPasswordInput.value;

      errorDiv.style.display = 'none';
      successDiv.style.display = 'none';

      if (skipTurnstile) {
        submitEmailChange(newEmail, currentPassword, null);
        return;
      }

      verificationComplete = false;
      turnstileToken = '';
      verificationModal.style.display = 'flex';
      loadingDiv.style.display = 'block';
      containerDiv.style.display = 'none';
      turnstileSuccessDiv.style.display = 'none';

      setTimeout(renderTurnstile, 300);
    });

    function renderTurnstile() {
      if (typeof turnstile === 'undefined') {
        setTimeout(renderTurnstile, 200);
        return;
      }

      loadingDiv.style.display = 'none';
      containerDiv.style.display = 'block';

      const widget = containerDiv.querySelector('.cf-turnstile');
      if (widget.dataset.rendered === 'true') {
        widget.innerHTML = '';
        widget.removeAttribute('data-rendered');
      }

      turnstile.render(widget, {
        sitekey: '<%= ENV.fetch("TURNSTILE_SITE_KEY", "0x4AAAAAACkKXqa756rWhUr7") %>',
        theme: 'light',
        callback: function(token) {
          verificationComplete = true;
          turnstileToken = token;
          containerDiv.style.display = 'none';
          turnstileSuccessDiv.style.display = 'block';

          setTimeout(function() {
            verificationModal.style.display = 'none';
            submitEmailChange(newEmailInput.value.trim(), currentPasswordInput.value, token);
          }, 800);
        }
      });
      widget.dataset.rendered = 'true';
    }

    function submitEmailChange(newEmail, currentPassword, token) {
      isSubmitting = true;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';

      const payload = {
        new_email: newEmail,
        current_password: currentPassword
      };

      if (token) {
        payload.cf_turnstile_response = token;
      }

      fetch('<%= request_email_change_path %>', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
        },
        body: JSON.stringify(payload)
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          successDiv.textContent = data.message;
          successDiv.style.display = 'block';
          emailChangeForm.reset();

          setTimeout(() => {
            emailChangeModal.style.display = 'none';
          }, 3000);
        } else {
          errorDiv.textContent = data.error || 'An error occurred';
          errorDiv.style.display = 'block';
        }
      })
      .catch(error => {
        console.error('Error:', error);
        errorDiv.textContent = 'Failed to send verification email. Please try again.';
        errorDiv.style.display = 'block';
      })
      .finally(() => {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Verification Email';
        isSubmitting = false;
        verificationComplete = false;
        turnstileToken = '';
      });
    }

    verificationModal.addEventListener('click', function(e) {
      if (e.target === verificationModal && !verificationComplete) {
        verificationModal.style.display = 'none';
      }
    });
  });
</script>
