<section class="auth-page">
  <div class="auth-card">
    <h1>Sign up</h1>

    <% if @validation_error.present? %>
      <div class="error-messages">
        <h2>Verification Error</h2>
        <ul>
          <li><%= @validation_error %></li>
        </ul>
      </div>
    <% end %>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { id: "signup-form" }) do |f| %>
      <% if resource.errors.any? %>
        <div class="error-messages">
          <h2><%= pluralize(resource.errors.count, "error") %> prevented sign up:</h2>
          <ul>
            <% resource.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :email %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
      </div>

      <div>
        <%= f.label :password %>
        <% if @minimum_password_length %>
          <small>(<%= @minimum_password_length %> characters minimum)</small>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password" %>
      </div>

      <div>
        <%= f.label :password_confirmation %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
      </div>

      <% unless ENV["SKIP_TURNSTILE_VERIFICATION"] == "true" %>
        <%= f.hidden_field :cf_turnstile_response, value: "", id: "cf_turnstile_response" %>
      <% end %>

      <div>
        <%= f.submit "Create account", class: "btn btn-primary", id: "signup-submit-btn" %>
      </div>
    <% end %>

    <div class="auth-links">
      <%= link_to "Log in", new_session_path(resource_name) %>
    </div>
  </div>

  <!-- Verification Modal -->
  <div id="signup-verification-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 9999; justify-content: center; align-items: center;">
    <div style="background: white; padding: 30px; border-radius: 12px; max-width: 100%; width: 90%; max-width: 380px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); max-height: 90vh; overflow-y: auto;">
      <h3 style="margin: 0 0 10px 0; text-align: center; color: #333;">Security Verification</h3>
      <p style="margin: 0 0 20px 0; text-align: center; color: #666; font-size: 14px;">Please complete the verification to continue</p>
      
      <div id="signup-turnstile-loading" style="text-align: center; padding: 20px 0; color: #999;">
        <p>Loading verification...</p>
      </div>
      
      <div id="signup-turnstile-container" style="display: none; text-align: center; overflow-x: auto;">
        <div class="cf-turnstile"></div>
      </div>
      
      <div id="signup-turnstile-success" style="display: none; text-align: center; padding: 20px 0;">
        <p style="color: #28a745; font-size: 16px; margin: 0;">✓ Verified! Submitting...</p>
      </div>
    </div>
  </div>

  <script>
    function initializeSignupForm() {
      const signupForm = document.getElementById('signup-form');
      const submitBtn = document.getElementById('signup-submit-btn');
      const modal = document.getElementById('signup-verification-modal');
      const turnstileResponse = document.getElementById('cf_turnstile_response');
      const loadingDiv = document.getElementById('signup-turnstile-loading');
      const containerDiv = document.getElementById('signup-turnstile-container');
      const successDiv = document.getElementById('signup-turnstile-success');
      
      // Make sure all elements exist
      if (!signupForm || !submitBtn || !modal || !turnstileResponse) {
        return;
      }

      // Clear any old token and state
      turnstileResponse.value = '';
      let verificationComplete = false;
      let isSubmitting = false;

      // Prevent form submission if already submitting
      signupForm.addEventListener('submit', function(e) {
        if (isSubmitting) {
          e.preventDefault();
          return false;
        }
      });

      submitBtn.addEventListener('click', function(e) {
        e.preventDefault();

        // Prevent double-submission
        if (isSubmitting) {
          return;
        }

        // If verification already complete and we have a fresh token, submit immediately
        if (verificationComplete && turnstileResponse.value) {
          isSubmitting = true;
          submitBtn.disabled = true;
          submitBtn.textContent = 'Creating account...';
          signupForm.submit();
          return;
        }

        // Reset and show modal
        verificationComplete = false;
        turnstileResponse.value = ''; // Clear any old token
        submitBtn.disabled = true; // CRITICAL: Disable button immediately when opening modal
        modal.style.display = 'flex';
        loadingDiv.style.display = 'block';
        containerDiv.style.display = 'none';
        successDiv.style.display = 'none';
        
        // Wait for Turnstile API to load, then render
        setTimeout(renderTurnstile, 300);
      });

      function renderTurnstile() {
        if (typeof turnstile === 'undefined') {
          // API not loaded yet, retry
          setTimeout(renderTurnstile, 200);
          return;
        }

        // Hide loading, show container
        loadingDiv.style.display = 'none';
        containerDiv.style.display = 'block';

        const widget = containerDiv.querySelector('.cf-turnstile');
        
        // Clear any previous render
        if (widget.dataset.rendered === 'true') {
          widget.innerHTML = '';
          widget.removeAttribute('data-rendered');
        }

        turnstile.render(widget, {
          sitekey: '<%= ENV.fetch("TURNSTILE_SITE_KEY", "0x4AAAAAACkKXqa756rWhUr7") %>',
          theme: 'light',
          callback: function(token) {
            turnstileResponse.value = token;
            verificationComplete = true;
            
            // Show success message
            containerDiv.style.display = 'none';
            successDiv.style.display = 'block';
            
            // Auto-submit after 1 second
            setTimeout(() => {
              isSubmitting = true;
              modal.style.display = 'none';
              signupForm.submit();
            }, 1000);
          }
        });
        widget.dataset.rendered = 'true';
      }

      // Close modal on background click (only if verification isn't complete)
      modal.addEventListener('click', function(e) {
        if (e.target === modal && !verificationComplete) {
          modal.style.display = 'none';
          turnstileResponse.value = ''; // Clear incomplete verification
          submitBtn.disabled = false; // Re-enable button
          submitBtn.textContent = 'Create account';
        }
      });

      // Restore button state on form reset
      signupForm.addEventListener('reset', function() {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Create account';
        turnstileResponse.value = '';
        verificationComplete = false;
        isSubmitting = false;
      });
    }

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', initializeSignupForm);
    // Re-initialize on Turbo navigation
    document.addEventListener('turbo:load', initializeSignupForm);
  </script>
</section>
