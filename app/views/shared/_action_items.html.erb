<% signal_presenter = QuoteSignalPresenter.new(locale: I18n.locale) %>
<% action_items = local_assigns[:action_items] || @system_action_items || @generated_action_items || [] %>
<% mode = local_assigns[:mode].to_s.presence || "full" %>

<% if mode == "compact_summary" %>
  <% if action_items.any? %>
    <div class="dashboard-side-module-list">
      <% action_items.first(4).each do |item| %>
        <% item_cta = signal_presenter.action_item_cta(item) %>
        <article class="dashboard-side-module-item dashboard-task-item is-<%= item.priority %>">
          <div>
            <span class="dashboard-action-secondary-label"><%= item.reference.is_a?(Quote) ? item.reference.customer.name : item.reference_label %></span>
            <strong><%= item.headline %></strong>
            <small class="dashboard-side-module-subline"><%= item.secondary_text %></small>
          </div>
          <% if item_cta.method == :post %>
            <%= button_to item_cta.label, item_cta.path, method: :post, form: { data: { turbo: false } }, class: ui_button_classes(:secondary, "dashboard-side-module-cta") %>
          <% else %>
            <%= link_to item_cta.label, item_cta.path, class: ui_button_classes(:secondary, "dashboard-side-module-cta") %>
          <% end %>
        </article>
      <% end %>
    </div>
    <% if action_items.size > 4 %>
      <div class="dashboard-task-more" data-action-items-more data-expand-id="action-items" hidden>
        <% action_items.drop(4).each do |item| %>
          <% item_cta = signal_presenter.action_item_cta(item) %>
          <article class="dashboard-side-module-item dashboard-task-item is-<%= item.priority %>">
            <div>
              <span class="dashboard-action-secondary-label"><%= item.reference.is_a?(Quote) ? item.reference.customer.name : item.reference_label %></span>
              <strong><%= item.headline %></strong>
              <small class="dashboard-side-module-subline"><%= item.secondary_text %></small>
            </div>
            <% if item_cta.method == :post %>
              <%= button_to item_cta.label, item_cta.path, method: :post, form: { data: { turbo: false } }, class: ui_button_classes(:secondary, "dashboard-side-module-cta") %>
            <% else %>
              <%= link_to item_cta.label, item_cta.path, class: ui_button_classes(:secondary, "dashboard-side-module-cta") %>
            <% end %>
          </article>
        <% end %>
      </div>
      <div class="dashboard-task-footer">
        <%= render "components/ui/button",
                   variant: :secondary,
                   class: "dashboard-action-toggle dashboard-inline-toggle",
                   attrs: { data: { action_items_toggle: true, action_count: action_items.size - 4, expanded: "false", expand_id: "action-items" } } do %>
          <%= t("dashboard.view.index.show_more", count: action_items.size - 4) %>
        <% end %>
      </div>
    <% end %>
    <p class="dashboard-side-module-meta"><%= t("dashboard.view.action_items.open_items", count: action_items.count) %></p>
  <% else %>
    <p class="dashboard-side-module-note"><%= t("dashboard.view.action_items.no_unresolved") %></p>
  <% end %>
<% else %>
  <section id="action-items-section">
    <%= render "components/ui/card", class: "dashboard-panel dashboard-action-required dashboard-module--urgent app-surface" do %>
      <div class="dashboard-action-summary-head">
        <h2><%= t("dashboard.view.action_items.system_title") %></h2>
        <span class="dashboard-alert-pill <%= action_items.any? ? 'is-watch' : 'is-good' %>">
          <%= t("dashboard.view.action_items.open_items", count: action_items.count) %>
        </span>
      </div>
      <p class="dashboard-panel-note"><%= t("dashboard.view.action_items.system_note") %></p>

      <% if action_items.any? %>
        <div class="dashboard-task-list">
          <% action_items.first(4).each do |item| %>
            <% item_cta = signal_presenter.action_item_cta(item) %>
            <article class="dashboard-task-item is-<%= item.priority %>">
              <div>
                <strong><%= item.headline %></strong>
                <p><%= item.secondary_text %></p>
                <p><%= item.reference.is_a?(Quote) ? item.reference.customer.name : item.reference_label %></p>
              </div>
              <div class="dashboard-task-actions">
                <% if item_cta.method == :post %>
                  <%= button_to item_cta.label, item_cta.path, method: :post, form: { data: { turbo: false } }, class: ui_button_classes(:secondary, "dashboard-next-step-btn is-neutral") %>
                <% else %>
                  <%= link_to item_cta.label, item_cta.path, class: ui_button_classes(:secondary, "dashboard-next-step-btn is-neutral") %>
                <% end %>
                <%= button_to t("dashboard.view.action_items.mark_handled"), resolve_action_item_path(item), method: :patch, class: ui_button_classes(:secondary, "dashboard-next-step-btn is-primary") %>
              </div>
            </article>
          <% end %>

          <% if action_items.size > 4 %>
            <div class="dashboard-task-more" data-action-items-more data-expand-id="action-items" hidden>
              <% action_items.drop(4).each do |item| %>
                <% item_cta = signal_presenter.action_item_cta(item) %>
                <article class="dashboard-task-item is-<%= item.priority %>">
                  <div>
                    <strong><%= item.headline %></strong>
                    <p><%= item.secondary_text %></p>
                    <p><%= item.reference.is_a?(Quote) ? item.reference.customer.name : item.reference_label %></p>
                  </div>
                  <div class="dashboard-task-actions">
                    <% if item_cta.method == :post %>
                      <%= button_to item_cta.label, item_cta.path, method: :post, form: { data: { turbo: false } }, class: ui_button_classes(:secondary, "dashboard-next-step-btn is-neutral") %>
                    <% else %>
                      <%= link_to item_cta.label, item_cta.path, class: ui_button_classes(:secondary, "dashboard-next-step-btn is-neutral") %>
                    <% end %>
                    <%= button_to t("dashboard.view.action_items.mark_handled"), resolve_action_item_path(item), method: :patch, class: ui_button_classes(:secondary, "dashboard-next-step-btn is-primary") %>
                  </div>
                </article>
              <% end %>
            </div>

            <div class="dashboard-task-footer">
              <%= render "components/ui/button",
                         variant: :secondary,
                         class: "dashboard-action-toggle dashboard-inline-toggle",
                         attrs: { data: { action_items_toggle: true, action_count: action_items.size - 4, expanded: "false", expand_id: "action-items" } } do %>
                <%= t("dashboard.view.index.show_more", count: action_items.size - 4) %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="dashboard-panel-note"><%= t("dashboard.view.action_items.no_unresolved") %></p>
      <% end %>
    <% end %>
  </section>
<% end %>
