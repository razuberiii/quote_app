<% perspectives = t("seo.view.buyer_facing_quotation_link.perspectives") %>

<section class="app-page-shell marketing-page-shell">
  <%= render "components/ui/card", class: "app-surface marketing-hero-shell" do %>
    <div class="grid gap-8 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:items-start">
      <div class="marketing-section-heading">
        <p class="marketing-section-kicker"><%= t("seo.view.buyer_facing_quotation_link.hero.kicker") %></p>
        <h1 class="marketing-section-title max-w-none"><%= t("seo.view.buyer_facing_quotation_link.hero.title") %></h1>
        <p class="marketing-section-body"><%= t("seo.view.buyer_facing_quotation_link.hero.body") %></p>
        <div class="flex flex-wrap gap-3">
          <%= render "components/ui/button", href: sample_quote_path, variant: :primary, attrs: { target: "_blank" } do %>
            <%= t("seo.view.shared.links.view_sample_quote") %>
          <% end %>
        </div>
      </div>

      <div class="marketing-overview-panel">
        <article class="marketing-overview-panel__row">
          <p class="app-stat-label"><%= t("seo.view.buyer_facing_quotation_link.cards.action.label") %></p>
          <p class="app-subtle-note mt-2"><%= t("seo.view.buyer_facing_quotation_link.cards.action.body") %></p>
        </article>
        <article class="marketing-overview-panel__row">
          <p class="app-stat-label"><%= t("seo.view.buyer_facing_quotation_link.cards.visibility.label") %></p>
          <p class="app-subtle-note mt-2"><%= t("seo.view.buyer_facing_quotation_link.cards.visibility.body") %></p>
        </article>
        <article class="marketing-overview-panel__row">
          <p class="app-stat-label"><%= t("seo.view.buyer_facing_quotation_link.cards.thread.label") %></p>
          <p class="app-subtle-note mt-2"><%= t("seo.view.buyer_facing_quotation_link.cards.thread.body") %></p>
        </article>
      </div>
    </div>
  <% end %>

  <%= render "components/ui/card", class: "app-surface marketing-section-card marketing-section-card--perspective", attrs: { "data-controller": "marketing-switcher", "data-marketing-switcher-selected-value": perspectives.first[:key] } do %>
    <div class="app-section-stack gap-5">
      <div class="app-section-stack gap-2">
        <p class="marketing-section-kicker"><%= t("seo.view.buyer_facing_quotation_link.switcher.kicker") %></p>
        <h2 class="marketing-section-title marketing-section-title--quiet max-w-none"><%= t("seo.view.buyer_facing_quotation_link.switcher.title") %></h2>
        <p class="marketing-section-body marketing-section-body--compact"><%= t("seo.view.buyer_facing_quotation_link.switcher.body") %></p>
      </div>

      <div class="marketing-switcher__nav marketing-switcher__nav--inline" role="tablist" aria-label="<%= t('seo.view.buyer_facing_quotation_link.switcher.aria_label') %>">
        <% perspectives.each_with_index do |perspective, index| %>
          <button
            id="buyer-perspective-tab-<%= perspective[:key] %>"
            type="button"
            role="tab"
            class="marketing-switcher__tab marketing-switcher__tab--inline <%= 'is-active' if index.zero? %>"
            aria-controls="buyer-perspective-panel-<%= perspective[:key] %>"
            aria-selected="<%= index.zero? %>"
            tabindex="<%= index.zero? ? 0 : -1 %>"
            data-active="<%= index.zero? %>"
            data-action="click->marketing-switcher#select keydown->marketing-switcher#keydown"
            data-marketing-switcher-target="tab"
            data-state-key="<%= perspective[:key] %>">
            <span class="marketing-switcher__tab-copy">
              <strong><%= perspective[:label] %></strong>
              <span><%= perspective[:summary] %></span>
            </span>
          </button>
        <% end %>
      </div>

      <% perspectives.each_with_index do |perspective, index| %>
        <section
          id="buyer-perspective-panel-<%= perspective[:key] %>"
          class="marketing-switcher__panel <%= 'is-active' if index.zero? %>"
          role="tabpanel"
          aria-labelledby="buyer-perspective-tab-<%= perspective[:key] %>"
          <%= "hidden" unless index.zero? %>
          data-marketing-switcher-target="panel"
          data-state-key="<%= perspective[:key] %>">
          <div class="grid gap-4 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]">
            <article class="marketing-perspective-stage">
              <div class="marketing-perspective-stage__header">
                <p class="marketing-section-kicker marketing-section-kicker--panel"><%= perspective[:panel_kicker] %></p>
                <h3 class="text-2xl font-semibold tracking-tight text-slate-950"><%= perspective[:title] %></h3>
                <p class="app-section-caption"><%= perspective[:body] %></p>
              </div>
              <div class="marketing-perspective-stage__actions">
                <% perspective[:chips].each do |chip| %>
                  <span class="marketing-perspective-stage__chip"><%= chip %></span>
                <% end %>
              </div>
            </article>

            <article class="marketing-version-canvas">
              <p class="marketing-section-kicker"><%= perspective[:record_kicker] %></p>
              <div class="mt-3 space-y-2">
                <% perspective[:record_rows].each do |row| %>
                  <div class="marketing-summary-row <%= 'is-changed' if row[:emphasis] %>">
                    <span class="text-slate-600"><%= row[:label] %></span>
                    <span class="font-semibold text-slate-950"><%= row[:value] %></span>
                  </div>
                <% end %>
              </div>
            </article>
          </div>
        </section>
      <% end %>
    </div>
  <% end %>

  <%= render "seo/continue_reading",
    related_topics: [
      { label: t("seo.view.shared.links.quote_revision_control"), path: quote_revision_control_path },
      { label: t("seo.view.shared.links.foreign_trade_quotation_software"), path: foreign_trade_quotation_software_path }
    ],
    comparison_link: { label: t("seo.view.shared.links.quotation_software_vs_excel"), path: quotation_software_vs_excel_path },
    cta: { label: t("seo.view.shared.links.view_sample_quote"), path: sample_quote_path, target: "_blank" } %>
</section>

