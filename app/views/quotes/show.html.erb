<div class="quote-document">
  <header class="quote-doc-header">
    <div>
      <p class="quote-doc-kicker">Quotation</p>
      <h1>Quote <%= @quote.quote_no %> <span class="quote-doc-version">V<%= @quote.revision_number %></span></h1>
    </div>
    <span class="status-badge status-<%= @quote.status %>"><%= @quote.status&.capitalize %></span>
  </header>

  <section class="quote-meta-grid">
    <article class="quote-meta-card">
      <h3>Seller</h3>
      <p><strong><%= @quote.company.name %></strong></p>
      <p><%= @quote.company.address.presence || "-" %></p>
      <p><%= @quote.company.phone.presence || "-" %></p>
      <p><%= @quote.company.email.presence || "-" %></p>
      <p><%= @quote.company.website.presence || "-" %></p>
    </article>

    <article class="quote-meta-card">
      <h3>Buyer</h3>
      <p><strong><%= @quote.customer.name %></strong></p>
      <p>Contact: <%= @quote.customer.contact_name.presence || "-" %></p>
      <p><%= @quote.customer.address.presence || "-" %></p>
      <p><%= @quote.customer.phone.presence || "-" %></p>
      <p><%= @quote.customer.email.presence || "-" %></p>
    </article>

    <article class="quote-meta-card">
      <h3>Quote Info</h3>
      <p><strong>Quote Date:</strong> <%= @quote.issued_on&.strftime("%Y-%m-%d") %></p>
      <p><strong>Valid Until:</strong> <%= @quote.valid_until&.strftime("%Y-%m-%d") || "-" %></p>
      <p><strong>Currency:</strong> <%= @quote.currency %></p>
      <p><strong>Status:</strong> <%= @quote.status&.capitalize %></p>
    </article>
  </section>

  <h3>Items</h3>
  <table class="quote-items-table quote-doc-table">
    <thead>
      <tr>
        <th>Image</th>
        <th>Description</th>
        <th>Qty</th>
        <th>Unit Price</th>
        <th>Line Total</th>
      </tr>
    </thead>
    <tbody>
      <% @quote.quote_items.ordered.each do |item| %>
        <tr>
          <td>
            <% if item.product&.image&.attached? %>
              <%= image_tag item.product.image, class: "quote-item-image" %>
            <% else %>
              -
            <% end %>
          </td>
          <td><%= item.description %></td>
          <td><%= item.quantity %></td>
          <td><%= number_to_currency(item.unit_price, unit: @quote.currency) %></td>
          <td><%= number_to_currency(item.amount, unit: @quote.currency) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <aside class="quote-total-box">
    <p><span>Subtotal</span><strong><%= number_to_currency(@quote.subtotal, unit: @quote.currency) %></strong></p>
    <p><span>Tax / VAT</span><strong><%= number_to_currency(@quote.tax_amount, unit: @quote.currency) %></strong></p>
    <p><span>Shipping</span><strong><%= number_to_currency(@quote.shipping_amount, unit: @quote.currency) %></strong></p>
    <p><span>Discount</span><strong><%= number_to_currency(@quote.discount_amount, unit: @quote.currency) %></strong></p>
    <p class="quote-total-grand"><span>Grand Total</span><strong><%= number_to_currency(@quote.grand_total, unit: @quote.currency) %></strong></p>
  </aside>

  <% if @quote.payment_term.present? || @quote.terms_text.present? || @quote.legal_disclaimer.present? || @quote.delivery_notes.present? %>
    <section class="quote-section-block">
      <h3>Terms & Conditions</h3>
      <p><strong>Payment Terms:</strong> <%= @quote.payment_term.presence || "-" %></p>
      <p><strong>Terms:</strong> <%= @quote.terms_text.presence || "-" %></p>
      <p><strong>Legal Disclaimer:</strong> <%= @quote.legal_disclaimer.presence || "-" %></p>
      <p><strong>Delivery Notes:</strong> <%= @quote.delivery_notes.presence || "-" %></p>
    </section>
  <% end %>

  <% if @quote.notes.present? %>
    <section class="quote-section-block">
      <h3>Internal Notes</h3>
      <p><%= simple_format(@quote.notes) %></p>
    </section>
  <% end %>
</div>

<div class="quote-toolbar">
  <div class="quote-toolbar-main">
    <%= link_to "Back to Customer", @quote.customer, class: "quote-back-link" %>
    <%= link_to "Edit", edit_quote_path(@quote), class: "btn btn-secondary" %>
    <%= button_to "New Revision", duplicate_quote_path(@quote), method: :post, form: { data: { turbo: false } }, class: "btn btn-primary" %>
    <%= link_to "Share (Public Link)", public_quote_path(@quote), class: "btn btn-secondary", target: "_blank" %>
    <%= link_to "Download PDF", export_pdf_quote_path(@quote), class: "btn btn-secondary" %>
    <%= link_to "Download Excel", export_xlsx_quote_path(@quote), class: "btn btn-secondary" %>
  </div>

  <div class="quote-toolbar-danger">
    <%= button_to "Delete Quote", quote_path(@quote), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this quote? This action cannot be undone." }, class: "btn btn-danger" %>
  </div>
</div>

<section class="quote-history">
  <h3>History</h3>
  <div class="quote-history-tabs">
    <% @quote.customer.quotes.where(quote_no: @quote.quote_no).order(revision_number: :desc).each do |q| %>
      <% is_current = q.id == @quote.id %>
      <% tab_class = "history-tab#{' active' if is_current}" %>
      <% label = "V#{q.revision_number}" %>
      <% if is_current %>
        <span class="<%= tab_class %>"><%= label %></span>
      <% else %>
        <%= link_to label, quote_path(q), class: tab_class %>
      <% end %>
    <% end %>
  </div>
</section>
