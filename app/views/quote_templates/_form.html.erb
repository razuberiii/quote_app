<% advanced_collapsible = local_assigns.fetch(:advanced_collapsible, false) %>
<%= form_with model: quote_template, html: { class: "template-editor-form", data: { template_editor_form: true } } do |f| %>
  <% if quote_template.errors.any? %>
    <div class="error-messages">
      <h2><%= pluralize(quote_template.errors.count, "error") %> prevented this template from being saved:</h2>
      <ul>
        <% quote_template.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="template-identity-row">
    <div>
      <%= f.label :name, "Preset name" %>
      <%= f.text_field :name, required: true, placeholder: "Modern B2B Quotation" %>
    </div>
    <div>
      <%= f.label :slug, "Preset slug" %>
      <%= f.text_field :slug, placeholder: "auto-from-name" %>
    </div>
    <div>
      <%= f.label :document_kind, "Default document view" %>
      <%= f.select :document_kind, [["Quotation", "quotation"], ["Proforma Invoice (PI)", "proforma_invoice"]], {}, data: { template_preview_target: "document-kind" } %>
    </div>
  </section>

  <div class="template-editor-layout">
    <div class="template-editor-sections">
      <section class="template-editor-section template-editor-section-visual">
        <header>
          <h3>Visual Style</h3>
          <p>Control the visual signature of your quotation documents.</p>
        </header>
        <div class="template-form-grid">
          <div>
            <%= f.label :layout_type, "Layout type" %>
            <%= f.select :layout_type, QuoteTemplate.layout_types.keys.map { |it| [it.titleize, it] }, {}, data: { template_preview_target: "layout" } %>
          </div>
          <div>
            <%= f.label :layout_density, "Layout density" %>
            <%= f.select :layout_density, [["Compact", "compact"], ["Standard", "standard"], ["Spacious", "spacious"]], {}, data: { template_preview_target: "density" } %>
          </div>
          <div>
            <%= f.label :accent_color, "Accent color" %>
            <%= f.color_field :accent_color, data: { template_preview_target: "accent" } %>
          </div>
          <div>
            <%= f.label :font_family, "Font family" %>
            <%= f.select :font_family, ["Inter", "Noto Sans", "Segoe UI", "Arial", "Helvetica"], {}, data: { template_preview_target: "font" } %>
          </div>
          <div>
            <%= f.label :logo_position, "Logo position" %>
            <%= f.select :logo_position, [["Right Top", "right"], ["Left Top", "left"], ["Center", "center"]], {}, data: { template_preview_target: "logo-position" } %>
          </div>
        </div>
      </section>

      <section class="template-editor-section">
        <header>
          <h3>Document Structure</h3>
          <p>Decide which blocks should appear by default on quote output.</p>
        </header>
        <div class="template-toggle-grid">
          <label><%= f.check_box :show_logo, data: { template_preview_toggle: "logo" } %> Show logo</label>
          <label><%= f.check_box :show_tax, data: { template_preview_toggle: "tax" } %> Show tax line</label>
          <label><%= f.check_box :show_shipping, data: { template_preview_toggle: "shipping" } %> Show shipping line</label>
          <label><%= f.check_box :show_payment_term, data: { template_preview_toggle: "payment" } %> Show payment term</label>
          <label><%= f.check_box :show_customer_owner, data: { template_preview_toggle: "customer-owner" } %> Show sales owner</label>
          <label><%= f.check_box :show_notes, data: { template_preview_toggle: "notes" } %> Show notes section</label>
          <label><%= f.check_box :show_signature_block, data: { template_preview_toggle: "signature" } %> Show signature block</label>
          <label><%= f.check_box :show_images, data: { template_preview_toggle: "images" } %> Show product images</label>
          <label><%= f.check_box :show_valid_until, data: { template_preview_toggle: "valid-until" } %> Show valid until</label>
          <label><%= f.check_box :show_terms_section, data: { template_preview_toggle: "terms" } %> Show terms section</label>
          <label><%= f.check_box :show_currency, data: { template_preview_toggle: "currency" } %> Show currency symbol/code</label>
          <label><%= f.check_box :show_closing_message, data: { template_preview_toggle: "closing" } %> Show closing message</label>
          <label><%= f.check_box :show_watermark, data: { template_preview_toggle: "watermark" } %> Show watermark</label>
          <label><%= f.check_box :show_saas_branding, data: { template_preview_toggle: "saas-branding" } %> Show Rubusoo footer (white-label off by default)</label>
          <label><%= f.check_box :excel_show_grid_lines %> Show Excel gridlines</label>
        </div>
        <div class="template-form-grid">
          <div>
            <%= f.label :signature_name, "Authorized by name (optional)" %>
            <%= f.text_field :signature_name, placeholder: "e.g. Amy Chen", data: { template_preview_target: "signature-name" } %>
            <p class="template-sub">Used for the signature footer text. Leave blank to hide "Authorized by".</p>
          </div>
          <div>
            <%= f.label :signature_image, "Sales signature image" %>
            <div class="app-file-picker" data-file-picker>
              <%= f.file_field :signature_image, id: "quote_template_signature_image", accept: "image/*", class: "app-file-input", data: { template_preview_target: "signature-image-upload", file_picker_input: true, file_picker_name: "signature-file-name" } %>
              <button type="button" class="app-file-picker-btn" data-file-picker-trigger="quote_template_signature_image">Choose file</button>
              <span class="app-file-picker-name" id="signature-file-name"><%= quote_template.signature_image.attached? ? quote_template.signature_image.filename.to_s : "No file selected" %></span>
            </div>
            <p class="template-sub">This is the sales signature image shown to the customer.</p>
            <% if quote_template.signature_image.attached? %>
              <label><%= check_box_tag "quote_template[remove_signature_image]", "1", false %> Remove existing signature image</label>
            <% end %>
          </div>
          <div data-watermark-text-container>
            <%= f.label :watermark_text, "Watermark text" %>
            <%= f.text_field :watermark_text, placeholder: "CONFIDENTIAL (leave empty to use company name)", data: { template_preview_target: "watermark-text" } %>
            <p class="template-sub" data-watermark-mode-hint>If a watermark image is uploaded, image takes priority and text watermark is hidden.</p>
          </div>
          <div>
            <%= f.label :watermark_image, "Watermark image" %>
            <div class="app-file-picker" data-file-picker>
              <%= f.file_field :watermark_image, id: "quote_template_watermark_image", accept: "image/*", class: "app-file-input", data: { template_preview_target: "watermark-image-upload", file_picker_input: true, file_picker_name: "watermark-file-name", existing_file: quote_template.watermark_image.attached? } %>
              <button type="button" class="app-file-picker-btn" data-file-picker-trigger="quote_template_watermark_image">Choose file</button>
              <span class="app-file-picker-name" id="watermark-file-name"><%= quote_template.watermark_image.attached? ? quote_template.watermark_image.filename.to_s : "No file selected" %></span>
            </div>
            <p class="template-sub">Watermark is rendered behind the quote content.</p>
            <% if quote_template.watermark_image.attached? %>
              <label><%= check_box_tag "quote_template[remove_watermark_image]", "1", false %> Remove existing watermark image</label>
            <% end %>
          </div>
          <div>
            <%= f.label :watermark_opacity, "Watermark intensity (%)" %>
            <%= f.number_field :watermark_opacity, min: 3, max: 40, step: 1, data: { template_preview_target: "watermark-opacity" } %>
            <p class="template-sub">Recommended range: 8-16. Higher value means darker watermark.</p>
          </div>
        </div>
      </section>

      <section class="template-editor-section template-editor-section-compact">
        <header>
          <h3>Number & Format</h3>
          <p>Set money readability standards for all exported quote documents.</p>
        </header>
        <div class="template-form-grid">
          <div>
            <%= f.label :amount_decimals, "Decimal places" %>
            <%= f.select :amount_decimals, [["0", 0], ["2", 2]], {}, data: { template_preview_target: "amount-decimals" } %>
          </div>
          <div>
            <%= f.label :thousand_separator, "Thousand separator" %>
            <%= f.select :thousand_separator, [["1,234.00", "comma"], ["1 234.00", "space"], ["1234.00", "none"]], {}, data: { template_preview_target: "thousand-separator" } %>
          </div>
          <div>
            <%= f.label :currency_display_mode, "Currency display" %>
            <%= f.select :currency_display_mode, [["Symbol Prefix ($123)", "symbol_prefix"], ["Code Prefix (USD 123)", "code_prefix"], ["Code Suffix (123 USD)", "code_suffix"]], {}, data: { template_preview_target: "currency-display-mode" } %>
          </div>
        </div>
      </section>

      <% if advanced_collapsible %>
        <details class="template-editor-section template-editor-section-advanced" open>
          <summary class="template-editor-summary">
            <strong>Labels & Text</strong>
            <span>Advanced settings</span>
          </summary>
          <div class="template-editor-section-body">
            <div class="template-form-grid">
              <div>
                <%= f.label :description_label, "Description label" %>
                <%= f.text_field :description_label, data: { template_preview_target: "label-description" } %>
              </div>
              <div>
                <%= f.label :spec_label, "Spec label" %>
                <%= f.text_field :spec_label, placeholder: "Spec", data: { template_preview_target: "label-spec" } %>
              </div>
              <div>
                <%= f.label :addon_label, "Add-on label" %>
                <%= f.text_field :addon_label, placeholder: "Add-on", data: { template_preview_target: "label-addon" } %>
              </div>
              <div>
                <%= f.label :qty_label, "Qty label" %>
                <%= f.text_field :qty_label, data: { template_preview_target: "label-qty" } %>
              </div>
              <div>
                <%= f.label :unit_price_label, "Unit price label" %>
                <%= f.text_field :unit_price_label, data: { template_preview_target: "label-unit-price" } %>
              </div>
              <div>
                <%= f.label :line_total_label, "Line total label" %>
                <%= f.text_field :line_total_label, data: { template_preview_target: "label-line-total" } %>
              </div>
              <div>
                <%= f.label :quotation_title, "Quotation title" %>
                <%= f.text_field :quotation_title, placeholder: "QUOTATION", data: { template_preview_target: "title-quote" } %>
              </div>
              <div>
                <%= f.label :quotation_number_label, "Quotation number label" %>
                <%= f.text_field :quotation_number_label, placeholder: "Quote #", data: { template_preview_target: "number-label-quote" } %>
              </div>
              <div>
                <%= f.label :pi_title, "PI title" %>
                <%= f.text_field :pi_title, placeholder: "PROFORMA INVOICE" %>
              </div>
              <div>
                <%= f.label :pi_number_label, "PI number label" %>
                <%= f.text_field :pi_number_label, placeholder: "PI #", data: { template_preview_target: "number-label-pi" } %>
              </div>
              <div class="template-span-2">
                <%= f.label :quotation_footer_note, "Quotation footer note" %>
                <%= f.text_area :quotation_footer_note, rows: 2, data: { template_preview_target: "footer-quote" } %>
              </div>
              <div class="template-span-2">
                <%= f.label :pi_footer_note, "PI footer note" %>
                <%= f.text_area :pi_footer_note, rows: 2 %>
              </div>
              <div class="template-span-2">
                <%= f.label :footer_text, "Fallback footer text" %>
                <%= f.text_area :footer_text, rows: 2, data: { template_preview_target: "footer-fallback" } %>
              </div>
              <div class="template-span-2">
                <%= f.label :closing_message, "Closing message under Grand Total" %>
                <%= f.text_area :closing_message, rows: 2, placeholder: QuoteTemplate::DEFAULT_CLOSING_MESSAGE %>
                <p class="template-sub">Optional. Leave empty to hide message completely even if toggle is on.</p>
              </div>
            </div>
          </div>
        </details>
      <% else %>
        <section class="template-editor-section template-editor-section-advanced">
          <header>
            <h3>Labels & Text</h3>
            <p>Advanced text settings for table labels, document titles, and footer notes.</p>
          </header>
          <div class="template-form-grid">
            <div>
              <%= f.label :description_label, "Description label" %>
              <%= f.text_field :description_label, data: { template_preview_target: "label-description" } %>
            </div>
            <div>
              <%= f.label :spec_label, "Spec label" %>
              <%= f.text_field :spec_label, placeholder: "Spec", data: { template_preview_target: "label-spec" } %>
            </div>
            <div>
              <%= f.label :addon_label, "Add-on label" %>
              <%= f.text_field :addon_label, placeholder: "Add-on", data: { template_preview_target: "label-addon" } %>
            </div>
            <div>
              <%= f.label :qty_label, "Qty label" %>
              <%= f.text_field :qty_label, data: { template_preview_target: "label-qty" } %>
            </div>
            <div>
              <%= f.label :unit_price_label, "Unit price label" %>
              <%= f.text_field :unit_price_label, data: { template_preview_target: "label-unit-price" } %>
            </div>
            <div>
              <%= f.label :line_total_label, "Line total label" %>
              <%= f.text_field :line_total_label, data: { template_preview_target: "label-line-total" } %>
            </div>
            <div>
              <%= f.label :quotation_title, "Quotation title" %>
              <%= f.text_field :quotation_title, placeholder: "QUOTATION", data: { template_preview_target: "title-quote" } %>
            </div>
            <div>
              <%= f.label :quotation_number_label, "Quotation number label" %>
              <%= f.text_field :quotation_number_label, placeholder: "Quote #", data: { template_preview_target: "number-label-quote" } %>
            </div>
            <div>
              <%= f.label :pi_title, "PI title" %>
              <%= f.text_field :pi_title, placeholder: "PROFORMA INVOICE" %>
            </div>
            <div>
              <%= f.label :pi_number_label, "PI number label" %>
              <%= f.text_field :pi_number_label, placeholder: "PI #", data: { template_preview_target: "number-label-pi" } %>
            </div>
            <div class="template-span-2">
              <%= f.label :quotation_footer_note, "Quotation footer note" %>
              <%= f.text_area :quotation_footer_note, rows: 2, data: { template_preview_target: "footer-quote" } %>
            </div>
            <div class="template-span-2">
              <%= f.label :pi_footer_note, "PI footer note" %>
              <%= f.text_area :pi_footer_note, rows: 2 %>
            </div>
            <div class="template-span-2">
              <%= f.label :footer_text, "Fallback footer text" %>
              <%= f.text_area :footer_text, rows: 2, data: { template_preview_target: "footer-fallback" } %>
            </div>
            <div class="template-span-2">
              <%= f.label :closing_message, "Closing message under Grand Total" %>
              <%= f.text_area :closing_message, rows: 2, placeholder: QuoteTemplate::DEFAULT_CLOSING_MESSAGE %>
              <p class="template-sub">Optional. Leave empty to hide message completely even if toggle is on.</p>
            </div>
          </div>
        </section>
      <% end %>
    </div>

    <aside class="template-live-pane">
      <div class="template-live-pane-header">
        <h3>Live Preview</h3>
        <p>Real-time rendering with quote-like content.</p>
        <div class="template-live-pane-tools">
          <span class="template-preview-status is-saved" data-template-preview-status>Saved</span>
          <div class="template-preview-scenario">
            <label for="template_preview_scenario">Scenario</label>
            <select id="template_preview_scenario" data-template-preview-scenario>
              <option value="standard">Standard</option>
              <option value="long_text">Long Content</option>
              <option value="spec_heavy">Spec Heavy</option>
            </select>
          </div>
          <div class="template-preview-viewport-switch" data-template-preview-viewports>
            <button type="button" class="is-active" data-template-preview-viewport-btn="desktop" aria-pressed="true">Desktop</button>
            <button type="button" data-template-preview-viewport-btn="tablet" aria-pressed="false">Tablet</button>
            <button type="button" data-template-preview-viewport-btn="mobile" aria-pressed="false">Mobile</button>
          </div>
        </div>
      </div>
      <div class="template-preview template-preview-large template-preview-<%= quote_template.layout_type.presence || 'classic' %> template-preview-viewport-desktop<%= ' quote-watermarked' if quote_template.show_watermark? && quote_template.watermark_image.blank? %>" data-template-preview data-watermark="<%= template_watermark_text(quote_template, 'CONFIDENTIAL') %>" style="--template-accent: <%= quote_template.accent_color.presence || '#1F4E79' %>; --quote-watermark-opacity: <%= template_watermark_opacity(quote_template) %>; font-family: <%= quote_template.font_family.presence || 'Noto Sans' %>, sans-serif;">
        <% if quote_template.watermark_image.attached? %>
          <img src="<%= url_for(quote_template.watermark_image) %>" alt="Watermark image preview" class="quote-watermark-image" data-template-preview-watermark-image data-visible="<%= quote_template.show_watermark? %>">
        <% else %>
          <img src="" alt="Watermark image preview" class="quote-watermark-image" data-template-preview-watermark-image hidden>
        <% end %>
        <div class="preview-header preview-header-<%= quote_template.logo_position.presence || 'right' %>" data-template-preview-logo-position>
          <span data-template-preview-logo data-visible="<%= quote_template.show_logo? %>">LOGO</span>
          <strong data-template-preview-title><%= quote_template.quotation_title.presence || quote_template.resolved_document_title("quote") %></strong>
        </div>
        <div class="preview-body preview-body-rich preview-density-<%= quote_template.layout_density.presence || 'standard' %>" data-template-preview-density>
          <div></div>
          <div></div>
        </div>
        <div class="preview-doc-meta">
          <p><span data-template-preview-number-label><%= quote_template.quotation_number_label.presence || "Quote #" %></span><strong>QT-2026-0001</strong></p>
          <p data-template-preview-valid-until data-visible="<%= quote_template.show_valid_until? %>"><span>Valid Until</span><strong>2026-04-02</strong></p>
          <p data-template-preview-customer-owner data-visible="<%= quote_template.show_customer_owner? %>"><span>Sales Owner</span><strong>Amy Chen</strong></p>
        </div>
        <div class="preview-table preview-table-rich">
          <div class="preview-table-head">
            <span data-template-preview-label-description><%= quote_template.description_label.presence || "Description" %></span>
            <span data-template-preview-label-qty><%= quote_template.qty_label.presence || "Qty" %></span>
            <span data-template-preview-label-unit-price><%= quote_template.unit_price_label.presence || "Unit Price" %></span>
            <span data-template-preview-label-line-total><%= quote_template.line_total_label.presence || "Line Total" %></span>
          </div>
          <div class="preview-table-row">
            <span>
              <span data-template-preview-item-desc-1>Pump body SS304</span>
              <small class="preview-item-extra"><span data-template-preview-spec-label><%= quote_template.spec_label.presence || "Spec" %></span>: <span data-template-preview-item-spec-1>316L / IP55</span></small>
              <small class="preview-item-extra is-addon"><span data-template-preview-addon-label><%= quote_template.addon_label.presence || "Add-on" %></span>: <span data-template-preview-item-addon-1>Wooden Case (+$35)</span></small>
            </span>
            <span data-template-preview-item-qty-1>2</span>
            <span data-template-preview-amount data-template-preview-item-unit-1 data-raw-amount="900"></span>
            <span data-template-preview-amount data-template-preview-item-line-1 data-raw-amount="1800"></span>
          </div>
          <div class="preview-table-row"><span data-template-preview-item-desc-2>Motor 5.5kW</span><span data-template-preview-item-qty-2>1</span><span data-template-preview-amount data-template-preview-item-unit-2 data-raw-amount="620"></span><span data-template-preview-amount data-template-preview-item-line-2 data-raw-amount="620"></span></div>
          <div class="preview-table-row"><span data-template-preview-item-desc-3>Installation kit</span><span data-template-preview-item-qty-3>3</span><span data-template-preview-amount data-template-preview-item-unit-3 data-raw-amount="130"></span><span data-template-preview-amount data-template-preview-item-line-3 data-raw-amount="390"></span></div>
        </div>
        <div class="preview-summary">
          <p><span>Subtotal</span><strong data-template-preview-amount data-template-preview-subtotal data-raw-amount="2810"></strong></p>
          <p data-template-preview-tax data-visible="<%= quote_template.show_tax? %>"><span>Tax / VAT</span><strong data-template-preview-amount data-template-preview-tax-amount data-raw-amount="281"></strong></p>
          <p data-template-preview-shipping data-visible="<%= quote_template.show_shipping? %>"><span>Shipping</span><strong data-template-preview-amount data-template-preview-shipping-amount data-raw-amount="120"></strong></p>
          <p class="preview-total"><span>Grand Total</span><strong data-template-preview-amount data-template-preview-grand-total data-raw-amount="3211"></strong></p>
          <p class="preview-closing" data-template-preview-closing data-visible="<%= quote_template.show_closing_message? %>"><%= quote_template.resolved_closing_message.presence || QuoteTemplate::DEFAULT_CLOSING_MESSAGE %></p>
        </div>
        <div class="preview-meta">
          <p data-template-preview-payment data-visible="<%= quote_template.show_payment_term? %>"><strong>Payment Term:</strong> TT 30% deposit, 70% before shipment</p>
          <p data-template-preview-notes data-visible="<%= quote_template.show_notes? %>"><strong>Notes:</strong> Price valid for 30 days.</p>
          <% if quote_template.signature_image.attached? %>
            <p data-template-preview-signature-image data-visible="<%= quote_template.show_signature_block? %>"><img src="<%= url_for(quote_template.signature_image) %>" alt="Signature preview" class="quote-sales-signature-image"></p>
          <% else %>
            <p data-template-preview-signature-image hidden><img src="" alt="Signature preview" class="quote-sales-signature-image"></p>
          <% end %>
          <p data-template-preview-signature-name data-visible="<%= quote_template.show_signature_block? && quote_template.signature_name.present? %>"><strong>Authorized by:</strong> <span data-template-preview-signature-name-value><%= quote_template.signature_name.presence || "" %></span></p>
        </div>
        <div class="preview-terms" data-template-preview-terms data-visible="<%= quote_template.show_terms_section? %>">
          <strong>Terms:</strong> FOB Shanghai | Lead time 20 days.
        </div>
        <div class="preview-image-strip" data-template-preview-images data-visible="<%= quote_template.show_images? %>">
          <span></span><span></span><span></span>
        </div>
        <p class="preview-footer-note" data-template-preview-footer><%= quote_template.quotation_footer_note.presence || quote_template.footer_text.presence || "Thank you for your business." %></p>
        <p class="preview-saas-footnote" data-template-preview-saas-branding data-visible="<%= quote_template.show_saas_branding? %>"><%= quote_template.saas_branding_footer_text %></p>
      </div>
      <p class="template-preview-contrast-note" data-template-preview-contrast hidden></p>
    </aside>
  </div>

  <div class="template-form-footer">
    <label class="template-default-check"><%= check_box_tag :make_default, "1", quote_template.default_template? %> Set as default template</label>
    <div class="actions">
      <%= f.submit class: "btn btn-primary" %>
      <%= link_to "Back", quote_templates_path, class: "btn btn-secondary" %>
    </div>
  </div>
<% end %>

<script>
  (() => {
    const form = document.querySelector("[data-template-editor-form]");
    if (!form || form.dataset.previewBound === "true") return;
    form.dataset.previewBound = "true";

    const preview = form.querySelector("[data-template-preview]");
    if (!preview) return;

    const qs = (selector) => form.querySelector(selector);
    const qsp = (selector) => preview.querySelector(selector);
    const statusNode = form.querySelector("[data-template-preview-status]");
    const contrastNode = form.querySelector("[data-template-preview-contrast]");
    const scenarioNode = form.querySelector("[data-template-preview-scenario]");
    const viewportButtons = Array.from(form.querySelectorAll("[data-template-preview-viewport-btn]"));
    const previewWatermarkImage = qsp("[data-template-preview-watermark-image]");
    const previewSignatureImage = qsp("[data-template-preview-signature-image] img");
    let watermarkImageObjectUrl = "";
    let signatureImageObjectUrl = "";
    const viewportClasses = [
      "template-preview-viewport-desktop",
      "template-preview-viewport-tablet",
      "template-preview-viewport-mobile"
    ];
    const initialSignature = (() => {
      const parts = [];
      form.querySelectorAll("input[name], select[name], textarea[name]").forEach((field) => {
        if (field.disabled) return;
        const type = field.type ? field.type.toLowerCase() : "";
        if (type === "file") return;
        if (type === "hidden" && /authenticity_token|utf8|_method/.test(field.name)) return;
        if (type === "checkbox" || type === "radio") {
          parts.push(`${field.name}:${field.checked ? "1" : "0"}`);
          return;
        }
        parts.push(`${field.name}:${field.value}`);
      });
      return parts.sort().join("|");
    })();

    const showNode = (selector, visible) => {
      const node = qsp(selector);
      if (!node) return;
      const changed = node.hidden === visible;
      node.hidden = !visible;
      if (changed) {
        node.classList.remove("is-preview-flash");
        window.requestAnimationFrame(() => {
          node.classList.add("is-preview-flash");
        });
      }
    };

    const formatNumber = (value, decimals, separator) => {
      const fixed = Number(value || 0).toFixed(decimals);
      const [intPart, decPart] = fixed.split(".");
      let grouped = intPart;

      if (separator === "comma") grouped = intPart.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
      if (separator === "space") grouped = intPart.replace(/\B(?=(\d{3})+(?!\d))/g, " ");

      if (decimals === 0) return grouped;
      return `${grouped}.${decPart}`;
    };

    const formatMoney = (value, options) => {
      const amount = formatNumber(value, options.decimals, options.separator);
      if (!options.showCurrency) return amount;

      if (options.mode === "code_prefix") return `USD ${amount}`;
      if (options.mode === "code_suffix") return `${amount} USD`;
      return `$${amount}`;
    };

    const hexToRgb = (hex) => {
      const raw = String(hex || "").trim().replace("#", "");
      if (!/^[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$/.test(raw)) return null;
      const normalized = raw.length === 3 ? raw.split("").map((ch) => ch + ch).join("") : raw;
      return {
        r: Number.parseInt(normalized.slice(0, 2), 16),
        g: Number.parseInt(normalized.slice(2, 4), 16),
        b: Number.parseInt(normalized.slice(4, 6), 16)
      };
    };

    const relativeLuminance = (rgb) => {
      const linear = [rgb.r, rgb.g, rgb.b].map((value) => {
        const channel = value / 255;
        return channel <= 0.03928 ? channel / 12.92 : ((channel + 0.055) / 1.055) ** 2.4;
      });
      return 0.2126 * linear[0] + 0.7152 * linear[1] + 0.0722 * linear[2];
    };

    const contrastRatio = (hexA, hexB) => {
      const rgbA = hexToRgb(hexA);
      const rgbB = hexToRgb(hexB);
      if (!rgbA || !rgbB) return null;
      const lumA = relativeLuminance(rgbA);
      const lumB = relativeLuminance(rgbB);
      const lighter = Math.max(lumA, lumB);
      const darker = Math.min(lumA, lumB);
      return (lighter + 0.05) / (darker + 0.05);
    };

    const currentSignature = () => {
      const parts = [];
      form.querySelectorAll("input[name], select[name], textarea[name]").forEach((field) => {
        if (field.disabled) return;
        const type = field.type ? field.type.toLowerCase() : "";
        if (type === "file") return;
        if (type === "hidden" && /authenticity_token|utf8|_method/.test(field.name)) return;
        if (type === "checkbox" || type === "radio") {
          parts.push(`${field.name}:${field.checked ? "1" : "0"}`);
          return;
        }
        parts.push(`${field.name}:${field.value}`);
      });
      return parts.sort().join("|");
    };

    const updateSaveStatus = () => {
      if (!statusNode) return;
      const dirty = currentSignature() !== initialSignature;
      statusNode.textContent = dirty ? "Unsaved changes" : "Saved";
      statusNode.classList.toggle("is-dirty", dirty);
      statusNode.classList.toggle("is-saved", !dirty);
    };

    const updateContrastWarning = (accent) => {
      if (!contrastNode) return;
      const whiteContrast = contrastRatio(accent, "#ffffff");
      const textContrast = contrastRatio(accent, "#0f172a");
      const warnings = [];
      if (whiteContrast && whiteContrast < 4.5) warnings.push("white text on accent");
      if (textContrast && textContrast < 3.0) warnings.push("accent text on white background");

      if (warnings.length === 0) {
        contrastNode.hidden = true;
        contrastNode.textContent = "";
        return;
      }

      contrastNode.hidden = false;
      contrastNode.textContent = `Contrast check: low readability risk for ${warnings.join(" and ")}.`;
    };

    const applyViewport = (viewport) => {
      if (!viewport) return;
      preview.classList.remove(...viewportClasses);
      preview.classList.add(`template-preview-viewport-${viewport}`);
      viewportButtons.forEach((button) => {
        const active = button.dataset.templatePreviewViewportBtn === viewport;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", active ? "true" : "false");
      });
    };

    const applyScenario = (scenario) => {
      const scenarios = {
        standard: {
          desc1: "Pump body SS304",
          spec1: "316L / IP55",
          addon1: "Wooden Case (+$35)",
          qty1: "2",
          unit1: 900,
          line1: 1800,
          desc2: "Motor 5.5kW",
          qty2: "1",
          unit2: 620,
          line2: 620,
          desc3: "Installation kit",
          qty3: "3",
          unit3: 130,
          line3: 390
        },
        long_text: {
          desc1: "High-pressure stainless steel pump body with anti-corrosion treatment and reinforced flange",
          spec1: "316L / IP55 / 380V 50Hz",
          addon1: "Export packaging, reinforced frame, moisture-proof wrapping (+$120)",
          qty1: "2",
          unit1: 980,
          line1: 1960,
          desc2: "Motor with inverter-ready control set and thermal protection",
          qty2: "1",
          unit2: 760,
          line2: 760,
          desc3: "Installation + commissioning support package",
          qty3: "1",
          unit3: 480,
          line3: 480
        },
        spec_heavy: {
          desc1: "Pump body SS304",
          spec1: "Flow 25m3/h | Head 58m | Seal: Sic/Sic",
          addon1: "Spare seal set (+$55), base plate (+$40), wiring loom (+$22)",
          qty1: "1",
          unit1: 1320,
          line1: 1320,
          desc2: "Motor 7.5kW",
          qty2: "2",
          unit2: 690,
          line2: 1380,
          desc3: "Commissioning kit",
          qty3: "2",
          unit3: 210,
          line3: 420
        }
      };
      const data = scenarios[scenario] || scenarios.standard;
      const setText = (selector, value) => {
        const node = qsp(selector);
        if (!node) return;
        node.textContent = value;
      };
      const setAmount = (selector, value) => {
        const node = qsp(selector);
        if (!node) return;
        node.dataset.rawAmount = String(value);
      };

      setText("[data-template-preview-item-desc-1]", data.desc1);
      setText("[data-template-preview-item-spec-1]", data.spec1);
      setText("[data-template-preview-item-addon-1]", data.addon1);
      setText("[data-template-preview-item-qty-1]", data.qty1);
      setAmount("[data-template-preview-item-unit-1]", data.unit1);
      setAmount("[data-template-preview-item-line-1]", data.line1);
      setText("[data-template-preview-item-desc-2]", data.desc2);
      setText("[data-template-preview-item-qty-2]", data.qty2);
      setAmount("[data-template-preview-item-unit-2]", data.unit2);
      setAmount("[data-template-preview-item-line-2]", data.line2);
      setText("[data-template-preview-item-desc-3]", data.desc3);
      setText("[data-template-preview-item-qty-3]", data.qty3);
      setAmount("[data-template-preview-item-unit-3]", data.unit3);
      setAmount("[data-template-preview-item-line-3]", data.line3);

      const subtotal = (data.line1 || 0) + (data.line2 || 0) + (data.line3 || 0);
      const tax = 281;
      const shipping = 120;
      const grandTotal = subtotal + tax + shipping;
      setAmount("[data-template-preview-subtotal]", subtotal);
      setAmount("[data-template-preview-tax-amount]", tax);
      setAmount("[data-template-preview-shipping-amount]", shipping);
      setAmount("[data-template-preview-grand-total]", grandTotal);
    };

    const updatePreview = () => {
      const accent = qs("[data-template-preview-target='accent']")?.value || "#1F4E79";
      const font = qs("[data-template-preview-target='font']")?.value || "Noto Sans";
      const layout = qs("[data-template-preview-target='layout']")?.value || "classic";
      const density = qs("[data-template-preview-target='density']")?.value || "standard";
      const logoPosition = qs("[data-template-preview-target='logo-position']")?.value || "right";
      const titleQuote = qs("[data-template-preview-target='title-quote']")?.value?.trim() || "QUOTATION";
      const documentKind = qs("[data-template-preview-target='document-kind']")?.value || "quotation";
      const labelDesc = qs("[data-template-preview-target='label-description']")?.value?.trim() || "Description";
      const labelQty = qs("[data-template-preview-target='label-qty']")?.value?.trim() || "Qty";
      const labelUnitPrice = qs("[data-template-preview-target='label-unit-price']")?.value?.trim() || "Unit Price";
      const labelLineTotal = qs("[data-template-preview-target='label-line-total']")?.value?.trim() || "Line Total";
      const labelSpec = qs("[data-template-preview-target='label-spec']")?.value?.trim() || "Spec";
      const labelAddon = qs("[data-template-preview-target='label-addon']")?.value?.trim() || "Add-on";
      const numberLabelQuote = qs("[data-template-preview-target='number-label-quote']")?.value?.trim() || "Quote #";
      const numberLabelPi = qs("[data-template-preview-target='number-label-pi']")?.value?.trim() || "PI #";
      const footerQuote = qs("[data-template-preview-target='footer-quote']")?.value?.trim();
      const closingMessage = qs("[name='quote_template[closing_message]']")?.value?.trim();
      const footerFallback = qs("[data-template-preview-target='footer-fallback']")?.value?.trim();
      const decimals = Number.parseInt(qs("[data-template-preview-target='amount-decimals']")?.value || "2", 10);
      const separator = qs("[data-template-preview-target='thousand-separator']")?.value || "comma";
      const currencyMode = qs("[data-template-preview-target='currency-display-mode']")?.value || "symbol_prefix";
      const showCurrency = !!qs("[data-template-preview-toggle='currency']")?.checked;
      const showWatermark = !!qs("[data-template-preview-toggle='watermark']")?.checked;
      const watermarkTextInput = qs("[data-template-preview-target='watermark-text']")?.value?.trim() || "";
      const watermarkOpacityRaw = Number.parseInt(qs("[data-template-preview-target='watermark-opacity']")?.value || "12", 10);
      const signatureName = qs("[data-template-preview-target='signature-name']")?.value?.trim() || "";
      const watermarkUploadInput = qs("[data-template-preview-target='watermark-image-upload']");
      const signatureUploadInput = qs("[data-template-preview-target='signature-image-upload']");
      const removeWatermarkImage = !!qs("[name='quote_template[remove_watermark_image]']")?.checked;
      const removeSignatureImage = !!qs("[name='quote_template[remove_signature_image]']")?.checked;
      let hasWatermarkImage = previewWatermarkImage && !!previewWatermarkImage.getAttribute("src") && !removeWatermarkImage;
      let hasSignatureImage = previewSignatureImage && !!previewSignatureImage.getAttribute("src") && !removeSignatureImage;

      preview.classList.remove("template-preview-classic", "template-preview-modern", "template-preview-industry");
      preview.classList.add(`template-preview-${layout}`);
      preview.style.setProperty("--template-accent", accent);
      const watermarkOpacity = Number.isNaN(watermarkOpacityRaw) ? 12 : Math.min(40, Math.max(3, watermarkOpacityRaw));
      preview.style.setProperty("--quote-watermark-opacity", (watermarkOpacity / 100).toFixed(2));
      preview.style.fontFamily = `${font}, sans-serif`;
      hasWatermarkImage = hasWatermarkImage || watermarkImageActive();
      const watermarkText = hasWatermarkImage ? "" : (watermarkTextInput || "CONFIDENTIAL");
      preview.classList.toggle("quote-watermarked", showWatermark && watermarkText.length > 0);
      preview.dataset.watermark = showWatermark ? watermarkText : "";
      if (previewWatermarkImage) {
        const shouldShow = showWatermark && hasWatermarkImage;
        previewWatermarkImage.hidden = !shouldShow;
      }

      if (!removeWatermarkImage && watermarkUploadInput && previewWatermarkImage && watermarkUploadInput.files && watermarkUploadInput.files[0]) {
        const file = watermarkUploadInput.files[0];
        if (file.type && file.type.startsWith("image/")) {
          if (watermarkImageObjectUrl) URL.revokeObjectURL(watermarkImageObjectUrl);
          watermarkImageObjectUrl = URL.createObjectURL(file);
          previewWatermarkImage.src = watermarkImageObjectUrl;
          preview.classList.toggle("quote-watermarked", false);
          previewWatermarkImage.hidden = !showWatermark;
          hasWatermarkImage = true;
        }
      }

      if (!removeSignatureImage && signatureUploadInput && previewSignatureImage && signatureUploadInput.files && signatureUploadInput.files[0]) {
        const file = signatureUploadInput.files[0];
        if (file.type && file.type.startsWith("image/")) {
          if (signatureImageObjectUrl) URL.revokeObjectURL(signatureImageObjectUrl);
          signatureImageObjectUrl = URL.createObjectURL(file);
          previewSignatureImage.src = signatureImageObjectUrl;
          hasSignatureImage = true;
        }
      }

      const densityNode = qsp("[data-template-preview-density]");
      if (densityNode) {
        densityNode.classList.remove("preview-density-compact", "preview-density-standard", "preview-density-spacious");
        densityNode.classList.add(`preview-density-${density}`);
      }

      const header = qsp("[data-template-preview-logo-position]");
      if (header) {
        header.classList.remove("preview-header-left", "preview-header-right", "preview-header-center");
        header.classList.add(`preview-header-${logoPosition}`);
      }

      const titleNode = qsp("[data-template-preview-title]");
      if (titleNode) {
        if (documentKind === "proforma_invoice") {
          const piTitle = qs("[name='quote_template[pi_title]']")?.value?.trim() || "PROFORMA INVOICE";
          titleNode.textContent = piTitle;
        } else {
          titleNode.textContent = titleQuote;
        }
      }
      const descNode = qsp("[data-template-preview-label-description]");
      if (descNode) descNode.textContent = labelDesc;
      const qtyNode = qsp("[data-template-preview-label-qty]");
      if (qtyNode) qtyNode.textContent = labelQty;
      const unitPriceNode = qsp("[data-template-preview-label-unit-price]");
      if (unitPriceNode) unitPriceNode.textContent = labelUnitPrice;
      const lineTotalNode = qsp("[data-template-preview-label-line-total]");
      if (lineTotalNode) lineTotalNode.textContent = labelLineTotal;
      const specNode = qsp("[data-template-preview-spec-label]");
      if (specNode) specNode.textContent = labelSpec;
      const addonNode = qsp("[data-template-preview-addon-label]");
      if (addonNode) addonNode.textContent = labelAddon;
      const numberLabelNode = qsp("[data-template-preview-number-label]");
      if (numberLabelNode) numberLabelNode.textContent = documentKind === "proforma_invoice" ? numberLabelPi : numberLabelQuote;

      const footerNode = qsp("[data-template-preview-footer]");
      if (footerNode) {
        const piFooter = qs("[name='quote_template[pi_footer_note]']")?.value?.trim();
        footerNode.textContent = documentKind === "proforma_invoice" ? (piFooter || footerFallback || "Thank you for your business.") : (footerQuote || footerFallback || "Thank you for your business.");
      }
      const closingNode = qsp("[data-template-preview-closing]");
      if (closingNode) closingNode.textContent = closingMessage || "<No closing message>";
      const signatureNameNode = qsp("[data-template-preview-signature-name-value]");
      if (signatureNameNode) signatureNameNode.textContent = signatureName;

      preview.querySelectorAll("[data-template-preview-amount]").forEach((node) => {
        const raw = Number.parseFloat(node.dataset.rawAmount || "0");
        node.textContent = formatMoney(raw, {
          decimals: Number.isNaN(decimals) ? 2 : decimals,
          separator,
          mode: currencyMode,
          showCurrency
        });
      });

      showNode("[data-template-preview-logo]", !!qs("[data-template-preview-toggle='logo']")?.checked);
      showNode("[data-template-preview-tax]", !!qs("[data-template-preview-toggle='tax']")?.checked);
      showNode("[data-template-preview-shipping]", !!qs("[data-template-preview-toggle='shipping']")?.checked);
      showNode("[data-template-preview-payment]", !!qs("[data-template-preview-toggle='payment']")?.checked);
      showNode("[data-template-preview-notes]", !!qs("[data-template-preview-toggle='notes']")?.checked);
      const showSignature = !!qs("[data-template-preview-toggle='signature']")?.checked;
      showNode("[data-template-preview-signature-image]", showSignature && hasSignatureImage);
      showNode("[data-template-preview-signature-name]", showSignature && signatureName.length > 0);
      showNode("[data-template-preview-customer-owner]", !!qs("[data-template-preview-toggle='customer-owner']")?.checked);
      showNode("[data-template-preview-valid-until]", !!qs("[data-template-preview-toggle='valid-until']")?.checked);
      showNode("[data-template-preview-terms]", !!qs("[data-template-preview-toggle='terms']")?.checked);
      showNode("[data-template-preview-images]", !!qs("[data-template-preview-toggle='images']")?.checked);
      showNode("[data-template-preview-closing]", !!qs("[data-template-preview-toggle='closing']")?.checked);
      showNode("[data-template-preview-saas-branding]", !!qs("[data-template-preview-toggle='saas-branding']")?.checked);
      updateWatermarkModeUI();
      updateContrastWarning(accent);
      updateSaveStatus();
    };

    form.addEventListener("input", updatePreview);
    form.addEventListener("change", updatePreview);

    const showWatermarkToggle = qs("[data-template-preview-toggle='watermark']");
    const watermarkTextInput = qs("[data-template-preview-target='watermark-text']");
    const watermarkFileInput = qs("[data-template-preview-target='watermark-image-upload']");
    const watermarkOpacityInput = qs("[data-template-preview-target='watermark-opacity']");
    const removeWatermarkImageInput = qs("[name='quote_template[remove_watermark_image]']");
    const watermarkTextContainer = qs("[data-watermark-text-container]");
    const watermarkModeHint = qs("[data-watermark-mode-hint]");
    const showSignatureToggle = qs("[data-template-preview-toggle='signature']");
    const signatureNameInput = qs("[data-template-preview-target='signature-name']");
    const signatureFileInput = qs("[data-template-preview-target='signature-image-upload']");
    const hasExistingWatermarkImage = watermarkFileInput?.dataset.existingFile === "true";

    const watermarkImageActive = () => {
      const hasNewUpload = !!(watermarkFileInput && watermarkFileInput.files && watermarkFileInput.files[0]);
      const removeExisting = !!removeWatermarkImageInput?.checked;
      const hasExisting = hasExistingWatermarkImage && !removeExisting;
      return hasNewUpload || hasExisting;
    };

    const updateWatermarkModeUI = () => {
      const imageMode = watermarkImageActive();
      if (watermarkTextInput) watermarkTextInput.disabled = imageMode;
      if (watermarkTextContainer) watermarkTextContainer.classList.toggle("is-disabled", imageMode);
      if (watermarkModeHint) {
        watermarkModeHint.textContent = imageMode ?
          "Image watermark mode is active. Remove image to edit text watermark." :
          "Text watermark mode is active. Upload an image to switch to image mode.";
      }
    };

    const bindFilePickers = () => {
      form.querySelectorAll("[data-file-picker-trigger]").forEach((button) => {
        const inputId = button.dataset.filePickerTrigger;
        const input = form.querySelector(`#${inputId}`);
        if (!input) return;
        button.addEventListener("click", () => input.click());
      });

      form.querySelectorAll("[data-file-picker-input]").forEach((input) => {
        const fileNameTarget = input.dataset.filePickerName;
        const fileNameNode = fileNameTarget ? form.querySelector(`#${fileNameTarget}`) : null;
        if (!fileNameNode) return;
        const updateFileName = () => {
          fileNameNode.textContent = input.files && input.files[0] ? input.files[0].name : "No file selected";
        };
        input.addEventListener("change", updateFileName);
        updateFileName();
      });
    };
    bindFilePickers();

    if (watermarkTextInput && showWatermarkToggle) {
      watermarkTextInput.addEventListener("input", () => {
        if (watermarkTextInput.value.trim()) showWatermarkToggle.checked = true;
      });
    }
    if (watermarkFileInput && showWatermarkToggle) {
      watermarkFileInput.addEventListener("change", () => {
        if (watermarkFileInput.files && watermarkFileInput.files[0]) {
          showWatermarkToggle.checked = true;
          if (removeWatermarkImageInput) removeWatermarkImageInput.checked = false;
        }
        updateWatermarkModeUI();
      });
    }
    if (removeWatermarkImageInput) {
      removeWatermarkImageInput.addEventListener("change", updateWatermarkModeUI);
    }
    if (signatureFileInput && showSignatureToggle) {
      signatureFileInput.addEventListener("change", () => {
        if (signatureFileInput.files && signatureFileInput.files[0]) showSignatureToggle.checked = true;
      });
    }
    if (signatureNameInput && showSignatureToggle) {
      signatureNameInput.addEventListener("input", () => {
        if (signatureNameInput.value.trim()) showSignatureToggle.checked = true;
      });
    }
    form.addEventListener("submit", () => {
      if (!statusNode) return;
      statusNode.textContent = "Saving...";
      statusNode.classList.remove("is-dirty", "is-saved");
      statusNode.classList.add("is-saving");
    });

    viewportButtons.forEach((button) => {
      button.addEventListener("click", () => {
        applyViewport(button.dataset.templatePreviewViewportBtn);
      });
    });

    if (scenarioNode) {
      scenarioNode.addEventListener("change", () => {
        applyScenario(scenarioNode.value);
        updatePreview();
      });
    }

    applyViewport("desktop");
    applyScenario(scenarioNode?.value || "standard");
    updateWatermarkModeUI();
    updatePreview();
  })();
</script>
