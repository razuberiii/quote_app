<main class="deal-workspace library-page">
  <header class="deal-page-header"><div><p class="eyebrow">Reusable commercial knowledge</p><h1>Library</h1><p>Products, pricing, content and brand assets — available inside every Deal.</p></div><%= link_to "Add product", new_product_path, class: "button button--primary" %></header>
  <nav class="library-tabs"><% [["products","Products"],["pricing","Pricing"],["presets","Quote presets"],["content","Content blocks"],["brand","Brand kit"]].each do |key,label| %><%= link_to label, library_path(section: key), class: ("is-active" if @section == key) %><% end %></nav>
  <% if @section == "products" %><section class="library-grid"><% @products.each do |product| %><%= link_to product_path(product), class: "library-product" do %><div><% if product.respond_to?(:primary_image) && product.primary_image.attached? %><%= image_tag product.primary_image %><% else %><span><%= product.name.to_s.first %></span><% end %></div><small><%= product.sku %></small><h2><%= product.name %></h2><p><%= product.currency %> <%= number_with_delimiter(product.base_price) if product.respond_to?(:base_price) %> · MOQ <%= product.moq.presence || "—" %></p><% end %><% end %><%= link_to new_product_path, class: "library-add" do %><span>＋</span><strong>Add to Library</strong><small>Products can also be saved from Quote Studio.</small><% end %></section>
  <% else %><section class="library-resource-list"><% if @section == "presets" %><% (@quote_presets + @templates).each do |resource| %><article><div><span><%= resource.class.model_name.human %></span><strong><%= resource.respond_to?(:name) ? resource.name : resource.title %></strong></div><%= link_to "Edit", resource.is_a?(QuoteTemplate) ? edit_quote_template_path(resource) : edit_quote_preset_path(resource), class: "deal-next" %></article><% end %><% else %><div class="deal-zero"><h2><%= @section.humanize %> grows while you quote.</h2><p>Save reusable pricing, clauses and brand assets from the workflow where they are needed.</p><%= link_to "Open settings", edit_company_settings_path, class: "button button--secondary" %></div><% end %></section><% end %>
</main>
