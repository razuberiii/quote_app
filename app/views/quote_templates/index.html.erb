<section class="app-page-shell template-page-shell">
  <header class="app-page-header">
    <div class="app-page-header-main">
      <h1><%= t("quote_templates.view.index.title") %></h1>
      <p class="template-page-subtitle"><%= t("quote_templates.view.index.subtitle") %></p>
    </div>
    <div class="app-page-header-actions template-index-actions">
      <%= link_to t("quote_templates.view.index.new_template"), new_quote_template_path, class: "app-ui-button app-ui-button--primary" %>
    </div>
  </header>

  <div class="template-grid">
  <% @quote_templates.each do |template| %>
    <article class="template-card template-preset-card">
      <div class="template-card-head">
        <div>
          <h3><%= template.name %></h3>
          <p class="template-sub">slug: <code><%= template.slug %></code></p>
        </div>
        <% if template.default_template? %>
          <span class="template-default-pill"><%= t("quote_templates.view.index.default_preset") %></span>
        <% end %>
      </div>

      <div class="template-meta-compact">
        <p class="template-meta"><%= template.layout_type.titleize %> · <%= (template.layout_density.presence || "standard").titleize %></p>
        <p class="template-meta"><%= template.font_family.presence || "Noto Sans" %></p>
        <p class="template-meta"><%= t("quote_templates.view.index.accent") %> <span class="template-color-dot" style="background: <%= template.accent_color %>"></span><%= template.accent_color %></p>
      </div>
      <div class="template-usage-row">
        <span class="next-action-pill is-muted"><%= t("quote_templates.view.index.used_in_quotes", count: @template_usage_counts[template.id].to_i) %></span>
      </div>

      <div class="template-preview template-preview-card template-preview-<%= template.layout_type %>" style="--template-accent: <%= template.accent_color.presence || '#1F4E79' %>; font-family: <%= template.font_family.presence || 'Noto Sans' %>, sans-serif;">
        <div class="preview-header preview-header-<%= template.logo_position.presence || 'right' %>">
          <span><%= template.layout_type.upcase %> • <%= (template.layout_density.presence || "standard").upcase %></span>
          <strong><%= template.resolved_document_title("quote") %></strong>
        </div>
        <div class="preview-body preview-body-rich">
          <div></div>
          <div></div>
        </div>
        <div class="preview-table">
          <span><%= template.resolved_table_label("description") %></span>
          <span><%= template.resolved_table_label("qty") %></span>
          <span><%= template.resolved_table_label("line_total") %></span>
        </div>
        <div class="preview-total"><%= t("quote_document.labels.grand_total") %></div>
      </div>

      <div class="template-actions">
        <%= link_to t("quote_templates.view.index.edit"), edit_quote_template_path(template), class: "app-ui-button app-ui-button--secondary" %>
        <% unless template.default_template? %>
          <%= button_to t("quote_templates.view.index.set_default"), set_default_quote_template_path(template), method: :patch, class: "app-ui-button app-ui-button--primary", form: { data: { turbo: false } } %>
        <% end %>
        <%= button_to t("quote_templates.view.index.delete"), quote_template_path(template), method: :delete, class: "app-ui-button app-ui-button--danger", data: { turbo_confirm: t("quote_templates.view.index.delete_confirm") } %>
      </div>
    </article>
  <% end %>
  </div>
</section>
