<h1>User Roles</h1>

<div class="table-responsive">
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Email</th>
        <th>Company</th>
        <th>Current Role</th>
        <th>Change Role</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= user.id %></td>
          <td><%= user.email %></td>
          <td><%= user.company&.name %></td>
          <td><%= user.role %></td>
          <td>
            <%= form_with model: [ :admin, user ], method: :patch, local: true do |f| %>
              <%= f.select :role, User.roles.keys.map { |role| [ role.titleize, role ] }, {}, class: ui_input_classes %>
              <%= f.submit "Update", class: ui_button_classes(:secondary) %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
