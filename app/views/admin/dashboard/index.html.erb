<section class="app-page-shell admin-page-shell admin-page-shell--dashboard">
  <header class="app-page-header">
    <div>
      <h1><%= t("admin.dashboard.title") %></h1>
      <p><%= t("admin.dashboard.subtitle") %></p>
    </div>
  </header>

  <section class="app-surface">
    <div class="app-section-heading">
      <h2><%= t("admin.dashboard.metrics.title", default: "Overview Metrics") %></h2>
      <p class="app-section-caption"><%= t("admin.dashboard.metrics.subtitle", default: "Lightweight support-first snapshot.") %></p>
    </div>
    <div class="app-stat-grid admin-dashboard-stat-grid">
      <article class="app-stat-card">
        <span class="app-stat-label"><%= t("admin.dashboard.metrics.total_users") %></span>
        <strong class="app-stat-value"><%= @total_users %></strong>
      </article>
      <article class="app-stat-card">
        <span class="app-stat-label"><%= t("admin.dashboard.metrics.new_users_7d") %></span>
        <strong class="app-stat-value"><%= @new_users_last_7_days %></strong>
      </article>
      <article class="app-stat-card">
        <span class="app-stat-label"><%= t("admin.dashboard.metrics.active_users") %></span>
        <strong class="app-stat-value"><%= @active_users_count %></strong>
      </article>
      <article class="app-stat-card admin-stat-card--risk">
        <span class="app-stat-label"><%= t("admin.dashboard.metrics.suspended_users") %></span>
        <strong class="app-stat-value"><%= @suspended_users_count %></strong>
      </article>
    </div>
  </section>

  <section class="app-surface">
    <div class="app-section-heading">
      <h2><%= t("admin.notifications.broadcast_title") %></h2>
      <p class="app-section-caption"><%= t("admin.notifications.broadcast_subtitle") %></p>
    </div>

    <%= form_with url: admin_notifications_path, method: :post, scope: :announcement, local: true do |f| %>
      <div class="app-filter-grid">
        <div class="app-filter-field">
          <%= f.label :title, t("admin.notifications.fields.title") %>
          <%= f.text_field :title, class: ui_input_classes, required: true, maxlength: 120 %>
        </div>
        <div class="app-filter-field">
          <%= f.label :link_url, t("admin.notifications.fields.link_url") %>
          <%= f.url_field :link_url, class: ui_input_classes, placeholder: "https://rubusoo.com/changelog" %>
        </div>
        <div class="app-filter-field app-filter-field--full">
          <%= f.label :message, t("admin.notifications.fields.message") %>
          <%= f.text_area :message, class: "#{ui_input_classes} admin-notice-textarea", rows: 6, required: true, placeholder: t("admin.notifications.template.body") %>
          <p class="app-section-caption"><%= t("admin.notifications.fields.message_wrap_hint") %></p>
        </div>
        <div class="app-filter-actions">
          <%= f.submit t("admin.notifications.actions.send_all"), class: ui_button_classes(:primary), data: { turbo_confirm: t("admin.notifications.actions.confirm_send_all") } %>
        </div>
      </div>
    <% end %>

    <div class="app-section-caption">
      <strong><%= t("admin.notifications.template.title") %></strong><br>
      <%= simple_format(t("admin.notifications.template.body")) %>
    </div>
  </section>
</section>
