<section class="app-page-shell marketing-page-shell">
  <%= render "components/ui/card", class: "app-surface marketing-section-card" do %>
    <%= render "components/ui/section_header",
      kicker: t("landing.view.terms.hero.kicker"),
      title: t("landing.view.terms.hero.title"),
      body: t("landing.view.terms.hero.body"),
      tag: :h1,
      title_class: "max-w-none" %>

    <div class="legal-copy">
      <p class="legal-copy__updated"><%= t("landing.view.terms.last_updated") %></p>

      <section class="legal-section"><h2><%= t("landing.view.terms.sections.acceptance.title") %></h2><p><%= t("landing.view.terms.sections.acceptance.body") %></p>
      </section>

      <section class="legal-section"><h2><%= t("landing.view.terms.sections.account.title") %></h2><p><%= t("landing.view.terms.sections.account.body") %></p>
      </section>

      <section class="legal-section"><h2><%= t("landing.view.terms.sections.usage.title") %></h2><p><%= t("landing.view.terms.sections.usage.body") %></p>
      </section>

      <section class="legal-section"><h2><%= t("landing.view.terms.sections.availability.title") %></h2><p><%= t("landing.view.terms.sections.availability.body") %></p>
      </section>

      <section class="legal-section"><h2><%= t("landing.view.terms.sections.liability.title") %></h2><p><%= t("landing.view.terms.sections.liability.body") %></p>
      </section>

      <section class="legal-section"><h2><%= t("landing.view.terms.sections.contact.title") %></h2><p><%= t("landing.view.terms.sections.contact.body") %></p>
      </section>
    </div>
  <% end %>
</section>
