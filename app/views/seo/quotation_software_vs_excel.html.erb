<section class="app-page-shell marketing-page-shell">
  <%= render "components/ui/card", class: "app-surface marketing-hero-shell" do %>
    <div class="marketing-section-heading">
      <p class="marketing-section-kicker"><%= t("seo.view.quotation_software_vs_excel.hero.kicker") %></p>
      <h1 class="marketing-section-title max-w-none"><%= t("seo.view.quotation_software_vs_excel.hero.title") %></h1>
      <p class="marketing-section-body"><%= t("seo.view.quotation_software_vs_excel.hero.body") %></p>
      <div class="flex flex-wrap gap-3">
        <%= render "components/ui/button", href: sample_quote_path, variant: :primary, attrs: { target: "_blank" } do %>
          <%= t("seo.view.shared.links.view_sample_quote") %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= render "components/ui/card", class: "app-surface marketing-section-card" do %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 text-left">
        <thead class="bg-slate-950 text-white">
          <tr>
            <th class="px-4 py-3 text-sm font-semibold"><%= t("seo.view.quotation_software_vs_excel.table.headers.criteria") %></th>
            <th class="px-4 py-3 text-sm font-semibold"><%= t("seo.view.quotation_software_vs_excel.table.headers.excel") %></th>
            <th class="px-4 py-3 text-sm font-semibold"><%= t("seo.view.quotation_software_vs_excel.table.headers.rubusoo") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white text-sm text-slate-700">
          <tr>
            <td class="px-4 py-3 font-semibold text-slate-950"><%= t("seo.view.quotation_software_vs_excel.table.rows.revision.criteria") %></td>
            <td class="px-4 py-3"><%= t("seo.view.quotation_software_vs_excel.table.rows.revision.excel") %></td>
            <td class="px-4 py-3"><%= t("seo.view.quotation_software_vs_excel.table.rows.revision.rubusoo") %></td>
          </tr>
          <tr>
            <td class="px-4 py-3 font-semibold text-slate-950"><%= t("seo.view.quotation_software_vs_excel.table.rows.buyer_response.criteria") %></td>
            <td class="px-4 py-3"><%= t("seo.view.quotation_software_vs_excel.table.rows.buyer_response.excel") %></td>
            <td class="px-4 py-3"><%= t("seo.view.quotation_software_vs_excel.table.rows.buyer_response.rubusoo") %></td>
          </tr>
          <tr>
            <td class="px-4 py-3 font-semibold text-slate-950"><%= t("seo.view.quotation_software_vs_excel.table.rows.visibility.criteria") %></td>
            <td class="px-4 py-3"><%= t("seo.view.quotation_software_vs_excel.table.rows.visibility.excel") %></td>
            <td class="px-4 py-3"><%= t("seo.view.quotation_software_vs_excel.table.rows.visibility.rubusoo") %></td>
          </tr>
          <tr>
            <td class="px-4 py-3 font-semibold text-slate-950"><%= t("seo.view.quotation_software_vs_excel.table.rows.export.criteria") %></td>
            <td class="px-4 py-3"><%= t("seo.view.quotation_software_vs_excel.table.rows.export.excel") %></td>
            <td class="px-4 py-3"><%= t("seo.view.quotation_software_vs_excel.table.rows.export.rubusoo") %></td>
          </tr>
        </tbody>
      </table>
    </div>
  <% end %>

  <section class="marketing-editorial-band">
    <%= render "components/ui/card", class: "app-surface marketing-workflow-card" do %>
      <h2 class="text-2xl font-semibold tracking-tight text-slate-950"><%= t("seo.view.quotation_software_vs_excel.cards.buyer_flow.title") %></h2>
      <p class="app-section-caption"><%= t("seo.view.quotation_software_vs_excel.cards.buyer_flow.body") %></p>
      <div class="pt-2">
        <%= render "components/ui/button", href: sample_quote_path, variant: :secondary, attrs: { target: "_blank" } do %>
          <%= t("seo.view.quotation_software_vs_excel.cards.buyer_flow.cta") %>
        <% end %>
      </div>
    <% end %>
    <%= render "components/ui/card", class: "app-surface marketing-workflow-card" do %>
      <h2 class="text-2xl font-semibold tracking-tight text-slate-950"><%= t("seo.view.quotation_software_vs_excel.cards.internal_workflow.title") %></h2>
      <p class="app-section-caption"><%= t("seo.view.quotation_software_vs_excel.cards.internal_workflow.body") %></p>
      <div class="pt-2">
        <%= render "components/ui/button", href: demo_path, variant: :secondary do %>
          <%= t("seo.view.quotation_software_vs_excel.cards.internal_workflow.cta") %>
        <% end %>
      </div>
    <% end %>
  </section>

  <%= render "seo/continue_reading",
    related_topics: [
      { label: t("seo.view.shared.links.buyer_facing_quotation_link"), path: buyer_facing_quotation_link_path },
      { label: t("seo.view.shared.links.quote_revision_control"), path: quote_revision_control_path },
      { label: t("seo.view.shared.links.foreign_trade_quotation_software"), path: foreign_trade_quotation_software_path }
    ],
    comparison_link: nil,
    cta: { label: t("seo.view.shared.links.view_sample_quote"), path: sample_quote_path, target: "_blank" } %>
</section>
